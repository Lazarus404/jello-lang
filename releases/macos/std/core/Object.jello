package std.core;

/* Functions of Objects, which a program calls as Object.f(o, ...) or as
 * o.f(...); the compiler's intrinsics get, set, exists, remove, clear, copy,
 * keys and toString win, and a name that is neither calls the function in
 * the Object's field of that name. */

// The number of fields O has.
export let len = fn(o: Object): I32 { o.keys().len() };

// Whether O has no fields.
export let isEmpty = fn(o: Object): Bool { len(o) == 0 };

// Sets every field of OTHER on O, replacing any O has; O.
export let merge = fn(o: Object, other: Object): Object {
  let keys = other.keys();
  let i = 0;

  while (i < keys.len()) {
    o[keys[i]] = other[keys[i]];
    i++;
  }
  o
};

// The values of O's fields, in the order of its keys.
export let values = fn(o: Object): Array<Dynamic> {
  let keys = o.keys();
  let out = Array.new<Dynamic>(0);
  let i = 0;

  while (i < keys.len()) {
    out.push(o[keys[i]]);
    i++;
  }
  out
};
