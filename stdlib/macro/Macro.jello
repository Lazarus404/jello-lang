package std.macro;

/* What a macro's body uses as it runs, while the program that calls the
 * macro compiles. A macro takes each argument as syntax, a Fragment, and
 * emits the syntax that replaces its call:
 *
 *   macro twice(x) {
 *     Macro.emit(quote.expr { unquote(x) + unquote(x) });
 *   }
 *
 * A macro body names this module as Macro without importing it, and its
 * Fragment type likewise. A quote makes a Fragment of the syntax it holds,
 * each unquote(value) in it replaced by the Fragment value holds, or by a
 * literal of value when it is an I32, I64, F64, Bool, Bytes or null.
 *
 * The rest of this module is the compiler's: it runs a macro's body with its
 * arguments, and reads back what it emitted. */

import { appendFrom } from std.core.Array;
import { u8 } from std.core.Bytes;

// A piece of syntax a macro takes or makes; only this module looks inside.
export enum Fragment {
  // The call's argument at INDEX.
  Argument(index: I32);
  // The quote at INDEX in the macro's body, with its unquotes' fragments.
  Quoted(index: I32, holes: Array<Fragment>);
  // SOURCE, parsed as KIND when the macro's output is read.
  Parsed(source: Bytes, kind: Bytes);
  // A name, from gensym.
  Name(name: Bytes);
  // A literal of VALUE.
  Literal(value: Dynamic);
  Splice(values: Array<Fragment>);
}

// What the macro has emitted so far.
let _emitted = Array.new<Fragment>(0);
// The number the next gensym name ends with.
let _names = 0;
// The value of each literal argument, and whether each argument is one.
let _values = Array.new<Dynamic>(0);
let _literal = Array.new<Bool>(0);

// Checks that KIND is a kind of syntax parse reads.
let _kind = fn(kind: Bytes) {
  match (kind) {
    "auto", "expr", "stmt", "stmts", "type", "pat", "arm" => null,
    _ => {
      throw "Macro.parse: unknown kind " + kind + "; use expr, stmt, stmts, type, pat, arm or auto";
      null
    },
  }
};

// Emits FRAGMENT, which replaces the macro's call with any others emitted.
export let emit = fn(fragment: Fragment) {
  _emitted.push(fragment);
  null
};

// Emits each of FRAGMENTS, in order.
export let emit_all = fn(fragments: Array<Fragment>) {
  appendFrom(_emitted, fragments, 0);
  null
};

/* The syntax of SOURCE, read as KIND: "expr", "stmt", "stmts", "type",
 * "pat", or "auto", which reads statements when SOURCE starts with a keyword
 * that starts one and an expression otherwise. It is parsed once the macro
 * has finished, and text that does not parse fails the call. */
export let parse = fn(source: Bytes, kind: Bytes = "auto"): Fragment {
  _kind(kind);
  Fragment.Parsed(source, kind)
};

/* A name no other gensym call gives while the program compiles, made of
 * PREFIX, two underscores and a number; PREFIX is letters, digits and _, and
 * does not start with a digit. */
export let gensym = fn(prefix: Bytes): Fragment {
  let i = 0;

  while (i < prefix.len()) {
    let c = Bytes.get_u8(prefix, i);
    let letter = ((c >= "a".code) && (c <= "z".code)) || ((c >= "A".code) && (c <= "Z".code)) || (c == "_".code);
    if (!letter && ((i == 0) || (c < "0".code) || (c > "9".code))) { throw "Macro.gensym: a prefix is letters, digits and _, and does not start with a digit: " + prefix; }
    i++;
  }
  let name = prefix + "__" + Std.string(_names);
  _names++;
  Fragment.Name(name)
};

// The identifier NAME, validated when the compiler reads the fragment.
export let name = fn(name: Bytes): Fragment { Fragment.Name(name) };

// A sequence of arm fragments for an arm-list unquote.
export let splice = fn(values: Array<Fragment>): Fragment { Fragment.Splice(values) };

/* The value of FRAGMENT, when it is a literal: an argument written as one,
 * with an optional minus, or a literal unquoted. Its type is the literal's,
 * so it is read with `as`, as in Macro.literal(n) as I32. */
export let literal = fn(fragment: Fragment): Dynamic {
  match (fragment) {
    Argument(index) when (_literal[index]) => _values[index],
    Literal(value) => value,
    _ => {
      throw "Macro.literal: the fragment is not a literal";
      null
    },
  }
};

// The fragment of quote INDEX, with HOLES for its unquotes in order.
export let quoted = fn(index: I32, holes: Array<Dynamic>): Fragment {
  let made = Array.new<Fragment>(0);
  let i = 0;

  while (i < holes.len()) {
    let hole = holes[i];
    made.push(match (hole) {
      is Fragment as fragment => fragment,
      is I32, is I64, is F64, is Bool, is Bytes => Fragment.Literal(hole),
      _ when (hole == null) => Fragment.Literal(hole),
      _ => {
        throw "unquote takes a Fragment, or an I32, I64, F64, Bool, Bytes or null value; "
          + "an Array<Fragment> splices only into a match's arms";
        Fragment.Literal(null)
      },
    });
    i++;
  }
  Fragment.Quoted(index, made)
};

// The value of hex digit C.
let _digit = fn(c: I32): I32 { c <= "9".code ? c - "0".code : c - "a".code + 10 };

// The value of an argument's literal, from its form in the compiler's input.
let _read = fn(form: Bytes): Dynamic {
  let text = Bytes.slice(form, 1, form.len() - 1);

  match (Bytes.get_u8(form, 0)) {
    "i".code => {
      let value: I32 = Integer.parse(text);
      value as Dynamic
    },
    "l".code => {
      let value: I64 = Integer.parse(text);
      value as Dynamic
    },
    "f".code => Float.parse(text) as Dynamic,
    "b".code => (text == "1") as Dynamic,
    "s".code => {
      let out = Array.new<Bytes>(0);
      let i = 0;

      while (2 * i < text.len()) {
        out.push(u8(_digit(Bytes.get_u8(text, 2 * i)) * 16 + _digit(Bytes.get_u8(text, 2 * i + 1))));
        i++;
      }
      out.join("") as Dynamic
    },
    _ => null,
  }
};

// Appends the encoding of FRAGMENT to OUT; see run.
let _encode: (Fragment, Array<Bytes>) -> Null = fn(_fragment, _out) { null };

// Appends the encoding of the Bytes TEXT, after TAG, to OUT.
let _text = fn(tag: Bytes, text: Bytes, out: Array<Bytes>) {
  out.push(tag + Std.string(text.len()) + ";" + text);
  null
};
_encode = fn(fragment, out) {
  match (fragment) {
    Argument(index) => {
      out.push("p" + Std.string(index) + ";");
      null
    },
    Quoted(index, holes) => {
      out.push("t" + Std.string(index) + ";" + Std.string(holes.len()) + ";");
      let i = 0;

      while (i < holes.len()) {
        _encode(holes[i], out);
        i++;
      }
      null
    },
    Parsed(source, kind) => {
      _kind(kind);
      _text("s" + kind + ":", source, out)
    },
    Name(name) => _text("g", name, out),
    Literal(value) => match (value) {
      _ when (value == null) => {
        out.push("n");
        null
      },
      is I32 as v => {
        out.push("i" + Std.string(v) + ";");
        null
      },
      is I64 as v => {
        out.push("l" + Std.string(v) + ";");
        null
      },
      is F64 as v => _text("f", Std.string(v), out),
      is Bool as v => {
        out.push(v ? "b1" : "b0");
        null
      },
      is Bytes as v => _text("y", v, out),
      _ => {
        throw "a Fragment.Literal holds an I32, I64, F64, Bool, Bytes or null value";
        null
      },
    },
    Splice(values) => {
      out.push("a" + Std.string(values.len()) + ";");
      for (value in values) { _encode(value, out); }
      null
    },
  }
};

/* Runs the macro body of EXPANDERS that the program's first argument names,
 * with the arguments the rest describe, and returns what it emitted. The
 * arguments are the macro's index, the number its first gensym name ends
 * with, then a form for each argument: empty, or a literal's value after its
 * kind. What it returns is the number the next gensym name would end with
 * and `;`, then each fragment emitted, encoded; a number ends with `;`, and
 * a length and `;` come before any text. */
export let run = fn(expanders: Array<(Array<Fragment>) -> Null>): Bytes {
  let args = System.args;
  let index: I32 = Integer.parse(List.head(args));
  args = List.tail(args);
  _names = Integer.parse(List.head(args));
  args = List.tail(args);
  let arguments = Array.new<Fragment>(0);

  while (!List.is_nil(args)) {
    let form = List.head(args);
    _literal.push(form != "");
    _values.push(form == "" ? null : _read(form));
    arguments.push(Fragment.Argument(arguments.len()));
    args = List.tail(args);
  }
  expanders[index](arguments);
  let out = [Std.string(_names) + ";"];
  let i = 0;

  while (i < _emitted.len()) {
    _encode(_emitted[i], out);
    i++;
  }
  out.join("")
};
