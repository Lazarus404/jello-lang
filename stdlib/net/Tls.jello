package std.net;

import std.net.Tcp as Tcp;
import type { Listener, Stream } from std.net.Tcp;

load { net_tls_start, net_error, net_error_text } from vm;
load { tls_version, tls_config } from tls;

let _make: (Bool, Bytes, Bytes) -> Dynamic = tls_config;
let _start: (Dynamic, Dynamic, Bytes) -> Bool = net_tls_start;
let _error: () -> I32 = net_error;
let _errorText: (I32) -> Bytes = net_error_text;
let _version: () -> Bytes = tls_version;

let _raise = fn() { throw _errorText(_error()); };

export let library = fn(): Bytes { _version() };

export typedef Config = { let handle: Dynamic; };

export prototype Config {
  init(handle: Dynamic) { this.handle = handle; };
};

let _config = fn(server: Bool, certificates: Bytes, key: Bytes): Config {
  let made = _make(server, certificates, key);
  if (made is I32) { throw _errorText(made as I32); };
  new Config(made)
};

export let server = fn(certificates: Bytes, key: Bytes): Config {
  _config(true, certificates, key)
};

export let client = fn(trusted: Bytes): Config { _config(false, trusted, "") };

export let secureServer = fn(stream: Stream, config: Config): Stream {
  if (!_start(stream.handle, config.handle, "")) { _raise(); };
  stream
};

export let secureClient = fn(stream: Stream, config: Config, host: Bytes): Stream {
  if (!_start(stream.handle, config.handle, host)) { _raise(); };
  stream
};

export let connect = fn(host: Bytes, port: I32, config: Config): Stream {
  secureClient(Tcp.connect(host, port), config, host)
};

export let accept = fn(listener: Listener, config: Config): Stream {
  secureServer(listener.accept(), config)
};
