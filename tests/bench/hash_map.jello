// HashMap versus interned ID arrays over the same generated Bytes keys.
import std.sys.Date as Date;
import type { HashMap } from std.core.HashMap;

let KEYS = 20000;
let keys = Array.new<Bytes>(0);
let i = 0;
while (i < KEYS) { keys.push("key-" + Std.string(i)); i++; }

let map = new HashMap<Bytes, I32>();
let start = Date.now().time;
i = 0;
while (i < KEYS) { map.set(keys[i], i); i++; }
let mapInsert = (Date.now().time - start) as I32;
let mapChecksum = 0i64;
start = Date.now().time;
i = 0;
while (i < KEYS) { mapChecksum = mapChecksum + (map.get(keys[i]) as I64); i++; }
let mapLookup = (Date.now().time - start) as I32;

let interned = Array.new<Bytes>(0);
let values = Array.new<I32>(0);
start = Date.now().time;
i = 0;
while (i < KEYS) { let id = interned.internIndex(keys[i]); values.push(id); i++; }
let idsInsert = (Date.now().time - start) as I32;
let idsChecksum = 0i64;
start = Date.now().time;
i = 0;
while (i < KEYS) { idsChecksum = idsChecksum + (values[interned.indexOf(keys[i])] as I64); i++; }
let idsLookup = (Date.now().time - start) as I32;
System.assert(mapChecksum == idsChecksum);

"keys=" + Std.string(KEYS) + " map-insert-ms=" + Std.string(mapInsert) + " map-lookup-ms=" + Std.string(mapLookup)
  + " ids-insert-ms=" + Std.string(idsInsert) + " ids-lookup-ms=" + Std.string(idsLookup)
  + " checksum=" + Std.string(mapChecksum)
