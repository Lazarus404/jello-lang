// The primes below 4,000,000, sieved in a byte buffer, five times.
let sieve = fn(m: I32): I32 {
  let flags = Bytes.new(m);
  let count = 0;
  let i = 2;
  while (i < m) {
    if (Bytes.get(flags, i) == 0) {
      count++;
      let j = i + i;
      while (j < m) { Bytes.set(flags, j, 1); j = j + i; }
    }
    i++;
  }
  count
};
let k = 0;
while (k < 5) { System.assert(sieve(4000000) == 283146); k++; }
"ok"
