// Method calls on prototype instances: a particle system of 1,000 points, 10,000 steps.
typedef Point = { let x: F64; let y: F64; let dx: F64; let dy: F64; };
prototype Point {
  init(x: F64, y: F64, dx: F64, dy: F64) { this.x = x; this.y = y; this.dx = dx; this.dy = dy; };
  step() {
    this.x = this.x + this.dx;
    this.y = this.y + this.dy;
    if (this.x < 0.0 || this.x > 100.0) { this.dx = 0.0 - this.dx; }
    if (this.y < 0.0 || this.y > 100.0) { this.dy = 0.0 - this.dy; }
    null
  };
  norm(): F64 { this.x * this.x + this.y * this.y };
};
let points = Array.new<Point>(0);
let i = 0;
while (i < 1000) {
  points.push(new Point((i % 100) as F64, (i % 37) as F64, ((i % 7) as F64) * 0.5 - 1.5, ((i % 5) as F64) * 0.25 - 0.5));
  i++;
}
let s = 0;
while (s < 10000) {
  i = 0;
  while (i < points.len()) { points[i].step(); i++; }
  s++;
}
let total = 0.0;
i = 0;
while (i < points.len()) { total = total + points[i].norm(); i++; }
System.assert(Math.floor(total) == 7214397.0);
"ok"
