{
  "inputs": ["jelloc/src", "jelloc/tests", "stdlib"],
  "exclude": [
    "jelloc/src/frontend/syntax/UnicodeWidth.jello",
    "jelloc/tests/e2e/cli",
    "jelloc/tests/e2e/corpus",
    "jelloc/tests/e2e/programs",
    "jelloc/tests/unit/format/cases",
    "jelloc/tests/workload"
  ],
  "overrides": [
    { "paths": ["jelloc/tests"], "rewrite_comments": false }
  ]
}
