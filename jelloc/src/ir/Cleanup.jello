package ir;

import type { BasicBlock, Function, Instruction, Terminator } from ir.Model;
import { Op, Terminator, instructionAt } from ir.Model;
import { blockIndexes, normalSuccessors, terminatorRead } from ir.Cfg;

let _UNKNOWN = 0;
let _INT = 1;
let _BOOL = 2;

let _kinds = Array.new<I32>(0);
let _values = Array.new<I32>(0);
let _known = Array.new<I32>(0);
let _copies = Array.new<I32>(0);
let _copied = Array.new<I32>(0);
let _copiesOf = Array.new<Array<I32>>(0);

let _forget = fn(register: I32) {
  _kinds[register] = _UNKNOWN;
  _copies[register] = -1;

  let copies = _copiesOf[register];
  if (copies.len() == 0) { return null; }
  let i = 0;

  while (i < copies.len()) {
    if (_copies[copies[i]] == register) { _copies[copies[i]] = -1; }
    i++;
  }
  _copiesOf[register] = Array.new<I32>(0);
  null
};

let _forgetAll = fn() {
  let i = 0;

  while (i < _copied.len()) {
    _copies[_copied[i]] = -1;
    i++;
  }
  _copied = Array.new<I32>(0);

  i = 0;

  while (i < _known.len()) {
    _kinds[_known[i]] = _UNKNOWN;
    i++;
  }
  _known = Array.new<I32>(0);
  null
};

let _source = fn(register: I32): I32 { (_copies[register] >= 0) ? _copies[register] : register };

let _rebuilt = fn(
  block: BasicBlock, instructions: Array<Instruction>, terminator: Terminator
): BasicBlock {
  { ...block, instructions, terminator }
};

let _merged = fn(blocks: Array<BasicBlock>, entry: I32): Array<BasicBlock> {
  let indexes = blockIndexes(blocks);
  let count = blocks.len();
  let entries = Array.new<I32>(count);
  let outside = Array.new<Bool>(count);
  let code = Array.new<Array<Instruction>>(0);
  let lasts = Array.new<Terminator>(0);

  entries[indexes[entry]] = 2;
  let i = 0;

  while (i < count) {
    let block = blocks[i];
    let targets = normalSuccessors(block.terminator);
    let t = 0;

    while (t < targets.len()) {
      entries[indexes[targets[t]]] = entries[indexes[targets[t]]] + 1;
      t++;
    }
    if (block.handler != null) { entries[indexes[block.handler.target]] = 2; }
    code.push(block.instructions);
    lasts.push(block.terminator);
    outside[i] = block.handler == null;
    i++;
  }

  let gone = Array.new<Bool>(count);
  let joined = false;
  i = 0;

  while (i < count) {
    let joining = !gone[i] && outside[i];
    let copied = false;

    while (joining) {
      joining = false;

      match (lasts[i]) {
        Jump(target) => {
          let next = indexes[target];

          if ((next != i) && (entries[next] == 1) && outside[next]) {
            if (!copied) {
              code[i] = code[i].copy();
              copied = true;
            }
            code[i].appendFrom(code[next], 0);
            lasts[i] = lasts[next];
            gone[next] = true;
            joined = true;
            joining = true;
          }
        },
        _ => {},
      }
    }
    i++;
  }
  if (!joined) { return blocks; }

  let out = Array.new<BasicBlock>(0);
  i = 0;

  while (i < count) {
    if (!gone[i]) { out.push(_rebuilt(blocks[i], code[i], lasts[i])); }
    i++;
  }
  out
};

let _intResult = fn(op: Op, left: I32, right: I32): I32 {
  match (op) {
    Add => left + right,
    Sub => left - right,
    Mul => left * right,
    BitAnd => left & right,
    BitOr => left | right,
    BitXor => left ^ right,
    Shl => left << right,
    Shr => left >> right,
    Neg => -left,
    _ => 0,
  }
};

let _folded = fn(insn: Instruction, args: Array<I32>): ?Instruction {
  let n = args.len();
  let ints = n > 0;
  let bools = n > 0;
  let i = 0;

  while (i < n) {
    if (_kinds[args[i]] != _INT) { ints = false; }
    if (_kinds[args[i]] != _BOOL) { bools = false; }
    i++;
  }
  if (!ints && !bools) { return null; }

  let op = insn.op;
  let int = match (op) { Add, Sub, Mul, BitAnd, BitOr, BitXor, Shl, Shr, Neg => ints, _ => false };
  let bool = match (op) { Eq => true, Lt => ints, Not => bools, _ => false };
  if (!int && !bool) { return null; }

  let left = _values[args[0]];
  let right = (n > 1) ? _values[args[1]] : 0;
  let value = int ? _intResult(op, left, right) : match (op) {
    Eq => (left == right) ? 1 : 0,
    Lt => (left < right) ? 1 : 0,
    _ => 1 - left,
  };
  instructionAt(int ? Op.ConstI32 : Op.ConstBool, insn.dst, [], value, insn.node)
};

let _countReads = fn(blocks: Array<BasicBlock>, reads: Array<I32>) {
  let i = 0;

  while (i < blocks.len()) {
    let instructions = blocks[i].instructions;
    let j = 0;

    while (j < instructions.len()) {
      let args = instructions[j].args;
      let a = 0;

      while (a < args.len()) {
        reads[args[a]] = reads[args[a]] + 1;
        a++;
      }
      j++;
    }
    let last = terminatorRead(blocks[i].terminator);
    if (last >= 0) { reads[last] = reads[last] + 1; }
    i++;
  }
  null
};

let _reads = Array.new<I32>(0);

let _onlyReadAfter = fn(
  copy: I32, source: I32, instructions: Array<Instruction>, at: I32, terminator: Terminator
): Bool {
  let seen = 0;
  let j = at + 1;

  while ((j < instructions.len()) && (seen < _reads[copy])) {
    let insn = instructions[j];
    let a = 0;

    while (a < insn.args.len()) {
      if (insn.args[a] == copy) { seen++; }
      a++;
    }
    if ((insn.dst == copy) || (insn.dst == source)) { return seen == _reads[copy]; }
    j++;
  }
  if ((seen < _reads[copy]) && (terminatorRead(terminator) == copy)) { seen++; }
  seen == _reads[copy]
};

let _changed = false;

let _propagated = fn(
  instructions: Array<Instruction>, at: I32, terminator: Terminator
): Instruction {
  let insn = instructions[at];
  let args = insn.args;
  let copied = false;
  let i = 0;

  while (i < args.len()) {
    if (_copies[args[i]] >= 0) { copied = true; }
    i++;
  }
  let read = args;

  if (copied) {
    read = Array.new<I32>(0);
    i = 0;

    while (i < args.len()) {
      read.push(_source(args[i]));
      i++;
    }
  }

  let dst = insn.dst;
  let folded = _folded(insn, read);
  let out = (folded != null)
    ? folded
    : (copied ? instructionAt(insn.op, dst, read, insn.imm, insn.node) : insn);
  if (copied || (folded != null)) { _changed = true; }
  if (dst < 0) { return out; }

  _forget(dst);

  match (out.op) {
    ConstI32 => {
      _kinds[dst] = _INT;
      _values[dst] = out.imm;
      _known.push(dst);
    },
    ConstBool => {
      _kinds[dst] = _BOOL;
      _values[dst] = out.imm;
      _known.push(dst);
    },
    Move when (read[0] != dst) => {
      if (_kinds[read[0]] != _UNKNOWN) {
        _kinds[dst] = _kinds[read[0]];
        _values[dst] = _values[read[0]];
        _known.push(dst);
      }

      if (_onlyReadAfter(dst, read[0], instructions, at, terminator)) {
        _copies[dst] = read[0];
        _copied.push(dst);
        _copiesOf[read[0]].push(dst);
      }
    },
    _ => {},
  }
  out
};

let _terminator = fn(terminator: Terminator): Terminator {
  let read = terminatorRead(terminator);
  if (read < 0) { return terminator; }

  let source = _source(read);

  match (terminator) {
    Branch(_, thenTarget, elseTarget) when (_kinds[source] == _BOOL) => {
      _changed = true;
      Terminator.Jump((_values[source] != 0) ? thenTarget : elseTarget)
    },
    _ when (source == read) => terminator,
    Branch(_, thenTarget, elseTarget) => {
      _changed = true;
      Terminator.Branch(source, thenTarget, elseTarget)
    },
    ReturnValue(_) => {
      _changed = true;
      Terminator.ReturnValue(source)
    },
    Throw(_, node) => {
      _changed = true;
      Terminator.Throw(source, node)
    },
    _ => terminator,
  }
};

let _anyChanged = false;

let _propagateAll = fn(blocks: Array<BasicBlock>): Array<BasicBlock> {
  let out = Array.new<BasicBlock>(0);
  _anyChanged = false;

  let i = 0;

  while (i < blocks.len()) {
    let block = blocks[i];
    _forgetAll();
    _changed = false;

    let code = Array.new<Instruction>(0);
    let j = 0;

    while (j < block.instructions.len()) {
      code.push(_propagated(block.instructions, j, block.terminator));
      j++;
    }
    let last = _terminator(block.terminator);

    out.push(_changed ? _rebuilt(block, code, last) : block);
    if (_changed) { _anyChanged = true; }
    i++;
  }
  out
};

let _reachable = fn(blocks: Array<BasicBlock>, entry: I32): Array<BasicBlock> {
  let indexes = blockIndexes(blocks);
  let seen = Array.new<Bool>(blocks.len());
  let pending = [indexes[entry]];
  seen[indexes[entry]] = true;
  let reached = 1;

  while (pending.len() > 0) {
    let block = blocks[pending.pop()];
    let next = Array.new<I32>(0);
    let targets = normalSuccessors(block.terminator);
    let t = 0;

    while (t < targets.len()) {
      next.push(indexes[targets[t]]);
      t++;
    }
    if (block.handler != null) { next.push(indexes[block.handler.target]); }

    t = 0;

    while (t < next.len()) {
      if (!seen[next[t]]) {
        seen[next[t]] = true;
        pending.push(next[t]);
        reached++;
      }
      t++;
    }
  }
  if (reached == blocks.len()) { return blocks; }

  let out = Array.new<BasicBlock>(0);
  let i = 0;

  while (i < blocks.len()) {
    if (seen[i]) { out.push(blocks[i]); }
    i++;
  }
  out
};

let _removable = fn(insn: Instruction): Bool {
  match (insn.op) {
    ConstBool, ConstI32, ConstI64, ConstFloat, ConstBytes, ConstAtom, ConstNull, ConstFunction,
    Move, Add, Sub, Mul, Shl, Shr, BitAnd, BitOr, BitXor, Neg, Not, Eq, Lt, LtU,
    Sext, Trunc, Zext, Box, KindOf, IsEnum, IsNull, ListNil, ListIsNil,
    TupleNew, EnumNew, ObjectNew, GlobalGet =>
      insn.dst >= 0,
    _ => false,
  }
};

let _without = fn(instructions: Array<Instruction>, removed: Array<I32>): Array<Instruction> {
  let kept = Array.new<Instruction>(0);
  let r = removed.len() - 1;
  let j = 0;

  while (j < instructions.len()) {
    if ((r >= 0) && (removed[r] == j)) {
      r--;
    } else {
      kept.push(instructions[j]);
    }
    j++;
  }
  kept
};

let _withoutDead = fn(blocks: Array<BasicBlock>, reads: Array<I32>): Array<BasicBlock> {
  let current = blocks;
  let again = true;

  while (again) {
    again = false;
    let out = Array.new<BasicBlock>(0);
    let i = 0;

    while (i < current.len()) {
      let block = current[i];
      let instructions = block.instructions;
      let removed = Array.new<I32>(0);
      let j = instructions.len() - 1;

      while (j >= 0) {
        let insn = instructions[j];

        if (_removable(insn) && (reads[insn.dst] == 0)) {
          let a = 0;

          while (a < insn.args.len()) {
            let arg = insn.args[a];
            reads[arg] = reads[arg] - 1;
            if (reads[arg] == 0) { again = true; }
            a++;
          }
          removed.push(j);
        }
        j--;
      }
      let kept = (removed.len() > 0)
        ? _rebuilt(block, _without(instructions, removed), block.terminator)
        : block;
      out.push(kept);
      i++;
    }
    current = out;
  }
  current
};

export let cleanupFunction = fn(function: Function): Function {
  let count = function.registers.len();
  _kinds = Array.new<I32>(count);
  _values = Array.new<I32>(count);
  _copies = Array.new<I32>(count);
  _copied = Array.new<I32>(0);
  _known = Array.new<I32>(0);
  _copiesOf = Array.new<Array<I32>>(0);
  let i = 0;

  while (i < count) {
    _copies[i] = -1;
    _copiesOf.push(Array.new<I32>(0));
    i++;
  }

  let merged = _merged(function.blocks, function.entry);
  _reads = Array.new<I32>(count);
  _countReads(merged, _reads);
  let propagated = _propagateAll(merged);
  let reached = _reachable(propagated, function.entry);

  let reads = _reads;

  if (_anyChanged || (reached.len() != propagated.len())) {
    reads = Array.new<I32>(count);
    _countReads(reached, reads);
  }

  { ...function, blocks: _withoutDead(reached, reads) }
};
