package ir;

/** @file
 * Clean-up of a lowered function, after inlining. A block outside any try region that only a
 * jump from one other such block reaches joins the end of that block, so an inlined copy joins
 * the blocks around it. Within each block, a read of a register that a `Move` copied reads the
 * copy's source while neither changes, and an I32 or Bool operation of constants becomes a
 * constant; a branch on a constant becomes a jump. Blocks no path reaches are then removed, and
 * so is each instruction whose value is never read and that can neither trap nor have an effect.
 * Registers are not single-assignment, so what is known of a register is forgotten when it is
 * written, and so is every copy of it. */

import type { BasicBlock, Function, Instruction, Terminator } from ir.Model;
import { Op, Terminator, instructionAt } from ir.Model;
import { blockIndexes, normalSuccessors, terminatorRead } from ir.Cfg;

/* What is known of a register's value. These are I32 codes in a flat array rather than an enum,
 * as the per-register tables are rewritten on every instruction. */
// Nothing is known.
const _UNKNOWN = 0;
// An I32 constant, in `_values`.
const _INT = 1;
// A Bool constant, 0 or 1, in `_values`.
const _BOOL = 2;

/** What is known of each register in the block being cleaned (`_UNKNOWN`, `_INT` or `_BOOL`),
 * the constant when one is, and the registers known as either; the register each is a copy of
 * or -1, the registers that have been copies in the block, and by source register, those that
 * have been copies of it, some since written. */
let _kinds = Array.new<I32>(0);
let _values = Array.new<I32>(0);
let _known = Array.new<I32>(0);
let _copies = Array.new<I32>(0);
let _copied = Array.new<I32>(0);
let _copiesOf = Array.new<Array<I32>>(0);

/** Forgets what is known of `register`, which is written, and that any register is a copy of
 * it. */
let _forget = fn(register: I32) {
  _kinds[register] = _UNKNOWN;
  _copies[register] = -1;

  let copies = _copiesOf[register];
  if (copies.len() == 0) { return null; }

  for (copy in copies) {
    if (_copies[copy] == register) { _copies[copy] = -1; }
  }
  _copiesOf[register] = Array.new<I32>(0);
  null
};

// Forgets everything known, at the start of a block.
let _forgetAll = fn() {
  for (register in _copied) {
    _copies[register] = -1;
  }
  _copied = Array.new<I32>(0);

  for (register in _known) {
    _kinds[register] = _UNKNOWN;
  }
  _known = Array.new<I32>(0);
  null
};

/** Returns the register `register`'s value is read from; the source of the copy it is, or
 * itself. */
let _source = fn(register: I32): I32 { (_copies[register] >= 0) ? _copies[register] : register };

// Returns `block` with `instructions` and `terminator` in place of its own.
let _rebuilt = fn(
  block: BasicBlock, instructions: Array<Instruction>, terminator: Terminator
): BasicBlock {
  { ...block, instructions, terminator }
};

/** Returns `blocks` with each block outside any try region that only a jump from one other such
 * block reaches, other than the entry, joined onto the end of that block. */
let _merged = fn(blocks: Array<BasicBlock>, entry: I32): Array<BasicBlock> {
  let indexes = blockIndexes(blocks);
  let count = blocks.len();
  let entries = Array.new<I32>(count);
  let outside = Array.new<Bool>(count);
  let code = Array.new<Array<Instruction>>(0);
  let lasts = Array.new<Terminator>(0);

  // The entry and the catch blocks are entered other than by a jump, so never join another.
  entries[indexes[entry]] = 2;

  for (i, block in blocks) {
    for (target in normalSuccessors(block.terminator)) {
      entries[indexes[target]] = entries[indexes[target]] + 1;
    }
    if (block.handler != null) { entries[indexes[block.handler.target]] = 2; }
    code.push(block.instructions);
    lasts.push(block.terminator);
    outside[i] = block.handler == null;
  }

  let gone = Array.new<Bool>(count);
  let joined = false;
  let i = 0;

  while (i < count) {
    let joining = !gone[i] && outside[i];
    let copied = false;

    while (joining) {
      joining = false;

      match (lasts[i]) {
        Jump(target) => {
          let next = indexes[target];

          if ((next != i) && (entries[next] == 1) && outside[next]) {
            // The block's own instructions are copied once, so a chain joins in linear time.
            if (!copied) {
              code[i] = code[i].copy();
              copied = true;
            }
            code[i].appendFrom(code[next], 0);
            lasts[i] = lasts[next];
            gone[next] = true;
            joined = true;
            joining = true;
          }
        },
        _ => {},
      }
    }
    i++;
  }
  if (!joined) { return blocks; }

  let out = Array.new<BasicBlock>(0);

  for (i, block in blocks) {
    if (!gone[i]) { out.push(_rebuilt(block, code[i], lasts[i])); }
  }
  out
};

/** Returns the I32 that the I32 operation `op` computes from `left` and `right`, with the VM's
 * wrapping and shift counts, which Jello's own operators share. */
let _intResult = fn(op: Op, left: I32, right: I32): I32 {
  match (op) {
    Add => left + right,
    Sub => left - right,
    Mul => left * right,
    BitAnd => left & right,
    BitOr => left | right,
    BitXor => left ^ right,
    Shl => left << right,
    Shr => left >> right,
    Neg => -left,
    _ => 0,
  }
};

/** Returns the constant `insn` computes when its operands, `args`, are known constants, as a
 * `ConstI32` or `ConstBool`, or null. Operations that may trap are never folded. */
let _folded = fn(insn: Instruction, args: Array<I32>): ?Instruction {
  let n = args.len();
  let ints = n > 0;
  let bools = n > 0;

  for (arg in args) {
    if (_kinds[arg] != _INT) { ints = false; }
    if (_kinds[arg] != _BOOL) { bools = false; }
  }
  if (!ints && !bools) { return null; }

  let op = insn.op;
  let int = match (op) { Add, Sub, Mul, BitAnd, BitOr, BitXor, Shl, Shr, Neg => ints, _ => false };
  let bool = match (op) { Eq => true, Lt => ints, Not => bools, _ => false };
  if (!int && !bool) { return null; }

  let left = _values[args[0]];
  let right = (n > 1) ? _values[args[1]] : 0;
  let value = int ? _intResult(op, left, right) : match (op) {
    Eq => (left == right) ? 1 : 0,
    Lt => (left < right) ? 1 : 0,
    _ => 1 - left,
  };
  instructionAt(int ? Op.ConstI32 : Op.ConstBool, insn.dst, [], value, insn.node)
};

// Counts in `reads` each read of a register by `blocks`' instructions and terminators.
let _countReads = fn(blocks: Array<BasicBlock>, reads: Array<I32>) {
  for (block in blocks) {
    for (insn in block.instructions) {
      for (arg in insn.args) {
        reads[arg] = reads[arg] + 1;
      }
    }
    let last = terminatorRead(block.terminator);
    if (last >= 0) { reads[last] = reads[last] + 1; }
  }
  null
};

// How often each register of the function being cleaned is read, before propagation.
let _reads = Array.new<I32>(0);

/** Checks whether every read of `copy` in the function is by `instructions` after index `at`, or
 * by their block's `terminator`, before `copy` or `source` is written again. The `Move` at `at`
 * is then left unread once they read `source`, so propagating the copy removes it rather than
 * keeping both registers live, which would stop the allocator coalescing them. */
let _onlyReadAfter = fn(
  copy: I32, source: I32, instructions: Array<Instruction>, at: I32, terminator: Terminator
): Bool {
  let seen = 0;
  let j = at + 1;

  while ((j < instructions.len()) && (seen < _reads[copy])) {
    let insn = instructions[j];

    for (arg in insn.args) {
      if (arg == copy) { seen++; }
    }
    if ((insn.dst == copy) || (insn.dst == source)) { return seen == _reads[copy]; }
    j++;
  }
  if ((seen < _reads[copy]) && (terminatorRead(terminator) == copy)) { seen++; }
  seen == _reads[copy]
};

// Whether `_propagated` or `_terminator` changed what it was given, in the block being cleaned.
let _changed = false;

/** Returns instruction `at` of `instructions` with its reads through copies and its constant
 * folded, and records what it makes known of its destination.
 * @param terminator  the terminator of the block of `instructions` */
let _propagated = fn(
  instructions: Array<Instruction>, at: I32, terminator: Terminator
): Instruction {
  let insn = instructions[at];
  let args = insn.args;
  let copied = false;

  for (arg in args) {
    if (_copies[arg] >= 0) { copied = true; }
  }
  let read = copied ? args.map(_source) : args;

  let dst = insn.dst;
  let folded = _folded(insn, read);
  let out = (folded != null)
    ? folded
    : (copied ? instructionAt(insn.op, dst, read, insn.imm, insn.node) : insn);
  if (copied || (folded != null)) { _changed = true; }
  if (dst < 0) { return out; }

  _forget(dst);

  match (out.op) {
    ConstI32 => {
      _kinds[dst] = _INT;
      _values[dst] = out.imm;
      _known.push(dst);
    },
    ConstBool => {
      _kinds[dst] = _BOOL;
      _values[dst] = out.imm;
      _known.push(dst);
    },
    Move when (read[0] != dst) => {
      if (_kinds[read[0]] != _UNKNOWN) {
        _kinds[dst] = _kinds[read[0]];
        _values[dst] = _values[read[0]];
        _known.push(dst);
      }

      if (_onlyReadAfter(dst, read[0], instructions, at, terminator)) {
        _copies[dst] = read[0];
        _copied.push(dst);
        _copiesOf[read[0]].push(dst);
      }
    },
    _ => {},
  }
  out
};

// Returns `terminator` reading through copies, and a branch on a constant as a jump.
let _terminator = fn(terminator: Terminator): Terminator {
  let read = terminatorRead(terminator);
  if (read < 0) { return terminator; }

  let source = _source(read);

  match (terminator) {
    Branch(_, thenTarget, elseTarget) when (_kinds[source] == _BOOL) => {
      _changed = true;
      Terminator.Jump((_values[source] != 0) ? thenTarget : elseTarget)
    },
    _ when (source == read) => terminator,
    Branch(_, thenTarget, elseTarget) => {
      _changed = true;
      Terminator.Branch(source, thenTarget, elseTarget)
    },
    ReturnValue(_) => {
      _changed = true;
      Terminator.ReturnValue(source)
    },
    Throw(_, node) => {
      _changed = true;
      Terminator.Throw(source, node)
    },
    _ => terminator,
  }
};

// Whether `_propagateAll` changed any block.
let _anyChanged = false;

// Returns `blocks` with copies and constants propagated through each.
let _propagateAll = fn(blocks: Array<BasicBlock>): Array<BasicBlock> {
  let out = Array.new<BasicBlock>(0);
  _anyChanged = false;

  for (block in blocks) {
    _forgetAll();
    _changed = false;

    let code = Array.new<Instruction>(0);

    for (j, _ in block.instructions) {
      code.push(_propagated(block.instructions, j, block.terminator));
    }
    let last = _terminator(block.terminator);

    out.push(_changed ? _rebuilt(block, code, last) : block);
    if (_changed) { _anyChanged = true; }
  }
  out
};

/** Returns the blocks of `blocks` a path from block `entry` reaches, through jumps, branches and
 * the handlers of try regions, or `blocks` when it reaches all of them. */
let _reachable = fn(blocks: Array<BasicBlock>, entry: I32): Array<BasicBlock> {
  let indexes = blockIndexes(blocks);
  let seen = Array.new<Bool>(blocks.len());
  let pending = [indexes[entry]];
  seen[indexes[entry]] = true;
  let reached = 1;

  while (pending.len() > 0) {
    let block = blocks[pending.pop()];
    let next = Array.new<I32>(0);

    for (target in normalSuccessors(block.terminator)) {
      next.push(indexes[target]);
    }
    // A block in a try region names its catch block, whether or not it can still throw.
    if (block.handler != null) { next.push(indexes[block.handler.target]); }

    for (successor in next) {
      if (!seen[successor]) {
        seen[successor] = true;
        pending.push(successor);
        reached++;
      }
    }
  }
  if (reached == blocks.len()) { return blocks; }

  let out = Array.new<BasicBlock>(0);

  for (i, block in blocks) {
    if (seen[i]) { out.push(block); }
  }
  out
};

/** Checks whether `insn` may be removed when its value is never read; it neither traps nor has
 * an effect beyond defining its destination. */
let _removable = fn(insn: Instruction): Bool {
  match (insn.op) {
    ConstBool, ConstI32, ConstI64, ConstFloat, ConstBytes, ConstAtom, ConstNull, ConstFunction,
    Move, Add, Sub, Mul, Shl, Shr, BitAnd, BitOr, BitXor, Neg, Not, Eq, Lt, LtU,
    Sext, Trunc, Zext, Box, KindOf, IsEnum, IsNull, ListNil, ListIsNil,
    TupleNew, EnumNew, ObjectNew, GlobalGet =>
      insn.dst >= 0,
    _ => false,
  }
};

// Returns `instructions` without those at the indexes in `removed`, which is descending.
let _without = fn(instructions: Array<Instruction>, removed: Array<I32>): Array<Instruction> {
  let kept = Array.new<Instruction>(0);
  let r = removed.len() - 1;

  for (j, insn in instructions) {
    if ((r >= 0) && (removed[r] == j)) {
      r--;
    } else {
      kept.push(insn);
    }
  }
  kept
};

/** Returns `blocks` without the removable instructions whose value is never read, sweeping again
 * while removing one leaves another unread in a block swept before.
 * @param reads  how often each register is read by `blocks` */
let _withoutDead = fn(blocks: Array<BasicBlock>, reads: Array<I32>): Array<BasicBlock> {
  let current = blocks;
  let again = true;

  while (again) {
    again = false;
    let out = Array.new<BasicBlock>(0);

    for (block in current) {
      let instructions = block.instructions;
      let removed = Array.new<I32>(0);
      // Backwards, so a chain of unread values in one block goes in one sweep.
      let j = instructions.len() - 1;

      while (j >= 0) {
        let insn = instructions[j];

        if (_removable(insn) && (reads[insn.dst] == 0)) {
          for (arg in insn.args) {
            reads[arg] = reads[arg] - 1;
            if (reads[arg] == 0) { again = true; }
          }
          removed.push(j);
        }
        j--;
      }
      let kept = (removed.len() > 0)
        ? _rebuilt(block, _without(instructions, removed), block.terminator)
        : block;
      out.push(kept);
    }
    current = out;
  }
  current
};

/** Cleans up `function` (see the file comment).
 * @return the cleaned function; its registers, parameters and entry are unchanged */
export let cleanupFunction = fn(function: Function): Function {
  let count = function.registers.len();
  _kinds = Array.new<I32>(count);
  _values = Array.new<I32>(count);
  _copies = Array.new<I32>(count);
  _copied = Array.new<I32>(0);
  _known = Array.new<I32>(0);
  _copiesOf = Array.new<Array<I32>>(0);
  let i = 0;

  while (i < count) {
    _copies[i] = -1;
    _copiesOf.push(Array.new<I32>(0));
    i++;
  }

  let merged = _merged(function.blocks, function.entry);
  _reads = Array.new<I32>(count);
  _countReads(merged, _reads);
  let propagated = _propagateAll(merged);
  let reached = _reachable(propagated, function.entry);

  // Propagation and pruning change who reads what, so the counts are taken again if either did.
  let reads = _reads;

  if (_anyChanged || (reached.len() != propagated.len())) {
    reads = Array.new<I32>(count);
    _countReads(reached, reads);
  }

  { ...function, blocks: _withoutDead(reached, reads) }
};
