        _emit(Op.Unbox, dst, [value], 0);
        return dst;
      }
      if ((valueOf(id) == 1) || (_cellOf(operand) >= 0)) { _emit(Op.NullCheck, -1, [value], 0); }
      value
    },
    Block => _lowerBlock(id),
    If => _if(id),
    Try => _try(id, true),
    And, Or => _shortCircuit(id),
    Eq when (typeOf(childOf(id, 0)) == TYPE_BOOL) => _boolEqual(id),
    Div, Rem => _divide(id),
    Shr when (_wideUnsigned(typeOf(id))) => _logicalShift(id),
    Eq, Lt, Gt, Le, Ge when (isFloatType(typeOf(childOf(id, 0)))) => _float(id),
    Neg when (typeOf(id) == TYPE_F16) => _float(id),
    BytesConcatMany => _joined(id),
