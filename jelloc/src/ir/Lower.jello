let _convert = fn(id: I32): I32 {
  let source = typeOf(childOf(id, 0));
  let target = typeOf(id);
  let value = _expr(childOf(id, 0));
  let nullable = match (kindOf(target)) { Null => isObject(innerOf(target)), _ => false };
  if (isObject(target) || nullable) { return value; }
  if (isFloatType(source) || isFloatType(target)) { return _floatConvert(source, target, value); }
  let wideSource = integerBits(source) == 64;
  let wide = integerBits(target) == 64;
  if (wideSource == wide) { return wide ? value : _normalised(target, value); }
  let dst = _fresh(target);

  if (wide) {
    _emit(source == TYPE_U32 ? Op.Zext : Op.Sext, dst, [value], 0);
    return dst;
  }
  _emit(Op.Trunc, dst, [value], 0);
  _normalised(target, dst)
};

let _byMinusOne = fn(remainder: Bool, ty: I32, left: I32): I32 {
  if (remainder) { return _widened(ty, _i32(0)); }
  let dst = _fresh(ty);
  _emit(Op.Neg, dst, [left], 0);
  dst
};

let _divide = fn(id: I32): I32 {
  let ty = typeOf(id);
  if (isFloatType(ty)) { return _float(id); }
  let divisor = childOf(id, 1);
  let remainder = match (opOf(id)) { Rem => true, _ => false };

  if (_isNarrow(ty) || _wideUnsigned(ty)) {
    let operands = _values(id, 0);
    let dst = _fresh(ty);
    _emit(_isNarrow(ty) ? (remainder ? Op.Rem : Op.Div) : (remainder ? Op.RemU : Op.DivU), dst, operands, 0);
    return _normalised(ty, dst);
  }
  let op = remainder ? Op.Rem : Op.Div;
  let constant = match (opOf(divisor)) { I32, I64 => true, _ => false };
  let minusOne = constant && (valueOf(divisor) == -1) && ((ty == TYPE_I32) || (auxOf(divisor) == -1));
  let left = _expr(childOf(id, 0));
  let right = _expr(divisor);
  if (minusOne) { return _byMinusOne(remainder, ty, left); }
  let result = _fresh(ty);

  if (constant) {
    _emit(op, result, [left, right], 0);
    return result;
  }
  let isMinusOne = _fresh(TYPE_BOOL);
  _emit(Op.Eq, isMinusOne, [right, _widened(ty, _i32(-1))], 0);
  let wrapBlock = _nextBlock;
  let divideBlock = wrapBlock + 1;
  let joinBlock = wrapBlock + 2;
  _nextBlock += 3;
  _end(Terminator.Branch(isMinusOne, wrapBlock, divideBlock), wrapBlock);
  _move(result, _byMinusOne(remainder, ty, left));
  _end(Terminator.Jump(joinBlock), divideBlock);
  _emit(op, result, [left, right], 0);
  _end(Terminator.Jump(joinBlock), joinBlock);
  result
};

let _arrayLiteral = fn(id: I32): I32 {
  let items = _values(id, 0);
  let array = _fresh(typeOf(id));
  _emit(Op.ArrayNew, array, [_i32(items.len() as I32)], 0);
  let i = 0;

  while (i < items.len()) {
    _emit(Op.ArraySet, -1, [array, _i32(i as I32), items[i]], 0);
    i++;
  }
  array
};

let _bytesFormat = fn(code: I32): I32 {
  (segmentWidth(code) == 16 ? 0 : (code & BITS_FLOAT) != 0 ? 6 : 2) + ((code & BITS_BIG) != 0 ? 1 : 0)
};

let _bitsPack = fn(id: I32): I32 {
  let values = Array.new<I32>(0);
  let fixed = valueOf(id);
  let rest = -1;
  let i = 0;

  while (i < childCount(id)) {
    values.push(_expr(childOf(childOf(id, i), 0)));
    if (segmentWidth(auxOf(childOf(id, i))) == 0) { rest = values[i]; }
    i++;
