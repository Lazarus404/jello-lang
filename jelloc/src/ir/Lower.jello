};

let _exit = fn(terminator: Terminator) { _end(terminator, -1) };

let _while = fn(id: I32) {
  let conditionBlock = _nextBlock;
  let bodyBlock = conditionBlock + 1;
  let exitBlock = conditionBlock + 2;
  _nextBlock += 3;
  _end(Terminator.Jump(conditionBlock), conditionBlock);
  _branch(childOf(id, 0), bodyBlock, exitBlock, bodyBlock);
  let outerBreak = _breakTarget;
  let outerContinue = _continueTarget;
  _breakTarget = exitBlock;
  _continueTarget = conditionBlock;
  _lowerBlock(childOf(id, 1));
  _breakTarget = outerBreak;
  _continueTarget = outerContinue;
  _end(Terminator.Jump(conditionBlock), exitBlock);
  null
};

let _doWhile = fn(id: I32) {
  let bodyBlock = _nextBlock;
  let conditionBlock = bodyBlock + 1;
  let exitBlock = bodyBlock + 2;
  _nextBlock += 3;
  _end(Terminator.Jump(bodyBlock), bodyBlock);
  let outerBreak = _breakTarget;
  let outerContinue = _continueTarget;
  _breakTarget = exitBlock;
  _continueTarget = conditionBlock;
  _lowerBlock(childOf(id, 1));
  _breakTarget = outerBreak;
  _continueTarget = outerContinue;
  _end(Terminator.Jump(conditionBlock), conditionBlock);
  _branch(childOf(id, 0), bodyBlock, exitBlock, exitBlock);
  null
};

let _statementAt: (I32) -> Bool = fn(_id) { false };

let _restart = fn(id: I32) {
  let args = _values(id, 0);
  let i = 0;

  while (i < args.len()) {
    let held = indexOf(_params, args[i]);
    if ((held >= 0) && (held < i) && (args[held] != _params[held])) { args[i] = _copy(typeOf(childOf(id, i)), args[i]); }
    i++;
  }
  i = 0;

  while (i < args.len()) {
    if (args[i] != _params[i]) { _move(_params[i], args[i]); }
    i++;
  }
  _exit(Terminator.Jump(_start))
};

_tail = fn(value, result, join) {
  let outer = _node;
  _node = value;

  match (opOf(value)) {
    If, IfStatement when (_chains(value, result)) => {
      if (!_decided(value, result, join)) {
        let thenBlock = _nextBlock;
        let otherwise = childCount(value) == 3;
        _nextBlock += otherwise ? 2 : 1;
        _branch(childOf(value, 0), thenBlock, otherwise ? thenBlock + 1 : join, thenBlock);
        _tail(childOf(value, 1), result, join);

        if (otherwise) {
          _open(thenBlock + 1);
          _tail(childOf(value, 2), result, join);
        }
      }
    },
    Block when ((auxOf(value) == 1) || (result < 0)) => {
      if (_statements(value)) { _tail(lastChild(value), result, join); } else if (result == _DISCARDED) { _end(Terminator.Jump(join), -1); } else { _open(-1); }
    },
    Call when ((result == _RETURNED) && (valueOf(value) == _self) && (_handler == null)) => _restart(value),
    _ when (result == _RETURNED) => _exit(Terminator.ReturnValue(_expr(value))),
    _ when (result == _DISCARDED) => {
      _expr(value);
      _end(Terminator.Jump(join), -1)
    },
    _ => {
      _move(result, _expr(value));
      _end(Terminator.Jump(join), -1)
    },
  };
  _node = outer;
  null
};

let _returned = fn(id: I32): Null { _start < 0 ? _exit(Terminator.ReturnValue(_expr(id))) : _tail(id, _RETURNED, -1) };

let _ifStatement = fn(id: I32) {
  let joinBlock = _nextBlock;
  _nextBlock += 1;
  _tail(id, _DISCARDED, joinBlock);
  _open(joinBlock)
};

_statement = fn(id) {
  let outer = _node;
  _node = id;
  let done = _statementAt(id);
  _node = outer;
  done
};

_statementAt = fn(id) {
  match (opOf(id)) {
    Declare => {
      let i = 0;

      while (i < childCount(id)) {
        _bind(childOf(id, i));
        i++;
      } null
    },
    Expression => {
      _expr(childOf(id, 0));
      null
    },
    Return => _returned(childOf(id, 0)),
    Throw => _exit(Terminator.Throw(_expr(childOf(id, 0)), id)),
    Break => _exit(Terminator.Jump(_breakTarget)),
    Continue => _exit(Terminator.Jump(_continueTarget)),
    While => auxOf(id) == 0 ? _while(id) : _doWhile(id),
    IfStatement => _ifStatement(id),
    TryStatement => {
      _try(id, false);
      null
    },
    Block => {
      _lowerBlock(id);
      null
    },
    _ => {
      internalError("invalid HIR statement op");
      null
    },
  };
  true
};

_lowerBlock = fn(id) { _statements(id) ? _expr(lastChild(id)) : -1 };

let _usesOf = fn(binding: I32): I32 { binding < _uses.len() ? _uses[binding] : 0 };

let _use = fn(binding: I32, flag: I32) {
  while (_uses.len() <= binding) {
    _uses.push(0);
    _lastRead.push(-1);
  }
  _uses[binding] = _uses[binding] | flag;
  null
};

let _markUses: (I32, I32) -> Null = fn(_id, _expression) { null };
_markUses = fn(id, expression) {
  let at = _walked;
  _walked++;
  let reboxes = false;

  let sequential = match (opOf(id)) {
    Block, If, IfStatement, While, Try, TryStatement, Let, Const, Declare, Expression, Return, Throw, SetGlobal, InitGlobal, And, Or => true,
    Assign => {
      let overtakes = (expression >= 0) && (valueOf(id) < _lastRead.len()) && (_lastRead[valueOf(id)] > expression);
      _use(valueOf(id), overtakes ? _ASSIGNED | _OVERTAKEN : _ASSIGNED);
      true
    },
    Local => {
      _use(valueOf(id), _UNBOXED);
      _lastRead[valueOf(id)] = at;
      true
    },
    FunctionRef => {
      reboxes = true;
      false
    },
    ToDynamic => {
      reboxes = _cellOf(childOf(id, 0)) < 0;
      false
    },
    Call => { if (valueOf(id) == _self) { _start = 1; } false },
    _ => false,
  };
  let inner = ((expression < 0) && !sequential && (childCount(id) > 1)) ? at : expression;
  let i = 0;

  while (i < childCount(id)) {
    let child = childOf(id, i);
    match (opOf(child)) { Local when (reboxes) => null, _ => _markUses(child, inner) };
    i++;
  }
  null
};

let _begin = fn(body: I32, self: I32) {
  _registers = Array.new<ValueType>(0);
  _instructions = Array.new<Instruction>(0);
  _blocks = Array.new<BasicBlock>(0);
  _block = 0;
  _nextBlock = 1;
  _bindings = Array.new<I32>(0);
  _uses = Array.new<I32>(0);
  _lastRead = Array.new<I32>(0);
  _walked = 0;
  _assignedRegisters = Array.new<Bool>(0);
  _boxes = Array.new<I32>(0);
  _targeted = [true];
  _reachable = true;
  _breakTarget = -1;
  _continueTarget = -1;
  _handler = null;
  _node = -1;
  _self = self;
  _start = -1;
  _markUses(body, -1)
};

let _function = fn(id: I32, functionId: I32): IrFunction {
  _begin(lastChild(id), functionId);
  let params = Array.new<I32>(0);
  let arguments = typeArgCount(typeOf(id));
  let i = 0;

  while (i < childCount(id) - 1) {
    let param = childOf(id, i);
    let capture = match (opOf(param)) { Capture => true, _ => false };
    let register = _fresh(capture ? TYPE_DYNAMIC : typeOf(param));
    params.push(register);
    if (capture) { _setBox(valueOf(param), register); }
    let bound = register;
    let cell = _isCell(valueOf(param));
    let used = (_usesOf(valueOf(param)) & (cell ? _UNBOXED | _ASSIGNED : _UNBOXED)) != 0;

    if (capture && used && (cell || !_isDynamic(param))) {
      bound = cell ? _freshCell(typeOf(param)) : _fresh(typeOf(param));
      _emit(Op.Unbox, bound, [register], 0);
    }
    _bindRegister(param, bound);
    i++;
  }

  if (_start >= 0) {
    _params = params;
    _nextBlock++;
    _end(Terminator.Jump(_start), _start);
  }
  _returned(lastChild(id));
  let captures = (params.len() as I32) - arguments;
  IrFunction.Function(functionId, params, captures, _registers, _valueType(innerOf(typeOf(id))), _blocks, 0)
};

let _reachableFunctions = fn(): Array<Bool> {
  let root = rootNode();
  let reached = [true];
  while (reached.len() < childCount(root)) { reached.push(false); }
  let pending = [lastChild(root)];

  while (pending.len() > 0) {
    let id = pending.pop();
    let names = match (opOf(id)) { Call, FunctionRef => valueOf(id) > 0, _ => false };

    if (names && !reached[valueOf(id)]) {
      reached[valueOf(id)] = true;
      pending.push(lastChild(childOf(root, valueOf(id) - 1)));
    }
    let i = 0;

    while (i < childCount(id)) {
      pending.push(childOf(id, i));
      i++;
    }
  }
  reached
};

let _partStarts = Array.new<I32>(0);

export let functionNode: (I32) -> I32 = fn(functionId) {
  let root = rootNode();
  let first = childCount(root);
  if (functionId >= first) { return childOf(lastChild(root), _partStarts[functionId - first]); }
  functionId == 0 ? lastChild(root) : childOf(root, functionId - 1)
};

let _PART_TYPES = 128;

let _part = fn(body: I32, start: I32, functionId: I32): Tuple<IrFunction, I32> {
  _begin(childOf(body, start), functionId);
  let types = Array.new<ValueType>(0);
  let counted = 0;
  let next = start;

  while ((next < childCount(body) - 1) && (types.len() < _PART_TYPES)) {
    if (next > start) { _markUses(childOf(body, next), -1); }
    _statement(childOf(body, next));
    next++;

    while (counted < _registers.len()) {
      internValueType(types, _registers[counted]);
      counted++;
    }
  }
  let result = _fresh(TYPE_NULL);
  _emit(Op.ConstNull, result, [], 0);
  _exit(Terminator.ReturnValue(result));
  (IrFunction.Function(functionId, [], 0, _registers, _valueType(TYPE_NULL), _blocks, 0), next)
};

let _findCells = fn() {
  let groups = Array.new<I32>(0);
  let assigned = Array.new<Bool>(0);
  let captured = Array.new<Bool>(0);

  let grow = fn(binding: I32) {
    while (groups.len() <= binding) {
      groups.push(groups.len() as I32);
      assigned.push(false);
      captured.push(false);
    }
    null
  };

  let find = fn(binding: I32): I32 {
    grow(binding);
    let group = binding;
    while (groups[group] != group) { group = groups[group]; }
    group
  };
  let count = nodeCount();
  let id = 0;

  while (id < count) {
    match (opOf(id)) {
      Assign => {
        assigned[find(valueOf(id))] = true;
        null
      },
      FunctionRef when (valueOf(id) > 0) => {
        let function = functionNode(valueOf(id));
        let first = typeArgCount(typeOf(function));
        let i = 0;

        while (i < childCount(id)) {
          let source = childOf(id, i);

          match (opOf(source)) {
            Local => {
              let group = find(valueOf(source));
              let copy = find(valueOf(childOf(function, first + i)));

              if (group != copy) {
                groups[copy] = group;
                assigned[group] = assigned[group] || assigned[copy];
              }
              captured[group] = true;
              null
            },
            _ => null,
          };
          i++;
        }
        null
      },
      _ => null,
    };
    id++;
  }
  _cells = Array.new<Bool>(0);
  let binding = 0;

  while (binding < groups.len()) {
    let group = find(binding);
    _cells.push(assigned[group] && captured[group]);
    binding++;
  }
  null
};

let _poolSizes = Array.new<I32>(0);

let _forgetIndexes = fn(indexes: Array<I32>, size: I32) {
  let i = 0;

  while (i < indexes.len()) {
    if (indexes[i] >= size) { indexes[i] = -1; }
    i++;
  }
  null
};

let _lowerBody = fn(functions: Array<IrFunction>, enums: Array<EnumSchema>, inParts: Bool, verified: I32): IrProgram {
  let root = rootNode();
  let body = lastChild(root);
  let first = childCount(root);
  let result = -1;

  if (!inParts) {
    _begin(body, -1);
    result = _lowerBlock(body);
  } else {
    let statements = childCount(body) - 1;
    let next = 0;
    _partStarts = [];

    while (next < statements) {
      _partStarts.push(next);
      let (part, after) = _part(body, next, first + (_partStarts.len() as I32) - 1);
      functions.push(part);
      next = after;
    }
    _begin(lastChild(body), -1);
    let part = 0;

    while (part < _partStarts.len()) {
      _emit(Op.Call, _fresh(TYPE_NULL), [], first + (part as I32));
      part++;
    }
    result = _expr(lastChild(body));
  }
  _end(Terminator.ReturnValue(result), -1);
  functions.push(IrFunction.Function(0, [], 0, _registers, _valueType(typeOf(body)), _blocks, 0));
  let globals = Array.new<ValueType>(0);
  let i = 0;

  while (i < globalCount()) {
    globals.push(_valueType(globalTypeOf(i)));
    i++;
  }
  let lowered = IrProgram.Program(functions, _pool, _wides, _floats, _atoms, enums, globals, _natives);
  verifyProgramFrom(lowered, false, verified);
  lowered
};

export let lowerProgram: (Hir) -> IrProgram = fn(program) {
  useHir(program);
  _pool = Array.new<Bytes>(0);
  _poolIndexes = Array.new<I32>(0);
  _wides = Array.new<I64>(0);
  _floats = Array.new<I64>(0);
  _atoms = Array.new<Bytes>(0);
  _atomIndexes = Array.new<I32>(0);
  let proto = findBytesId("__proto__");
  if (proto >= 0) { _internAt(_atomIndexes, _atoms, proto); }
  _natives = Array.new<Native>(0);
  _nativeIndexes = Array.new<I32>(0);
  while (_nativeIndexes.len() < nativeCount()) { _nativeIndexes.push(-1); }
  _enumIndexes = Array.new<I32>(0);
  let enumTypes = Array.new<I32>(0);
  let ty = 0;

  while (ty < typeCount()) {
    _enumIndexes.push(match (kindOf(ty)) {
      Enum, Record when (!isTemplateEnum(ty)) => {
        enumTypes.push(ty);
        (enumTypes.len() - 1) as I32
      }, _ => -1
    });
    ty++;
  }
  let enums = Array.new<EnumSchema>(0);
  let e = 0;

  while (e < enumTypes.len()) {
    let variants = Array.new<Array<ValueType>>(0);
    let tag = 0;

    while (tag < variantCount(enumTypes[e])) {
      let fields = Array.new<ValueType>(0);
      let f = 0;

      while (f < fieldCount(enumTypes[e], tag)) {
        fields.push(_valueType(fieldType(enumTypes[e], tag, f)));
        f++;
      }
      variants.push(fields);
      tag++;
    }
    enums.push(isRecord(enumTypes[e]) ? EnumSchema.Record(variants[0]) : EnumSchema.Enum(variants));
    e++;
  }
  _findCells();
  let root = rootNode();
  let functions = Array.new<IrFunction>(0);
  let reached = _reachableFunctions();
  let i = 0;

  while (i < childCount(root) - 1) {
    if (reached[i + 1]) { functions.push(_function(childOf(root, i), i + 1)); }
    i++;
  }
  _poolSizes = [_pool.len() as I32, _wides.len() as I32, _floats.len() as I32, _atoms.len() as I32, _natives.len() as I32];
  _lowerBody(functions, enums, false, 0)
};

export let relowerBodyInParts: (IrProgram) -> IrProgram = fn(earlier) {
  if (_poolSizes.len() == 0) { throw "no program body to lower again"; }
  Array.resize(_pool, _poolSizes[0]);
  Array.resize(_wides, _poolSizes[1]);
  Array.resize(_floats, _poolSizes[2]);
  Array.resize(_atoms, _poolSizes[3]);
  Array.resize(_natives, _poolSizes[4]);
  _forgetIndexes(_poolIndexes, _poolSizes[0]);
  _forgetIndexes(_atomIndexes, _poolSizes[3]);
  _forgetIndexes(_nativeIndexes, _poolSizes[4]);
  _poolSizes = [];

  match (earlier) { Program(functions, _, _, _, _, enums, _, _) => {
    let kept = Array.new<IrFunction>(0);
    while (kept.len() < functions.len() - 1) { kept.push(functions[kept.len()]); }
    _lowerBody(kept, enums, true, kept.len() as I32)
  } }
};
