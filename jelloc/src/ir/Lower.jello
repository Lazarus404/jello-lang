package ir;

/** @file
 * Lowering; translates the checked flat HIR (`frontend.hir.Hir`) into the IR (`ir.Model`). Each
 * HIR function becomes an IR function, and the program body becomes function 0. Expressions
 * are evaluated left to right into fresh typed registers; control flow (`if`, loops, `&&`,
 * `||`, `try`, division's -1 case) becomes basic blocks; Bool equality, `is` kind tests and
 * closure captures become the operations the VM provides. Code after the end of every path is
 * not emitted. The lowered program is verified (`ir.Verify`), optimised (`ir.Optimize`) and
 * handed to legalisation (`backend.jello.Legalize`). The function being lowered is built in
 * module state. */

import type { Hir } from frontend.hir.Hir;
import {
  BITS_BIG, BITS_FLOAT, KIND_ENUM, KIND_HANDLE, KIND_I32, KIND_I64, Kind, TYPE_ATOM, TYPE_BOOL,
  TYPE_BYTES, TYPE_DYNAMIC, TYPE_F16, TYPE_F32, TYPE_F64, TYPE_I32, TYPE_I64, TYPE_I8, TYPE_NULL,
  TYPE_U32, TYPE_U64, TYPE_U8, auxOf, wideValueOf, bytesOf, childCount, childOf, fieldCount,
  fieldType, innerOf, integerBits, isFloatKind, isFloatType, isHandle, isKind, isRecord,
  isReference, isTemplateEnum, kindOf, lastChild, leastValue, mostValue, opOf, rootNode, slotType,
  typeArg, typeArgCount, typeCount, findBytesId, globalCount, isObject, nodeCount, globalTypeOf,
  nativeCount, nativeLibraryOf, nativeNameOf, nativeTypeOf, segmentWidth, typeOf, useHir, valueOf,
  variantCount
} from frontend.hir.Hir;
import type {
  BasicBlock, EnumSchema, Function as IrFunction, Instruction, Native, Op, Program as IrProgram,
  Terminator, ThrowHandler, ValueType
} from ir.Model;
import {
  EnumSchema, Op, Terminator, ValueType, instructionAt, internValueType, nextFunctionId,
} from ir.Model;
import { blockMayThrow } from ir.Cfg;
import { verifyProgramFrom } from ir.Verify;
import { internalError } from support.Internal;

// The type of each register of the function being built, by register.
let _registers = Array.new<ValueType>(0);
// The instructions of the block being built.
let _instructions = Array.new<Instruction>(0);
/** The finished blocks of the function being built. A block is appended when its terminator is
 * known. */
let _blocks = Array.new<BasicBlock>(0);
// The ID of the block being built.
let _block = 0;
// The next unused block ID; block 0 is the entry.
let _nextBlock = 1;
// The register holding each binding, by binding ID, or -1.
let _bindings = Array.new<I32>(0);
// The `_uses` flag of a binding assigned somewhere in the function.
const _ASSIGNED = 1;
/** The `_uses` flag of a binding assigned after an earlier operand of the same expression read
 * it, while that read may still be waiting to be used. Every read of such a binding is a
 * copy. */
const _OVERTAKEN = 2;
/** The `_uses` flag of a binding whose value is read, not only re-boxed for a closure's capture or
 * a Dynamic; such a capture is unboxed on entry. */
const _UNBOXED = 4;
/** How the function uses each binding, by binding ID; a set of `_ASSIGNED`, `_OVERTAKEN` and
 * `_UNBOXED`, filled by `_markUses` before the function is lowered. */
let _uses = Array.new<I32>(0);
/** The position in the `_markUses` walk where each binding was last read, by binding ID, or
 * -1. */
let _lastRead = Array.new<I32>(0);
// The number of nodes the `_markUses` walk has visited, which is the next node's position.
let _walked = 0;
// Whether each register holds an assigned local, a `Let` that some assignment overwrites.
let _assignedRegisters = Array.new<Bool>(0);
/** The Dynamic register each capture arrived in, by binding ID, or -1, so a closure that
 * captures it again passes that box on. */
let _boxes = Array.new<I32>(0);
/** By binding ID, whether the binding lives in a cell, a one-element array; a local that a
 * closure captures and that it or any closure assigns, and every copy of it. The local and its
 * copies share the cell, so each sees every write. Filled by `_findCells` for the program. */
let _cells = Array.new<Bool>(0);
/** Whether each block, by ID, is the target of an emitted terminator. Code in any other block
 * never runs and is not emitted. */
let _targeted = Array.new<Bool>(0);
// Whether the block being built can run; `_emit` drops instructions while it cannot.
let _reachable = true;
// The block `break` jumps to in the innermost loop, or -1 outside a loop.
let _breakTarget = -1;
// The block `continue` jumps to in the innermost loop, or -1 outside a loop.
let _continueTarget = -1;
/** The handler of the innermost try being lowered, or null. Each block takes the one current
 * when it ends. */
let _handler: ?ThrowHandler = null;
// The IR ID of the function being lowered, or -1 for the program body.
let _self = -1;
// The function's parameter registers, in order.
let _params = Array.new<I32>(0);
/** The block after the function's entry, where a call of itself in return position starts again,
 * or -1 if it never calls itself; `_markUses` sets it. */
let _start = -1;
// The program's bytes pool, with each HIR bytes value added once on first use.
let _pool = Array.new<Bytes>(0);
// Each HIR bytes ID's index in `_pool`, or -1 while unused.
let _poolIndexes = Array.new<I32>(0);
// The program's I64 pool, with one entry per literal.
let _wides = Array.new<I64>(0);
// The program's F64 pool, with the bits of each literal.
let _floats = Array.new<I64>(0);
// The program's atoms, with each name added once on first use.
let _atoms = Array.new<Bytes>(0);
// Each HIR bytes ID's index in `_atoms`, or -1 while no atom has that name.
let _atomIndexes = Array.new<I32>(0);
/** Each HIR enum type's index among the program's enums, by type ID, or -1 for other types and
 * for generic enum templates. */
let _enumIndexes = Array.new<I32>(0);
/** The natives the program calls. A native that is declared but never called is not
 * imported. */
let _natives = Array.new<Native>(0);
// Each HIR native ID's index in `_natives`, or -1 while it is not called.
let _nativeIndexes = Array.new<I32>(0);

/** Returns the IR types of HIR type `ty`'s type arguments, in order; a tuple's elements or a
 * function's parameters. */
let _valueTypes = fn(ty: I32): Array<ValueType> {
  let items = Array.new<ValueType>(0);
  let i = 0;

  while (i < typeArgCount(ty)) {
    items.push(_valueType(typeArg(ty, i)));
    i++;
  }
  items
};

/** Returns the IR type of the registers that hold HIR type `ty`.
 * @param ty  the HIR type ID, with no inference variable or type parameter left */
let _valueType = fn(ty: I32): ValueType {
  match (kindOf(ty)) {
    Bool => ValueType.Bool,
    I32 => ValueType.I32,
    I64 => ValueType.I64,
    Bytes => ValueType.Bytes,
    Atom => ValueType.Atom,
    Array => ValueType.ArrayOf(_valueType(innerOf(ty))),
    List => ValueType.ListOf(_valueType(innerOf(ty))),
    /* A Null<T> of a reference T is a T whose null is the null pointer; any other is boxed,
     * and so is a bare null. */
    Null => ((innerOf(ty) >= 0) && isReference(innerOf(ty)))
      ? _valueType(innerOf(ty))
      : ValueType.Dynamic,
    Tuple => ValueType.TupleOf(_valueTypes(ty)),
    Function => ValueType.Function(_valueTypes(ty), _valueType(innerOf(ty))),
    // A function's parameter holds a Null<T> or an Array<T>.
    Optional, Rest => _valueType(slotType(ty)),
    Enum, Record => ValueType.Nominal(_enumIndexes[ty]),
    // A native handle, which only the checker tells apart from other Dynamic values.
    Dynamic, Abstract => ValueType.Dynamic,
    Object => ValueType.Object,
    /* The VM has one Bytes kind; that a buffer is never shared as Bytes is the checker's
     * guarantee. */
    ByteBuffer => ValueType.Bytes,
    Var, Param, Applied => {
      internalError("an inferred type reached lowering");
      ValueType.Dynamic
    },
    I8, I16, U8, U16, U32 => ValueType.I32,
    U64 => ValueType.I64,
    F16 => ValueType.F16,
    F32 => ValueType.F32,
    F64 => ValueType.F64,
  }
};

// Checks whether node `id`'s type lowers to Dynamic.
let _isDynamic = fn(id: I32): Bool {
  match (_valueType(typeOf(id))) { Dynamic => true, _ => false }
};

// Allocates and returns a register of IR type `ty`.
let _freshValue = fn(ty: ValueType): I32 {
  _registers.push(ty);
  _registers.len() - 1
};
// Allocates and returns a register for a value of HIR type `ty`.
let _fresh = fn(ty: I32): I32 { _freshValue(_valueType(ty)) };
// The HIR node being lowered, or -1; every instruction records it (see `Model.Instruction`).
let _node = -1;

/** Appends an `op` instruction with `dst` (or -1), `args` and `imm` to the block being built,
 * unless that block cannot run. */
let _emit = fn(op: Op, dst: I32, args: Array<I32>, imm: I32) {
  if (_reachable) { _instructions.push(instructionAt(op, dst, args, imm, _node)); }
  null
};
// Emits a `Move` of register `src` into register `dst`.
let _move = fn(dst: I32, src: I32) { _emit(Op.Move, dst, [src], 0) };

/** Returns the index in `table`, the bytes pool or the atoms, of HIR bytes ID `id`, adding the
 * value on first use; `indexes` maps each ID to its index, or -1. */
let _internAt = fn(indexes: Array<I32>, table: Array<Bytes>, id: I32): I32 {
  while (indexes.len() <= id) { indexes.push(-1); }

  if (indexes[id] < 0) {
    indexes[id] = table.len();
    table.push(bytesOf(id));
  }
  indexes[id]
};

/** Returns the immediate of the object access `id`; the index among the program's atoms of the key
 * it names, or -1 when it reads the key from a child. */
let _objectKey = fn(id: I32): I32 {
  valueOf(id) < 0 ? -1 : _internAt(_atomIndexes, _atoms, valueOf(id))
};

// Records that an emitted terminator targets block ID `block`, so code in it runs.
let _target = fn(block: I32) {
  while (_targeted.len() <= block) { _targeted.push(false); }
  _targeted[block] = true;
  null
};

/** Starts block `block` for the code that follows. It runs only if a terminator emitted so far
 * targets it; otherwise its code is dropped.
 * @param block  the block ID, or -1 for code that never runs */
let _open = fn(block: I32) {
  _instructions = Array.new<Instruction>(0);
  _block = block;
  _reachable = (block >= 0) && (block < _targeted.len()) && _targeted[block];
  null
};

/** Ends the block being built with `terminator`, under the current handler, and starts `next`.
 * A block that cannot run is dropped, and its terminator targets nothing.
 * @param terminator  how the block ends
 * @param next  the block the following code goes in, or -1 if it never runs */
let _end = fn(terminator: Terminator, next: I32) {
  if (_reachable) {
    _blocks.push({ id: _block, instructions: _instructions, terminator, handler: _handler });

    match (terminator) {
      Jump(target) => _target(target),
      Branch(_, thenTarget, elseTarget) => {
        _target(thenTarget);
        _target(elseTarget)
      },
      _ => null,
    };
  }
  _open(next)
};

/** Maps the binding that node `binding` declares to `register`.
 * @param binding  a node whose value is the binding ID; a binding, parameter, capture or `Try` */
let _bindRegister = fn(binding: I32, register: I32) {
  while (_bindings.len() <= valueOf(binding)) { _bindings.push(-1); }
  _bindings[valueOf(binding)] = register;
  null
};

// Records that `register` holds an assigned local.
let _markAssigned = fn(register: I32) {
  while (_assignedRegisters.len() <= register) { _assignedRegisters.push(false); }
  _assignedRegisters[register] = true;
  null
};

// Checks whether binding ID `binding` lives in a cell.
let _isCell = fn(binding: I32): Bool { (binding < _cells.len()) && _cells[binding] };

// Returns the binding that node `id` reads if it is a `Local` read of a cell, or -1.
let _cellOf = fn(id: I32): I32 {
  match (opOf(id)) {
    Local when (_isCell(valueOf(id))) => valueOf(id),
    _ => -1,
  }
};
// Returns a fresh register for a cell of HIR type `ty`'s values.
let _freshCell = fn(ty: I32): I32 { _freshValue(ValueType.ArrayOf(_valueType(ty))) };

// Records that `box` holds binding ID `binding` boxed, or its cell, for a closure to capture.
let _setBox = fn(binding: I32, box: I32) {
  while (_boxes.len() <= binding) { _boxes.push(-1); }
  _boxes[binding] = box;
  null
};

// Copies `register` into a fresh register of HIR type `ty` and returns the copy.
let _copy = fn(ty: I32, register: I32): I32 {
  let dst = _fresh(ty);
  _move(dst, register);
  dst
};

/** Lowers one binding of a `Declare`. A `Let` gets its own register, since assignments overwrite
 * it. An `InitGlobal` initialises its global with `GlobalSet`.
 * @param binding  the `Let`, `Const` or `InitGlobal` node */
let _bind = fn(binding: I32) {
  // A closure that captures its own binding needs the binding's cell before it is made.
  let local = match (opOf(binding)) { Let, Const => true, _ => false };

  if (local && _capturesItself(binding)) {
    let cell = _freshCell(typeOf(binding));
    _emit(Op.ArrayNew, cell, [_i32(1)], 0);
    let box = _fresh(TYPE_DYNAMIC);
    _emit(Op.Box, box, [cell], 0);
    _setBox(valueOf(binding), box);
    _bindRegister(binding, cell);
    _emit(Op.ArraySet, -1, [cell, _i32(0), _expr(childOf(binding, 0))], 0);
    return null;
  }
  let value = _expr(childOf(binding, 0));

  match (opOf(binding)) {
    InitGlobal => _emit(Op.GlobalSet, -1, [value], valueOf(binding)),
    // A cell is boxed once, for every closure that captures it.
    Let when (_isCell(valueOf(binding))) => {
      let cell = _freshCell(typeOf(binding));
      _emit(Op.ArrayNew, cell, [_i32(1)], 0);
      _emit(Op.ArraySet, -1, [cell, _i32(0), value], 0);
      let box = _fresh(TYPE_DYNAMIC);
      _emit(Op.Box, box, [cell], 0);
      _setBox(valueOf(binding), box);
      _bindRegister(binding, cell)
    },
    Let => {
      let register = _copy(typeOf(binding), value);
      if ((_usesOf(valueOf(binding)) & _ASSIGNED) != 0) { _markAssigned(register); }
      _bindRegister(binding, register)
    },
    /* Any other binding is never assigned, so it shares its value's register, unless that is
     * an assigned local's, whose current value it keeps in a copy. */
    _ => {
      let assigned = (value >= 0)
        && (value < _assignedRegisters.len())
        && _assignedRegisters[value];
      _bindRegister(binding, assigned ? _copy(typeOf(binding), value) : value)
    },
  }
};

/** Lowers the children of node `id` from child `start` on, left to right, and returns their
 * registers in order. */
let _values = fn(id: I32, start: I32): Array<I32> {
  let registers = Array.new<I32>(0);
  let i = start;

  while (i < childCount(id)) {
    registers.push(_expr(childOf(id, i)));
    i++;
  }
  registers
};

/** Lowers node `id` and returns its value boxed in a Dynamic register. A Dynamic value is boxed
 * already, and a read of a captured binding reuses the box it arrived in, unless that box holds
 * its cell. */
let _boxed = fn(id: I32): I32 {
  let box = match (opOf(id)) {
    Local when ((valueOf(id) < _boxes.len()) && (_cellOf(id) < 0)) => _boxes[valueOf(id)],
    _ => -1,
  };
  if (box >= 0) { return box; }
  let value = _expr(id);
  if (_isDynamic(id)) { return value; }
  _unaryOp(Op.Box, TYPE_DYNAMIC, value)
};

// Lowers closure capture `id` and returns it boxed; a binding in a cell passes its cell's box.
let _capturedBox = fn(id: I32): I32 {
  let binding = _cellOf(id);
  binding >= 0 ? _boxes[binding] : _boxed(id)
};

/** Lowers the statements of the block node `id`.
 * @return whether its tail runs; a tail after the end of every path is checked but never runs */
let _statements = fn(id: I32): Bool {
  let i = 0;

  while (i < childCount(id) - auxOf(id)) {
    _statement(childOf(id, i));
    i++;
  }
  _reachable && (auxOf(id) == 1)
};

/** Lowers the Bool node `condition` as control flow, ending the block being built: `&&`, `||`, `!`,
 * a constant and a block's tail branch on their parts rather than computing a Bool.
 * @param ifTrue  the block to go to when it holds
 * @param ifFalse  the block to go to when it does not
 * @param next  the block the following code goes in */
let _branch = fn(condition: I32, ifTrue: I32, ifFalse: I32, next: I32): Null {
  match (opOf(condition)) {
    And, Or => {
      let right = _nextBlock;
      _nextBlock += 1;

      match (opOf(condition)) {
        And => _branch(childOf(condition, 0), right, ifFalse, right),
        _ => _branch(childOf(condition, 0), ifTrue, right, right),
      };
      _branch(childOf(condition, 1), ifTrue, ifFalse, next)
    },
    Not => _branch(childOf(condition, 0), ifFalse, ifTrue, next),
    Bool => _end(Terminator.Jump(valueOf(condition) != 0 ? ifTrue : ifFalse), next),
    Block when (auxOf(condition) == 1) => _statements(condition)
      ? _branch(lastChild(condition), ifTrue, ifFalse, next)
      : _open(next),
    _ => _end(Terminator.Branch(_expr(condition), ifTrue, ifFalse), next),
  }
};

/** Lowers `condition` as `_branch` does, given that `head`, the test its chain of `&&` starts with,
 * holds. */
let _branchAfter = fn(condition: I32, head: I32, ifTrue: I32, ifFalse: I32, next: I32): Null {
  if (condition == head) { return _end(Terminator.Jump(ifTrue), next); }

  if (childOf(condition, 0) == head) {
    return _branch(childOf(condition, 1), ifTrue, ifFalse, next);
  }
  let right = _nextBlock;
  _nextBlock += 1;
  _branchAfter(childOf(condition, 0), head, right, ifFalse, right);
  _branch(childOf(condition, 1), ifTrue, ifFalse, next)
};

/** Returns the binding that the test `test` compares with an I32 constant, when it is a never
 * assigned I32 local, so that every arm reads the same value; else -1. */
let _keyOf = fn(test: I32): I32 {
  let local = childOf(test, 0);
  let binding = match (opOf(local)) { Local => valueOf(local), _ => -1 };
  let fixed = (binding >= 0)
    && (typeOf(local) == TYPE_I32)
    && !_isCell(binding)
    && ((_usesOf(binding) & _ASSIGNED) == 0);
  (fixed && match (opOf(childOf(test, 1))) { I32 => true, _ => false }) ? binding : -1
};

// Returns the test of a binding with a constant (`_keyOf`) that `condition` starts with, or -1.
let _head = fn(condition: I32): I32 {
  match (opOf(condition)) {
    And => _head(childOf(condition, 0)),
    Eq when (_keyOf(condition) >= 0) => condition,
    _ => -1,
  }
};

// The `result` of `_tail` for the value the function returns, and for a statement.
const _RETURNED = -1;
const _DISCARDED = -2;

/** Checks whether `value` is an `if` that `_tail` passes `result` on through: an `If` whose type
 * is the register's, or any in return position, or an `IfStatement` for a statement. */
let _chains = fn(value: I32, result: I32): Bool {
  match (opOf(value)) {
    If => (result == _RETURNED)
      || ((result >= 0) && (_valueType(typeOf(value)) == _registers[result])),
    IfStatement => result == _DISCARDED,
    _ => false,
  }
};

/** Lowers a chain of `if`s from `value`, as `_tail` does, as a decision tree, when two or more of
 * its first arms start by testing one binding with constants, as a match's arms test an enum's
 * tag; each constant is tested once, then only the arms that test it are tried, in order, without
 * that test. When they fail, what follows them runs. Each arm's value is lowered once.
 * @return whether it lowered the chain */
let _decided = fn(value: I32, result: I32, join: I32): Bool {
  let arms = Array.new<I32>(0);
  let heads = Array.new<I32>(0);
  let rest = value;
  let key = -1;

  while ((rest >= 0) && _chains(rest, result)) {
    let head = _head(childOf(rest, 0));
    if ((head < 0) || ((key >= 0) && (_keyOf(head) != key))) { break; }
    key = _keyOf(head);
    arms.push(rest);
    heads.push(head);
    rest = childCount(rest) == 3 ? childOf(rest, 2) : -1;
  }
  let n = arms.len();
  if (n < 2) { return false; }
  /* Each arm's entry is the block of its value when the test is all it has, which ends the arms
   * that test its constant, else a block of its own; failing, an arm goes on to the next arm
   * that tests its constant. */
  let bodies = _nextBlock;
  let after = bodies + n;
  _nextBlock = after + 1;
  let entries = Array.new<I32>(0);
  let nexts = Array.new<I32>(0);
  let firsts = Array.new<I32>(0);
  let later = Array.new<Bool>(0);

  for (a, arm in arms) {
    if (childOf(arm, 0) == heads[a]) {
      entries.push(bodies + a);
    } else {
      entries.push(_nextBlock);
      _nextBlock += 1;
    }
    nexts.push(-1);
    later.push(false);
  }
  let a = 0;

  while (a < n) {
    if (!later[a]) { firsts.push(a); }
    let b = a + 1;
    while ((b < n) && (valueOf(childOf(heads[b], 1)) != valueOf(childOf(heads[a], 1)))) { b++; }

    if (b < n) {
      nexts[a] = b;
      later[b] = true;
    }
    a++;
  }

  // The first test of each constant, in the order the arms make them.
  for (f, first in firsts) {
    let last = f + 1 == firsts.len();
    let next = last ? after : _nextBlock;
    if (!last) { _nextBlock += 1; }
    _end(Terminator.Branch(_expr(heads[first]), entries[first], next), last ? -1 : next);
  }

  for (a, arm in arms) {
    if (entries[a] != bodies + a) {
      _open(entries[a]);
      let otherwise = nexts[a] < 0 ? after : entries[nexts[a]];
      _branchAfter(childOf(arm, 0), heads[a], bodies + a, otherwise, -1);
    }
  }

  for (a, arm in arms) {
    _open(bodies + a);
    _tail(childOf(arm, 1), result, join);
  }
  _open(after);
  if (rest >= 0) { _tail(rest, result, join); } else { _end(Terminator.Jump(join), -1); }
  true
};

/** Lowers an `If` expression into one result register, then a join block (`_tail`).
 * @param id  the `If` node
 * @return the result register */
let _if = fn(id: I32): I32 {
  let result = _fresh(typeOf(id));
  let joinBlock = _nextBlock;
  _nextBlock += 1;
  _tail(id, result, joinBlock);
  _open(joinBlock);
  result
};

/** Lowers Bool `a == b` as `a ? b : !b`, since the VM compares only numbers. Both operands are
 * evaluated first, left to right.
 * @param id  the `Eq` node, with Bool operands
 * @return the result register */
let _boolEqual = fn(id: I32): I32 {
  let left = _expr(childOf(id, 0));
  let right = _expr(childOf(id, 1));
  let sameBlock = _nextBlock;
  let flipBlock = sameBlock + 1;
  let joinBlock = sameBlock + 2;
  _nextBlock += 3;
  _end(Terminator.Branch(left, sameBlock, flipBlock), sameBlock);
  let result = _fresh(TYPE_BOOL);
  _move(result, right);
  _end(Terminator.Jump(joinBlock), flipBlock);
  _emit(Op.Not, result, [right], 0);
  _end(Terminator.Jump(joinBlock), joinBlock);
  result
};

/** Lowers `a && b`, which evaluates `b` only when `a` is true, or `a || b`, which evaluates it
 * only when `a` is false. `a` is moved into the result, which `b` overwrites when it runs.
 * @param id  the `And` or `Or` node
 * @return the result register */
let _shortCircuit = fn(id: I32): I32 {
  let result = _fresh(typeOf(id));
  _move(result, _expr(childOf(id, 0)));
  let rightBlock = _nextBlock;
  let joinBlock = rightBlock + 1;
  _nextBlock += 2;
  _end(match (opOf(id)) {
    And => Terminator.Branch(result, rightBlock, joinBlock),
    _ => Terminator.Branch(result, joinBlock, rightBlock),
  }, rightBlock);
  _move(result, _expr(childOf(id, 1)));
  _end(Terminator.Jump(joinBlock), joinBlock);
  result
};

/** Returns the IR operation that computes HIR node `id`'s value into a fresh register from its
 * operands. `Gt` is `Lt` with its operands swapped, and `IsPresent` is `IsNull` negated, by
 * the caller. */
let _operation = fn(id: I32): Op {
  match (opOf(id)) {
    Bool => Op.ConstBool,
    I32 => Op.ConstI32,
    I64 => Op.ConstI64,
    Float => Op.ConstFloat,
    Bytes => Op.ConstBytes,
    Null => Op.ConstNull,
    Atom => Op.ConstAtom,

    Add => Op.Add,
    Sub => Op.Sub,
    Mul => Op.Mul,
    Shl => Op.Shl,
    Shr => Op.Shr,
    BitAnd => Op.BitAnd,
    BitOr => Op.BitOr,
    BitXor => Op.BitXor,
    Neg => Op.Neg,
    Not => Op.Not,
    Eq => Op.Eq,
    Lt, Gt => _wideUnsigned(typeOf(childOf(id, 0))) ? Op.LtU : Op.Lt,
    IsNull, IsPresent => Op.IsNull,

    ArrayNew => Op.ArrayNew,
    ArrayLen => Op.ArrayLen,
    ArrayGet => Op.ArrayGet,
    ArrayConcat => Op.ArrayConcat,
    ListNil => Op.ListNil,
    ListCons => Op.ListCons,
    ListHead => Op.ListHead,
    ListTail => Op.ListTail,
    ListIsNil => Op.ListIsNil,
    BytesNew => Op.BytesNew,
    BytesLen => Op.BytesLen,
    BytesGet => Op.BytesGet,
    BytesSlice => Op.BytesSlice,
    BytesConcat => Op.BytesConcat,
    BytesJoin => Op.BytesJoin,
    BytesEq => Op.BytesEq,

    Tuple => Op.TupleNew,
    TupleField => Op.TupleGet,
    EnumNew => Op.EnumNew,
    EnumTag => Op.EnumTag,
    EnumField => Op.EnumGet,
    ObjectNew => Op.ObjectNew,
    ObjectGet => Op.ObjectGet,
    ObjectHas => Op.ObjectHas,
    ObjectRemove => Op.ObjectRemove,
    ObjectCopy => Op.ObjectCopy,
    ObjectKeys => Op.ObjectKeys,

    Call => Op.Call,
    CallIndirect => Op.CallIndirect,
    CallNative => Op.CallNative,
    _ => {
      internalError("invalid HIR expression op");
      Op.Move
    },
  }
};

/** Returns the index among the program's natives of HIR native ID `native`, importing it on its
 * first call. */
let _nativeIndex = fn(native: I32): I32 {
  if (_nativeIndexes[native] < 0) {
    let ty = nativeTypeOf(native);
    let result = innerOf(ty);
    _natives.push({
      library: nativeLibraryOf(native),
      name: nativeNameOf(native),
      params: _valueTypes(ty),
      result: _valueType(result),
      void: result == TYPE_NULL,
    });
    _nativeIndexes[native] = _natives.len() - 1;
  }
  _nativeIndexes[native]
};

// The most parts one `BytesConcatMany` instruction joins, its window of consecutive registers.
const _JOIN_PARTS = 64;

/** Lowers the `BytesConcatMany` node `id` in runs of at most `_JOIN_PARTS` parts, each run after
 * the first joining the last's result first. A run is joined as soon as its parts are computed,
 * so a long join keeps few of them live.
 * @return the register of the joined Bytes */
let _joined = fn(id: I32): I32 {
  let joined = -1;
  let i = 0;

  while (i < childCount(id)) {
    let window = Array.new<I32>(0);
    if (joined >= 0) { window.push(joined); }

    while ((i < childCount(id)) && (window.len() < _JOIN_PARTS)) {
      window.push(_expr(childOf(id, i)));
      i++;
    }
    joined = _fresh(TYPE_BYTES);
    _emit(Op.BytesConcatMany, joined, window, 0);
  }
  joined
};

// Loads I32 constant `value` into a fresh register and returns it.
let _i32 = fn(value: I32): I32 {
  let dst = _fresh(TYPE_I32);
  _emit(Op.ConstI32, dst, Array.new<I32>(0), value);
  dst
};

/** Emits operation `op` of type `ty` on registers `left` and `right` into a fresh register and
 * returns it. */
let _binaryOp = fn(op: Op, ty: I32, left: I32, right: I32): I32 {
  let dst = _fresh(ty);
  _emit(op, dst, [left, right], 0);
  dst
};

/** Emits operation `op` of type `ty` on register `operand` into a fresh register and returns
 * it. */
let _unaryOp = fn(op: Op, ty: I32, operand: I32): I32 {
  let dst = _fresh(ty);
  _emit(op, dst, [operand], 0);
  dst
};
/** Emits I32 operation `op` on registers `left` and `right` into a fresh register and returns
 * it. */
let _arithmetic = fn(op: Op, left: I32, right: I32): I32 { _binaryOp(op, TYPE_I32, left, right) };
// Emits a `Convert` of register `value` to HIR type `ty` into a fresh register and returns it.
let _converted = fn(ty: I32, value: I32): I32 { _unaryOp(Op.Convert, ty, value) };

// Loads I64 constant `value` into a fresh register of HIR type `ty` and returns it.
let _i64 = fn(ty: I32, value: I64): I32 {
  _wides.push(value);
  let dst = _fresh(ty);
  _emit(Op.ConstI64, dst, Array.new<I32>(0), _wides.len() - 1);
  dst
};
// Emits an `ArrayLen` of register `array` into a fresh register and returns it.
let _length = fn(array: I32): I32 { _unaryOp(Op.ArrayLen, TYPE_I32, array) };
// Emits a `BytesLen` of register `bytes` into a fresh register and returns it.
let _bytesLength = fn(bytes: I32): I32 { _unaryOp(Op.BytesLen, TYPE_I32, bytes) };

/** Widens `value`, an I32 register, to the integer type `ty`.
 * @param ty  the HIR integer type
 * @param value  the I32 register
 * @return `value` itself for a type held in 32 bits, or a sign-extended I64 copy */
let _widened = fn(ty: I32, value: I32): I32 {
  if (integerBits(ty) != 64) { return value; }
  _unaryOp(Op.Sext, ty, value)
};

/** Checks whether `ty` is U32 or U64, whose values fill their register, so that comparison,
 * division and right shifts need the unsigned operations. */
let _wideUnsigned = fn(ty: I32): Bool { (ty == TYPE_U32) || (ty == TYPE_U64) };
// Checks whether `ty` is held in fewer bits than its register; I8, I16, U8 or U16.
let _isNarrow = fn(ty: I32): Bool { integerBits(ty) < 32 };

/** Returns `value`, an I32 register holding a result of type `ty`, with a narrow type's value
 * sign- or zero-extended again; wrapped to its width. Any other type's register is returned.
 * @param ty  the HIR type
 * @param value  the I32 register */
let _normalised = fn(ty: I32, value: I32): I32 {
  match (kindOf(ty)) {
    I8, I16 => {
      let shift = _i32(ty == TYPE_I8 ? 24 : 16);
      _arithmetic(Op.Shr, _arithmetic(Op.Shl, value, shift), shift)
    },
    U8, U16 => _arithmetic(Op.BitAnd, value, _i32(ty == TYPE_U8 ? 255 : 65535)),
    _ => value,
  }
};

/** Returns `dst`, the register of node `id`'s result, wrapped to the width of a narrow type; its
 * arithmetic needs it, while the bitwise operations and `Shr` keep a narrow value as it is. */
let _wrapped = fn(id: I32, dst: I32): I32 {
  if (!_isNarrow(typeOf(id))) { return dst; }
  match (opOf(id)) { Add, Sub, Mul, Shl, Neg => _normalised(typeOf(id), dst), _ => dst }
};

/** Lowers node `id` as `x as Dynamic` does; a U32 is boxed as the I64 of its value, so that it
 * reads back the same. */
let _toDynamic = fn(id: I32): I32 {
  if (typeOf(id) != TYPE_U32) { return _boxed(id); }
  let wide = _fresh(TYPE_I64);
  _emit(Op.Zext, wide, [_expr(id)], 0);
  let dst = _fresh(TYPE_DYNAMIC);
  _emit(Op.Box, dst, [wide], 0);
  dst
};

/** Lowers `a >> b` for U32 or U64; the arithmetic shift with the bits shifted in cleared,
 * `(a >> b) & ~((-1 << (w - 1 - b)) << 1)` for width `w`, which holds for every count modulo `w`.
 * @param id  the `Shr` node
 * @return the result register */
let _logicalShift = fn(id: I32): I32 {
  let ty = typeOf(id);
  let operands = _values(id, 0);
  let count = operands[1];
  let shifted = _binaryOp(Op.Shr, ty, operands[0], count);
  let ones = _widened(ty, _i32(-1));
  let room = _binaryOp(Op.Sub, ty, _widened(ty, _i32(integerBits(ty) - 1)), count);
  let high = _binaryOp(Op.Shl, ty, _binaryOp(Op.Shl, ty, ones, room), _widened(ty, _i32(1)));
  let mask = _binaryOp(Op.BitXor, ty, high, ones);
  _binaryOp(Op.BitAnd, ty, shifted, mask)
};

/** Compares `operands`, two registers of a float type the VM compares, as node `id`, an `Eq`,
 * `Lt`, `Gt`, `Le` or `Ge`, does. `a > b` is `b < a`, and `a <= b` is `a < b`, or else `a == b`,
 * so that NaN is neither less nor equal. */
let _floatCompare = fn(id: I32, operands: Array<I32>): I32 {
  let op = opOf(id);
  let swapped = match (op) { Gt, Ge => true, _ => false };
  let left = operands[swapped ? 1 : 0];
  let right = operands[swapped ? 0 : 1];
  let result = _fresh(TYPE_BOOL);
  _emit(match (op) { Eq => Op.Eq, _ => Op.Lt }, result, [left, right], 0);
  if (match (op) { Le, Ge => false, _ => true }) { return result; }
  let equal = _nextBlock;
  _nextBlock += 2;
  _end(Terminator.Branch(result, equal + 1, equal), equal);
  _emit(Op.Eq, result, [left, right], 0);
  _end(Terminator.Jump(equal + 1), equal + 1);
  result
};

/** Lowers node `id`, a comparison of floats, or an F16 division or negation, which the VM has
 * only for F32. F16 operands are exact in F32, and a quotient rounded to F32 and then to F16 is
 * the F16 quotient, as 24 bits are more than twice 11 and 2.
 * @return the result register */
let _float = fn(id: I32): I32 {
  let operands = _values(id, 0);

  if (typeOf(childOf(id, 0)) == TYPE_F16) {
    for (i, operand in operands) {
      operands[i] = _converted(TYPE_F32, operand);
    }
  }

  match (opOf(id)) {
    Div => {
      let f16 = typeOf(id) == TYPE_F16;
      let q = _binaryOp(Op.Div, f16 ? TYPE_F32 : typeOf(id), operands[0], operands[1]);
      f16 ? _converted(TYPE_F16, q) : q
    },
    Neg => {
      let dst = _fresh(TYPE_F32);
      _emit(Op.Neg, dst, operands, 0);
      _converted(TYPE_F16, dst)
    },
    _ => _floatCompare(id, operands),
  }
};

/** Traps as a float conversion out of range does when the Bool register `failed` holds, by
 * converting NaN. */
let _trapIf = fn(failed: I32) {
  let trap = _nextBlock;
  _nextBlock += 2;
  _end(Terminator.Branch(failed, trap, trap + 1), trap);
  let nan = _fresh(TYPE_F32);
  _emit(Op.ConstFloat, nan, Array.new<I32>(0), 2143289344);
  _converted(TYPE_I32, nan);
  _end(Terminator.Jump(trap + 1), trap + 1);
  null
};

/** Traps unless the Dynamic register `value` holds a native handle, as a value of an abstract
 * type must, or null when `nullable`; with NULL_DEREF for null and TYPE_MISMATCH for anything
 * else, by unboxing it as a Bool and then as an Atom, which no value is both of. */
let _checkHandle = fn(value: I32, nullable: Bool) {
  let kind = _unaryOp(Op.KindOf, TYPE_I32, value);
  let held = _binaryOp(Op.Eq, TYPE_BOOL, kind, _i32(KIND_HANDLE));
  let failed = _nextBlock;
  let done = failed + (nullable ? 2 : 1);
  _nextBlock = done + 1;
  _end(Terminator.Branch(held, done, failed), failed);

  if (nullable) {
    let absent = _unaryOp(Op.IsNull, TYPE_BOOL, value);
    _end(Terminator.Branch(absent, done, failed + 1), failed + 1);
  }
  _unaryOp(Op.Unbox, TYPE_BOOL, value);
  _unaryOp(Op.Unbox, TYPE_ATOM, value);
  _end(Terminator.Jump(done), done);
  null
};

/** Returns `value` after trapping (`_trapIf`) unless `offset`, its distance above its type's
 * least value, is at most `span`, unsigned; registers of one integer type. */
let _inRange = fn(value: I32, offset: I32, span: I32): I32 {
  _trapIf(_binaryOp(Op.LtU, TYPE_BOOL, span, offset));
  value
};

/** Converts `value`, an I64 register holding a U64, to the float type `target`. One above the
 * greatest I64 converts as half of it, with its lowest bit kept so that it rounds as the whole
 * does, doubled; through F32 for F16, which rounds twice.
 * @return the result register */
let _fromU64 = fn(target: I32, value: I32): I32 {
  let ty = target == TYPE_F16 ? TYPE_F32 : target;
  let result = _fresh(ty);
  let low = _nextBlock;
  _nextBlock += 3;
  _end(Terminator.Branch(_binaryOp(Op.Lt, TYPE_BOOL, value, _i64(TYPE_I64, 0)), low + 1, low), low);
  _emit(Op.Convert, result, [value], 0);
  _end(Terminator.Jump(low + 2), low + 1);
  let shifted = _binaryOp(Op.Shr, TYPE_I64, value, _i64(TYPE_I64, 1));
  let half = _binaryOp(Op.BitAnd, TYPE_I64, shifted, _i64(TYPE_I64, 9223372036854775807));
  let lowest = _binaryOp(Op.BitAnd, TYPE_I64, value, _i64(TYPE_I64, 1));
  let halved = _converted(ty, _binaryOp(Op.BitOr, TYPE_I64, half, lowest));
  _emit(Op.Add, result, [halved, halved], 0);
  _end(Terminator.Jump(low + 2), low + 2);
  target == TYPE_F16 ? _converted(TYPE_F16, result) : result
};

/** Converts `value`, an F32 or F64 register, to the integer type `target`, truncating towards
 * zero; a value out of the target's range traps. The VM checks an I32 or I64 target's, and a
 * narrower one's is checked after converting to I32, U32's after converting to I64. U64 from
 * 2^63 up converts as the I64 2^63 below it.
 * @return the result register */
let _toInteger = fn(target: I32, value: I32): I32 {
  match (kindOf(target)) {
    I32, I64 => _converted(target, value),
    I8, I16, U8, U16 => {
      let least = leastValue(target) as I32;
      let narrow = _converted(TYPE_I32, value);
      let offset = least == 0 ? narrow : _arithmetic(Op.Sub, narrow, _i32(least));
      _inRange(narrow, offset, _i32((mostValue(target) as I32) - least))
    },
    U32 => {
      let converted = _converted(TYPE_I64, value);
      let wide = _inRange(converted, converted, _i64(TYPE_I64, 4294967295));
      _unaryOp(Op.Trunc, TYPE_U32, wide)
    },
    _ => {
      let exact = _registers[value] == ValueType.F64 ? value : _converted(TYPE_F64, value);
      // 2^63, the least F64 that no I64 holds.
      let top = _fresh(TYPE_F64);
      _floats.push(4890909195324358656);
      _emit(Op.ConstFloat, top, Array.new<I32>(0), _floats.len() - 1);
      let result = _fresh(TYPE_U64);
      let low = _nextBlock;
      _nextBlock += 3;
      _end(Terminator.Branch(_binaryOp(Op.Lt, TYPE_BOOL, exact, top), low, low + 1), low);
      _emit(Op.Convert, result, [exact], 0);
      _trapIf(_binaryOp(Op.Lt, TYPE_BOOL, result, _i64(TYPE_I64, 0)));
      _end(Terminator.Jump(low + 2), low + 1);
      let above = _converted(TYPE_I64, _binaryOp(Op.Sub, TYPE_F64, exact, top));
      _emit(Op.Add, result, [above, _i64(TYPE_I64, -9223372036854775807 - 1)], 0);
      _end(Terminator.Jump(low + 2), low + 2);
      result
    },
  }
};

/** Lowers `as` between a float type and another number type. A conversion the VM lacks goes
 * through F32, which rounds F64 to F16 twice, or from a 64-bit integer to F16; U32 widens to I64
 * first, and U64 converts as `_fromU64` does. A float becomes an integer as `_toInteger`
 * converts it.
 * @param source  the operand's type
 * @param target  the result's type
 * @param value  the operand register
 * @return the result register */
let _floatConvert = fn(source: I32, target: I32, value: I32): I32 {
  if (!isFloatType(target)) {
    return _toInteger(target, source == TYPE_F16 ? _converted(TYPE_F32, value) : value);
  }
  if (source == TYPE_U64) { return _fromU64(target, value); }
  let operand = value;

  if (source == TYPE_U32) {
    operand = _fresh(TYPE_I64);
    _emit(Op.Zext, operand, [value], 0);
  }
  let wideSource = (integerBits(source) == 64) || (source == TYPE_U32) || (source == TYPE_F64);
  let viaF32 = ((target == TYPE_F16) && wideSource)
    || ((source == TYPE_F16) && (target == TYPE_F64));
  _converted(target, viaF32 ? _converted(TYPE_F32, operand) : operand)
};

/** Lowers a conversion between integer types, which wraps to the target's width; a 32-bit value
 * widens with `Sext`, or `Zext` from U32, and a 64-bit one narrows with `Trunc`.
 * @param id  the `Convert` node
 * @return the result register */
let _convert = fn(id: I32): I32 {
  let source = typeOf(childOf(id, 0));
  let target = typeOf(id);
  let value = _expr(childOf(id, 0));
  // Every Object type, nullable or not, is the VM's object type.
  let nullable = match (kindOf(target)) { Null => isObject(innerOf(target)), _ => false };
  if (isObject(target) || nullable) { return value; }
  if (isFloatType(source) || isFloatType(target)) { return _floatConvert(source, target, value); }
  let wideSource = integerBits(source) == 64;
  let wide = integerBits(target) == 64;
  if (wideSource == wide) { return wide ? value : _normalised(target, value); }
  let dst = _fresh(target);

  if (wide) {
    _emit(source == TYPE_U32 ? Op.Zext : Op.Sext, dst, [value], 0);
    return dst;
  }
  _emit(Op.Trunc, dst, [value], 0);
  _normalised(target, dst)
};

/** Computes `left / -1` or `left % -1`; `-left`, wrapping, or 0.
 * @param remainder  whether it is `%`
 * @param ty  the HIR integer type
 * @param left  the dividend register
 * @return the result register */
let _byMinusOne = fn(remainder: Bool, ty: I32, left: I32): I32 {
  if (remainder) { return _widened(ty, _i32(0)); }
  _unaryOp(Op.Neg, ty, left)
};

/** Lowers `a / b` or `a % b`. They truncate towards zero and trap on a zero divisor, and wrap as
 * Java's and Go's do; the minimum value divided by -1 is itself, with remainder 0, where the
 * VM's DIV and MOD trap. So a divisor that may be -1 is handled in a block of its own.
 * A constant divisor needs no test; -1 never reaches `Div` or `Rem`, and any other goes
 * straight to them.
 * @param id  the `Div` or `Rem` node
 * @return the result register */
let _divide = fn(id: I32): I32 {
  let ty = typeOf(id);
  if (isFloatType(ty)) { return _float(id); }
  let divisor = childOf(id, 1);
  let remainder = match (opOf(id)) { Rem => true, _ => false };

  /* A narrow quotient, even the minimum divided by -1, fits in 32 bits and wraps when
   * normalised; an unsigned division has no -1. */
  if (_isNarrow(ty) || _wideUnsigned(ty)) {
    let operands = _values(id, 0);
    let dst = _fresh(ty);
    let division = _isNarrow(ty)
      ? (remainder ? Op.Rem : Op.Div)
      : (remainder ? Op.RemU : Op.DivU);
    _emit(division, dst, operands, 0);
    return _normalised(ty, dst);
  }
  let op = remainder ? Op.Rem : Op.Div;
  let constant = match (opOf(divisor)) { I32, I64 => true, _ => false };
  // An I64 literal keeps its high word in aux; -1 is all ones in both words.
  let minusOne = constant
    && (valueOf(divisor) == -1)
    && ((ty == TYPE_I32) || (auxOf(divisor) == -1));
  let left = _expr(childOf(id, 0));
  let right = _expr(divisor);
  if (minusOne) { return _byMinusOne(remainder, ty, left); }

  let result = _fresh(ty);

  if (constant) {
    _emit(op, result, [left, right], 0);
    return result;
  }
  let isMinusOne = _fresh(TYPE_BOOL);
  _emit(Op.Eq, isMinusOne, [right, _widened(ty, _i32(-1))], 0);
  let wrapBlock = _nextBlock;
  let divideBlock = wrapBlock + 1;
  let joinBlock = wrapBlock + 2;
  _nextBlock += 3;
  _end(Terminator.Branch(isMinusOne, wrapBlock, divideBlock), wrapBlock);
  _move(result, _byMinusOne(remainder, ty, left));
  _end(Terminator.Jump(joinBlock), divideBlock);
  _emit(op, result, [left, right], 0);
  _end(Terminator.Jump(joinBlock), joinBlock);
  result
};

// The most elements of an array literal computed before they are stored.
const _LITERAL_CHUNK = 16;

/** Lowers an array literal `[a, b]`: computes its first `_LITERAL_CHUNK` elements, allocates its
 * length, stores them, then computes and stores the rest a chunk at a time, so that a long
 * literal keeps few elements live. Nothing can see the array before the literal ends, so
 * allocating it before the later elements are computed is not observable.
 * @param id  the `ArrayLiteral` node
 * @return the array register */
let _arrayLiteral = fn(id: I32): I32 {
  let n = childCount(id);
  let array = -1;
  let first = 0;

  while ((first == 0) || (first < n)) {
    let items = Array.new<I32>(0);

    while ((first + items.len() < n) && (items.len() < _LITERAL_CHUNK)) {
      items.push(_expr(childOf(id, first + items.len())));
    }

    if (first == 0) {
      array = _fresh(typeOf(id));
      _emit(Op.ArrayNew, array, [_i32(n)], 0);
    }

    for (i, item in items) {
      _emit(Op.ArraySet, -1, [array, _i32(first + i), item], 0);
    }
    first += _LITERAL_CHUNK;
  }
  array
};

/** Returns the `BytesRead` or `BytesWrite` format of a bits segment of 16 or 32 bits with code
 * `code` (see `Model.Op`). A U32 reads and writes an I32's bits as the VM's I32 does. */
let _bytesFormat = fn(code: I32): I32 {
  let format = segmentWidth(code) == 16 ? 0 : (code & BITS_FLOAT) != 0 ? 6 : 2;
  format + ((code & BITS_BIG) != 0 ? 1 : 0)
};

/** Lowers `bits[...]`; evaluates the segments' values in order, then allocates the bytes,
 * writes each, a rest last, and freezes them, as Bytes no one writes.
 * @param id  the `BitsPack` node
 * @return the bytes register */
let _bitsPack = fn(id: I32): I32 {
  let values = Array.new<I32>(0);
  let fixed = valueOf(id);
  let rest = -1;
  let i = 0;

  while (i < childCount(id)) {
    values.push(_expr(childOf(childOf(id, i), 0)));
    if (segmentWidth(auxOf(childOf(id, i))) == 0) { rest = values[i]; }
    i++;
  }
  let length = rest < 0 ? _i32(fixed) : _arithmetic(Op.Add, _bytesLength(rest), _i32(fixed));
  let bytes = _fresh(TYPE_BYTES);
  _emit(Op.BytesNew, bytes, [length], 0);

  for (i, value in values) {
    let field = childOf(id, i);
    let width = segmentWidth(auxOf(field));

    if (width == 0) {
      _emit(Op.BytesBlit, -1, [bytes, value, _i32(fixed)], 0);
    } else if (width <= 8) {
      _emit(Op.BitsWrite, -1, [bytes, value], valueOf(field) * 16 + width);
    } else {
      let offset = _i32(valueOf(field) / 8);
      _emit(Op.BytesWrite, -1, [bytes, offset, value], _bytesFormat(auxOf(field)));
    }
  }
  _emit(Op.BytesFreeze, -1, [bytes], 0);
  bytes
};

/** Lowers a push; resizes the array to one more element and stores into the new slot. That is
 * amortised O(1), since the VM grows capacity geometrically.
 * @param id  the `ArrayPush` node
 * @return the register of the new length, the push's value */
let _push = fn(id: I32): I32 {
  let operands = _values(id, 0);
  let array = operands[0];
  let length = _length(array);
  let grown = _arithmetic(Op.Add, length, _i32(1));
  _emit(Op.ArrayResize, -1, [array, grown], 0);
  _emit(Op.ArraySet, -1, [array, length, operands[1]], 0);
  grown
};

/** Lowers a pop; reads the last element, then shrinks the array by one. Reading index -1 of an
 * empty array traps.
 * @param id  the `ArrayPop` node
 * @return the register of the removed element */
let _pop = fn(id: I32): I32 {
  let array = _expr(childOf(id, 0));
  let last = _arithmetic(Op.Sub, _length(array), _i32(1));
  let value = _fresh(typeOf(id));
  _emit(Op.ArrayGet, value, [array, last], 0);
  _emit(Op.ArrayResize, -1, [array, last], 0);
  value
};

// Checks whether `handler`, a block's, catches into block `target`.
let _catchesInto = fn(handler: ?ThrowHandler, target: I32): Bool {
  (handler != null) && (handler.target == target)
};

/** Lowers a `try`; the body's blocks catch into the catch block, which the VM enters with the
 * thrown value in a fresh Dynamic register, bound to the catch binding if any. The catch block
 * runs only if one of the body's blocks may throw; otherwise the body opens no try region.
 * @param id  the `Try` or `TryStatement` node
 * @param value  whether it is a `Try` expression, whose value is the body's or the catch's
 * @return the result register, or -1 for a statement */
let _try = fn(id: I32, value: Bool): I32 {
  let bodyBlock = _nextBlock;
  let catchBlock = bodyBlock + 1;
  let joinBlock = bodyBlock + 2;
  _nextBlock += 3;
  let result = value ? _fresh(typeOf(id)) : -1;
  let payload = _fresh(TYPE_DYNAMIC);
  // The try's value field is its catch binding, bound to the payload.
  if (valueOf(id) >= 0) { _bindRegister(id, payload); }
  _end(Terminator.Jump(bodyBlock), bodyBlock);

  let outer = _handler;
  let first = _blocks.len();
  _handler = { target: catchBlock, payload };
  let body = _lowerBlock(childOf(id, 0));
  if (value) { _move(result, body); }
  _end(Terminator.Jump(joinBlock), -1);
  _handler = outer;

  let throws = false;
  let i = first;

  while (i < _blocks.len()) {
    let block = _blocks[i];

    if (_catchesInto(block.handler, catchBlock)
      && blockMayThrow(block.instructions, block.terminator)) {
      throws = true;
    }
    i++;
  }
  // A body that cannot throw opens no region.
  i = first;

  while (!throws && (i < _blocks.len())) {
    if (_catchesInto(_blocks[i].handler, catchBlock)) {
      _blocks[i] = { ..._blocks[i], handler: outer };
    }
    i++;
  }

  if (throws) { _target(catchBlock); }
  _open(catchBlock);
  let caught = _lowerBlock(childOf(id, 1));
  if (value) { _move(result, caught); }
  _end(Terminator.Jump(joinBlock), joinBlock);
  result
};

/** Lowers expression node `id`, making it the node its instructions record.
 * @return the register holding its value, or -1 when no code that runs computes one */
let _expr = fn(id: I32): I32 {
  let outer = _node;
  _node = id;
  let register = _exprAt(id);
  _node = outer;

  register
};

/** Lowers expression node `id`; `_expr` wraps it to set the node instructions record.
 * @return the register holding its value, or -1 when no code that runs computes one */
let _exprAt = fn(id: I32): I32 {
  match (opOf(id)) {
    Local when (_isCell(valueOf(id))) => {
      let dst = _fresh(typeOf(id));
      _emit(Op.ArrayGet, dst, [_bindings[valueOf(id)], _i32(0)], 0);
      dst
    },
    // A read an assignment may overtake is a copy, so the assignment cannot change it.
    Local => {
      let register = _bindings[valueOf(id)];
      (_usesOf(valueOf(id)) & _OVERTAKEN) == 0 ? register : _copy(typeOf(id), register)
    },
    Assign when (_isCell(valueOf(id))) => {
      let value = _expr(childOf(id, 0));
      _emit(Op.ArraySet, -1, [_bindings[valueOf(id)], _i32(0), value], 0);
      value
    },
    Assign => {
      let value = _expr(childOf(id, 0));
      _move(_bindings[valueOf(id)], value);
      value
    },
    // A global is read into a fresh register; a call may change it later.
    Global => {
      let dst = _fresh(typeOf(id));
      _emit(Op.GlobalGet, dst, Array.new<I32>(0), valueOf(id));
      dst
    },
    SetGlobal => {
      let value = _expr(childOf(id, 0));
      _emit(Op.GlobalSet, -1, [value], valueOf(id));
      value
    },

    // An indexed assignment's value is the value stored.
    ArraySet => {
      let operands = _values(id, 0);
      _emit(Op.ArraySet, -1, operands, 0);
      operands[2]
    },
    SetField => {
      let operands = _values(id, 0);
      _emit(Op.StructSet, -1, operands, valueOf(id));
      operands[1]
    },
    BytesSet => {
      let operands = _values(id, 0);
      _emit(Op.BytesSet, -1, operands, 0);
      operands[2]
    },
    ObjectSet => {
      let operands = _values(id, 0);
      _emit(Op.ObjectSet, -1, operands, _objectKey(id));
      operands[operands.len() - 1]
    },
    ObjectClear => {
      let object = _expr(childOf(id, 0));
      _emit(Op.ObjectClear, -1, [object], 0);
      object
    },
    // An absent field reads as null, which a reference the checker holds present must not be.
    ObjectGet when (isReference(typeOf(id))) => {
      let dst = _fresh(typeOf(id));
      _emit(Op.ObjectGet, dst, _values(id, 0), _objectKey(id));
      _emit(Op.NullCheck, -1, [dst], 0);
      dst
    },

    BitsPack => _bitsPack(id),
    // A segment of up to 8 bits is read by its bit offset, a wider one by its byte offset.
    BitsRead => {
      let bytes = _expr(childOf(id, 0));
      let width = segmentWidth(auxOf(id));
      let dst = _fresh(typeOf(id));

      if (width <= 8) {
        _emit(Op.BitsRead, dst, [bytes], valueOf(id) * 16 + width);
      } else {
        _emit(Op.BytesRead, dst, [bytes, _i32(valueOf(id) / 8)], _bytesFormat(auxOf(id)));
      }
      dst
    },
    ArrayLiteral => _arrayLiteral(id),
    ArrayPush => _push(id),
    ArrayPop => _pop(id),
    ArrayResize => {
      let operands = _values(id, 0);
      _emit(Op.ArrayResize, -1, operands, 0);
      operands[0]
    },

    // A reference keeps its register as a Null<T>; a scalar is boxed.
    Present => {
      let value = _expr(childOf(id, 0));
      if (isReference(innerOf(typeOf(id)))) { return value; }
      _unaryOp(Op.Box, typeOf(id), value)
    },
    ToDynamic => _toDynamic(childOf(id, 0)),
    Convert => _convert(id),
    // A closure holds its captures boxed.
    FunctionRef => {
      let captures = Array.new<I32>(0);
      let i = 0;

      while (i < childCount(id)) {
        captures.push(_capturedBox(childOf(id, i)));
        i++;
      }
      let dst = _fresh(typeOf(id));
      _emit(Op.ConstFunction, dst, captures, valueOf(id));
      dst
    },
    // A native handle stays in its Dynamic register.
    FromDynamic when (isHandle(typeOf(id))) => {
      let value = _expr(childOf(id, 0));
      _checkHandle(value, false);
      value
    },
    // `Unbox` checks the kind; a null reference passes it, so it is null-checked too.
    FromDynamic => {
      let value = _expr(childOf(id, 0));
      let dst = _unaryOp(Op.Unbox, typeOf(id), value);
      if (isReference(typeOf(id))) { _emit(Op.NullCheck, -1, [dst], 0); }
      dst
    },

    /* As extraction does, `is I64` and a float's test also accept an I32; (kind - KIND_I32) *
     * (kind - tested kind) == 0. An enum's kind test also checks its type, with `IsEnum`. */
    IsKind when (valueOf(id) == KIND_ENUM) => {
      let dst = _fresh(TYPE_BOOL);
      _emit(Op.IsEnum, dst, [_expr(childOf(id, 0))], _enumIndexes[auxOf(id)]);
      dst
    },
    IsKind => {
      let kind = _fresh(TYPE_I32);
      _emit(Op.KindOf, kind, [_expr(childOf(id, 0))], 0);
      let code = valueOf(id);
      let wide = (code == KIND_I64) || isFloatKind(code);
      let tested = kind;

      if (wide) {
        let fromI32 = _arithmetic(Op.Sub, kind, _i32(KIND_I32));
        tested = _arithmetic(Op.Mul, fromI32, _arithmetic(Op.Sub, kind, _i32(code)));
      }
      let dst = _fresh(TYPE_BOOL);
      _emit(Op.Eq, dst, [tested, _i32(wide ? 0 : code)], 0);
      dst
    },

    /* A checked reference traps on null; unboxing null traps either way. A binding in a cell is
     * checked even when the checker knows it present; a call may run a closure that assigns
     * it. */
    Unwrap => {
      let operand = childOf(id, 0);
      let value = _expr(operand);
      if (!isReference(typeOf(id))) { return _unaryOp(Op.Unbox, typeOf(id), value); }
      if ((valueOf(id) == 1) || (_cellOf(operand) >= 0)) { _emit(Op.NullCheck, -1, [value], 0); }
      value
    },
    Block => _lowerBlock(id),
    If => _if(id),
    Try => _try(id, true),
    And, Or => _shortCircuit(id),
    Eq when (typeOf(childOf(id, 0)) == TYPE_BOOL) => _boolEqual(id),
    Div, Rem => _divide(id),
    Shr when (_wideUnsigned(typeOf(id))) => _logicalShift(id),
    Eq, Lt, Gt, Le, Ge when (isFloatType(typeOf(childOf(id, 0)))) => _float(id),
    Neg when (typeOf(id) == TYPE_F16) => _float(id),
    BytesConcatMany => _joined(id),
    _ => {
      let operands = _values(id, 0);
      let op = _operation(id);

      let imm = match (opOf(id)) {
        Bool, I32, TupleField, Call, EnumNew, EnumField => valueOf(id),
        Bytes => _internAt(_poolIndexes, _pool, valueOf(id)),
        CallNative => _nativeIndex(valueOf(id)),
        I64 => {
          _wides.push(wideValueOf(id));
          _wides.len() - 1
        },
        Float when (typeOf(id) == TYPE_F64) => {
          _floats.push(wideValueOf(id));
          _floats.len() - 1
        },
        Float => valueOf(id),
        Atom => _internAt(_atomIndexes, _atoms, valueOf(id)),
        ObjectGet, ObjectHas => _objectKey(id),
        _ => 0,
      };

      // `a > b` is `b < a`.
      match (opOf(id)) {
        Gt => {
          operands = [operands[1], operands[0]];
          null
        }, _ => null
      };
      let present = match (opOf(id)) { IsPresent => true, _ => false };
      let dst = _fresh(present ? TYPE_BOOL : typeOf(id));
      _emit(op, dst, operands, imm);
      // A native's result of an abstract type could be any value, so it is checked.
      let native = match (opOf(id)) { CallNative => true, _ => false };

      if (native && isHandle(typeOf(id))) {
        _checkHandle(dst, isKind(typeOf(id), Kind.Null));
      }
      if (!present) { return _wrapped(id, dst); }
      _unaryOp(Op.Not, TYPE_BOOL, dst)
    },
  }
};

// Ends the block being built with `terminator`; the code after it never runs.
let _exit = fn(terminator: Terminator) { _end(terminator, -1) };

/** Lowers a `while`; a condition block that branches to the body or the exit block, with the
 * body jumping back to the condition, through the step block when there is a step. Inside the
 * body `break` jumps to the exit block and `continue` to the step, or else the condition.
 * @param id  the `While` node */
let _while = fn(id: I32) {
  let conditionBlock = _nextBlock;
  let bodyBlock = conditionBlock + 1;
  let exitBlock = conditionBlock + 2;
  let stepped = childCount(id) == 3;
  let next = stepped ? conditionBlock + 3 : conditionBlock;
  _nextBlock += stepped ? 4 : 3;
  _end(Terminator.Jump(conditionBlock), conditionBlock);
  _branch(childOf(id, 0), bodyBlock, exitBlock, bodyBlock);

  let outerBreak = _breakTarget;
  let outerContinue = _continueTarget;
  _breakTarget = exitBlock;
  _continueTarget = next;
  _lowerBlock(childOf(id, 1));
  _breakTarget = outerBreak;
  _continueTarget = outerContinue;

  if (stepped) {
    _end(Terminator.Jump(next), next);
    _lowerBlock(childOf(id, 2));
  }
  _end(Terminator.Jump(conditionBlock), exitBlock);
  null
};

/** Lowers a `do` loop, a `While` whose body runs first; the body falls into a condition block
 * that branches back to the body or on to the exit block. The condition block opens after the
 * body, whose `continue` jumps to it, so that it is known to run.
 * @param id  the `While` node */
let _doWhile = fn(id: I32) {
  let bodyBlock = _nextBlock;
  let conditionBlock = bodyBlock + 1;
  let exitBlock = bodyBlock + 2;
  _nextBlock += 3;
  _end(Terminator.Jump(bodyBlock), bodyBlock);

  let outerBreak = _breakTarget;
  let outerContinue = _continueTarget;
  _breakTarget = exitBlock;
  _continueTarget = conditionBlock;
  _lowerBlock(childOf(id, 1));
  _breakTarget = outerBreak;
  _continueTarget = outerContinue;
  _end(Terminator.Jump(conditionBlock), conditionBlock);
  _branch(childOf(id, 0), bodyBlock, exitBlock, exitBlock);
  null
};

/** Lowers a call of the function being lowered, in return position and outside any try, as a jump
 * back to its start with its parameters set to the arguments. Every argument is evaluated before
 * any parameter changes, and one held in a parameter that an earlier move overwrites is copied
 * first.
 * @param id  the `Call` node */
let _restart = fn(id: I32) {
  let args = _values(id, 0);

  for (i, arg in args) {
    // A parameter moved before this argument is read must be copied first.
    let held = _params.indexOf(arg);

    if ((held >= 0) && (held < i) && (args[held] != _params[held])) {
      args[i] = _copy(typeOf(childOf(id, i)), arg);
    }
  }

  for (i, arg in args) {
    if (arg != _params[i]) { _move(_params[i], arg); }
  }
  _exit(Terminator.Jump(_start))
};

/** Lowers `value` at the end of a path, as `result` says, then goes on to the block `join`: into
 * the register `result`, or, when it is `_RETURNED`, as the value the function returns, or, when
 * `_DISCARDED`, as a statement. An `if` or a block passes the position on to its branches or
 * tail, and in return position a call of the function itself outside any try starts it again
 * (`_restart`). */
let _tail = fn(value: I32, result: I32, join: I32): Null {
  let outer = _node;
  _node = value;

  match (opOf(value)) {
    If, IfStatement when (_chains(value, result)) => {
      if (!_decided(value, result, join)) {
        let thenBlock = _nextBlock;
        let otherwise = childCount(value) == 3;
        _nextBlock += otherwise ? 2 : 1;
        _branch(childOf(value, 0), thenBlock, otherwise ? thenBlock + 1 : join, thenBlock);
        _tail(childOf(value, 1), result, join);

        if (otherwise) {
          _open(thenBlock + 1);
          _tail(childOf(value, 2), result, join);
        }
      }
    },
    Block when ((auxOf(value) == 1) || (result < 0)) => {
      if (_statements(value)) {
        _tail(lastChild(value), result, join);
      } else if (result == _DISCARDED) {
        _end(Terminator.Jump(join), -1);
      } else {
        _open(-1);
      }
    },
    // A call of itself in return position is a loop in disguise.
    Call when ((result == _RETURNED) && (valueOf(value) == _self) && (_handler == null)) => {
      _restart(value)
    },
    _ when (result == _RETURNED) => _exit(Terminator.ReturnValue(_expr(value))),
    _ when (result == _DISCARDED) => {
      _expr(value);
      _end(Terminator.Jump(join), -1)
    },
    _ => {
      _move(result, _expr(value));
      _end(Terminator.Jump(join), -1)
    },
  };
  _node = outer;
  null
};

/** Lowers expression node `id` as the value the function returns, and ends the path; in a
 * function that calls itself, through `_tail`.
 * @param id  the expression node */
let _returned = fn(id: I32): Null {
  _start < 0 ? _exit(Terminator.ReturnValue(_expr(id))) : _tail(id, _RETURNED, -1)
};

/** Lowers an `if` statement, and any `else if`, through `_tail`, then its join block.
 * @param id  the `IfStatement` node */
let _ifStatement = fn(id: I32) {
  let joinBlock = _nextBlock;
  _nextBlock += 1;
  _tail(id, _DISCARDED, joinBlock);
  _open(joinBlock)
};

// Lowers statement node `id`, making it the node its instructions record.
let _statement = fn(id: I32): Bool {
  let outer = _node;
  _node = id;
  let done = _statementAt(id);
  _node = outer;

  done
};

// Lowers statement node `id`; `_statement` wraps it to set the node instructions record.
let _statementAt = fn(id: I32): Bool {
  match (opOf(id)) {
    Declare => {
      let i = 0;

      while (i < childCount(id)) {
        _bind(childOf(id, i));
        i++;
      }
      null
    },
    Expression => {
      _expr(childOf(id, 0));
      null
    },
    Return => _returned(childOf(id, 0)),
    Throw => _exit(Terminator.Throw(_expr(childOf(id, 0)), id)),
    Break => _exit(Terminator.Jump(_breakTarget)),
    Continue => _exit(Terminator.Jump(_continueTarget)),
    While => auxOf(id) == 0 ? _while(id) : _doWhile(id),
    IfStatement => _ifStatement(id),
    TryStatement => {
      _try(id, false);
      null
    },
    Block => {
      _lowerBlock(id);
      null
    },
    _ => {
      internalError("invalid HIR statement op");
      null
    },
  };
  true
};

/** Lowers the `Block` node `id`; its statements, then its tail.
 * @return the tail's register, or -1 without a tail that runs */
let _lowerBlock = fn(id: I32): I32 { _statements(id) ? _expr(lastChild(id)) : -1 };

// Returns the `_uses` flags of binding ID `binding`, or 0 for a binding never seen.
let _usesOf = fn(binding: I32): I32 { binding < _uses.len() ? _uses[binding] : 0 };

/** Adds `flag` to the uses of binding ID `binding`.
 * @param flag  `_ASSIGNED`, `_OVERTAKEN` or `_UNBOXED`, or a combination */
let _use = fn(binding: I32, flag: I32) {
  while (_uses.len() <= binding) {
    _uses.push(0);
    _lastRead.push(-1);
  }
  _uses[binding] = _uses[binding] | flag;
  null
};

/** Records in `_uses` how the subtree at `id` uses each binding. `expression` is the walk
 * position where it entered the outermost expression of several operands that holds `id`,
 * or -1. Statements and control flow use each child's value before the next runs, as `&&` and
 * `||` do their left one, so only such an expression's operands can hold a read while a later
 * one assigns. An assignment to a binding read since that position marks it `_OVERTAKEN`,
 * and `_exprAt` then copies each of its reads. */
let _markUses = fn(id: I32, expression: I32): Null {
  let at = _walked;
  _walked++;
  /* A rebox's operand is not an unboxed read; it is boxed at once. A cell's value is read for
   * a Dynamic, so its capture is unboxed. */
  let reboxes = false;

  let sequential = match (opOf(id)) {
    Block, If, IfStatement, While, Try, TryStatement, Let, Const, Declare, Expression, Return,
    Throw, SetGlobal, InitGlobal, And, Or => true,
    Assign => {
      let overtakes = (expression >= 0)
        && (valueOf(id) < _lastRead.len())
        && (_lastRead[valueOf(id)] > expression);
      _use(valueOf(id), overtakes ? _ASSIGNED | _OVERTAKEN : _ASSIGNED);
      true
    },
    Local => {
      _use(valueOf(id), _UNBOXED);
      _lastRead[valueOf(id)] = at;
      true
    },
    FunctionRef => {
      reboxes = true;
      false
    },
    ToDynamic => {
      reboxes = _cellOf(childOf(id, 0)) < 0;
      false
    },
    Call => {
      if (valueOf(id) == _self) { _start = 1; }
      false
    },
    _ => false,
  };
  let inner = ((expression < 0) && !sequential && (childCount(id) > 1)) ? at : expression;
  let i = 0;

  while (i < childCount(id)) {
    let child = childOf(id, i);
    match (opOf(child)) { Local when (reboxes) => null, _ => _markUses(child, inner) };
    i++;
  }
  null
};

/** Resets the state of the function being built, then walks `body` to fill `_uses`.
 * @param body  the HIR node of the function's body block
 * @param self  the function's IR ID, or -1 for the program body */
let _begin = fn(body: I32, self: I32) {
  _registers = Array.new<ValueType>(0);
  _instructions = Array.new<Instruction>(0);
  _blocks = Array.new<BasicBlock>(0);
  _block = 0;
  _nextBlock = 1;
  _targeted = [true];
  _reachable = true;

  _bindings = Array.new<I32>(0);
  _uses = Array.new<I32>(0);
  _lastRead = Array.new<I32>(0);
  _walked = 0;
  _assignedRegisters = Array.new<Bool>(0);
  _boxes = Array.new<I32>(0);

  _breakTarget = -1;
  _continueTarget = -1;
  _handler = null;
  _node = -1;
  _self = self;
  _start = -1;
  _markUses(body, -1)
};

// Returns the function built so far as IR function `id`, entered at block 0.
let _irFunction = fn(id: I32, params: Array<I32>, captures: I32, result: ValueType): IrFunction {
  { id, params, captures, registers: _registers, result, blocks: _blocks, entry: 0 }
};

/** Lowers HIR function `id` into IR function `functionId`. Its captures arrive boxed after its
 * arguments, and each is unboxed on entry when the body reads its value, not only its box, or
 * when it is a cell. The body's tail is returned.
 * @param id  the HIR `Function` node
 * @param functionId  the IR function ID
 * @return the IR function */
let _function = fn(id: I32, functionId: I32): IrFunction {
  _begin(lastChild(id), functionId);
  let params = Array.new<I32>(0);
  let arguments = typeArgCount(typeOf(id));
  let i = 0;

  while (i < childCount(id) - 1) {
    let param = childOf(id, i);
    let capture = match (opOf(param)) { Capture => true, _ => false };
    let register = _fresh(capture ? TYPE_DYNAMIC : typeOf(param));
    params.push(register);
    if (capture) { _setBox(valueOf(param), register); }

    let bound = register;
    let cell = _isCell(valueOf(param));
    // A cell is unboxed when it is read or assigned; a value when it is read.
    let used = (_usesOf(valueOf(param)) & (cell ? _UNBOXED | _ASSIGNED : _UNBOXED)) != 0;

    if (capture && used && (cell || !_isDynamic(param))) {
      bound = cell ? _freshCell(typeOf(param)) : _fresh(typeOf(param));
      _emit(Op.Unbox, bound, [register], 0);
    }
    _bindRegister(param, bound);
    i++;
  }

  // The entry block allocated no other block, so the start block is block 1.
  if (_start >= 0) {
    _params = params;
    _nextBlock++;
    _end(Terminator.Jump(_start), _start);
  }
  _returned(lastChild(id));
  _irFunction(functionId, params, params.len() - arguments, _valueType(innerOf(typeOf(id))))
};

/** Returns, by function ID, whether the program body may run each HIR function: whether a chain
 * of calls and function references (`Call`, `FunctionRef`) from the body names it. Entry 0, the
 * body, is true. */
let _reachableFunctions = fn(): Array<Bool> {
  let root = rootNode();
  let reached = [true];
  while (reached.len() < childCount(root)) { reached.push(false); }
  let pending = [lastChild(root)];

  while (pending.len() > 0) {
    let id = pending.pop();
    let names = match (opOf(id)) { Call, FunctionRef => valueOf(id) > 0, _ => false };

    if (names && !reached[valueOf(id)]) {
      reached[valueOf(id)] = true;
      pending.push(lastChild(childOf(root, valueOf(id) - 1)));
    }
    let i = 0;

    while (i < childCount(id)) {
      pending.push(childOf(id, i));
      i++;
    }
  }
  reached
};

/** The first statement of each part of the program body, in order, and the ID of the first part;
 * the parts follow every function the program has, whichever pass made it. */
let _partStarts = Array.new<I32>(0);
let _firstPart = 0;

/** Returns the HIR node that IR function `functionId` was lowered from (IDs as in `Hir.Op`), so
 * the driver can locate an allocation failure.
 * @return the HIR `Function` node, the program's body block for function 0, or the first
 *     statement a part of the program body runs */
export let functionNode = fn(functionId: I32): I32 {
  let root = rootNode();

  if ((_partStarts.len() > 0) && (functionId >= _firstPart)) {
    return childOf(lastChild(root), _partStarts[functionId - _firstPart]);
  }
  functionId == 0 ? lastChild(root) : childOf(root, functionId - 1)
};

/** The register types at which a part of the program body ends; half of what a function may
 * have, which leaves the statement that reaches it room. */
const _PART_TYPES = 128;

/** Lowers statements of the program body `body` from `start`, before its tail, as IR function
 * `functionId`, which takes nothing and returns null. It ends after the statement at which its
 * registers reach `_PART_TYPES` types. No local lives from one statement of the program body to
 * the next, so any statement may start a part.
 * @return the IR function, and the statement after its last */
let _part = fn(body: I32, start: I32, functionId: I32): Tuple<IrFunction, I32> {
  _begin(childOf(body, start), functionId);
  let types = Array.new<ValueType>(0);
  let counted = 0;
  let next = start;

  while ((next < childCount(body) - 1) && (types.len() < _PART_TYPES)) {
    if (next > start) { _markUses(childOf(body, next), -1); }
    _statement(childOf(body, next));
    next++;

    while (counted < _registers.len()) {
      internValueType(types, _registers[counted]);
      counted++;
    }
  }

  let result = _fresh(TYPE_NULL);
  _emit(Op.ConstNull, result, [], 0);
  _exit(Terminator.ReturnValue(result));
  (_irFunction(functionId, [], 0, _valueType(TYPE_NULL)), next)
};

/** Checks whether the `Let` or `Const` node `id` binds a closure that captures the binding
 * itself. */
let _capturesItself = fn(id: I32): Bool {
  let value = childOf(id, 0);
  match (opOf(value)) { FunctionRef => null, _ => { return false; } };
  let i = 0;

  while (i < childCount(value)) {
    let source = childOf(value, i);

    match (opOf(source)) {
      Local when (valueOf(source) == valueOf(id)) => { return true; },
      _ => null,
    };
    i++;
  }
  false
};

/** Fills `_cells` for the program. A closure's captures pair, in order, with its function's
 * `Capture` bindings, so each local is grouped with its copies; a group that is captured and
 * assigned anywhere lives in one cell. */
let _findCells = fn() {
  let groups = Array.new<I32>(0);
  let assigned = Array.new<Bool>(0);
  let captured = Array.new<Bool>(0);

  let grow = fn(binding: I32) {
    while (groups.len() <= binding) {
      groups.push(groups.len());
      assigned.push(false);
      captured.push(false);
    }
    null
  };

  let find = fn(binding: I32): I32 {
    grow(binding);
    let group = binding;
    while (groups[group] != group) { group = groups[group]; }
    group
  };

  let count = nodeCount();
  let id = 0;

  while (id < count) {
    match (opOf(id)) {
      Assign => {
        assigned[find(valueOf(id))] = true;
        null
      },
      // A function that captures its own binding reads it after the binding is made, as a cell.
      Let, Const when (_capturesItself(id)) => {
        assigned[find(valueOf(id))] = true;
        null
      },
      // A reference in a dropped template's body names no function.
      FunctionRef when (valueOf(id) > 0) => {
        let function = functionNode(valueOf(id));
        let first = typeArgCount(typeOf(function));
        let i = 0;

        while (i < childCount(id)) {
          let source = childOf(id, i);

          match (opOf(source)) {
            Local => {
              let group = find(valueOf(source));
              let copy = find(valueOf(childOf(function, first + i)));

              if (group != copy) {
                groups[copy] = group;
                assigned[group] = assigned[group] || assigned[copy];
              }
              captured[group] = true;
              null
            },
            _ => null,
          };
          i++;
        }
        null
      },
      _ => null,
    };
    id++;
  }
  _cells = Array.new<Bool>(0);
  let binding = 0;

  while (binding < groups.len()) {
    let group = find(binding);
    _cells.push(assigned[group] && captured[group]);
    binding++;
  }
  null
};

/** The lengths of `_pool`, `_wides`, `_floats`, `_atoms` and `_natives` before the body of the
 * program `lowerProgram` last lowered was lowered, or empty before it lowers one;
 * `relowerBodyInParts` cuts the pools back to them. */
let _poolSizes = Array.new<I32>(0);

// Forgets each index in `indexes` at or past `size`, the length its table is cut back to.
let _forgetIndexes = fn(indexes: Array<I32>, size: I32) {
  for (i, index in indexes) {
    if (index >= size) { indexes[i] = -1; }
  }
  null
};

/** Lowers the program body of the program `lowerProgram` began, after its HIR `functions`, and
 * returns the program, verified with `Verify.verifyProgramFrom`. In parts, the body's statements
 * run in functions of their own (see `_part`), which function 0 calls in turn before its tail.
 * @param inParts  whether to lower the program body in parts
 * @param verified  how many of `functions` are verified already */
let _lowerBody = fn(
  functions: Array<IrFunction>,
  enums: Array<EnumSchema>,
  inParts: Bool,
  verified: I32
): IrProgram {
  // The program body becomes function 0, listed last, and its parts follow the HIR functions.
  let root = rootNode();
  let body = lastChild(root);
  let result = -1;

  if (!inParts) {
    _partStarts = [];
    _begin(body, -1);
    result = _lowerBlock(body);
  } else {
    let statements = childCount(body) - 1;
    let next = 0;
    let free = nextFunctionId(functions);
    _firstPart = (free > childCount(root)) ? free : childCount(root);
    _partStarts = [];

    while (next < statements) {
      _partStarts.push(next);
      let (part, after) = _part(body, next, _firstPart + _partStarts.len() - 1);
      functions.push(part);
      next = after;
    }
    _begin(lastChild(body), -1);
    let part = 0;

    while (part < _partStarts.len()) {
      _emit(Op.Call, _fresh(TYPE_NULL), [], _firstPart + part);
      part++;
    }
    result = _expr(lastChild(body));
  }
  _end(Terminator.ReturnValue(result), -1);
  functions.push(_irFunction(0, [], 0, _valueType(typeOf(body))));

  let globals = Array.new<ValueType>(0);
  let i = 0;

  while (i < globalCount()) {
    globals.push(_valueType(globalTypeOf(i)));
    i++;
  }
  let lowered: IrProgram = {
    functions,
    bytes: _pool,
    wides: _wides,
    floats: _floats,
    atoms: _atoms,
    enums,
    globals,
    natives: _natives,
  };
  verifyProgramFrom(lowered, false, verified);
  lowered
};

/** Lowers the checked HIR `program` to IR, with the program body as function 0, and verifies the
 * result with `Verify.verifyProgramFrom`. Only the functions the body can reach are lowered, so
 * an unused function of a linked module costs nothing. Every enum and record type but a generic
 * one's template becomes one of the program's nominal types, so each instance is one; natives
 * are imported only when called. */
export let lowerProgram = fn(program: Hir): IrProgram {
  useHir(program);
  _pool = Array.new<Bytes>(0);
  _poolIndexes = Array.new<I32>(0);
  _wides = Array.new<I64>(0);
  _floats = Array.new<I64>(0);
  _atoms = Array.new<Bytes>(0);
  _atomIndexes = Array.new<I32>(0);
  // The VM delegates through prototypes only when atom 0 is __proto__.
  let proto = findBytesId("__proto__");
  if (proto >= 0) { _internAt(_atomIndexes, _atoms, proto); }
  _natives = Array.new<Native>(0);
  _nativeIndexes = Array.new<I32>(0);
  while (_nativeIndexes.len() < nativeCount()) { _nativeIndexes.push(-1); }

  // Enums and records are numbered first; their fields may refer to any of them.
  _enumIndexes = Array.new<I32>(0);
  let enumTypes = Array.new<I32>(0);
  let ty = 0;

  while (ty < typeCount()) {
    // A generic enum or record is lowered as its instances.
    let nominal = match (kindOf(ty)) { Enum, Record => !isTemplateEnum(ty), _ => false };
    if (nominal) { enumTypes.push(ty); }
    _enumIndexes.push(nominal ? enumTypes.len() - 1 : -1);
    ty++;
  }
  let enums = Array.new<EnumSchema>(0);

  for (enumType in enumTypes) {
    let variants = Array.new<Array<ValueType>>(0);
    let tag = 0;

    while (tag < variantCount(enumType)) {
      let fields = Array.new<ValueType>(0);
      let f = 0;

      while (f < fieldCount(enumType, tag)) {
        fields.push(_valueType(fieldType(enumType, tag, f)));
        f++;
      }
      variants.push(fields);
      tag++;
    }
    enums.push(isRecord(enumType) ? EnumSchema.Record(variants[0]) : EnumSchema.Enum(variants));
  }

  _findCells();
  let root = rootNode();
  let functions = Array.new<IrFunction>(0);
  let reached = _reachableFunctions();
  let i = 0;

  while (i < childCount(root) - 1) {
    if (reached[i + 1]) { functions.push(_function(childOf(root, i), i + 1)); }
    i++;
  }
  _poolSizes = [_pool.len(), _wides.len(), _floats.len(), _atoms.len(), _natives.len()];
  _lowerBody(functions, enums, false, 0)
};

/** Lowers the body of the program `lowerProgram` last lowered again, in parts. Registers are
 * typed, so a body that initialises globals of many types, or whose globals `ir.Optimize` keeps
 * in registers, may need more registers than one function can have; in parts, they stay
 * globals.
 * @param earlier  that program, or a program optimised or legalised from it, whose HIR functions
 *   are kept
 * @throws an error when `lowerProgram` has lowered no program */
export let relowerBodyInParts = fn(earlier: IrProgram): IrProgram {
  if (_poolSizes.len() == 0) { throw "no program body to lower again"; }
  // Copies, so the programs lowered before keep their pools.
  _pool = _pool.copy();
  _wides = _wides.copy();
  _floats = _floats.copy();
  _atoms = _atoms.copy();
  _natives = _natives.copy();
  Array.resize(_pool, _poolSizes[0]);
  Array.resize(_wides, _poolSizes[1]);
  Array.resize(_floats, _poolSizes[2]);
  Array.resize(_atoms, _poolSizes[3]);
  Array.resize(_natives, _poolSizes[4]);
  _forgetIndexes(_poolIndexes, _poolSizes[0]);
  _forgetIndexes(_atomIndexes, _poolSizes[3]);
  _forgetIndexes(_nativeIndexes, _poolSizes[4]);

  // Every function but the last, the old body, is kept.
  let kept = Array.new<IrFunction>(0);
  while (kept.len() < earlier.functions.len() - 1) { kept.push(earlier.functions[kept.len()]); }
  _lowerBody(kept, earlier.enums, true, kept.len())
};
