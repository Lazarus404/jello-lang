package ir;

import type { Hir } from frontend.Hir;
import {
  KIND_ENUM, KIND_I32, KIND_I64, TYPE_BOOL, TYPE_BYTES, TYPE_BYTE_BUFFER, TYPE_DYNAMIC, TYPE_I32, auxOf, wideValueOf, bytesOf, childCount, childOf, fieldCount, fieldType, innerOf, isReference, isTemplateEnum, kindOf, lastChild, opOf, rootNode, typeArg,
  typeArgCount, typeCount, globalCount, globalTypeOf, nativeCount, nativeLibraryOf, nativeNameOf, nativeTypeOf, typeOf, useHir, valueOf, variantCount,
} from frontend.Hir;
import type { BasicBlock, EnumSchema, Function as IrFunction, Instruction, Native, Op, Program as IrProgram, Terminator, ThrowHandler, ValueType } from ir.Model;
import { BasicBlock, EnumSchema, Native, Op, Program as IrProgram, Terminator, ThrowHandler, ValueType, handlerTarget, instructionAt } from ir.Model;
import { blockMayThrow } from ir.Cfg;
import { verifyProgram } from ir.Verify;
import { internalError } from frontend.Internal;

let _registers = Array.new<ValueType>(0);
let _instructions = Array.new<Instruction>(0);
let _blocks = Array.new<BasicBlock>(0);
let _block = 0;
let _nextBlock = 1;
let _bindings = Array.new<I32>(0);
let _ASSIGNED = 1;
let _OVERTAKEN = 2;
let _UNBOXED = 4;
let _uses = Array.new<I32>(0);
let _lastRead = Array.new<I32>(0);
let _walked = 0;
let _assignedRegisters = Array.new<Bool>(0);
let _boxes = Array.new<I32>(0);
let _targeted = Array.new<Bool>(0);
let _reachable = true;
let _breakTarget = -1;
let _continueTarget = -1;
let _handler: ?ThrowHandler = null;
let _pool = Array.new<Bytes>(0);
let _poolIndexes = Array.new<I32>(0);
let _wides = Array.new<I64>(0);
let _enumIndexes = Array.new<I32>(0);
let _natives = Array.new<Native>(0);
let _nativeIndexes = Array.new<I32>(0);

let _valueType: (I32) -> ValueType = fn(_ty) { ValueType.Bool };

let _valueTypes = fn(ty: I32): Array<ValueType> {
  let items = Array.new<ValueType>(0);
  let i = 0;

  while (i < typeArgCount(ty)) {
    items.push(_valueType(typeArg(ty, i)));
    i++;
  }
  items
};
_valueType = fn(ty) {
  match (kindOf(ty)) {
    Bool => ValueType.Bool,
    I32 => ValueType.I32,
    I64 => ValueType.I64,
    Bytes => ValueType.Bytes,
    Array => ValueType.ArrayOf(_valueType(innerOf(ty))),
    List => ValueType.ListOf(_valueType(innerOf(ty))),
    Null => ((innerOf(ty) >= 0) && isReference(innerOf(ty))) ? _valueType(innerOf(ty)) : ValueType.Dynamic,
    Tuple => ValueType.TupleOf(_valueTypes(ty)),
    Function => ValueType.Function(_valueTypes(ty), _valueType(innerOf(ty))),
    Enum => ValueType.Nominal(_enumIndexes[ty]),
    Dynamic => ValueType.Dynamic,
    ByteBuffer => ValueType.Bytes,
    Var, Param, Applied => {
      internalError("an inferred type reached lowering");
      ValueType.Dynamic
    },
  }
};

let _isDynamic = fn(id: I32): Bool { match (_valueType(typeOf(id))) { Dynamic => true, _ => false } };

let _fresh = fn(ty: I32): I32 {
  let register = _registers.len() as I32;
  _registers.push(_valueType(ty));
  register
};
let _node = -1;
let _emit = fn(op: Op, dst: I32, args: Array<I32>, imm: I32) { if (_reachable) { _instructions.push(instructionAt(op, dst, args, imm, _node)); } null };
let _move = fn(dst: I32, src: I32) { _emit(Op.Move, dst, [src], 0) };

let _poolIndex = fn(id: I32): I32 {
  while (_poolIndexes.len() <= id) { _poolIndexes.push(-1); }

  if (_poolIndexes[id] < 0) {
    _poolIndexes[id] = _pool.len() as I32;
    _pool.push(bytesOf(id));
  }
  _poolIndexes[id]
};

let _target = fn(block: I32) {
  while (_targeted.len() <= block) { _targeted.push(false); }
  _targeted[block] = true;
  null
};

let _open = fn(block: I32) {
  _instructions = Array.new<Instruction>(0);
  _block = block;
  _reachable = (block >= 0) && (block < _targeted.len()) && _targeted[block];
  null
};

let _end = fn(terminator: Terminator, next: I32) {
  if (_reachable) {
    _blocks.push(BasicBlock.Block(_block, _instructions, terminator, _handler));

    match (terminator) {
      Jump(target) => _target(target),
      Branch(_, thenTarget, elseTarget) => {
        _target(thenTarget);
        _target(elseTarget)
      },
      _ => null,
    };
  }
  _open(next)
};

let _bindRegister = fn(binding: I32, register: I32) {
  while (_bindings.len() <= valueOf(binding)) { _bindings.push(-1); }
  _bindings[valueOf(binding)] = register;
  null
};

let _markAssigned = fn(register: I32) {
  while (_assignedRegisters.len() <= register) { _assignedRegisters.push(false); }
  _assignedRegisters[register] = true;
  null
};

let _copy = fn(ty: I32, register: I32): I32 {
  let dst = _fresh(ty);
  _move(dst, register);
  dst
};

let _expr: (I32) -> I32 = fn(_id) { -1 };
let _lowerBlock: (I32) -> I32 = fn(_id) { -1 };

let _bind = fn(binding: I32) {
  let value = _expr(childOf(binding, 0));

  match (opOf(binding)) {
    InitGlobal => _emit(Op.GlobalSet, -1, [value], valueOf(binding)),
    Let => {
      let register = _copy(typeOf(binding), value);
      if ((_usesOf(valueOf(binding)) & _ASSIGNED) != 0) { _markAssigned(register); }
      _bindRegister(binding, register)
    },
    _ => {
      let assigned = (value >= 0) && (value < _assignedRegisters.len()) && _assignedRegisters[value];
      _bindRegister(binding, assigned ? _copy(typeOf(binding), value) : value)
    },
  }
};

let _values = fn(id: I32, start: I32): Array<I32> {
  let registers = Array.new<I32>(0);
  let i = start;

  while (i < childCount(id)) {
    registers.push(_expr(childOf(id, i)));
    i++;
  }
  registers
};

let _boxed = fn(id: I32): I32 {
  let box = match (opOf(id)) { Local when (valueOf(id) < _boxes.len()) => _boxes[valueOf(id)], _ => -1 };
  if (box >= 0) { return box; }
  let value = _expr(id);
  if (_isDynamic(id)) { return value; }
  let dst = _fresh(TYPE_DYNAMIC);
  _emit(Op.Box, dst, [value], 0);
  dst
};

let _if = fn(id: I32): I32 {
  let condition = _expr(childOf(id, 0));
  let thenBlock = _nextBlock;
  let elseBlock = thenBlock + 1;
  let joinBlock = thenBlock + 2;
  _nextBlock += 3;
  _end(Terminator.Branch(condition, thenBlock, elseBlock), thenBlock);
  let result = _fresh(typeOf(id));
  _move(result, _expr(childOf(id, 1)));
  _end(Terminator.Jump(joinBlock), elseBlock);
  _move(result, _expr(childOf(id, 2)));
  _end(Terminator.Jump(joinBlock), joinBlock);
  result
};

let _boolEqual = fn(id: I32): I32 {
  let left = _expr(childOf(id, 0));
  let right = _expr(childOf(id, 1));
  let sameBlock = _nextBlock;
  let flipBlock = sameBlock + 1;
  let joinBlock = sameBlock + 2;
  _nextBlock += 3;
  _end(Terminator.Branch(left, sameBlock, flipBlock), sameBlock);
  let result = _fresh(TYPE_BOOL);
  _move(result, right);
  _end(Terminator.Jump(joinBlock), flipBlock);
  _emit(Op.Not, result, [right], 0);
  _end(Terminator.Jump(joinBlock), joinBlock);
  result
};

let _shortCircuit = fn(id: I32): I32 {
  let result = _fresh(typeOf(id));
  _move(result, _expr(childOf(id, 0)));
  let rightBlock = _nextBlock;
  let joinBlock = rightBlock + 1;
  _nextBlock += 2;
  _end(match (opOf(id)) {
    And => Terminator.Branch(result, rightBlock, joinBlock),
    _ => Terminator.Branch(result, joinBlock, rightBlock),
  }, rightBlock);
  _move(result, _expr(childOf(id, 1)));
  _end(Terminator.Jump(joinBlock), joinBlock);
  result
};

let _operation = fn(id: I32): Op {
  match (opOf(id)) {
    Bool => Op.ConstBool, I32 => Op.ConstI32, I64 => Op.ConstI64, Bytes => Op.ConstBytes, Null => Op.ConstNull,
    Add => Op.Add, Sub => Op.Sub, Mul => Op.Mul, Shl => Op.Shl, Shr => Op.Shr, BitAnd => Op.BitAnd, BitOr => Op.BitOr, BitXor => Op.BitXor,
    Neg => Op.Neg, Not => Op.Not, Eq => Op.Eq, Lt, Gt => Op.Lt,
    Sext => Op.Sext, Trunc => Op.Trunc, IsNull, IsPresent => Op.IsNull,
    ArrayNew => Op.ArrayNew, ArrayLen => Op.ArrayLen, ArrayGet => Op.ArrayGet,
    ListNil => Op.ListNil, ListCons => Op.ListCons, ListHead => Op.ListHead, ListTail => Op.ListTail, ListIsNil => Op.ListIsNil,
    BytesNew => Op.BytesNew, BytesLen => Op.BytesLen, BytesGet => Op.BytesGet, BytesSlice => Op.BytesSlice, BytesConcat => Op.BytesConcat, BytesEq => Op.BytesEq,
    Tuple => Op.TupleNew, TupleField => Op.TupleGet, Call => Op.Call, CallIndirect => Op.CallIndirect, CallNative => Op.CallNative,
    EnumNew => Op.EnumNew, EnumTag => Op.EnumTag, EnumField => Op.EnumGet,
    _ => {
      internalError("invalid HIR expression op");
      Op.Move
    },
  }
};

let _nativeIndex = fn(native: I32): I32 {
  if (_nativeIndexes[native] < 0) {
    let ty = nativeTypeOf(native);
    _natives.push(Native.Native(nativeLibraryOf(native), nativeNameOf(native), _valueTypes(ty), _valueType(innerOf(ty))));
    _nativeIndexes[native] = (_natives.len() - 1) as I32;
  }
  _nativeIndexes[native]
};

let _i32 = fn(value: I32): I32 {
  let dst = _fresh(TYPE_I32);
  _emit(Op.ConstI32, dst, Array.new<I32>(0), value);
  dst
};

let _arithmetic = fn(op: Op, left: I32, right: I32): I32 {
  let dst = _fresh(TYPE_I32);
  _emit(op, dst, [left, right], 0);
  dst
};

let _length = fn(array: I32): I32 {
  let dst = _fresh(TYPE_I32);
  _emit(Op.ArrayLen, dst, [array], 0);
  dst
};

let _widened = fn(ty: I32, value: I32): I32 {
  if (ty == TYPE_I32) { return value; }
  let dst = _fresh(ty);
  _emit(Op.Sext, dst, [value], 0);
  dst
};

let _byMinusOne = fn(remainder: Bool, ty: I32, left: I32): I32 {
  if (remainder) { return _widened(ty, _i32(0)); }
  let dst = _fresh(ty);
  _emit(Op.Neg, dst, [left], 0);
  dst
};

let _divide = fn(id: I32): I32 {
  let ty = typeOf(id);
  let divisor = childOf(id, 1);
  let remainder = match (opOf(id)) { Rem => true, _ => false };
  let op = remainder ? Op.Rem : Op.Div;
  let constant = match (opOf(divisor)) { I32, I64 => true, _ => false };
  let minusOne = constant && (valueOf(divisor) == -1) && ((ty == TYPE_I32) || (auxOf(divisor) == -1));
  let left = _expr(childOf(id, 0));
  let right = _expr(divisor);
  if (minusOne) { return _byMinusOne(remainder, ty, left); }
  let result = _fresh(ty);

  if (constant) {
    _emit(op, result, [left, right], 0);
    return result;
  }
  let isMinusOne = _fresh(TYPE_BOOL);
  _emit(Op.Eq, isMinusOne, [right, _widened(ty, _i32(-1))], 0);
  let wrapBlock = _nextBlock;
  let divideBlock = wrapBlock + 1;
  let joinBlock = wrapBlock + 2;
  _nextBlock += 3;
  _end(Terminator.Branch(isMinusOne, wrapBlock, divideBlock), wrapBlock);
  _move(result, _byMinusOne(remainder, ty, left));
  _end(Terminator.Jump(joinBlock), divideBlock);
  _emit(op, result, [left, right], 0);
  _end(Terminator.Jump(joinBlock), joinBlock);
  result
};

let _arrayLiteral = fn(id: I32): I32 {
  let items = _values(id, 0);
  let array = _fresh(typeOf(id));
  _emit(Op.ArrayNew, array, [_i32(items.len() as I32)], 0);
  let i = 0;

  while (i < items.len()) {
    _emit(Op.ArraySet, -1, [array, _i32(i as I32), items[i]], 0);
    i++;
  }
  array
};

let _push = fn(id: I32): I32 {
  let operands = _values(id, 0);
  let array = operands[0];
  let length = _length(array);
  let grown = _arithmetic(Op.Add, length, _i32(1));
  _emit(Op.ArrayResize, -1, [array, grown], 0);
  _emit(Op.ArraySet, -1, [array, length, operands[1]], 0);
  grown
};

let _pop = fn(id: I32): I32 {
  let array = _expr(childOf(id, 0));
  let last = _arithmetic(Op.Sub, _length(array), _i32(1));
  let value = _fresh(typeOf(id));
  _emit(Op.ArrayGet, value, [array, last], 0);
  _emit(Op.ArrayResize, -1, [array, last], 0);
  value
};

let _try = fn(id: I32, value: Bool): I32 {
  let bodyBlock = _nextBlock;
  let catchBlock = bodyBlock + 1;
  let joinBlock = bodyBlock + 2;
  _nextBlock += 3;
  let result = value ? _fresh(typeOf(id)) : -1;
  let payload = _fresh(TYPE_DYNAMIC);
  if (valueOf(id) >= 0) { _bindRegister(id, payload); }
  _end(Terminator.Jump(bodyBlock), bodyBlock);
  let outer = _handler;
  let first = _blocks.len();
  _handler = ThrowHandler.Catch(catchBlock, payload);
  let body = _lowerBlock(childOf(id, 0));
  if (value) { _move(result, body); }
  _end(Terminator.Jump(joinBlock), -1);
  _handler = outer;
  let throws = false;
  let i = first;

  while (i < _blocks.len()) {
    match (_blocks[i]) { Block(_, instructions, terminator, handler) => {
      let catches = (handler != null) && (handlerTarget(handler) == catchBlock);
      if (catches && blockMayThrow(instructions, terminator)) { throws = true; }
    } };
    i++;
  }
  i = first;

  while (!throws && (i < _blocks.len())) {
    match (_blocks[i]) { Block(block, instructions, terminator, handler) => {
      let catches = (handler != null) && (handlerTarget(handler) == catchBlock);
      if (catches) { _blocks[i] = BasicBlock.Block(block, instructions, terminator, outer); }
    } };
    i++;
  }
  if (throws) { _target(catchBlock); }
  _open(catchBlock);
  let caught = _lowerBlock(childOf(id, 1));
  if (value) { _move(result, caught); }
  _end(Terminator.Jump(joinBlock), joinBlock);
  result
};

let _exprAt: (I32) -> I32 = fn(_id) { -1 };
_expr = fn(id) {
  let outer = _node;
  _node = id;
  let register = _exprAt(id);
  _node = outer;
  register
};

_exprAt = fn(id) {
  match (opOf(id)) {
    Local => {
      let register = _bindings[valueOf(id)];
      (_usesOf(valueOf(id)) & _OVERTAKEN) == 0 ? register : _copy(typeOf(id), register)
    },
    Assign => {
      let value = _expr(childOf(id, 0));
      _move(_bindings[valueOf(id)], value);
      value
    },
    Global => {
      let dst = _fresh(typeOf(id));
      _emit(Op.GlobalGet, dst, Array.new<I32>(0), valueOf(id));
      dst
    },
    SetGlobal => {
      let value = _expr(childOf(id, 0));
      _emit(Op.GlobalSet, -1, [value], valueOf(id));
      value
    },
    ArraySet => {
      let operands = _values(id, 0);
      _emit(Op.ArraySet, -1, operands, 0);
      operands[2]
    },
    BytesSet => {
      let operands = _values(id, 0);
      _emit(Op.BytesSet, -1, operands, 0);
      operands[2]
    },
    BytesSlice when (typeOf(childOf(id, 0)) == TYPE_BYTE_BUFFER) => {
      let operands = _values(id, 0);
      let view = _fresh(TYPE_BYTES);
      _emit(Op.BytesSlice, view, operands, 0);
      let copy = _fresh(TYPE_BYTES);
      _emit(Op.BytesNew, copy, [operands[2]], 0);
      _emit(Op.BytesBlit, -1, [copy, view, _i32(0)], 0);
      copy
    },
    ArrayLiteral => _arrayLiteral(id),
    ArrayPush => _push(id),
    ArrayPop => _pop(id),
    ArrayResize => {
      let operands = _values(id, 0);
      _emit(Op.ArrayResize, -1, operands, 0);
      operands[0]
    },
    Present => {
      let value = _expr(childOf(id, 0));
      if (isReference(innerOf(typeOf(id)))) { return value; }
      let dst = _fresh(typeOf(id));
      _emit(Op.Box, dst, [value], 0);
      dst
    },
    ToDynamic => _boxed(childOf(id, 0)),
    FunctionRef => {
      let captures = Array.new<I32>(0);
      let i = 0;

      while (i < childCount(id)) {
        captures.push(_boxed(childOf(id, i)));
        i++;
      }
      let dst = _fresh(typeOf(id));
      _emit(Op.ConstFunction, dst, captures, valueOf(id));
      dst
    },
    FromDynamic => {
      let value = _expr(childOf(id, 0));
      let dst = _fresh(typeOf(id));
      _emit(Op.Unbox, dst, [value], 0);
      if (isReference(typeOf(id))) { _emit(Op.NullCheck, -1, [dst], 0); }
      dst
    },
    IsKind when (valueOf(id) == KIND_ENUM) => {
      let dst = _fresh(TYPE_BOOL);
      _emit(Op.IsEnum, dst, [_expr(childOf(id, 0))], _enumIndexes[auxOf(id)]);
      dst
    },
    IsKind => {
      let kind = _fresh(TYPE_I32);
      _emit(Op.KindOf, kind, [_expr(childOf(id, 0))], 0);
      let wide = valueOf(id) == KIND_I64;
      let tested = wide ? _arithmetic(Op.Mul, _arithmetic(Op.Sub, kind, _i32(KIND_I32)), _arithmetic(Op.Sub, kind, _i32(KIND_I64))) : kind;
      let dst = _fresh(TYPE_BOOL);
      _emit(Op.Eq, dst, [tested, _i32(wide ? 0 : valueOf(id))], 0);
      dst
    },
    Unwrap => {
      let value = _expr(childOf(id, 0));

      if (!isReference(typeOf(id))) {
        let dst = _fresh(typeOf(id));
        _emit(Op.Unbox, dst, [value], 0);
        return dst;
      }
      if (valueOf(id) == 1) { _emit(Op.NullCheck, -1, [value], 0); }
      value
    },
    Block => _lowerBlock(id),
    If => _if(id),
    Try => _try(id, true),
    And, Or => _shortCircuit(id),
    Eq when (typeOf(childOf(id, 0)) == TYPE_BOOL) => _boolEqual(id),
    Div, Rem => _divide(id),
    _ => {
      let operands = _values(id, 0);
      let op = _operation(id);

      let imm = match (opOf(id)) {
        Bool, I32, TupleField, Call, EnumNew, EnumField => valueOf(id),
        Bytes => _poolIndex(valueOf(id)),
        CallNative => _nativeIndex(valueOf(id)),
        I64 => {
          _wides.push(wideValueOf(id));
          (_wides.len() - 1) as I32
        },
        _ => 0,
      };

      match (opOf(id)) {
        Gt => {
          operands = [operands[1], operands[0]];
          null
        }, _ => null
      };
      let present = match (opOf(id)) { IsPresent => true, _ => false };
      let dst = _fresh(present ? TYPE_BOOL : typeOf(id));
      _emit(op, dst, operands, imm);

      if (present) {
        let negated = _fresh(TYPE_BOOL);
        _emit(Op.Not, negated, [dst], 0);
        negated
      } else { dst }
    },
  }
};

let _exit = fn(terminator: Terminator) { _end(terminator, -1) };

let _while = fn(id: I32) {
  let conditionBlock = _nextBlock;
  let bodyBlock = conditionBlock + 1;
  let exitBlock = conditionBlock + 2;
  _nextBlock += 3;
  _end(Terminator.Jump(conditionBlock), conditionBlock);
  let condition = _expr(childOf(id, 0));
  _end(Terminator.Branch(condition, bodyBlock, exitBlock), bodyBlock);
  let outerBreak = _breakTarget;
  let outerContinue = _continueTarget;
  _breakTarget = exitBlock;
  _continueTarget = conditionBlock;
  _lowerBlock(childOf(id, 1));
  _breakTarget = outerBreak;
  _continueTarget = outerContinue;
  _end(Terminator.Jump(conditionBlock), exitBlock);
  null
};

let _statement: (I32) -> Bool = fn(_id) { false };
let _statementAt: (I32) -> Bool = fn(_id) { false };

let _ifStatement = fn(id: I32) {
  let condition = _expr(childOf(id, 0));
  let thenBlock = _nextBlock;
  let joinBlock = thenBlock + 1;
  let hasElse = childCount(id) == 3;
  let elseBlock = hasElse ? thenBlock + 2 : joinBlock;
  _nextBlock += hasElse ? 3 : 2;
  _end(Terminator.Branch(condition, thenBlock, elseBlock), thenBlock);
  _lowerBlock(childOf(id, 1));
  _end(Terminator.Jump(joinBlock), elseBlock);

  if (hasElse) {
    let otherwise = childOf(id, 2);

    match (opOf(otherwise)) {
      IfStatement => _statement(otherwise), _ => {
        _lowerBlock(otherwise);
        true
      }
    };
    _end(Terminator.Jump(joinBlock), joinBlock);
  }
  null
};

_statement = fn(id) {
  let outer = _node;
  _node = id;
  let done = _statementAt(id);
  _node = outer;
  done
};

_statementAt = fn(id) {
  match (opOf(id)) {
    Declare => {
      let i = 0;

      while (i < childCount(id)) {
        _bind(childOf(id, i));
        i++;
      } null
    },
    Expression => {
      _expr(childOf(id, 0));
      null
    },
    Return => _exit(Terminator.ReturnValue(_expr(childOf(id, 0)))),
    Throw => _exit(Terminator.Throw(_expr(childOf(id, 0)), id)),
    Break => _exit(Terminator.Jump(_breakTarget)),
    Continue => _exit(Terminator.Jump(_continueTarget)),
    While => _while(id),
    IfStatement => _ifStatement(id),
    TryStatement => {
      _try(id, false);
      null
    },
    Block => {
      _lowerBlock(id);
      null
    },
    _ => {
      internalError("invalid HIR statement op");
      null
    },
  };
  true
};

_lowerBlock = fn(id) {
  let statements = childCount(id) - auxOf(id);
  let i = 0;

  while (i < statements) {
    _statement(childOf(id, i));
    i++;
  }
  (_reachable && (auxOf(id) == 1)) ? _expr(lastChild(id)) : -1
};

let _usesOf = fn(binding: I32): I32 { binding < _uses.len() ? _uses[binding] : 0 };

let _use = fn(binding: I32, flag: I32) {
  while (_uses.len() <= binding) {
    _uses.push(0);
    _lastRead.push(-1);
  }
  _uses[binding] = _uses[binding] | flag;
  null
};

let _markUses: (I32, I32) -> Null = fn(_id, _expression) { null };
_markUses = fn(id, expression) {
  let at = _walked;
  _walked++;
  let reboxes = false;

  let sequential = match (opOf(id)) {
    Block, If, IfStatement, While, Try, TryStatement, Let, Const, Declare, Expression, Return, Throw, SetGlobal, InitGlobal, And, Or => true,
    Assign => {
      let overtakes = (expression >= 0) && (valueOf(id) < _lastRead.len()) && (_lastRead[valueOf(id)] > expression);
      _use(valueOf(id), overtakes ? _ASSIGNED | _OVERTAKEN : _ASSIGNED);
      true
    },
    Local => {
      _use(valueOf(id), _UNBOXED);
      _lastRead[valueOf(id)] = at;
      true
    },
    FunctionRef, ToDynamic => {
      reboxes = true;
      false
    },
    _ => false,
  };
  let inner = ((expression < 0) && !sequential && (childCount(id) > 1)) ? at : expression;
  let i = 0;

  while (i < childCount(id)) {
    let child = childOf(id, i);
    match (opOf(child)) { Local when (reboxes) => null, _ => _markUses(child, inner) };
    i++;
  }
  null
};

let _begin = fn(body: I32) {
  _registers = Array.new<ValueType>(0);
  _instructions = Array.new<Instruction>(0);
  _blocks = Array.new<BasicBlock>(0);
  _block = 0;
  _nextBlock = 1;
  _bindings = Array.new<I32>(0);
  _uses = Array.new<I32>(0);
  _lastRead = Array.new<I32>(0);
  _walked = 0;
  _assignedRegisters = Array.new<Bool>(0);
  _boxes = Array.new<I32>(0);
  _targeted = [true];
  _reachable = true;
  _breakTarget = -1;
  _continueTarget = -1;
  _handler = null;
  _node = -1;
  _markUses(body, -1)
};

let _function = fn(id: I32, functionId: I32): IrFunction {
  _begin(lastChild(id));
  let params = Array.new<I32>(0);
  let arguments = typeArgCount(typeOf(id));
  let i = 0;

  while (i < childCount(id) - 1) {
    let param = childOf(id, i);
    let capture = match (opOf(param)) { Capture => true, _ => false };
    let register = _fresh(capture ? TYPE_DYNAMIC : typeOf(param));
    params.push(register);

    if (capture) {
      while (_boxes.len() <= valueOf(param)) { _boxes.push(-1); }
      _boxes[valueOf(param)] = register;
    }
    let bound = register;

    if (capture && !_isDynamic(param) && ((_usesOf(valueOf(param)) & _UNBOXED) != 0)) {
      bound = _fresh(typeOf(param));
      _emit(Op.Unbox, bound, [register], 0);
    }
    _bindRegister(param, bound);
    i++;
  }
  let result = _lowerBlock(lastChild(id));
  _end(Terminator.ReturnValue(result), -1);
  let captures = (params.len() as I32) - arguments;
  IrFunction.Function(functionId, params, captures, _registers, _valueType(innerOf(typeOf(id))), _blocks, 0)
};

export let functionNode: (I32) -> I32 = fn(functionId) {
  let root = rootNode();
  functionId == 0 ? lastChild(root) : childOf(root, functionId - 1)
};

export let lowerProgram: (Hir) -> IrProgram = fn(program) {
  useHir(program);
  _pool = Array.new<Bytes>(0);
  _poolIndexes = Array.new<I32>(0);
  _wides = Array.new<I64>(0);
  _natives = Array.new<Native>(0);
  _nativeIndexes = Array.new<I32>(0);
  while (_nativeIndexes.len() < nativeCount()) { _nativeIndexes.push(-1); }
  _enumIndexes = Array.new<I32>(0);
  let enumTypes = Array.new<I32>(0);
  let ty = 0;

  while (ty < typeCount()) {
    _enumIndexes.push(match (kindOf(ty)) {
      Enum when (!isTemplateEnum(ty)) => {
        enumTypes.push(ty);
        (enumTypes.len() - 1) as I32
      }, _ => -1
    });
    ty++;
  }
  let enums = Array.new<EnumSchema>(0);
  let e = 0;

  while (e < enumTypes.len()) {
    let variants = Array.new<Array<ValueType>>(0);
    let tag = 0;

    while (tag < variantCount(enumTypes[e])) {
      let fields = Array.new<ValueType>(0);
      let f = 0;

      while (f < fieldCount(enumTypes[e], tag)) {
        fields.push(_valueType(fieldType(enumTypes[e], tag, f)));
        f++;
      }
      variants.push(fields);
      tag++;
    }
    enums.push(EnumSchema.Enum(variants));
    e++;
  }
  let root = rootNode();
  let functions = Array.new<IrFunction>(0);
  let i = 0;

  while (i < childCount(root) - 1) {
    functions.push(_function(childOf(root, i), i + 1));
    i++;
  }
  let body = lastChild(root);
  _begin(body);
  let result = _lowerBlock(body);
  _end(Terminator.ReturnValue(result), -1);
  functions.push(IrFunction.Function(0, [], 0, _registers, _valueType(typeOf(body)), _blocks, 0));
  let globals = Array.new<ValueType>(0);
  i = 0;

  while (i < globalCount()) {
    globals.push(_valueType(globalTypeOf(i)));
    i++;
  }
  let lowered = IrProgram.Program(functions, _pool, _wides, enums, globals, _natives);
  verifyProgram(lowered);
  lowered
};
