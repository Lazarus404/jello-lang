      let i = 0;

      while (i < childCount(id)) {
        captures.push(_capturedBox(childOf(id, i)));
        i++;
      }
      let dst = _fresh(typeOf(id));
      _emit(Op.ConstFunction, dst, captures, valueOf(id));
      dst
    },
    FromDynamic => {
      let value = _expr(childOf(id, 0));
      let dst = _fresh(typeOf(id));
      _emit(Op.Unbox, dst, [value], 0);
      if (isReference(typeOf(id))) { _emit(Op.NullCheck, -1, [dst], 0); }
      dst
    },
    IsKind when (valueOf(id) == KIND_ENUM) => {
      let dst = _fresh(TYPE_BOOL);
      _emit(Op.IsEnum, dst, [_expr(childOf(id, 0))], _enumIndexes[auxOf(id)]);
      dst
    },
    IsKind => {
      let kind = _fresh(TYPE_I32);
      _emit(Op.KindOf, kind, [_expr(childOf(id, 0))], 0);
      let code = valueOf(id);
      let wide = (code == KIND_I64) || isFloatKind(code);
      let tested = wide ? _arithmetic(Op.Mul, _arithmetic(Op.Sub, kind, _i32(KIND_I32)), _arithmetic(Op.Sub, kind, _i32(code))) : kind;
      let dst = _fresh(TYPE_BOOL);
      _emit(Op.Eq, dst, [tested, _i32(wide ? 0 : code)], 0);
