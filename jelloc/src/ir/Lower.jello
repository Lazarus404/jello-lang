package ir;

import type {
  Binding as HirBinding,
  BindingId,
  Expr,
  FunctionDecl,
  FunctionBody,
  FunctionId,
  Parameter,
  Program as HirProgram,
  Type as HirType,
  Statement,
} from frontend.Hir;
import type {
  BasicBlock,
  Function as IrFunction,
  Instruction,
  Program as IrProgram,
  ReturnType,
  Terminator,
  ValueType,
} from ir.Model;
import { verifyProgram } from ir.Verify;

let _bindingId = fn(id: BindingId): I32 { match (id) { Id(value) => value } };
let _functionId = fn(id: FunctionId): I32 { match (id) { Id(value) => value } };

let _valueType = fn(ty: HirType): ValueType {
  match (ty) {
    Bool => ValueType.Bool,
    I32 => ValueType.I32,
    I64 => ValueType.I64,
  }
};

let _setBinding = fn(bindings: Array<I32>, id: BindingId, register: I32) {
  let index = _bindingId(id);
  while (bindings.len() <= index) { bindings.push(-1); }
  bindings[index] = register;
  null
};

let _bindValue = fn(
  binding: HirBinding,
  valueRegister: I32,
  bindings: Array<I32>,
  registers: Array<ValueType>,
  instructions: Array<Instruction>
) {
  match (binding) {
    Binding(id, _, ty, mutable, _) => {
      if (mutable) {
        let register = registers.len() as I32;
        registers.push(_valueType(ty));
        instructions.push(Instruction.Move(register, valueRegister));
        _setBinding(bindings, id, register);
      } else {
        _setBinding(bindings, id, valueRegister);
      }
    },
  };
  null
};

let _lowerExpr: (
  Expr,
  Array<I32>,
  Array<ValueType>,
  Array<Instruction>,
  Array<BasicBlock>,
  I32,
  Array<I32>
) -> Tuple<I32, ValueType, Array<Instruction>, I32> =
  fn(expr, bindings, registers, instructions, blocks, blockId, nextBlock) {
  match (expr) {
    BoolLiteral(value) => {
      let dst = registers.len() as I32;
      registers.push(ValueType.Bool);
      instructions.push(Instruction.ConstBool(dst, value));
      (dst, ValueType.Bool, instructions, blockId)
    },
    I32Literal(value) => {
      let dst = registers.len() as I32;
      registers.push(ValueType.I32);
      instructions.push(Instruction.ConstI32(dst, value));
      (dst, ValueType.I32, instructions, blockId)
    },
    Local(id, ty) => (bindings[_bindingId(id)], _valueType(ty), instructions, blockId),
    AssignLocal(id, value, ty) => {
      let (src, _, nextInstructions, nextId) = _lowerExpr(
        value, bindings, registers, instructions, blocks, blockId, nextBlock
      );
      let dst = bindings[_bindingId(id)];
      nextInstructions.push(Instruction.Move(dst, src));
      (dst, _valueType(ty), nextInstructions, nextId)
    },
    AddI32Wrap(left, right) => {
      let (leftRegister, _, afterLeft, leftBlock) = _lowerExpr(
        left, bindings, registers, instructions, blocks, blockId, nextBlock
      );
      let (rightRegister, _, afterRight, rightBlock) = _lowerExpr(
        right, bindings, registers, afterLeft, blocks, leftBlock, nextBlock
      );
      let dst = registers.len() as I32;
      registers.push(ValueType.I32);
      afterRight.push(Instruction.AddI32Wrap(dst, leftRegister, rightRegister));
      (dst, ValueType.I32, afterRight, rightBlock)
    },
    SubI32Wrap(left, right) => {
      let (leftRegister, _, afterLeft, leftBlock) = _lowerExpr(
        left, bindings, registers, instructions, blocks, blockId, nextBlock
      );
      let (rightRegister, _, afterRight, rightBlock) = _lowerExpr(
        right, bindings, registers, afterLeft, blocks, leftBlock, nextBlock
      );
      let dst = registers.len() as I32;
      registers.push(ValueType.I32);
      afterRight.push(Instruction.SubI32Wrap(dst, leftRegister, rightRegister));
      (dst, ValueType.I32, afterRight, rightBlock)
    },
    MultiplyI32Wrap(left, right) => {
      let (leftRegister, _, afterLeft, leftBlock) = _lowerExpr(left, bindings, registers, instructions, blocks, blockId, nextBlock);
      let (rightRegister, _, afterRight, rightBlock) = _lowerExpr(right, bindings, registers, afterLeft, blocks, leftBlock, nextBlock);
      let dst = registers.len() as I32;
      registers.push(ValueType.I32);
      afterRight.push(Instruction.MultiplyI32Wrap(dst, leftRegister, rightRegister));
      (dst, ValueType.I32, afterRight, rightBlock)
    },
    NegateI32Wrap(value) => {
      let (src, _, nextInstructions, nextId) = _lowerExpr(value, bindings, registers, instructions, blocks, blockId, nextBlock);
      let dst = registers.len() as I32;
      registers.push(ValueType.I32);
      nextInstructions.push(Instruction.NegateI32Wrap(dst, src));
      (dst, ValueType.I32, nextInstructions, nextId)
    },
    NotBool(value) => {
      let (src, _, nextInstructions, nextId) = _lowerExpr(value, bindings, registers, instructions, blocks, blockId, nextBlock);
      let dst = registers.len() as I32;
      registers.push(ValueType.Bool);
      nextInstructions.push(Instruction.NotBool(dst, src));
      (dst, ValueType.Bool, nextInstructions, nextId)
    },
    EqualI32(left, right) => {
      let (leftRegister, _, afterLeft, leftBlock) = _lowerExpr(
        left, bindings, registers, instructions, blocks, blockId, nextBlock
      );
      let (rightRegister, _, afterRight, rightBlock) = _lowerExpr(
        right, bindings, registers, afterLeft, blocks, leftBlock, nextBlock
      );
      let dst = registers.len() as I32;
      registers.push(ValueType.Bool);
      afterRight.push(Instruction.EqualI32(dst, leftRegister, rightRegister));
      (dst, ValueType.Bool, afterRight, rightBlock)
    },
    LessI32Signed(left, right) => {
      let (leftRegister, _, afterLeft, leftBlock) = _lowerExpr(
        left, bindings, registers, instructions, blocks, blockId, nextBlock
      );
      let (rightRegister, _, afterRight, rightBlock) = _lowerExpr(
        right, bindings, registers, afterLeft, blocks, leftBlock, nextBlock
      );
      let dst = registers.len() as I32;
      registers.push(ValueType.Bool);
      afterRight.push(Instruction.LessI32Signed(dst, leftRegister, rightRegister));
      (dst, ValueType.Bool, afterRight, rightBlock)
    },
    GreaterI32Signed(left, right) => {
      let (leftRegister, _, afterLeft, leftBlock) = _lowerExpr(
        left, bindings, registers, instructions, blocks, blockId, nextBlock
      );
      let (rightRegister, _, afterRight, rightBlock) = _lowerExpr(
        right, bindings, registers, afterLeft, blocks, leftBlock, nextBlock
      );
      let dst = registers.len() as I32;
      registers.push(ValueType.Bool);
      afterRight.push(Instruction.LessI32Signed(dst, rightRegister, leftRegister));
      (dst, ValueType.Bool, afterRight, rightBlock)
    },
    SignExtendI32ToI64(value) => {
      let (src, _, nextInstructions, nextId) = _lowerExpr(value, bindings, registers, instructions, blocks, blockId, nextBlock);
      let dst = registers.len() as I32;
      registers.push(ValueType.I64);
      nextInstructions.push(Instruction.SignExtendI32ToI64(dst, src));
      (dst, ValueType.I64, nextInstructions, nextId)
    },
    TruncateI64ToI32(value) => {
      let (src, _, nextInstructions, nextId) = _lowerExpr(value, bindings, registers, instructions, blocks, blockId, nextBlock);
      let dst = registers.len() as I32;
      registers.push(ValueType.I32);
      nextInstructions.push(Instruction.TruncateI64ToI32(dst, src));
      (dst, ValueType.I32, nextInstructions, nextId)
    },
    CallDirect(function, args, ty) => {
      let callArgs = Array.new<I32>(0);
      let currentInstructions = instructions;
      let currentBlock = blockId;
      let i = 0;

      while (i < args.len()) {
        let (arg, _, nextInstructions, nextId) = _lowerExpr(
          args[i], bindings, registers, currentInstructions, blocks, currentBlock, nextBlock
        );
        callArgs.push(arg);
        currentInstructions = nextInstructions;
        currentBlock = nextId;
        i++;
      }
      let resultType = _valueType(ty);
      let dst = registers.len() as I32;
      registers.push(resultType);
      currentInstructions.push(Instruction.CallDirect(dst, _functionId(function), callArgs));
      (dst, resultType, currentInstructions, currentBlock)
    },
    Block(blockBindings, tail) => {
      let currentInstructions = instructions;
      let currentBlock = blockId;
      let i = 0;

      while (i < blockBindings.len()) {
        match (blockBindings[i]) {
          Binding(_, _, _, _, value) => {
            let (register, _, nextInstructions, nextId) = _lowerExpr(
              value, bindings, registers, currentInstructions, blocks, currentBlock, nextBlock
            );
            currentInstructions = nextInstructions;
            currentBlock = nextId;
            _bindValue(blockBindings[i], register, bindings, registers, currentInstructions);
          },
          _ => {
            throw "internal: function binding in expression block";
            null
          },
        };
        i++;
      }
      _lowerExpr(tail, bindings, registers, currentInstructions, blocks, currentBlock, nextBlock)
    },
    If(condition, thenBranch, elseBranch, ty) => {
      let (conditionRegister, _, conditionInstructions, conditionBlock) = _lowerExpr(
        condition, bindings, registers, instructions, blocks, blockId, nextBlock
      );
      let thenBlock = nextBlock[0];
      let elseBlock = thenBlock + 1;
      let joinBlock = thenBlock + 2;
      nextBlock[0] = nextBlock[0] + 3;
      blocks.push(BasicBlock.Block(
        conditionBlock,
        conditionInstructions,
        Terminator.Branch(conditionRegister, thenBlock, elseBlock),
        null
      ));

      let resultType = _valueType(ty);
      let result = registers.len() as I32;
      registers.push(resultType);
      let (thenValue, _, thenInstructions, thenEnd) = _lowerExpr(
        thenBranch, bindings, registers, [], blocks, thenBlock, nextBlock
      );
      thenInstructions.push(Instruction.Move(result, thenValue));
      blocks.push(BasicBlock.Block(thenEnd, thenInstructions, Terminator.Jump(joinBlock), null));

      let (elseValue, _, elseInstructions, elseEnd) = _lowerExpr(
        elseBranch, bindings, registers, [], blocks, elseBlock, nextBlock
      );
      elseInstructions.push(Instruction.Move(result, elseValue));
      blocks.push(BasicBlock.Block(elseEnd, elseInstructions, Terminator.Jump(joinBlock), null));
      (result, resultType, Array.new<Instruction>(0), joinBlock)
    },
  }
};

let _lowerStatements: (
  Array<Statement>, Array<I32>, Array<ValueType>, Array<BasicBlock>, I32, Array<I32>, Array<Bool>, I32, I32
) -> Tuple<Array<Instruction>, I32> =
  fn(statements, bindings, registers, blocks, blockId, nextBlock, reachable, breakTarget, continueTarget) {
  let instructions = Array.new<Instruction>(0);
  let currentBlock = blockId;
  let i = 0;

  while (i < statements.len()) {
    let statement = statements[i];

    let ignored = match (statement) {
      Bind(binding) => match (binding) { Binding(id, _, _, _, value) => {
        let (register, _, nextInstructions, nextId) = _lowerExpr(
          value, bindings, registers, instructions, blocks, currentBlock, nextBlock
        );
        instructions = nextInstructions;
        currentBlock = nextId;
        _bindValue(binding, register, bindings, registers, instructions);
      } },
      Expression(value) => {
        let (_, _, nextInstructions, nextId) = _lowerExpr(
          value, bindings, registers, instructions, blocks, currentBlock, nextBlock
        );
        instructions = nextInstructions;
        currentBlock = nextId;
      },
      ReturnValue(value) => {
        let (register, _, nextInstructions, nextId) = _lowerExpr(
          value, bindings, registers, instructions, blocks, currentBlock, nextBlock
        );
        blocks.push(BasicBlock.Block(nextId, nextInstructions, Terminator.ReturnValue(register), null));
        instructions = [];
        currentBlock = nextId;
        reachable[0] = false;
      },
      ThrowValue(value) => {
        let (register, _, nextInstructions, nextId) = _lowerExpr(
          value, bindings, registers, instructions, blocks, currentBlock, nextBlock
        );
        blocks.push(BasicBlock.Block(nextId, nextInstructions, Terminator.Throw(register), null));
        instructions = [];
        currentBlock = nextId;
        reachable[0] = false;
      },
      BreakLoop => {
        blocks.push(BasicBlock.Block(currentBlock, instructions, Terminator.Jump(breakTarget), null));
        instructions = [];
        reachable[0] = false;
      },
      ContinueLoop => {
        blocks.push(BasicBlock.Block(currentBlock, instructions, Terminator.Jump(continueTarget), null));
        instructions = [];
        reachable[0] = false;
      },
      WhileLoop(condition, body) => {
        let conditionBlock = nextBlock[0];
        let bodyBlock = conditionBlock + 1;
        let exitBlock = conditionBlock + 2;
        nextBlock[0] = nextBlock[0] + 3;
        blocks.push(BasicBlock.Block(currentBlock, instructions, Terminator.Jump(conditionBlock), null));
        let (conditionRegister, _, conditionInstructions, conditionEnd) = _lowerExpr(
          condition, bindings, registers, [], blocks, conditionBlock, nextBlock
        );
        blocks.push(BasicBlock.Block(
          conditionEnd, conditionInstructions, Terminator.Branch(conditionRegister, bodyBlock, exitBlock), null
        ));
        let bodyReachable: Array<Bool> = [true];
        let (bodyInstructions, bodyEnd) = _lowerStatements(
          body, bindings, registers, blocks, bodyBlock, nextBlock, bodyReachable, exitBlock, conditionBlock
        );

        if (bodyReachable[0]) {
          blocks.push(BasicBlock.Block(bodyEnd, bodyInstructions, Terminator.Jump(conditionBlock), null));
        }
        instructions = [];
        currentBlock = exitBlock;
      },
    };
    i++;
  }
  (instructions, currentBlock)
};

let _lowerFunction = fn(declaration: FunctionDecl): IrFunction {
  match (declaration) {
    FunctionDecl(id, _, params, result, FunctionBody(statements, tail)) => {
      let bindingRegisters = Array.new<I32>(0);
      let registers = Array.new<ValueType>(0);
      let paramRegisters = Array.new<I32>(0);
      let i = 0;

      while (i < params.len()) {
        match (params[i]) {
          Parameter(bindingId, _, ty) => {
            let register = registers.len() as I32;
            registers.push(_valueType(ty));
            paramRegisters.push(register);
            _setBinding(bindingRegisters, bindingId, register);
          },
        };
        i++;
      }
      let blocks = Array.new<BasicBlock>(0);
      let nextBlock: Array<I32> = [1];
      let reachable: Array<Bool> = [true];
      let (instructions, finalBlock) = _lowerStatements(
        statements, bindingRegisters, registers, blocks, 0, nextBlock, reachable, -1, -1
      );

      if (reachable[0]) {
        let (value, _, tailInstructions, tailBlock) = _lowerExpr(
          tail, bindingRegisters, registers, instructions, blocks, finalBlock, nextBlock
        );
        blocks.push(BasicBlock.Block(tailBlock, tailInstructions, Terminator.ReturnValue(value), null));
      }
      IrFunction.Function(
        _functionId(id), paramRegisters, registers, ReturnType.Value(_valueType(result)), blocks, 0
      )
    },
  }
};

let _lowerTail = fn(program: HirProgram): IrProgram {
  let bindingRegisters = Array.new<I32>(0);
  let registers = Array.new<ValueType>(0);
  let instructions = Array.new<Instruction>(0);
  let blocks = Array.new<BasicBlock>(0);
  let currentBlock = 0;
  let nextBlock: Array<I32> = [1];
  let functions = Array.new<FunctionDecl>(0);
  let tailExpr: Expr = Expr.BoolLiteral(false);

  match (program) {
    Program(functionDecls, bindings, tail, _) => {
      let i = 0;

      while (i < functionDecls.len()) {
        functions.push(functionDecls[i]);
        i++;
      }
      tailExpr = tail;
      i = 0;

      while (i < bindings.len()) {
        match (bindings[i]) {
          Binding(id, _, _, _, value) => {
            let (register, _, nextInstructions, nextId) = _lowerExpr(
              value, bindingRegisters, registers, instructions, blocks, currentBlock, nextBlock
            );
            instructions = nextInstructions;
            currentBlock = nextId;
            _bindValue(bindings[i], register, bindingRegisters, registers, instructions);
          },
        };
        i++;
      }
      null
    },
  };
  let (resultRegister, resultType, finalInstructions, finalBlock) = _lowerExpr(
    tailExpr, bindingRegisters, registers, instructions, blocks, currentBlock, nextBlock
  );
  blocks.push(BasicBlock.Block(finalBlock, finalInstructions, Terminator.ReturnValue(resultRegister), null));
  let main = IrFunction.Function(
    0,
    [],
    registers,
    ReturnType.Value(resultType),
    blocks,
    0
  );
  let loweredFunctions = Array.new<IrFunction>(0);
  let i = 0;

  while (i < functions.len()) {
    loweredFunctions.push(_lowerFunction(functions[i]));
    i++;
  }
  loweredFunctions.push(main);
  IrProgram.Program(loweredFunctions)
};

export let lowerProgram: (HirProgram) -> IrProgram = fn(program) {
  let lowered = _lowerTail(program);
  verifyProgram(lowered);
  lowered
};
