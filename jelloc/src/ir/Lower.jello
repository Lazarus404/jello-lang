  while (i < values.len()) {
    let field = childOf(id, i);
    let width = segmentWidth(auxOf(field));
    if (width == 0) { _emit(Op.BytesBlit, -1, [bytes, values[i], _i32(fixed)], 0); } else if (width <= 8) { _emit(Op.BitsWrite, -1, [bytes, values[i]], valueOf(field) * 16 + width); } else { _emit(Op.BytesWrite, -1, [bytes, _i32(valueOf(field) / 8), values[i]], _bytesFormat(auxOf(field))); }
    i++;
  }
