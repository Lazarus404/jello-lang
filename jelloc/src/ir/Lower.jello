package ir;

import type { Hir } from frontend.Hir;
import {
  TYPE_BOOL, TYPE_I32, auxOf, bytesOf, childCount, childOf, fieldCount, fieldType, innerOf, isReference, kindOf, lastChild, opOf, rootNode, typeArg,
  typeArgCount, typeCount, globalCount, globalTypeOf, typeOf, useHir, valueOf, variantCount,
} from frontend.Hir;
import type { BasicBlock, EnumSchema, Function as IrFunction, Instruction, Op, Program as IrProgram, Terminator, ValueType } from ir.Model;
import { BasicBlock, EnumSchema, Op, Program as IrProgram, ReturnType, Terminator, ValueType, instruction } from ir.Model;
import { verifyProgram } from ir.Verify;

let _registers = Array.new<ValueType>(0);
let _instructions = Array.new<Instruction>(0);
let _blocks = Array.new<BasicBlock>(0);
let _block = 0;
let _nextBlock = 1;
let _bindings = Array.new<I32>(0);
let _targeted = Array.new<Bool>(0);
let _reachable = true;
let _breakTarget = -1;
let _continueTarget = -1;
let _pool = Array.new<Bytes>(0);
let _poolIndexes = Array.new<I32>(0);
let _enumIndexes = Array.new<I32>(0);

let _valueType: (I32) -> ValueType = fn(_ty) { ValueType.Bool };

let _valueTypes = fn(ty: I32): Array<ValueType> {
  let items = Array.new<ValueType>(0);
  let i = 0;

  while (i < typeArgCount(ty)) {
    items.push(_valueType(typeArg(ty, i)));
    i++;
  }
  items
};
_valueType = fn(ty) {
  match (kindOf(ty)) {
    Bool => ValueType.Bool,
    I32 => ValueType.I32,
    I64 => ValueType.I64,
    Bytes => ValueType.Bytes,
    Array => ValueType.ArrayOf(_valueType(innerOf(ty))),
    Null => ((innerOf(ty) >= 0) && isReference(innerOf(ty))) ? _valueType(innerOf(ty)) : ValueType.Dynamic,
    Tuple => ValueType.TupleOf(_valueTypes(ty)),
    Function => ValueType.Function(_valueTypes(ty), ReturnType.Value(_valueType(innerOf(ty)))),
    Enum => ValueType.Nominal(_enumIndexes[ty]),
    Dynamic => ValueType.Dynamic,
  }
};

let _isDynamic = fn(id: I32): Bool { match (_valueType(typeOf(id))) { Dynamic => true, _ => false } };

let _fresh = fn(ty: I32): I32 {
  let register = _registers.len() as I32;
  _registers.push(_valueType(ty));
  register
};
let _emit = fn(op: Op, dst: I32, args: Array<I32>, imm: I32) { if (_reachable) { _instructions.push(instruction(op, dst, args, imm)); } null };
let _move = fn(dst: I32, src: I32) { _emit(Op.Move, dst, [src], 0) };

let _poolIndex = fn(id: I32): I32 {
  while (_poolIndexes.len() <= id) { _poolIndexes.push(-1); }

  if (_poolIndexes[id] < 0) {
    _poolIndexes[id] = _pool.len() as I32;
    _pool.push(bytesOf(id));
  }
  _poolIndexes[id]
};

let _target = fn(block: I32) {
  while (_targeted.len() <= block) { _targeted.push(false); }
  _targeted[block] = true;
  null
};

let _end = fn(terminator: Terminator, next: I32) {
  if (_reachable) {
    _blocks.push(BasicBlock.Block(_block, _instructions, terminator, null));

    match (terminator) {
      Jump(target) => _target(target),
      Branch(_, thenTarget, elseTarget) => {
        _target(thenTarget);
        _target(elseTarget)
      },
      _ => null,
    };
  }
  _instructions = Array.new<Instruction>(0);
  _block = next;
  _reachable = (next >= 0) && (next < _targeted.len()) && _targeted[next];
  null
};

let _bindRegister = fn(binding: I32, register: I32) {
  while (_bindings.len() <= valueOf(binding)) { _bindings.push(-1); }
  _bindings[valueOf(binding)] = register;
  null
};

let _expr: (I32) -> I32 = fn(_id) { -1 };
let _lowerBlock: (I32) -> I32 = fn(_id) { -1 };

let _bind = fn(binding: I32) {
  let value = _expr(childOf(binding, 0));

  match (opOf(binding)) {
    InitGlobal => _emit(Op.GlobalSet, -1, [value], valueOf(binding)),
    Let => {
      let register = _fresh(typeOf(binding));
      _move(register, value);
      _bindRegister(binding, register)
    },
    _ => _bindRegister(binding, value),
  }
};

let _values = fn(id: I32, start: I32): Array<I32> {
  let registers = Array.new<I32>(0);
  let i = start;

  while (i < childCount(id)) {
    registers.push(_expr(childOf(id, i)));
    i++;
  }
  registers
};

let _if = fn(id: I32): I32 {
  let condition = _expr(childOf(id, 0));
  let thenBlock = _nextBlock;
  let elseBlock = thenBlock + 1;
  let joinBlock = thenBlock + 2;
  _nextBlock += 3;
  _end(Terminator.Branch(condition, thenBlock, elseBlock), thenBlock);
  let result = _fresh(typeOf(id));
  _move(result, _expr(childOf(id, 1)));
  _end(Terminator.Jump(joinBlock), elseBlock);
  _move(result, _expr(childOf(id, 2)));
  _end(Terminator.Jump(joinBlock), joinBlock);
  result
};

let _shortCircuit = fn(id: I32): I32 {
  let result = _fresh(typeOf(id));
  _move(result, _expr(childOf(id, 0)));
  let rightBlock = _nextBlock;
  let joinBlock = rightBlock + 1;
  _nextBlock += 2;
  _end(match (opOf(id)) {
    And => Terminator.Branch(result, rightBlock, joinBlock),
    _ => Terminator.Branch(result, joinBlock, rightBlock),
  }, rightBlock);
  _move(result, _expr(childOf(id, 1)));
  _end(Terminator.Jump(joinBlock), joinBlock);
  result
};

let _operation = fn(id: I32): Op {
  match (opOf(id)) {
    Bool => Op.ConstBool, I32 => Op.ConstI32, Bytes => Op.ConstBytes, Null => Op.ConstNull, FunctionRef => Op.ConstFunction,
    Add => Op.Add, Sub => Op.Sub, Mul => Op.Mul, Neg => Op.Neg, Not => Op.Not, Eq => Op.Eq, Lt, Gt => Op.Lt,
    Sext => Op.Sext, Trunc => Op.Trunc, IsNull, IsPresent => Op.IsNull,
    ArrayNew => Op.ArrayNew, ArrayLen => Op.ArrayLen, ArrayGet => Op.ArrayGet,
    BytesLen => Op.BytesLen, BytesGet => Op.BytesGet, BytesSlice => Op.BytesSlice, BytesConcat => Op.BytesConcat, BytesEq => Op.BytesEq,
    Tuple => Op.TupleNew, TupleField => Op.TupleGet, Call => Op.Call, CallIndirect => Op.CallIndirect,
    EnumNew => Op.EnumNew, EnumTag => Op.EnumTag, EnumField => Op.EnumGet,
    _ => {
      throw "invalid HIR expression op";
      Op.Move
    },
  }
};

let _i32 = fn(value: I32): I32 {
  let dst = _fresh(TYPE_I32);
  _emit(Op.ConstI32, dst, Array.new<I32>(0), value);
  dst
};

let _arithmetic = fn(op: Op, left: I32, right: I32): I32 {
  let dst = _fresh(TYPE_I32);
  _emit(op, dst, [left, right], 0);
  dst
};

let _length = fn(array: I32): I32 {
  let dst = _fresh(TYPE_I32);
  _emit(Op.ArrayLen, dst, [array], 0);
  dst
};

let _arrayLiteral = fn(id: I32): I32 {
  let items = _values(id, 0);
  let array = _fresh(typeOf(id));
  _emit(Op.ArrayNew, array, [_i32(items.len() as I32)], 0);
  let i = 0;

  while (i < items.len()) {
    _emit(Op.ArraySet, -1, [array, _i32(i as I32), items[i]], 0);
    i++;
  }
  array
};

let _push = fn(id: I32): I32 {
  let operands = _values(id, 0);
  let array = operands[0];
  let length = _length(array);
  let grown = _arithmetic(Op.Add, length, _i32(1));
  _emit(Op.ArrayResize, -1, [array, grown], 0);
  _emit(Op.ArraySet, -1, [array, length, operands[1]], 0);
  grown
};

let _pop = fn(id: I32): I32 {
  let array = _expr(childOf(id, 0));
  let last = _arithmetic(Op.Sub, _length(array), _i32(1));
  let value = _fresh(typeOf(id));
  _emit(Op.ArrayGet, value, [array, last], 0);
  _emit(Op.ArrayResize, -1, [array, last], 0);
  value
};

_expr = fn(id) {
  match (opOf(id)) {
    Local => _bindings[valueOf(id)],
    Assign => {
      let dst = _bindings[valueOf(id)];
      _move(dst, _expr(childOf(id, 0)));
      dst
    },
    Global => {
      let dst = _fresh(typeOf(id));
      _emit(Op.GlobalGet, dst, Array.new<I32>(0), valueOf(id));
      dst
    },
    SetGlobal => {
      let value = _expr(childOf(id, 0));
      _emit(Op.GlobalSet, -1, [value], valueOf(id));
      value
    },
    ArraySet => {
      let operands = _values(id, 0);
      _emit(Op.ArraySet, -1, operands, 0);
      operands[2]
    },
    ArrayLiteral => _arrayLiteral(id),
    ArrayPush => _push(id),
    ArrayPop => _pop(id),
    ArrayResize => {
      let operands = _values(id, 0);
      _emit(Op.ArrayResize, -1, operands, 0);
      operands[0]
    },
    Present => {
      let value = _expr(childOf(id, 0));
      if (isReference(innerOf(typeOf(id)))) { return value; }
      let dst = _fresh(typeOf(id));
      _emit(Op.Box, dst, [value], 0);
      dst
    },
    ToDynamic => {
      let value = _expr(childOf(id, 0));
      if (_isDynamic(childOf(id, 0))) { return value; }
      let dst = _fresh(typeOf(id));
      _emit(Op.Box, dst, [value], 0);
      dst
    },
    FromDynamic => {
      let value = _expr(childOf(id, 0));
      let dst = _fresh(typeOf(id));
      _emit(Op.Unbox, dst, [value], 0);
      if (isReference(typeOf(id))) { _emit(Op.NullCheck, -1, [dst], 0); }
      dst
    },
    IsKind => {
      let kind = _fresh(TYPE_I32);
      _emit(Op.KindOf, kind, [_expr(childOf(id, 0))], 0);
      let tested = valueOf(id) != 7 ? kind : _arithmetic(Op.Mul, _arithmetic(Op.Sub, kind, _i32(2)), _arithmetic(Op.Sub, kind, _i32(7)));
      let dst = _fresh(TYPE_BOOL);
      _emit(Op.Eq, dst, [tested, _i32(valueOf(id) != 7 ? valueOf(id) : 0)], 0);
      dst
    },
    Unwrap => {
      let value = _expr(childOf(id, 0));

      if (!isReference(typeOf(id))) {
        let dst = _fresh(typeOf(id));
        _emit(Op.Unbox, dst, [value], 0);
        return dst;
      }
      if (valueOf(id) == 1) { _emit(Op.NullCheck, -1, [value], 0); }
      value
    },
    Block => _lowerBlock(id),
    If => _if(id),
    And, Or => _shortCircuit(id),
    _ => {
      let operands = _values(id, 0);
      let op = _operation(id);

      let imm = match (opOf(id)) {
        Bool, I32, FunctionRef, TupleField, Call, EnumNew, EnumField => valueOf(id),
        Bytes => _poolIndex(valueOf(id)),
        _ => 0,
      };

      match (opOf(id)) {
        Gt => {
          operands = [operands[1], operands[0]];
          null
        }, _ => null
      };
      let present = match (opOf(id)) { IsPresent => true, _ => false };
      let dst = _fresh(present ? TYPE_BOOL : typeOf(id));
      _emit(op, dst, operands, imm);

      if (present) {
        let negated = _fresh(TYPE_BOOL);
        _emit(Op.Not, negated, [dst], 0);
        negated
      } else { dst }
    },
  }
};

let _exit = fn(terminator: Terminator) { _end(terminator, -1) };

let _while = fn(id: I32) {
  let conditionBlock = _nextBlock;
  let bodyBlock = conditionBlock + 1;
  let exitBlock = conditionBlock + 2;
  _nextBlock += 3;
  _end(Terminator.Jump(conditionBlock), conditionBlock);
  let condition = _expr(childOf(id, 0));
  _end(Terminator.Branch(condition, bodyBlock, exitBlock), bodyBlock);
  let outerBreak = _breakTarget;
  let outerContinue = _continueTarget;
  _breakTarget = exitBlock;
  _continueTarget = conditionBlock;
  _lowerBlock(childOf(id, 1));
  _breakTarget = outerBreak;
  _continueTarget = outerContinue;
  _end(Terminator.Jump(conditionBlock), exitBlock);
  null
};

let _statement: (I32) -> Bool = fn(_id) { false };

let _ifStatement = fn(id: I32) {
  let condition = _expr(childOf(id, 0));
  let thenBlock = _nextBlock;
  let joinBlock = thenBlock + 1;
  let hasElse = childCount(id) == 3;
  let elseBlock = hasElse ? thenBlock + 2 : joinBlock;
  _nextBlock += hasElse ? 3 : 2;
  _end(Terminator.Branch(condition, thenBlock, elseBlock), thenBlock);
  _lowerBlock(childOf(id, 1));
  _end(Terminator.Jump(joinBlock), elseBlock);

  if (hasElse) {
    let otherwise = childOf(id, 2);

    match (opOf(otherwise)) {
      IfStatement => _statement(otherwise), _ => {
        _lowerBlock(otherwise);
        true
      }
    };
    _end(Terminator.Jump(joinBlock), joinBlock);
  }
  null
};

_statement = fn(id) {
  match (opOf(id)) {
    Declare => {
      let i = 0;

      while (i < childCount(id)) {
        _bind(childOf(id, i));
        i++;
      } null
    },
    Expression => {
      _expr(childOf(id, 0));
      null
    },
    Return => _exit(Terminator.ReturnValue(_expr(childOf(id, 0)))),
    Throw => _exit(Terminator.Throw(_expr(childOf(id, 0)))),
    Break => _exit(Terminator.Jump(_breakTarget)),
    Continue => _exit(Terminator.Jump(_continueTarget)),
    While => _while(id),
    IfStatement => _ifStatement(id),
    Block => {
      _lowerBlock(id);
      null
    },
    _ => {
      throw "invalid HIR statement op";
      null
    },
  };
  true
};

_lowerBlock = fn(id) {
  let statements = childCount(id) - auxOf(id);
  let i = 0;

  while (i < statements) {
    _statement(childOf(id, i));
    i++;
  }
  (_reachable && (auxOf(id) == 1)) ? _expr(lastChild(id)) : -1
};

let _begin = fn() {
  _registers = Array.new<ValueType>(0);
  _instructions = Array.new<Instruction>(0);
  _blocks = Array.new<BasicBlock>(0);
  _block = 0;
  _nextBlock = 1;
  _bindings = Array.new<I32>(0);
  _targeted = [true];
  _reachable = true;
  _breakTarget = -1;
  _continueTarget = -1;
  null
};

let _function = fn(id: I32, functionId: I32): IrFunction {
  _begin();
  let params = Array.new<I32>(0);
  let i = 0;

  while (i < childCount(id) - 1) {
    let param = childOf(id, i);
    let register = _fresh(typeOf(param));
    params.push(register);
    _bindRegister(param, register);
    i++;
  }
  let result = _lowerBlock(lastChild(id));
  _end(Terminator.ReturnValue(result), -1);
  IrFunction.Function(functionId, params, _registers, ReturnType.Value(_valueType(innerOf(typeOf(id)))), _blocks, 0)
};

export let lowerProgram: (Hir) -> IrProgram = fn(program) {
  useHir(program);
  _pool = Array.new<Bytes>(0);
  _poolIndexes = Array.new<I32>(0);
  _enumIndexes = Array.new<I32>(0);
  let enumTypes = Array.new<I32>(0);
  let ty = 0;

  while (ty < typeCount()) {
    _enumIndexes.push(match (kindOf(ty)) {
      Enum => {
        enumTypes.push(ty);
        (enumTypes.len() - 1) as I32
      }, _ => -1
    });
    ty++;
  }
  let enums = Array.new<EnumSchema>(0);
  let e = 0;

  while (e < enumTypes.len()) {
    let variants = Array.new<Array<ValueType>>(0);
    let tag = 0;

    while (tag < variantCount(enumTypes[e])) {
      let fields = Array.new<ValueType>(0);
      let f = 0;

      while (f < fieldCount(enumTypes[e], tag)) {
        fields.push(_valueType(fieldType(enumTypes[e], tag, f)));
        f++;
      }
      variants.push(fields);
      tag++;
    }
    enums.push(EnumSchema.Enum(variants));
    e++;
  }
  let root = rootNode();
  let functions = Array.new<IrFunction>(0);
  let i = 0;

  while (i < childCount(root) - 1) {
    functions.push(_function(childOf(root, i), i + 1));
    i++;
  }
  _begin();
  let body = lastChild(root);
  let result = _lowerBlock(body);
  _end(Terminator.ReturnValue(result), -1);
  functions.push(IrFunction.Function(0, [], _registers, ReturnType.Value(_valueType(typeOf(body))), _blocks, 0));
  let globals = Array.new<ValueType>(0);
  i = 0;

  while (i < globalCount()) {
    globals.push(_valueType(globalTypeOf(i)));
    i++;
  }
  let lowered = IrProgram.Program(functions, _pool, enums, globals);
  verifyProgram(lowered);
  lowered
};
