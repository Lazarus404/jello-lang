package ir;

export enum ValueType {
  Bool;
  I32;
  I64;
  Bytes;
  Dynamic;
  ArrayOf(element: ValueType);
  ListOf(element: ValueType);
  TupleOf(elements: Array<ValueType>);
  Nominal(id: I32);
  Function(args: Array<ValueType>, result: ReturnType);
}

export enum ReturnType {
  Void;
  Value(ty: ValueType);
}

export enum Op {
  ConstBool; ConstI32; ConstI64; ConstBytes; ConstNull; ConstFunction; Move;
  Add; Sub; Mul; Div; Rem; Shl; Shr; BitAnd; BitOr; BitXor; Neg; Not; Eq; Lt; Sext; Trunc; Box; Unbox; KindOf; IsEnum; IsNull; NullCheck;
  ArrayNew; ArrayLen; ArrayGet; ArraySet; ArrayResize; ListNil; ListCons; ListHead; ListTail; ListIsNil; BytesNew; BytesSet; BytesBlit; BytesLen; BytesGet; BytesSlice; BytesConcat; BytesEq;
  TupleNew; TupleGet; EnumNew; EnumTag; EnumGet;
  Call; CallIndirect; CallNative; GlobalGet; GlobalSet;
  StructNew; StructSet; AddImm; SubImm; MulImm; EqImm; LtImm; SpillPush; SpillPop;
}

export enum Instruction {
  Instruction(op: Op, dst: I32, args: Array<I32>, imm: I32, node: I32);
}

export let instructionAt: (Op, I32, Array<I32>, I32, I32) -> Instruction = fn(op, dst, args, imm, node) {
  Instruction.Instruction(op, dst, args, imm, node)
};

export let instruction: (Op, I32, Array<I32>, I32) -> Instruction = fn(op, dst, args, imm) {
  Instruction.Instruction(op, dst, args, imm, -1)
};

export let opOf: (Instruction) -> Op = fn(instruction) { match (instruction) { Instruction(op, _, _, _, _) => op } };
export let dstOf: (Instruction) -> I32 = fn(instruction) { match (instruction) { Instruction(_, dst, _, _, _) => dst } };
export let argsOf: (Instruction) -> Array<I32> = fn(instruction) { match (instruction) { Instruction(_, _, args, _, _) => args } };
export let immOf: (Instruction) -> I32 = fn(instruction) { match (instruction) { Instruction(_, _, _, imm, _) => imm } };
export let nodeOf: (Instruction) -> I32 = fn(instruction) { match (instruction) { Instruction(_, _, _, _, node) => node } };

export enum Effect {
  MayReadMemory;
  MayWriteMemory;
  MayAllocate;
  MayCall;
  MayThrow;
  MayTrap;
}

export enum Terminator {
  Jump(target: I32);
  Branch(condition: I32, thenTarget: I32, elseTarget: I32);
  ReturnVoid;
  ReturnValue(value: I32);
  Throw(value: I32, node: I32);
  Unreachable;
}

export enum ThrowHandler {
  Catch(target: I32, payload: I32);
}

export let handlerTarget: (ThrowHandler) -> I32 = fn(handler) { match (handler) { Catch(target, _) => target } };
export let handlerPayload: (ThrowHandler) -> I32 = fn(handler) { match (handler) { Catch(_, payload) => payload } };

export enum BasicBlock {
  Block(
    id: I32,
    instructions: Array<Instruction>,
    terminator: Terminator,
    handler: ?ThrowHandler
  );
}

export enum Function {
  Function(
    id: I32,
    params: Array<I32>,
    captures: I32,
    registers: Array<ValueType>,
    result: ReturnType,
    blocks: Array<BasicBlock>,
    entry: I32
  );
}

export enum EnumSchema { Enum(variants: Array<Array<ValueType>>); }

export enum Native { Native(library: Bytes, name: Bytes, params: Array<ValueType>, result: ValueType); }

export enum Program {
  Program(
    functions: Array<Function>, bytes: Array<Bytes>, wides: Array<I64>, enums: Array<EnumSchema>, globals: Array<ValueType>,
    natives: Array<Native>
  );
}

export let argumentCount: (Function) -> I32 = fn(function) {
  match (function) { Function(_, params, captures, _, _, _, _) => (params.len() as I32) - captures }
};

export let opEffects: (Op) -> Array<Effect> = fn(op) {
  match (op) {
    Box, ConstFunction, ArrayNew, ListCons, EnumNew, StructNew => [Effect.MayAllocate],
    BytesNew => [Effect.MayAllocate, Effect.MayTrap],
    BytesSet => [Effect.MayWriteMemory, Effect.MayTrap],
    BytesBlit => [Effect.MayReadMemory, Effect.MayWriteMemory, Effect.MayTrap],
    BytesSlice, BytesConcat => [Effect.MayAllocate, Effect.MayReadMemory, Effect.MayTrap],
    ArrayResize => [Effect.MayAllocate, Effect.MayWriteMemory, Effect.MayTrap],
    BytesLen, BytesEq => [Effect.MayReadMemory, Effect.MayTrap],
    Call, CallIndirect => [Effect.MayCall, Effect.MayThrow],
    CallNative => [Effect.MayCall, Effect.MayAllocate, Effect.MayTrap],
    BytesGet, ArrayLen, ArrayGet, ListHead, ListTail, TupleGet, EnumGet => [Effect.MayReadMemory, Effect.MayTrap],
    GlobalGet => [Effect.MayReadMemory],
    Unbox, NullCheck => [Effect.MayTrap],
    GlobalSet => [Effect.MayWriteMemory],
    ArraySet, StructSet => [Effect.MayWriteMemory, Effect.MayTrap],
    TupleNew => [Effect.MayAllocate, Effect.MayWriteMemory],
    _ => [],
  }
};

export let instructionMayThrow: (Instruction) -> Bool = fn(instruction) {
  match (opOf(instruction)) { Call, CallIndirect => true, _ => false }
};

let _equal: (ValueType, ValueType) -> Bool = fn(_left, _right) { false };

export let valueTypesEqual: (Array<ValueType>, Array<ValueType>) -> Bool = fn(left, right) {
  if (left.len() != right.len()) { return false; }
  let i = 0;

  while (i < left.len()) {
    if (!_equal(left[i], right[i])) { return false; }
    i++;
  }
  true
};

export let returnTypeEqual: (ReturnType, ReturnType) -> Bool = fn(left, right) {
  match ((left, right)) { (Void, Void) => true, (Value(a), Value(b)) => _equal(a, b), _ => false }
};

_equal = fn(left, right) {
  match ((left, right)) {
    (Bool, Bool), (I32, I32), (I64, I64), (Bytes, Bytes), (Dynamic, Dynamic) => true,
    (Nominal(a), Nominal(b)) => a == b,
    (ArrayOf(a), ArrayOf(b)), (ListOf(a), ListOf(b)) => _equal(a, b),
    (TupleOf(a), TupleOf(b)) => valueTypesEqual(a, b),
    (Function(leftArgs, leftResult), Function(rightArgs, rightResult)) =>
      valueTypesEqual(leftArgs, rightArgs) && returnTypeEqual(leftResult, rightResult),
    _ => false,
  }
};

export let valueTypeEqual: (ValueType, ValueType) -> Bool = fn(left, right) { _equal(left, right) };

export let canBeNull: (ValueType) -> Bool = fn(ty) { match (ty) { Bool, I32, I64, ListOf(_) => false, _ => true } };
