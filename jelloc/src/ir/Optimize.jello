package ir;

/** @file
 * Optimisation of lowered IR, before legalisation. A global that only the program body reads or
 * writes becomes a register of the body, as a top-level `local` is in Lua; the body's own loops
 * then run on registers instead of module state. A direct call of a small function that makes
 * no calls and cannot throw becomes a copy of its body, which saves the call frame, and every
 * function but the body is then cleaned up (`ir.Cleanup`).
 *
 * Before that, a call passing a function without captures to a small function that only ever
 * calls that parameter calls a copy that calls the function directly instead; so
 * `xs.map(fn(x) { x * 2 })` loops over a multiplication rather than an indirect call, once the
 * inliner has been. */

import type { BasicBlock, Function, Instruction, Program, ThrowHandler, ValueType } from ir.Model;
import { Op, Terminator, argumentCount, instructionAt, nextFunctionId } from ir.Model;
import { blockIndexes, blockMayThrow, terminatorRead } from ir.Cfg;
import { cleanupFunction } from ir.Cleanup;

// Marks in `marked` each global that a `GlobalGet` or `GlobalSet` of `function` addresses.
let _markGlobals = fn(function: Function, marked: Array<Bool>) {
  for (block in function.blocks) {
    for (insn in block.instructions) {
      match (insn.op) {
        GlobalGet, GlobalSet => { marked[insn.imm] = true; },
        _ => {},
      }
    }
  }
  null
};

/** Rewrites `insn` of the body: a `GlobalGet` or `GlobalSet` of a global with a register in
 * `promoted` becomes a `Move` from or to that register. */
let _promote = fn(insn: Instruction, promoted: Array<I32>): Instruction {
  match (insn.op) {
    GlobalGet when (promoted[insn.imm] >= 0) =>
      instructionAt(Op.Move, insn.dst, [promoted[insn.imm]], 0, insn.node),
    GlobalSet when (promoted[insn.imm] >= 0) =>
      instructionAt(Op.Move, promoted[insn.imm], insn.args, 0, insn.node),
    _ => insn,
  }
};

/** The program body, function ID 0, with each global it addresses that no other function does
 * in a register of its own instead, or null when there is no such global.
 * @param body  the body
 * @param globals  the program's global types
 * @param elsewhere  whether a function other than the body addresses each global */
let _promoteBody = fn(
  body: Function, globals: Array<ValueType>, elsewhere: Array<Bool>
): ?Function {
  let used = Array.new<Bool>(globals.len());
  _markGlobals(body, used);

  let types = body.registers.copy();
  let promoted = Array.new<I32>(0);

  for (g, ty in globals) {
    if (used[g] && !elsewhere[g]) {
      promoted.push(types.len());
      types.push(ty);
    } else {
      promoted.push(-1);
    }
  }
  if (types.len() == body.registers.len()) { return null; }

  let out = Array.new<BasicBlock>(0);

  for (block in body.blocks) {
    let rewritten = Array.new<Instruction>(0);

    for (insn in block.instructions) {
      rewritten.push(_promote(insn, promoted));
    }
    out.push({ ...block, instructions: rewritten });
  }

  { ...body, registers: types, blocks: out }
};

// The most instructions a function may have for its direct calls to be inlined.
const _INLINE_LIMIT = 16;

/** Checks whether `function` may be copied, into its callers or for them; a function other than
 * the program body, without captures, of at most `limit` instructions. */
let _copyable = fn(function: Function, limit: I32): Bool {
  if ((function.id == 0) || (function.captures != 0)) { return false; }

  let size = 0;

  for (block in function.blocks) {
    size = size + block.instructions.len();
    if (size > limit) { return false; }
  }
  true
};

/** Checks whether direct calls of `function` may be replaced by its body; a copyable function of
 * at most `_INLINE_LIMIT` instructions that makes no calls, cannot throw and has no try regions.
 * Traps in it then locate as they did. */
let _inlinable = fn(function: Function): Bool {
  if (!_copyable(function, _INLINE_LIMIT)) { return false; }

  for (block in function.blocks) {
    if ((block.handler != null) || blockMayThrow(block.instructions, block.terminator)) {
      return false;
    }

    for (insn in block.instructions) {
      if (insn.op == Op.CallNative) { return false; }
    }
  }
  true
};

/** Returns the inlinable function a direct call `insn` calls, or null.
 * @param leaves  each inlinable function by ID, or null */
let _leafCalled = fn(insn: Instruction, leaves: Array<?Function>): ?Function {
  (insn.op == Op.Call) ? leaves[insn.imm] : null
};

// Returns `insn` with each register renumbered by `offset`.
let _shifted = fn(insn: Instruction, offset: I32): Instruction {
  let shifted = Array.new<I32>(0);

  for (arg in insn.args) {
    shifted.push(arg + offset);
  }
  let dst = (insn.dst >= 0) ? insn.dst + offset : insn.dst;
  instructionAt(insn.op, dst, shifted, insn.imm, insn.node)
};

/** Appends to `blocks` a copy of `callee` for the call `call`, whose block continues in block
 * `next`; its registers are appended to `types`, its blocks take IDs from `base` up, and each
 * return moves its value to the call's destination and jumps to `next`.
 * @param handler  the try region of the calling block, which the copy joins
 * @return the first block ID after the copy's */
let _copy = fn(
  callee: Function,
  call: Instruction,
  base: I32,
  next: I32,
  handler: ?ThrowHandler,
  blocks: Array<BasicBlock>,
  types: Array<ValueType>
): I32 {
  let offset = types.len();
  types.appendFrom(callee.registers, 0);

  for (block in callee.blocks) {
    let out = Array.new<Instruction>(0);

    if (block.id == callee.entry) {
      // The arguments arrive in the callee's parameters, as a call would put them.
      for (j, param in callee.params) {
        out.push(instructionAt(Op.Move, param + offset, [call.args[j]], 0, call.node));
      }
    }

    for (insn in block.instructions) {
      out.push(_shifted(insn, offset));
    }

    let last = match (block.terminator) {
      Jump(target) => Terminator.Jump(target + base),
      Branch(condition, thenTarget, elseTarget) =>
        Terminator.Branch(condition + offset, thenTarget + base, elseTarget + base),
      ReturnValue(value) => {
        if (call.dst >= 0) {
          out.push(instructionAt(Op.Move, call.dst, [value + offset], 0, call.node));
        }
        Terminator.Jump(next)
      },
      _ => block.terminator,
    };
    blocks.push({ id: block.id + base, instructions: out, terminator: last, handler });
  }

  base + blockIndexes(callee.blocks).len()
};

// Checks whether any of `blocks` makes a direct call of an inlinable function in `leaves`.
let _callsLeaf = fn(blocks: Array<BasicBlock>, leaves: Array<?Function>): Bool {
  for (block in blocks) {
    for (insn in block.instructions) {
      if (_leafCalled(insn, leaves) != null) { return true; }
    }
  }
  false
};

/** Replaces each direct call of an inlinable function in `function` by a copy of its body, or
 * returns null when there is none. A block is split at each such call; the copy follows the head,
 * and the rest of the block follows the copy.
 * @param leaves  each inlinable function by ID, or null */
let _inlineInto = fn(function: Function, leaves: Array<?Function>): ?Function {
  let blocks = function.blocks;
  if (!_callsLeaf(blocks, leaves)) { return null; }

  let out = Array.new<BasicBlock>(0);
  let types = function.registers.copy();
  let next = blockIndexes(blocks).len();

  for (block in blocks) {
    let handler = block.handler;
    let current = block.id;
    let code = Array.new<Instruction>(0);

    for (insn in block.instructions) {
      let leaf = _leafCalled(insn, leaves);

      if (leaf == null) {
        code.push(insn);
      } else {
        // The head jumps into the copy, whose returns land in block `rest`.
        let rest = next;
        let entry = Terminator.Jump(rest + 1 + leaf.entry);
        out.push({ id: current, instructions: code, terminator: entry, handler });
        next = _copy(leaf, insn, rest + 1, rest, handler, out, types);
        current = rest;
        code = Array.new<Instruction>(0);
      }
    }
    out.push({ id: current, instructions: code, terminator: block.terminator, handler });
  }

  { ...function, registers: types, blocks: out }
};

/** Inlines direct calls of small leaf functions into every function but the program body,
 * whose registers are already the most, or returns null when there is no such call. */
let _inlineAll = fn(functions: Array<Function>): ?Array<Function> {
  let leaves = Array.new<?Function>(0);

  for (function in functions) {
    while (leaves.len() <= function.id) { leaves.push(null); }
    if (_inlinable(function)) { leaves[function.id] = function; }
  }

  let out = Array.new<Function>(0);
  let changed = false;

  for (function in functions) {
    let inlined = (function.id != 0) ? _inlineInto(function, leaves) : null;

    if (inlined == null) {
      out.push(function);
    } else {
      out.push(inlined);
      changed = true;
    }
  }
  changed ? out : null
};

// The most instructions a function may have to be copied for a function it is passed.
const _SPECIALISE_LIMIT = 64;

/** Returns the argument positions of `function`'s parameters that it only calls; never writes,
 * passes on, keeps, compares or returns. Empty when there are none or it cannot be copied. */
let _calledParams = fn(function: Function): Array<I32> {
  let positions = Array.new<I32>(0);

  if ((argumentCount(function) == 0) || !_copyable(function, _SPECIALISE_LIMIT)) {
    return positions;
  }

  // Each register's reads: 0 none yet, 1 only as a callee, -1 any other.
  let uses = Array.new<I32>(function.registers.len());

  for (block in function.blocks) {
    for (insn in block.instructions) {
      for (a, arg in insn.args) {
        let called = (a == 0) && (insn.op == Op.CallIndirect);
        uses[arg] = (called && (uses[arg] >= 0)) ? 1 : -1;
      }
      if (insn.dst >= 0) { uses[insn.dst] = -1; }
    }
    let read = terminatorRead(block.terminator);
    if (read >= 0) { uses[read] = -1; }
  }

  let p = 0;

  while (p < argumentCount(function)) {
    if (uses[function.params[p]] == 1) { positions.push(p); }
    p++;
  }
  positions
};

/** Returns, for each register of `function`, one more than the ID of the function without
 * captures that is its only value; 0 when it is never written, -3 - r when its only write copies
 * register r, as a local passed on is, and -1 when it has another value, as a parameter or a
 * register written otherwise or more than once has. `_knownAt` follows the copies. */
let _knownFunctions = fn(function: Function): Array<I32> {
  let known = Array.new<I32>(function.registers.len());

  for (param in function.params) {
    known[param] = -1;
  }

  for (block in function.blocks) {
    for (insn in block.instructions) {
      if (insn.dst >= 0) {
        let value = -1;

        if (known[insn.dst] == 0) {
          if ((insn.op == Op.ConstFunction) && (insn.args.len() == 0)) {
            value = insn.imm + 1;
          } else if (insn.op == Op.Move) {
            value = -3 - insn.args[0];
          }
        }
        known[insn.dst] = value;
      }
    }
  }
  known
};

/** Returns the ID of the function register `r` holds wherever it is read, in whichever block,
 * following its copies, or a negative number when it holds no one function. A cycle of copies
 * holds nothing, and is cut off after as many steps as there are registers. */
let _knownAt = fn(known: Array<I32>, r: I32): I32 {
  let value = known[r];
  let steps = 0;

  while ((value <= -3) && (steps < known.len())) {
    value = known[-3 - value];
    steps++;
  }
  (value > 0) ? value - 1 : -1
};

/** Returns `function` as a copy numbered `id` that calls function `target` directly wherever it
 * called its parameter `param`. */
let _calling = fn(function: Function, param: I32, target: I32, id: I32): Function {
  let blocks = Array.new<BasicBlock>(0);

  for (block in function.blocks) {
    let code = Array.new<Instruction>(0);

    for (insn in block.instructions) {
      if ((insn.op == Op.CallIndirect) && (insn.args[0] == param)) {
        let args = Array.new<I32>(0);
        args.appendFrom(insn.args, 1);
        code.push(instructionAt(Op.Call, insn.dst, args, target, insn.node));
      } else {
        code.push(insn);
      }
    }
    blocks.push({ ...block, instructions: code });
  }
  { ...function, id, blocks }
};

/** A copy of function `source` that calls function `target` directly for the parameter at
 * `position`. */
typedef Copy = {
  let source: I32;
  let position: I32;
  let target: I32;
};

/** What `_specialiseAll` knows of the program: its functions by ID, the positions `_calledParams`
 * finds for each (worked out when first wanted), and the copies made, numbered from `base` up in
 * the order of `copies`, with what each is in `copied`. */
typedef Specialising = {
  let byId: Array<?Function>;
  let called: Array<?Array<I32>>;
  let copies: Array<Function>;
  let copied: Array<Copy>;
  let base: I32;
};

// No positions, for the many calls of functions that have none.
let _NO_POSITIONS = Array.new<I32>(0);

// Returns `_calledParams` of `function`, worked out once.
let _positions = fn(s: Specialising, function: Function): Array<I32> {
  let known = s.called[function.id];
  if (known != null) { return known; }
  let positions = _calledParams(function);
  s.called[function.id] = positions;
  positions
};

/** Returns the ID of the copy of `function` calling `target` for the parameter at `position`,
 * making it when there is none yet. */
let _copyFor = fn(s: Specialising, function: Function, position: I32, target: I32): I32 {
  for (i, copy in s.copied) {
    if ((copy.source == function.id) && (copy.position == position) && (copy.target == target)) {
      return s.base + i;
    }
  }
  let id = s.base + s.copies.len();
  s.copies.push(_calling(function, function.params[position], target, id));
  s.copied.push({ source: function.id, position, target });
  id
};

/** Returns `function` with each direct call that passes a function without captures for a
 * parameter the callee only calls calling a copy of the callee that calls it directly, or null
 * when there is no such call. One such parameter per call is copied for; a callee rarely takes
 * two. Most functions pass none, so a block is copied only once a call in it changes. */
let _specialised = fn(s: Specialising, function: Function): ?Function {
  // Worked out once a call might pass a known function.
  let known = Array.new<I32>(0);
  let blocks: ?Array<BasicBlock> = null;

  for (i, block in function.blocks) {
    let instructions = block.instructions;
    let code: ?Array<Instruction> = null;

    for (j, insn in instructions) {
      let callee = (insn.op == Op.Call) ? s.byId[insn.imm] : null;
      let positions = (callee != null) ? _positions(s, callee) : _NO_POSITIONS;
      if ((positions.len() > 0) && (known.len() == 0)) { known = _knownFunctions(function); }
      let p = 0;

      while ((callee != null) && (p < positions.len())) {
        let target = _knownAt(known, insn.args[positions[p]]);

        if (target >= 0) {
          let out = code ?? instructions.copy();
          let copy = _copyFor(s, callee, positions[p], target);
          out[j] = instructionAt(Op.Call, insn.dst, insn.args, copy, insn.node);
          code = out;
          break;
        }
        p++;
      }
    }

    if (code != null) {
      let out = blocks ?? function.blocks.copy();
      out[i] = { ...block, instructions: code };
      blocks = out;
    }
  }
  (blocks != null) ? { ...function, blocks } : null
};

/** Returns `functions` with each call passing a function without captures for a parameter the
 * callee only calls calling a copy of the callee that calls it directly, the copies listed
 * before the program body, which stays last; or null when there is no such call. */
let _specialiseAll = fn(functions: Array<Function>): ?Array<Function> {
  let base = nextFunctionId(functions);
  let s: Specialising = {
    byId: Array.new<?Function>(base),
    called: Array.new<?Array<I32>>(base),
    copies: Array.new<Function>(0),
    copied: Array.new<Copy>(0),
    base,
  };

  for (function in functions) {
    s.byId[function.id] = function;
  }

  let out = Array.new<Function>(0);

  for (function in functions) {
    out.push(_specialised(s, function) ?? function);
  }
  if (s.copies.len() == 0) { return null; }
  let body = out.pop();
  out.appendFrom(s.copies, 0);
  out.push(body);
  out
};

/** Optimises a lowered program. `Driver` passes the result to `Legalize.legalizeJlo`; when the
 * body then needs too many registers, `Lower.relowerBodyInParts` lowers it again from the HIR,
 * with its globals, and keeps the other functions, which never address a promoted global.
 * Inlining may leave another function needing too many, so `Driver` then optimises again
 * without rewriting.
 * @param program  a program from `Lower.lowerProgram`, whose body, function ID 0, is last
 * @param rewrite  whether to copy small functions for the functions they are passed, inline
 *   direct calls of small leaf functions, then clean up every function but the body, which runs
 *   once (`Cleanup.cleanupFunction`)
 * @return the optimised program, or `program` when nothing changes; the input is not modified */
export let optimizeProgram = fn(program: Program, rewrite: Bool): Program {
  let functions = program.functions;
  let elsewhere = Array.new<Bool>(program.globals.len());
  let i = 0;

  while (i < functions.len() - 1) {
    _markGlobals(functions[i], elsewhere);
    i++;
  }
  let body = _promoteBody(functions[functions.len() - 1], program.globals, elsewhere);
  if ((body == null) && !rewrite) { return program; }

  let promoted = functions.copy();
  if (body != null) { promoted[promoted.len() - 1] = body; }
  if (!rewrite) { return { ...program, functions: promoted }; }

  // Each is a fresh array, so the clean-up may write it.
  let specialised = _specialiseAll(promoted) ?? promoted;
  let out = _inlineAll(specialised) ?? specialised;
  i = 0;

  while (i < out.len() - 1) {
    out[i] = cleanupFunction(out[i]);
    i++;
  }
  { ...program, functions: out }
};
