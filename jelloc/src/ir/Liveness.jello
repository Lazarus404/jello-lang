package ir;

import type { BasicBlock, Instruction } from ir.Model;
import { instructionMayThrow } from ir.Model;
import { blockCatch, blockIndexes, normalSuccessors, terminatorRead } from ir.Cfg;

let _registers = 0;

let _reads = fn(insn: Instruction): Array<I32> {
  match (insn.op) { SpillPop => [_registers + insn.imm], _ => insn.args }
};

let _writes = fn(insn: Instruction): Array<I32> {
  match (insn.op) {
    SpillPush => [_registers + insn.imm],
    _ => (insn.dst >= 0) ? [insn.dst] : Array.new<I32>(0),
  }
};

let _add = fn(set: Array<I32>, marks: Array<I32>, stamp: I32, value: I32) {
  if (marks[value] != stamp) {
    marks[value] = stamp;
    set.push(value);
  }
  null
};

let _mark = fn(values: Array<I32>, marks: Array<I32>, stamp: I32) {
  let i = 0;

  while (i < values.len()) {
    marks[values[i]] = stamp;
    i++;
  }
  null
};

export let liveness = fn(
  blocks: Array<BasicBlock>,
  registers: I32,
  slots: I32,
  fromStart: Bool
): Tuple<Array<Array<I32>>, Array<Array<I32>>> {
  _registers = registers;
  let count = registers + slots;
  let indexes = blockIndexes(blocks);

  let marks = Array.new<I32>(count);
  let written = Array.new<I32>(count);
  let early = Array.new<I32>(count);
  let i = 0;

  while (i < count) {
    marks[i] = -1;
    written[i] = -1;
    early[i] = -1;
    i++;
  }
  let stamp = 0;

  let uses = Array.new<Array<I32>>(0);
  let defs = Array.new<Array<I32>>(0);
  let kills = Array.new<Array<I32>>(0);
  let successors = Array.new<Array<I32>>(0);
  let catches = Array.new<I32>(0);
  let payloads = Array.new<I32>(0);
  let liveIn = Array.new<Array<I32>>(0);
  let liveOut = Array.new<Array<I32>>(0);
  i = 0;

  while (i < blocks.len()) {
    let instructions = blocks[i].instructions;
    let terminator = blocks[i].terminator;
    stamp++;

    let used = Array.new<I32>(0);
    let defined = Array.new<I32>(0);
    let killed = Array.new<I32>(0);
    let throwing = false;
    let j = 0;

    while (j < instructions.len()) {
      if (!fromStart && instructionMayThrow(instructions[j])) { throwing = true; }

      let reads = _reads(instructions[j]);
      let a = 0;

      while (a < reads.len()) {
        if (written[reads[a]] != stamp) { _add(used, marks, stamp, reads[a]); }
        a++;
      }

      let writes = _writes(instructions[j]);
      a = 0;

      while (a < writes.len()) {
        _add(defined, written, stamp, writes[a]);
        if (!fromStart && !throwing) { killed.push(writes[a]); }
        a++;
      }
      j++;
    }

    let last = terminatorRead(terminator);
    if ((last >= 0) && (written[last] != stamp)) { _add(used, marks, stamp, last); }
    let targets = normalSuccessors(terminator);
    let next = Array.new<I32>(0);
    let a = 0;

    while (a < targets.len()) {
      next.push(indexes[targets[a]]);
      a++;
    }
    let (catchBlock, payload) = blockCatch(blocks[i], indexes);

    uses.push(used);
    defs.push(defined);
    kills.push(killed);
    successors.push(next);
    catches.push(catchBlock);
    payloads.push(payload);
    liveIn.push(Array.new<I32>(0));
    liveOut.push(Array.new<I32>(0));
    i++;
  }

  let changed = true;

  while (changed) {
    changed = false;
    i = blocks.len() - 1;

    while (i >= 0) {
      stamp++;
      let out = Array.new<I32>(0);
      let catchBlock = catches[i];
      let s = 0;
      let m = 0;

      while (s < successors[i].len()) {
        let into = liveIn[successors[i][s]];
        m = 0;

        while (m < into.len()) {
          _add(out, marks, stamp, into[m]);
          m++;
        }
        s++;
      }
      let caught = (catchBlock >= 0) ? liveIn[catchBlock] : Array.new<I32>(0);
      m = 0;

      while (m < caught.len()) {
        if (caught[m] != payloads[i]) { _add(out, marks, stamp, caught[m]); }
        m++;
      }
      liveOut[i] = out;

      stamp++;
      let live = Array.new<I32>(0);
      _mark(defs[i], written, stamp);
      _mark(kills[i], early, stamp);
      m = 0;

      while (m < uses[i].len()) {
        _add(live, marks, stamp, uses[i][m]);
        m++;
      }
      m = 0;

      while (m < out.len()) {
        if (written[out[m]] != stamp) { _add(live, marks, stamp, out[m]); }
        m++;
      }
      m = 0;

      while (m < caught.len()) {
        if ((caught[m] != payloads[i]) && (early[caught[m]] != stamp)) {
          _add(live, marks, stamp, caught[m]);
        }
        m++;
      }

      if (live.len() > liveIn[i].len()) {
        liveIn[i] = live;
        changed = true;
      }
      i--;
    }
  }

  (liveIn, liveOut)
};
