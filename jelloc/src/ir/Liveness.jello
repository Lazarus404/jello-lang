package ir;

/** @file
 * Liveness of an IR function's registers; the registers it reads, on some path from each
 * block's start, before writing them. Sets are lists of members, so the work follows what is
 * live, not how many registers the function has. Past the function's registers come its spill
 * slots; a `SpillPush` writes one and a `SpillPop` reads it. The register allocator
 * (`backend.jello.Allocate`) builds interference from it, and `ir.Verify` checks with it that
 * every register and spill slot is written before it is read. */

import type { BasicBlock, Instruction } from ir.Model;
import { instructionMayThrow } from ir.Model;
import { blockCatch, blockIndexes, normalSuccessors, terminatorRead } from ir.Cfg;

/** The register count of the function being analysed; spill slot `n` is liveness member
 * `_registers + n`. */
let _registers = 0;

// Returns the members `insn` reads; its argument registers, or for a `SpillPop` its slot.
let _reads = fn(insn: Instruction): Array<I32> {
  match (insn.op) { SpillPop => [_registers + insn.imm], _ => insn.args }
};

/** Returns the members `insn` writes; its destination if it has one, or for a `SpillPush` its
 * slot. */
let _writes = fn(insn: Instruction): Array<I32> {
  match (insn.op) {
    SpillPush => [_registers + insn.imm],
    _ => (insn.dst >= 0) ? [insn.dst] : Array.new<I32>(0),
  }
};

/** Adds `value` to `set` and marks it with `stamp`, unless it is already marked. Stamping instead
 * of clearing makes starting a new set O(1).
 * @param set  the set's members
 * @param marks  a mark per member
 * @param stamp  the current set's stamp
 * @param value  the member to add */
let _add = fn(set: Array<I32>, marks: Array<I32>, stamp: I32, value: I32) {
  if (marks[value] != stamp) {
    marks[value] = stamp;
    set.push(value);
  }
  null
};

// Marks every member of `values` with `stamp` in `marks`, which holds a mark per member.
let _mark = fn(values: Array<I32>, marks: Array<I32>, stamp: I32) {
  for (value in values) {
    marks[value] = stamp;
  }
  null
};

/** Computes the live-in and live-out sets of each block by backward dataflow to a fixed point.
 * A block that may throw into a catch block flows into it too; what the catch reads, less the
 * payload the VM writes as it enters it, is live out of the block. Into the block it is live
 * from the first instruction that may throw, since a value written before that is the one a
 * throw carries. With `fromStart` it is live from the block's start instead, so no register
 * the catch reads is reused anywhere in the block, whichever call throws; the allocator asks
 * for this and the verifier does not.
 * @param blocks  the function's blocks
 * @param registers  the function's register count
 * @param slots  the number of spill slots, members `registers` onwards
 * @param fromStart  whether what a catch reads is live into a throwing block from its start
 * @return the live-in and live-out member lists, by block index in `blocks` */
export let liveness = fn(
  blocks: Array<BasicBlock>,
  registers: I32,
  slots: I32,
  fromStart: Bool
): Tuple<Array<Array<I32>>, Array<Array<I32>>> {
  _registers = registers;
  let count = registers + slots;
  let indexes = blockIndexes(blocks);

  /* A member is in the set being built, written by the block, or written before its first
   * throw while its mark in `marks`, `written` or `early` holds the current stamp. */
  let marks = Array.new<I32>(count);
  let written = Array.new<I32>(count);
  let early = Array.new<I32>(count);
  let i = 0;

  while (i < count) {
    marks[i] = -1;
    written[i] = -1;
    early[i] = -1;
    i++;
  }
  let stamp = 0;

  /* Per block; what it reads before writing, what it writes, what it writes before it may
   * first throw, its successors, and its catch block and payload. */
  let uses = Array.new<Array<I32>>(0);
  let defs = Array.new<Array<I32>>(0);
  let kills = Array.new<Array<I32>>(0);
  let successors = Array.new<Array<I32>>(0);
  let catches = Array.new<I32>(0);
  let payloads = Array.new<I32>(0);
  let liveIn = Array.new<Array<I32>>(0);
  let liveOut = Array.new<Array<I32>>(0);

  for (block in blocks) {
    let terminator = block.terminator;
    stamp++;

    let used = Array.new<I32>(0);
    let defined = Array.new<I32>(0);
    let killed = Array.new<I32>(0);
    let throwing = false;

    for (insn in block.instructions) {
      if (!fromStart && instructionMayThrow(insn)) { throwing = true; }

      for (register in _reads(insn)) {
        if (written[register] != stamp) { _add(used, marks, stamp, register); }
      }

      for (register in _writes(insn)) {
        _add(defined, written, stamp, register);
        if (!fromStart && !throwing) { killed.push(register); }
      }
    }

    let last = terminatorRead(terminator);
    if ((last >= 0) && (written[last] != stamp)) { _add(used, marks, stamp, last); }
    let next = Array.new<I32>(0);

    for (target in normalSuccessors(terminator)) {
      next.push(indexes[target]);
    }
    let (catchBlock, payload) = blockCatch(block, indexes);

    uses.push(used);
    defs.push(defined);
    kills.push(killed);
    successors.push(next);
    catches.push(catchBlock);
    payloads.push(payload);
    liveIn.push(Array.new<I32>(0));
    liveOut.push(Array.new<I32>(0));
  }

  // The sets only grow, so a block's live-in changed exactly when it has more members.
  let changed = true;

  while (changed) {
    changed = false;
    i = blocks.len() - 1;

    while (i >= 0) {
      stamp++;
      let out = Array.new<I32>(0);
      let catchBlock = catches[i];

      for (successor in successors[i]) {
        for (member in liveIn[successor]) {
          _add(out, marks, stamp, member);
        }
      }
      let caught = (catchBlock >= 0) ? liveIn[catchBlock] : Array.new<I32>(0);

      for (member in caught) {
        if (member != payloads[i]) { _add(out, marks, stamp, member); }
      }
      liveOut[i] = out;

      stamp++;
      let live = Array.new<I32>(0);
      _mark(defs[i], written, stamp);
      _mark(kills[i], early, stamp);

      for (member in uses[i]) {
        _add(live, marks, stamp, member);
      }

      for (member in out) {
        if (written[member] != stamp) { _add(live, marks, stamp, member); }
      }

      for (member in caught) {
        if ((member != payloads[i]) && (early[member] != stamp)) {
          _add(live, marks, stamp, member);
        }
      }

      if (live.len() > liveIn[i].len()) {
        liveIn[i] = live;
        changed = true;
      }
      i--;
    }
  }

  (liveIn, liveOut)
};
