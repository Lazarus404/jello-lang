package ir;

import { bytesLiteral } from frontend.Tokens;
import { concatAll, decimal } from frontend.Text;
import type { BasicBlock, Function, Instruction, Native, Program, ReturnType, Terminator, ThrowHandler, ValueType } from ir.Model;
import { ReturnType, ValueType, argumentCount, argsOf, dstOf, immOf, opOf } from ir.Model;

let _type: (ValueType) -> Bytes = fn(_ty) { "" };

let _types = fn(types: Array<ValueType>): Bytes {
  let out = "";
  let i = 0;

  while (i < types.len()) {
    if (i > 0) { out += ", "; }
    out += _type(types[i]);
    i++;
  }
  out
};
let _returnType = fn(result: ReturnType): Bytes { match (result) { Void => "void", Value(ty) => _type(ty) } };
_type = fn(ty) {
  match (ty) {
    Bool => "bool",
    I32 => "i32",
    I64 => "i64",
    Bytes => "bytes",
    Dynamic => "dynamic",
    ArrayOf(element) => "array<" + _type(element) + ">",
    ListOf(element) => "list<" + _type(element) + ">",
    TupleOf(elements) => "(" + _types(elements) + ")",
    Nominal(id) => "type@" + Std.string(id),
    Function(args, result) => "fn(" + _types(args) + ") -> " + _returnType(result),
  }
};
export let printValueType: (ValueType) -> Bytes = fn(ty) { _type(ty) };

let _register = fn(id: I32): Bytes { "%" + Std.string(id) };

let _registers = fn(ids: Array<I32>, start: I32): Bytes {
  let out = "";
  let i = start;

  while (i < ids.len()) {
    if (i > start) { out += ", "; }
    out += _register(ids[i]);
    i++;
  }
  out
};

let _width = fn(registers: Array<ValueType>, register: I32): Bytes { _type(registers[register]) };

let _instruction = fn(instruction: Instruction, registers: Array<ValueType>, pool: Array<Bytes>): Bytes {
  let args = argsOf(instruction);
  let imm = Std.string(immOf(instruction));
  let operands = _registers(args, 0);

  let text = match (opOf(instruction)) {
    ConstBool => "bool " + (immOf(instruction) == 1 ? "true" : "false"),
    ConstI32 => "i32 " + imm,
    ConstI64 => "i64 #" + imm,
    ConstBytes => "bytes " + bytesLiteral(pool[immOf(instruction)]),
    ConstNull => "null",
    ConstFunction => "function @" + imm + (args.len() > 0 ? "(" + operands + ")" : ""),
    Move => "move " + operands,
    Add => "add.wrap." + _width(registers, args[0]) + " " + operands,
    Sub => "sub.wrap." + _width(registers, args[0]) + " " + operands,
    Mul => "mul.wrap." + _width(registers, args[0]) + " " + operands,
    Div => "div.s." + _width(registers, args[0]) + " " + operands,
    Rem => "rem.s." + _width(registers, args[0]) + " " + operands,
    Shl => "shl." + _width(registers, args[0]) + " " + operands,
    Shr => "shr.s." + _width(registers, args[0]) + " " + operands,
    BitAnd => "bitand." + _width(registers, args[0]) + " " + operands,
    BitOr => "bitor." + _width(registers, args[0]) + " " + operands,
    BitXor => "bitxor." + _width(registers, args[0]) + " " + operands,
    Neg => "neg.wrap." + _width(registers, args[0]) + " " + operands,
    Not => "not.bool " + operands,
    Eq => "eq." + _width(registers, args[0]) + " " + operands,
    Lt => "lt.s." + _width(registers, args[0]) + " " + operands,
    Sext => "sext.i32.i64 " + operands,
    Trunc => "trunc.i64.i32 " + operands,
    Box => "box " + operands,
    Unbox => "unbox " + operands,
    KindOf => "kind_of " + operands,
    IsEnum => "is_enum @" + imm + " " + operands,
    IsNull => "is_null " + operands,
    NullCheck => "null_check " + operands,
    ArrayNew => "array.new " + operands,
    ArrayLen => "array.len " + operands,
    ArrayGet => "array.get " + operands,
    ArraySet => "array.set " + operands,
    ArrayResize => "array.resize " + operands,
    ListNil => "list.nil",
    ListCons => "list.cons " + operands,
    ListHead => "list.head " + operands,
    ListTail => "list.tail " + operands,
    ListIsNil => "list.is_nil " + operands,
    BytesNew => "bytes.new " + operands,
    BytesSet => "bytes.set_u8 " + operands,
    BytesBlit => "bytes.blit " + operands,
    BytesLen => "bytes.len " + operands,
    BytesGet => "bytes.get_u8 " + operands,
    BytesSlice => "bytes.slice " + operands,
    BytesConcat => "bytes.concat " + operands,
    BytesEq => "bytes.eq " + operands,
    TupleNew => "tuple " + operands,
    TupleGet => "tuple.get " + operands + ", " + imm,
    EnumNew => "enum.new " + imm + "(" + operands + ")",
    EnumTag => "enum.tag " + operands,
    EnumGet => "enum.get " + operands + ", " + imm,
    Call => "call @" + imm + "(" + operands + ")",
    CallIndirect => "call " + _register(args[0]) + "(" + _registers(args, 1) + ")",
    CallNative => "call native n" + imm + "(" + operands + ")",
    StructNew => "struct.new",
    StructSet => "struct.set " + _register(args[0]) + ", " + imm + ", " + _register(args[1]),
    AddImm => "add.wrap.i32 " + operands + ", " + imm,
    SubImm => "sub.wrap.i32 " + operands + ", " + imm,
    MulImm => "mul.wrap.i32 " + operands + ", " + imm,
    EqImm => "eq.i32 " + operands + ", " + imm,
    LtImm => "lt.s.i32 " + operands + ", " + imm,
    SpillPush => "spill.push " + operands + ", " + imm,
    SpillPop => "spill.pop " + imm,
    GlobalGet => "global.get g" + imm,
    GlobalSet => "global.set g" + imm + ", " + operands,
  };
  let dst = dstOf(instruction);
  dst < 0 ? text : _register(dst) + " = " + text
};

let _terminator = fn(terminator: Terminator): Bytes {
  match (terminator) {
    Jump(target) => "jump block " + Std.string(target),
    Branch(condition, thenTarget, elseTarget) => "branch " + _register(condition)
      + ", block " + Std.string(thenTarget) + ", block " + Std.string(elseTarget),
    ReturnVoid => "return",
    ReturnValue(value) => "return " + _register(value),
    Throw(value, _) => "throw " + _register(value),
    Unreachable => "unreachable",
  }
};

let _handler = fn(handler: ThrowHandler): Bytes {
  match (handler) { Catch(target, payload) => " catch block " + Std.string(target) + " as " + _register(payload) }
};

let _block = fn(block: BasicBlock, registers: Array<ValueType>, pool: Array<Bytes>, out: Array<Bytes>) {
  match (block) { Block(id, instructions, terminator, handler) => {
    let label = "  block " + Std.string(id);
    if (handler != null) { label += _handler(handler); }
    out.push(label + ":\n");
    let i = 0;

    while (i < instructions.len()) {
      out.push("    " + _instruction(instructions[i], registers, pool) + "\n");
      i++;
    }
    out.push("    " + _terminator(terminator) + "\n");
  } };
  null
};

let _function = fn(function: Function, pool: Array<Bytes>, out: Array<Bytes>) {
  match (function) { Function(id, params, captures, registers, result, blocks, entry) => {
    let header = "fn @" + Std.string(id) + "(";
    let i = 0;

    while (i < params.len()) {
      if (i == argumentCount(function)) { header += ") captures("; } else if (i > 0) { header += ", "; }
      header += _register(params[i]) + ": " + _type(registers[params[i]]);
      i++;
    }
    out.push(header + ") -> " + _returnType(result) + " entry " + Std.string(entry) + " {\n");
    i = 0;

    while (i < registers.len()) {
      out.push("  register " + _register(i) + ": " + _type(registers[i]) + "\n");
      i++;
    }
    i = 0;

    while (i < blocks.len()) {
      _block(blocks[i], registers, pool, out);
      i++;
    }
    out.push("}\n");
  } };
  null
};

export let printIr: (Program) -> Bytes = fn(program) {
  match (program) { Program(functions, pool, wides, _, globals, natives) => {
    let out = Array.new<Bytes>(0);
    let i = 0;

    while (i < globals.len()) {
      out.push("global g" + Std.string(i) + ": " + _type(globals[i]) + "\n");
      i++;
    }
    if (globals.len() > 0) { out.push("\n"); }
    i = 0;

    while (i < natives.len()) {
      match (natives[i]) { Native(library, name, params, result) => {
        out.push("native n" + Std.string(i) + ": " + library + "." + name + " " + _type(ValueType.Function(params, ReturnType.Value(result))) + "\n");
      } };
      i++;
    }
    if (natives.len() > 0) { out.push("\n"); }
    i = 0;

    while (i < wides.len()) {
      out.push("i64 #" + Std.string(i) + " = " + decimal(wides[i]) + "\n");
      i++;
    }
    if (wides.len() > 0) { out.push("\n"); }
    i = 0;

    while (i < functions.len()) {
      if (i > 0) { out.push("\n"); }
      _function(functions[i], pool, out);
      i++;
    }
    concatAll(out)
  } }
};
