package ir;

import { bytesLiteral } from support.Text;
import type {
  BasicBlock, Function, Instruction, Native, Program, Terminator, ThrowHandler, ValueType
} from ir.Model;
import { argumentCount } from ir.Model;

let _types = fn(types: Array<ValueType>): Bytes {
  let out = "";

  for (i, ty in types) {
    if (i > 0) { out += ", "; }
    out += _type(ty);
  }
  out
};

let _type = fn(ty: ValueType): Bytes {
  match (ty) {
    Bool => "bool",
    I32 => "i32",
    I64 => "i64",
    F16 => "f16",
    F32 => "f32",
    F64 => "f64",
    Bytes => "bytes",
    Atom => "atom",
    Dynamic => "dynamic",
    Object => "object",
    ArrayOf(element) => `array<${_type(element)}>`,
    ListOf(element) => `list<${_type(element)}>`,
    TupleOf(elements) => `(${_types(elements)})`,
    Nominal(id) => `type@${id}`,
    Function(args, result) => `fn(${_types(args)}) -> ${_type(result)}`,
  }
};

let _register = fn(id: I32): Bytes { `%${id}` };

let _registers = fn(ids: Array<I32>, start: I32): Bytes {
  let out = "";
  let i = start;

  while (i < ids.len()) {
    if (i > start) { out += ", "; }
    out += _register(ids[i]);
    i++;
  }
  out
};

let _width = fn(registers: Array<ValueType>, register: I32): Bytes { _type(registers[register]) };

let _qualified = fn(
  registers: Array<ValueType>,
  register: I32,
  integer: Bytes,
  float: Bytes
): Bytes {
  let name = match (registers[register]) { F16, F32, F64 => float, _ => integer };
  name + _type(registers[register])
};

let _equalityWidth = fn(registers: Array<ValueType>, register: I32): Bytes {
  match (registers[register]) {
    Function(_, _) => "fn",
    _ => _width(registers, register),
  }
};

let _FORMATS = ["u16.le", "u16.be", "u32.le", "u32.be", "i32.le", "i32.be", "f32.le", "f32.be"];
let _format = fn(format: I32): Bytes { _FORMATS[format] };
let _bitField = fn(imm: I32): Bytes { `, ${imm / 16}, ${imm % 16}` };

let _atomKey = fn(imm: I32): Bytes { imm < 0 ? "" : `, #${imm}` };

let _instruction = fn(
  instruction: Instruction,
  registers: Array<ValueType>,
  pool: Array<Bytes>
): Bytes {
  let args = instruction.args;
  let imm = Std.string(instruction.imm);
  let operands = _registers(args, 0);

  let text: Bytes = match (instruction.op) {
    ConstBool => `bool ${instruction.imm == 1 ? "true" : "false"}`,
    ConstI32 => `i32 ${imm}`,
    ConstI64 => `i64 #${imm}`,
    ConstFloat => match (registers[instruction.dst]) {
      F64 => `f64 #${imm}`,
      _ => `${_type(registers[instruction.dst])} bits ${imm}`,
    },
    ConstBytes => `bytes ${bytesLiteral(pool[instruction.imm])}`,
    ConstAtom => `atom #${imm}`,
    ConstNull => "null",
    ConstFunction => `function @${imm}${args.len() > 0 ? "(" + operands + ")" : ""}`,
    Move => `move ${operands}`,
    Add => `${_qualified(registers, args[0], "add.wrap.", "add.")} ${operands}`,
    Sub => `${_qualified(registers, args[0], "sub.wrap.", "sub.")} ${operands}`,
    Mul => `${_qualified(registers, args[0], "mul.wrap.", "mul.")} ${operands}`,
    Div => `${_qualified(registers, args[0], "div.s.", "div.")} ${operands}`,
    Rem => `rem.s.${_width(registers, args[0])} ${operands}`,
    DivU => `div.u.${_width(registers, args[0])} ${operands}`,
    RemU => `rem.u.${_width(registers, args[0])} ${operands}`,
    Shl => `shl.${_width(registers, args[0])} ${operands}`,
    Shr => `shr.s.${_width(registers, args[0])} ${operands}`,
    BitAnd => `bitand.${_width(registers, args[0])} ${operands}`,
    BitOr => `bitor.${_width(registers, args[0])} ${operands}`,
    BitXor => `bitxor.${_width(registers, args[0])} ${operands}`,
    Neg => `${_qualified(registers, args[0], "neg.wrap.", "neg.")} ${operands}`,
    Not => `not.bool ${operands}`,
    Eq => `eq.${_equalityWidth(registers, args[0])} ${operands}`,
    Lt => `${_qualified(registers, args[0], "lt.s.", "lt.")} ${operands}`,
    LtU => `lt.u.${_width(registers, args[0])} ${operands}`,
    Sext => `sext.i32.i64 ${operands}`,
    Zext => `zext.i32.i64 ${operands}`,
    Trunc => `trunc.i64.i32 ${operands}`,
    Convert => {
      let source = _width(registers, args[0]);
      `convert.${source}.${_type(registers[instruction.dst])} ${operands}`
    },
    Box => `box ${operands}`,
    Unbox => `unbox ${operands}`,
    KindOf => `kind_of ${operands}`,
    IsEnum => `is_enum @${imm} ${operands}`,
    IsNull => `is_null ${operands}`,
    NullCheck => `null_check ${operands}`,
    ArrayNew => `array.new ${operands}`,
    ArrayLen => `array.len ${operands}`,
    ArrayGet => `array.get ${operands}`,
    ArraySet => `array.set ${operands}`,
    ArrayResize => `array.resize ${operands}`,
    ArrayConcat => `array.concat ${operands}`,
    ListNil => "list.nil",
    ListCons => `list.cons ${operands}`,
    ListHead => `list.head ${operands}`,
    ListTail => `list.tail ${operands}`,
    ListIsNil => `list.is_nil ${operands}`,
    BytesNew => `bytes.new ${operands}`,
    BytesSet => `bytes.set_u8 ${operands}`,
    BytesBlit => `bytes.blit ${operands}`,
    BytesFreeze => `bytes.freeze ${operands}`,
    BitsRead => `bits.read ${operands}${_bitField(instruction.imm)}`,
    BitsWrite => `bits.write ${operands}${_bitField(instruction.imm)}`,
    BytesRead => `bytes.read.${_format(instruction.imm)} ${operands}`,
    BytesWrite => `bytes.write.${_format(instruction.imm)} ${operands}`,
    BytesLen => `bytes.len ${operands}`,
    BytesGet => `bytes.get_u8 ${operands}`,
    BytesSlice => `bytes.slice ${operands}`,
    BytesConcat => `bytes.concat ${operands}`,
    BytesJoin => `bytes.join ${operands}`,
    BytesConcatMany => `bytes.concat_many ${operands}`,
    BytesEq => `bytes.eq ${operands}`,
    TupleNew => `tuple ${operands}`,
    TupleGet => `tuple.get ${operands}, ${imm}`,
    EnumNew => `enum.new ${imm}(${operands})`,
    EnumTag => `enum.tag ${operands}`,
    EnumGet => `enum.get ${operands}, ${imm}`,
    ObjectNew => "object.new",
    ObjectGet => `object.get ${operands}${_atomKey(instruction.imm)}`,
    ObjectSet => `object.set ${operands}${_atomKey(instruction.imm)}`,
    ObjectHas => `object.has ${operands}${_atomKey(instruction.imm)}`,
    ObjectRemove => `object.remove ${operands}`,
    ObjectClear => `object.clear ${operands}`,
    ObjectCopy => `object.copy ${operands}`,
    ObjectKeys => `object.keys ${operands}`,
    Call => `call @${imm}(${operands})`,
    CallIndirect => `call ${_register(args[0])}(${_registers(args, 1)})`,
    CallNative => `call native n${imm}(${operands})`,
    StructNew => "struct.new",
    StructSet => `struct.set ${_register(args[0])}, ${imm}, ${_register(args[1])}`,
    AddImm => `add.wrap.i32 ${operands}, ${imm}`,
    SubImm => `sub.wrap.i32 ${operands}, ${imm}`,
    MulImm => `mul.wrap.i32 ${operands}, ${imm}`,
    EqImm => `eq.i32 ${operands}, ${imm}`,
    LtImm => `lt.s.i32 ${operands}, ${imm}`,
    SpillPush => `spill.push ${operands}, ${imm}`,
    SpillPop => `spill.pop ${imm}`,
    GlobalGet => `global.get g${imm}`,
    GlobalSet => `global.set g${imm}, ${operands}`,
  };
  let dst = instruction.dst;
  (dst < 0) ? text : `${_register(dst)} = ${text}`
};

let _terminator = fn(terminator: Terminator): Bytes {
  match (terminator) {
    Jump(target) => `jump block ${target}`,
    Branch(condition, thenTarget, elseTarget) => {
      `branch ${_register(condition)}, block ${thenTarget}, block ${elseTarget}`
    },
    ReturnValue(value) => `return ${_register(value)}`,
    Throw(value, _) => `throw ${_register(value)}`,
  }
};

let _handler = fn(handler: ThrowHandler): Bytes {
  ` catch block ${handler.target} as ${_register(handler.payload)}`
};

let _block = fn(
  block: BasicBlock,
  registers: Array<ValueType>,
  pool: Array<Bytes>,
  out: Array<Bytes>
) {
  let handler = block.handler;
  let label = `  block ${block.id}`;
  if (handler != null) { label += _handler(handler); }
  out.push(`${label}:\n`);

  for (insn in block.instructions) {
    out.push(`    ${_instruction(insn, registers, pool)}\n`);
  }
  out.push(`    ${_terminator(block.terminator)}\n`);
  null
};

let _function = fn(function: Function, pool: Array<Bytes>, out: Array<Bytes>) {
  let registers = function.registers;
  let header = `fn @${function.id}(`;

  for (i, param in function.params) {
    if (i == argumentCount(function)) {
      header += ") captures(";
    } else if (i > 0) {
      header += ", ";
    }
    header += `${_register(param)}: ${_type(registers[param])}`;
  }
  out.push(`${header}) -> ${_type(function.result)} entry ${function.entry} {\n`);

  for (i, ty in registers) {
    out.push(`  register ${_register(i)}: ${_type(ty)}\n`);
  }

  for (block in function.blocks) {
    _block(block, registers, pool, out);
  }
  out.push("}\n");
  null
};

export let printIr = fn(program: Program): Bytes {
  let out = Array.new<Bytes>(0);

  let globals = program.globals;

  for (i, ty in globals) {
    out.push(`global g${i}: ${_type(ty)}\n`);
  }
  if (globals.len() > 0) { out.push("\n"); }

  let natives = program.natives;

  for (i, native in natives) {
    let result = native.void ? "void" : _type(native.result);
    let signature = `fn(${_types(native.params)}) -> ${result}`;
    out.push(`native n${i}: ${native.library}.${native.name} ${signature}\n`);
  }
  if (natives.len() > 0) { out.push("\n"); }

  let wides = program.wides;

  for (i, wide in wides) {
    out.push(`i64 #${i} = ${wide}\n`);
  }
  if (wides.len() > 0) { out.push("\n"); }

  let floats = program.floats;

  for (i, float in floats) {
    out.push(`f64 #${i} = bits ${float}\n`);
  }
  if (floats.len() > 0) { out.push("\n"); }

  let atoms = program.atoms;

  for (i, atom in atoms) {
    out.push(`atom #${i} = :${atom}\n`);
  }
  if (atoms.len() > 0) { out.push("\n"); }

  for (i, function in program.functions) {
    if (i > 0) { out.push("\n"); }
    _function(function, program.bytes, out);
  }

  out.join("")
};
