package ir;

import { handlerPayload, handlerTarget, instructionMayThrow } from ir.Model;
import type { BasicBlock, Instruction, Terminator, ThrowHandler } from ir.Model;

export let terminatorThrows: (Terminator) -> Bool = fn(terminator) {
  match (terminator) { Throw(_, _) => true, _ => false }
};

export let normalSuccessors: (Terminator) -> Array<I32> = fn(terminator) {
  match (terminator) {
    Jump(target) => [target],
    Branch(_, thenTarget, elseTarget) => [thenTarget, elseTarget],
    _ => [],
  }
};

export let blockMayThrow: (Array<Instruction>, Terminator) -> Bool = fn(instructions, terminator) {
  if (terminatorThrows(terminator)) { return true; }
  let i = 0;

  while (i < instructions.len()) {
    if (instructionMayThrow(instructions[i])) { return true; }
    i++;
  }
  false
};

export let blockIndexes: (Array<BasicBlock>) -> Array<I32> = fn(blocks) {
  let indexes = Array.new<I32>(0);
  let i = 0;

  while (i < blocks.len()) {
    match (blocks[i]) {
      Block(id, _, _, _) => {
        while (indexes.len() <= id) { indexes.push(-1); }
        indexes[id] = i;
        null
      }
    };
    i++;
  }
  indexes
};

export let blockCatch: (BasicBlock, Array<I32>) -> Tuple<I32, I32> = fn(block, indexes) {
  match (block) { Block(_, instructions, terminator, handler) => {
    if ((handler == null) || !blockMayThrow(instructions, terminator)) { return (-1, -1); }
    (indexes[handlerTarget(handler)], handlerPayload(handler))
  } }
};

export let blockSuccessors: (BasicBlock) -> Array<I32> = fn(block) {
  match (block) {
    Block(_, instructions, terminator, handler) => {
      let successors = normalSuccessors(terminator);

      if (blockMayThrow(instructions, terminator) && (handler != null)) {
        successors.push(handlerTarget(handler));
      }
      successors
    },
  }
};
