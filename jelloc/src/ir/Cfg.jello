package ir;

import { instructionMayThrow } from ir.Model;
import type { BasicBlock, Instruction, Terminator } from ir.Model;

let _terminatorThrows = fn(terminator: Terminator): Bool {
  match (terminator) { Throw(_, _) => true, _ => false }
};

export let blockId = fn(block: BasicBlock): I32 { block.id };

export let terminatorRead = fn(terminator: Terminator): I32 {
  match (terminator) { Branch(value, _, _), ReturnValue(value), Throw(value, _) => value, _ => -1 }
};

export let normalSuccessors = fn(terminator: Terminator): Array<I32> {
  match (terminator) {
    Jump(target) => [target],
    Branch(_, thenTarget, elseTarget) => [thenTarget, elseTarget],
    _ => [],
  }
};

export let blockMayThrow = fn(instructions: Array<Instruction>, terminator: Terminator): Bool {
  if (_terminatorThrows(terminator)) { return true; }

  for (instruction in instructions) {
    if (instructionMayThrow(instruction)) { return true; }
  }
  false
};

export let blockIndexes = fn(blocks: Array<BasicBlock>): Array<I32> {
  let indexes = Array.new<I32>(0);

  for (i, block in blocks) {
    let id = block.id;
    while (indexes.len() <= id) { indexes.push(-1); }
    indexes[id] = i;
  }

  indexes
};

export let blockCatch = fn(block: BasicBlock, indexes: Array<I32>): Tuple<I32, I32> {
  let handler = block.handler;

  if ((handler == null) || !blockMayThrow(block.instructions, block.terminator)) {
    return (-1, -1);
  }

  (indexes[handler.target], handler.payload)
};
