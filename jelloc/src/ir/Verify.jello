package ir;

/** @file
 * The IR verifier; checks that a program is well formed and well typed, and raises an internal
 * error for the first problem it finds, since invalid IR is a compiler bug. Lowering
 * (`ir.Lower`) verifies its output, legalisation (`backend.jello.Legalize`) verifies the
 * legalised forms, and allocation (`backend.jello.Allocate`) also checks the `.jlo` limits on
 * registers and native arity. Checks cover operand counts and types per operation, block
 * targets and try regions, and that every register and spill slot is written before it is
 * read. The program being verified is held in module state while a check runs. */

import type {
  BasicBlock, EnumSchema, Function, Instruction, Native, Program, Terminator, ThrowHandler,
  ValueType
} from ir.Model;
import { ValueType, argumentCount, canBeNull, comparesByIdentity, valueTypeEqual } from ir.Model;
import { liveness } from ir.Liveness;
import { internalError } from support.Internal;

/** Raises an internal error for invalid IR.
 * @param message  what is wrong
 * @return false, never reached
 * @throws an internal error with `message` */
let _fail = fn(message: Bytes): Bool {
  internalError(`invalid IR: ${message}`);
  false
};

/** Whether a program surrounds the function being verified. Without one (`verifyFunction`),
 * whatever needs the program is not checked; calls, function constants' callees, enum
 * layouts and enum tests, globals, and the I64 and bytes pool indexes. */
let _inProgram = false;
/** Whether the program is legalised (see `Model.Op` and `backend.jello.Legalize`); an `EnumGet`
 * reads its field index from a register too, `TupleNew` is gone, and a throw raises a Dynamic. */
let _legalized = false;
// Each function's index in the program by function ID, or -1.
let _functionIndexes = Array.new<I32>(0);
// The function type of each function, by index in the program, as a `Function` value type.
let _signatures = Array.new<ValueType>(0);
// The number of captures of each function, by index in the program.
let _captureCounts = Array.new<I32>(0);
// The size of the program's bytes pool.
let _poolSize = 0;
// The size of the program's I64 pool.
let _wideCount = 0;
// The size of the program's F64 pool.
let _floatCount = 0;
// The number of the program's atoms.
let _atomCount = 0;
// The program's enum layouts.
let _enums = Array.new<EnumSchema>(0);
// The program's global types.
let _globals = Array.new<ValueType>(0);
// The program's natives.
let _natives = Array.new<Native>(0);

// The register types of the function being verified.
let _registers = Array.new<ValueType>(0);

/** The types the operand checks name most, spelled once; most instructions, it turns out, are
 * about bytes and I32s. */
let _bool = ValueType.Bool;
let _i32 = ValueType.I32;
let _i64 = ValueType.I64;
let _bytes = ValueType.Bytes;
let _atom = ValueType.Atom;
let _object = ValueType.Object;
let _dynamic = ValueType.Dynamic;

// The operand type lists the checks name most, built once.
let _noTypes = Array.new<ValueType>(0);
let _ofBool = [_bool];
let _ofI32 = [_i32];
let _ofI64 = [_i64];
let _ofBytes = [_bytes];
let _ofDynamic = [_dynamic];
let _ofObject = [_object];
let _bytesI32 = [_bytes, _i32];
let _bytesI32I32 = [_bytes, _i32, _i32];
let _bytesBytes = [_bytes, _bytes];
let _bytesBytesI32 = [_bytes, _bytes, _i32];
let _objectAtom = [_object, _atom];

/** Returns the type of `register`.
 * @throws an internal error if `register` is not one of the function's */
let _type = fn(register: I32): ValueType {
  if ((register < 0) || (register >= _registers.len())) {
    _fail(`register out of range: ${register}`);
  }
  _registers[register]
};

/** Checks that `register` has type `expected`.
 * @throws an internal error if it does not */
let _expect = fn(register: I32, expected: ValueType) {
  if (!valueTypeEqual(_type(register), expected)) { _fail(`wrong type for register ${register}`); }
  null
};

// Checks that the registers of `registers` from `start` on have the types `types`, in turn.
let _expectEach = fn(registers: Array<I32>, start: I32, types: Array<ValueType>) {
  for (i, ty in types) {
    _expect(registers[start + i], ty);
  }
  null
};

// Checks that every register of `registers` has type `expected`.
let _expectAll = fn(registers: Array<I32>, expected: ValueType) {
  for (register in registers) {
    _expect(register, expected);
  }
  null
};

// Checks whether `ty` is an integer type, I32 or I64.
let _isNumeric = fn(ty: ValueType): Bool { match (ty) { I32, I64 => true, _ => false } };

/** Checks whether `ty` is an integer type or F32 or F64, the types the VM divides, negates and
 * compares; with `half`, F16 too, which it only adds, subtracts and multiplies. */
let _isArithmetic = fn(ty: ValueType, half: Bool): Bool {
  match (ty) {
    I32, I64, F32, F64 => true,
    F16 => half,
    _ => false,
  }
};

/** Checks whether the VM converts a value of type `source` to type `target`, one of them a
 * float. */
let _converts = fn(source: ValueType, target: ValueType): Bool {
  match ((source, target)) {
    (I32, F16), (I32, F32), (I32, F64), (I64, F32), (I64, F64) => true,
    (F16, I32), (F32, I32), (F64, I32), (F32, I64), (F64, I64) => true,
    (F16, F32), (F32, F16), (F32, F64), (F64, F32) => true,
    _ => false,
  }
};

/** Returns the index in the program of the function with ID `function`.
 * @throws an internal error if no function has that ID */
let _index = fn(function: I32): I32 {
  if ((function < 0)
    || (function >= _functionIndexes.len())
    || (_functionIndexes[function] < 0)) {
    _fail(`unknown function @${function}`);
  }
  _functionIndexes[function]
};

/** Checks a call's operands against a signature; the arguments from `start` on against
 * `params`, and the destination against `result`.
 * @param params  the callee's parameter types
 * @param result  the callee's result type
 * @param dst  the call's destination register
 * @param args  the call's operands
 * @param start  the index of the first argument in `args`
 * @throws an internal error on a count or type mismatch */
let _call = fn(
  params: Array<ValueType>,
  result: ValueType,
  dst: I32,
  args: Array<I32>,
  start: I32
) {
  if (args.len() - start != params.len()) { _fail("call argument count mismatch"); }
  _expectEach(args, start, params);
  _expect(dst, result)
};

/** Returns the variants' field types of enum `enumId`, by tag.
 * @throws an internal error if `enumId` is out of range or a record's */
let _variants = fn(enumId: I32): Array<Array<ValueType>> {
  if ((enumId < 0) || (enumId >= _enums.len())) { _fail(`unknown enum type@${enumId}`); }

  match (_enums[enumId]) {
    Enum(variants) => variants,
    Record(_) => {
      _fail(`enum operation on a record@${enumId}`);
      []
    },
  }
};

/** Returns the field types of variant `tag` of enum `enumId`.
 * @param enumId  the enum's index
 * @param tag  the variant's tag
 * @return the field types
 * @throws an internal error if the enum or the tag is out of range */
let _fields = fn(enumId: I32, tag: I32): Array<ValueType> {
  let variants = _variants(enumId);
  if ((tag < 0) || (tag >= variants.len())) { _fail("enum tag out of range"); }
  variants[tag]
};

/** Fails unless `imm` is a `BitsRead` or `BitsWrite` field; a width of 1 to 8 bits at a
 * non-negative bit offset. */
let _bitField = fn(imm: I32) {
  if ((imm < 0) || (imm % 16 == 0) || (imm % 16 > 8)) { _fail("bit field out of range"); }
  null
};

// Returns the value type of a `BytesRead` or `BytesWrite` format, after checking it.
let _formatType = fn(format: I32): ValueType {
  if ((format < 0) || (format > 7)) { _fail("bytes format out of range"); }
  format >= 6 ? ValueType.F32 : _i32
};

/** Fails, in a whole program, unless `imm` indexes a pool of `size` entries.
 * @param what  the kind of constant, for the error */
let _pooled = fn(imm: I32, size: I32, what: Bytes) {
  if (_inProgram && ((imm < 0) || (imm >= size))) { _fail(`${what} out of range`); }
  null
};

/** Returns the field types of a struct of type `ty`; a tuple's elements, or a record's fields, or
 * null for a record outside a whole program, whose layout is unknown.
 * @param what  the operation, for the error
 * @throws an internal error if `ty` is neither */
let _structFields = fn(ty: ValueType, what: Bytes): ?Array<ValueType> {
  match (ty) {
    TupleOf(elements) => elements,
    Nominal(_) when (!_inProgram) => null,
    Nominal(id) when ((id >= 0) && (id < _enums.len())) => match (_enums[id]) {
      Record(fields) => fields,
      Enum(_) => {
        _fail(`${what} of an enum`);
        null
      },
    },
    _ => {
      _fail(`${what} of a non-struct`);
      null
    },
  }
};

/** Checks whether some variant of enum `enumId` has field `index` of type `ty`. An `EnumGet`
 * carries no tag, so this is all the verifier can check of it.
 * @param enumId  the enum's index
 * @param index  the field index
 * @param ty  the field's expected type
 * @throws an internal error if the enum is out of range */
let _hasField = fn(enumId: I32, index: I32, ty: ValueType): Bool {
  let variants = _variants(enumId);

  for (fields in variants) {
    if ((index < fields.len()) && valueTypeEqual(fields[index], ty)) { return true; }
  }
  false
};

/** Returns the type of global `index`.
 * @throws an internal error if it is out of range */
let _global = fn(index: I32): ValueType {
  if ((index < 0) || (index >= _globals.len())) { _fail("global out of range"); }
  _globals[index]
};

/** Checks that an instruction's operands `args` number `count`.
 * @throws an internal error if the count differs */
let _arity = fn(args: Array<I32>, count: I32) {
  if (args.len() != count) { _fail("wrong operand count"); }
  null
};

// Checks that an instruction's operands `args` have the types `types`, count first.
let _operands = fn(args: Array<I32>, types: Array<ValueType>) {
  _arity(args, types.len());
  _expectEach(args, 0, types)
};

/** Checks an instruction that defines `dst` of type `result` from operands of the types
 * `types`; the count, then the destination, then the operands. */
let _defines = fn(dst: I32, result: ValueType, args: Array<I32>, types: Array<ValueType>) {
  _arity(args, types.len());
  _expect(dst, result);
  _expectEach(args, 0, types)
};

// Fails unless `imm` is a spill slot, which an instruction numbers in 16 bits.
let _spillSlot = fn(imm: I32) {
  if ((imm < 0) || (imm >= 65536)) { _fail("spill slot out of range"); }
  null
};

/** Checks the operands and immediate of a `BitsRead`, `BitsWrite`, `BytesRead` or `BytesWrite`;
 * apart, so that `_instruction` stays small. */
let _bitsOrBytes = fn(instruction: Instruction) {
  let dst = instruction.dst;
  let args = instruction.args;
  let imm = instruction.imm;

  match (instruction.op) {
    BitsRead => {
      _arity(args, 1);
      _bitField(imm);
      _expect(dst, _i32);
      _expect(args[0], _bytes)
    },
    BitsWrite => {
      _arity(args, 2);
      _bitField(imm);
      _expectEach(args, 0, _bytesI32)
    },
    BytesRead => {
      _arity(args, 2);
      _expect(dst, _formatType(imm));
      _expectEach(args, 0, _bytesI32)
    },
    _ => {
      _arity(args, 3);
      _expectEach(args, 0, _bytesI32);
      _expect(args[2], _formatType(imm))
    },
  }
};

/** Checks one instruction; its operands are registers of the function, a store defines no
 * register while every other operation defines one, and its operand count, operand types,
 * destination type and immediate fit its operation. With `_inProgram`, references into the
 * program are checked too.
 * @throws an internal error if it is invalid */
let _instruction = fn(instruction: Instruction) {
  let dst = instruction.dst;
  let args = instruction.args;
  let imm = instruction.imm;

  for (arg in args) {
    _type(arg);
  }

  match (instruction.op) {
    ArraySet, ArrayResize, BytesSet, BytesBlit, BytesFreeze, BitsWrite, BytesWrite, StructSet,
    ObjectSet, ObjectClear, SpillPush, GlobalSet, NullCheck => {
      if (dst >= 0) { _fail("store defines a register"); }
      null
    },
    _ => {
      _type(dst);
      null
    },
  };

  match (instruction.op) {
    ConstBool => {
      _defines(dst, _bool, args, _noTypes);
      if ((imm != 0) && (imm != 1)) { _fail("bool constant out of range"); }
      null
    },
    ConstI32 => _defines(dst, _i32, args, _noTypes),
    ConstI64 => {
      _defines(dst, _i64, args, _noTypes);
      _pooled(imm, _wideCount, "i64 constant")
    },
    ConstFloat => {
      _arity(args, 0);

      match (_type(dst)) {
        F64 => _pooled(imm, _floatCount, "f64 constant"),
        F32, F16 => null,
        _ => {
          _fail("float constant of a type that is no float");
          null
        },
      }
    },
    ConstBytes => {
      _defines(dst, _bytes, args, _noTypes);
      _pooled(imm, _poolSize, "bytes constant")
    },
    ConstAtom => {
      _defines(dst, _atom, args, _noTypes);
      _pooled(imm, _atomCount, "atom constant")
    },
    ConstNull => {
      _arity(args, 0);
      if (!canBeNull(_type(dst))) { _fail("null constant of a type without null"); }
      null
    },
    ConstFunction => {
      match (_type(dst)) {
        Function(_, _) => null,
        _ => {
          _fail("function constant destination is not function typed");
          null
        },
      };
      _expectAll(args, _dynamic);

      if (_inProgram) {
        let callee = _index(imm);

        if (!valueTypeEqual(_type(dst), _signatures[callee])) {
          _fail("function constant signature mismatch");
        }
        if (args.len() != _captureCounts[callee]) { _fail("closure capture count mismatch"); }
      }
      null
    },
    Move => {
      _arity(args, 1);
      if (!valueTypeEqual(_type(dst), _type(args[0]))) { _fail("move type mismatch"); }
      null
    },

    Add, Sub, Mul, Div, Rem, Shl, Shr, BitAnd, BitOr, BitXor, DivU, RemU => {
      _arity(args, 2);
      let ty = _type(dst);

      let numeric = match (instruction.op) {
        Add, Sub, Mul => _isArithmetic(ty, true),
        Div => _isArithmetic(ty, false),
        _ => _isNumeric(ty),
      };
      if (!numeric) { _fail("arithmetic on a type that does not support it"); }
      _expect(args[0], ty);
      _expect(args[1], ty)
    },
    Neg => {
      _arity(args, 1);

      if (!_isArithmetic(_type(dst), false)) {
        _fail("negation of a type that does not support it");
      }
      _expect(args[0], _type(dst))
    },
    AddImm, SubImm, MulImm => _defines(dst, _i32, args, _ofI32),
    EqImm, LtImm => _defines(dst, _bool, args, _ofI32),
    Not => _defines(dst, _bool, args, _ofBool),
    Eq, Lt, LtU => {
      _arity(args, 2);
      _expect(dst, _bool);
      let ty = _type(args[0]);

      // Atoms and functions compare for equality alone, and unsigned only integers.
      let compared = match (instruction.op) {
        Eq when (comparesByIdentity(ty)) => true,
        LtU => _isNumeric(ty),
        _ => _isArithmetic(ty, false),
      };
      if (!compared) { _fail("comparison of a type that does not support it"); }
      _expect(args[1], ty)
    },
    Sext, Zext => _defines(dst, _i64, args, _ofI32),
    Trunc => _defines(dst, _i32, args, _ofI64),
    Convert => {
      _arity(args, 1);
      if (!_converts(_type(args[0]), _type(dst))) { _fail("conversion the VM lacks"); }
      null
    },

    Box => {
      _arity(args, 1);
      _expect(dst, _dynamic)
    },
    Unbox => {
      _arity(args, 1);

      match (_type(dst)) {
        Dynamic => {
          _fail("unbox to Dynamic");
          null
        },
        _ => null,
      };
      _expect(args[0], _dynamic)
    },
    KindOf => _defines(dst, _i32, args, _ofDynamic),
    IsEnum => {
      _defines(dst, _bool, args, _ofDynamic);

      if (_inProgram && ((imm < 0) || (imm >= _enums.len()))) {
        _fail("enum test of an unknown enum");
      }
      null
    },
    IsNull => {
      _arity(args, 1);
      _expect(dst, _bool);
      if (!canBeNull(_type(args[0]))) { _fail("null test of a type without null"); }
      null
    },
    NullCheck => {
      _arity(args, 1);
      if (!canBeNull(_type(args[0]))) { _fail("null check of a type without null"); }
      null
    },

    ArrayNew => {
      _arity(args, 1);

      match (_type(dst)) {
        ArrayOf(_) => null,
        _ => {
          _fail("array.new defines a non-array");
          null
        },
      };
      _expect(args[0], _i32)
    },
    ArrayLen => {
      _arity(args, 1);
      _expect(dst, _i32);

      match (_type(args[0])) {
        ArrayOf(_) => null,
        _ => {
          _fail("array.len of a non-array");
          null
        },
      }
    },
    ArrayGet, ArraySet => {
      let get = match (instruction.op) { ArrayGet => true, _ => false };
      _arity(args, get ? 2 : 3);

      match (_type(args[0])) {
        ArrayOf(element) => {
          _expect(args[1], _i32);
          _expect(get ? dst : args[2], element)
        },
        _ => {
          _fail("array access of a non-array");
          null
        },
      }
    },
    ArrayResize => {
      _arity(args, 2);

      match (_type(args[0])) {
        ArrayOf(_) => null,
        _ => {
          _fail("array.resize of a non-array");
          null
        },
      };
      _expect(args[1], _i32)
    },
    ArrayConcat => {
      _arity(args, 2);

      match (_type(dst)) {
        ArrayOf(_) => _expectEach(args, 0, [_type(dst), _type(dst)]),
        _ => {
          _fail("array.concat defines a non-array");
          null
        },
      }
    },

    ListNil => {
      _arity(args, 0);

      match (_type(dst)) {
        ListOf(_) => null,
        _ => {
          _fail("list.nil defines a non-list");
          null
        },
      }
    },
    ListCons => {
      _arity(args, 2);

      match (_type(dst)) {
        ListOf(element) => _expectEach(args, 0, [element, _type(dst)]),
        _ => {
          _fail("list.cons defines a non-list");
          null
        },
      }
    },
    ListHead, ListTail, ListIsNil => {
      _arity(args, 1);

      match (_type(args[0])) {
        ListOf(element) => match (instruction.op) {
          ListHead => _expect(dst, element),
          ListTail => _expect(dst, _type(args[0])),
          _ => _expect(dst, _bool),
        },
        _ => {
          _fail("list access of a non-list");
          null
        },
      }
    },

    BytesNew => _defines(dst, _bytes, args, _ofI32),
    BytesSet => _operands(args, _bytesI32I32),
    BytesBlit => _operands(args, _bytesBytesI32),
    BytesFreeze => _operands(args, _ofBytes),
    BitsRead, BitsWrite, BytesRead, BytesWrite => _bitsOrBytes(instruction),
    BytesGet => _defines(dst, _i32, args, _bytesI32),
    BytesLen => _defines(dst, _i32, args, _ofBytes),
    BytesSlice => _defines(dst, _bytes, args, _bytesI32I32),
    BytesConcat => _defines(dst, _bytes, args, _bytesBytes),
    BytesConcatMany => {
      // Its part count is an instruction byte.
      if (args.len() > 255) { _fail("bytes.concat_many of more than 255 parts"); }
      _expect(dst, _bytes);
      _expectAll(args, _bytes)
    },
    BytesJoin => _defines(dst, _bytes, args, [ValueType.ArrayOf(_bytes), _bytes]),
    BytesEq => _defines(dst, _bool, args, _bytesBytes),

    TupleNew => {
      if (_legalized) { _fail("tuple construction after legalization"); }
      let fields = _structFields(_type(dst), "tuple construction");
      if (fields != null) { _operands(args, fields); }
      null
    },
    StructNew => {
      _arity(args, 0);
      _structFields(_type(dst), "struct.new");
      null
    },
    TupleGet, StructSet => {
      let get = match (instruction.op) { TupleGet => true, _ => false };
      _arity(args, get ? 1 : 2);
      let fields = _structFields(_type(args[0]), "tuple access");

      if (fields != null) {
        if ((imm < 0) || (imm >= fields.len())) { _fail("tuple field index out of range"); }
        _expect(get ? dst : args[1], fields[imm]);
      }
      null
    },
    EnumNew => match (_type(dst)) {
      Nominal(id) => {
        if (_inProgram) { _operands(args, _fields(id, imm)); }
        null
      },
      _ => {
        _fail("enum construction destination is not nominal");
        null
      },
    },
    EnumTag => {
      _arity(args, 1);
      _expect(dst, _i32);

      match (_type(args[0])) {
        Nominal(_) => null,
        _ => {
          _fail("enum tag source is not nominal");
          null
        },
      }
    },
    EnumGet => {
      _arity(args, _legalized ? 2 : 1);
      if (_legalized) { _expect(args[1], _i32); }

      match (_type(args[0])) {
        Nominal(id) => {
          if (_inProgram && !_hasField(id, imm, _type(dst))) {
            _fail("enum payload type mismatch");
          }
          null
        },
        _ => {
          _fail("enum payload source is not nominal");
          null
        },
      }
    },

    ObjectNew => _defines(dst, _object, args, _noTypes),
    // A key in `imm` is an atom of the program; otherwise the access reads it from an Atom.
    ObjectGet, ObjectSet, ObjectHas => {
      let keyed = imm < 0;
      let set = match (instruction.op) { ObjectSet => true, _ => false };
      _arity(args, (keyed ? 2 : 1) + (set ? 1 : 0));
      _expect(args[0], _object);

      if (keyed) {
        _expect(args[1], _atom);
      } else if (_inProgram && (imm >= _atomCount)) {
        _fail("object key out of range");
      }
      match (instruction.op) { ObjectHas => _expect(dst, _bool), _ => null }
    },
    ObjectRemove => _defines(dst, _bool, args, _objectAtom),
    ObjectClear => _operands(args, _ofObject),
    ObjectCopy => _defines(dst, _object, args, _ofObject),
    ObjectKeys => _defines(dst, ValueType.ArrayOf(_atom), args, _ofObject),

    Call => {
      if (_inProgram) {
        let callee = _index(imm);
        if (_captureCounts[callee] != 0) { _fail("direct call of a function that captures"); }

        match (_signatures[callee]) {
          Function(params, result) => _call(params, result, dst, args, 0),
          _ => null,
        };
      }
      null
    },
    CallNative => {
      if (_inProgram) {
        if ((imm < 0) || (imm >= _natives.len())) { _fail("native out of range"); }
        let native = _natives[imm];
        _call(native.params, native.result, dst, args, 0);
      }
      null
    },
    CallIndirect => {
      if (args.len() == 0) { _fail("indirect call without a callee"); }

      match (_type(args[0])) {
        Function(params, result) => _call(params, result, dst, args, 1),
        _ => {
          _fail("indirect call callee is not function typed");
          null
        },
      }
    },

    SpillPush => {
      _arity(args, 1);
      _spillSlot(imm)
    },
    SpillPop => {
      _arity(args, 0);
      _spillSlot(imm)
    },
    GlobalGet => {
      _arity(args, 0);
      if (_inProgram) { _expect(dst, _global(imm)); }
      null
    },
    GlobalSet => {
      _arity(args, 1);
      if (_inProgram) { _expect(args[0], _global(imm)); }
      null
    },
  };
  null
};

/** Checks whether two blocks with handlers `a` and `b` are in the same try region; both have
 * none, or both catch into the same block with the same payload register. */
let _sameHandler = fn(a: ?ThrowHandler, b: ?ThrowHandler): Bool {
  if ((a == null) || (b == null)) { return (a == null) && (b == null); }
  (a.target == b.target) && (a.payload == b.payload)
};

/** Checks the try regions, which emission turns into the VM's TRY and ENDTRY scopes. The entry
 * block is in none, and both targets of a branch are in the branching block's region; only a
 * jump enters or leaves one. A catch block runs one region out of the blocks it catches for,
 * so following handlers from a block through their catch blocks counts its nesting, which
 * may be at most 16, the depth of the VM's try stack.
 * @param blocks  the function's blocks
 * @param indexes  block indexes by ID
 * @param entry  the entry block's ID
 * @throws an internal error if a region is invalid */
let _regions = fn(blocks: Array<BasicBlock>, indexes: Array<I32>, entry: I32) {
  if (blocks[indexes[entry]].handler != null) { _fail("entry block inside a try region"); }

  for (block in blocks) {
    let handler = block.handler;

    match (block.terminator) {
      Branch(_, thenTarget, elseTarget) => {
        let same = _sameHandler(handler, blocks[indexes[thenTarget]].handler)
          && _sameHandler(handler, blocks[indexes[elseTarget]].handler);
        if (!same) { _fail("branch into another try region"); }
        null
      },
      _ => null,
    };

    // Each catch block is one region further out, so the walk out counts the nesting.
    let depth = 0;

    while (handler != null) {
      depth++;
      if (depth > 16) { _fail("try regions nested more than 16 deep"); }
      handler = blocks[indexes[handler.target]].handler;
    }
  }
  null
};

/** Maps block IDs to positions in `blocks`, as `Cfg.blockIndexes` does, checking that IDs are
 * non-negative and unique.
 * @return each block's index by its ID, with -1 for an ID with no block
 * @throws an internal error on a negative or duplicate ID */
let _blockIndexes = fn(blocks: Array<BasicBlock>): Array<I32> {
  let indexes = Array.new<I32>(0);

  for (i, block in blocks) {
    let id = block.id;
    if (id < 0) { _fail("negative block id"); }
    while (indexes.len() <= id) { indexes.push(-1); }
    if (indexes[id] >= 0) { _fail("duplicate block id"); }
    indexes[id] = i;
  }
  indexes
};

/** Returns the index of block `id` from `indexes`, the block indexes by ID.
 * @throws an internal error if no block has that ID */
let _target = fn(indexes: Array<I32>, id: I32): I32 {
  if ((id < 0) || (id >= indexes.len()) || (indexes[id] < 0)) { _fail(`unknown block: ${id}`); }
  indexes[id]
};

/** Checks a terminator; its targets exist, a branch's condition is Bool, a return's value has
 * the function's result type, and a thrown value is a register of the function, Dynamic once
 * legalised.
 * @param result  the function's result type
 * @param indexes  block indexes by ID
 * @throws an internal error if it is invalid */
let _terminator = fn(result: ValueType, indexes: Array<I32>, terminator: Terminator) {
  match (terminator) {
    Jump(target) => {
      _target(indexes, target);
      null
    },
    Branch(condition, thenTarget, elseTarget) => {
      _expect(condition, _bool);
      _target(indexes, thenTarget);
      _target(indexes, elseTarget);
      null
    },
    ReturnValue(value) => _expect(value, result),
    // A legalised throw raises a boxed value, which a handler receives.
    Throw(value, _) => {
      if (_legalized) { _expect(value, _dynamic); } else { _type(value); }
      null
    },
  }
};

// Returns the spill slot `instruction` pushes or pops, or -1 if it is not a spill.
let _slot = fn(instruction: Instruction): I32 {
  match (instruction.op) { SpillPush, SpillPop => instruction.imm, _ => -1 }
};

/** Checks that every register and spill slot read is written earlier on every path to the
 * read; only the parameters may be live into the entry block. A throw carries what its block
 * wrote before the first instruction that may throw, and the catch payload (see
 * `Liveness.liveness`).
 * @param params  the function's parameter registers
 * @param blocks  the function's blocks
 * @param indexes  block indexes by ID
 * @param entry  the entry block's ID
 * @param slots  the number of spill slots the function uses
 * @throws an internal error naming the lowest register or slot read before it is written */
let _definitions = fn(
  params: Array<I32>,
  blocks: Array<BasicBlock>,
  indexes: Array<I32>,
  entry: I32,
  slots: I32
) {
  let registers = _registers.len();
  let (liveIn, _) = liveness(blocks, registers, slots, false);
  let live = liveIn[_target(indexes, entry)];
  let first = -1;

  for (register in live) {
    if ((params.indexOf(register) < 0) && ((first < 0) || (register < first))) { first = register; }
  }
  if (first >= registers) { _fail(`spill slot read before written: ${first - registers}`); }
  if (first >= 0) { _fail(`register used before definition: ${first}`); }
  null
};

/** Checks one function; its blocks, parameters (captures must be Dynamic), handlers, each
 * instruction and terminator, that each spill slot holds one type, its try regions, and that
 * every read follows a write.
 * @throws an internal error if it is invalid */
let _function = fn(function: Function) {
  let params = function.params;
  let blocks = function.blocks;
  _registers = function.registers;
  if (blocks.len() == 0) { _fail("function has no blocks"); }

  if ((function.captures < 0) || (function.captures > params.len())) {
    _fail("capture count out of range");
  }
  let indexes = _blockIndexes(blocks);
  _target(indexes, function.entry);

  for (i, param in params) {
    // Captures arrive boxed.
    if (i >= argumentCount(function)) {
      _expect(param, _dynamic);
    } else {
      _type(param);
    }
    if (params.indexOf(param) < i) { _fail("duplicate parameter register"); }
  }

  // Each spill slot holds one type. Slots are sparse, so `seen` marks the used ones.
  let slotTypes = Array.new<ValueType>(0);
  let seen = Array.new<Bool>(0);

  for (block in blocks) {
    let handler = block.handler;

    if (handler != null) {
      _target(indexes, handler.target);
      _expect(handler.payload, _dynamic);
      if (handler.target == block.id) { _fail("block handles its own throw"); }
    }

    for (insn in block.instructions) {
      _instruction(insn);
      let slot = _slot(insn);

      if (slot >= 0) {
        let ty = match (insn.op) { SpillPush => _type(insn.args[0]), _ => _type(insn.dst) };

        while (slotTypes.len() <= slot) {
          slotTypes.push(ty);
          seen.push(false);
        }

        if (!seen[slot]) {
          slotTypes[slot] = ty;
          seen[slot] = true;
        }
        if (!valueTypeEqual(slotTypes[slot], ty)) { _fail("spill slot type mismatch"); }
      }
    }
    _terminator(function.result, indexes, block.terminator);
  }

  _regions(blocks, indexes, function.entry);
  _definitions(params, blocks, indexes, function.entry, slotTypes.len());
  true
};

/** Verifies `function` on its own, unlegalised. What needs the program is not checked (see
 * `_inProgram`).
 * @throws an internal error if it is invalid */
export let verifyFunction = fn(function: Function): Bool {
  _inProgram = false;
  _legalized = false;
  _function(function)
};

/** Returns the function type of `function`; its argument registers' types and its result.
 * Captures are not part of it. */
let _signatureOf = fn(function: Function): ValueType {
  let types = Array.new<ValueType>(0);
  let i = 0;

  while (i < argumentCount(function)) {
    types.push(function.registers[function.params[i]]);
    i++;
  }
  ValueType.Function(types, function.result)
};

/** Verifies `program`; indexes its functions by ID (which must be non-negative and unique) and
 * records their signatures and the program's pools and tables, then checks each function from
 * index `first`.
 * @param legalized  whether to check the legalised forms
 * @param first  the index of the first function to check; those before it were checked already
 * @throws an internal error if it is invalid */
let _program = fn(program: Program, legalized: Bool, first: I32): Bool {
  _legalized = legalized;
  let functions = program.functions;
  _functionIndexes = Array.new<I32>(0);
  _signatures = Array.new<ValueType>(0);
  _captureCounts = Array.new<I32>(0);

  for (i, function in functions) {
    let id = function.id;
    if (id < 0) { _fail("negative function id"); }
    while (_functionIndexes.len() <= id) { _functionIndexes.push(-1); }
    if (_functionIndexes[id] >= 0) { _fail("duplicate function id"); }
    _functionIndexes[id] = i;

    for (param in function.params) {
      if ((param < 0) || (param >= function.registers.len())) {
        _fail("parameter register out of range");
      }
    }
    _signatures.push(_signatureOf(function));
    _captureCounts.push(function.captures);
  }

  _poolSize = program.bytes.len();
  _wideCount = program.wides.len();
  _floatCount = program.floats.len();
  _atomCount = program.atoms.len();
  _enums = program.enums;
  _globals = program.globals;
  _natives = program.natives;
  _inProgram = true;
  let i = first;

  while (i < functions.len()) {
    _function(functions[i]);
    i++;
  }
  _inProgram = false;
  true
};

// Verifies `program` as lowering produces it, before legalisation (see `_program`).
export let verifyProgram = fn(program: Program): Bool { _program(program, false, 0) };
// Verifies `program` in its legalised forms (see `_program`).
export let verifyLegalizedProgram = fn(program: Program): Bool { _program(program, true, 0) };

/** Verifies `program`, whose functions before index `first` were verified already in a program
 * with the same pools up to their uses (see `_program`).
 * @param legalized  whether to check the legalised forms */
export let verifyProgramFrom = fn(program: Program, legalized: Bool, first: I32): Bool {
  _program(program, legalized, first)
};

/** Verifies an allocated `program`; it is legalised and within the `.jlo` limits. Registers
 * are byte operands, so a function may use at most 256, and an import has at most 8 arguments
 * (see `Emit._module`).
 * @throws an internal error if it is invalid or exceeds a limit */
export let verifyAllocatedProgram = fn(program: Program): Bool {
  for (function in program.functions) {
    let count = function.registers.len();
    if (count > 256) { _fail(`function @${function.id} uses ${count} registers; JLO allows 256`); }
  }

  for (native in program.natives) {
    if (native.params.len() > 8) { _fail(`native ${native.name} takes more than 8 arguments`); }
  }

  verifyLegalizedProgram(program)
};
