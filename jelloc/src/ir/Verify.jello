package ir;

import type { BasicBlock, EnumSchema, Function, Instruction, Program, ReturnType, Terminator, ThrowHandler, ValueType } from ir.Model;
import { ReturnType, ValueType, argsOf, dstOf, immOf, instructionMayThrow, opOf, returnTypeEqual, valueTypeEqual } from ir.Model;
import { normalSuccessors } from ir.Cfg;
import { bitsAdd, bitsCopy, bitsEqual, bitsFull, bitsHas, bitsIntersect, bitsNew, bitsUnion } from ir.Bits;

let _fail = fn(message: Bytes): Bool {
  throw "invalid IR: " + message;
  false
};

let _inProgram = false;
let _functionIds = Array.new<I32>(0);
let _signatures = Array.new<ValueType>(0);
let _poolSize = 0;
let _enums = Array.new<EnumSchema>(0);
let _globals = Array.new<ValueType>(0);

let _registers = Array.new<ValueType>(0);

let _type = fn(register: I32): ValueType {
  if ((register < 0) || (register >= _registers.len())) { _fail("register out of range: " + Std.string(register)); }
  _registers[register]
};

let _expect = fn(register: I32, expected: ValueType) {
  if (!valueTypeEqual(_type(register), expected)) { _fail("wrong type for register " + Std.string(register)); }
  null
};

let _isNumeric = fn(ty: ValueType): Bool { match (ty) { I32, I64 => true, _ => false } };

let _signature = fn(function: I32): ValueType {
  let i = 0;

  while (i < _functionIds.len()) {
    if (_functionIds[i] == function) { return _signatures[i]; }
    i++;
  }
  _fail("unknown function @" + Std.string(function));
  ValueType.Bool
};

let _call = fn(params: Array<ValueType>, result: ReturnType, dst: I32, args: Array<I32>, start: I32) {
  if ((args.len() as I32) - start != (params.len() as I32)) { _fail("call argument count mismatch"); }
  let i = 0;

  while (i < params.len()) {
    _expect(args[start + i], params[i]);
    i++;
  }
  match (result) { Value(ty) => _expect(dst, ty), Void => { if (dst >= 0) { _fail("void call defines a register"); } null } }
};

let _fields = fn(enumId: I32, tag: I32): Array<ValueType> {
  if ((enumId < 0) || (enumId >= _enums.len())) { _fail("unknown enum type@" + Std.string(enumId)); }

  match (_enums[enumId]) { Enum(variants) => {
    if ((tag < 0) || (tag >= variants.len())) { _fail("enum tag out of range"); }
    variants[tag]
  } }
};

let _hasField = fn(enumId: I32, index: I32, ty: ValueType): Bool {
  match (_enums[enumId]) { Enum(variants) => {
    let i = 0;

    while (i < variants.len()) {
      if ((index < variants[i].len()) && valueTypeEqual(variants[i][index], ty)) { return true; }
      i++;
    }
    false
  } }
};

let _global = fn(index: I32): ValueType {
  if ((index < 0) || (index >= _globals.len())) { _fail("global out of range"); }
  _globals[index]
};

let _arity = fn(args: Array<I32>, count: I32) { if (args.len() != count) { _fail("wrong operand count"); } null };

let _instruction = fn(instruction: Instruction) {
  let dst = dstOf(instruction);
  let args = argsOf(instruction);
  let imm = immOf(instruction);
  let i = 0;

  while (i < args.len()) {
    _type(args[i]);
    i++;
  }

  match (opOf(instruction)) {
    ArraySet, StructSet, SpillPush, GlobalSet => { if (dst >= 0) { _fail("store defines a register"); } null },
    Call => null,
    _ => {
      _type(dst);
      null
    },
  };

  match (opOf(instruction)) {
    ConstBool => {
      _arity(args, 0);
      _expect(dst, ValueType.Bool);
      if ((imm != 0) && (imm != 1)) { _fail("bool constant out of range"); } null
    },
    ConstI32 => {
      _arity(args, 0);
      _expect(dst, ValueType.I32)
    },
    ConstBytes => {
      _arity(args, 0);
      _expect(dst, ValueType.Bytes);
      if (_inProgram && ((imm < 0) || (imm >= _poolSize))) { _fail("bytes constant out of range"); } null
    },
    ConstNull => {
      _arity(args, 0);
      _expect(dst, ValueType.Dynamic)
    },
    ConstFunction => {
      _arity(args, 0);

      match (_type(dst)) {
        Function(_, _) => null, _ => {
          _fail("function constant destination is not function typed");
          null
        }
      };
      if (_inProgram && !valueTypeEqual(_type(dst), _signature(imm))) { _fail("function constant signature mismatch"); }
      null
    },
    Move => {
      _arity(args, 1);
      if (!valueTypeEqual(_type(dst), _type(args[0]))) { _fail("move type mismatch"); } null
    },
    Add, Sub, Mul => {
      _arity(args, 2);
      if (!_isNumeric(_type(dst))) { _fail("arithmetic requires an integer type"); }
      _expect(args[0], _type(dst));
      _expect(args[1], _type(dst))
    },
    Neg => {
      _arity(args, 1);
      if (!_isNumeric(_type(dst))) { _fail("negation requires an integer type"); }
      _expect(args[0], _type(dst))
    },
    Not => {
      _arity(args, 1);
      _expect(dst, ValueType.Bool);
      _expect(args[0], ValueType.Bool)
    },
    Eq, Lt => {
      _arity(args, 2);
      _expect(dst, ValueType.Bool);
      if (!_isNumeric(_type(args[0]))) { _fail("comparison requires an integer type"); }
      _expect(args[1], _type(args[0]))
    },
    Sext => {
      _arity(args, 1);
      _expect(dst, ValueType.I64);
      _expect(args[0], ValueType.I32)
    },
    Trunc => {
      _arity(args, 1);
      _expect(dst, ValueType.I32);
      _expect(args[0], ValueType.I64)
    },
    Box => {
      _arity(args, 1);
      _expect(dst, ValueType.Dynamic)
    },
    IsNull => {
      _arity(args, 1);
      _expect(dst, ValueType.Bool);
      _expect(args[0], ValueType.Dynamic)
    },
    PhysEq => {
      _arity(args, 2);
      _expect(dst, ValueType.Bool)
    },
    ArrayNew => {
      _arity(args, 1);

      match (_type(dst)) {
        ArrayOf(_) => null, _ => {
          _fail("array.new defines a non-array");
          null
        }
      };
      _expect(args[0], ValueType.I32)
    },
    ArrayLen => {
      _arity(args, 1);
      _expect(dst, ValueType.I32);

      match (_type(args[0])) {
        ArrayOf(_) => null, _ => {
          _fail("array.len of a non-array");
          null
        }
      }
    },
    ArrayGet, ArraySet => {
      let get = match (opOf(instruction)) { ArrayGet => true, _ => false };
      _arity(args, get ? 2 : 3);

      match (_type(args[0])) {
        ArrayOf(element) => {
          _expect(args[1], ValueType.I32);
          _expect(get ? dst : args[2], element)
        },
        _ => {
          _fail("array access of a non-array");
          null
        },
      }
    },
    BytesGet => {
      _arity(args, 2);
      _expect(dst, ValueType.I32);
      _expect(args[0], ValueType.Bytes);
      _expect(args[1], ValueType.I32)
    },
    TupleNew => match (_type(dst)) {
      TupleOf(elements) => {
        _arity(args, elements.len() as I32);
        let j = 0;

        while (j < elements.len()) {
          _expect(args[j], elements[j]);
          j++;
        } null
      },
      _ => {
        _fail("tuple defines a non-tuple");
        null
      },
    },
    StructNew => {
      _arity(args, 0);

      match (_type(dst)) {
        TupleOf(_) => null, _ => {
          _fail("struct.new defines a non-tuple");
          null
        }
      }
    },
    TupleGet, StructSet => {
      let get = match (opOf(instruction)) { TupleGet => true, _ => false };
      _arity(args, get ? 1 : 2);

      match (_type(args[0])) {
        TupleOf(elements) => {
          if ((imm < 0) || (imm >= elements.len())) { _fail("tuple field index out of range"); }
          _expect(get ? dst : args[1], elements[imm])
        },
        _ => {
          _fail("tuple access of a non-tuple");
          null
        },
      }
    },
    EnumNew => match (_type(dst)) {
      Nominal(id) => {
        if (_inProgram) {
          let fields = _fields(id, imm);
          _arity(args, fields.len() as I32);
          let j = 0;

          while (j < fields.len()) {
            _expect(args[j], fields[j]);
            j++;
          }
        }
        null
      },
      _ => {
        _fail("enum construction destination is not nominal");
        null
      },
    },
    EnumTag => {
      _arity(args, 1);
      _expect(dst, ValueType.I32);

      match (_type(args[0])) {
        Nominal(_) => null, _ => {
          _fail("enum tag source is not nominal");
          null
        }
      }
    },
    EnumGet => {
      if ((args.len() != 1) && (args.len() != 2)) { _fail("wrong operand count"); }
      if (args.len() == 2) { _expect(args[1], ValueType.I32); }

      match (_type(args[0])) {
        Nominal(id) => { if (_inProgram && !_hasField(id, imm, _type(dst))) { _fail("enum payload type mismatch"); } null },
        _ => {
          _fail("enum payload source is not nominal");
          null
        },
      }
    },
    Call => { if (_inProgram) { match (_signature(imm)) { Function(params, result) => _call(params, result, dst, args, 0), _ => null }; } null },
    CallIndirect => {
      if (args.len() == 0) { _fail("indirect call without a callee"); }

      match (_type(args[0])) {
        Function(params, result) => _call(params, result, dst, args, 1),
        _ => {
          _fail("indirect call callee is not function typed");
          null
        },
      }
    },
    SpillPush => {
      _arity(args, 1);
      if ((imm < 0) || (imm >= 65536)) { _fail("spill slot out of range"); } null
    },
    GlobalGet => {
      _arity(args, 0);
      if (_inProgram) { _expect(dst, _global(imm)); } null
    },
    GlobalSet => {
      _arity(args, 1);
      if (_inProgram) { _expect(args[0], _global(imm)); } null
    },
    SpillPop => {
      _arity(args, 0);
      if ((imm < 0) || (imm >= 65536)) { _fail("spill slot out of range"); } null
    },
  };
  null
};

let _handlerTarget = fn(handler: ThrowHandler): I32 { match (handler) { Catch(target, _) => target } };
let _handlerPayload = fn(handler: ThrowHandler): I32 { match (handler) { Catch(_, payload) => payload } };

let _blockId = fn(block: BasicBlock): I32 { match (block) { Block(id, _, _, _) => id } };

let _blockIndexes = fn(blocks: Array<BasicBlock>): Array<I32> {
  let indexes = Array.new<I32>(0);
  let i = 0;

  while (i < blocks.len()) {
    let id = _blockId(blocks[i]);
    if (id < 0) { _fail("negative block id"); }
    while (indexes.len() <= id) { indexes.push(-1); }
    if (indexes[id] >= 0) { _fail("duplicate block id"); }
    indexes[id] = i;
    i++;
  }
  indexes
};

let _target = fn(indexes: Array<I32>, id: I32): I32 {
  if ((id < 0) || (id >= indexes.len()) || (indexes[id] < 0)) { _fail("unknown block: " + Std.string(id)); }
  indexes[id]
};

let _terminator = fn(result: ReturnType, indexes: Array<I32>, terminator: Terminator) {
  match (terminator) {
    Jump(target) => {
      _target(indexes, target);
      null
    },
    Branch(condition, thenTarget, elseTarget) => {
      _expect(condition, ValueType.Bool);
      _target(indexes, thenTarget);
      _target(indexes, elseTarget);
      null
    },
    ReturnVoid => { if (!returnTypeEqual(result, ReturnType.Void)) { _fail("value function returns void"); } null },
    ReturnValue(value) => match (result) {
      Void => {
        _fail("void function returns a value");
        null
      }, Value(expected) => _expect(value, expected)
    },
    Throw(value) => {
      _type(value);
      null
    },
    Unreachable => null,
  }
};

let _slot = fn(instruction: Instruction): I32 { match (opOf(instruction)) { SpillPush, SpillPop => immOf(instruction), _ => -1 } };

let _writes = fn(instruction: Instruction): Array<I32> {
  match (opOf(instruction)) { SpillPush => [(_registers.len() as I32) + immOf(instruction)], _ => dstOf(instruction) >= 0 ? [dstOf(instruction)] : Array.new<I32>(0) }
};

let _reads = fn(instruction: Instruction): Array<I32> {
  match (opOf(instruction)) { SpillPop => [(_registers.len() as I32) + immOf(instruction)], _ => argsOf(instruction) }
};

let _uses = fn(defined: Array<I32>, facts: Array<I32>) {
  let i = 0;

  while (i < facts.len()) {
    if (!bitsHas(defined, facts[i])) {
      if (facts[i] >= _registers.len()) { _fail("spill slot read before written: " + Std.string(facts[i] - (_registers.len() as I32))); }
      _fail("register used before definition: " + Std.string(facts[i]));
    }
    i++;
  }
  null
};

let _addAll = fn(set: Array<I32>, facts: Array<I32>) {
  let i = 0;

  while (i < facts.len()) {
    bitsAdd(set, facts[i]);
    i++;
  } null
};

let _terminatorUses = fn(terminator: Terminator): Array<I32> {
  match (terminator) { Branch(value, _, _), ReturnValue(value), Throw(value) => [value], _ => Array.new<I32>(0) }
};

let _definitions = fn(params: Array<I32>, blocks: Array<BasicBlock>, indexes: Array<I32>, entry: I32, slots: I32) {
  let count = (_registers.len() as I32) + slots;
  let normal = Array.new<Array<I32>>(0);
  let exceptional = Array.new<Array<I32>>(0);
  let handlers = Array.new<I32>(0);
  let i = 0;

  while (i < blocks.len()) {
    match (blocks[i]) { Block(_, instructions, terminator, handler) => {
      let all = bitsNew(count);
      let beforeThrow = bitsNew(count);
      let throwing = false;
      let j = 0;

      while (j < instructions.len()) {
        if (instructionMayThrow(instructions[j])) { throwing = true; }
        _addAll(all, _writes(instructions[j]));
        if (!throwing) { _addAll(beforeThrow, _writes(instructions[j])); }
        j++;
      }
      let throws = throwing || match (terminator) { Throw(_) => true, _ => false };
      let target = -1;

      if ((handler != null) && throws) {
        bitsAdd(beforeThrow, _handlerPayload(handler));
        target = _target(indexes, _handlerTarget(handler));
      }
      normal.push(all);
      exceptional.push(beforeThrow);
      handlers.push(target);
    } };
    i++;
  }
  let entryIndex = _target(indexes, entry);
  let inputs = Array.new<Array<I32>>(0);
  let reached = Array.new<Bool>(0);
  i = 0;

  while (i < blocks.len()) {
    inputs.push(bitsFull(count));
    reached.push(false);
    i++;
  }
  inputs[entryIndex] = bitsNew(count);
  reached[entryIndex] = true;
  i = 0;

  while (i < params.len()) {
    bitsAdd(inputs[entryIndex], params[i]);
    i++;
  }
  let changed = true;

  while (changed) {
    changed = false;
    i = 0;

    while (i < blocks.len()) {
      if (reached[i]) {
        match (blocks[i]) { Block(_, _, terminator, _) => {
          let out = bitsCopy(inputs[i]);
          bitsUnion(out, normal[i]);
          let successors = normalSuccessors(terminator);
          let s = 0;

          while (s <= successors.len()) {
            let target = s < successors.len() ? _target(indexes, successors[s]) : handlers[i];
            let edge = s < successors.len() ? out : bitsCopy(inputs[i]);
            if (s == successors.len()) { bitsUnion(edge, exceptional[i]); }

            if ((target >= 0) && (target != entryIndex)) {
              let next = bitsCopy(inputs[target]);

              if (!reached[target]) {
                next = bitsCopy(edge);
                reached[target] = true;
                changed = true;
              } else { bitsIntersect(next, edge); }

              if (!bitsEqual(next, inputs[target])) {
                inputs[target] = next;
                changed = true;
              }
            }
            s++;
          }
        } };
      }
      i++;
    }
  }
  i = 0;

  while (i < blocks.len()) {
    if (reached[i]) {
      match (blocks[i]) { Block(_, instructions, terminator, _) => {
        let defined = bitsCopy(inputs[i]);
        let j = 0;

        while (j < instructions.len()) {
          _uses(defined, _reads(instructions[j]));
          _addAll(defined, _writes(instructions[j]));
          j++;
        }
        _uses(defined, _terminatorUses(terminator));
      } };
    }
    i++;
  }
  null
};

let _function = fn(function: Function) {
  match (function) { Function(_, params, registers, result, blocks, entry) => {
    _registers = registers;
    if (blocks.len() == 0) { _fail("function has no blocks"); }
    let indexes = _blockIndexes(blocks);
    _target(indexes, entry);
    let i = 0;

    while (i < params.len()) {
      _type(params[i]);
      let j = 0;

      while (j < i) {
        if (params[i] == params[j]) { _fail("duplicate parameter register"); }
        j++;
      }
      i++;
    }
    let slotTypes = Array.new<ValueType>(0);
    i = 0;

    while (i < blocks.len()) {
      match (blocks[i]) { Block(id, instructions, terminator, handler) => {
        if (handler != null) {
          _target(indexes, _handlerTarget(handler));
          _expect(_handlerPayload(handler), ValueType.Dynamic);
          if (_handlerTarget(handler) == id) { _fail("block handles its own throw"); }
        }
        let j = 0;

        while (j < instructions.len()) {
          _instruction(instructions[j]);
          let slot = _slot(instructions[j]);

          if (slot >= 0) {
            let ty = match (opOf(instructions[j])) { SpillPush => _type(argsOf(instructions[j])[0]), _ => _type(dstOf(instructions[j])) };
            while (slotTypes.len() <= slot) { slotTypes.push(ty); }
            if (!valueTypeEqual(slotTypes[slot], ty)) { _fail("spill slot type mismatch"); }
          }
          j++;
        }
        _terminator(result, indexes, terminator);
      } };
      i++;
    }
    _definitions(params, blocks, indexes, entry, slotTypes.len() as I32);
  } };
  true
};

export let verifyFunction: (Function) -> Bool = fn(function) {
  _inProgram = false;
  _function(function)
};

let _signatureOf = fn(function: Function): ValueType {
  match (function) { Function(_, params, registers, result, _, _) => {
    let types = Array.new<ValueType>(0);
    let i = 0;

    while (i < params.len()) {
      types.push(registers[params[i]]);
      i++;
    }
    ValueType.Function(types, result)
  } }
};

export let verifyProgram: (Program) -> Bool = fn(program) {
  match (program) { Program(functions, pool, enums, globals) => {
    _functionIds = Array.new<I32>(0);
    _signatures = Array.new<ValueType>(0);
    let i = 0;

    while (i < functions.len()) {
      match (functions[i]) { Function(id, params, registers, _, _, _) => {
        let j = 0;

        while (j < _functionIds.len()) {
          if (_functionIds[j] == id) { _fail("duplicate function id"); }
          j++;
        }
        j = 0;

        while (j < params.len()) {
          if ((params[j] < 0) || (params[j] >= registers.len())) { _fail("parameter register out of range"); }
          j++;
        }
        _functionIds.push(id);
        _signatures.push(_signatureOf(functions[i]));
      } };
      i++;
    }
    _poolSize = pool.len() as I32;
    _enums = enums;
    _globals = globals;
    _inProgram = true;
    i = 0;

    while (i < functions.len()) {
      _function(functions[i]);
      i++;
    }
    _inProgram = false;
  } };
  true
};
