package ir;

import type { BasicBlock, EnumSchema, Function, Instruction, Native, Program, Terminator, ThrowHandler, ValueType } from ir.Model;
import { ValueType, argumentCount, comparesByIdentity, argsOf, canBeNull, dstOf, handlerPayload, handlerTarget, immOf, opOf, valueTypeEqual } from ir.Model;
import { blockId } from ir.Cfg;
import { liveness } from ir.Liveness;
import { internalError } from frontend.Internal;
import { indexOf } from std.core.Arrays;

let _fail = fn(message: Bytes): Bool {
  internalError("invalid IR: " + message);
  false
};

let _inProgram = false;
let _legalized = false;
let _functionIndexes = Array.new<I32>(0);
let _signatures = Array.new<ValueType>(0);
let _captureCounts = Array.new<I32>(0);
let _poolSize = 0;
let _wideCount = 0;
let _floatCount = 0;
let _atomCount = 0;
let _enums = Array.new<EnumSchema>(0);
let _globals = Array.new<ValueType>(0);
let _natives = Array.new<Native>(0);

let _registers = Array.new<ValueType>(0);

let _type = fn(register: I32): ValueType {
  if ((register < 0) || (register >= _registers.len())) { _fail("register out of range: " + Std.string(register)); }
  _registers[register]
};

let _expect = fn(register: I32, expected: ValueType) {
  if (!valueTypeEqual(_type(register), expected)) { _fail("wrong type for register " + Std.string(register)); }
  null
};

let _isNumeric = fn(ty: ValueType): Bool { match (ty) { I32, I64 => true, _ => false } };
let _isArithmetic = fn(ty: ValueType, half: Bool): Bool { match (ty) { I32, I64, F32, F64 => true, F16 => half, _ => false } };

let _converts = fn(source: ValueType, target: ValueType): Bool {
  match ((source, target)) {
    (I32, F16), (I32, F32), (I32, F64), (I64, F32), (I64, F64), (F16, I32), (F32, I32), (F64, I32), (F32, I64), (F64, I64) => true,
    (F16, F32), (F32, F16), (F32, F64), (F64, F32) => true,
    _ => false,
  }
};

let _index = fn(function: I32): I32 {
  if ((function < 0) || (function >= _functionIndexes.len()) || (_functionIndexes[function] < 0)) { _fail("unknown function @" + Std.string(function)); }
  _functionIndexes[function]
};

let _call = fn(params: Array<ValueType>, result: ValueType, dst: I32, args: Array<I32>, start: I32) {
  if ((args.len() as I32) - start != (params.len() as I32)) { _fail("call argument count mismatch"); }
  let i = 0;

  while (i < params.len()) {
    _expect(args[start + i], params[i]);
    i++;
  }
  _expect(dst, result)
};

let _fields = fn(enumId: I32, tag: I32): Array<ValueType> {
  if ((enumId < 0) || (enumId >= _enums.len())) { _fail("unknown enum type@" + Std.string(enumId)); }

  match (_enums[enumId]) { Enum(variants) => {
    if ((tag < 0) || (tag >= variants.len())) { _fail("enum tag out of range"); }
    variants[tag]
  } }
};

let _hasField = fn(enumId: I32, index: I32, ty: ValueType): Bool {
  if ((enumId < 0) || (enumId >= _enums.len())) { _fail("unknown enum type@" + Std.string(enumId)); }

  match (_enums[enumId]) { Enum(variants) => {
    let i = 0;

    while (i < variants.len()) {
      if ((index < variants[i].len()) && valueTypeEqual(variants[i][index], ty)) { return true; }
      i++;
    }
    false
  } }
};

let _global = fn(index: I32): ValueType {
  if ((index < 0) || (index >= _globals.len())) { _fail("global out of range"); }
  _globals[index]
};

let _arity = fn(args: Array<I32>, count: I32) { if (args.len() != count) { _fail("wrong operand count"); } null };

let _instruction = fn(instruction: Instruction) {
  let dst = dstOf(instruction);
  let args = argsOf(instruction);
  let imm = immOf(instruction);
  let i = 0;

  while (i < args.len()) {
    _type(args[i]);
    i++;
  }

  match (opOf(instruction)) {
    ArraySet, ArrayResize, BytesSet, BytesBlit, StructSet, SpillPush, GlobalSet, NullCheck => { if (dst >= 0) { _fail("store defines a register"); } null },
    _ => {
      _type(dst);
      null
    },
  };

  match (opOf(instruction)) {
    ConstBool => {
      _arity(args, 0);
      _expect(dst, ValueType.Bool);
      if ((imm != 0) && (imm != 1)) { _fail("bool constant out of range"); } null
    },
    ConstI32 => {
      _arity(args, 0);
      _expect(dst, ValueType.I32)
    },
    ConstI64 => {
      _arity(args, 0);
      _expect(dst, ValueType.I64);
      if (_inProgram && ((imm < 0) || (imm >= _wideCount))) { _fail("i64 constant out of range"); } null
    },
    ConstFloat => {
      _arity(args, 0);

      match (_type(dst)) {
        F64 => { if (_inProgram && ((imm < 0) || (imm >= _floatCount))) { _fail("f64 constant out of range"); } null },
        F32, F16 => null,
        _ => {
          _fail("float constant of a type that is no float");
          null
        },
      }
    },
    ConstBytes => {
      _arity(args, 0);
      _expect(dst, ValueType.Bytes);
      if (_inProgram && ((imm < 0) || (imm >= _poolSize))) { _fail("bytes constant out of range"); } null
    },
    ConstNull => {
      _arity(args, 0);
      if (!canBeNull(_type(dst))) { _fail("null constant of a type without null"); } null
    },
    ConstFunction => {
      match (_type(dst)) {
        Function(_, _) => null, _ => {
          _fail("function constant destination is not function typed");
          null
        }
      };
      i = 0;

      while (i < args.len()) {
        _expect(args[i], ValueType.Dynamic);
        i++;
      }

      if (_inProgram) {
        let callee = _index(imm);
        if (!valueTypeEqual(_type(dst), _signatures[callee])) { _fail("function constant signature mismatch"); }
        if (args.len() != _captureCounts[callee]) { _fail("closure capture count mismatch"); }
      }
      null
    },
    Move => {
      _arity(args, 1);
      if (!valueTypeEqual(_type(dst), _type(args[0]))) { _fail("move type mismatch"); } null
    },
    Add, Sub, Mul, Div, Rem, Shl, Shr, BitAnd, BitOr, BitXor, DivU, RemU => {
      _arity(args, 2);
      let numeric = match (opOf(instruction)) { Add, Sub, Mul => _isArithmetic(_type(dst), true), Div => _isArithmetic(_type(dst), false), _ => _isNumeric(_type(dst)) };
      if (!numeric) { _fail("arithmetic on a type that does not support it"); }
      _expect(args[0], _type(dst));
      _expect(args[1], _type(dst))
    },
    Neg => {
      _arity(args, 1);
      if (!_isArithmetic(_type(dst), false)) { _fail("negation of a type that does not support it"); }
      _expect(args[0], _type(dst))
    },
    AddImm, SubImm, MulImm => {
      _arity(args, 1);
      _expect(dst, ValueType.I32);
      _expect(args[0], ValueType.I32)
    },
    EqImm, LtImm => {
      _arity(args, 1);
      _expect(dst, ValueType.Bool);
      _expect(args[0], ValueType.I32)
    },
    Not => {
      _arity(args, 1);
      _expect(dst, ValueType.Bool);
      _expect(args[0], ValueType.Bool)
    },
    Eq, Lt, LtU => {
      _arity(args, 2);
      _expect(dst, ValueType.Bool);
      let ty = _type(args[0]);
      let compared = match (opOf(instruction)) { Eq when (comparesByIdentity(ty)) => true, LtU => _isNumeric(ty), _ => _isArithmetic(ty, false) };
      if (!compared) { _fail("comparison of a type that does not support it"); }
      _expect(args[1], ty)
    },
    Sext, Zext => {
      _arity(args, 1);
      _expect(dst, ValueType.I64);
      _expect(args[0], ValueType.I32)
    },
    Trunc => {
      _arity(args, 1);
      _expect(dst, ValueType.I32);
      _expect(args[0], ValueType.I64)
    },
    Convert => {
      _arity(args, 1);
      if (!_converts(_type(args[0]), _type(dst))) { _fail("conversion the VM lacks"); } null
    },
    Box => {
      _arity(args, 1);
      _expect(dst, ValueType.Dynamic)
    },
    Unbox => {
      _arity(args, 1);

      match (_type(dst)) {
        Dynamic => {
          _fail("unbox to Dynamic");
          null
        }, _ => null
      };
      _expect(args[0], ValueType.Dynamic)
    },
    KindOf => {
      _arity(args, 1);
      _expect(dst, ValueType.I32);
      _expect(args[0], ValueType.Dynamic)
    },
    IsEnum => {
      _arity(args, 1);
      _expect(dst, ValueType.Bool);
      _expect(args[0], ValueType.Dynamic);
      if (_inProgram && ((imm < 0) || (imm >= _enums.len()))) { _fail("enum test of an unknown enum"); }
      null
    },
    IsNull => {
      _arity(args, 1);
      _expect(dst, ValueType.Bool);
      if (!canBeNull(_type(args[0]))) { _fail("null test of a type without null"); } null
    },
    NullCheck => {
      _arity(args, 1);
      if (!canBeNull(_type(args[0]))) { _fail("null check of a type without null"); } null
    },
    ArrayNew => {
      _arity(args, 1);

      match (_type(dst)) {
        ArrayOf(_) => null, _ => {
          _fail("array.new defines a non-array");
          null
        }
      };
      _expect(args[0], ValueType.I32)
    },
    ArrayLen => {
      _arity(args, 1);
      _expect(dst, ValueType.I32);

      match (_type(args[0])) {
        ArrayOf(_) => null, _ => {
          _fail("array.len of a non-array");
          null
        }
      }
    },
    ArrayGet, ArraySet => {
      let get = match (opOf(instruction)) { ArrayGet => true, _ => false };
      _arity(args, get ? 2 : 3);

      match (_type(args[0])) {
        ArrayOf(element) => {
          _expect(args[1], ValueType.I32);
          _expect(get ? dst : args[2], element)
        },
        _ => {
          _fail("array access of a non-array");
          null
        },
      }
    },
    ArrayResize => {
      _arity(args, 2);

      match (_type(args[0])) {
        ArrayOf(_) => null, _ => {
          _fail("array.resize of a non-array");
          null
        }
      };
      _expect(args[1], ValueType.I32)
    },
    ArrayConcat => {
      _arity(args, 2);

      match (_type(dst)) {
        ArrayOf(_) => {
          _expect(args[0], _type(dst));
          _expect(args[1], _type(dst))
        }, _ => {
          _fail("array.concat defines a non-array");
          null
        }
      }
    },
    ListNil => {
      _arity(args, 0);

      match (_type(dst)) {
        ListOf(_) => null, _ => {
          _fail("list.nil defines a non-list");
          null
        }
      }
    },
    ListCons => {
      _arity(args, 2);

      match (_type(dst)) {
        ListOf(element) => {
          _expect(args[0], element);
          _expect(args[1], _type(dst))
        }, _ => {
          _fail("list.cons defines a non-list");
          null
        }
      }
    },
    ListHead, ListTail, ListIsNil => {
      _arity(args, 1);

      match (_type(args[0])) {
        ListOf(element) => match (opOf(instruction)) { ListHead => _expect(dst, element), ListTail => _expect(dst, _type(args[0])), _ => _expect(dst, ValueType.Bool) },
        _ => {
          _fail("list access of a non-list");
          null
        },
      }
    },
    BytesNew => {
      _arity(args, 1);
      _expect(dst, ValueType.Bytes);
      _expect(args[0], ValueType.I32)
    },
    BytesSet => {
      _arity(args, 3);
      _expect(args[0], ValueType.Bytes);
      _expect(args[1], ValueType.I32);
      _expect(args[2], ValueType.I32)
    },
    BytesBlit => {
      _arity(args, 3);
      _expect(args[0], ValueType.Bytes);
      _expect(args[1], ValueType.Bytes);
      _expect(args[2], ValueType.I32)
    },
    BytesGet => {
      _arity(args, 2);
      _expect(dst, ValueType.I32);
      _expect(args[0], ValueType.Bytes);
      _expect(args[1], ValueType.I32)
    },
    BytesLen => {
      _arity(args, 1);
      _expect(dst, ValueType.I32);
      _expect(args[0], ValueType.Bytes)
    },
    BytesSlice => {
      _arity(args, 3);
      _expect(dst, ValueType.Bytes);
      _expect(args[0], ValueType.Bytes);
      _expect(args[1], ValueType.I32);
      _expect(args[2], ValueType.I32)
    },
    BytesConcat => {
      _arity(args, 2);
      _expect(dst, ValueType.Bytes);
      _expect(args[0], ValueType.Bytes);
      _expect(args[1], ValueType.Bytes)
    },
    BytesEq => {
      _arity(args, 2);
      _expect(dst, ValueType.Bool);
      _expect(args[0], ValueType.Bytes);
      _expect(args[1], ValueType.Bytes)
    },
    TupleNew => if (_legalized) {
      _fail("tuple construction after legalization");
      null
    } else { match (_type(dst)) {
      TupleOf(elements) => {
        _arity(args, elements.len() as I32);
        let j = 0;

        while (j < elements.len()) {
          _expect(args[j], elements[j]);
          j++;
        } null
      },
      _ => {
        _fail("tuple defines a non-tuple");
        null
      },
    } },
    StructNew => {
      _arity(args, 0);

      match (_type(dst)) {
        TupleOf(_) => null, _ => {
          _fail("struct.new defines a non-tuple");
          null
        }
      }
    },
    TupleGet, StructSet => {
      let get = match (opOf(instruction)) { TupleGet => true, _ => false };
      _arity(args, get ? 1 : 2);

      match (_type(args[0])) {
        TupleOf(elements) => {
          if ((imm < 0) || (imm >= elements.len())) { _fail("tuple field index out of range"); }
          _expect(get ? dst : args[1], elements[imm])
        },
        _ => {
          _fail("tuple access of a non-tuple");
          null
        },
      }
    },
    EnumNew => match (_type(dst)) {
      Nominal(id) => {
        if (_inProgram) {
          let fields = _fields(id, imm);
          _arity(args, fields.len() as I32);
          let j = 0;

          while (j < fields.len()) {
            _expect(args[j], fields[j]);
            j++;
          }
        }
        null
      },
      _ => {
        _fail("enum construction destination is not nominal");
        null
      },
    },
    EnumTag => {
      _arity(args, 1);
      _expect(dst, ValueType.I32);

      match (_type(args[0])) {
        Nominal(_) => null, _ => {
          _fail("enum tag source is not nominal");
          null
        }
      }
    },
    EnumGet => {
      _arity(args, _legalized ? 2 : 1);
      if (_legalized) { _expect(args[1], ValueType.I32); }

      match (_type(args[0])) {
        Nominal(id) => { if (_inProgram && !_hasField(id, imm, _type(dst))) { _fail("enum payload type mismatch"); } null },
        _ => {
          _fail("enum payload source is not nominal");
          null
        },
      }
    },
    Call => {
      if (_inProgram) {
        let callee = _index(imm);
        if (_captureCounts[callee] != 0) { _fail("direct call of a function that captures"); }
        match (_signatures[callee]) { Function(params, result) => _call(params, result, dst, args, 0), _ => null };
      }
      null
    },
    CallNative => {
      if (_inProgram) {
        if ((imm < 0) || (imm >= _natives.len())) { _fail("native out of range"); }
        match (_natives[imm]) { Native(_, _, params, result) => _call(params, result, dst, args, 0) };
      }
      null
    },
    CallIndirect => {
      if (args.len() == 0) { _fail("indirect call without a callee"); }

      match (_type(args[0])) {
        Function(params, result) => _call(params, result, dst, args, 1),
        _ => {
          _fail("indirect call callee is not function typed");
          null
        },
      }
    },
    SpillPush => {
      _arity(args, 1);
      if ((imm < 0) || (imm >= 65536)) { _fail("spill slot out of range"); } null
    },
    GlobalGet => {
      _arity(args, 0);
      if (_inProgram) { _expect(dst, _global(imm)); } null
    },
    GlobalSet => {
      _arity(args, 1);
      if (_inProgram) { _expect(args[0], _global(imm)); } null
    },
    ConstAtom => {
      _arity(args, 0);
      _expect(dst, ValueType.Atom);
      if (_inProgram && ((imm < 0) || (imm >= _atomCount))) { _fail("atom constant out of range"); } null
    },
    SpillPop => {
      _arity(args, 0);
      if ((imm < 0) || (imm >= 65536)) { _fail("spill slot out of range"); } null
    },
  };
  null
};

let _blockHandler = fn(block: BasicBlock): ?ThrowHandler { match (block) { Block(_, _, _, handler) => handler } };

let _sameHandler = fn(a: ?ThrowHandler, b: ?ThrowHandler): Bool {
  if ((a == null) || (b == null)) { return (a == null) && (b == null); }
  (handlerTarget(a) == handlerTarget(b)) && (handlerPayload(a) == handlerPayload(b))
};

let _regions = fn(blocks: Array<BasicBlock>, indexes: Array<I32>, entry: I32) {
  if (_blockHandler(blocks[indexes[entry]]) != null) { _fail("entry block inside a try region"); }
  let i = 0;

  while (i < blocks.len()) {
    let handler = _blockHandler(blocks[i]);

    match (blocks[i]) { Block(_, _, terminator, _) => match (terminator) {
      Branch(_, thenTarget, elseTarget) => {
        let same = _sameHandler(handler, _blockHandler(blocks[indexes[thenTarget]])) && _sameHandler(handler, _blockHandler(blocks[indexes[elseTarget]]));
        if (!same) { _fail("branch into another try region"); }
        null
      },
      _ => null,
    } };
    let depth = 0;

    while (handler != null) {
      depth++;
      if (depth > 16) { _fail("try regions nested more than 16 deep"); }
      handler = _blockHandler(blocks[indexes[handlerTarget(handler)]]);
    }
    i++;
  }
  null
};

let _blockIndexes = fn(blocks: Array<BasicBlock>): Array<I32> {
  let indexes = Array.new<I32>(0);
  let i = 0;

  while (i < blocks.len()) {
    let id = blockId(blocks[i]);
    if (id < 0) { _fail("negative block id"); }
    while (indexes.len() <= id) { indexes.push(-1); }
    if (indexes[id] >= 0) { _fail("duplicate block id"); }
    indexes[id] = i;
    i++;
  }
  indexes
};

let _target = fn(indexes: Array<I32>, id: I32): I32 {
  if ((id < 0) || (id >= indexes.len()) || (indexes[id] < 0)) { _fail("unknown block: " + Std.string(id)); }
  indexes[id]
};

let _terminator = fn(result: ValueType, indexes: Array<I32>, terminator: Terminator) {
  match (terminator) {
    Jump(target) => {
      _target(indexes, target);
      null
    },
    Branch(condition, thenTarget, elseTarget) => {
      _expect(condition, ValueType.Bool);
      _target(indexes, thenTarget);
      _target(indexes, elseTarget);
      null
    },
    ReturnValue(value) => _expect(value, result),
    Throw(value, _) => { if (_legalized) { _expect(value, ValueType.Dynamic); } else { _type(value); } null },
  }
};

let _slot = fn(instruction: Instruction): I32 { match (opOf(instruction)) { SpillPush, SpillPop => immOf(instruction), _ => -1 } };

let _definitions = fn(params: Array<I32>, blocks: Array<BasicBlock>, indexes: Array<I32>, entry: I32, slots: I32) {
  let registers = _registers.len() as I32;
  let (liveIn, _) = liveness(blocks, registers, slots, false);
  let live = liveIn[_target(indexes, entry)];
  let first = -1;
  let i = 0;

  while (i < live.len()) {
    let p = 0;
    while ((p < params.len()) && (params[p] != live[i])) { p++; }
    if ((p == params.len()) && ((first < 0) || (live[i] < first))) { first = live[i]; }
    i++;
  }
  if (first >= registers) { _fail("spill slot read before written: " + Std.string(first - registers)); }
  if (first >= 0) { _fail("register used before definition: " + Std.string(first)); }
  null
};

let _function = fn(function: Function) {
  match (function) { Function(_, params, captures, registers, result, blocks, entry) => {
    _registers = registers;
    if (blocks.len() == 0) { _fail("function has no blocks"); }
    if ((captures < 0) || (captures > params.len())) { _fail("capture count out of range"); }
    let indexes = _blockIndexes(blocks);
    _target(indexes, entry);
    let i = 0;

    while (i < params.len()) {
      if (i >= argumentCount(function)) { _expect(params[i], ValueType.Dynamic); } else { _type(params[i]); }
      if (indexOf(params, params[i]) < i) { _fail("duplicate parameter register"); }
      i++;
    }
    let slotTypes = Array.new<ValueType>(0);
    let seen = Array.new<Bool>(0);
    i = 0;

    while (i < blocks.len()) {
      match (blocks[i]) { Block(id, instructions, terminator, handler) => {
        if (handler != null) {
          _target(indexes, handlerTarget(handler));
          _expect(handlerPayload(handler), ValueType.Dynamic);
          if (handlerTarget(handler) == id) { _fail("block handles its own throw"); }
        }
        let j = 0;

        while (j < instructions.len()) {
          _instruction(instructions[j]);
          let slot = _slot(instructions[j]);

          if (slot >= 0) {
            let ty = match (opOf(instructions[j])) { SpillPush => _type(argsOf(instructions[j])[0]), _ => _type(dstOf(instructions[j])) };

            while (slotTypes.len() <= slot) {
              slotTypes.push(ty);
              seen.push(false);
            }

            if (!seen[slot]) {
              slotTypes[slot] = ty;
              seen[slot] = true;
            }
            if (!valueTypeEqual(slotTypes[slot], ty)) { _fail("spill slot type mismatch"); }
          }
          j++;
        }
        _terminator(result, indexes, terminator);
      } };
      i++;
    }
    _regions(blocks, indexes, entry);
    _definitions(params, blocks, indexes, entry, slotTypes.len() as I32);
  } };
  true
};

export let verifyFunction: (Function) -> Bool = fn(function) {
  _inProgram = false;
  _legalized = false;
  _function(function)
};

let _signatureOf = fn(function: Function): ValueType {
  match (function) { Function(_, params, captures, registers, result, _, _) => {
    let types = Array.new<ValueType>(0);
    let i = 0;

    while (i < argumentCount(function)) {
      types.push(registers[params[i]]);
      i++;
    }
    ValueType.Function(types, result)
  } }
};

let _program = fn(program: Program, legalized: Bool): Bool {
  _legalized = legalized;

  match (program) { Program(functions, pool, wides, floats, atoms, enums, globals, natives) => {
    _functionIndexes = Array.new<I32>(0);
    _signatures = Array.new<ValueType>(0);
    _captureCounts = Array.new<I32>(0);
    let i = 0;

    while (i < functions.len()) {
      match (functions[i]) { Function(id, params, captures, registers, _, _, _) => {
        if (id < 0) { _fail("negative function id"); }
        while (_functionIndexes.len() <= id) { _functionIndexes.push(-1); }
        if (_functionIndexes[id] >= 0) { _fail("duplicate function id"); }
        _functionIndexes[id] = i as I32;
        let j = 0;

        while (j < params.len()) {
          if ((params[j] < 0) || (params[j] >= registers.len())) { _fail("parameter register out of range"); }
          j++;
        }
        _signatures.push(_signatureOf(functions[i]));
        _captureCounts.push(captures);
      } };
      i++;
    }
    _poolSize = pool.len() as I32;
    _wideCount = wides.len() as I32;
    _floatCount = floats.len() as I32;
    _atomCount = atoms.len() as I32;
    _enums = enums;
    _globals = globals;
    _natives = natives;
    _inProgram = true;
    i = 0;

    while (i < functions.len()) {
      _function(functions[i]);
      i++;
    }
    _inProgram = false;
  } };
  true
};

export let verifyProgram: (Program) -> Bool = fn(program) { _program(program, false) };
export let verifyLegalizedProgram: (Program) -> Bool = fn(program) { _program(program, true) };

export let verifyAllocatedProgram: (Program) -> Bool = fn(program) {
  match (program) { Program(functions, _, _, _, _, _, _, natives) => {
    let i = 0;

    while (i < functions.len()) {
      match (functions[i]) { Function(id, _, _, registers, _, _, _) => {
        if (registers.len() > 256) { _fail("function @" + Std.string(id) + " uses " + Std.string(registers.len()) + " registers; JLO allows 256"); }
      } };
      i++;
    }
    i = 0;

    while (i < natives.len()) {
      match (natives[i]) { Native(_, name, params, _) => { if (params.len() > 8) { _fail("native " + name + " takes more than 8 arguments"); } null } };
      i++;
    }
  } };
  verifyLegalizedProgram(program)
};
