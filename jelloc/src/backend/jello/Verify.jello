package backend.jello;

import type { ReturnType, Terminator, ValueType } from ir.Model;
import type { Block, Function, Instruction, Program } from backend.jello.Model;

let _typeEq = fn(left: ValueType, right: ValueType): Bool {
  match (left) {
    Bool => match (right) { Bool => true, _ => false },
    I32 => match (right) { I32 => true, _ => false },
    I64 => match (right) { I64 => true, _ => false },
    Dynamic => match (right) { Dynamic => true, _ => false },
    _ => false,
  }
};

let _typeName = fn(ty: ValueType): Bytes {
  match (ty) { Bool => "bool", I32 => "i32", I64 => "i64", Dynamic => "dynamic", _ => "unsupported" }
};

let _registerType = fn(registers: Array<ValueType>, id: I32): ValueType {
  if ((id < 0) || (id >= registers.len())) {
    throw "invalid JLO: register out of range";
    return ValueType.Bool;
  }
  registers[id]
};

let _expect = fn(registers: Array<ValueType>, id: I32, ty: ValueType) {
  let actual = _registerType(registers, id);

  if (!_typeEq(actual, ty)) {
    throw "invalid JLO: register " + Std.string(id) + " type mismatch: expected " + _typeName(ty)
      + ", got " + _typeName(actual);
  }
  null
};

let _hasBlock = fn(blocks: Array<Block>, id: I32): Bool {
  let i = 0;

  while (i < blocks.len()) {
    match (blocks[i]) { Block(blockId, _, _) => if (blockId == id) { return true; } };
    i++;
  }
  false
};

let _layoutTypeCompatible = fn(left: ValueType, right: ValueType): Bool {
  let compatible = _typeEq(left, right);
  if (!compatible) { compatible = match (left) { Dynamic => match (right) { I64 => true, _ => false }, _ => false }; }
  compatible
};

let _instruction = fn(registers: Array<ValueType>, instruction: Instruction) {
  match (instruction) {
    ConstBool(dst, _) => _expect(registers, dst, ValueType.Bool),
    ConstI32(dst, _) => _expect(registers, dst, ValueType.I32),
    Move(dst, src) => {
      let dstType = _registerType(registers, dst);
      let srcType = _registerType(registers, src);

      if (!_typeEq(dstType, srcType) && !_typeEq(dstType, ValueType.Dynamic)) {
        throw "invalid JLO: move type mismatch";
      }
      null
    },
    AddI32(dst, left, right) => {
      _expect(registers, dst, ValueType.I32);
      _expect(registers, left, ValueType.I32);
      _expect(registers, right, ValueType.I32);
    },
    SubI32(dst, left, right) => {
      _expect(registers, dst, ValueType.I32);
      _expect(registers, left, ValueType.I32);
      _expect(registers, right, ValueType.I32);
    },
    MultiplyI32(dst, left, right) => {
      _expect(registers, dst, ValueType.I32);
      _expect(registers, left, ValueType.I32);
      _expect(registers, right, ValueType.I32);
    },
    NegateI32(dst, src) => {
      _expect(registers, dst, ValueType.I32);
      _expect(registers, src, ValueType.I32);
    },
    NotBool(dst, src) => {
      _expect(registers, dst, ValueType.Bool);
      _expect(registers, src, ValueType.Bool);
    },
    EqualI32(dst, left, right) => {
      _expect(registers, dst, ValueType.Bool);
      _expect(registers, left, ValueType.I32);
      _expect(registers, right, ValueType.I32);
    },
    LessI32Signed(dst, left, right) => {
      _expect(registers, dst, ValueType.Bool);
      _expect(registers, left, ValueType.I32);
      _expect(registers, right, ValueType.I32);
    },
    SignExtendI32ToI64(dst, src) => {
      _expect(registers, dst, ValueType.I64);
      _expect(registers, src, ValueType.I32);
    },
    TruncateI64ToI32(dst, src) => {
      _expect(registers, dst, ValueType.I32);
      _expect(registers, src, ValueType.I64);
    },
    Call(dst, _, args) => {
      _registerType(registers, dst);
      let i = 0;

      while (i < args.len()) {
        _registerType(registers, args[i]);
        i++;
      }
      null
    },
    SpillPush(src, slot) => {
      _registerType(registers, src);
      if (slot < 0) { throw "invalid JLO: negative spill slot"; } null
    },
    SpillPop(dst, slot) => {
      _registerType(registers, dst);
      if (slot < 0) { throw "invalid JLO: negative spill slot"; } null
    },
  }
};

let _terminator = fn(registers: Array<ValueType>, result: ReturnType, blocks: Array<Block>, terminator: Terminator) {
  match (terminator) {
    Jump(target) => if (!_hasBlock(blocks, target)) { throw "invalid JLO: unknown jump target"; },
    Branch(condition, thenTarget, elseTarget) => {
      _expect(registers, condition, ValueType.Bool);
      if (!_hasBlock(blocks, thenTarget) || !_hasBlock(blocks, elseTarget)) { throw "invalid JLO: unknown branch target"; }
    },
    ReturnVoid => match (result) {
      Void => null, _ => {
        throw "invalid JLO: value function returns void";
        null
      }
    },
    ReturnValue(value) => match (result) {
      Value(ty) => _expect(registers, value, ty),
      _ => {
        throw "invalid JLO: void function returns value";
        null
      },
    },
    Throw(value) => _expect(registers, value, ValueType.Dynamic),
    Unreachable => null,
  }
};

let _function = fn(function: Function) {
  match (function) {
    Function(_, params, registers, result, blocks, entry) => {
      if (!_hasBlock(blocks, entry)) { throw "invalid JLO: unknown entry block"; }
      let i = 0;

      while (i < params.len()) {
        _registerType(registers, params[i]);
        i++;
      }
      i = 0;

      while (i < blocks.len()) {
        match (blocks[i]) {
          Block(id, instructions, terminator) => {
            let j = 0;

            while (j < i) {
              match (blocks[j]) { Block(previous, _, _) => if (id == previous) { throw "invalid JLO: duplicate block"; } };
              j++;
            }
            j = 0;

            while (j < instructions.len()) {
              _instruction(registers, instructions[j]);
              j++;
            }
            _terminator(registers, result, blocks, terminator);
          },
        };
        i++;
      }
    },
  }
};

export let verifyFinalJloFunction: (
  Function,
  Array<Function>,
  Array<ValueType>,
  I32,
  I32,
  Array<I32>,
  Array<I32>,
  I32
) -> Bool = fn(function, functions, physicalRegisters, scratchStart, scratchSize, blockIds, blockPcs, instructionCount) {
  match (function) {
    Function(_, params, sourceRegisters, result, blocks, entry) => {
      if (physicalRegisters.len() > 256) { throw "invalid final JLO: exceeds 256 physical registers"; }

      if ((scratchStart < 0) || (scratchSize < 0) || (scratchStart + scratchSize != physicalRegisters.len())) {
        throw "invalid final JLO: non-contiguous scratch window";
      }
      let i = 0;

      while (i < params.len()) {
        if (params[i] != i) { throw "invalid final JLO: parameters must be first"; }
        i++;
      }
      i = 0;

      while (i < physicalRegisters.len()) {
        match (physicalRegisters[i]) {
          Bool => null,
          I32 => null,
          I64 => null,
          Dynamic => null,
          _ => {
            throw "invalid final JLO: unsupported physical register type";
            null
          },
        };
        i++;
      }

      if ((blockIds.len() != blocks.len()) || (blockPcs.len() != blocks.len())) {
        throw "invalid final JLO: incomplete block layout";
      }

      let expectedPc = 0;
      i = 0;

      while (i < blocks.len()) {
        let found = false;
        let j = 0;

        while (j < blocks.len()) {
          match (blocks[j]) { Block(id, _, _) => if (id == blockIds[i]) { found = true; } };
          j++;
        }
        if (!found || (blockPcs[i] != expectedPc)) { throw "invalid final JLO: malformed block layout"; }
        match (blocks[i]) { Block(_, _, _) => null };
        let ordered = 0;

        while (ordered < blocks.len()) {
          match (blocks[ordered]) {
            Block(id, instructions, terminator) => if (id == blockIds[i]) {
              j = 0;

              while (j < instructions.len()) {
                _instruction(physicalRegisters, instructions[j]);
                expectedPc += match (instructions[j]) {
                  Call(dst, callee, args) => {
                    if (args.len() > scratchSize) { throw "invalid final JLO: call exceeds scratch window"; }
                    let calleeFound = false;
                    let n = 0;

                    while (n < functions.len()) {
                      match (functions[n]) {
                        Function(calleeId, calleeParams, calleeRegisters, calleeResult, _, _) => if (calleeId == callee) {
                          calleeFound = true;
                          if (args.len() != calleeParams.len()) { throw "invalid final JLO: call argument count mismatch"; }
                          let a = 0;

                          while (a < args.len()) {
                            if ((calleeParams[a] != a) || (args[a] != args[0] + a)
                              || (args[a] < scratchStart) || (args[a] >= scratchStart + scratchSize)
                              || !_typeEq(_registerType(sourceRegisters, args[a]), _registerType(calleeRegisters, calleeParams[a]))
                              || !_layoutTypeCompatible(physicalRegisters[args[a]], _registerType(sourceRegisters, args[a]))) {
                              throw "invalid final JLO: call argument layout mismatch";
                            }
                            a++;
                          }

                          match (calleeResult) {
                            Value(ty) => if (!_typeEq(_registerType(sourceRegisters, dst), ty)) {
                              throw "invalid final JLO: call result type mismatch";
                            },
                            _ => {
                              throw "invalid final JLO: value call targets void function";
                              null
                            },
                          };
                        },
                      };
                      n++;
                    }
                    if (!calleeFound) { throw "invalid final JLO: unknown callee"; }
                    1
                  },
                  _ => 1,
                };
                j++;
              }
              expectedPc += match (terminator) {
                Branch(condition, thenTarget, elseTarget) => {
                  _expect(physicalRegisters, condition, ValueType.Bool);
                  if (!_hasBlock(blocks, thenTarget) || !_hasBlock(blocks, elseTarget)) { throw "invalid final JLO: unknown branch target"; }
                  2
                },
                Jump(target) => { if (!_hasBlock(blocks, target)) { throw "invalid final JLO: unknown jump target"; } 1 },
                ReturnValue(value) => {
                  match (result) {
                    Value(ty) => _expect(physicalRegisters, value, ty), _ => {
                      throw "invalid final JLO: unsupported return";
                      null
                    }
                  };
                  1
                },
                Throw(value) => {
                  _expect(physicalRegisters, value, ValueType.Dynamic);
                  1
                },
                _ => {
                  throw "invalid final JLO: unsupported terminator";
                  0
                },
              };
            },
          };
          ordered++;
        }
        i++;
      }

      if ((blockIds.len() == 0) || (blockIds[0] != entry) || (expectedPc != instructionCount)) {
        throw "invalid final JLO: instruction count mismatch";
      }
    },
  };
  true
};

export let verifyJlo: (Program) -> Bool = fn(program) {
  match (program) {
    Program(functions) => {
      let i = 0;

      while (i < functions.len()) {
        let id = match (functions[i]) { Function(functionId, _, _, _, _, _) => functionId };
        let j = 0;

        while (j < i) {
          match (functions[j]) { Function(previous, _, _, _, _, _) => if (id == previous) { throw "invalid JLO: duplicate function"; } };
          j++;
        }
        _function(functions[i]);
        i++;
      }
      i = 0;

      while (i < functions.len()) {
        match (functions[i]) {
          Function(_, _, registers, _, blocks, _) => {
            let j = 0;

            while (j < blocks.len()) {
              match (blocks[j]) {
                Block(_, instructions, _) => {
                  let k = 0;

                  while (k < instructions.len()) {
                    match (instructions[k]) {
                      Call(dst, callee, args) => {
                        let found = false;
                        let n = 0;

                        while (n < functions.len()) {
                          match (functions[n]) {
                            Function(id, params, calleeRegisters, result, _, _) => if (id == callee) {
                              found = true;
                              if (args.len() != params.len()) { throw "invalid JLO: call argument count mismatch"; }
                              let a = 0;

                              while (a < args.len()) {
                                if (!_typeEq(_registerType(registers, args[a]), _registerType(calleeRegisters, params[a]))) {
                                  throw "invalid JLO: call argument type mismatch";
                                }
                                a++;
                              }

                              match (result) {
                                Value(ty) => if (!_typeEq(_registerType(registers, dst), ty)) { throw "invalid JLO: call result type mismatch"; },
                                _ => {
                                  throw "invalid JLO: value call targets void function";
                                  null
                                },
                              };
                            },
                          };
                          n++;
                        }
                        if (!found) { throw "invalid JLO: unknown callee"; }
                      },
                      _ => null,
                    };
                    k++;
                  }
                },
              };
              j++;
            }
          },
        };
        i++;
      }
    },
  };
  true
};
