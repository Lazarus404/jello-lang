package backend.jello;

import type { BasicBlock, Function, Instruction, Program, Terminator, ThrowHandler, ValueType } from ir.Model;
import { BasicBlock, Function, Op, Program, Terminator, ThrowHandler, argsOf, dstOf, handlerPayload, handlerTarget, immOf, instruction, opOf, valueTypeEqual } from ir.Model;
import { blockMayThrow, normalSuccessors } from ir.Cfg;
import { bitsAdd, bitsCopy, bitsHas, bitsNew, bitsRemove, bitsUnion } from ir.Bits;
import { verifyAllocatedProgram } from ir.Verify;

let _REGISTER_LIMIT = 256;

let _keyTypes = Array.new<ValueType>(0);
let _keys = Array.new<I32>(0);

let _key = fn(ty: ValueType): I32 {
  let i = 0;

  while (i < _keyTypes.len()) {
    if (valueTypeEqual(_keyTypes[i], ty)) { return i; }
    i++;
  }
  _keyTypes.push(ty);
  (_keyTypes.len() - 1) as I32
};

let _windowStart = fn(op: Op): I32 { match (op) { Call, CallNative, EnumNew => 0, CallIndirect, BytesSlice => 1, _ => -1 } };

let _blockIndexes = fn(blocks: Array<BasicBlock>): Array<I32> {
  let indexes = Array.new<I32>(0);
  let i = 0;

  while (i < blocks.len()) {
    match (blocks[i]) {
      Block(id, _, _, _) => {
        while (indexes.len() <= id) { indexes.push(-1); }
        indexes[id] = i;
        null
      }
    };
    i++;
  }
  indexes
};

let _terminatorUses = fn(terminator: Terminator): Array<I32> {
  match (terminator) { Branch(value, _, _), ReturnValue(value), Throw(value) => [value], _ => Array.new<I32>(0) }
};

let _catch = fn(block: BasicBlock, indexes: Array<I32>): Tuple<I32, I32> {
  match (block) { Block(_, instructions, terminator, handler) => {
    if ((handler == null) || !blockMayThrow(instructions, terminator)) { return (-1, -1); }
    (indexes[handlerTarget(handler)], handlerPayload(handler))
  } }
};

let _caught = fn(liveIn: Array<Array<I32>>, c: Tuple<I32, I32>): Array<I32> {
  let (target, payload) = c;
  let caught = bitsCopy(liveIn[target]);
  bitsRemove(caught, payload);
  caught
};

let _liveness = fn(blocks: Array<BasicBlock>, count: I32): Tuple<Array<Array<I32>>, Array<Array<I32>>> {
  let indexes = _blockIndexes(blocks);
  let uses = Array.new<Array<I32>>(0);
  let defs = Array.new<Array<I32>>(0);
  let liveIn = Array.new<Array<I32>>(0);
  let liveOut = Array.new<Array<I32>>(0);
  let successors = Array.new<Array<I32>>(0);
  let i = 0;

  while (i < blocks.len()) {
    let used = bitsNew(count);
    let defined = bitsNew(count);

    match (blocks[i]) { Block(_, instructions, terminator, _) => {
      let j = 0;

      while (j < instructions.len()) {
        let args = argsOf(instructions[j]);
        let a = 0;

        while (a < args.len()) {
          if (!bitsHas(defined, args[a])) { bitsAdd(used, args[a]); }
          a++;
        }
        if (dstOf(instructions[j]) >= 0) { bitsAdd(defined, dstOf(instructions[j])); }
        j++;
      }
      let last = _terminatorUses(terminator);
      let a = 0;

      while (a < last.len()) {
        if (!bitsHas(defined, last[a])) { bitsAdd(used, last[a]); }
        a++;
      }
      let targets = normalSuccessors(terminator);
      let indexed = Array.new<I32>(0);
      a = 0;

      while (a < targets.len()) {
        indexed.push(indexes[targets[a]]);
        a++;
      }
      successors.push(indexed);
    } };
    uses.push(used);
    defs.push(defined);
    liveIn.push(bitsNew(count));
    liveOut.push(bitsNew(count));
    i++;
  }
  let none = bitsNew(count);
  let changed = true;

  while (changed) {
    changed = false;
    i = blocks.len() - 1;

    while (i >= 0) {
      let out = liveOut[i];
      let s = 0;

      while (s < successors[i].len()) {
        let into = liveIn[successors[i][s]];
        let w = 0;

        while (w < out.len()) {
          out[w] = out[w] | into[w];
          w++;
        }
        s++;
      }
      let c = _catch(blocks[i], indexes);
      let (target, _) = c;
      let caught = target >= 0 ? _caught(liveIn, c) : none;
      bitsUnion(out, caught);
      let w = 0;

      while (w < out.len()) {
        let next = uses[i][w] | (out[w] & (defs[i][w] ^ -1)) | caught[w];

        if (next != liveIn[i][w]) {
          liveIn[i][w] = next;
          changed = true;
        }
        w++;
      }
      i--;
    }
  }
  (liveIn, liveOut)
};

let _interference = fn(blocks: Array<BasicBlock>, count: I32): Array<Array<I32>> {
  let indexes = _blockIndexes(blocks);
  let (liveIn, liveOut) = _liveness(blocks, count);
  let neighbors = Array.new<Array<I32>>(0);
  let i = 0;

  while (i < count) {
    neighbors.push(Array.new<I32>(0));
    i++;
  }
  let payloadsDone = Array.new<Bool>(blocks.len());
  i = 0;

  while (i < blocks.len()) {
    payloadsDone[i] = false;
    i++;
  }
  i = 0;

  while (i < blocks.len()) {
    let c = _catch(blocks[i], indexes);
    let (target, payload) = c;
    let caught = target >= 0 ? _caught(liveIn, c) : bitsNew(count);

    if ((target >= 0) && !payloadsDone[target]) {
      payloadsDone[target] = true;
      let other = 0;

      while (other < count) {
        if (bitsHas(caught, other)) {
          neighbors[payload].push(other);
          neighbors[other].push(payload);
        }
        other++;
      }
    }

    match (blocks[i]) { Block(_, instructions, terminator, _) => {
      let live = bitsCopy(liveOut[i]);
      let last = _terminatorUses(terminator);
      let a = 0;

      while (a < last.len()) {
        bitsAdd(live, last[a]);
        a++;
      }
      let j = instructions.len() - 1;

      while (j >= 0) {
        let dst = dstOf(instructions[j]);

        if (dst >= 0) {
          let w = 0;

          while (w < live.len()) {
            let word = live[w];

            if (word != 0) {
              let bit = 0;

              while (bit < 32) {
                let other = (w << 5) + bit;

                if ((((word >> bit) & 1) == 1) && (other != dst)) {
                  neighbors[dst].push(other);
                  neighbors[other].push(dst);
                }
                bit++;
              }
            }
            w++;
          }
          bitsRemove(live, dst);
        }
        let args = argsOf(instructions[j]);
        a = 0;

        while (a < args.len()) {
          bitsAdd(live, args[a]);
          a++;
        }
        bitsUnion(live, caught);
        j--;
      }
    } };
    i++;
  }
  neighbors
};

let _color = fn(params: Array<I32>, first: Array<I32>, neighbors: Array<Array<I32>>, limit: I32): Array<I32> {
  let count = _keys.len();
  let colors = Array.new<I32>(count);
  let colorKeys = Array.new<I32>(limit);
  let marks = Array.new<I32>(limit);
  let i = 0;

  while (i < count) {
    colors[i] = -1;
    i++;
  }
  i = 0;

  while (i < limit) {
    colorKeys[i] = -1;
    marks[i] = -1;
    i++;
  }
  i = 0;

  while (i < params.len()) {
    colors[params[i]] = i;
    colorKeys[i] = _keys[params[i]];
    i++;
  }
  let k = 0;

  while (k < first.len() + count) {
    i = k < first.len() ? first[k] : k - (first.len() as I32);

    if (colors[i] < 0) {
      let n = 0;

      while (n < neighbors[i].len()) {
        let color = colors[neighbors[i][n]];
        if (color >= 0) { marks[color] = i; }
        n++;
      }
      let color = 0;
      while ((color < limit) && ((marks[color] == i) || ((colorKeys[color] >= 0) && (colorKeys[color] != _keys[i])))) { color++; }

      if (color < limit) {
        colors[i] = color;
        colorKeys[color] = _keys[i];
      }
    }
    k++;
  }
  colors
};

let _scratchOffset = fn(scratch: Array<I32>, args: Array<I32>, start: I32): I32 {
  let size = (args.len() as I32) - start;
  let offset = 0;

  while (offset + size <= scratch.len()) {
    let i = 0;
    while ((i < size) && (scratch[offset + i] == _keys[args[start + i]])) { i++; }
    if (i == size) { return offset; }
    offset++;
  }
  -1
};

let _colors = Array.new<I32>(0);
let _tempStart = 0;
let _tempOffsets = Array.new<I32>(0);
let _nextTemp = Array.new<I32>(0);
let _scratch = Array.new<I32>(0);
let _scratchStart = 0;
let _out = Array.new<Instruction>(0);

let _emit = fn(op: Op, dst: I32, args: Array<I32>, imm: I32) {
  _out.push(instruction(op, dst, args, imm));
  null
};

let _read = fn(register: I32): I32 {
  if (_colors[register] >= 0) { return _colors[register]; }
  let key = _keys[register];
  let temp = _tempStart + _tempOffsets[key] + _nextTemp[key];
  _nextTemp[key]++;
  _emit(Op.SpillPop, temp, Array.new<I32>(0), register);
  temp
};

let _write = fn(register: I32): I32 { _colors[register] >= 0 ? _colors[register] : _tempStart + _tempOffsets[_keys[register]] };

let _written = fn(register: I32, physical: I32) { if (_colors[register] < 0) { _emit(Op.SpillPush, -1, [physical], register); } null };

let _resetTemps = fn() {
  let i = 0;

  while (i < _nextTemp.len()) {
    _nextTemp[i] = 0;
    i++;
  } null
};

let _rewrite = fn(insn: Instruction) {
  _resetTemps();
  let op = opOf(insn);
  let dst = dstOf(insn);
  let args = argsOf(insn);
  let start = _windowStart(op);
  let physical = Array.new<I32>(0);

  if (start >= 0) {
    let window = _scratchStart + _scratchOffset(_scratch, args, start);
    let i = 0;

    while (i < start) {
      physical.push(_read(args[i]));
      i++;
    }

    while (i < args.len()) {
      let slot = window + i - start;
      if (_colors[args[i]] >= 0) { _emit(Op.Move, slot, [_colors[args[i]]], 0); } else { _emit(Op.SpillPop, slot, Array.new<I32>(0), args[i]); }
      physical.push(slot);
      i++;
    }
  } else {
    let i = 0;

    while (i < args.len()) {
      physical.push(_read(args[i]));
      i++;
    }
  }

  if (dst < 0) {
    _emit(op, -1, physical, immOf(insn));
    return null;
  }
  let target = match (op) { Move => _colors[dst] >= 0 ? _colors[dst] : physical[0], _ => _write(dst) };
  let redundant = match (op) { Move => target == physical[0], _ => false };
  if (!redundant) { _emit(op, target, physical, immOf(insn)); }
  _written(dst, target)
};

let _rewriteBlock = fn(block: BasicBlock): BasicBlock {
  match (block) { Block(id, instructions, terminator, handler) => {
    _out = Array.new<Instruction>(0);
    let i = 0;

    while (i < instructions.len()) {
      _rewrite(instructions[i]);
      i++;
    }
    _resetTemps();

    let allocated = match (terminator) {
      Branch(value, thenTarget, elseTarget) => Terminator.Branch(_read(value), thenTarget, elseTarget),
      ReturnValue(value) => Terminator.ReturnValue(_read(value)),
      Throw(value) => Terminator.Throw(_read(value)),
      _ => terminator,
    };
    let caught: ?ThrowHandler = null;
    if (handler != null) { caught = ThrowHandler.Catch(handlerTarget(handler), _colors[handlerPayload(handler)]); }
    BasicBlock.Block(id, _out, allocated, caught)
  } }
};

let _tooMany = fn(id: I32) {
  throw "function @" + Std.string(id) + " needs more than 256 registers; split it into smaller functions";
  null
};

let _allocate = fn(function: Function): Function {
  match (function) { Function(id, params, registers, result, blocks, entry) => {
    _keyTypes = Array.new<ValueType>(0);
    _keys = Array.new<I32>(0);
    let i = 0;

    while (i < registers.len()) {
      _keys.push(_key(registers[i]));
      i++;
    }
    _scratch = Array.new<I32>(0);
    i = 0;

    while (i < blocks.len()) {
      match (blocks[i]) { Block(_, instructions, _, _) => {
        let j = 0;

        while (j < instructions.len()) {
          let start = _windowStart(opOf(instructions[j]));
          let args = argsOf(instructions[j]);

          if ((start >= 0) && (_scratchOffset(_scratch, args, start) < 0)) {
            let a = start;

            while (a < args.len()) {
              _scratch.push(_keys[args[a]]);
              a++;
            }
          }
          j++;
        }
      } };
      i++;
    }
    if (params.len() + _scratch.len() > _REGISTER_LIMIT) { _tooMany(id); }
    let neighbors = _interference(blocks, registers.len() as I32);
    let payloads = Array.new<I32>(0);
    i = 0;

    while (i < blocks.len()) {
      match (blocks[i]) { Block(_, _, _, handler) => { if (handler != null) { payloads.push(handlerPayload(handler)); } null } };
      i++;
    }
    let spilled = Array.new<Bool>(_keyTypes.len());
    i = 0;

    while (i < spilled.len()) {
      spilled[i] = false;
      i++;
    }
    let temps = 0;
    _colors = _color(params, payloads, neighbors, _REGISTER_LIMIT - _scratch.len());
    let changed = true;

    while (changed) {
      changed = false;
      i = 0;

      while (i < _colors.len()) {
        if ((_colors[i] < 0) && !spilled[_keys[i]]) {
          spilled[_keys[i]] = true;
          temps += 2;
          changed = true;
        }
        i++;
      }
      if (changed) { _colors = _color(params, payloads, neighbors, _REGISTER_LIMIT - _scratch.len() - temps); }
    }
    i = 0;

    while (i < payloads.len()) {
      if (_colors[payloads[i]] < 0) { throw "a catch value needs a register, and all 256 are in use"; }
      i++;
    }
    let physical = Array.new<ValueType>(0);
    i = 0;

    while (i < _colors.len()) {
      while (physical.len() <= _colors[i]) { physical.push(registers[i]); }
      if (_colors[i] >= 0) { physical[_colors[i]] = registers[i]; }
      i++;
    }
    _tempStart = physical.len() as I32;
    _tempOffsets = Array.new<I32>(_keyTypes.len());
    _nextTemp = Array.new<I32>(_keyTypes.len());
    i = 0;

    while (i < _keyTypes.len()) {
      _tempOffsets[i] = -1;
      _nextTemp[i] = 0;

      if (spilled[i]) {
        _tempOffsets[i] = (physical.len() as I32) - _tempStart;
        physical.push(_keyTypes[i]);
        physical.push(_keyTypes[i]);
      }
      i++;
    }
    _scratchStart = physical.len() as I32;
    i = 0;

    while (i < _scratch.len()) {
      physical.push(_keyTypes[_scratch[i]]);
      i++;
    }
    if (physical.len() > _REGISTER_LIMIT) { _tooMany(id); }
    let allocated = Array.new<BasicBlock>(0);
    i = 0;

    while (i < blocks.len()) {
      allocated.push(_rewriteBlock(blocks[i]));
      i++;
    }
    let physicalParams = Array.new<I32>(0);
    i = 0;

    while (i < params.len()) {
      physicalParams.push(i);
      i++;
    }
    Function.Function(id, physicalParams, physical, result, allocated, entry)
  } }
};

let _failed = -1;
export let allocationFailure: () -> I32 = fn() { _failed };

export let allocateProgram: (Program) -> Program = fn(program) {
  _failed = -1;

  let allocated = match (program) { Program(functions, pool, wides, enums, globals, natives) => {
    let out = Array.new<Function>(0);
    let i = 0;

    while (i < functions.len()) {
      try { out.push(_allocate(functions[i])); } catch (e) {
        _failed = match (functions[i]) { Function(id, _, _, _, _, _) => id };
        throw Std.string(e);
      }
      i++;
    }
    Program.Program(out, pool, wides, enums, globals, natives)
  } };
  verifyAllocatedProgram(allocated);
  allocated
};
