package backend.jello;

import type { BasicBlock, Function, Instruction, Program, Terminator, ThrowHandler, ValueType } from ir.Model;
import { BasicBlock, Function, Op, Program, Terminator, ThrowHandler, argsOf, dstOf, handlerPayload, handlerTarget, immOf, instructionAt, nodeOf, opOf, valueTypeEqual } from ir.Model;
import { blockCatch, blockIndexes } from ir.Cfg;
import { liveness, terminatorReads } from ir.Liveness;
import { verifyAllocatedProgram } from ir.Verify;

let _REGISTER_LIMIT = 256;

let _keyTypes = Array.new<ValueType>(0);
let _keys = Array.new<I32>(0);

let _key = fn(ty: ValueType): I32 {
  let i = 0;

  while (i < _keyTypes.len()) {
    if (valueTypeEqual(_keyTypes[i], ty)) { return i; }
    i++;
  }
  _keyTypes.push(ty);
  (_keyTypes.len() - 1) as I32
};

let _windowStart = fn(op: Op): I32 { match (op) { Call, CallNative, EnumNew, ConstFunction => 0, CallIndirect, BytesSlice => 1, _ => -1 } };

let _live = Array.new<I32>(0);
let _places = Array.new<I32>(0);

let _enliven = fn(register: I32) {
  if (_places[register] < 0) {
    _places[register] = _live.len() as I32;
    _live.push(register);
  }
  null
};

let _kill = fn(register: I32) {
  let place = _places[register];

  if (place >= 0) {
    let last = _live[_live.len() - 1];
    _live.pop();

    if (last != register) {
      _live[place] = last;
      _places[last] = place;
    }
    _places[register] = -1;
  }
  null
};

let _interference = fn(blocks: Array<BasicBlock>, count: I32): Array<Array<I32>> {
  let indexes = blockIndexes(blocks);
  let (liveIn, liveOut) = liveness(blocks, count, 0, true);
  let neighbors = Array.new<Array<I32>>(0);
  let i = 0;

  while (i < count) {
    neighbors.push(Array.new<I32>(0));
    i++;
  }
  let payloadsDone = Array.new<Bool>(blocks.len());
  i = 0;

  while (i < blocks.len()) {
    payloadsDone[i] = false;
    i++;
  }
  let caughtMarks = Array.new<I32>(count);
  _places = Array.new<I32>(count);
  i = 0;

  while (i < count) {
    caughtMarks[i] = -1;
    _places[i] = -1;
    i++;
  }
  i = 0;

  while (i < blocks.len()) {
    let (target, payload) = blockCatch(blocks[i], indexes);
    let caught = target >= 0 ? liveIn[target] : Array.new<I32>(0);
    let first = (target >= 0) && !payloadsDone[target];
    let m = 0;
    if (first) { payloadsDone[target] = true; }

    while (m < caught.len()) {
      if (caught[m] != payload) {
        caughtMarks[caught[m]] = i;

        if (first) {
          neighbors[payload].push(caught[m]);
          neighbors[caught[m]].push(payload);
        }
      }
      m++;
    }

    match (blocks[i]) { Block(_, instructions, terminator, _) => {
      m = 0;

      while (m < liveOut[i].len()) {
        _enliven(liveOut[i][m]);
        m++;
      }
      let last = terminatorReads(terminator);
      let a = 0;

      while (a < last.len()) {
        _enliven(last[a]);
        a++;
      }
      let j = instructions.len() - 1;

      while (j >= 0) {
        let dst = dstOf(instructions[j]);
        let source = match (opOf(instructions[j])) { Move => argsOf(instructions[j])[0], _ => -1 };

        if (dst >= 0) {
          m = 0;

          while (m < _live.len()) {
            let other = _live[m];

            if ((other != dst) && (other != source)) {
              neighbors[dst].push(other);
              neighbors[other].push(dst);
            }
            m++;
          }
          if (caughtMarks[dst] != i) { _kill(dst); }
        }
        let args = argsOf(instructions[j]);
        a = 0;

        while (a < args.len()) {
          _enliven(args[a]);
          a++;
        }
        j--;
      }
    } };
    while (_live.len() > 0) { _kill(_live[_live.len() - 1]); }
    i++;
  }
  neighbors
};

let _moves = fn(blocks: Array<BasicBlock>): Array<Tuple<I32, I32>> {
  let moves = Array.new<Tuple<I32, I32>>(0);
  let i = 0;

  while (i < blocks.len()) {
    match (blocks[i]) { Block(_, instructions, _, _) => {
      let j = 0;

      while (j < instructions.len()) {
        match (opOf(instructions[j])) {
          Move => {
            moves.push((dstOf(instructions[j]), argsOf(instructions[j])[0]));
            null
          }, _ => null
        };
        j++;
      }
    } };
    i++;
  }
  moves
};

let _groups = Array.new<I32>(0);
let _members = Array.new<Array<I32>>(0);
let _groupColors = Array.new<I32>(0);
let _degrees = Array.new<I32>(0);

let _group = fn(register: I32): I32 {
  let r = register;
  while (_groups[r] != r) { r = _groups[r]; }
  let on = register;

  while (on != r) {
    let next = _groups[on];
    _groups[on] = r;
    on = next;
  }
  r
};

let _conflict = fn(a: I32, b: I32, color: I32, neighbors: Array<Array<I32>>): Bool {
  let groups = [a, b];
  let g = 0;
  if (color < 0) { groups = _degrees[a] <= _degrees[b] ? [a] : [b]; }

  while (g < groups.len()) {
    let members = _members[groups[g]];
    let m = 0;

    while (m < members.len()) {
      let n = 0;

      while (n < neighbors[members[m]].len()) {
        let other = _group(neighbors[members[m]][n]);
        if ((other == a) || (other == b)) { return true; }
        if ((color >= 0) && (_groupColors[other] == color)) { return true; }
        n++;
      }
      m++;
    }
    g++;
  }
  false
};

let _coalesce = fn(moves: Array<Tuple<I32, I32>>, fixed: Array<I32>, neighbors: Array<Array<I32>>) {
  let count = fixed.len();
  _groups = Array.new<I32>(count);
  _members = Array.new<Array<I32>>(count);
  _groupColors = Array.new<I32>(count);
  _degrees = Array.new<I32>(count);
  let i = 0;

  while (i < count) {
    _groups[i] = i;
    _members[i] = [i];
    _groupColors[i] = fixed[i];
    _degrees[i] = neighbors[i].len() as I32;
    i++;
  }
  i = 0;

  while (i < moves.len()) {
    let (dst, src) = moves[i];
    let a = _group(dst);
    let b = _group(src);
    let colorA = _groupColors[a];
    let colorB = _groupColors[b];
    let color = colorA >= 0 ? colorA : colorB;

    if ((a != b) && (_keys[a] == _keys[b]) && ((colorA < 0) || (colorB < 0) || (colorA == colorB)) && !_conflict(a, b, color, neighbors)) {
      _groups[b] = a;
      _groupColors[a] = color;
      _degrees[a] = _degrees[a] + _degrees[b];
      let into = _members[a];
      let rest = _members[b];

      if (rest.len() > into.len()) {
        into = _members[b];
        rest = _members[a];
      }
      let m = 0;

      while (m < rest.len()) {
        into.push(rest[m]);
        m++;
      }
      _members[a] = into;
      _members[b] = Array.new<I32>(0);
    }
    i++;
  }
  null
};

let _free = fn(color: I32, register: I32, marks: Array<I32>, colorKeys: Array<I32>): Bool {
  (color >= 0) && (color < marks.len()) && (marks[color] != register) && ((colorKeys[color] < 0) || (colorKeys[color] == _keys[register]))
};

let _color = fn(first: Array<I32>, neighbors: Array<Array<I32>>, moves: Array<Tuple<I32, I32>>, limit: I32): Array<I32> {
  let count = _keys.len();
  let colors = Array.new<I32>(count);
  let colorKeys = Array.new<I32>(limit);
  let marks = Array.new<I32>(limit);
  let partners = Array.new<Array<I32>>(0);
  let i = 0;

  while (i < limit) {
    colorKeys[i] = -1;
    marks[i] = -1;
    i++;
  }
  i = 0;

  while (i < count) {
    partners.push(Array.new<I32>(0));
    colors[i] = _groups[i] == i ? _groupColors[i] : -1;
    if (colors[i] >= 0) { colorKeys[colors[i]] = _keys[i]; }
    i++;
  }
  i = 0;

  while (i < moves.len()) {
    let (dst, src) = moves[i];
    let a = _group(dst);
    let b = _group(src);

    if (a != b) {
      partners[a].push(b);
      partners[b].push(a);
    }
    i++;
  }
  let k = 0;

  while (k < first.len() + count) {
    i = k < first.len() ? _group(first[k]) : k - (first.len() as I32);

    if ((colors[i] < 0) && (_groups[i] == i)) {
      let m = 0;

      while (m < _members[i].len()) {
        let n = 0;
        let member = _members[i][m];

        while (n < neighbors[member].len()) {
          let color = colors[_group(neighbors[member][n])];
          if (color >= 0) { marks[color] = i; }
          n++;
        }
        m++;
      }
      let color = -1;
      let p = 0;

      while ((color < 0) && (p < partners[i].len())) {
        if (_free(colors[partners[i][p]], i, marks, colorKeys)) { color = colors[partners[i][p]]; }
        p++;
      }

      if (color < 0) {
        color = 0;
        while ((color < limit) && !_free(color, i, marks, colorKeys)) { color++; }
      }

      if (color < limit) {
        colors[i] = color;
        colorKeys[color] = _keys[i];
      }
    }
    k++;
  }
  i = 0;

  while (i < count) {
    colors[i] = colors[_group(i)];
    i++;
  }
  i = 0;

  while (i < count) {
    let n = 0;

    while ((colors[i] >= 0) && (n < neighbors[i].len())) {
      if (colors[neighbors[i][n]] == colors[i]) { throw "register allocation gave interfering registers %" + Std.string(i) + " and %" + Std.string(neighbors[i][n]) + " one register"; }
      n++;
    }
    i++;
  }
  colors
};

let _scratchOffset = fn(scratch: Array<I32>, args: Array<I32>, start: I32): I32 {
  let size = (args.len() as I32) - start;
  let offset = 0;

  while (offset + size <= scratch.len()) {
    let i = 0;
    while ((i < size) && (scratch[offset + i] == _keys[args[start + i]])) { i++; }
    if (i == size) { return offset; }
    offset++;
  }
  -1
};

let _registers = Array.new<ValueType>(0);
let _slotOf = Array.new<I32>(0);
let _scratch = Array.new<I32>(0);

let _fresh = fn(ty: ValueType, key: I32, slot: I32): I32 {
  _registers.push(ty);
  _keys.push(key);
  _slotOf.push(slot);
  (_registers.len() - 1) as I32
};

let _withWindows = fn(blocks: Array<BasicBlock>): Array<BasicBlock> {
  let windowed = Array.new<BasicBlock>(0);
  let i = 0;

  while (i < blocks.len()) {
    match (blocks[i]) { Block(id, instructions, terminator, handler) => {
      let out = Array.new<Instruction>(0);
      let j = 0;

      while (j < instructions.len()) {
        let insn = instructions[j];
        let start = _windowStart(opOf(insn));
        let args = argsOf(insn);

        if ((start < 0) || (start >= args.len())) { out.push(insn); } else {
          let offset = _scratchOffset(_scratch, args, start);
          let moved = Array.new<I32>(0);
          let a = 0;

          while (a < args.len()) {
            if (a < start) { moved.push(args[a]); } else {
              let slot = _fresh(_registers[args[a]], _keys[args[a]], offset + a - start);
              out.push(instructionAt(Op.Move, slot, [args[a]], 0, nodeOf(insn)));
              moved.push(slot);
            }
            a++;
          }
          out.push(instructionAt(opOf(insn), dstOf(insn), moved, immOf(insn), nodeOf(insn)));
        }
        j++;
      }
      windowed.push(BasicBlock.Block(id, out, terminator, handler));
    } };
    i++;
  }
  windowed
};

let _windowBase = fn(params: Array<I32>, neighbors: Array<Array<I32>>): I32 {
  let base = 0;

  while (base < params.len()) {
    let fits = true;
    let i = 0;

    while (fits && (i < _scratch.len()) && (base + i < params.len())) {
      let param = params[base + i];
      fits = _keys[param] == _scratch[i];
      let n = 0;

      while (fits && (n < neighbors[param].len())) {
        fits = _slotOf[neighbors[param][n]] != i;
        n++;
      }
      i++;
    }
    if (fits) { return base; }
    base++;
  }
  params.len() as I32
};

let _colors = Array.new<I32>(0);
let _slots = Array.new<I32>(0);
let _tempStart = 0;
let _tempOffsets = Array.new<I32>(0);
let _nextTemp = Array.new<I32>(0);
let _out = Array.new<Instruction>(0);

let _node = -1;

let _emit = fn(op: Op, dst: I32, args: Array<I32>, imm: I32) {
  _out.push(instructionAt(op, dst, args, imm, _node));
  null
};

let _read = fn(register: I32): I32 {
  if (_colors[register] >= 0) { return _colors[register]; }
  let key = _keys[register];
  let temp = _tempStart + _tempOffsets[key] + _nextTemp[key];
  _nextTemp[key]++;
  _emit(Op.SpillPop, temp, Array.new<I32>(0), _slots[register]);
  temp
};

let _write = fn(register: I32): I32 { _colors[register] >= 0 ? _colors[register] : _tempStart + _tempOffsets[_keys[register]] };

let _written = fn(register: I32, physical: I32) { if (_colors[register] < 0) { _emit(Op.SpillPush, -1, [physical], _slots[register]); } null };

let _resetTemps = fn() {
  let i = 0;

  while (i < _nextTemp.len()) {
    _nextTemp[i] = 0;
    i++;
  } null
};

let _rewrite = fn(insn: Instruction) {
  _resetTemps();
  _node = nodeOf(insn);
  let op = opOf(insn);
  let dst = dstOf(insn);
  let args = argsOf(insn);
  let moved = match (op) { Move => true, _ => false };

  if (moved && (_colors[dst] >= 0) && (_colors[args[0]] < 0)) {
    _emit(Op.SpillPop, _colors[dst], Array.new<I32>(0), _slots[args[0]]);
    return null;
  }

  if (moved && (_colors[dst] < 0) && (_slots[dst] != _slots[args[0]])) {
    _emit(Op.SpillPush, -1, [_read(args[0])], _slots[dst]);
    return null;
  }
  if (moved && (_colors[dst] == _colors[args[0]])) { return null; }
  let physical = Array.new<I32>(0);
  let i = 0;

  while (i < args.len()) {
    physical.push(_read(args[i]));
    i++;
  }

  if (dst < 0) {
    _emit(op, -1, physical, immOf(insn));
    return null;
  }
  let target = _write(dst);
  _emit(op, target, physical, immOf(insn));
  _written(dst, target)
};

let _rewriteBlock = fn(block: BasicBlock): BasicBlock {
  match (block) { Block(id, instructions, terminator, handler) => {
    _out = Array.new<Instruction>(0);
    let i = 0;

    while (i < instructions.len()) {
      _rewrite(instructions[i]);
      i++;
    }
    _resetTemps();
    _node = -1;

    let allocated = match (terminator) {
      Branch(value, thenTarget, elseTarget) => Terminator.Branch(_read(value), thenTarget, elseTarget),
      ReturnValue(value) => Terminator.ReturnValue(_read(value)),
      Throw(value, node) => {
        _node = node;
        Terminator.Throw(_read(value), node)
      },
      _ => terminator,
    };
    let caught: ?ThrowHandler = null;
    if (handler != null) { caught = ThrowHandler.Catch(handlerTarget(handler), _colors[handlerPayload(handler)]); }
    BasicBlock.Block(id, _out, allocated, caught)
  } }
};

let _tooMany = fn(id: I32) {
  throw "function @" + Std.string(id) + " needs more than 256 registers; split it into smaller functions";
  null
};

let _allocate = fn(function: Function): Function {
  match (function) { Function(id, params, captures, registers, result, blocks, entry) => {
    _keyTypes = Array.new<ValueType>(0);
    _keys = Array.new<I32>(0);
    _registers = Array.new<ValueType>(0);
    _slotOf = Array.new<I32>(0);
    let i = 0;

    while (i < registers.len()) {
      _registers.push(registers[i]);
      _keys.push(_key(registers[i]));
      _slotOf.push(-1);
      i++;
    }
    _scratch = Array.new<I32>(0);
    i = 0;

    while (i < blocks.len()) {
      match (blocks[i]) { Block(_, instructions, _, _) => {
        let j = 0;

        while (j < instructions.len()) {
          let start = _windowStart(opOf(instructions[j]));
          let args = argsOf(instructions[j]);

          if ((start >= 0) && (_scratchOffset(_scratch, args, start) < 0)) {
            let a = start;

            while (a < args.len()) {
              _scratch.push(_keys[args[a]]);
              a++;
            }
          }
          j++;
        }
      } };
      i++;
    }
    let windowed = _withWindows(blocks);
    let count = _registers.len() as I32;
    let neighbors = _interference(windowed, count);
    let moves = _moves(windowed);
    let payloads = Array.new<I32>(0);
    i = 0;

    while (i < windowed.len()) {
      match (windowed[i]) { Block(_, _, _, handler) => { if (handler != null) { payloads.push(handlerPayload(handler)); } null } };
      i++;
    }
    let base = _windowBase(params, neighbors);
    let fixed = Array.new<I32>(count);
    i = 0;

    while (i < count) {
      fixed[i] = _slotOf[i] >= 0 ? base + _slotOf[i] : -1;
      i++;
    }
    i = 0;

    while (i < params.len()) {
      fixed[params[i]] = i as I32;
      i++;
    }
    _coalesce(moves, fixed, neighbors);
    let spilled = Array.new<Bool>(_keyTypes.len());
    i = 0;

    while (i < spilled.len()) {
      spilled[i] = false;
      i++;
    }
    let temps = 0;
    let reserved = base + (_scratch.len() as I32) > (params.len() as I32) ? base + (_scratch.len() as I32) : params.len() as I32;
    if (reserved > _REGISTER_LIMIT) { _tooMany(id); }
    _colors = _color(payloads, neighbors, moves, _REGISTER_LIMIT);
    let changed = true;

    while (changed) {
      changed = false;
      i = 0;

      while (i < _colors.len()) {
        if ((_colors[i] < 0) && !spilled[_keys[i]]) {
          spilled[_keys[i]] = true;
          temps += 2;
          changed = true;
        }
        i++;
      }

      if (changed) {
        if (reserved > _REGISTER_LIMIT - temps) { _tooMany(id); }
        _colors = _color(payloads, neighbors, moves, _REGISTER_LIMIT - temps);
      }
    }
    i = 0;

    while (i < payloads.len()) {
      if (_colors[payloads[i]] < 0) { throw "a catch value needs a register, and all 256 are in use"; }
      i++;
    }
    _slots = Array.new<I32>(_colors.len());
    let slotCount = 0;
    i = 0;

    while (i < _colors.len()) {
      _slots[i] = -1;

      if ((_colors[i] < 0) && (_group(i) == i)) {
        _slots[i] = slotCount;
        slotCount++;
      }
      i++;
    }
    i = 0;

    while (i < _colors.len()) {
      _slots[i] = _slots[_group(i)];
      i++;
    }
    let physical = Array.new<ValueType>(0);
    i = 0;

    while (i < _colors.len()) {
      while (physical.len() <= _colors[i]) { physical.push(_registers[i]); }
      if (_colors[i] >= 0) { physical[_colors[i]] = _registers[i]; }
      i++;
    }
    _tempStart = physical.len() as I32;
    _tempOffsets = Array.new<I32>(_keyTypes.len());
    _nextTemp = Array.new<I32>(_keyTypes.len());
    i = 0;

    while (i < _keyTypes.len()) {
      _tempOffsets[i] = -1;
      _nextTemp[i] = 0;

      if (spilled[i]) {
        _tempOffsets[i] = (physical.len() as I32) - _tempStart;
        physical.push(_keyTypes[i]);
        physical.push(_keyTypes[i]);
      }
      i++;
    }
    if (physical.len() > _REGISTER_LIMIT) { _tooMany(id); }
    let allocated = Array.new<BasicBlock>(0);
    i = 0;

    while (i < windowed.len()) {
      allocated.push(_rewriteBlock(windowed[i]));
      i++;
    }
    let physicalParams = Array.new<I32>(0);
    i = 0;

    while (i < params.len()) {
      physicalParams.push(i);
      i++;
    }
    Function.Function(id, physicalParams, captures, physical, result, allocated, entry)
  } }
};

let _failed = -1;
export let allocationFailure: () -> I32 = fn() { _failed };

export let allocateProgram: (Program) -> Program = fn(program) {
  _failed = -1;

  let allocated = match (program) { Program(functions, pool, wides, enums, globals, natives) => {
    let out = Array.new<Function>(0);
    let i = 0;

    while (i < functions.len()) {
      try { out.push(_allocate(functions[i])); } catch (e) {
        _failed = match (functions[i]) { Function(id, _, _, _, _, _, _) => id };
        throw Std.string(e);
      }
      i++;
    }
    Program.Program(out, pool, wides, enums, globals, natives)
  } };
  verifyAllocatedProgram(allocated);
  allocated
};
