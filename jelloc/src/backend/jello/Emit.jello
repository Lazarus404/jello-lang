package backend.jello;

import type { BasicBlock, EnumSchema, Function, Instruction, Native, Program, Terminator, ValueType } from ir.Model;
import { ValueType, argumentCount, argsOf, dstOf, handlerPayload, handlerTarget, immOf, nodeOf, opOf, valueTypeEqual } from ir.Model;
import { blockId } from ir.Cfg;
import { internalError } from frontend.Internal;

let _buffer = Bytes.new(0);
let _size = 0;

let _byte = fn(value: I32) {
  if (_size == _buffer.len()) {
    let grown = Bytes.new(_buffer.len() * 2 + 64);
    let i = 0;

    while (i < _size) {
      Bytes.set_u8(grown, i, Bytes.get_u8(_buffer, i));
      i++;
    }
    _buffer = grown;
  }
  Bytes.set_u8(_buffer, _size, value & 255);
  _size++;
  null
};

let _u16 = fn(value: I32) {
  _byte(value);
  _byte(value >> 8)
};

let _u32 = fn(value: I32) {
  _byte(value);
  _byte(value >> 8);
  _byte(value >> 16);
  _byte(value >> 24)
};

let _uleb = fn(value: I32) {
  let v = value;

  while (v >= 128) {
    _byte(v | 128);
    v = v >> 7;
  }
  _byte(v)
};

let _sleb = fn(value: I32) {
  let v = value;
  let more = true;

  while (more) {
    let b = v & 127;
    v = v >> 7;
    more = !(((v == 0) && ((b & 64) == 0)) || ((v == -1) && ((b & 64) != 0)));
    _byte(more ? b | 128 : b);
  }
  null
};

let _bytes = fn(value: Bytes) {
  let i = 0;

  while (i < value.len()) {
    _byte(Bytes.get_u8(value, i));
    i++;
  } null
};

let _types = Array.new<ValueType>(0);
let _typeKinds = Array.new<I32>(0);
let _typeDetails = Array.new<I32>(0);
let _signatures = Array.new<ValueType>(0);
let _structs = Array.new<Array<ValueType>>(0);

let _buckets = Array.new<Array<I32>>(0);

let _hash: (ValueType) -> I32 = fn(_ty) { 0 };
_hash = fn(ty) {
  let combine = fn(seed: I32, types: Array<ValueType>): I32 {
    let h = seed;
    let i = 0;

    while (i < types.len()) {
      h = h * 31 + _hash(types[i]);
      i++;
    }
    h
  };

  match (ty) {
    Bool => 1, I32 => 2, I64 => 3, Bytes => 4, Dynamic => 5,
    ArrayOf(element) => 6 * 31 + _hash(element),
    ListOf(element) => 11 * 31 + _hash(element),
    TupleOf(elements) => combine(7, elements),
    Function(args, result) => combine(8 * 31 + _hash(result), args),
    Nominal(id) => 10 * 31 + id,
  }
};

let _bucket = fn(ty: ValueType): Array<I32> { _buckets[_hash(ty) & (_buckets.len() - 1)] };

let _find = fn(ty: ValueType): I32 {
  let bucket = _bucket(ty);
  let i = 0;

  while (i < bucket.len()) {
    if (valueTypeEqual(_types[bucket[i]], ty)) { return bucket[i]; }
    i++;
  }
  -1
};

let _add = fn(ty: ValueType, kind: I32, detail: I32): I32 {
  _types.push(ty);
  _typeKinds.push(kind);
  _typeDetails.push(detail);
  let index = (_types.len() - 1) as I32;
  _bucket(ty).push(index);
  index
};

let _typeIndex: (ValueType) -> I32 = fn(_ty) { -1 };
_typeIndex = fn(ty) {
  let found = _find(ty);
  if (found >= 0) { return found; }

  match (ty) {
    Bool => _add(ty, 2, 0),
    I32 => _add(ty, 6, 0),
    I64 => _add(ty, 7, 0),
    Bytes => _add(ty, 11, 0),
    Dynamic => _add(ty, 18, 0),
    ArrayOf(element) => _add(ty, 13, _typeIndex(element)),
    ListOf(element) => _add(ty, 12, _typeIndex(element)),
    TupleOf(elements) => {
      let i = 0;

      while (i < elements.len()) {
        _typeIndex(elements[i]);
        i++;
      }
      _structs.push(elements);
      _add(ty, 14, (_structs.len() - 1) as I32)
    },
    Function(args, result) => {
      let i = 0;

      while (i < args.len()) {
        _typeIndex(args[i]);
        i++;
      }
      _typeIndex(result);
      _signatures.push(ty);
      _add(ty, 16, (_signatures.len() - 1) as I32)
    },
    Nominal(id) => {
      internalError("unknown enum type@" + Std.string(id));
      -1
    },
  }
};

let _functionIndexes = Array.new<I32>(0);

let _functionIndex = fn(id: I32): I32 {
  if ((id < 0) || (id >= _functionIndexes.len()) || (_functionIndexes[id] < 0)) { internalError("JLO emission found unknown function"); }
  _functionIndexes[id]
};

let _operand = fn(value: I32, name: Bytes): I32 {
  if ((value < 0) || (value > 255)) { internalError("JLO emission: operand " + name + " is " + Std.string(value) + ", outside 0..255"); }
  value
};

let _insn = fn(opcode: I32, a: I32, b: I32, c: I32, imm: I32) {
  _byte(opcode);
  _byte(_operand(a, "a"));
  _byte(_operand(b, "b"));
  _byte(_operand(c, "c"));
  _u32(imm);
  null
};

let _registerTypes = Array.new<ValueType>(0);
let _wide = fn(register: I32): Bool { match (_registerTypes[register]) { I64 => true, _ => false } };

let _window = fn(args: Array<I32>, start: I32): I32 {
  let i = start + 1;

  while (i < args.len()) {
    if (args[i] != args[i - 1] + 1) { internalError("JLO emission requires consecutive call arguments"); }
    i++;
  }
  args.len() > start ? args[start] : 0
};

let _instruction = fn(insn: Instruction) {
  let dst = dstOf(insn);
  let args = argsOf(insn);
  let imm = immOf(insn);
  let a = args.len() > 0 ? args[0] : 0;
  let b = args.len() > 1 ? args[1] : 0;

  match (opOf(insn)) {
    ConstBool => _insn(24, dst, 0, 0, imm),
    ConstI32 => _insn(19, dst, 0, 0, imm),
    ConstI64 => _insn(20, dst, 0, 0, imm),
    ConstBytes => _insn(27, dst, 0, 0, imm),
    ConstNull => _insn(25, dst, 0, 0, 0),
    ConstFunction => args.len() == 0 ? _insn(15, dst, 0, 0, _functionIndex(imm)) : _insn(16, dst, _window(args, 0), args.len() as I32, _functionIndex(imm)),
    Move => _insn(4, dst, a, 0, 0),
    Add => _insn(_wide(a) ? 42 : 28, dst, a, b, 0),
    Sub => _insn(_wide(a) ? 43 : 29, dst, a, b, 0),
    Mul => _insn(_wide(a) ? 44 : 30, dst, a, b, 0),
    Div => _insn(_wide(a) ? 45 : 31, dst, a, b, 0),
    Rem => _insn(_wide(a) ? 46 : 32, dst, a, b, 0),
    Shl => _insn(_wide(a) ? 48 : 37, dst, a, b, 0),
    Shr => _insn(_wide(a) ? 49 : 38, dst, a, b, 0),
    BitAnd => _insn(_wide(a) ? 50 : 39, dst, a, b, 0),
    BitOr => _insn(_wide(a) ? 51 : 40, dst, a, b, 0),
    BitXor => _insn(_wide(a) ? 52 : 41, dst, a, b, 0),
    Neg => _insn(_wide(a) ? 47 : 36, dst, a, 0, 0),
    Not => _insn(66, dst, a, 0, 0),
    Eq => _insn(_wide(a) ? 71 : 67, dst, a, b, 0),
    Lt => _insn(_wide(a) ? 72 : 68, dst, a, b, 0),
    Sext => _insn(77, dst, a, 0, 0),
    Trunc => _insn(81, dst, a, 0, 0),
    Box => _insn(96, dst, a, 0, 0),
    Unbox => _insn(match (_registerTypes[dst]) { Bool => 104, I32 => 99, I64 => 100, _ => 106 }, dst, a, 0, 0),
    KindOf => _insn(110, dst, a, 0, 0),
    IsEnum => _insn(192, dst, a, 0, _find(ValueType.Nominal(imm))),
    IsNull => _insn(190, dst, a, 0, 0),
    NullCheck => _insn(191, a, 0, 0, 0),
    ArrayNew => _insn(116, dst, a, 0, 0),
    ArrayLen => _insn(117, dst, a, 0, 0),
    ArrayGet => _insn(118, dst, a, b, 0),
    ArraySet => _insn(119, args[2], a, b, 0),
    ArrayResize => _insn(121, 0, a, b, 0),
    ListNil => _insn(111, dst, 0, 0, 0),
    ListCons => _insn(112, dst, a, b, 0),
    ListHead => _insn(113, dst, a, 0, 0),
    ListTail => _insn(114, dst, a, 0, 0),
    ListIsNil => _insn(115, dst, a, 0, 0),
    BytesNew => _insn(122, dst, a, 0, 0),
    BytesSet => _insn(125, args[2], a, b, 0),
    BytesBlit => _insn(176, a, b, args[2], 0),
    BytesLen => _insn(123, dst, a, 0, 0),
    BytesGet => _insn(124, dst, a, b, 0),
    BytesSlice => _insn(189, dst, a, _window(args, 1), 0),
    BytesConcat => _insn(126, dst, a, b, 0),
    BytesEq => _insn(128, dst, a, b, 0),
    StructNew => _insn(150, dst, 0, 0, 0),
    TupleGet => _insn(151, dst, a, 0, imm),
    StructSet => _insn(152, b, a, 0, imm),
    Call => _insn(11, dst, _window(args, 0), args.len() as I32, _functionIndex(imm)),
    CallIndirect => _insn(12, dst, a, (args.len() as I32) - 1, _window(args, 1)),
    CallNative => _insn(167, dst, _window(args, 0), args.len() as I32, imm),
    EnumNew => _insn(164, dst, _window(args, 0), args.len() as I32, imm),
    EnumTag => _insn(165, dst, a, 0, 0),
    EnumGet => _insn(166, dst, a, b, 0),
    AddImm => _insn(33, dst, a, 0, imm),
    SubImm => _insn(34, dst, a, 0, imm),
    MulImm => _insn(35, dst, a, 0, imm),
    EqImm => _insn(69, dst, a, 0, imm),
    LtImm => _insn(70, dst, a, 0, imm),
    SpillPush => _insn(107, a, 0, 0, imm),
    SpillPop => _insn(108, dst, 0, 0, imm),
    GlobalGet => _insn(187, dst, 0, 0, imm),
    GlobalSet => _insn(188, a, 0, 0, imm),
    TupleNew => {
      internalError("JLO emission found an unlegalized TupleNew");
      null
    },
  }
};

export let noSource: (I32) -> Tuple<Bytes, I32, I32> = fn(_node) { ("", 0, 0) };

let _locate = noSource;
let _files = Array.new<Bytes>(0);
let _runs = Array.new<Array<I32>>(0);
let _run = Array.new<I32>(0);
let _runNode = -1;

let _file = fn(path: Bytes): I32 {
  let i = 0;

  while (i < _files.len()) {
    if (_files[i] == path) { return i as I32; }
    i++;
  }
  _files.push(path);
  (_files.len() - 1) as I32
};

let _at = fn(pc: I32, node: I32) {
  if ((node < 0) || (node == _runNode)) { return null; }
  _runNode = node;
  let (path, line, column) = _locate(node);
  if (path == "") { return null; }
  let file = _file(path);
  let n = _run.len();
  if ((n > 0) && (_run[n - 3] == file) && (_run[n - 2] == line) && (_run[n - 1] == column)) { return null; }

  if ((n > 0) && (_run[n - 4] == pc)) {
    _run[n - 3] = file;
    _run[n - 2] = line;
    _run[n - 1] = column;
    return null;
  }
  _run.push(pc);
  _run.push(file);
  _run.push(line);
  _run.push(column);
  null
};

let _catchTargets = Array.new<I32>(0);
let _catchPayloads = Array.new<I32>(0);

let _regions: (I32) -> Array<I32> = fn(_block) { Array.new<I32>(0) };
_regions = fn(block) {
  if (_catchTargets[block] < 0) { return Array.new<I32>(0); }
  let regions = _regions(_catchTargets[block]);
  regions.push(block);
  regions
};

let _sameRegion = fn(a: I32, b: I32): Bool { (_catchTargets[a] == _catchTargets[b]) && (_catchPayloads[a] == _catchPayloads[b]) };

let _transition = fn(source: I32, to: I32): Tuple<I32, Array<I32>> {
  let left = _regions(source);
  let entered = _regions(to);
  let shared = 0;
  while ((shared < left.len()) && (shared < entered.len()) && _sameRegion(left[shared], entered[shared])) { shared++; }
  let opened = Array.new<I32>(0);
  let i = shared;

  while (i < entered.len()) {
    opened.push(entered[i]);
    i++;
  }
  ((left.len() as I32) - shared, opened)
};

let _blocks = Array.new<BasicBlock>(0);
let _indexes = Array.new<I32>(0);
let _isCatch = Array.new<Bool>(0);

let _block = fn(id: I32): BasicBlock { _blocks[_indexes[id]] };

let _forward = fn(id: I32): I32 {
  let target = id;
  let steps = 0;

  while (steps < _blocks.len()) {
    let next = match (_block(target)) {
      Block(_, instructions, Jump(to), _) when ((instructions.len() == 0) && !_isCatch[target]) => to,
      _ => -1,
    };
    if ((next < 0) || (next == target)) { return target; }
    target = next;
    steps++;
  }
  target
};

let _branchTarget = fn(source: I32, target: I32): I32 {
  let to = _forward(target);
  _sameRegion(source, to) ? to : target
};

let _threaded = fn(source: I32, terminator: Terminator): Terminator {
  match (terminator) {
    Jump(target) => {
      let to = _forward(target);

      match (_block(to)) {
        Block(_, instructions, ReturnValue(value), _) when (instructions.len() == 0) => Terminator.ReturnValue(value),
        _ => Terminator.Jump(to),
      }
    },
    Branch(condition, thenTarget, elseTarget) => {
      let thenTo = _branchTarget(source, thenTarget);
      let elseTo = _branchTarget(source, elseTarget);
      thenTo == elseTo ? Terminator.Jump(thenTo) : Terminator.Branch(condition, thenTo, elseTo)
    },
    _ => terminator,
  }
};

let _terminatorOf = fn(block: BasicBlock): Terminator { match (block) { Block(_, _, terminator, _) => terminator } };

let _successors = fn(terminator: Terminator): Array<I32> {
  match (terminator) { Jump(target) => [target], Branch(_, thenTarget, elseTarget) => [elseTarget, thenTarget], _ => Array.new<I32>(0) }
};

let _layout = fn(entry: I32): Array<BasicBlock> {
  let count = _blocks.len();
  let threaded = Array.new<BasicBlock>(count);
  let reachable = Array.new<Bool>(count);
  let placed = Array.new<Bool>(count);
  let i = 0;

  while (i < count) {
    match (_blocks[i]) {
      Block(id, instructions, terminator, handler) => {
        threaded[i] = BasicBlock.Block(id, instructions, _threaded(id, terminator), handler);
        null
      }
    };
    reachable[i] = false;
    placed[i] = false;
    i++;
  }
  let work = [entry];
  reachable[_indexes[entry]] = true;
  let reached = 1;

  while (work.len() > 0) {
    let id = work.pop();
    let next = _successors(_terminatorOf(threaded[_indexes[id]]));
    if (_catchTargets[id] >= 0) { next.push(_catchTargets[id]); }
    let s = 0;

    while (s < next.len()) {
      if (!reachable[_indexes[next[s]]]) {
        reachable[_indexes[next[s]]] = true;
        reached++;
        work.push(next[s]);
      }
      s++;
    }
  }
  let order = Array.new<BasicBlock>(0);
  let current = _indexes[entry];
  let scan = 0;

  while (order.len() < reached) {
    if (current < 0) {
      while (!reachable[scan] || placed[scan]) { scan++; }
      current = scan;
    }
    placed[current] = true;
    order.push(threaded[current]);
    let next = _successors(_terminatorOf(threaded[current]));
    current = -1;
    let s = 0;

    while ((current < 0) && (s < next.len())) {
      if (!placed[_indexes[next[s]]]) { current = _indexes[next[s]]; }
      s++;
    }
  }
  order
};

let _terminatorSize = fn(source: I32, terminator: Terminator, next: I32): I32 {
  match (terminator) {
    Jump(target) => {
      let (left, opened) = _transition(source, target);
      left + (opened.len() as I32) + (target == next ? 0 : 1)
    },
    Branch(_, _, elseTarget) => elseTarget == next ? 1 : 2,
    ReturnValue(_), Throw(_, _) => 1,
  }
};

let _function = fn(function: Function) {
  match (function) { Function(_, params, captures, registers, _, blocks, entry) => {
    _registerTypes = registers;
    _blocks = blocks;
    _indexes = Array.new<I32>(0);
    _isCatch = Array.new<Bool>(0);
    _catchTargets = Array.new<I32>(0);
    _catchPayloads = Array.new<I32>(0);
    let i = 0;

    while (i < blocks.len()) {
      let id = blockId(blocks[i]);

      while (_indexes.len() <= id) {
        _indexes.push(-1);
        _isCatch.push(false);
        _catchTargets.push(-1);
        _catchPayloads.push(-1);
      }
      _indexes[id] = i;
      i++;
    }
    i = 0;

    while (i < blocks.len()) {
      match (blocks[i]) { Block(id, _, _, handler) => {
        if (handler != null) {
          _catchTargets[id] = handlerTarget(handler);
          _catchPayloads[id] = handlerPayload(handler);
          _isCatch[handlerTarget(handler)] = true;
        }
        null
      } };
      i++;
    }
    let order = _layout(entry);
    let nexts = Array.new<I32>(order.len());
    i = 0;

    while (i < order.len()) {
      nexts[i] = i + 1 < order.len() ? blockId(order[i + 1]) : -1;
      i++;
    }
    let pcs = Array.new<I32>(0);
    let count = 0;
    i = 0;

    while (i < order.len()) {
      match (order[i]) { Block(id, instructions, terminator, _) => {
        while (pcs.len() <= id) { pcs.push(-1); }
        pcs[id] = count;
        count += (instructions.len() as I32) + _terminatorSize(id, terminator, nexts[i]);
      } };
      i++;
    }
    _run = Array.new<I32>(0);
    _runNode = -1;
    let args = argumentCount(function);
    _u32(-1);
    _u32(registers.len() as I32);
    _u32(captures > 0 ? args : registers.len() as I32);
    _u32(args);
    _u32(count);
    i = 0;

    while (i < registers.len()) {
      _u32(_typeIndex(registers[i]));
      i++;
    }
    let pc = 0;
    i = 0;

    while (i < order.len()) {
      match (order[i]) { Block(id, instructions, terminator, _) => {
        let j = 0;

        while (j < instructions.len()) {
          _at(pc, nodeOf(instructions[j]));
          _instruction(instructions[j]);
          pc++;
          j++;
        }

        match (terminator) {
          Jump(target) => {
            let (left, opened) = _transition(id, target);
            j = 0;

            while (j < left) {
              _insn(6, 0, 0, 0, 0);
              pc++;
              j++;
            }
            j = 0;

            while (j < opened.len()) {
              let region = opened[j];
              _insn(5, _catchPayloads[region], 0, 0, pcs[_catchTargets[region]] - pc - 1);
              pc++;
              j++;
            }

            if (target != nexts[i]) {
              _insn(2, 0, 0, 0, pcs[target] - pc - 1);
              pc++;
            }
          },
          Branch(condition, thenTarget, elseTarget) => {
            _insn(3, condition, 0, 0, pcs[thenTarget] - pc - 1);
            pc++;

            if (elseTarget != nexts[i]) {
              _insn(2, 0, 0, 0, pcs[elseTarget] - pc - 1);
              pc++;
            }
          },
          ReturnValue(value) => {
            _insn(1, value, 0, 0, 0);
            pc++;
          },
          Throw(value, node) => {
            _at(pc, node);
            _insn(7, value, 0, 0, 0);
            pc++;
          },
        };
      } };
      i++;
    }
    if (pc != count) { internalError("JLO emission laid out " + Std.string(count) + " instructions but wrote " + Std.string(pc)); }
    _runs.push(_run);
  } };
  null
};

let _typeEntry = fn(kind: I32, detail: I32) {
  _byte(kind);
  _byte(0);
  _u16(0);
  _u32(detail);
  _u32(0)
};

let _module = fn(program: Program): Bytes {
  match (program) { Program(functions, pool, wides, enums, globals, natives) => {
    let atoms = Array.new<Bytes>(0);

    let atom = fn(name: Bytes): I32 {
      let a = 0;

      while (a < atoms.len()) {
        if (atoms[a] == name) { return a; }
        a++;
      }
      atoms.push(name);
      (atoms.len() - 1) as I32
    };
    _types = Array.new<ValueType>(0);
    _typeKinds = Array.new<I32>(0);
    _typeDetails = Array.new<I32>(0);
    _signatures = Array.new<ValueType>(0);
    _structs = Array.new<Array<ValueType>>(0);
    _buckets = Array.new<Array<I32>>(0);
    while (_buckets.len() < 256) { _buckets.push(Array.new<I32>(0)); }
    let i = 0;

    while (i < enums.len()) {
      _add(ValueType.Nominal(i), 19, i);
      i++;
    }
    i = 0;

    while (i < enums.len()) {
      match (enums[i]) { Enum(variants) => {
        let v = 0;

        while (v < variants.len()) {
          let f = 0;

          while (f < variants[v].len()) {
            _typeIndex(variants[v][f]);
            f++;
          }
          v++;
        }
      } };
      i++;
    }
    i = 0;

    while (i < globals.len()) {
      _typeIndex(globals[i]);
      i++;
    }
    _functionIndexes = Array.new<I32>(0);
    i = 0;

    while (i < functions.len()) {
      match (functions[i]) { Function(id, _, _, registers, _, _, _) => {
        while (_functionIndexes.len() <= id) { _functionIndexes.push(-1); }
        _functionIndexes[id] = i;
        let r = 0;

        while (r < registers.len()) {
          _typeIndex(registers[r]);
          r++;
        }
      } };
      i++;
    }
    _buffer = Bytes.new(4096);
    _size = 0;
    i = 0;

    while (i < natives.len()) {
      match (natives[i]) { Native(library, name, params, result) => {
        atom(library);
        atom(name);
        _typeIndex(result);
        let a = 0;

        while (a < params.len()) {
          _typeIndex(params[a]);
          a++;
        }
      } };
      i++;
    }
    let features = (wides.len() > 0 ? 1 : 0) | (pool.len() > 0 ? 2 : 0) | (natives.len() > 0 ? 8192 : 0) | (enums.len() > 0 ? 16384 : 0)
      | (globals.len() > 0 ? 32768 : 0) | 8;
    _u32(1246517570);
    _u32(1);
    _u32(features);
    _u32(_types.len() as I32);
    _u32(_signatures.len() as I32);
    _u32(_structs.len() as I32);
    _u32(atoms.len() as I32);
    _u32(functions.len() as I32);
    _u32(_functionIndex(0));
    _u32(natives.len() as I32);
    if (enums.len() > 0) { _u32(enums.len() as I32); }

    if (wides.len() > 0) {
      _u32(wides.len() as I32);
      _u32(0);
    }
    if (pool.len() > 0) { _u32(pool.len() as I32); }
    if (globals.len() > 0) { _u32(globals.len() as I32); }
    i = 0;

    while (i < _types.len()) {
      _typeEntry(_typeKinds[i], _typeDetails[i]);
      i++;
    }
    i = 0;

    while (i < _signatures.len()) {
      match (_signatures[i]) { Function(args, result) => {
        _u32(_find(result));
        _u16(args.len() as I32);
        let a = 0;

        while (a < args.len()) {
          _u32(_find(args[a]));
          a++;
        }
      }, _ => null };
      i++;
    }
    i = 0;

    while (i < _structs.len()) {
      _u16(_structs[i].len() as I32);
      _byte(0);
      _byte(1);
      let f = 0;

      while (f < _structs[i].len()) {
        _u32(_find(_structs[i][f]));
        f++;
      }
      i++;
    }
    i = 0;

    while (i < enums.len()) {
      match (enums[i]) { Enum(variants) => {
        _u16(variants.len() as I32);
        let v = 0;

        while (v < variants.len()) {
          _u16(variants[v].len() as I32);
          let f = 0;

          while (f < variants[v].len()) {
            _u32(_find(variants[v][f]));
            f++;
          }
          v++;
        }
      } };
      i++;
    }
    i = 0;

    while (i < atoms.len()) {
      _u32(atoms[i].len() as I32);
      _bytes(atoms[i]);
      i++;
    }
    i = 0;

    while (i < natives.len()) {
      match (natives[i]) { Native(library, name, params, result) => {
        _u32(atom(library));
        _u32(atom(name));
        _byte(_typeKinds[_find(result)]);
        _byte(params.len() as I32);
        let a = 0;

        while (a < 8) {
          _byte(a < params.len() ? _typeKinds[_find(params[a])] : 0);
          a++;
        }
      } };
      i++;
    }
    i = 0;

    while (i < wides.len()) {
      _u32(wides[i] as I32);
      _u32((wides[i] >> 32) as I32);
      i++;
    }
    i = 0;

    while (i < pool.len()) {
      _u32(pool[i].len() as I32);
      _bytes(pool[i]);
      i++;
    }
    i = 0;

    while (i < globals.len()) {
      _u32(_find(globals[i]));
      i++;
    }
    _files = Array.new<Bytes>(0);
    _runs = Array.new<Array<I32>>(0);
    i = 0;

    while (i < functions.len()) {
      try { _function(functions[i]); } catch (e) { throw "function " + Std.string(i) + ": " + Std.string(e); }
      i++;
    }
    _u32(_files.len() as I32);
    i = 0;

    while (i < _files.len()) {
      _u32(_files[i].len() as I32);
      _bytes(_files[i]);
      i++;
    }
    i = 0;

    while (i < _runs.len()) {
      let run = _runs[i];
      let r = 0;
      let pc = 0;
      let line = 0;
      _uleb((run.len() / 4) as I32);

      while (r < run.len()) {
        _uleb(run[r] - pc);
        _uleb(run[r + 1]);
        _sleb(run[r + 2] - line);
        _uleb(run[r + 3]);
        pc = run[r];
        line = run[r + 2];
        r = r + 4;
      }
      i++;
    }
    Bytes.slice(_buffer, 0, _size)
  } }
};

export let emitAllocated: (Program, (I32) -> Tuple<Bytes, I32, I32>) -> Bytes = fn(program, locate) {
  _locate = locate;
  _module(program)
};
