package backend.jello;

/** @file
 * Encodes an allocated IR program as a `.jlo` module, the last pass of the pipeline after
 * legalisation (`backend.jello.Legalize`) and register allocation (`backend.jello.Allocate`).
 * `Driver` writes the bytes it returns. The module is, in order: the header and section counts,
 * the type table, function signatures, struct layouts, enum schemas, atoms, native imports, the
 * I64 and Bytes constant pools, global types, the functions, and the line table. Fixed-width
 * integers are little-endian.
 *
 * Each function's blocks are laid out so that jumps fall through where they can. Jumps to
 * blocks that only jump on are threaded, and try regions are opened with `TRY` and closed
 * with `ENDTRY` on the jumps that enter and leave them. Every instruction is the VM's
 * canonical 8-byte form; opcode, `a`, `b` and `c` bytes, then a 32-bit immediate. */

import type { BasicBlock, Function, Instruction, Program, Terminator, ValueType } from ir.Model;
import { ValueType, argumentCount, comparesByIdentity, valueTypeEqual } from ir.Model;
import { internalError } from support.Internal;

// The VM's opcodes, numbered as in its `bytecode.h`.
const JOP_RET = 1;
const JOP_JMP = 2;
const JOP_JMP_IF = 3;
const JOP_MOV = 4;
const JOP_TRY = 5;
const JOP_ENDTRY = 6;
const JOP_THROW = 7;
const JOP_CALL = 11;
const JOP_CALLR = 12;
const JOP_CONST_FUN = 15;
const JOP_CLOSURE = 16;
const JOP_CONST_I32 = 19;
const JOP_CONST_I64 = 20;
const JOP_CONST_F16 = 21;
const JOP_CONST_F32 = 22;
const JOP_CONST_F64 = 23;
const JOP_CONST_BOOL = 24;
const JOP_CONST_NULL = 25;
const JOP_CONST_ATOM = 26;
const JOP_CONST_BYTES = 27;
const JOP_ADD_I32 = 28;
const JOP_SUB_I32 = 29;
const JOP_MUL_I32 = 30;
const JOP_DIV_I32 = 31;
const JOP_MOD_I32 = 32;
const JOP_ADD_I32_IMM = 33;
const JOP_SUB_I32_IMM = 34;
const JOP_MUL_I32_IMM = 35;
const JOP_NEG_I32 = 36;
const JOP_SHL_I32 = 37;
const JOP_SHR_I32 = 38;
const JOP_BITAND_I32 = 39;
const JOP_BITOR_I32 = 40;
const JOP_BITXOR_I32 = 41;
const JOP_ADD_I64 = 42;
const JOP_SUB_I64 = 43;
const JOP_MUL_I64 = 44;
const JOP_DIV_I64 = 45;
const JOP_MOD_I64 = 46;
const JOP_NEG_I64 = 47;
const JOP_SHL_I64 = 48;
const JOP_SHR_I64 = 49;
const JOP_BITAND_I64 = 50;
const JOP_BITOR_I64 = 51;
const JOP_BITXOR_I64 = 52;
const JOP_ADD_F16 = 53;
const JOP_SUB_F16 = 54;
const JOP_MUL_F16 = 55;
const JOP_ADD_F32 = 56;
const JOP_SUB_F32 = 57;
const JOP_MUL_F32 = 58;
const JOP_DIV_F32 = 59;
const JOP_NEG_F32 = 60;
const JOP_ADD_F64 = 61;
const JOP_SUB_F64 = 62;
const JOP_MUL_F64 = 63;
const JOP_DIV_F64 = 64;
const JOP_NEG_F64 = 65;
const JOP_NOT_BOOL = 66;
const JOP_EQ_I32 = 67;
const JOP_LT_I32 = 68;
const JOP_EQ_I32_IMM = 69;
const JOP_LT_I32_IMM = 70;
const JOP_EQ_I64 = 71;
const JOP_LT_I64 = 72;
const JOP_EQ_F32 = 73;
const JOP_LT_F32 = 74;
const JOP_EQ_F64 = 75;
const JOP_LT_F64 = 76;
const JOP_SEXT_I64 = 77;
const JOP_I32_FROM_I64 = 81;
const JOP_F64_FROM_I32 = 82;
const JOP_I32_FROM_F64 = 83;
const JOP_F64_FROM_I64 = 84;
const JOP_I64_FROM_F64 = 85;
const JOP_F32_FROM_I32 = 86;
const JOP_I32_FROM_F32 = 87;
const JOP_F64_FROM_F32 = 88;
const JOP_F32_FROM_F64 = 89;
const JOP_F32_FROM_I64 = 90;
const JOP_I64_FROM_F32 = 91;
const JOP_F16_FROM_F32 = 92;
const JOP_F32_FROM_F16 = 93;
const JOP_F16_FROM_I32 = 94;
const JOP_I32_FROM_F16 = 95;
const JOP_TO_DYN = 96;
const JOP_FROM_DYN_I32 = 99;
const JOP_FROM_DYN_I64 = 100;
const JOP_FROM_DYN_F16 = 101;
const JOP_FROM_DYN_F32 = 102;
const JOP_FROM_DYN_F64 = 103;
const JOP_FROM_DYN_BOOL = 104;
const JOP_FROM_DYN_ATOM = 105;
const JOP_FROM_DYN_PTR = 106;
const JOP_SPILL_PUSH = 107;
const JOP_SPILL_POP = 108;
const JOP_PHYSEQ = 109;
const JOP_KINDOF = 110;
const JOP_LIST_NIL = 111;
const JOP_LIST_CONS = 112;
const JOP_LIST_HEAD = 113;
const JOP_LIST_TAIL = 114;
const JOP_LIST_IS_NIL = 115;
const JOP_ARRAY_NEW = 116;
const JOP_ARRAY_LEN = 117;
const JOP_ARRAY_GET = 118;
const JOP_ARRAY_SET = 119;
const JOP_ARRAY_CONCAT2 = 120;
const JOP_ARRAY_RESIZE = 121;
const JOP_BYTES_NEW = 122;
const JOP_BYTES_LEN = 123;
const JOP_BYTES_GET_U8 = 124;
const JOP_BYTES_SET_U8 = 125;
const JOP_BYTES_CONCAT2 = 126;
const JOP_BYTES_CONCAT_MANY = 127;
const JOP_BYTES_EQ = 128;
const JOP_BYTES_READ_U16_LE = 132;
const JOP_BYTES_WRITE_U16_LE = 140;
const JOP_BITS_WRITE = 148;
const JOP_BITS_READ = 149;
const JOP_STRUCT_NEW = 150;
const JOP_STRUCT_GET = 151;
const JOP_STRUCT_SET = 152;
const JOP_OBJ_NEW = 153;
const JOP_OBJ_HAS_ATOM = 154;
const JOP_OBJ_GET_ATOM = 155;
const JOP_OBJ_SET_ATOM = 156;
const JOP_OBJ_GET = 157;
const JOP_OBJ_SET = 158;
const JOP_OBJ_HAS = 159;
const JOP_OBJ_REMOVE = 160;
const JOP_OBJ_CLEAR = 161;
const JOP_OBJ_COPY = 162;
const JOP_OBJ_KEYS = 163;
const JOP_ENUM_NEW = 164;
const JOP_ENUM_TAG = 165;
const JOP_ENUM_GET = 166;
const JOP_CALL_NATIVE = 167;
const JOP_BYTES_BLIT = 176;
const JOP_DIV_U32 = 177;
const JOP_MOD_U32 = 178;
const JOP_DIV_U64 = 179;
const JOP_MOD_U64 = 180;
const JOP_LT_U32 = 181;
const JOP_LT_U64 = 182;
const JOP_ZEXT_I64 = 183;
const JOP_GLOBAL_GET = 187;
const JOP_GLOBAL_SET = 188;
const JOP_BYTES_SLICE = 189;
const JOP_IS_NULL = 190;
const JOP_NULL_CHECK = 191;
const JOP_IS_ENUM = 192;
const JOP_BYTES_FREEZE = 193;
const JOP_BYTES_JOIN = 194;

/** The output buffer; only its first `_size` bytes are written. It at least doubles when full. This
 * and the rest of the module state are reset for each module and, where they are per function, for
 * each function. */
let _buffer = Bytes.new(0);
// The number of bytes written to `_buffer`.
let _size = 0;

/** Appends the low byte of `value` to the output.
 * @param value  the byte, of which bits above the eighth are ignored */
let _byte = fn(value: I32) {
  if (_size == _buffer.len()) {
    let grown = Bytes.new(_buffer.len() * 2 + 64);
    let i = 0;

    while (i < _size) {
      Bytes.set_u8(grown, i, Bytes.get_u8(_buffer, i));
      i++;
    }
    _buffer = grown;
  }
  Bytes.set_u8(_buffer, _size, value & 255);
  _size++;
  null
};

// Appends the low 16 bits of `value`, little-endian.
let _u16 = fn(value: I32) {
  _byte(value);
  _byte(value >> 8)
};

/** Appends `value` as 32 bits, little-endian; a negative value is written as its two's
 * complement. */
let _u32 = fn(value: I32) {
  _byte(value);
  _byte(value >> 8);
  _byte(value >> 16);
  _byte(value >> 24)
};

/** Appends `value` as unsigned LEB128; seven bits a byte, lowest first, with the top bit set on
 * every byte but the last.
 * @param value  a non-negative value */
let _uleb = fn(value: I32) {
  let v = value;

  while (v >= 128) {
    _byte(v | 128);
    v = v >> 7;
  }
  _byte(v)
};

/** Appends `value` as signed LEB128, which ends once the remaining bits are the sign extension
 * of bit 6 of the last byte written. */
let _sleb = fn(value: I32) {
  let v = value;
  let more = true;

  while (more) {
    let b = v & 127;
    v = v >> 7;
    more = !(((v == 0) && ((b & 64) == 0)) || ((v == -1) && ((b & 64) != 0)));
    _byte(more ? b | 128 : b);
  }
  null
};

// Appends the bytes of `value` with no length prefix.
let _bytes = fn(value: Bytes) {
  for (byte in value) {
    _byte(byte);
  }
  null
};

/** The module's type table; each value type interned once, by type index. A type's components
 * are interned before it, so they have lower indexes, except an enum's field types; the enums
 * are interned first. */
let _types = Array.new<ValueType>(0);
// The VM type kind (`jello_type_kind`) of each entry of `_types`.
let _typeKinds = Array.new<I32>(0);
/** The payload of each entry of `_types`; the element's type index for an array or list, the
 * signature index for a function, the struct layout index for a tuple, the enum schema index for
 * an enum, and 0 otherwise. */
let _typeDetails = Array.new<I32>(0);
// The module's function signatures, each a `ValueType.Function`, by signature index.
let _signatures = Array.new<ValueType>(0);
// The module's struct layouts, each a tuple's field types, by layout index.
let _structs = Array.new<Array<ValueType>>(0);

// The hash table over `_types`; 256 buckets of type indexes, chosen by `_hash` of the type.
let _buckets = Array.new<Array<I32>>(0);

/** Returns a structural hash of `ty`, consistent with `Model.valueTypeEqual`; an enum hashes by
 * its index.
 * @return the hash, which may be negative */
let _hash = fn(ty: ValueType): I32 {
  let combine = fn(seed: I32, types: Array<ValueType>): I32 {
    let h = seed;

    for (ty in types) {
      h = h * 31 + _hash(ty);
    }
    h
  };

  match (ty) {
    Bool => 1,
    I32 => 2,
    I64 => 3,
    Bytes => 4,
    Dynamic => 5,
    Atom => 9,
    F16 => 12,
    F32 => 13,
    F64 => 14,
    Object => 15,
    ArrayOf(element) => 6 * 31 + _hash(element),
    ListOf(element) => 11 * 31 + _hash(element),
    TupleOf(elements) => combine(7, elements),
    Function(args, result) => combine(8 * 31 + _hash(result), args),
    Nominal(id) => 10 * 31 + id,
  }
};

/** Returns the bucket of `_buckets` that `ty` belongs in. The bucket count must be a power of
 * two.
 * @return the bucket, shared with `_buckets` */
let _bucket = fn(ty: ValueType): Array<I32> { _buckets[_hash(ty) & (_buckets.len() - 1)] };

// Returns the type index of `ty`, or -1 if it is not interned, without interning it.
let _find = fn(ty: ValueType): I32 {
  let bucket = _bucket(ty);

  for (index in bucket) {
    if (valueTypeEqual(_types[index], ty)) { return index; }
  }
  -1
};

/** Appends `ty` to the type table and its hash bucket; the caller has checked it is absent.
 * @param kind  its VM type kind
 * @param detail  its payload (see `_typeDetails`)
 * @return its type index */
let _add = fn(ty: ValueType, kind: I32, detail: I32): I32 {
  _types.push(ty);
  _typeKinds.push(kind);
  _typeDetails.push(detail);
  let index = _types.len() - 1;
  _bucket(ty).push(index);
  index
};

/** Interns `ty` and every type it contains, and returns its type index. A function type also adds
 * a signature and a tuple a struct layout. The kinds are the VM's; Bool 2, Atom 3, I32 6, I64 7,
 * F16 8, F32 9, F64 10, Bytes 11, List 12, Array 13, Struct 14 for a tuple, Object 15, Function 16
 * and Dynamic 18. Nominal types are not added here; `_module` interns each first, an enum as
 * kind 19 and a record as a struct. */
let _typeIndex = fn(ty: ValueType): I32 {
  let found = _find(ty);
  if (found >= 0) { return found; }

  match (ty) {
    Bool => _add(ty, 2, 0),
    I32 => _add(ty, 6, 0),
    I64 => _add(ty, 7, 0),
    F16 => _add(ty, 8, 0),
    F32 => _add(ty, 9, 0),
    F64 => _add(ty, 10, 0),
    Bytes => _add(ty, 11, 0),
    Atom => _add(ty, 3, 0),
    Dynamic => _add(ty, 18, 0),
    Object => _add(ty, 15, 0),
    ArrayOf(element) => _add(ty, 13, _typeIndex(element)),
    ListOf(element) => _add(ty, 12, _typeIndex(element)),
    TupleOf(elements) => {
      for (element in elements) {
        _typeIndex(element);
      }
      _structs.push(elements);
      _add(ty, 14, _structs.len() - 1)
    },
    Function(args, result) => {
      for (arg in args) {
        _typeIndex(arg);
      }
      _typeIndex(result);
      _signatures.push(ty);
      _add(ty, 16, _signatures.len() - 1)
    },
    Nominal(id) => {
      internalError(`unknown enum type@${id}`);
      -1
    },
  }
};

/** The module function index of each IR function ID, or -1 for an ID with no function. Functions
 * are emitted in program order, so the index is the function's position in the program. */
let _functionIndexes = Array.new<I32>(0);

// Returns the module function index of the function with IR function ID `id`.
let _functionIndex = fn(id: I32): I32 {
  if ((id < 0) || (id >= _functionIndexes.len()) || (_functionIndexes[id] < 0)) {
    internalError("JLO emission found unknown function");
  }
  _functionIndexes[id]
};

/** Checks that `value` fits a one-byte instruction operand. Register and count operands are single
 * bytes, so a value outside 0..255 is a compiler bug, never something to wrap.
 * @param value  the operand
 * @param name  the operand's name, `a`, `b` or `c`, for the error
 * @return `value` */
let _operand = fn(value: I32, name: Bytes): I32 {
  if ((value < 0) || (value > 255)) {
    internalError(`JLO emission: operand ${name} is ${value}, outside 0..255`);
  }
  value
};

/** Appends one instruction in the VM's canonical 8-byte form.
 * @param opcode  the VM opcode (`JOP_*` in the VM's `bytecode.h`)
 * @param a  the first operand byte
 * @param b  the second operand byte
 * @param c  the third operand byte
 * @param imm  the 32-bit immediate */
let _insn = fn(opcode: I32, a: I32, b: I32, c: I32, imm: I32) {
  _byte(opcode);
  _byte(_operand(a, "a"));
  _byte(_operand(b, "b"));
  _byte(_operand(c, "c"));
  _u32(imm);
  null
};

// The physical register types of the function being emitted.
let _registerTypes = Array.new<ValueType>(0);

// Checks whether `register` holds an I64, which selects an integer opcode's 64-bit form.
let _wide = fn(register: I32): Bool {
  match (_registerTypes[register]) {
    I64 => true,
    _ => false,
  }
};

/** Returns the opcode of an arithmetic or comparison op for the type of its operand `register`;
 * `i32` for an I32, a Bool or an Atom, and the others for their types, -1 where the VM has none. */
let _numeric = fn(register: I32, i32: I32, i64: I32, f16: I32, f32: I32, f64: I32): I32 {
  let opcode = match (_registerTypes[register]) {
    I64 => i64,
    F64 => f64,
    F32 => f32,
    F16 => f16,
    _ => i32,
  };
  if (opcode < 0) { internalError("JLO emission found an F16 operation the VM lacks"); }
  opcode
};

/** Returns the opcode that converts a value of type `source` to type `target`, one of them a
 * float, or -1 if the VM has none. */
let _conversion = fn(source: ValueType, target: ValueType): I32 {
  match ((source, target)) {
    (I32, F64) => JOP_F64_FROM_I32,
    (F64, I32) => JOP_I32_FROM_F64,
    (I64, F64) => JOP_F64_FROM_I64,
    (F64, I64) => JOP_I64_FROM_F64,
    (I32, F32) => JOP_F32_FROM_I32,
    (F32, I32) => JOP_I32_FROM_F32,
    (F32, F64) => JOP_F64_FROM_F32,
    (F64, F32) => JOP_F32_FROM_F64,
    (I64, F32) => JOP_F32_FROM_I64,
    (F32, I64) => JOP_I64_FROM_F32,
    (F32, F16) => JOP_F16_FROM_F32,
    (F16, F32) => JOP_F32_FROM_F16,
    (I32, F16) => JOP_F16_FROM_I32,
    (F16, I32) => JOP_I32_FROM_F16,
    _ => -1,
  }
};

/** Returns the first register of the window holding `args` from index `start`, which allocation
 * placed in consecutive registers.
 * @param args  an instruction's physical argument registers
 * @param start  the index of the first windowed argument
 * @return the window's first register, or 0 when it is empty, since any register names an
 *         empty window */
let _window = fn(args: Array<I32>, start: I32): I32 {
  let i = start + 1;

  while (i < args.len()) {
    if (args[i] != args[i - 1] + 1) {
      internalError("JLO emission requires consecutive call arguments");
    }
    i++;
  }
  args.len() > start ? args[start] : 0
};

/** Appends the VM instruction for a `BitsRead`, `BitsWrite`, `BytesRead` or `BytesWrite`; apart,
 * so that `_instruction` stays small. The width is the VM's `c`, and a format counts from
 * `BYTES_READ_U16_LE` or its write. */
let _bitsOrBytes = fn(insn: Instruction) {
  let args = insn.args;
  let imm = insn.imm;

  match (insn.op) {
    BitsRead => _insn(JOP_BITS_READ, insn.dst, args[0], imm % 16, imm / 16),
    BitsWrite => _insn(JOP_BITS_WRITE, args[0], args[1], imm % 16, imm / 16),
    BytesRead => _insn(JOP_BYTES_READ_U16_LE + imm, insn.dst, args[0], args[1], 0),
    _ => _insn(JOP_BYTES_WRITE_U16_LE + imm, args[2], args[0], args[1], 0),
  }
};

/** Returns the `FROM_DYN_*` opcode that unboxes a Dynamic to type `ty`; every reference type
 * shares `FROM_DYN_PTR`, which checks the type as it goes. */
let _unboxOpcode = fn(ty: ValueType): I32 {
  match (ty) {
    Bool => JOP_FROM_DYN_BOOL,
    I32 => JOP_FROM_DYN_I32,
    I64 => JOP_FROM_DYN_I64,
    Atom => JOP_FROM_DYN_ATOM,
    F64 => JOP_FROM_DYN_F64,
    F32 => JOP_FROM_DYN_F32,
    F16 => JOP_FROM_DYN_F16,
    _ => JOP_FROM_DYN_PTR,
  }
};

/** Appends the VM instruction for the legalised, allocated `insn`. Each op maps to one opcode; an
 * arithmetic or comparison op takes the form of its first operand's type, `Convert` the form of
 * its two types, and `ConstFloat` and `Unbox` the form of the destination's type. Windowed
 * operands (call arguments, closure captures, enum fields, a slice's start and length) are named
 * by their first register.
 * @param insn  the instruction, with physical registers */
let _instruction = fn(insn: Instruction) {
  let dst = insn.dst;
  let args = insn.args;
  let imm = insn.imm;
  let a = args.len() > 0 ? args[0] : 0;
  let b = args.len() > 1 ? args[1] : 0;

  match (insn.op) {
    ConstBool => _insn(JOP_CONST_BOOL, dst, 0, 0, imm),
    ConstI32 => _insn(JOP_CONST_I32, dst, 0, 0, imm),
    ConstI64 => _insn(JOP_CONST_I64, dst, 0, 0, imm),
    ConstBytes => _insn(JOP_CONST_BYTES, dst, 0, 0, imm),
    ConstNull => _insn(JOP_CONST_NULL, dst, 0, 0, 0),
    // `CONST_FUN` without captures; `CLOSURE` copies the Dynamic captures from a window.
    ConstFunction => (args.len() == 0)
      ? _insn(JOP_CONST_FUN, dst, 0, 0, _functionIndex(imm))
      : _insn(JOP_CLOSURE, dst, _window(args, 0), args.len(), _functionIndex(imm)),
    Move => _insn(JOP_MOV, dst, a, 0, 0),
    Add => _insn(_numeric(a, JOP_ADD_I32, JOP_ADD_I64, JOP_ADD_F16, JOP_ADD_F32, JOP_ADD_F64),
      dst, a, b, 0),
    Sub => _insn(_numeric(a, JOP_SUB_I32, JOP_SUB_I64, JOP_SUB_F16, JOP_SUB_F32, JOP_SUB_F64),
      dst, a, b, 0),
    Mul => _insn(_numeric(a, JOP_MUL_I32, JOP_MUL_I64, JOP_MUL_F16, JOP_MUL_F32, JOP_MUL_F64),
      dst, a, b, 0),
    Div => _insn(_numeric(a, JOP_DIV_I32, JOP_DIV_I64, -1, JOP_DIV_F32, JOP_DIV_F64), dst, a, b, 0),
    Rem => _insn(_wide(a) ? JOP_MOD_I64 : JOP_MOD_I32, dst, a, b, 0),
    Shl => _insn(_wide(a) ? JOP_SHL_I64 : JOP_SHL_I32, dst, a, b, 0),
    Shr => _insn(_wide(a) ? JOP_SHR_I64 : JOP_SHR_I32, dst, a, b, 0),
    BitAnd => _insn(_wide(a) ? JOP_BITAND_I64 : JOP_BITAND_I32, dst, a, b, 0),
    BitOr => _insn(_wide(a) ? JOP_BITOR_I64 : JOP_BITOR_I32, dst, a, b, 0),
    BitXor => _insn(_wide(a) ? JOP_BITXOR_I64 : JOP_BITXOR_I32, dst, a, b, 0),
    Neg => _insn(_numeric(a, JOP_NEG_I32, JOP_NEG_I64, -1, JOP_NEG_F32, JOP_NEG_F64), dst, a, 0, 0),
    Not => _insn(JOP_NOT_BOOL, dst, a, 0, 0),
    // Atoms and functions compare by identity, with `PHYSEQ`.
    Eq => {
      let opcode = comparesByIdentity(_registerTypes[a])
        ? JOP_PHYSEQ
        : _numeric(a, JOP_EQ_I32, JOP_EQ_I64, -1, JOP_EQ_F32, JOP_EQ_F64);
      _insn(opcode, dst, a, b, 0)
    },
    Lt => _insn(_numeric(a, JOP_LT_I32, JOP_LT_I64, -1, JOP_LT_F32, JOP_LT_F64), dst, a, b, 0),
    Sext => _insn(JOP_SEXT_I64, dst, a, 0, 0),
    Trunc => _insn(JOP_I32_FROM_I64, dst, a, 0, 0),
    Box => _insn(JOP_TO_DYN, dst, a, 0, 0),
    Unbox => _insn(_unboxOpcode(_registerTypes[dst]), dst, a, 0, 0),
    KindOf => _insn(JOP_KINDOF, dst, a, 0, 0),
    IsEnum => _insn(JOP_IS_ENUM, dst, a, 0, _find(ValueType.Nominal(imm))),
    IsNull => _insn(JOP_IS_NULL, dst, a, 0, 0),
    NullCheck => _insn(JOP_NULL_CHECK, a, 0, 0, 0),
    ArrayNew => _insn(JOP_ARRAY_NEW, dst, a, 0, 0),
    ArrayLen => _insn(JOP_ARRAY_LEN, dst, a, 0, 0),
    ArrayGet => _insn(JOP_ARRAY_GET, dst, a, b, 0),
    ArraySet => _insn(JOP_ARRAY_SET, args[2], a, b, 0),
    ArrayConcat => _insn(JOP_ARRAY_CONCAT2, dst, a, b, 0),
    ArrayResize => _insn(JOP_ARRAY_RESIZE, 0, a, b, 0),
    ListNil => _insn(JOP_LIST_NIL, dst, 0, 0, 0),
    ListCons => _insn(JOP_LIST_CONS, dst, a, b, 0),
    ListHead => _insn(JOP_LIST_HEAD, dst, a, 0, 0),
    ListTail => _insn(JOP_LIST_TAIL, dst, a, 0, 0),
    ListIsNil => _insn(JOP_LIST_IS_NIL, dst, a, 0, 0),
    BytesNew => _insn(JOP_BYTES_NEW, dst, a, 0, 0),
    BytesSet => _insn(JOP_BYTES_SET_U8, args[2], a, b, 0),
    BytesBlit => _insn(JOP_BYTES_BLIT, a, b, args[2], 0),
    BytesFreeze => _insn(JOP_BYTES_FREEZE, a, 0, 0, 0),
    BitsRead, BitsWrite, BytesRead, BytesWrite => _bitsOrBytes(insn),
    BytesLen => _insn(JOP_BYTES_LEN, dst, a, 0, 0),
    BytesGet => _insn(JOP_BYTES_GET_U8, dst, a, b, 0),
    BytesSlice => _insn(JOP_BYTES_SLICE, dst, a, _window(args, 1), 0),
    BytesConcat => _insn(JOP_BYTES_CONCAT2, dst, a, b, 0),
    BytesJoin => _insn(JOP_BYTES_JOIN, dst, a, b, 0),
    BytesConcatMany => _insn(JOP_BYTES_CONCAT_MANY, dst, _window(args, 0), args.len(), 0),
    BytesEq => _insn(JOP_BYTES_EQ, dst, a, b, 0),
    StructNew => _insn(JOP_STRUCT_NEW, dst, 0, 0, 0),
    TupleGet => _insn(JOP_STRUCT_GET, dst, a, 0, imm),
    StructSet => _insn(JOP_STRUCT_SET, b, a, 0, imm),
    Call => _insn(JOP_CALL, dst, _window(args, 0), args.len(), _functionIndex(imm)),
    CallIndirect => _insn(JOP_CALLR, dst, a, args.len() - 1, _window(args, 1)),
    CallNative => _insn(JOP_CALL_NATIVE, dst, _window(args, 0), args.len(), imm),
    EnumNew => _insn(JOP_ENUM_NEW, dst, _window(args, 0), args.len(), imm),
    EnumTag => _insn(JOP_ENUM_TAG, dst, a, 0, 0),
    EnumGet => _insn(JOP_ENUM_GET, dst, a, b, 0),
    // An object access takes its key as an atom in `imm`, or else from an Atom register.
    ObjectNew => _insn(JOP_OBJ_NEW, dst, 0, 0, 0),
    ObjectHas => imm < 0
      ? _insn(JOP_OBJ_HAS, dst, a, b, 0)
      : _insn(JOP_OBJ_HAS_ATOM, dst, a, 0, imm),
    ObjectGet => imm < 0
      ? _insn(JOP_OBJ_GET, dst, a, b, 0)
      : _insn(JOP_OBJ_GET_ATOM, dst, a, 0, imm),
    ObjectSet => imm < 0
      ? _insn(JOP_OBJ_SET, args[2], a, b, 0)
      : _insn(JOP_OBJ_SET_ATOM, b, a, 0, imm),
    ObjectRemove => _insn(JOP_OBJ_REMOVE, dst, a, b, 0),
    ObjectClear => _insn(JOP_OBJ_CLEAR, 0, a, 0, 0),
    ObjectCopy => _insn(JOP_OBJ_COPY, dst, a, 0, 0),
    ObjectKeys => _insn(JOP_OBJ_KEYS, dst, a, 0, 0),
    AddImm => _insn(JOP_ADD_I32_IMM, dst, a, 0, imm),
    SubImm => _insn(JOP_SUB_I32_IMM, dst, a, 0, imm),
    MulImm => _insn(JOP_MUL_I32_IMM, dst, a, 0, imm),
    EqImm => _insn(JOP_EQ_I32_IMM, dst, a, 0, imm),
    LtImm => _insn(JOP_LT_I32_IMM, dst, a, 0, imm),
    SpillPush => _insn(JOP_SPILL_PUSH, a, 0, 0, imm),
    SpillPop => _insn(JOP_SPILL_POP, dst, 0, 0, imm),
    GlobalGet => _insn(JOP_GLOBAL_GET, dst, 0, 0, imm),
    GlobalSet => _insn(JOP_GLOBAL_SET, a, 0, 0, imm),
    ConstAtom => _insn(JOP_CONST_ATOM, dst, 0, 0, imm),
    DivU => _insn(_wide(a) ? JOP_DIV_U64 : JOP_DIV_U32, dst, a, b, 0),
    RemU => _insn(_wide(a) ? JOP_MOD_U64 : JOP_MOD_U32, dst, a, b, 0),
    LtU => _insn(_wide(a) ? JOP_LT_U64 : JOP_LT_U32, dst, a, b, 0),
    Zext => _insn(JOP_ZEXT_I64, dst, a, 0, 0),
    ConstFloat => {
      let opcode = match (_registerTypes[dst]) {
        F64 => JOP_CONST_F64,
        F32 => JOP_CONST_F32,
        _ => JOP_CONST_F16,
      };
      _insn(opcode, dst, 0, 0, imm)
    },
    Convert => {
      let opcode = _conversion(_registerTypes[a], _registerTypes[dst]);
      if (opcode < 0) { internalError("JLO emission found a conversion the VM lacks"); }
      _insn(opcode, dst, a, 0, 0)
    },
    TupleNew => internalError("JLO emission found an unlegalized TupleNew"),
  }
};

/** A locator for code with no source, such as IR built by hand in tests; it locates nothing, so
 * the line table is empty.
 * @param _node  a HIR node, ignored
 * @return an empty path, line 0 and column 0 */
export let noSource = fn(_node: I32): Tuple<Bytes, I32, I32> { ("", 0, 0) };

/** The locator `emitAllocated` was given; a HIR node's source path, line and column, or an empty
 * path when it has none. */
let _locate = noSource;
// The line table's source paths, by file index.
let _files = Array.new<Bytes>(0);
// Each emitted function's runs (see `_run`), by function index.
let _runs = Array.new<Array<I32>>(0);
/** The line-table runs of the function being emitted, four values each; the pc a run starts at,
 * and its file index, line and column. A run covers instructions up to the next run's pc; an
 * instruction without a node, or with one at the same location, continues the run before it. */
let _run = Array.new<I32>(0);
// The HIR node of the last instruction `_at` saw in the function being emitted, or -1.
let _runNode = -1;

/** Records that the instruction at `pc` came from HIR node `node`, starting a run when its
 * location differs from the current run's. A later location for the same pc replaces the
 * earlier one.
 * @param pc  the instruction's index in its function
 * @param node  the HIR node, or -1 for none */
let _at = fn(pc: I32, node: I32) {
  if ((node < 0) || (node == _runNode)) { return null; }
  _runNode = node;
  let (path, line, column) = _locate(node);
  if (path == "") { return null; }
  let file = _files.internIndex(path);
  let n = _run.len();

  if ((n > 0)
    && (_run[n - 3] == file)
    && (_run[n - 2] == line)
    && (_run[n - 1] == column)) {
    return null;
  }

  // A second location for the same pc wins: the run is relabelled rather than repeated.
  if ((n > 0) && (_run[n - 4] == pc)) {
    _run[n - 3] = file;
    _run[n - 2] = line;
    _run[n - 1] = column;
    return null;
  }

  _run.push(pc);
  _run.push(file);
  _run.push(line);
  _run.push(column);
  null
};

/** The catch block ID of each block of the function being emitted, by block ID, or -1 for a block
 * outside any try region. A catch block runs one try region out, so the regions active in a
 * block are its catch block's and then its own; the VM's handler stack, innermost last.
 * `ir.Verify` has checked that regions nest at most 16 deep and that only jumps change them. */
let _catchTargets = Array.new<I32>(0);
// The catch payload register of each block of the function being emitted, by block ID, or -1.
let _catchPayloads = Array.new<I32>(0);

/** Returns the try regions active in `block`, outermost first, each named by a block in it.
 * @param block  a block ID
 * @return the regions, as the VM's handler stack holds them, innermost last */
let _regions = fn(block: I32): Array<I32> {
  if (_catchTargets[block] < 0) { return Array.new<I32>(0); }
  let regions = _regions(_catchTargets[block]);
  regions.push(block);
  regions
};

/** Checks whether block IDs `a` and `b` are in the same innermost try region; the same catch
 * block and payload, or no region at all. */
let _sameRegion = fn(a: I32, b: I32): Bool {
  (_catchTargets[a] == _catchTargets[b]) && (_catchPayloads[a] == _catchPayloads[b])
};

/** Computes the try regions a jump from `source` to `to` leaves and enters. The regions the two
 * blocks share, from the outermost in, stay open. Only a jump may change regions.
 * @param source  the jumping block's ID
 * @param to  the target block's ID
 * @return how many regions the jump leaves (each an `ENDTRY`), and the blocks naming the regions
 *         it then enters (each a `TRY`), outermost first */
let _transition = fn(source: I32, to: I32): Tuple<I32, Array<I32>> {
  let left = _regions(source);
  let entered = _regions(to);
  let shared = 0;

  while ((shared < left.len())
    && (shared < entered.len())
    && _sameRegion(left[shared], entered[shared])) {
    shared++;
  }

  (left.len() - shared, Array.new<I32>(0).appendFrom(entered, shared))
};

// The blocks of the function being emitted, in IR order.
let _blocks = Array.new<BasicBlock>(0);
// The index in `_blocks` of each block ID, or -1 for an ID with no block.
let _indexes = Array.new<I32>(0);
// Whether each block ID is a catch block, which a `TRY` names as its handler.
let _isCatch = Array.new<Bool>(0);

// Returns the block of the function being emitted with ID `id`.
let _block = fn(id: I32): BasicBlock { _blocks[_indexes[id]] };

/** Follows a jump to block `id` through empty blocks that only jump on. A catch block is never
 * passed through, since a `TRY` names it; a cycle of empty blocks stops after as many hops as
 * there are blocks.
 * @param id  the target block ID
 * @return the block ID the jump ends up at */
let _forward = fn(id: I32): I32 {
  let target = id;
  let steps = 0;

  while (steps < _blocks.len()) {
    let block = _block(target);

    let next = match (block.terminator) {
      Jump(to) when ((block.instructions.len() == 0) && !_isCatch[target]) => to,
      _ => -1,
    };
    if ((next < 0) || (next == target)) { return target; }
    target = next;
    steps++;
  }

  target
};

/** Returns where a branch from `source` to `target` can go once empty jump-only blocks are passed
 * through. A branch cannot change try regions, so it is forwarded only to a block in its own.
 * @param source  the branching block's ID
 * @param target  one of the branch's targets
 * @return the forwarded target, or `target` when that is in another region */
let _branchTarget = fn(source: I32, target: I32): I32 {
  let to = _forward(target);
  _sameRegion(source, to) ? to : target
};

/** Threads the terminator of block `source`; its targets are forwarded through empty jump-only
 * blocks, a jump to an empty block that only returns becomes that return, and a branch whose two
 * targets coincide becomes a jump. The return needs none of the jump's `TRY` or `ENDTRY`, since
 * a frame's try scopes end with it. */
let _threaded = fn(source: I32, terminator: Terminator): Terminator {
  match (terminator) {
    Jump(target) => {
      let to = _forward(target);
      let landing = _block(to);

      match (landing.terminator) {
        ReturnValue(value) when (landing.instructions.len() == 0) => Terminator.ReturnValue(value),
        _ => Terminator.Jump(to),
      }
    },
    Branch(condition, thenTarget, elseTarget) => {
      let thenTo = _branchTarget(source, thenTarget);
      let elseTo = _branchTarget(source, elseTarget);
      thenTo == elseTo ? Terminator.Jump(thenTo) : Terminator.Branch(condition, thenTo, elseTo)
    },
    _ => terminator,
  }
};

/** Returns the blocks `terminator` may transfer to, in the order layout prefers to place them
 * next; a branch's else block before its then block, since a branch falls through to its else.
 * @return the target block IDs; none for a return or throw */
let _successors = fn(terminator: Terminator): Array<I32> {
  match (terminator) {
    Jump(target) => [target],
    Branch(_, thenTarget, elseTarget) => [elseTarget, thenTarget],
    _ => Array.new<I32>(0),
  }
};

/** Orders the function's blocks for emission, with their terminators threaded (`_threaded`).
 * Only blocks reachable from the entry through threaded terminators and catch blocks are kept.
 * From the entry, each block is followed by its jump's target, or its branch's else block (or
 * else its then block), when that is not placed yet, so the jump falls through. A chain that
 * ends resumes at the first reachable block, in IR order, not placed yet.
 * @param entry  the entry block's ID
 * @return the threaded blocks in layout order, the entry first */
let _layout = fn(entry: I32): Array<BasicBlock> {
  let count = _blocks.len();
  let threaded = Array.new<BasicBlock>(count);
  let reachable = Array.new<Bool>(count);
  let placed = Array.new<Bool>(count);

  for (i, block in _blocks) {
    threaded[i] = { ...block, terminator: _threaded(block.id, block.terminator) };
  }

  // Which blocks are reachable, from the entry along threaded terminators and into catch blocks.
  let work = [entry];
  reachable[_indexes[entry]] = true;
  let reached = 1;

  while (work.len() > 0) {
    let id = work.pop();
    let next = _successors(threaded[_indexes[id]].terminator);
    if (_catchTargets[id] >= 0) { next.push(_catchTargets[id]); }

    for (successor in next) {
      if (!reachable[_indexes[successor]]) {
        reachable[_indexes[successor]] = true;
        reached++;
        work.push(successor);
      }
    }
  }

  let order = Array.new<BasicBlock>(0);
  let current = _indexes[entry];
  let scan = 0;

  while (order.len() < reached) {
    if (current < 0) {
      while (!reachable[scan] || placed[scan]) { scan++; }
      current = scan;
    }
    placed[current] = true;
    order.push(threaded[current]);
    let next = _successors(threaded[current].terminator);
    current = -1;
    let s = 0;

    while ((current < 0) && (s < next.len())) {
      if (!placed[_indexes[next[s]]]) { current = _indexes[next[s]]; }
      s++;
    }
  }

  order
};

/** Counts the instructions the terminator of block `source` is emitted as. A jump is an `ENDTRY`
 * for each region it leaves and a `TRY` for each it enters, then a `JMP` unless its target is
 * laid out next. A branch is a `JMP_IF` to its then block and a `JMP` to its else block unless
 * that is next. A return or throw is one instruction.
 * @param source  the block's ID
 * @param terminator  its threaded terminator
 * @param next  the ID of the block laid out after it, or -1 for none
 * @return the instruction count */
let _terminatorSize = fn(source: I32, terminator: Terminator, next: I32): I32 {
  match (terminator) {
    Jump(target) => {
      let (left, opened) = _transition(source, target);
      left + opened.len() + (target == next ? 0 : 1)
    },
    Branch(_, _, elseTarget) => elseTarget == next ? 1 : 2,
    ReturnValue(_), Throw(_, _) => 1,
  }
};

/** Appends `function`'s record and collects its line-table runs into `_runs`. The record is the
 * header (no name atom, register count, first capture register, argument count, instruction
 * count), each register's type index, then the instructions. Blocks are laid out by `_layout`
 * and sized first, so that every jump's immediate can be its target's pc relative to the
 * instruction after the jump.
 * @param function  an allocated function */
let _function = fn(function: Function) {
  let registers = function.registers;
  let blocks = function.blocks;
  _registerTypes = registers;
  _blocks = blocks;

  // Index the blocks by ID, and note each try region's catch block and payload register.
  _indexes = Array.new<I32>(0);
  _isCatch = Array.new<Bool>(0);
  _catchTargets = Array.new<I32>(0);
  _catchPayloads = Array.new<I32>(0);

  for (i, block in blocks) {
    let id = block.id;

    while (_indexes.len() <= id) {
      _indexes.push(-1);
      _isCatch.push(false);
      _catchTargets.push(-1);
      _catchPayloads.push(-1);
    }
    _indexes[id] = i;
  }

  for (block in blocks) {
    let handler = block.handler;

    if (handler != null) {
      _catchTargets[block.id] = handler.target;
      _catchPayloads[block.id] = handler.payload;
      _isCatch[handler.target] = true;
    }
  }

  // Lay the blocks out, then size them, so that every jump knows its target's pc.
  let order = _layout(function.entry);
  let nexts = Array.new<I32>(order.len());

  for (i, _ in order) {
    nexts[i] = i + 1 < order.len() ? order[i + 1].id : -1;
  }
  let pcs = Array.new<I32>(0);
  let count = 0;

  for (i, block in order) {
    while (pcs.len() <= block.id) { pcs.push(-1); }
    pcs[block.id] = count;
    count += block.instructions.len() + _terminatorSize(block.id, block.terminator, nexts[i]);
  }

  _run = Array.new<I32>(0);
  _runNode = -1;
  /* Header; no name atom (`UINT32_MAX`), register count, the first capture register (they
   * follow the arguments; the register count when there are none), argument count, and
   * instruction count. */
  let args = argumentCount(function);
  _u32(-1);
  _u32(registers.len());
  _u32(function.captures > 0 ? args : registers.len());
  _u32(args);
  _u32(count);

  for (register in registers) {
    _u32(_typeIndex(register));
  }

  let pc = 0;

  for (i, block in order) {
    let id = block.id;

    for (insn in block.instructions) {
      _at(pc, insn.node);
      _instruction(insn);
      pc++;
    }

    match (block.terminator) {
      /* `ENDTRY` closes each region the jump leaves; `TRY` opens each it enters, naming the
       * payload register and the catch block's pc. */
      Jump(target) => {
        let (left, opened) = _transition(id, target);
        let j = 0;

        while (j < left) {
          _insn(JOP_ENDTRY, 0, 0, 0, 0);
          pc++;
          j++;
        }

        for (region in opened) {
          _insn(JOP_TRY, _catchPayloads[region], 0, 0, pcs[_catchTargets[region]] - pc - 1);
          pc++;
        }

        if (target != nexts[i]) {
          _insn(JOP_JMP, 0, 0, 0, pcs[target] - pc - 1);
          pc++;
        }
      },
      Branch(condition, thenTarget, elseTarget) => {
        _insn(JOP_JMP_IF, condition, 0, 0, pcs[thenTarget] - pc - 1);
        pc++;

        if (elseTarget != nexts[i]) {
          _insn(JOP_JMP, 0, 0, 0, pcs[elseTarget] - pc - 1);
          pc++;
        }
      },
      ReturnValue(value) => {
        _insn(JOP_RET, value, 0, 0, 0);
        pc++;
      },
      Throw(value, node) => {
        _at(pc, node);
        _insn(JOP_THROW, value, 0, 0, 0);
        pc++;
      },
    };
  }

  if (pc != count) {
    internalError(`JLO emission laid out ${count} instructions but wrote ${pc}`);
  }

  _runs.push(_run);
  null
};

/** Appends a 12-byte type-table entry; the kind byte, three bytes of padding, the payload, and
 * an unused word.
 * @param kind  the VM type kind
 * @param detail  the payload (see `_typeDetails`) */
let _typeEntry = fn(kind: I32, detail: I32) {
  _byte(kind);
  _byte(0);
  _u16(0);
  _u32(detail);
  _u32(0)
};

/** Encodes `program`, whose registers are physical, as a `.jlo` module. Every type is interned
 * before anything is written, enums and records first so that nominal type `i` has type index `i`.
 * The header is the magic `0x4A4C5942`, version 1, the feature flags (`CONST64` 1, `CONSTBYTES` 2,
 * `LINE_TABLE` 8, which is always set, `IMPORTS` 8192, `ENUM_SCHEMA` 16384 and `GLOBALS` 32768),
 * then the section counts, with the entry (the index of function ID 0) before the import count. The
 * enum, constant-pool and global counts are present only with their features. Struct layouts are
 * unnamed and mutable, since the VM rejects `STRUCT_SET` on an immutable struct. An error while
 * emitting a function is rethrown prefixed with the function's index.
 * @param program  an allocated program
 * @return the module's bytes */
let _module = fn(program: Program): Bytes {
  let functions = program.functions;
  let pool = program.bytes;
  let wides = program.wides;
  let floats = program.floats;
  let enums = program.enums;
  let globals = program.globals;
  let natives = program.natives;

  /* The module's atoms are the program's, at their own indexes so that `CONST_ATOM` names
   * them, then each native's library and export names. */
  let atoms = program.atoms.copy();
  _types = Array.new<ValueType>(0);
  _typeKinds = Array.new<I32>(0);
  _typeDetails = Array.new<I32>(0);
  _signatures = Array.new<ValueType>(0);
  _structs = Array.new<Array<ValueType>>(0);
  _buckets = Array.new<Array<I32>>(0);
  while (_buckets.len() < 256) { _buckets.push(Array.new<I32>(0)); }

  // An enum is a kind 19 type naming its schema, by its place among the enums; a record a struct.
  let enumCount = 0;

  for (i, schema in enums) {
    match (schema) {
      Enum(_) => {
        _add(ValueType.Nominal(i), 19, enumCount);
        enumCount++;
      },
      Record(fields) => {
        _structs.push(fields);
        _add(ValueType.Nominal(i), 14, _structs.len() - 1);
      },
    };
  }

  for (schema in enums) {
    match (schema) {
      Enum(variants) => {
        for (variant in variants) {
          for (field in variant) {
            _typeIndex(field);
          }
        }
      },
      Record(fields) => {
        for (field in fields) {
          _typeIndex(field);
        }
      },
    };
  }

  for (global in globals) {
    _typeIndex(global);
  }
  _functionIndexes = Array.new<I32>(0);

  for (i, function in functions) {
    while (_functionIndexes.len() <= function.id) { _functionIndexes.push(-1); }
    _functionIndexes[function.id] = i;

    for (register in function.registers) {
      _typeIndex(register);
    }
  }
  _buffer = Bytes.new(4096);
  _size = 0;

  for (native in natives) {
    atoms.internIndex(native.library);
    atoms.internIndex(native.name);
    _typeIndex(native.result);

    for (param in native.params) {
      _typeIndex(param);
    }
  }

  // The header and section counts.
  let constants64 = (wides.len() + floats.len()) > 0;
  let features = (constants64 ? 1 : 0)
    | (pool.len() > 0 ? 2 : 0)
    | (natives.len() > 0 ? 8192 : 0)
    | (enumCount > 0 ? 16384 : 0)
    | (globals.len() > 0 ? 32768 : 0)
    | 8;
  _u32(1246517570);
  _u32(1);
  _u32(features);
  _u32(_types.len());
  _u32(_signatures.len());
  _u32(_structs.len());
  _u32(atoms.len());
  _u32(functions.len());
  _u32(_functionIndex(0));
  _u32(natives.len());
  if (enumCount > 0) { _u32(enumCount); }

  // `CONST64` counts the I64 constants, then the F64 ones.
  if (constants64) {
    _u32(wides.len());
    _u32(floats.len());
  }
  if (pool.len() > 0) { _u32(pool.len()); }
  if (globals.len() > 0) { _u32(globals.len()); }

  // The type table, signatures, struct layouts and enum schemas.
  for (i, kind in _typeKinds) {
    _typeEntry(kind, _typeDetails[i]);
  }

  for (signature in _signatures) {
    match (signature) {
      Function(args, result) => {
        _u32(_find(result));
        _u16(args.len());

        for (arg in args) {
          _u32(_find(arg));
        }
      },
      _ => null,
    };
  }

  for (layout in _structs) {
    _u16(layout.len());
    _byte(0);
    _byte(1);

    for (field in layout) {
      _u32(_find(field));
    }
  }

  for (schema in enums) {
    match (schema) {
      Enum(variants) => {
        _u16(variants.len());

        for (variant in variants) {
          _u16(variant.len());

          for (field in variant) {
            _u32(_find(field));
          }
        }
      },
      Record(_) => null,
    };
  }

  for (atom in atoms) {
    _u32(atom.len());
    _bytes(atom);
  }

  /* An import; library and export atoms, the result's type kind, the arity, then eight
   * argument kind bytes, padded with 0. The loader checks them against the `.jdll` export. */
  for (native in natives) {
    let params = native.params;
    _u32(atoms.internIndex(native.library));
    _u32(atoms.internIndex(native.name));
    // 1 is Void
    _byte(native.void ? 1 : _typeKinds[_find(native.result)]);
    _byte(params.len());
    let a = 0;

    while (a < 8) {
      _byte(a < params.len() ? _typeKinds[_find(params[a])] : 0);
      a++;
    }
  }

  // The constant pools and the global types.
  for (wide in wides) {
    _u32(wide as I32);
    _u32((wide >> 32) as I32);
  }

  for (float in floats) {
    _u32(float as I32);
    _u32((float >> 32) as I32);
  }

  for (constant in pool) {
    _u32(constant.len());
    _bytes(constant);
  }

  for (global in globals) {
    _u32(_find(global));
  }

  _files = Array.new<Bytes>(0);
  _runs = Array.new<Array<I32>>(0);

  for (i, function in functions) {
    try { _function(function); } catch (e) { throw `function ${i}: ${e}`; }
  }

  // The line table; the file count and each path with its length, then each function's runs.
  _u32(_files.len());

  for (file in _files) {
    _u32(file.len());
    _bytes(file);
  }

  for (run in _runs) {
    /* The run count, then each run as ULEB128 pc delta, ULEB128 file, SLEB128 line delta and
     * ULEB128 column; the deltas are from the previous run, or from 0 for the first. */
    let r = 0;
    let pc = 0;
    let line = 0;
    _uleb(run.len() / 4);

    while (r < run.len()) {
      _uleb(run[r] - pc);
      _uleb(run[r + 1]);
      _sleb(run[r + 2] - line);
      _uleb(run[r + 3]);
      pc = run[r];
      line = run[r + 2];
      r = r + 4;
    }
  }

  Bytes.slice(_buffer, 0, _size)
};

/** Encodes `program`, as `Allocate.allocateProgram` returned it, as a `.jlo` module whose line
 * table locates each instruction through `locate`. `Driver` writes the result to the output file.
 * The VM validates the bytes when it loads them, unless `JELLO_BC_SKIP_VALIDATE` is set.
 * @param program  an allocated program
 * @param locate  gives a HIR node's source path, line and column, or an empty path when the node
 *        has no source; `noSource` locates nothing
 * @return the module's bytes */
export let emitAllocated = fn(program: Program, locate: (I32) -> Tuple<Bytes, I32, I32>): Bytes {
  _locate = locate;
  _module(program)
};
