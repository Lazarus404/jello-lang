/** @file
 * The project that `jelloc run`, `test` and `deps.get` work in; the nearest directory at or above
 * where they start that holds a `jello.json`. Its manifest names the source directory, `src`
 * (`"src"` by default), the test directories, `test.dirs` (`["tests"]` by default), and the
 * dependencies, and `dev_dependencies` for its tests alone, which `jlo_tool get-deps` fetches
 * into `packages/<name>/`, or which a directory of `package_paths` holds as `<name>/`. Each
 * package's own manifest names its source directory and its dependencies in turn, and both name
 * the directory of their native libraries, `jdll` (`"jdll"` by default), which `jello` searches
 * when it exists. Keys it does not know are ignored, and a bad value is an error located in the
 * manifest. `Driver` searches the sources for imports. */

import { Json, jsonAt, jsonField, parseJson } from support.Json;
import { sourceDiagnostic } from frontend.syntax.Source;
import { E0211, E0212, coded } from support.Codes;
import { exists, readText } from std.io.File;

load { file_real_path } from std;

let _realPath: (Bytes) -> Bytes = file_real_path;

// A project and the packages it depends on.
export typedef Project = {
  // The directory that holds its `jello.json`.
  let root: Bytes;
  // The source roots of it and its packages, its own first.
  let sources: Array<Bytes>;
  // The source roots of the packages that only its `dev_dependencies` reach, for its tests.
  let testSources: Array<Bytes>;
  // Its test directories.
  let tests: Array<Bytes>;
  // The directories of the native libraries it and its packages have, its own first.
  let libraries: Array<Bytes>;
};

/** A dependency some manifest names; `at` is the offset of its value in `namedIn`, the path of
 * that manifest. */
typedef Dependency = {
  let name: Bytes;
  let at: I32;
  let namedIn: Bytes;
};

/** Returns the path of `name` in directory `dir`, which may end with slashes; `dir` itself for
 * "." or "", and `name` itself when it is absolute. */
export let inDirectory = fn(dir: Bytes, name: Bytes): Bytes {
  let end = dir.len();
  while ((end > 1) && (Bytes.get_u8(dir, end - 1) == "/".code)) { end--; }
  let trimmed = Bytes.slice(dir, 0, end);

  if ((name == ".") || (name == "")) { return trimmed; }
  if (name.startsWith("/")) { return name; }
  if (trimmed == ".") { return name; }
  trimmed == "/" ? `/${name}` : `${trimmed}/${name}`
};

/** Returns the directory above `dir`, which is relative where `dir` is; the directory of a file
 * when `dir` is the file's path. */
export let parentDirectory = fn(dir: Bytes): Bytes {
  if ((dir == ".") || (dir == "..") || ((dir.len() > 3) && dir.endsWith("/.."))) {
    return `${dir}/..`;
  }
  let slash = dir.lastIndexOf("/");
  slash < 0 ? "." : (slash == 0 ? "/" : Bytes.slice(dir, 0, slash))
};

// Returns the last component of the path `path`.
export let baseName = fn(path: Bytes): Bytes {
  let slash = path.lastIndexOf("/");
  Bytes.slice(path, slash + 1, path.len() - slash - 1)
};

/** Returns the nearest directory at or above `start` that holds a `jello.json`, or "" when none
 * does. */
export let findProject = fn(start: Bytes): Bytes {
  let dir = start;

  while (!exists(inDirectory(dir, "jello.json"))) {
    let real = _realPath(dir);
    if ((real == "") || (real == "/")) { return ""; }
    dir = parentDirectory(dir);
  }
  dir
};

/** A manifest being read; its path and text, for located errors, and what it holds, which a
 * second read of the same path reuses. */
let _path = "";
let _text = "";
let _json: ?Json = null;

// Throws `message`, with `code`, as a diagnostic at offset `at` of the manifest being read.
let _fail = fn(at: I32, code: Bytes, message: Bytes) {
  throw sourceDiagnostic(_path, _text, at, coded(code, message));
};

/** Reads the manifest at `path`, which must be an object.
 * @return the manifest */
let _read = fn(path: Bytes): Json {
  if ((path == _path) && (_json != null)) { return _json; }
  _path = path;
  _text = readText(path);
  _json = null;

  let (value, message, at) = parseJson(_text);
  if (value == null) { _fail(at, E0211, `invalid JSON: ${message}`); }

  match (value) {
    Object(_, _, _) => null,
    _ => _fail(jsonAt(value), E0211, "a jello.json holds an object"),
  };
  _json = value;
  value
};

// Returns the string at `key` of `manifest`, or `otherwise` when it has none.
let _string = fn(manifest: Json, key: Bytes, otherwise: Bytes): Bytes {
  let found = jsonField(manifest, key);
  if (found == null) { return otherwise; }

  match (found) {
    Text(_, value) => value,
    _ => {
      _fail(jsonAt(found), E0211, `"${key}" must be a string`);
      ""
    },
  }
};

/** Returns the strings of the array at `key` of `value`, or `otherwise` when it has none.
 * @param what  the key's name in a message, such as "test.dirs" */
let _strings = fn(value: Json, key: Bytes, what: Bytes, otherwise: Array<Bytes>): Array<Bytes> {
  let found = jsonField(value, key);
  if (found == null) { return otherwise; }

  let message = `"${what}" must be an array of strings`;

  let string = fn(item: Json): Bytes {
    match (item) {
      Text(_, text) => text,
      _ => {
        _fail(jsonAt(item), E0211, message);
        ""
      },
    }
  };

  match (found) {
    List(_, items) => items.map(string),
    _ => {
      _fail(jsonAt(found), E0211, message);
      []
    },
  }
};

/** Adds to `found` the dependencies that `key` of `manifest`, the manifest just read, names and
 * it lacks. */
let _dependencies = fn(manifest: Json, key: Bytes, found: Array<Dependency>) {
  let field = jsonField(manifest, key);
  if (field == null) { return null; }

  match (field) {
    Null(_) => null,
    Object(_, keys, values) => {
      for (i, name in keys) {
        if (found.first(fn(known: Dependency): Bool { known.name == name }) == null) {
          found.push({ name: name, at: jsonAt(values[i]), namedIn: _path });
        }
      }
      null
    },
    _ => _fail(jsonAt(field), E0211, `"${key}" must be an object`),
  }
};

// Adds directory `name` of `dir` to `libraries` when it exists.
let _addLibraries = fn(dir: Bytes, name: Bytes, libraries: Array<Bytes>) {
  let path = inDirectory(dir, name);
  if (exists(path)) { libraries.push(path); }
  null
};

// Returns each of `names` as a path in directory `dir`.
let _within = fn(dir: Bytes, names: Array<Bytes>): Array<Bytes> {
  names.map(fn(name: Bytes): Bytes { inDirectory(dir, name) })
};

// Returns the first of `places` that holds directory `name`, or "" when none does.
let _locate = fn(places: Array<Bytes>, name: Bytes): Bytes {
  for (place in places) {
    let candidate = inDirectory(place, name);
    if (exists(candidate)) { return candidate; }
  }
  ""
};

/** Finds the packages of `dependencies` from index `start` on, in `places`, adding each one's
 * source root to `sources`, its native libraries to `libraries`, and its own dependencies to
 * `dependencies`, which it finds in turn.
 * @throws a located error for a dependency no place holds */
let _resolve = fn(
  dependencies: Array<Dependency>, start: I32, places: Array<Bytes>, sources: Array<Bytes>,
  libraries: Array<Bytes>
) {
  let d = start;

  while (d < dependencies.len()) {
    let dependency = dependencies[d];
    let dir = _locate(places, dependency.name);

    if (dir == "") {
      if (_path != dependency.namedIn) { _read(dependency.namedIn); }
      _fail(
        dependency.at,
        E0212,
        `package ${dependency.name} is in none of ${places.join(", ")}; run \`jelloc deps.get\``
      );
    }

    let packageManifest = inDirectory(dir, "jello.json");
    let src = "src";
    let jdll = "jdll";

    if (exists(packageManifest)) {
      let read = _read(packageManifest);
      src = _string(read, "src", "src");
      jdll = _string(read, "jdll", "jdll");
      _dependencies(read, "dependencies", dependencies);
    }
    sources.push(inDirectory(dir, src));
    _addLibraries(dir, jdll, libraries);
    d++;
  }
  null
};

/** Reads the project at `root`, whose `jello.json` exists, and the manifests of its packages.
 * @throws a located error for a manifest that is not valid, or a dependency no directory holds */
export let loadProject = fn(root: Bytes): Project {
  let manifest = _read(inDirectory(root, "jello.json"));
  let sources = [inDirectory(root, _string(manifest, "src", "src"))];

  let dirs = ["tests"];
  let test = jsonField(manifest, "test");

  if (test != null) {
    match (test) {
      Object(_, _, _) => null,
      _ => _fail(jsonAt(test), E0211, "\"test\" must be an object"),
    };
    dirs = _strings(test, "dirs", "test.dirs", dirs);
  }
  let tests = _within(root, dirs);

  let libraries = Array.new<Bytes>(0);
  _addLibraries(root, _string(manifest, "jdll", "jdll"), libraries);
  let paths = _strings(manifest, "package_paths", "package_paths", Array.new<Bytes>(0));
  let places = [inDirectory(root, "packages")].appendFrom(_within(root, paths), 0);

  /* The packages only the project's own `dev_dependencies` reach, after the others, are roots for
   * its tests alone. */
  let dependencies = Array.new<Dependency>(0);
  _dependencies(manifest, "dependencies", dependencies);
  _resolve(dependencies, 0, places, sources, libraries);
  let shared = dependencies.len();
  let testSources = Array.new<Bytes>(0);
  _dependencies(manifest, "dev_dependencies", dependencies);
  _resolve(dependencies, shared, places, testSources, libraries);
  { root, sources, testSources, tests, libraries }
};

/** Returns what a compile that names no input, or no output, assumes in directory `dir`: the
 * entry module, the manifest's `entry` or else `Main.jello` in its `src`, and the module's file
 * name, the manifest's `name` or else the directory's own, with each space or `/` made a `-`. A
 * manifest is read when `dir` holds one.
 * @throws a located error for a manifest that is not valid */
export let compileDefaults = fn(dir: Bytes): Tuple<Bytes, Bytes> {
  let entry = "src/Main.jello";
  let name = "";
  let path = inDirectory(dir, "jello.json");

  if (exists(path)) {
    let manifest = _read(path);
    entry = _string(manifest, "entry", inDirectory(_string(manifest, "src", "src"), "Main.jello"));
    name = _string(manifest, "name", "");
  }

  let base = name == "" ? baseName(_realPath(dir)) : name;
  let file = base.replaceAll(" ", "-").replaceAll("/", "-");
  // The file system's root has no name of its own.
  (inDirectory(dir, entry), file == "" ? "main" : file)
};
