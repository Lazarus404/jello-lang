package frontend;

import type { Expr as AstExpr, Program as AstProgram, Type as AstType } from frontend.Ast;
import { bindPatternName, isBindPattern } from frontend.Ast;
import { checkAggregateExpr } from frontend.CheckAggregates;
import { checkEnumExpr, declareEnums } from frontend.CheckEnums;
import { checkValueExpr } from frontend.CheckValues;
import type { Hir } from frontend.Hir;
import { Kind, Op, TYPE_NULL, declareGlobal, declareNative, globalNameOf, innerOf, isKind, kindOf, node, spanOf, typeArg, typeArgCount, typeName, typeOf } from frontend.Hir;
import { firstUninitializedRead } from frontend.InitOrder;
import { Binding, declareScoped, enterModule, exportScoped, resetExports, scoped } from frontend.ModuleScope;
import type { Import, Module } from frontend.Modules;
import { Import, Module } from frontend.Modules;
import { programSyntax } from frontend.Parser;
import type { Syntax } from frontend.Source;
import { Syntax } from frontend.Source;
import {
  beginCheck, checkEffect, checkFunctionBody, checkOperand, checkType, declareFunctions, enterSyntax, finishProgram,
  isDirectFunction, syntaxChild, takeRegexpInits, useAggregateChecks, useEnumChecks, useValueChecks,
} from frontend.TypeCheck;
import { verifyHir } from frontend.VerifyHir;

let _initializers = Array.new<I32>(0);

let _isLoaded = fn(value: AstExpr): Bool {
  match (value) { Variable(name) => match (scoped(name)) { Loaded(_, _) => true, _ => false }, _ => false }
};

let _returnsVoid = fn(ty: AstType): Bool {
  match (ty) { Function(_, result) => match (result) { Named(name) => name == "Void", _ => false }, _ => false }
};

let _marshalled = fn(ty: I32, name: Bytes): I32 {
  let i = 0;

  while (i <= typeArgCount(ty)) {
    let part = i < typeArgCount(ty) ? typeArg(ty, i) : innerOf(ty);

    match (kindOf(part)) {
      Bool, I32, Bytes, Dynamic => null, _ => {
        throw "native " + name + " cannot pass " + typeName(part) + "; natives take and return bool, i32, bytes or dynamic";
        null
      }
    };
    i++;
  }
  ty
};

let _initializeFirst = fn(first: I32, inits: Array<I32>) {
  if (inits.len() == 0) { return null; }
  let out = Array.new<I32>(0);
  let i = 0;

  while (i < first) {
    out.push(_initializers[i]);
    i++;
  }
  i = 0;

  while (i < inits.len()) {
    out.push(inits[i]);
    i++;
  }
  i = first;

  while (i < _initializers.len()) {
    out.push(_initializers[i]);
    i++;
  }
  _initializers = out;
  null
};

let _checkModule = fn(modules: Array<Module>, index: I32, runs: Bool): I32 {
  match (modules[index]) { Module(_, statements, syntax, tail, imports) => {
    let outer = enterSyntax(syntax);
    enterModule(imports, modules, !runs);
    declareEnums(statements, index);

    if (!runs) {
      enterSyntax(outer);
      return -1;
    }
    let first = _initializers.len() as I32;
    let functionIndex = declareFunctions(statements);
    let i = 0;

    while (i < statements.len()) {
      let parent = enterSyntax(syntaxChild(i));

      match (statements[i]) {
        ImportFrom(Native, items, library) => {
          if (library.len() != 1) { throw "a native library is named by one identifier: load { ... } from std;"; }
          let j = 0;

          while (j < items.len()) {
            match (items[j]) { Item(name, alias) => declareScoped(alias == null ? name : alias, Binding.Loaded(library[0], name)) };
            j++;
          }
          null
        },
        ImportFrom(_, _, _) => null,
        LetStmt(_, exported, pattern, _, annotation, value) when (_isLoaded(value)) => {
          let name = bindPatternName(pattern);
          if ((annotation != null) && _returnsVoid(annotation)) { throw "native " + name + " needs a result type: natives without a result are not supported yet"; }
          let ty = annotation == null ? -1 : checkType(annotation);
          if ((ty < 0) || !isKind(ty, Kind.Function)) { throw "a native needs a function type: let " + name + ": (Bytes) -> I32 = ...;"; }

          match (value) { Variable(loaded) => match (scoped(loaded)) {
            Loaded(library, native) => declareScoped(name, Binding.Native(declareNative(library, native, _marshalled(ty, native)))),
            _ => false,
          }, _ => false };
          if (exported) { exportScoped(index, name); }
          null
        },
        LetStmt(_, exported, pattern, _, _, value) when (isDirectFunction(statements[i])) => {
          match (value) { Function(_, _, body, _) => checkFunctionBody(functionIndex, body, syntaxChild(0)), _ => true };
          functionIndex++;
          if (exported) { exportScoped(index, bindPatternName(pattern)); }
          null
        },
        LetStmt(isConst, exported, pattern, typeParams, annotation, value) when (isBindPattern(pattern)) => {
          let name = bindPatternName(pattern);
          if (typeParams.len() != 0) { throw "globals do not support type parameters"; }
          let ty = annotation == null ? -1 : checkType(annotation);
          let checked = checkOperand(value, 0, ty);
          if (ty < 0) { ty = typeOf(checked); } else if (ty != typeOf(checked)) { throw "binding annotation type mismatch: " + name; }
          if (ty == TYPE_NULL) { throw "null needs a type from its context: annotate " + name + " as Null<T>"; }
          let global = declareGlobal(name, ty, !isConst);
          declareScoped(name, Binding.Global(global));
          _initializers.push(node(Op.Declare, 0, 0, 0, [node(Op.InitGlobal, ty, global, 0, [checked])]));
          if (exported) { exportScoped(index, name); }
          null
        },
        LetStmt(_, _, _, _, _, _) => {
          throw "top-level destructuring is not supported yet";
          null
        },
        Expression(value) => {
          _initializers.push(checkEffect(value, 0));
          null
        },
        Enum(_, _, _, _) => null,
        _ => {
          throw "unsupported statement in initial semantic slice";
          null
        },
      };
      enterSyntax(parent);
      i++;
    }
    let checkedTail = tail == null ? -1 : checkOperand(tail, statements.len() as I32, -1);
    _initializeFirst(first, takeRegexpInits());
    enterSyntax(outer);
    checkedTail
  } }
};

let _checkInitOrder = fn() {
  let (binding, global) = firstUninitializedRead();

  if (binding >= 0) {
    match (spanOf(binding)) { Span(path, start, end) => enterSyntax(Syntax.Node(path, start, end, Array.new<Syntax>(0))) };
    throw "global " + globalNameOf(global) + " is read before it is initialized";
  }
  null
};

export let typeCheckModules: (Array<Module>) -> Hir = fn(modules) {
  beginCheck();
  resetExports();
  useEnumChecks(checkEnumExpr);
  useAggregateChecks(checkAggregateExpr);
  useValueChecks(checkValueExpr);
  _initializers = Array.new<I32>(0);
  let entry = (modules.len() - 1) as I32;
  let i = 0;
  let tail = -1;
  let runs = Array.new<Bool>(0);

  while (i <= entry) {
    runs.push(i == entry);
    i++;
  }
  i = entry;

  while (i >= 0) {
    if (runs[i]) {
      match (modules[i]) { Module(_, _, _, _, imports) => {
        let j = 0;

        while (j < imports.len()) {
          match (imports[j]) { Import(_, module, _, typeOnly) => { if (!typeOnly) { runs[module] = true; } } };
          j++;
        }
      } };
    }
    i--;
  }
  i = 0;

  while (i <= entry) {
    tail = _checkModule(modules, i, runs[i]);
    i++;
  }

  match (modules[entry]) { Module(_, _, syntax, _, _) => {
    enterSyntax(syntax);
    if (tail < 0) { throw "program requires a trailing expression"; }
  } };
  _initializers.push(tail);
  let hir = finishProgram(node(Op.Block, typeOf(tail), 0, 1, _initializers));
  _checkInitOrder();
  verifyHir(hir);
  hir
};

export let typeCheckProgramWithSyntax: (AstProgram, Syntax) -> Hir = fn(program, syntax) {
  match (program) { Program(packageName, statements, tail) => {
    match (packageName) {
      None => null, _ => {
        throw "semantic analysis currently requires a package-less program";
        null
      }
    };
    let path = match (syntax) { Node(path, _, _, _) => path };
    typeCheckModules([Module.Module(path, statements, syntax, tail, Array.new<Import>(0))])
  } }
};

export let typeCheckProgram: (AstProgram) -> Hir = fn(program) { typeCheckProgramWithSyntax(program, programSyntax(program)) };
