package frontend;

import type { Program as AstProgram, Stmt, Type as AstType } from frontend.Ast;
import { bindPatternName, isBindPattern } from frontend.Ast;
import { checkAggregateExpr, declareBuiltins } from frontend.CheckAggregates;
import { checkEnumExpr, declareEnums } from frontend.CheckEnums;
import { resetDerived, structuralEquality, unsupported } from frontend.CheckDerived;
import { checkAssertion, declareAssertions } from frontend.CheckTesting;
import { checkValueExpr } from frontend.CheckValues;
import type { Hir } from frontend.Hir;
import { Kind, Op, TYPE_NULL, declareGlobal, declareNative, functionType, globalNameOf, globalTypeOf, innerOf, isKind, kindOf, node, typeArg, typeArgCount, typeName, typeOf } from frontend.Hir;
import { firstUninitializedRead } from frontend.InitOrder;
import { internalRaised } from frontend.Internal;
import { Binding, addImport, declareScoped, enterModule, exportScoped, exportedType, resetExports, scoped } from frontend.ModuleScope;
import type { Import, Module } from frontend.Modules;
import { Import, Module, isHookName, isTestModule, isTestName, moduleName } from frontend.Modules;
import { programSyntax } from frontend.Parser;
import type { Syntax } from frontend.Source;
import { Syntax } from frontend.Source;
import {
  annotatedGlobal, beginCheck, checkAnnotation, bindingType, checkDirect, checkEffect, checkLiteralRanges, checkOperand, declareFunctions, enterNode, enterSyntax, finishProgram,
  checkInitializer, checkTemplate, checkWhile, instantiateTemplates, isDirectFunction, isLoaded, isTemplate, syntaxChild, takeRegexpInits, unsupportedStatement, useAggregateChecks, useAssertionChecks, useEnumChecks, useStructuralEquality, useUnsupported, useValueChecks,
} from frontend.TypeCheck;
import { verifyHir } from frontend.VerifyHir;

let _initializers = Array.new<I32>(0);
let _testing = -1;

let _returnsVoid = fn(ty: AstType): Bool {
  match (ty) { Function(_, result) => match (result) { Named(name) => name == "Void", _ => false }, _ => false }
};

let _marshalled = fn(ty: I32, name: Bytes): I32 {
  let count = typeArgCount(ty);
  if (count > 8) { throw "native " + name + " takes " + Std.string(count) + " arguments; at most 8 are supported"; }
  let i = 0;

  while (i <= count) {
    let part = i < count ? typeArg(ty, i) : innerOf(ty);

    match (kindOf(part)) {
      Bool, I32, Bytes, Dynamic => null, _ => {
        throw "native " + name + " cannot pass " + typeName(part) + "; natives take and return Bool, I32, Bytes or Dynamic";
        null
      }
    };
    i++;
  }
  ty
};

let _initializeFirst = fn(first: I32, inits: Array<I32>) {
  if (inits.len() == 0) { return null; }
  let out = Array.new<I32>(0);
  let i = 0;

  while (i < first) {
    out.push(_initializers[i]);
    i++;
  }
  i = 0;

  while (i < inits.len()) {
    out.push(inits[i]);
    i++;
  }
  i = first;

  while (i < _initializers.len()) {
    out.push(_initializers[i]);
    i++;
  }
  _initializers = out;
  null
};

let _publish = fn(index: I32, name: Bytes, exported: Bool, opened: Bool) {
  if (exported || opened) { exportScoped(index, name, exported); }
  null
};

let _checkSignature = fn(statement: Stmt, test: I32) {
  match (statement) {
    LetStmt(_, _, pattern, _, _, _) when (isBindPattern(pattern)) => {
      let name = bindPatternName(pattern);

      if (isTestName(name) || isHookName(name)) {
        let params = isTestName(name) ? [test] : Array.new<I32>(0);

        if (bindingType(scoped(name)) != functionType(params, TYPE_NULL)) {
          throw "wrong signature for " + name + ", must be: let " + name + " = fn(" + (params.len() == 0 ? "" : "t: Test") + ") { ... }";
        }
      }
      null
    },
    _ => null,
  }
};

let _checkModule = fn(modules: Array<Module>, index: I32, runs: Bool, opened: Bool): I32 {
  match (modules[index]) { Module(_, dotted, statements, syntax, tail, imports) => {
    let outer = enterSyntax(syntax);
    enterModule(index, imports, modules);
    let k = 0;

    while (k < imports.len()) {
      let at = match (imports[k]) { Import(_, _, _, _, _, statement), Namespace(_, _, _, statement) => statement };

      if (at < 0) { addImport(imports[k], modules, !runs); } else {
        let parent = enterSyntax(syntaxChild(at));
        addImport(imports[k], modules, !runs);
        enterSyntax(parent);
      }
      k++;
    }
    declareEnums(statements, index, opened);

    if (!runs) {
      enterSyntax(outer);
      return -1;
    }
    if (index == _testing) { declareAssertions(index); }
    let test = isTestModule(dotted) && (_testing >= 0) ? exportedType(_testing, "Test") : -1;
    let first = _initializers.len() as I32;
    let functionIndex = declareFunctions(statements);
    let i = 0;

    while (i < statements.len()) {
      let parent = enterSyntax(syntaxChild(i));

      match (statements[i]) {
        ImportFrom(Native, items, library) => {
          if (library.len() != 1) { throw "a native library is named by one identifier: load { ... } from std;"; }
          let j = 0;

          while (j < items.len()) {
            match (items[j]) { Item(name, alias) => declareScoped(alias == null ? name : alias, Binding.Loaded(library[0], name)) };
            j++;
          }
          null
        },
        ImportFrom(_, _, _), ImportModule(_, _, _) => null,
        LetStmt(_, exported, pattern, _, annotation, value) when (isLoaded(value)) => {
          let name = bindPatternName(pattern);
          if ((annotation != null) && _returnsVoid(annotation)) { throw "native " + name + " needs a result type: natives without a result are not supported yet"; }
          let ty = checkAnnotation(annotation);
          if ((ty < 0) || !isKind(ty, Kind.Function)) { throw "a native needs a function type: let " + name + ": (Bytes) -> I32 = ...;"; }

          match (value) { Variable(loaded) => match (scoped(loaded)) {
            Loaded(library, native) => declareScoped(name, Binding.Native(declareNative(library, native, _marshalled(ty, native)))),
            _ => false,
          }, _ => false };
          _publish(index, name, exported, opened);
          null
        },
        LetStmt(_, exported, pattern, _, _, _) when (isTemplate(statements[i])) => {
          let name = bindPatternName(pattern);
          checkTemplate(name);
          _publish(index, name, exported, opened);
          null
        },
        LetStmt(_, exported, pattern, _, _, value) when (isDirectFunction(statements[i])) => {
          checkDirect(functionIndex);
          functionIndex++;
          _publish(index, bindPatternName(pattern), exported, opened);
          null
        },
        LetStmt(isConst, exported, pattern, typeParams, annotation, value) when (isBindPattern(pattern)) => {
          let name = bindPatternName(pattern);
          if (typeParams.len() != 0) { throw "globals do not support type parameters"; }
          let global = annotation == null ? -1 : annotatedGlobal(i);
          let checked = checkInitializer(value, global < 0 ? -1 : globalTypeOf(global), name);
          let ty = typeOf(checked);

          if (global < 0) {
            global = declareGlobal(name, ty, !isConst);
            declareScoped(name, Binding.Global(global));
          }
          _initializers.push(node(Op.Declare, 0, 0, 0, [node(Op.InitGlobal, ty, global, 0, [checked])]));
          _publish(index, name, exported, opened);
          null
        },
        LetStmt(_, _, _, _, _, _) => {
          throw "top-level destructuring is not supported yet";
          null
        },
        Expression(value) => {
          _initializers.push(checkEffect(value, 0));
          null
        },
        While(condition, body) => {
          _initializers.push(checkWhile(condition, body));
          null
        },
        Enum(_, _, _, _) => null,
        _ => {
          throw unsupportedStatement(statements[i]);
          null
        },
      };
      if (test >= 0) { _checkSignature(statements[i], test); }
      enterSyntax(parent);
      i++;
    }
    let checkedTail = tail == null ? -1 : checkOperand(tail, statements.len() as I32, -1);
    _initializeFirst(first, takeRegexpInits());
    enterSyntax(outer);
    checkedTail
  } }
};

let _checkInitOrder = fn() {
  let (binding, global) = firstUninitializedRead();

  if (binding >= 0) {
    enterNode(binding);
    throw "global " + globalNameOf(global) + " is read before it is initialized";
  }
  null
};

export let typeCheckModules: (Array<Module>) -> Hir = fn(modules) {
  beginCheck();
  resetExports();
  useEnumChecks(checkEnumExpr);
  useAggregateChecks(checkAggregateExpr);
  declareBuiltins();
  useValueChecks(checkValueExpr);
  useAssertionChecks(checkAssertion);
  useStructuralEquality(structuralEquality);
  useUnsupported(unsupported);
  resetDerived();
  _initializers = Array.new<I32>(0);
  let entry = (modules.len() - 1) as I32;
  let i = 0;
  let tail = -1;
  _testing = -1;

  while (i <= entry) {
    if (moduleName(modules[i]) == "std.testing") { _testing = i; }
    i++;
  }
  i = 0;
  let runs = Array.new<Bool>(0);
  let opened = Array.new<Bool>(0);

  while (i <= entry) {
    runs.push(i == entry);
    opened.push(false);
    i++;
  }
  i = entry;

  while (i >= 0) {
    if (runs[i]) {
      match (modules[i]) { Module(_, _, _, _, _, imports) => {
        let j = 0;

        while (j < imports.len()) {
          match (imports[j]) {
            Import(_, module, _, typeOnly, privately, _) => {
              if (!typeOnly) { runs[module] = true; }
              if (privately) { opened[module] = true; }
            },
            Namespace(_, module, privately, _) => {
              runs[module] = true;
              if (privately) { opened[module] = true; }
            },
          };
          j++;
        }
      } };
    }
    i--;
  }
  i = 0;

  try {
    while (i <= entry) {
      tail = _checkModule(modules, i, runs[i], opened[i]);
      i++;
    }
    instantiateTemplates();
    _initializeFirst(0, takeRegexpInits());

    match (modules[entry]) { Module(_, _, _, syntax, _, _) => {
      enterSyntax(syntax);
      if (tail < 0) { throw "program requires a trailing expression"; }
    } };
  } catch (e) {
    if (!internalRaised()) { checkLiteralRanges(); }
    throw e;
  }
  _initializers.push(tail);
  let hir = finishProgram(node(Op.Block, typeOf(tail), 0, 1, _initializers));
  _checkInitOrder();
  verifyHir(hir);
  hir
};

export let typeCheckProgramWithSyntax: (AstProgram, Syntax) -> Hir = fn(program, syntax) {
  match (program) { Program(packageName, statements, tail) => {
    match (packageName) {
      None => null, _ => {
        throw "semantic analysis currently requires a package-less program";
        null
      }
    };
    let path = match (syntax) { Node(path, _, _, _, _) => path };
    typeCheckModules([Module.Module(path, "", statements, syntax, tail, Array.new<Import>(0))])
  } }
};

export let typeCheckProgram: (AstProgram) -> Hir = fn(program) { typeCheckProgramWithSyntax(program, programSyntax(program)) };
