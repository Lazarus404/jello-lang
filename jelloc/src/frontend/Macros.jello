package frontend;

import type { Expr, Pattern, Program, QuoteBody, Stmt, Type } from frontend.syntax.Ast;
import {
  BinaryOp, Expr, FloatSize, IntSize, Pattern, Stmt, Type, UnaryOp, integerValue, wideIntegerValue
} from frontend.syntax.Ast;
import type { Located } from frontend.syntax.Rewrite;
import { Located, rewrite } from frontend.syntax.Rewrite;
import type { SourceSpan, Syntax } from frontend.syntax.Source;
import { relocated, sourceLocation, syntaxSpan } from frontend.syntax.Source;
import { isName, lexFailure, lexFile } from frontend.syntax.Lexer;
import {
  parseFailureSpan, parseProgram, programSyntax, takeSyntaxErrors
} from frontend.syntax.Parser;
import { E0901, E1000, E1001, E1002, E1003, coded, uncoded } from support.Codes;
import { internalError } from support.Internal;

load { image_run } from vm;

let _imageRun: (Bytes, Bytes, I64) -> Bytes = image_run;

const _MAX_DEPTH = 32;
const _MAX_NODES = 4096;
const _FUEL: I64 = 100000000;

typedef Definition = {
  let path: Bytes;
  let name: Bytes;
  let exported: Bool;
  let index: I32;
  let params: Array<Bytes>;
  let quotes: Array<Tuple<QuoteBody, Syntax>>;
  let scope: Array<Tuple<Bytes, I32>>;
};

enum Fragment {
  Argument(index: I32);
  Quoted(index: I32, holes: Array<Fragment>);
  Parsed(source: Bytes, kind: Bytes);
  Name(name: Bytes);
  Literal(kind: I32, text: Bytes);
}

let _definitions = Array.new<Definition>(0);
let _imagePaths = Array.new<Bytes>(0);
let _images = Array.new<Bytes>(0);
let _std = "";
let _names = 0;
let _failure: ?SourceSpan = null;

let _visible = Array.new<Tuple<Bytes, I32>>(0);
let _nodes = 0;
let _depth = 0;

let _macro = -1;
let _arguments = Array.new<Expr>(0);
let _placed = Array.new<Bool>(0);
let _call: Syntax = {
  path: "",
  start: 0,
  end: 0,
  children: [],
  patterns: []
};

export let macroFailureSpan = fn(): ?SourceSpan { _failure };

export let beginMacros = fn(std: Bytes) {
  _definitions = Array.new<Definition>(0);
  _imagePaths = Array.new<Bytes>(0);
  _images = Array.new<Bytes>(0);
  _std = std;
  _names = 0;
  _failure = null;
  null
};

let _leaf = fn(at: Syntax): Syntax {
  { ...at, children: [], patterns: [] }
};

let _node = fn(at: Syntax, children: Array<Syntax>): Syntax {
  { ...at, children, patterns: [] }
};

let _placedAtCall = fn(syntax: Syntax): Syntax {
  relocated(syntax, _call.path, _call.start, _call.end)
};

let _at = fn(syntax: Syntax, message: Bytes): Bytes {
  _failure = syntaxSpan(syntax);
  message
};

let _failed = fn(code: Bytes, message: Bytes): Bytes {
  let name = _definitions[_macro].name;
  _at(_call, coded(code, `macro ${name} ${message}`))
};

let _quotedCall = fn(
  index: I32,
  holes: Array<Tuple<Expr, Syntax>>,
  syntax: Syntax
): Tuple<Expr, Syntax> {
  let values = Array.new<Expr>(0);
  let valueSyntax = Array.new<Syntax>(0);

  for ((value, at) in holes) {
    values.push(Expr.Cast(value, Type.Named("Dynamic")));
    valueSyntax.push(_node(at, [at]));
  }

  let callee = Expr.Member(Expr.Variable("Macro"), "quoted");
  let args = [Expr.Integer(Std.string(index), IntSize.Infer), Expr.Array(values)];
  let calleeAt = _node(syntax, [_leaf(syntax)]);
  let at = _node(syntax, [calleeAt, _leaf(syntax), _node(syntax, valueSyntax)]);
  (Expr.Call(callee, [], args), at)
};

let _quoted = fn(body: QuoteBody, syntax: Syntax): Located {
  match (body) {
    Expression(value) => Located.Expression(value, syntax.children[0]),
    Statement(value) => Located.Statements([value], [syntax.children[0]]),
    Statements(values) => Located.Statements(values, syntax.children),
    Pattern(value) => Located.Pattern(value, syntax.patterns[0]),
    Type(value) => Located.Type(value),
  }
};

let _holes = fn(body: QuoteBody, syntax: Syntax): Array<Tuple<Expr, Syntax>> {
  let holes = Array.new<Tuple<Expr, Syntax>>(0);
  rewrite(_quoted(body, syntax), fn(node: Located): ?Located {
    match (node) {
      Expression(Unquote(value), at) => {
        holes.push((value, at.children[0]));
        node
      },
      Pattern(Unquote(value), at) => {
        holes.push((value, at.children[0]));
        node
      },
      Type(Unquote(name)) => {
        holes.push((Expr.Variable(name), _leaf(syntax)));
        node
      },
      Expression(Quote(_, _), at) => {
        throw _at(at, coded(E1001, "a quote cannot hold another quote"));
      },
      _ => null,
    }
  });
  holes
};

let _body = fn(body: Located, quotes: Array<Tuple<QuoteBody, Syntax>>): Located {
  rewrite(body, fn(node: Located): ?Located {
    match (node) {
      Statements(values, syntax) => match (values[0]) {
        ImportModule(_, _, _), ImportFrom(_, _, _) => {
          throw _at(syntax[0], coded(E1000, "a macro body cannot import or load"));
        },
        Macro(_, _, _, _) => {
          throw _at(syntax[0], coded(E1000, "a macro body cannot define a macro"));
        },
        Expression(Quote(_, _)) => {
          let quoted = match (values[0]) { Expression(quoted) => quoted, _ => Expr.Null };

          match (_body(Located.Expression(quoted, syntax[0].children[0]), quotes)) {
            Expression(call, at) => {
              let emit = Expr.Call(Expr.Member(Expr.Variable("Macro"), "emit"), [], [call]);
              let emitAt = _node(at, [_node(at, [_leaf(at)]), at]);
              Located.Statements([Stmt.Expression(emit)], [_node(syntax[0], [emitAt])])
            },
            _ => null,
          }
        },
        _ => null,
      },
      Expression(Quote(_, quoted), syntax) => {
        let index = quotes.len();
        quotes.push((quoted, syntax));

        let holes = _holes(quoted, syntax);
        let made = Array.new<Tuple<Expr, Syntax>>(0);

        for ((value, at) in holes) {
          match (_body(Located.Expression(value, at), quotes)) {
            Expression(out, outAt) => made.push((out, outAt)),
            _ => null,
          };
        }

        let (call, at) = _quotedCall(index, made, syntax);
        Located.Expression(call, at)
      },
      Expression(Unquote(_), syntax) => {
        throw _at(syntax, coded(E1001, "unquote is only allowed inside a quote"));
      },
      _ => null,
    }
  })
};

let _macros = fn(statements: Array<Stmt>, syntax: Array<Syntax>): Array<Tuple<Stmt, Syntax>> {
  let out = Array.new<Tuple<Stmt, Syntax>>(0);

  for (i, statement in statements) {
    match (statement) {
      Macro(_, _, _, _) => out.push((statement, syntax[i])),
      _ => null,
    };
  }
  out
};

const _ARGUMENTS = "__arguments";
const _BODY = "__body";

export let expanderSource = fn(
  statements: Array<Stmt>,
  syntax: Array<Syntax>
): Tuple<Bytes, Array<Located>> {
  let macros = _macros(statements, syntax);
  let functions = Array.new<Bytes>(0);
  let bodies = Array.new<Located>(0);

  for (defined in macros) {
    match (defined) {
      (Macro(_, _, params, body), at) => {
        let quotes = Array.new<Tuple<QuoteBody, Syntax>>(0);
        bodies.push(_body(Located.Statements(body, at.children), quotes));

        let bindings = Array.new<Bytes>(0);

        for (p, param in params) {
          bindings.push(`let ${param} = ${_ARGUMENTS}[${p}]; `);
        }
        let params = `${_ARGUMENTS}: Array<Fragment>`;
        functions.push(`fn(${params}): Null { ${bindings.join("")}${_BODY}; }`);
      },
      _ => null,
    };
  }

  let source = "import std.macro.Macro as Macro;\n"
    + "import type { Fragment } from std.macro.Macro;\n"
    + `Macro.run([\n  ${functions.join(",\n  ")}\n])\n`;
  (source, bodies)
};

export let spliceBodies = fn(node: Located, bodies: Array<Located>): Located {
  let next = 0;
  let out = rewrite(node, fn(inner: Located): ?Located {
    match (inner) {
      Statements([Expression(Variable(name))], _)
        when ((name == _BODY) && (next < bodies.len())) => {
        next++;
        bodies[next - 1]
      },
      _ => null,
    }
  });
  if (next != bodies.len()) { internalError("a macro program does not hold each macro's body"); }
  out
};

const _RAN = 0;
const _OUT_OF_FUEL = 2;

let _image = fn(path: Bytes): Bytes {
  let known = _imagePaths.indexOf(path);
  if (known >= 0) { return _images[known]; }

  let std = _std == "" ? "" : `--std\0${_std}\0`;
  let args = `${path}\0--expanders\0${std}`;
  let out = _imageRun("", args, 0);
  let made = Bytes.slice(out, 1, out.len() - 1);

  if (Bytes.get_u8(out, 0) != _RAN) {
    _failure = null;
    throw made;
  }

  _imagePaths.push(path);
  _images.push(made);
  made
};

let _define = fn(path: Bytes, index: I32, statement: Stmt, syntax: Syntax) {
  match (statement) {
    Macro(exported, name, params, body) => {
      if (_visibleIndex(name) >= 0) {
        throw _at(syntax, coded(E1000, `macro ${name} is already defined`));
      }

      let quotes = Array.new<Tuple<QuoteBody, Syntax>>(0);
      _body(Located.Statements(body, syntax.children), quotes);
      _definitions.push({ path, name, exported, index, params, quotes, scope: _visible });
      _visible.push((name, _definitions.len() - 1));
    },
    _ => null,
  };
  null
};

let _scopeIndex = fn(scope: Array<Tuple<Bytes, I32>>, name: Bytes): I32 {
  for ((local, index) in scope) {
    if (local == name) { return index; }
  }
  -1
};

let _visibleIndex = fn(name: Bytes): I32 { _scopeIndex(_visible, name) };

let _importMacro = fn(local: Bytes, path: Bytes, module: Bytes, name: Bytes, at: SourceSpan) {
  _failure = at;
  if (_visibleIndex(local) >= 0) { throw coded(E1000, `macro ${local} is already defined`); }

  for (i, definition in _definitions) {
    if ((definition.path == path) && (definition.name == name)) {
      if (!definition.exported) {
        throw coded(E1000, `macro ${name} is not exported by ${module}`);
      }
      _visible.push((local, i));
      _failure = null;
      return null;
    }
  }
  throw coded(E1000, `${module} defines no macro ${name}`);
};

let _form = fn(value: Expr): Bytes {
  let (negative, literal) = match (value) {
    Unary(Negate, inner) => (true, inner),
    _ => (false, value),
  };
  let sign = negative ? "-" : "";

  try {
    match (literal) {
      Integer(digits, Infer), Integer(digits, I32) => `i${integerValue(digits, negative)}`,
      Integer(digits, I64) => `l${wideIntegerValue(digits, negative)}`,
      Float(text, Infer), Float(text, F64) => `f${sign}${text}`,
      Bool(flag) when (!negative) => flag ? "b1" : "b0",
      Null when (!negative) => "n",
      Bytes(text) when (!negative) => `s${text.toHex()}`,
      _ => "",
    }
  } catch { "" }
};

let _output = "";
let _read = 0;

let _find = fn(text: Bytes, c: I32, start: I32): I32 {
  let i = start;
  while ((i < text.len()) && (Bytes.get_u8(text, i) != c)) { i++; }
  i
};

let _upTo = fn(end: I32): Bytes {
  let start = _read;
  _read = _find(_output, end, start) + 1;
  Bytes.slice(_output, start, _read - 1 - start)
};

let _number = fn(): I32 { integerValue(_upTo(";".code), false) };

let _text = fn(): Bytes {
  let length = _number();
  _read += length;
  Bytes.slice(_output, _read - length, length)
};

let _fragment = fn(): Fragment {
  let tag = Bytes.get_u8(_output, _read);
  _read++;

  let fragment = match (tag) {
    "p".code => Fragment.Argument(_number()),
    "t".code => {
      let index = _number();
      let count = _number();
      let holes = Array.new<Fragment>(0);
      while (holes.len() < count) { holes.push(_fragment()); }
      Fragment.Quoted(index, holes)
    },
    "s".code => {
      let kind = _upTo(":".code);
      Fragment.Parsed(_text(), kind)
    },
    "g".code => {
      let name = _text();
      if (!isName(name)) { throw _failed(E1003, "emitted a Fragment.Name that is not a name"); }
      Fragment.Name(name)
    },
    "i".code, "l".code => Fragment.Literal(tag, _upTo(";".code)),
    "f".code, "y".code => Fragment.Literal(tag, _text()),
    "b".code => {
      _read++;
      Fragment.Literal(tag, Bytes.slice(_output, _read - 1, 1))
    },
    "n".code => Fragment.Literal(tag, ""),
    _ => {
      internalError("a macro's output is malformed");
      Fragment.Argument(0)
    },
  };

  match (fragment) {
    Name(_), Literal(_, _) => _made(1),
    _ => null,
  };
  fragment
};

let _literalExpression = fn(kind: I32, text: Bytes): Tuple<Expr, Syntax> {
  let negative = (text.len() > 0) && (Bytes.get_u8(text, 0) == "-".code);
  let digits = negative ? Bytes.slice(text, 1, text.len() - 1) : text;
  let at = _leaf(_call);

  let quotient = fn(dividend: Bytes): Tuple<Expr, Syntax> {
    let zero = Expr.Float("0.0", FloatSize.Infer);
    let divided = Expr.Binary(BinaryOp.Divide, Expr.Float(dividend, FloatSize.Infer), zero);
    (divided, _node(_call, [at, at]))
  };

  let (value, valueAt) = match (kind) {
    "i".code => (Expr.Integer(digits, IntSize.Infer), at),
    "l".code => (Expr.Integer(digits, IntSize.I64), at),
    "f".code when (digits == "NaN") => quotient("0.0"),
    "f".code when (digits == "Infinity") => quotient("1.0"),
    "f".code => (Expr.Float(digits, FloatSize.Infer), at),
    "b".code => (Expr.Bool(text == "1"), at),
    "y".code => (Expr.Bytes(text), at),
    _ => (Expr.Null, at),
  };

  match (kind) {
    "i".code, "l".code, "f".code when (negative) =>
      (Expr.Unary(UnaryOp.Negate, value), _node(_call, [valueAt])),
    _ => (value, valueAt),
  }
};

let _parseFailure = fn(message: Bytes, source: Bytes, shift: I32): Bytes {
  let (lexedAt, lexed) = lexFailure();
  let span = parseFailureSpan();
  let at = lexedAt;
  let why = lexed;

  if (lexedAt < 0) {
    at = span == null ? -1 : span.start;
    why = Bytes.slice(message, 0, _find(message, "\n".code, 0));
    if (why.startsWith("ParseError: ")) { why = Bytes.slice(why, 12, why.len() - 12); }
  }
  why = uncoded(why);
  if (at < 0) { return why; }

  let offset = at - shift;
  let clamped = offset < 0 ? 0 : (offset > source.len() ? source.len() : offset);
  let (line, column) = sourceLocation(source, clamped);
  `at ${line}:${column}, ${why}`
};

let _parsed = fn(source: Bytes, kind: Bytes): Located {
  let prefix = kind == "auto" ? "quote { " : `quote.${kind} { `;

  let program = try {
    parseProgram(lexFile(`${prefix}${source}\n}`, "Macro.parse"))
  } catch (e) {
    takeSyntaxErrors();
    let why = _parseFailure(Std.string(e), source, prefix.len());
    throw _failed(E1003, `emitted text that does not parse: ${why}`);
  };

  let syntax = _placedAtCall(programSyntax(program)).children;

  match (program) {
    { statements: [], tail: Quote(_, body) } => {
      _made(_count(syntax[0]));
      _marked(_quoted(body, syntax[0]), _definitions[_macro].scope)
    },
    _ => { throw _failed(E1003, `emitted text that does not parse as ${kind}`); },
  }
};

let _argument = fn(index: I32): Located {
  if ((index < 0) || (index >= _arguments.len())) {
    throw _failed(E1003, "emitted an argument it was not given");
  }

  let at = _call.children[index + 1];
  if (_placed[index]) { _made(_count(at)); }
  _placed[index] = true;

  match (_arguments[index]) {
    Quote(_, body) => {
      let quoted = _quoted(body, at);
      let cannot = "a quote passed to a macro cannot unquote";
      rewrite(quoted, fn(node: Located): ?Located {
        match (node) {
          Expression(Unquote(_), unquoted), Pattern(Unquote(_), unquoted) => {
            throw _at(unquoted, coded(E1002, cannot));
          },
          Type(Unquote(_)) => { throw _at(at, coded(E1002, cannot)); },
          _ => null,
        }
      });
      quoted
    },
    value => Located.Expression(value, at),
  }
};

let _made = fn(n: I32) {
  _nodes += n;

  if (_nodes > _MAX_NODES) {
    throw _failed(E0901, `made more than ${_MAX_NODES} syntax nodes in this module`);
  }
  null
};

const _MARK = "\0";

let _marked = fn(node: Located, scope: Array<Tuple<Bytes, I32>>): Located {
  rewrite(node, fn(inner: Located): ?Located {
    match (inner) {
      Expression(Unquote(_), _), Pattern(Unquote(_), _) => inner,
      Expression(Call(Variable(name), [], args), at) when (_scopeIndex(scope, name) >= 0) => {
        let children = at.children;
        let marked = Array.new<Expr>(0);

        for (i, arg in args) {
          match (_marked(Located.Expression(arg, children[i + 1]), scope)) {
            Expression(value, _) => marked.push(value),
            _ => null,
          };
        }
        let callee = Expr.Variable(_MARK + Std.string(_scopeIndex(scope, name)));
        Located.Expression(Expr.Call(callee, [], marked), at)
      },
      _ => null,
    }
  })
};

let _instantiate = fn(index: I32, holes: Array<Fragment>): Located {
  let definition = _definitions[_macro];
  let quotes = definition.quotes;

  if ((index < 0) || (index >= quotes.len())) {
    throw _failed(E1003, "emitted a quote it does not have");
  }

  let (body, defined) = quotes[index];
  let syntax = _placedAtCall(defined);
  _made(_count(defined));

  let next = 0;

  let take = fn(): Fragment {
    if (next >= holes.len()) { throw _failed(E1003, "emitted a quote with too few unquotes"); }
    next++;
    holes[next - 1]
  };
  let out = rewrite(_marked(_quoted(body, syntax), definition.scope), fn(node: Located): ?Located {
    match (node) {
      Statements([Expression(Unquote(_))], _) => {
        let (values, at) = _statementsOf(take());
        Located.Statements(values, at)
      },
      Expression(Unquote(_), _) => {
        let (value, at) = _expressionOf(take());
        Located.Expression(value, at)
      },
      Pattern(Unquote(_), _) => {
        let (value, at) = _patternOf(take());
        Located.Pattern(value, at)
      },
      Type(Unquote(_)) => Located.Type(_typeOf(take())),
      _ => null,
    }
  });
  if (next != holes.len()) { throw _failed(E1003, "emitted a quote with too many unquotes"); }
  out
};

let _located = fn(fragment: Fragment): Located {
  match (fragment) {
    Argument(index) => _argument(index),
    Quoted(index, holes) => _instantiate(index, holes),
    Parsed(source, kind) => _parsed(source, kind),
    Name(name) => Located.Expression(Expr.Variable(name), _leaf(_call)),
    Literal(kind, text) => {
      let (value, at) = _literalExpression(kind, text);
      Located.Expression(value, at)
    },
  }
};

let _misplaced = fn(made: Located, needed: Bytes): Bytes {
  let kind = match (made) {
    Expression(_, _) => "an expression",
    Statements(_, _) => "statements",
    Pattern(_, _) => "a pattern",
    Type(_) => "a type",
  };
  _failed(E1003, `emitted ${kind} where ${needed} is needed`)
};

let _expressionOf = fn(fragment: Fragment): Tuple<Expr, Syntax> {
  match (_located(fragment)) {
    Expression(value, at) => (value, at),
    Statements([Expression(value)], [at]) => (value, at.children[0]),
    made => { throw _misplaced(made, "an expression"); },
  }
};

let _statementsOf = fn(fragment: Fragment): Tuple<Array<Stmt>, Array<Syntax>> {
  match (fragment) {
    Name(_) => { throw _failed(E1003, "emitted a name where a statement is needed"); },
    _ => match (_located(fragment)) {
      Expression(value, at) => ([Stmt.Expression(value)], [_node(at, [at])]),
      Statements(values, at) => (values, at),
      made => { throw _misplaced(made, "a statement"); },
    },
  }
};

let _patternOf = fn(fragment: Fragment): Tuple<Pattern, Syntax> {
  match (_located(fragment)) {
    Pattern(value, at) => (value, at),
    Expression(Variable(name), at) => (Pattern.BindPattern(name), at),
    Expression(Integer(digits, size), at) => (Pattern.Integer(digits, size), at),
    Expression(Unary(Negate, Integer(digits, size)), at) =>
      (Pattern.Integer(`-${digits}`, size), at),
    Expression(Float(text, size), at) => (Pattern.Float(text, size), at),
    Expression(Unary(Negate, Float(text, size)), at) => (Pattern.Float(`-${text}`, size), at),
    Expression(Bool(flag), at) => (Pattern.Bool(flag), at),
    Expression(Bytes(text), at) => (Pattern.Bytes(text), at),
    Expression(Null, at) => (Pattern.Null, at),
    made => { throw _misplaced(made, "a pattern"); },
  }
};

let _typeOf = fn(fragment: Fragment): Type {
  match (_located(fragment)) {
    Type(value) => value,
    Expression(Variable(name), _) => Type.Named(name),
    made => { throw _misplaced(made, "a type"); },
  }
};

let _count = fn(syntax: Syntax): I32 {
  let { children, patterns } = syntax;
  let n = 1;

  for (child in children) {
    n += _count(child);
  }

  for (pattern in patterns) {
    n += _count(pattern);
  }
  n
};

let _run = fn(index: I32, call: Expr, syntax: Syntax): Array<Fragment> {
  let args = match (call) { Call(_, _, args) => args, _ => [] };
  _macro = index;
  _arguments = args;
  _call = syntax;
  _placed = Array.new<Bool>(args.len());

  let definition = _definitions[index];
  let params = definition.params;

  if (args.len() != params.len()) {
    let noun = (params.len() == 1) ? "argument" : "arguments";
    throw _failed(E1002, `takes ${params.len()} ${noun}, not ${args.len()}`);
  }

  let entries = [Std.string(definition.index), Std.string(_names)];

  for (arg in args) {
    entries.push(_form(arg));
  }
  let image = _image(definition.path);
  let out = _imageRun(image, `${entries.join("\0")}\0`, _FUEL);

  let tag = Bytes.get_u8(out, 0);

  if (tag == _OUT_OF_FUEL) {
    throw _failed(E1003, `runs too long; it took more than ${_FUEL} steps`);
  }
  if (tag != _RAN) { throw _failed(E1003, `failed: ${Bytes.slice(out, 1, out.len() - 1)}`); }

  _output = out;
  _read = 1;
  _names = _number();
  let fragments = Array.new<Fragment>(0);
  while (_read < _output.len()) { fragments.push(_fragment()); }
  fragments
};

let _deeper = fn(node: Located): Located {
  if (_depth >= _MAX_DEPTH) {
    throw _failed(E0901, `expands ${_MAX_DEPTH} levels deep; does it call itself without end?`);
  }
  _depth++;
  let out = _expandIn(node);
  _depth--;
  out
};

let _calledMacro = fn(call: Expr): I32 {
  match (call) {
    Call(Variable(name), [], _) when (name.startsWith(_MARK)) =>
      integerValue(Bytes.slice(name, 1, name.len() - 1), false),
    Call(Variable(name), [], _) => _visibleIndex(name),
    _ => -1,
  }
};

let _expandStatement = fn(index: I32, call: Expr, syntax: Syntax): Located {
  let fragments = _run(index, call, syntax.children[0]);
  let statements = Array.new<Stmt>(0);
  let made = Array.new<Syntax>(0);

  for (fragment in fragments) {
    let (values, at) = _statementsOf(fragment);

    for (j, value in values) {
      match (value) {
        ImportModule(_, _, _), ImportFrom(_, _, _) => {
          throw _failed(E1003, "emitted an import, which a module makes itself");
        },
        Macro(_, _, _, _) => { throw _failed(E1003, "emitted a macro definition"); },
        _ => null,
      };
      statements.push(value);
      made.push(at[j]);
    }
  }
  _deeper(Located.Statements(statements, made))
};

let _expandExpression = fn(index: I32, call: Expr, syntax: Syntax): Located {
  let fragments = _run(index, call, syntax);

  if (fragments.len() != 1) {
    let needed = "is called where an expression is needed, so it must emit one expression";
    throw _failed(E1002, `${needed}, not ${fragments.len()} fragments`);
  }

  let (value, at) = _expressionOf(fragments[0]);
  _deeper(Located.Expression(value, at))
};

let _expandIn = fn(node: Located): Located {
  rewrite(node, fn(inner: Located): ?Located {
    match (inner) {
      Expression(Quote(_, _), _) => inner,
      Statements([Expression(call)], syntax) => {
        let index = _calledMacro(call);
        (index < 0) ? null : _expandStatement(index, call, syntax[0])
      },
      Expression(call, syntax) => {
        let index = _calledMacro(call);
        (index < 0) ? null : _expandExpression(index, call, syntax)
      },
      _ => null,
    }
  })
};

export let hasMacros = fn(statements: Array<Stmt>): Bool {
  for (statement in statements) {
    match (statement) {
      Macro(_, _, _, _), ImportFrom(MacroOnly, _, _) => { return true; },
      _ => null,
    };
  }
  false
};

export let expandModule = fn(
  path: Bytes,
  statements: Array<Stmt>,
  syntax: Syntax,
  tail: ?Expr,
  imported: Array<Tuple<Bytes, Bytes, Bytes, Bytes, SourceSpan>>
): Tuple<Array<Stmt>, Syntax, ?Expr, Array<I32>> {
  _visible = Array.new<Tuple<Bytes, I32>>(0);
  _nodes = 0;
  _depth = 0;
  let children = syntax.children;
  let macros = _macros(statements, children);

  for ((local, file, module, name, at) in imported) {
    _importMacro(local, file, module, name, at);
  }

  for (i, (definition, at) in macros) {
    _define(path, i, definition, at);
  }

  let out = Array.new<Stmt>(0);
  let outSyntax = Array.new<Syntax>(0);
  let moved = Array.new<I32>(0);

  for (i, statement in statements) {
    match (statement) {
      Macro(_, _, _, _), ImportFrom(MacroOnly, _, _) => moved.push(-1),
      _ => {
        moved.push(out.len());

        match (_expandIn(Located.Statements([statement], [children[i]]))) {
          Statements(values, at) => {
            out.appendFrom(values, 0);
            outSyntax.appendFrom(at, 0);
            null
          },
          _ => null,
        };
      },
    };
  }

  let expandedTail = tail;

  if (tail != null) {
    match (_expandIn(Located.Expression(tail, children[children.len() - 1]))) {
      Expression(value, at) => {
        expandedTail = value;
        outSyntax.push(at);
      },
      _ => null,
    };
  }
  let root: Syntax = { ...syntax, children: outSyntax, patterns: [] };
  (out, root, expandedTail, moved)
};
