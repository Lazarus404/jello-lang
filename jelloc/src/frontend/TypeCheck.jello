package frontend;

import type {
  AssignOp, BinaryOp, Block as AstBlock, Expr as AstExpr, IncDecOp, IntSize, Parameter, Pattern, Stmt, Type as AstType, UnaryOp,
} from frontend.Ast;
import { Block as AstBlock, Expr as AstExpr, bindPatternName, integerValue, isBindPattern, wideIntegerValue } from frontend.Ast;
import type { Hir } from frontend.Hir;
import frontend.Hir as H;
import { Kind, Op } from frontend.Hir;
import { Binding, declareScoped, isImported, namespaceMember, scoped, scopedType } from frontend.ModuleScope;
import {
  assignLocal, assignmentMark, enterLoop, isNarrowed, keepNarrowings, leaveLoop, narrow, narrowings, resetNarrowing, setNarrowings,
} from frontend.Narrowing;
import type { SourceSpan, Syntax } from frontend.Source;
import { SourceSpan, Syntax } from frontend.Source;

let _names = Array.new<Bytes>(0);
let _ids = Array.new<I32>(0);
let _nextBinding = 0;
let _bindingTypes = Array.new<I32>(0);
let _mutable = Array.new<Bool>(0);
let _assigned = Array.new<Bool>(0);
let _captured = Array.new<Bool>(0);
let _scopeStart = 0;
let _loops = 0;
let _tries = 0;
enum Frame { Frame(names: Array<Bytes>, ids: Array<I32>); }
let _frames = Array.new<Frame>(0);
let _captures = [Array.new<I32>(0)];
let _sources = [Array.new<I32>(0)];
let _functionNames = Array.new<Bytes>(0);
let _functionTypes = Array.new<I32>(0);
let _functionParams = Array.new<Array<Bytes>>(0);
let _functionNodes = Array.new<I32>(0);
let _functionParamTypes = Array.new<Array<I32>>(0);
let _result = -1;
let _noSyntax = fn(): Syntax { Syntax.Node("", 0, 0, Array.new<Syntax>(0), Array.new<Syntax>(0)) };
let _syntax = _noSyntax();

export let enterSyntax: (Syntax) -> Syntax = fn(syntax) {
  let outer = _syntax;
  _syntax = syntax;
  match (syntax) { Node(path, start, end, _, _) => H.setSpan(path, start, end) };
  outer
};

let _childOf = fn(syntax: Syntax, index: I32): Syntax { match (syntax) { Node(_, _, _, children, _) => children[index] } };
export let syntaxChild: (I32) -> Syntax = fn(index) { _childOf(_syntax, index) };
export let syntaxPattern: (I32) -> Syntax = fn(index) { match (_syntax) { Node(_, _, _, _, patterns) => patterns[index] } };
export let subPattern: (Syntax, I32) -> Syntax = fn(syntax, index) { _childOf(syntax, index) };

let _findIn = fn(names: Array<Bytes>, name: Bytes, start: I32): I32 {
  let i = names.len() - 1;

  while (i >= start) {
    if (names[i] == name) { return i; }
    i--;
  }
  -1
};
let _find = fn(name: Bytes, start: I32): I32 { _findIn(_names, name, start) };

export let newBinding: () -> I32 = fn() {
  let id = _nextBinding;
  _nextBinding++;
  _bindingTypes.push(-1);
  _mutable.push(false);
  _assigned.push(false);
  _captured.push(false);
  id
};

let _declare = fn(name: Bytes, ty: I32, mutable: Bool): I32 {
  let id = newBinding();
  _bindingTypes[id] = ty;
  _mutable[id] = mutable;
  _names.push(name);
  _ids.push(id);
  id
};

let _popTo = fn(start: I32) {
  while (_names.len() > start) {
    _names.pop();
    _ids.pop();
  }
  null
};

let _leaf = fn(op: Op, ty: I32, value: I32): I32 { H.node(op, ty, value, 0, []) };
let _unary = fn(op: Op, ty: I32, operand: I32): I32 { H.node(op, ty, 0, 0, [operand]) };
let _binary = fn(op: Op, ty: I32, left: I32, right: I32): I32 { H.node(op, ty, 0, 0, [left, right]) };

export let checkType: (AstType) -> I32 = fn(_ty) { -1 };

let _checkTypes = fn(types: Array<AstType>): Array<I32> {
  let checked = Array.new<I32>(0);
  let i = 0;

  while (i < types.len()) {
    checked.push(checkType(types[i]));
    i++;
  }
  checked
};
checkType = fn(ty) { match (ty) {
  Named(name) => match (name) {
    "I32" => H.TYPE_I32,
    "I64" => H.TYPE_I64,
    "Bool" => H.TYPE_BOOL,
    "Bytes" => H.TYPE_BYTES,
    "Dynamic" => H.TYPE_DYNAMIC,
    _ => {
      let named = scopedType(name);
      if (named < 0) { throw "unsupported type: " + name; }
      named
    },
  },
  Generic(name, args) => match (name) {
    "Array" when (args.len() == 1) => H.arrayType(checkType(args[0])),
    "List" when (args.len() == 1) => H.listType(checkType(args[0])),
    "Tuple" when (args.len() >= 2) => H.tupleType(_checkTypes(args)),
    "Null" when (args.len() == 1) => H.nullType(checkType(args[0])),
    _ => {
      throw "unsupported generic type: " + name;
      -1
    },
  },
  Function(args, result) => H.functionType(_checkTypes(args), checkType(result)),
  OptionalArg(inner) => H.nullType(checkType(inner)),
  VarargsArg(_) => {
    throw "variadic parameters are not supported yet";
    -1
  },
  _ => {
    throw "tuple types are written Tuple<A, B>";
    -1
  },
} };

let _checkExpr: (AstExpr, Syntax, I32) -> I32 = fn(_expr, _exprSyntax, _expected) { -1 };
let _checkBlock: (Array<Stmt>, ?AstExpr, I32) -> I32 = fn(_statements, _tail, _expected) { -1 };
let _checkTry: (AstBlock, ?Bytes, AstBlock, I32, Bool) -> I32 = fn(_body, _catchName, _handler, _expected, _statement) { -1 };
let _checkEnum: (AstExpr, I32, Bool) -> I32 = fn(_expr, _expected, _statement) { -1 };

export let useEnumChecks: ((AstExpr, I32, Bool) -> I32) -> Bool = fn(check) {
  _checkEnum = check;
  true
};
let _isEnumName = fn(base: AstExpr): Bool { match (base) { Variable(name) => (_find(name, 0) < 0) && (scopedType(name) >= 0), _ => false } };
let _checkValue: (AstExpr, I32) -> I32 = fn(_expr, _expected) { -1 };

export let useValueChecks: ((AstExpr, I32) -> I32) -> Bool = fn(check) {
  _checkValue = check;
  true
};
let _checkAggregate: (AstExpr, I32) -> I32 = fn(_expr, _expected) { -1 };

export let useAggregateChecks: ((AstExpr, I32) -> I32) -> Bool = fn(check) {
  _checkAggregate = check;
  true
};

let _isEnumExpr = fn(expr: AstExpr): Bool {
  match (expr) {
    Match(_, _) => true,
    Member(base, _) => _isEnumName(base),
    Call(callee, _, _) => match (callee) { Member(base, _) => _isEnumName(base), _ => false },
    _ => false,
  }
};
export let checkOperand: (AstExpr, I32, I32) -> I32 = fn(expr, index, expected) { _checkExpr(expr, syntaxChild(index), expected) };

let _known = fn(id: I32): Bool { match (H.opOf(id)) { Local => isNarrowed(H.valueOf(id)), _ => false } };
let _unwrap = fn(id: I32): I32 { H.node(Op.Unwrap, H.innerOf(H.typeOf(id)), _known(id) ? 0 : 1, 0, [id]) };
export let presentKnown: (I32) -> I32 = fn(id) { (H.isKind(H.typeOf(id), Kind.Null) && _known(id)) ? _unwrap(id) : id };

export let bufferHint: (I32) -> Bytes = fn(ty) {
  ty == H.TYPE_BYTE_BUFFER ? "; copy a buffer's bytes out with Bytes.slice(buffer, 0, buffer.len())" : ""
};

let _coerce = fn(id: I32, expected: I32): I32 {
  let ty = H.typeOf(id);
  if ((expected < 0) || (ty == expected)) { return id; }

  if (H.holdsNull(expected)) {
    if (ty == H.innerOf(expected)) { return _unary(Op.Present, expected, id); }

    if (ty == H.TYPE_NULL) {
      let typed = _leaf(Op.Null, expected, 0);
      return match (H.opOf(id)) { Null => typed, _ => H.node(Op.Block, expected, 0, 1, [_unary(Op.Expression, 0, id), typed]) };
    }
  }
  if (H.isKind(ty, Kind.Null) && (H.innerOf(ty) == expected)) { return _unwrap(id); }
  if (ty == H.TYPE_BYTE_BUFFER) { throw "a buffer from Bytes.new is not " + H.typeName(expected) + bufferHint(ty); }
  if ((expected == H.TYPE_DYNAMIC) && (ty != H.TYPE_NULL)) { throw "a value becomes Dynamic only with `as Dynamic`"; }
  id
};

let _presentAt = fn(id: I32, index: I32): I32 {
  let ty = H.typeOf(id);
  if (!H.isKind(ty, Kind.Null) || (H.innerOf(ty) < 0)) { return id; }
  let outer = enterSyntax(syntaxChild(index));
  let present = _unwrap(id);
  enterSyntax(outer);
  present
};
export let presentAt: (I32, I32) -> I32 = fn(id, index) { _presentAt(id, index) };

let _coerceAt = fn(id: I32, expected: I32, index: I32): I32 {
  let outer = enterSyntax(syntaxChild(index));
  let coerced = _coerce(id, expected);
  enterSyntax(outer);
  coerced
};
export let coerceAt: (I32, I32, I32) -> I32 = fn(id, expected, index) { _coerceAt(id, expected, index) };

let _value = fn(expr: AstExpr, index: I32): I32 { _presentAt(_checkExpr(expr, syntaxChild(index), -1), index) };
export let checkPresent: (AstExpr, I32) -> I32 = fn(expr, index) { _value(expr, index) };

export let joinTypes: (I32, I32) -> I32 = fn(a, b) {
  if (a == b) { return a; }
  if ((a == H.TYPE_NULL) || (H.isKind(b, Kind.Null) && (H.innerOf(b) == a))) { return H.nullType(b); }
  if ((b == H.TYPE_NULL) || (H.isKind(a, Kind.Null) && (H.innerOf(a) == b))) { return H.nullType(a); }
  -1
};

let _isNull = fn(value: AstExpr): Bool { match (value) { Null => true, _ => false } };

export let isInferredInteger: (AstExpr) -> Bool = fn(value) {
  match (value) { Integer(_, size) => match (size) { Infer => true, _ => false }, Unary(op, operand) => match (op) { Negate => isInferredInteger(operand), _ => false }, _ => false }
};

let _isValueEquality = fn(op: BinaryOp, left: AstExpr, right: AstExpr): Bool {
  match (op) { Equal, NotEqual => !_isNull(left) && !_isNull(right), _ => false }
};

let _narrowBy = fn(cond: AstExpr, present: Bool) {
  match (cond) {
    Binary(op, left, right) => {
      let tests = match (op) { NotEqual => present, Equal => !present, _ => false };
      let name = match (left) { Variable(found) when (_isNull(right)) => found, _ => match (right) { Variable(found) when (_isNull(left)) => found, _ => "" } };
      let found = (tests && (name != "")) ? _find(name, 0) : -1;
      let id = found >= 0 ? _ids[found] : -1;
      if ((id >= 0) && H.isKind(_bindingTypes[id], Kind.Null)) { narrow(id, _mutable[id]); }
      null
    },
    _ => null,
  }
};

let _checkInteger = fn(text: Bytes, size: IntSize, negative: Bool, expected: I32): I32 {
  let ty = match (size) {
    Infer => expected == H.TYPE_I64 ? H.TYPE_I64 : H.TYPE_I32,
    I32 => H.TYPE_I32,
    I64 => H.TYPE_I64,
    _ => {
      throw "integer literals narrower than I32 are not supported yet";
      H.TYPE_I32
    },
  };
  if (ty == H.TYPE_I64) { return H.wideLiteral(wideIntegerValue(text, negative)); }
  _leaf(Op.I32, H.TYPE_I32, integerValue(text, negative))
};

let _checkUnary = fn(op: UnaryOp, value: AstExpr, expected: I32): I32 {
  match (op) {
    Negate => match (value) {
      Integer(digits, size) => _checkInteger(digits, size, true, expected),
      _ => {
        let operand = _value(value, 0);
        let ty = H.typeOf(operand);
        if ((ty != H.TYPE_I32) && (ty != H.TYPE_I64)) { throw "negation requires an I32 or I64 operand"; }
        _unary(Op.Neg, ty, operand)
      },
    },
    _ => {
      let operand = _value(value, 0);
      if (H.typeOf(operand) != H.TYPE_BOOL) { throw "operator ! requires a bool operand, not " + H.typeName(H.typeOf(operand)); }
      _unary(Op.Not, H.TYPE_BOOL, operand)
    },
  }
};

let _checkNullComparison = fn(op: BinaryOp, value: AstExpr, index: I32): I32 {
  let operand = checkOperand(value, index, -1);
  let ty = H.typeOf(operand);

  if (!H.holdsNull(ty) || (ty == H.TYPE_NULL)) {
    enterSyntax(syntaxChild(index));
    throw "only Null<T> values can be compared with null, not " + H.typeName(ty);
  }

  match (op) {
    Equal => _unary(Op.IsNull, H.TYPE_BOOL, operand),
    NotEqual => _unary(Op.IsPresent, H.TYPE_BOOL, operand),
    _ => {
      throw "null supports only == and !=";
      -1
    },
  }
};

let _compare = fn(op: Op, left: I32, right: I32, negate: Bool): I32 {
  let compared = _binary(op, H.TYPE_BOOL, left, right);
  negate ? _unary(Op.Not, H.TYPE_BOOL, compared) : compared
};

export let isNullaryVariant: (I32) -> Bool = fn(id) { match (H.opOf(id)) { EnumNew => H.childCount(id) == 0, _ => false } };

let _enumEquality = fn(op: BinaryOp, left: I32, right: I32): I32 {
  let negate = match (op) {
    Equal => false, NotEqual => true, _ => {
      throw "enums support only == and !=";
      false
    }
  };
  let variant = isNullaryVariant(right) ? right : left;
  let value = isNullaryVariant(right) ? left : right;
  if (!isNullaryVariant(variant)) { throw "enum values can be compared only with a variant without a payload, such as E.None; use match"; }
  _compare(Op.Eq, _unary(Op.EnumTag, H.TYPE_I32, value), _leaf(Op.I32, H.TYPE_I32, H.valueOf(variant)), negate)
};

let _operatorText = fn(op: BinaryOp): Bytes {
  match (op) {
    Add => "+", Subtract => "-", Multiply => "*", Divide => "/", Remainder => "%",
    ShiftLeft => "<<", ShiftRight => ">>", BitAnd => "&", BitOr => "|", BitXor => "^",
    Equal => "==", NotEqual => "!=", Less => "<", LessEqual => "<=", Greater => ">", GreaterEqual => ">=",
    And => "&&", Or => "||",
  }
};

let _bitwiseHint = fn(op: BinaryOp, left: I32, right: I32): Bytes {
  let leftBool = H.typeOf(left) == H.TYPE_BOOL;
  let rightBool = H.typeOf(right) == H.TYPE_BOOL;
  let logical = match (op) { BitAnd => "&&", BitOr => "||", BitXor => "!=", _ => "" };
  if ((logical == "") || (!leftBool && !rightBool)) { return ""; }
  leftBool && rightBool ? "; use " + logical + " on bool operands" : "; comparisons bind tighter, so write (a " + _operatorText(op) + " b) == c"
};

export let binaryValues: (BinaryOp, I32, I32) -> I32 = fn(op, left, right) {
  if ((H.typeOf(left) == H.TYPE_BYTE_BUFFER) || (H.typeOf(right) == H.TYPE_BYTE_BUFFER)) {
    throw "operator " + _operatorText(op) + " is not defined for a buffer from Bytes.new" + bufferHint(H.TYPE_BYTE_BUFFER);
  }

  if ((H.typeOf(left) == H.TYPE_DYNAMIC) || (H.typeOf(right) == H.TYPE_DYNAMIC)) {
    throw "a Dynamic value must be extracted with `as T` before use";
  }

  if ((H.typeOf(left) == H.TYPE_BYTES) && (H.typeOf(right) == H.TYPE_BYTES)) {
    return match (op) {
      Add => _binary(Op.BytesConcat, H.TYPE_BYTES, left, right),
      Equal => _binary(Op.BytesEq, H.TYPE_BOOL, left, right),
      NotEqual => _unary(Op.Not, H.TYPE_BOOL, _binary(Op.BytesEq, H.TYPE_BOOL, left, right)),
      _ => {
        throw "Bytes support only +, == and !=";
        -1
      },
    };
  }
  if (H.isKind(H.typeOf(left), Kind.Enum) && (H.typeOf(right) == H.typeOf(left))) { return _enumEquality(op, left, right); }
  let bools = (H.typeOf(left) == H.TYPE_BOOL) && (H.typeOf(right) == H.TYPE_BOOL);

  match (op) {
    And, Or => {
      if (!bools) { throw "&& and || require bool operands"; }
      return _binary(match (op) { And => Op.And, _ => Op.Or }, H.TYPE_BOOL, left, right);
    },
    Equal, NotEqual when (bools) => { return _compare(Op.Eq, left, right, match (op) { NotEqual => true, _ => false }); },
    _ => null,
  };
  let ty = H.typeOf(left);

  if (((ty != H.TYPE_I32) && (ty != H.TYPE_I64)) || (H.typeOf(right) != ty)) {
    throw (ty == H.TYPE_I64) || (H.typeOf(right) == H.TYPE_I64)
      ? "integer operands must have the same type: " + H.typeName(ty) + " and " + H.typeName(H.typeOf(right))
      : "operator " + _operatorText(op) + " is not defined for " + H.typeName(ty) + " and " + H.typeName(H.typeOf(right)) + _bitwiseHint(op, left, right);
  }

  match (op) {
    Add => _binary(Op.Add, ty, left, right),
    Subtract => _binary(Op.Sub, ty, left, right),
    Multiply => _binary(Op.Mul, ty, left, right),
    Divide => _binary(Op.Div, ty, left, right),
    Remainder => _binary(Op.Rem, ty, left, right),
    ShiftLeft => _binary(Op.Shl, ty, left, right),
    ShiftRight => _binary(Op.Shr, ty, left, right),
    BitAnd => _binary(Op.BitAnd, ty, left, right),
    BitOr => _binary(Op.BitOr, ty, left, right),
    BitXor => _binary(Op.BitXor, ty, left, right),
    Equal => _compare(Op.Eq, left, right, false),
    NotEqual => _compare(Op.Eq, left, right, true),
    Less => _compare(Op.Lt, left, right, false),
    LessEqual => _compare(Op.Gt, left, right, true),
    Greater => _compare(Op.Gt, left, right, false),
    GreaterEqual => _compare(Op.Lt, left, right, true),
    _ => {
      throw "operator " + _operatorText(op) + " is not supported yet";
      -1
    },
  }
};

let _checkBinary = fn(op: BinaryOp, leftExpr: AstExpr, rightExpr: AstExpr, expected: I32): I32 {
  let isEquality = match (op) { Equal, NotEqual => true, _ => false };

  if (isEquality && (_isNull(leftExpr) || _isNull(rightExpr))) {
    return _isNull(leftExpr) ? _checkNullComparison(op, rightExpr, 1) : _checkNullComparison(op, leftExpr, 0);
  }

  if (isInferredInteger(leftExpr) && !isInferredInteger(rightExpr)) {
    let right = _value(rightExpr, 1);
    return binaryValues(op, checkOperand(leftExpr, 0, H.typeOf(right) == H.TYPE_DYNAMIC ? -1 : H.typeOf(right)), right);
  }
  let arithmetic = match (op) { Add, Subtract, Multiply, ShiftLeft, ShiftRight, BitAnd, BitOr, BitXor => true, _ => false };
  let integer = (expected == H.TYPE_I32) || (expected == H.TYPE_I64);
  let left = _presentAt(_checkExpr(leftExpr, syntaxChild(0), arithmetic && integer ? expected : -1), 0);
  let before = narrowings();
  match (op) { And => _narrowBy(leftExpr, true), Or => _narrowBy(leftExpr, false), _ => null };
  let right = checkOperand(rightExpr, 1, H.typeOf(left) == H.TYPE_DYNAMIC ? -1 : H.typeOf(left));
  keepNarrowings(before);
  binaryValues(op, left, right)
};

let _functionType = fn(index: I32): I32 {
  let ty = _functionTypes[index];
  if (ty < 0) { throw _functionNames[index] + " is used before its result type is inferred; annotate its result type"; }
  ty
};

let _enclosingFind = fn(name: Bytes): Tuple<I32, I32> {
  let depth = _frames.len() - 1;

  while (depth >= 0) {
    let id = match (_frames[depth]) {
      Frame(names, ids) => {
        let found = _findIn(names, name, 0);
        found >= 0 ? ids[found] : -1
      }
    };
    if (id >= 0) { return (depth as I32, id); }
    depth--;
  }
  (-1, -1)
};

let _enclosingHas = fn(name: Bytes): Bool {
  let (depth, _) = _enclosingFind(name);
  depth >= 0
};

let _capturedTarget = fn(name: Bytes): Bytes { "cannot assign to " + name + ": a closure captures it" };

let _capture = fn(name: Bytes): I32 {
  let (depth, id) = _enclosingFind(name);
  if (depth < 0) { return -1; }
  let ty = _bindingTypes[id];
  if (_assigned[id]) { throw "a closure cannot capture " + name + ": it is assigned after its declaration"; }
  _captured[id] = true;
  depth++;

  while (depth < _captures.len()) {
    let captures = _captures[depth];
    let sources = _sources[depth];
    let i = 0;
    while ((i < sources.len()) && (H.valueOf(sources[i]) != id)) { i++; }

    if (i == sources.len()) {
      sources.push(_leaf(Op.Local, ty, id));
      captures.push(H.node(Op.Capture, ty, newBinding(), H.bytesId(name), []));
    }
    id = H.valueOf(captures[i]);
    depth++;
  }
  _leaf(Op.Local, ty, id)
};

let _moduleBinding = fn(name: Bytes): Binding { ((_find(name, 0) >= 0) || _enclosingHas(name)) ? Binding.Unbound : scoped(name) };

export let isBound: (Bytes) -> Bool = fn(name) {
  (_find(name, 0) >= 0) || _enclosingHas(name) || match (scoped(name)) { Unbound => false, _ => true }
};

let _isNamespace = fn(name: Bytes): Bool { match (_moduleBinding(name)) { Namespace(_, _) => true, _ => false } };

let _inNamespace = fn(space: Bytes, name: Bytes): Binding {
  match (scoped(space)) { Namespace(module, path) => namespaceMember(module, path, name), _ => Binding.Unbound }
};

let _bindingValue = fn(binding: Binding, name: Bytes): I32 {
  match (binding) {
    Global(id) => _leaf(Op.Global, H.globalTypeOf(id), id),
    Function(index) => _leaf(Op.FunctionRef, _functionType(index), index + 1),
    Loaded(_, _) => {
      throw "native " + name + " needs a typed binding first: let f: (Bytes) -> I32 = " + name + ";";
      -1
    },
    Native(_) => {
      throw "native " + name + " can only be called; natives are not values yet";
      -1
    },
    Namespace(_, _) => {
      throw name + " is a module namespace, not a value; name one of its exports, as in " + name + ".x";
      -1
    },
    Unbound => {
      throw "unknown local: " + name;
      -1
    },
  }
};

let _checkVariable = fn(name: Bytes): I32 {
  let found = _find(name, 0);
  if (found >= 0) { return _leaf(Op.Local, _bindingTypes[_ids[found]], _ids[found]); }
  let captured = _capture(name);
  if (captured >= 0) { return captured; }
  _bindingValue(scoped(name), name)
};

let _arguments = fn(function: I32, args: Array<AstExpr>, children: Array<I32>, message: Bytes): Array<I32> {
  let i = 0;

  while (i < args.len()) {
    let syntax = syntaxChild(i + 1);
    let expected = H.typeArg(function, i);
    let arg = _checkExpr(args[i], syntax, expected);
    let outer = enterSyntax(syntax);
    if (H.typeOf(arg) != expected) { throw message; }
    enterSyntax(outer);
    children.push(arg);
    i++;
  }
  children
};

let _checkIndirectCall = fn(callee: I32, args: Array<AstExpr>): I32 {
  let ty = H.typeOf(callee);
  if (!H.isKind(ty, Kind.Function)) { throw "call target is not a function"; }
  if (args.len() != H.typeArgCount(ty)) { throw "wrong indirect call argument count"; }
  H.node(Op.CallIndirect, H.innerOf(ty), 0, 0, _arguments(ty, args, [callee], "wrong indirect call argument type"))
};

let _checkDirectCall = fn(index: I32, args: Array<AstExpr>): I32 {
  let ty = _functionType(index);
  let name = _functionNames[index];
  if (args.len() != H.typeArgCount(ty)) { throw "wrong argument count for " + name; }
  H.node(Op.Call, H.innerOf(ty), index + 1, 0, _arguments(ty, args, [], "wrong argument type for " + name))
};

let _checkNativeCall = fn(native: I32, name: Bytes, args: Array<AstExpr>): I32 {
  let ty = H.nativeTypeOf(native);
  if (args.len() != H.typeArgCount(ty)) { throw "wrong argument count for " + name; }
  H.node(Op.CallNative, H.innerOf(ty), native, 0, _arguments(ty, args, [], "wrong argument type for " + name))
};

let _checkBindingCall = fn(binding: Binding, name: Bytes, callee: AstExpr, args: Array<AstExpr>): I32 {
  match (binding) {
    Function(index) => _checkDirectCall(index, args),
    Native(native) => _checkNativeCall(native, name, args),
    _ => _checkIndirectCall(_value(callee, 0), args),
  }
};

let _checkCall = fn(callee: AstExpr, typeArgs: Array<AstType>, args: Array<AstExpr>): I32 {
  if (typeArgs.len() != 0) { throw "calls do not support type arguments"; }

  match (callee) {
    Variable(name) => _checkBindingCall(_moduleBinding(name), name, callee, args),
    Member(Variable(space), name) => _checkBindingCall(_inNamespace(space, name), space + "." + name, callee, args),
    _ => _checkIndirectCall(_value(callee, 0), args),
  }
};

let _checkIf = fn(condition: AstExpr, thenBranch: AstExpr, elseBranch: AstExpr, expected: I32): I32 {
  let checkedCondition = _value(condition, 0);
  if (H.typeOf(checkedCondition) != H.TYPE_BOOL) { throw "if condition must be bool"; }
  let before = narrowings();
  _narrowBy(condition, true);
  let checkedThen = checkOperand(thenBranch, 1, expected);
  keepNarrowings(before);
  _narrowBy(condition, false);
  let checkedElse = checkOperand(elseBranch, 2, expected);
  keepNarrowings(before);
  let ty = joinTypes(H.typeOf(checkedThen), H.typeOf(checkedElse));
  if (ty < 0) { throw "if branches must have the same type"; }
  H.node(Op.If, ty, 0, 0, [checkedCondition, _coerceAt(checkedThen, ty, 1), _coerceAt(checkedElse, ty, 2)])
};

let _importedTarget = fn(name: Bytes): Bytes { "cannot assign to imported binding: " + name };

let _assignable = fn(name: Bytes): Tuple<Bool, I32, I32> {
  let found = _find(name, 0);
  let (_, outer) = found >= 0 ? (0, _ids[found]) : _enclosingFind(name);

  if (outer >= 0) {
    if (!_mutable[outer]) { throw "cannot assign to immutable local: " + name; }
    if ((found < 0) || _captured[outer]) { throw _capturedTarget(name); }
    _assigned[outer] = true;
    return (false, outer, _bindingTypes[outer]);
  }

  let id = match (scoped(name)) {
    Global(target) => target,
    Function(_) => {
      throw "cannot assign to function: " + name;
      -1
    },
    Loaded(_, _), Native(_) => {
      throw "cannot assign to native: " + name;
      -1
    },
    Namespace(_, _) => {
      throw "cannot assign to module namespace: " + name;
      -1
    },
    Unbound => {
      throw "unknown local: " + name;
      -1
    },
  };
  if (isImported(name)) { throw _importedTarget(name); }
  if (!H.globalIsMutable(id)) { throw "cannot assign to immutable global: " + name; }
  (true, id, H.globalTypeOf(id))
};

let _checkVariableAssignment = fn(op: AssignOp, name: Bytes, value: AstExpr): I32 {
  let (global, id, ty) = _assignable(name);
  let checked = checkOperand(value, 1, ty);
  if (H.typeOf(checked) != ty) { throw "assignment type mismatch: " + name; }
  let assign = global ? Op.SetGlobal : Op.Assign;
  if (!global && H.isKind(ty, Kind.Null)) { assignLocal(id, H.typeOf(checked) == ty && match (H.opOf(checked)) { Present => true, _ => false }); }

  match (op) {
    Assign => H.node(assign, ty, id, 0, [checked]),
    _ => {
      let bytes = (ty == H.TYPE_BYTES) && match (op) { Add => true, _ => false };
      if ((ty != H.TYPE_I32) && (ty != H.TYPE_I64) && !bytes) { throw "compound assignment requires an I32 or I64 variable: " + name; }
      let operation = bytes ? Op.BytesConcat : match (op) { Add => Op.Add, Subtract => Op.Sub, Multiply => Op.Mul, _ => Op.Div };
      let outer = enterSyntax(syntaxChild(0));
      let target = _leaf(global ? Op.Global : Op.Local, ty, id);
      enterSyntax(outer);
      H.node(assign, ty, id, 0, [_binary(operation, ty, target, checked)])
    },
  }
};

let _rejectNamespaceTarget = fn(target: AstExpr): Bool {
  match (target) {
    Member(Variable(space), name) when (_isNamespace(space)) => {
      _inNamespace(space, name);
      throw _importedTarget(space + "." + name);
      false
    },
    _ => true,
  }
};

let _checkAssignment = fn(expr: AstExpr, op: AssignOp, target: AstExpr, value: AstExpr): I32 {
  _rejectNamespaceTarget(target);

  match (target) {
    Variable(name) => _checkVariableAssignment(op, name, value),
    Index(_, _) => _checkAggregate(expr, -1),
    Member(_, _) => {
      throw "assigning to a field is not supported yet";
      -1
    },
    _ => {
      throw "only a variable or an element can be assigned";
      -1
    },
  }
};

export let one: (I32) -> I32 = fn(ty) { ty == H.TYPE_I64 ? H.wideLiteral(1) : _leaf(Op.I32, H.TYPE_I32, 1) };

let _checkIncDec = fn(op: IncDecOp, prefix: Bool, target: AstExpr, discarded: Bool): I32 {
  _rejectNamespaceTarget(target);
  if (match (target) { Index(_, _) => true, _ => false }) { return _checkAggregate(AstExpr.IncDec(op, prefix || discarded, target), -1); }

  let name = match (target) {
    Variable(found) => found, _ => {
      throw "only a variable or an element can be incremented or decremented";
      ""
    }
  };
  let (global, id, ty) = _assignable(name);
  if ((ty != H.TYPE_I32) && (ty != H.TYPE_I64)) { throw "increment and decrement require an I32 or I64 variable: " + name; }
  let outer = enterSyntax(syntaxChild(0));
  let current = _leaf(global ? Op.Global : Op.Local, ty, id);
  enterSyntax(outer);
  let increment = match (op) { Increment => true, _ => false };
  let updated = H.node(global ? Op.SetGlobal : Op.Assign, ty, id, 0, [_binary(increment ? Op.Add : Op.Sub, ty, current, one(ty))]);
  if (prefix || discarded) { return updated; }
  _binary(increment ? Op.Sub : Op.Add, ty, updated, one(ty))
};

let _unsupportedExpr = fn(expr: AstExpr): Bytes {
  let feature = match (expr) {
    RegExp(_, _) => "regexp values outside a match pattern are",
    Atom(_) => "atoms are",
    Float(_, _) => "floating-point numbers are",
    This => "`this` is",
    Super => "`super` is",
    List(_) => "lists are",
    Object(_) => "objects are",
    Spread(_) => "spread expressions are",
    Bits(_) => "bit syntax is",
    TypeApply(_, _) => "type application outside a call is",
    New(_, _) => "`new` is",
    Function(_, _, _, _) => "methods are",
    With(_, _, _) => "`with` expressions are",
    LetExpr(_, _, _, _) => "`let` expressions are",
    Pipe(_, _), Topic => "pipelines are",
    Await(_) => "`await` is",
    Quote(_, _), Unquote(_) => "macros are",
    _ => "this expression is",
  };
  feature + " not supported yet"
};

export let unsupportedStatement: (Stmt) -> Bytes = fn(statement) {
  let feature = match (statement) {
    Prototype(_, _, _, _) => "prototypes are",
    Typedef(_, _, _, _) => "typedefs are",
    Macro(_, _, _, _) => "macros are",
    DoWhile(_, _) => "do-while loops are",
    ImportModule(_, _, _), ImportFrom(_, _, _) => "imports inside a function are",
    Enum(_, _, _, _) => "enums declared inside a function are",
    LetStmt(_, _, _, _, _, _) => "exports inside a function are",
    Return(_) => "`return` outside a function is",
    Throw(_) => "`throw` at the top level is",
    Break => {
      return "break outside loop";
      ""
    },
    Continue => {
      return "continue outside loop";
      ""
    },
    _ => "this statement is",
  };
  feature + " not supported yet"
};

let _checkFunctionLiteral: (Array<Parameter>, ?AstType, AstBlock, I32) -> I32 = fn(_params, _result, _body, _expected) { -1 };

_checkExpr = fn(expr, syntax, expected) {
  let outer = enterSyntax(syntax);
  let literal = H.isKind(expected, Kind.Null) ? H.innerOf(expected) : expected;

  let id = match (expr) {
    _ when (_isEnumExpr(expr)) => _checkEnum(expr, expected, false),
    Bytes(value) => _leaf(Op.Bytes, H.TYPE_BYTES, H.bytesId(value)),
    Bool(value) => _leaf(Op.Bool, H.TYPE_BOOL, value ? 1 : 0),
    Null => _leaf(Op.Null, H.holdsNull(expected) ? expected : H.TYPE_NULL, 0),
    Integer(digits, size) => _checkInteger(digits, size, false, literal),
    Unary(op, value) => _checkUnary(op, value, literal),
    Binary(op, left, right) when (_isValueEquality(op, left, right)) => _checkValue(expr, expected),
    Binary(op, left, right) => _checkBinary(op, left, right, literal),
    Cast(_, _), Is(_, _) => _checkValue(expr, expected),
    Variable(name) => _checkVariable(name),
    Member(Variable(space), name) when (_isNamespace(space)) => _bindingValue(_inNamespace(space, name), space + "." + name),
    Tuple(_), Array(_), Member(_, _), Index(_, _) => _checkAggregate(expr, literal),
    Call(callee, typeArgs, args) when (match (callee) { Member(Variable(space), _) => _isNamespace(space), _ => false }) => _checkCall(callee, typeArgs, args),
    Call(callee, _, _) when (match (callee) { Member(_, _), TypeApply(_, _) => true, _ => false }) => _checkAggregate(expr, expected),
    Call(callee, typeArgs, args) => _checkCall(callee, typeArgs, args),
    If(_, _, elseBranch) when (_isNull(elseBranch)) => {
      throw "an if used as a value needs an else branch";
      -1
    },
    If(condition, thenBranch, elseBranch), Conditional(condition, thenBranch, elseBranch) => _checkIf(condition, thenBranch, elseBranch, expected),
    Try(body, catchName, handler) => _checkTry(body, catchName, handler, expected, false),
    IncDec(op, prefix, target) => _checkIncDec(op, prefix, target, false),
    BlockExpr(block) => match (block) { Block(statements, tail) => {
      if (tail == null) { throw "value block requires a trailing expression"; }
      _checkBlock(statements, tail, expected)
    } },
    Assign(op, target, value) => _checkAssignment(expr, op, target, value),
    Function(params, result, body, isMethod) when (!isMethod) => _checkFunctionLiteral(params, result, body, expected),
    _ => {
      throw _unsupportedExpr(expr);
      -1
    },
  };
  let coerced = _coerce(id, expected);
  enterSyntax(outer);
  coerced
};

let _isFunctionValue = fn(value: AstExpr): Bool { match (value) { Function(_, _, _, isMethod) => !isMethod, _ => false } };

export let isDirectFunction: (Stmt) -> Bool = fn(statement) {
  match (statement) {
    LetStmt(_, _, pattern, _, annotation, value) => isBindPattern(pattern) && (annotation == null) && _isFunctionValue(value),
    _ => false,
  }
};

let _addFunction = fn(name: Bytes, params: Array<Parameter>, result: ?AstType, expected: I32): I32 {
  let fits = (expected >= 0) && H.isKind(expected, Kind.Function) && (H.typeArgCount(expected) == params.len());
  let names = Array.new<Bytes>(0);
  let types = Array.new<I32>(0);
  let i = 0;

  while (i < params.len()) {
    match (params[i]) { Parameter(paramName, paramType, kind) => {
      match (kind) {
        Required => null, _ => {
          throw "only required parameters are supported";
          null
        }
      };
      let j = 0;

      while (j < names.len()) {
        if (names[j] == paramName) { throw "duplicate parameter: " + paramName; }
        j++;
      }
      let ty = paramType != null ? checkType(paramType) : fits ? H.typeArg(expected, i) : -1;
      if (ty < 0) { throw "parameter " + paramName + " of " + name + " needs a type"; }
      names.push(paramName);
      types.push(ty);
    } };
    i++;
  }
  let resultType = result != null ? checkType(result) : fits ? H.innerOf(expected) : -1;
  _functionNames.push(name);
  _functionTypes.push(resultType < 0 ? -1 : H.functionType(types, resultType));
  _functionParams.push(names);
  _functionParamTypes.push(types);
  _functionNodes.push(-1);
  (_functionNames.len() - 1) as I32
};

let _declareFunction = fn(name: Bytes, typeParams: Array<Bytes>, value: AstExpr) {
  if (typeParams.len() != 0) { throw "generic functions are not supported yet: " + name; }

  match (value) {
    Function(params, result, _, _) => declareScoped(name, Binding.Function(_addFunction(name, params, result, -1))),
    _ => true,
  };
  null
};

export let declareFunctions: (Array<Stmt>) -> I32 = fn(statements) {
  let first = _functionNames.len() as I32;
  let i = 0;

  while (i < statements.len()) {
    let outer = enterSyntax(syntaxChild(i));

    match (statements[i]) {
      LetStmt(_, _, pattern, typeParams, _, value) when (isDirectFunction(statements[i])) =>
        _declareFunction(bindPatternName(pattern), typeParams, value),
      _ => null,
    };
    enterSyntax(outer);
    i++;
  }
  first
};

let _checkLocal = fn(pattern: Pattern, isConst: Bool, typeParams: Array<Bytes>, annotation: ?AstType, value: AstExpr): I32 {
  let name = bindPatternName(pattern);
  if (typeParams.len() != 0) { throw "local bindings do not support type parameters"; }
  if (_find(name, _scopeStart) >= 0) { throw "duplicate local: " + name; }
  let ty = annotation == null ? -1 : checkType(annotation);
  let checked = checkOperand(value, 0, ty);
  if ((ty >= 0) && (H.typeOf(checked) == H.TYPE_NULL)) { throw "only Null<T> can hold null, not " + H.typeName(ty); }
  if (ty < 0) { ty = H.typeOf(checked); } else if (ty != H.typeOf(checked)) { throw "binding annotation type mismatch: " + name; }
  if (ty == H.TYPE_NULL) { throw "null needs a type from its context: annotate " + name + " as Null<T>"; }
  let binding = _declare(name, ty, !isConst);
  match (H.opOf(checked)) { Present => narrow(binding, !isConst), _ => false };
  H.node(isConst ? Op.Const : Op.Let, ty, binding, H.bytesId(name), [checked])
};

let _checkResult = fn(value: AstExpr, index: I32, message: Bytes): I32 {
  let checked = checkOperand(value, index, _result);
  if (_result < 0) { _result = H.typeOf(checked); } else if (H.typeOf(checked) != _result) { throw message; }
  checked
};

let _checkStatement: (Stmt, Syntax) -> I32 = fn(_statement, _statementSyntax) { -1 };
let _checkIfStatement: (AstExpr, AstExpr, AstExpr) -> I32 = fn(_condition, _thenBranch, _elseBranch) { -1 };

export let checkEffect: (AstExpr, I32) -> I32 = fn(value, index) {
  match (value) {
    If(condition, thenBranch, elseBranch) => {
      let outer = enterSyntax(syntaxChild(index));
      let id = _checkIfStatement(condition, thenBranch, elseBranch);
      enterSyntax(outer);
      id
    },
    Match(_, _) => {
      let outer = enterSyntax(syntaxChild(index));
      let id = _checkEnum(value, -1, true);
      enterSyntax(outer);
      id
    },
    Try(body, catchName, handler) => {
      let outer = enterSyntax(syntaxChild(index));
      let id = _checkTry(body, catchName, handler, -1, true);
      enterSyntax(outer);
      id
    },
    IncDec(op, prefix, target) => {
      let outer = enterSyntax(syntaxChild(index));
      let id = _unary(Op.Expression, 0, _checkIncDec(op, prefix, target, true));
      enterSyntax(outer);
      id
    },
    _ => _unary(Op.Expression, 0, checkOperand(value, index, -1)),
  }
};

let _STATEMENT_TAIL = 0;
let _VALUE_TAIL = 1;
let _RESULT_TAIL = 2;

let _checkBlockBody = fn(prefix: Array<I32>, statements: Array<Stmt>, tail: ?AstExpr, first: I32, expected: I32, tailKind: I32): I32 {
  let outerStart = _scopeStart;
  _scopeStart = tailKind == _RESULT_TAIL ? 0 : _names.len();
  let before = narrowings();
  let children = prefix;
  let ends = false;
  let i = 0;

  while (i < statements.len()) {
    if (ends) {
      enterSyntax(syntaxChild(first + i));
      throw "unreachable statement";
    }
    let statement = _checkStatement(statements[i], syntaxChild(first + i));
    ends = H.endsPath(statement);
    children.push(statement);
    i++;
  }
  let ty = 0;
  let hasTail = false;

  if (tail != null) {
    let index = first + (statements.len() as I32);

    if ((tailKind == _STATEMENT_TAIL) && !ends) { children.push(checkEffect(tail, index)); } else {
      let checked = tailKind == _RESULT_TAIL ? _checkResult(tail, index, "function result type mismatch") : checkOperand(tail, index, expected);
      ty = H.typeOf(checked);
      hasTail = true;
      children.push(checked);
    }
  } else if ((tailKind == _RESULT_TAIL) && !ends) { throw "function can fall through without a value"; }
  _popTo(_scopeStart);
  _scopeStart = outerStart;
  keepNarrowings(before);
  H.node(Op.Block, ty, 0, hasTail ? 1 : 0, children)
};

export let checkArm: (Array<Bytes>, Array<I32>, Array<Stmt>, ?AstExpr, I32, I32, Bool) -> I32 = fn(names, values, statements, tail, first, expected, statement) {
  let mark = _names.len();
  let prefix = Array.new<I32>(0);
  let i = 0;

  while (i < names.len()) {
    let value = values[i];
    prefix.push(_unary(Op.Declare, 0, H.node(Op.Const, H.typeOf(value), _declare(names[i], H.typeOf(value), false), H.bytesId(names[i]), [value])));
    i++;
  }
  let block = _checkBlockBody(prefix, statements, tail, first, expected, statement ? _STATEMENT_TAIL : _VALUE_TAIL);
  _popTo(mark);
  block
};

let _checkBranch = fn(branch: AstExpr, index: I32): I32 {
  let outer = enterSyntax(syntaxChild(index));

  let block = match (branch) {
    BlockExpr(body) => match (body) { Block(statements, tail) => _checkBlockBody([], statements, tail, 0, -1, _STATEMENT_TAIL) },
    _ => {
      throw "if branch must be a block";
      -1
    },
  };
  enterSyntax(outer);
  block
};

_checkIfStatement = fn(condition, thenBranch, elseBranch) {
  let checkedCondition = _value(condition, 0);
  if (H.typeOf(checkedCondition) != H.TYPE_BOOL) { throw "if condition must be bool"; }
  let before = narrowings();
  _narrowBy(condition, true);
  let children = [checkedCondition, _checkBranch(thenBranch, 1)];
  keepNarrowings(before);
  _narrowBy(condition, false);

  match (elseBranch) {
    Null => null,
    If(_, _, _) => {
      children.push(checkEffect(elseBranch, 2));
      null
    },
    _ => {
      children.push(_checkBranch(elseBranch, 2));
      null
    },
  };
  keepNarrowings(before);
  let thenEnds = H.endsPath(children[1]);
  let elseEnds = (children.len() == 3) && H.endsPath(children[2]);
  if (thenEnds && !elseEnds) { _narrowBy(condition, false); }
  if (elseEnds && !thenEnds) { _narrowBy(condition, true); }
  H.node(Op.IfStatement, 0, 0, 0, children)
};

_checkTry = fn(body, catchName, handler, expected, statement) {
  if (_tries == 16) { throw "try regions nest more than 16 deep in one function"; }
  let tailKind = statement ? _STATEMENT_TAIL : _VALUE_TAIL;
  let before = narrowings();
  let mark = assignmentMark();
  _tries++;

  let checkedBody = match (body) { Block(statements, tail) => {
    if (!statement && (tail == null)) { throw "a try used as a value needs a value at the end of its body"; }
    _checkBlockBody([], statements, tail, 0, expected, tailKind)
  } };
  _tries--;
  let afterBody = narrowings();
  leaveLoop(before, mark);
  let scope = _names.len();
  let binding = catchName == null ? -1 : _declare(catchName, H.TYPE_DYNAMIC, false);
  let first = match (body) { Block(statements, tail) => (statements.len() as I32) + (tail == null ? 0 : 1) };

  let checkedHandler = match (handler) { Block(statements, tail) => {
    if (!statement && (tail == null)) { throw "a try used as a value needs a value at the end of its catch"; }
    _checkBlockBody([], statements, tail, first, expected, tailKind)
  } };
  _popTo(scope);
  if (H.endsPath(checkedHandler)) { setNarrowings(afterBody); } else if (!H.endsPath(checkedBody)) { keepNarrowings(afterBody); }
  let name = catchName == null ? 0 : H.bytesId(catchName);
  if (statement) { return H.node(Op.TryStatement, 0, binding, name, [checkedBody, checkedHandler]); }
  let ty = joinTypes(H.typeOf(checkedBody), H.typeOf(checkedHandler));
  if (ty < 0) { throw "try and catch values must have the same type, not " + H.typeName(H.typeOf(checkedBody)) + " and " + H.typeName(H.typeOf(checkedHandler)); }
  H.node(Op.Try, ty, binding, name, [_coerce(checkedBody, ty), _coerce(checkedHandler, ty)])
};

let _checkDestructure = fn(pattern: Pattern, isConst: Bool, typeParams: Array<Bytes>, annotation: ?AstType, value: AstExpr): I32 {
  let items = match (pattern) {
    Tuple(items) => items,
    _ => {
      enterSyntax(syntaxPattern(0));
      throw "this binding pattern is not supported yet";
      Array.new<Pattern>(0)
    },
  };
  if (typeParams.len() != 0) { throw "local bindings do not support type parameters"; }
  let ty = annotation == null ? -1 : checkType(annotation);
  let checked = checkOperand(value, 0, ty);
  let tuple = H.typeOf(checked);
  if ((ty >= 0) && (ty != tuple)) { throw "binding annotation type mismatch"; }

  if (!H.isKind(tuple, Kind.Tuple) || (H.typeArgCount(tuple) != items.len())) {
    throw "cannot destructure " + H.typeName(tuple) + " into " + Std.string(items.len()) + " names";
  }
  let hidden = newBinding();
  let children = [H.node(Op.Const, tuple, hidden, H.bytesId("tuple"), [checked])];
  let i = 0;

  while (i < items.len()) {
    let field = H.typeArg(tuple, i);
    let outer = enterSyntax(subPattern(syntaxPattern(0), i));

    match (items[i]) {
      Wildcard => null,
      BindPattern(name) => {
        if (_find(name, _scopeStart) >= 0) { throw "duplicate local: " + name; }
        let read = H.node(Op.TupleField, field, i, 0, [_leaf(Op.Local, tuple, hidden)]);
        children.push(H.node(isConst ? Op.Const : Op.Let, field, _declare(name, field, !isConst), H.bytesId(name), [read]));
        null
      },
      _ => {
        throw "nested patterns in let are not supported yet";
        null
      },
    };
    enterSyntax(outer);
    i++;
  }
  H.node(Op.Declare, 0, 0, 0, children)
};

export let checkWhile: (AstExpr, Array<Stmt>) -> I32 = fn(condition, body) {
  let before = narrowings();
  let mark = assignmentMark();
  enterLoop();
  let checkedCondition = _value(condition, 0);
  if (H.typeOf(checkedCondition) != H.TYPE_BOOL) { throw "while condition must be bool"; }
  _narrowBy(condition, true);
  _loops++;
  let checkedBody = _checkBlockBody([], body, null, 1, -1, _STATEMENT_TAIL);
  _loops--;
  leaveLoop(before, mark);
  H.node(Op.While, 0, 0, 0, [checkedCondition, checkedBody])
};

_checkStatement = fn(statement, syntax) {
  let outer = enterSyntax(syntax);

  let id = match (statement) {
    LetStmt(isConst, exported, pattern, typeParams, annotation, value) when (!exported && isBindPattern(pattern)) =>
      _unary(Op.Declare, 0, _checkLocal(pattern, isConst, typeParams, annotation, value)),
    LetStmt(isConst, exported, pattern, typeParams, annotation, value) when (!exported) =>
      _checkDestructure(pattern, isConst, typeParams, annotation, value),
    Expression(value) => checkEffect(value, 0),
    Return(value) => {
      if (value == null) { throw "value function requires a return value"; }
      _unary(Op.Return, 0, _checkResult(value, 0, "return type mismatch"))
    },
    Throw(value) => {
      let thrown = _value(value, 0);

      if (H.typeOf(thrown) == H.TYPE_BYTE_BUFFER) {
        enterSyntax(syntaxChild(0));
        throw "a buffer from Bytes.new cannot be thrown" + bufferHint(H.typeOf(thrown));
      }

      if (H.isKind(H.typeOf(thrown), Kind.List)) {
        enterSyntax(syntaxChild(0));
        throw "a list cannot be thrown: its nil would read as null (decision 42)";
      }
      _unary(Op.Throw, 0, thrown)
    },
    Break => {
      if (_loops == 0) { throw "break outside loop"; }
      _leaf(Op.Break, 0, 0)
    },
    Continue => {
      if (_loops == 0) { throw "continue outside loop"; }
      _leaf(Op.Continue, 0, 0)
    },
    While(condition, body) => checkWhile(condition, body),
    _ => {
      throw unsupportedStatement(statement);
      -1
    },
  };
  enterSyntax(outer);
  id
};

let _checkFunction = fn(index: I32, body: AstBlock, syntax: Syntax): Array<I32> {
  let outer = enterSyntax(syntax);
  let outerNames = _names;
  let outerIds = _ids;
  let outerLoops = _loops;
  let outerTries = _tries;
  let outerStart = _scopeStart;
  let outerKnown = narrowings();
  setNarrowings(Array.new<I32>(0));
  _frames.push(Frame.Frame(outerNames, outerIds));
  _captures.push(Array.new<I32>(0));
  _sources.push(Array.new<I32>(0));
  _names = Array.new<Bytes>(0);
  _ids = Array.new<I32>(0);
  _loops = 0;
  _tries = 0;
  _scopeStart = 0;
  let ty = _functionTypes[index];
  let name = _functionNames[index];
  let paramNames = _functionParams[index];
  let paramTypes = _functionParamTypes[index];
  let outerResult = _result;
  _result = ty < 0 ? -1 : H.innerOf(ty);
  let children = Array.new<I32>(0);
  let i = 0;

  while (i < paramNames.len()) {
    let paramType = paramTypes[i];
    let parent = enterSyntax(syntaxChild(i));
    children.push(H.node(Op.Parameter, paramType, _declare(paramNames[i], paramType, false), H.bytesId(paramNames[i]), []));
    enterSyntax(parent);
    i++;
  }
  let first = paramNames.len() as I32;

  match (body) { Block(statements, tail) => {
    let checked = _checkBlockBody([], statements, tail, first, -1, _RESULT_TAIL);
    if (_result < 0) { throw name + " never returns a value; annotate its result type"; }

    if (ty < 0) {
      ty = H.functionType(paramTypes, _result);
      _functionTypes[index] = ty;
    }
    let captures = _captures[_frames.len()];
    let c = 0;

    while (c < captures.len()) {
      children.push(captures[c]);
      c++;
    }
    children.push(checked);
    _functionNodes[index] = H.node(Op.Function, ty, H.bytesId(name), 0, children);
  } };
  let sources = _sources[_frames.len()];
  _frames.pop();
  _captures.pop();
  _sources.pop();
  _names = outerNames;
  _ids = outerIds;
  _result = outerResult;
  _loops = outerLoops;
  _tries = outerTries;
  _scopeStart = outerStart;
  setNarrowings(outerKnown);
  enterSyntax(outer);
  sources
};

export let checkFunctionBody: (I32, AstBlock, Syntax) -> Bool = fn(index, body, syntax) {
  _checkFunction(index, body, syntax);
  true
};

_checkFunctionLiteral = fn(params, result, body, expected) {
  let index = _addFunction("fn", params, result, expected);
  let captured = _checkFunction(index, body, _syntax);
  H.node(Op.FunctionRef, _functionType(index), index + 1, 0, captured)
};

_checkBlock = fn(statements, tail, expected) { _checkBlockBody([], statements, tail, 0, expected, _VALUE_TAIL) };

let _regexpKeys = Array.new<Bytes>(0);
let _regexpGlobals = Array.new<I32>(0);
let _regexpInits = Array.new<I32>(0);

export let regexpGlobal: (Bytes, Bytes) -> I32 = fn(pattern, flags) {
  let key = flags + "/" + pattern;
  let i = 0;

  while (i < _regexpKeys.len()) {
    if (_regexpKeys[i] == key) { return _regexpGlobals[i]; }
    i++;
  }
  let global = H.declareGlobal("~r/" + pattern + "/" + flags, H.TYPE_DYNAMIC, false);
  let compile = H.stdNative("regexp_compile", [H.TYPE_BYTES, H.TYPE_BYTES], H.TYPE_DYNAMIC);
  let compiled = H.node(Op.CallNative, H.TYPE_DYNAMIC, compile, 0, [_leaf(Op.Bytes, H.TYPE_BYTES, H.bytesId(pattern)), _leaf(Op.Bytes, H.TYPE_BYTES, H.bytesId(flags))]);
  _regexpInits.push(H.node(Op.Declare, 0, 0, 0, [H.node(Op.InitGlobal, H.TYPE_DYNAMIC, global, 0, [compiled])]));
  _regexpKeys.push(key);
  _regexpGlobals.push(global);
  global
};

export let takeRegexpInits: () -> Array<I32> = fn() {
  let inits = _regexpInits;
  _regexpKeys = Array.new<Bytes>(0);
  _regexpGlobals = Array.new<I32>(0);
  _regexpInits = Array.new<I32>(0);
  inits
};

export let beginCheck: () -> Bool = fn() {
  H.beginHir();
  resetNarrowing();
  _names = Array.new<Bytes>(0);
  _ids = Array.new<I32>(0);
  _nextBinding = 0;
  _bindingTypes = Array.new<I32>(0);
  _mutable = Array.new<Bool>(0);
  _assigned = Array.new<Bool>(0);
  _captured = Array.new<Bool>(0);
  _syntax = _noSyntax();
  _frames = Array.new<Frame>(0);
  _captures = [Array.new<I32>(0)];
  _sources = [Array.new<I32>(0)];
  _scopeStart = 0;
  _loops = 0;
  _tries = 0;
  _functionNames = Array.new<Bytes>(0);
  _functionTypes = Array.new<I32>(0);
  _functionParams = Array.new<Array<Bytes>>(0);
  _functionNodes = Array.new<I32>(0);
  _functionParamTypes = Array.new<Array<I32>>(0);
  _result = -1;
  takeRegexpInits();
  true
};

export let finishProgram: (I32) -> Hir = fn(body) {
  _functionNodes.push(body);
  let hir = H.finishHir(H.node(Op.Program, 0, 0, 0, _functionNodes));
  _syntax = _noSyntax();
  hir
};

export let checkFailureSpan: () -> ?SourceSpan = fn() {
  let span: ?SourceSpan = null;
  match (_syntax) { Node(path, start, end, _, _) => { if (path != "") { span = SourceSpan.Span(path, start, end); } } };
  span
};
