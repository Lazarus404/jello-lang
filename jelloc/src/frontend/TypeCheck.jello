package frontend;

import type {
  AssignOp, BinaryOp, Block as AstBlock, Expr as AstExpr, IntSize, Parameter, Pattern, Stmt, Type as AstType, UnaryOp,
} from frontend.Ast;
import { Block as AstBlock, Expr as AstExpr, bindPatternName, integerValue, isBindPattern } from frontend.Ast;
import type { Hir } from frontend.Hir;
import frontend.Hir as H;
import { Kind, Op } from frontend.Hir;
import { Binding, declareScoped, isImported, scoped, scopedType } from frontend.ModuleScope;
import type { SourceSpan, Syntax } from frontend.Source;
import { SourceSpan, Syntax } from frontend.Source;

let _names = Array.new<Bytes>(0);
let _ids = Array.new<I32>(0);
let _types = Array.new<I32>(0);
let _mutable = Array.new<Bool>(0);
let _nextBinding = 0;
let _scopeStart = 0;
let _loops = 0;
let _enclosing = Array.new<Bytes>(0);
let _functionNames = Array.new<Bytes>(0);
let _functionTypes = Array.new<I32>(0);
let _functionParams = Array.new<Array<Bytes>>(0);
let _functionNodes = Array.new<I32>(0);
let _functionParamTypes = Array.new<Array<I32>>(0);
let _result = -1;
let _arrayI32 = 0;
let _tupleI32 = 0;
let _nullI32 = 0;
let _noSyntax = fn(): Syntax { Syntax.Node("", 0, 0, Array.new<Syntax>(0)) };
let _syntax = _noSyntax();

export let enterSyntax: (Syntax) -> Syntax = fn(syntax) {
  let outer = _syntax;
  _syntax = syntax;
  match (syntax) { Node(path, start, end, _) => H.setSpan(path, start, end) };
  outer
};

let _childOf = fn(syntax: Syntax, index: I32): Syntax { match (syntax) { Node(_, _, _, children) => children[index] } };
export let syntaxChild: (I32) -> Syntax = fn(index) { _childOf(_syntax, index) };

let _find = fn(name: Bytes, start: I32): I32 {
  let i = _names.len() - 1;

  while (i >= start) {
    if (_names[i] == name) { return i; }
    i--;
  }
  -1
};

let _declare = fn(name: Bytes, ty: I32, mutable: Bool): I32 {
  let id = _nextBinding;
  _nextBinding++;
  _names.push(name);
  _ids.push(id);
  _types.push(ty);
  _mutable.push(mutable);
  id
};

let _popTo = fn(start: I32) {
  while (_names.len() > start) {
    _names.pop();
    _ids.pop();
    _types.pop();
    _mutable.pop();
  }
  null
};

let _leaf = fn(op: Op, ty: I32, value: I32): I32 { H.node(op, ty, value, 0, []) };
let _unary = fn(op: Op, ty: I32, operand: I32): I32 { H.node(op, ty, 0, 0, [operand]) };
let _binary = fn(op: Op, ty: I32, left: I32, right: I32): I32 { H.node(op, ty, 0, 0, [left, right]) };

let _isAstI32 = fn(ty: AstType): Bool { match (ty) { Named(name) => name == "I32", _ => false } };

export let checkType: (AstType) -> I32 = fn(_ty) { -1 };
checkType = fn(ty) { match (ty) {
  Named(name) => match (name) {
    "I32" => H.TYPE_I32,
    "I64" => H.TYPE_I64,
    "Bool" => H.TYPE_BOOL,
    "Bytes" => H.TYPE_BYTES,
    _ => {
      let named = scopedType(name);
      if (named < 0) { throw "unsupported type: " + name; }
      named
    },
  },
  Generic(name, args) => match (name) {
    "Array" when (args.len() == 1) => if (_isAstI32(args[0])) { _arrayI32 } else {
      throw "only Array<I32> is supported";
      -1
    },
    "Tuple" when (args.len() == 2) => if (_isAstI32(args[0]) && _isAstI32(args[1])) { _tupleI32 } else {
      throw "only Tuple<I32, I32> is supported";
      -1
    },
    _ => {
      throw "unsupported generic type";
      -1
    },
  },
  Function(args, result) => {
    let params = Array.new<I32>(0);
    let i = 0;

    while (i < args.len()) {
      params.push(checkType(args[i]));
      i++;
    }
    H.functionType(params, checkType(result))
  },
  OptionalArg(inner) => if (_isAstI32(inner)) { _nullI32 } else {
    throw "only ?I32 is supported";
    -1
  },
  _ => {
    throw "unsupported type in initial semantic slice";
    -1
  },
} };

let _checkExpr: (AstExpr, Syntax, I32) -> I32 = fn(_expr, _exprSyntax, _expected) { -1 };
let _checkBlock: (Array<Stmt>, ?AstExpr, I32) -> I32 = fn(_statements, _tail, _expected) { -1 };
let _checkEnum: (AstExpr, I32, Bool) -> I32 = fn(_expr, _expected, _statement) { -1 };

export let useEnumChecks: ((AstExpr, I32, Bool) -> I32) -> Bool = fn(check) {
  _checkEnum = check;
  true
};
let _isEnumName = fn(base: AstExpr): Bool { match (base) { Variable(name) => (_find(name, 0) < 0) && (scopedType(name) >= 0), _ => false } };

let _isEnumExpr = fn(expr: AstExpr): Bool {
  match (expr) {
    Match(_, _) => true,
    Member(base, _) => _isEnumName(base),
    Call(callee, _, _) => match (callee) { Member(base, _) => _isEnumName(base), _ => false },
    _ => false,
  }
};
let _value = fn(expr: AstExpr, index: I32): I32 { _checkExpr(expr, syntaxChild(index), -1) };
export let checkOperand: (AstExpr, I32, I32) -> I32 = fn(expr, index, expected) { _checkExpr(expr, syntaxChild(index), expected) };

let _checkInteger = fn(text: Bytes, size: IntSize, negative: Bool, expected: I32): I32 {
  let ty = match (size) {
    Infer => expected == H.TYPE_I64 ? H.TYPE_I64 : H.TYPE_I32,
    I32 => H.TYPE_I32,
    I64 => H.TYPE_I64,
    _ => {
      throw "integer literals narrower than I32 are not supported yet";
      H.TYPE_I32
    },
  };
  if (ty == H.TYPE_I64) { throw "I64 literals are not supported yet"; }
  _leaf(Op.I32, H.TYPE_I32, integerValue(text, negative))
};

let _checkUnary = fn(op: UnaryOp, value: AstExpr, expected: I32): I32 {
  match (op) {
    Negate => match (value) {
      Integer(digits, size) => _checkInteger(digits, size, true, expected),
      _ => {
        let operand = _value(value, 0);
        if (H.typeOf(operand) != H.TYPE_I32) { throw "i32 negation requires i32 operand"; }
        _unary(Op.Neg, H.TYPE_I32, operand)
      },
    },
    _ => {
      let operand = _value(value, 0);
      if (H.typeOf(operand) != H.TYPE_BOOL) { throw "bool not requires bool operand"; }
      _unary(Op.Not, H.TYPE_BOOL, operand)
    },
  }
};

let _isNull = fn(value: AstExpr): Bool { match (value) { Null => true, _ => false } };

let _checkNullComparison = fn(op: BinaryOp, value: AstExpr, index: I32): I32 {
  let operand = _value(value, index);
  if (H.typeOf(operand) != _nullI32) { throw "null comparison requires ?I32"; }

  match (op) {
    Equal => _unary(Op.IsNull, H.TYPE_BOOL, operand),
    NotEqual => _unary(Op.IsPresent, H.TYPE_BOOL, operand),
    _ => {
      throw "null supports only == and !=";
      -1
    },
  }
};

let _compare = fn(op: Op, left: I32, right: I32, negate: Bool): I32 {
  let compared = _binary(op, H.TYPE_BOOL, left, right);
  negate ? _unary(Op.Not, H.TYPE_BOOL, compared) : compared
};

let _checkBinary = fn(op: BinaryOp, leftExpr: AstExpr, rightExpr: AstExpr): I32 {
  let isEquality = match (op) { Equal, NotEqual => true, _ => false };

  if (isEquality && (_isNull(leftExpr) || _isNull(rightExpr))) {
    return _isNull(leftExpr) ? _checkNullComparison(op, rightExpr, 1) : _checkNullComparison(op, leftExpr, 0);
  }
  let left = _value(leftExpr, 0);
  let right = checkOperand(rightExpr, 1, H.typeOf(left));

  match (op) {
    And, Or => {
      if ((H.typeOf(left) != H.TYPE_BOOL) || (H.typeOf(right) != H.TYPE_BOOL)) { throw "&& and || require bool operands"; }
      return _binary(match (op) { And => Op.And, _ => Op.Or }, H.TYPE_BOOL, left, right);
    },
    _ => null,
  };
  if ((H.typeOf(left) != H.TYPE_I32) || (H.typeOf(right) != H.TYPE_I32)) { throw "i32 binary operation requires i32 operands"; }

  match (op) {
    Add => _binary(Op.Add, H.TYPE_I32, left, right),
    Subtract => _binary(Op.Sub, H.TYPE_I32, left, right),
    Multiply => _binary(Op.Mul, H.TYPE_I32, left, right),
    Equal => _compare(Op.Eq, left, right, false),
    NotEqual => _compare(Op.Eq, left, right, true),
    Less => _compare(Op.Lt, left, right, false),
    LessEqual => _compare(Op.Gt, left, right, true),
    Greater => _compare(Op.Gt, left, right, false),
    GreaterEqual => _compare(Op.Lt, left, right, true),
    _ => {
      throw "unsupported i32 binary operation";
      -1
    },
  }
};

let _checkCast = fn(value: AstExpr, targetType: AstType): I32 {
  let operand = _value(value, 0);
  let target = checkType(targetType);

  match ((H.kindOf(H.typeOf(operand)), H.kindOf(target))) {
    (I32, I64) => _unary(Op.Sext, H.TYPE_I64, operand),
    (I64, I32) => _unary(Op.Trunc, H.TYPE_I32, operand),
    _ => {
      throw "unsupported explicit cast";
      -1
    },
  }
};

let _functionType = fn(index: I32): I32 {
  let ty = _functionTypes[index];
  if (ty < 0) { throw _functionNames[index] + " is used before its result type is inferred; annotate its result type"; }
  ty
};

let _checkVariable = fn(name: Bytes): I32 {
  let found = _find(name, 0);
  if (found >= 0) { return _leaf(Op.Local, _types[found], _ids[found]); }
  let i = 0;

  while (i < _enclosing.len()) {
    if (_enclosing[i] == name) { throw "closures that capture variables are not supported yet: " + name; }
    i++;
  }

  match (scoped(name)) {
    Global(id) => _leaf(Op.Global, H.globalTypeOf(id), id),
    Function(index) => _leaf(Op.FunctionRef, _functionType(index), index + 1),
    Unbound => {
      throw "unknown local: " + name;
      -1
    },
  }
};

let _checkTuple = fn(items: Array<AstExpr>): I32 {
  if (items.len() != 2) { throw "only Tuple<I32, I32> literals are supported"; }
  let first = _value(items[0], 0);
  let second = _value(items[1], 1);
  if ((H.typeOf(first) != H.TYPE_I32) || (H.typeOf(second) != H.TYPE_I32)) { throw "tuple literal requires two I32 values"; }
  H.node(Op.Tuple, _tupleI32, 0, 0, [first, second])
};

let _checkTupleField = fn(base: AstExpr, member: Bytes): I32 {
  let value = _value(base, 0);
  if ((H.typeOf(value) != _tupleI32) || ((member != "0") && (member != "1"))) { throw "Tuple<I32, I32> field must be .0 or .1"; }
  H.node(Op.TupleField, H.TYPE_I32, member == "0" ? 0 : 1, 0, [value])
};

let _checkIndex = fn(baseExpr: AstExpr, indexExpr: AstExpr): I32 {
  let base = _value(baseExpr, 0);
  let index = _value(indexExpr, 1);
  if (H.typeOf(index) != H.TYPE_I32) { throw "index requires an I32 index"; }

  match (H.kindOf(H.typeOf(base))) {
    Bytes => _binary(Op.BytesGet, H.TYPE_I32, base, index),
    Array => _binary(Op.ArrayGet, H.innerOf(H.typeOf(base)), base, index),
    _ => {
      throw "index requires Bytes or Array<I32>";
      -1
    },
  }
};

let _checkArrayNew = fn(element: AstType, length: AstExpr): I32 {
  if (!_isAstI32(element)) { throw "only Array.new<I32> is supported"; }
  let checked = _value(length, 1);
  if (H.typeOf(checked) != H.TYPE_I32) { throw "Array.new<I32> length must be I32"; }
  _unary(Op.ArrayNew, _arrayI32, checked)
};

let _arguments = fn(function: I32, args: Array<AstExpr>, children: Array<I32>, lift: Bool, message: Bytes): Array<I32> {
  let i = 0;

  while (i < args.len()) {
    let syntax = syntaxChild(i + 1);
    let expected = H.typeArg(function, i);
    let arg = _checkExpr(args[i], syntax, expected);
    let outer = enterSyntax(syntax);

    if (lift && (expected == _nullI32)) {
      if (H.typeOf(arg) == H.TYPE_I32) { arg = _unary(Op.Present, expected, arg); } else if (H.typeOf(arg) != expected) { throw "?I32 requires I32 or null"; }
    }
    if (H.typeOf(arg) != expected) { throw message; }
    enterSyntax(outer);
    children.push(arg);
    i++;
  }
  children
};

let _checkIndirectCall = fn(callee: I32, args: Array<AstExpr>): I32 {
  let ty = H.typeOf(callee);
  if (!H.isKind(ty, Kind.Function)) { throw "call target is not a function"; }
  if (args.len() != H.typeArgCount(ty)) { throw "wrong indirect call argument count"; }
  H.node(Op.CallIndirect, H.innerOf(ty), 0, 0, _arguments(ty, args, [callee], false, "wrong indirect call argument type"))
};

let _checkDirectCall = fn(index: I32, args: Array<AstExpr>): I32 {
  let ty = _functionType(index);
  let name = _functionNames[index];
  if (args.len() != H.typeArgCount(ty)) { throw "wrong argument count for " + name; }
  H.node(Op.Call, H.innerOf(ty), index + 1, 0, _arguments(ty, args, [], true, "wrong argument type for " + name))
};

let _isArrayNew = fn(callee: AstExpr): Bool {
  match (callee) { Member(base, member) => (member == "new") && (match (base) { Variable(name) => name == "Array", _ => false }), _ => false }
};

let _checkCall = fn(callee: AstExpr, typeArgs: Array<AstType>, args: Array<AstExpr>): I32 {
  match (callee) {
    TypeApply(base, applied) => {
      if (!_isArrayNew(base) || (typeArgs.len() != 0) || (applied.len() != 1) || (args.len() != 1)) { throw "unsupported type-applied call"; }
      _checkArrayNew(applied[0], args[0])
    },
    Member(base, member) => if (_isArrayNew(callee)) {
      if ((typeArgs.len() != 1) || (args.len() != 1)) { throw "Array.new requires one type argument and one length"; }
      _checkArrayNew(typeArgs[0], args[0])
    } else {
      if ((member != "len") || (typeArgs.len() != 0) || (args.len() != 0)) { throw "unsupported method call"; }
      let array = _checkExpr(base, _childOf(syntaxChild(0), 0), -1);
      if (H.typeOf(array) != _arrayI32) { throw "len requires Array<I32>"; }
      _unary(Op.ArrayLen, H.TYPE_I32, array)
    },
    Variable(name) => {
      if (typeArgs.len() != 0) { throw "calls do not support type arguments"; }
      let direct = _find(name, 0) >= 0 ? Binding.Unbound : scoped(name);
      match (direct) { Function(index) => _checkDirectCall(index, args), _ => _checkIndirectCall(_value(callee, 0), args) }
    },
    _ => {
      if (typeArgs.len() != 0) { throw "indirect calls do not support type arguments"; }
      _checkIndirectCall(_value(callee, 0), args)
    },
  }
};

let _checkIf = fn(condition: AstExpr, thenBranch: AstExpr, elseBranch: AstExpr, expected: I32): I32 {
  let checkedCondition = _value(condition, 0);
  if (H.typeOf(checkedCondition) != H.TYPE_BOOL) { throw "if condition must be bool"; }
  let checkedThen = checkOperand(thenBranch, 1, expected);
  let checkedElse = checkOperand(elseBranch, 2, expected);
  if (H.typeOf(checkedThen) != H.typeOf(checkedElse)) { throw "if branches must have the same type"; }
  H.node(Op.If, H.typeOf(checkedThen), 0, 0, [checkedCondition, checkedThen, checkedElse])
};

let _checkVariableAssignment = fn(op: AssignOp, name: Bytes, value: AstExpr): I32 {
  let found = _find(name, 0);
  let global = found < 0;
  let ty = -1;
  let id = -1;

  if (global) {
    id = match (scoped(name)) {
      Global(target) => target,
      Function(_) => {
        throw "cannot assign to function: " + name;
        -1
      },
      Unbound => {
        throw "unknown local: " + name;
        -1
      },
    };
    if (isImported(name)) { throw "cannot assign to imported binding: " + name; }
    ty = H.globalTypeOf(id);
    if (!H.globalIsMutable(id)) { throw "cannot assign to immutable global: " + name; }
  } else {
    if (!_mutable[found]) { throw "cannot assign to immutable local: " + name; }
    id = _ids[found];
    ty = _types[found];
  }
  let checked = checkOperand(value, 1, ty);
  if (H.typeOf(checked) != ty) { throw "assignment type mismatch: " + name; }
  let assign = global ? Op.SetGlobal : Op.Assign;

  match (op) {
    Assign => H.node(assign, ty, id, 0, [checked]),
    Add, Subtract => {
      if (ty != H.TYPE_I32) { throw "compound assignment requires i32 local: " + name; }
      let operation = match (op) { Add => Op.Add, _ => Op.Sub };
      let outer = enterSyntax(syntaxChild(0));
      let target = _leaf(global ? Op.Global : Op.Local, ty, id);
      enterSyntax(outer);
      H.node(assign, ty, id, 0, [_binary(operation, H.TYPE_I32, target, checked)])
    },
    _ => {
      throw "unsupported compound assignment";
      -1
    },
  }
};

let _checkAssignment = fn(op: AssignOp, target: AstExpr, value: AstExpr): I32 {
  let isAssign = match (op) { Assign => true, _ => false };

  match (target) {
    Variable(name) => _checkVariableAssignment(op, name, value),
    Index(base, index) when (isAssign) => {
      let place = syntaxChild(0);
      let array = _checkExpr(base, _childOf(place, 0), -1);
      let checkedIndex = _checkExpr(index, _childOf(place, 1), -1);
      let checked = checkOperand(value, 1, H.isKind(H.typeOf(array), Kind.Array) ? H.innerOf(H.typeOf(array)) : -1);

      if ((H.typeOf(array) != _arrayI32) || (H.typeOf(checkedIndex) != H.TYPE_I32) || (H.typeOf(checked) != H.TYPE_I32)) {
        throw "Array<I32> assignment requires Array<I32>, I32 index, and I32 value";
      }
      H.node(Op.ArraySet, H.TYPE_I32, 0, 0, [array, checkedIndex, checked])
    },
    _ => {
      throw "unsupported expression in initial semantic slice";
      -1
    },
  }
};

let _checkFunctionLiteral: (Array<Parameter>, ?AstType, AstBlock, I32) -> I32 = fn(_params, _result, _body, _expected) { -1 };

_checkExpr = fn(expr, syntax, expected) {
  let outer = enterSyntax(syntax);

  let id = match (expr) {
    _ when (_isEnumExpr(expr)) => _checkEnum(expr, expected, false),
    Bytes(value) => _leaf(Op.Bytes, H.TYPE_BYTES, H.bytesId(value)),
    Bool(value) => _leaf(Op.Bool, H.TYPE_BOOL, value ? 1 : 0),
    Null => _leaf(Op.Null, _nullI32, 0),
    Integer(digits, size) => _checkInteger(digits, size, false, expected),
    Unary(op, value) => _checkUnary(op, value, expected),
    Binary(op, left, right) => _checkBinary(op, left, right),
    Cast(value, ty) => _checkCast(value, ty),
    Variable(name) => _checkVariable(name),
    Tuple(items) => _checkTuple(items),
    Member(base, member) => _checkTupleField(base, member),
    Index(base, index) => _checkIndex(base, index),
    Call(callee, typeArgs, args) => _checkCall(callee, typeArgs, args),
    If(condition, thenBranch, elseBranch) => _checkIf(condition, thenBranch, elseBranch, expected),
    BlockExpr(block) => match (block) { Block(statements, tail) => {
      if (tail == null) { throw "value block requires a trailing expression"; }
      _checkBlock(statements, tail, expected)
    } },
    Assign(op, target, value) => _checkAssignment(op, target, value),
    Function(params, result, body, isMethod) when (!isMethod) => _checkFunctionLiteral(params, result, body, expected),
    _ => {
      throw "unsupported expression in initial semantic slice";
      -1
    },
  };
  enterSyntax(outer);
  id
};

let _isFunctionValue = fn(value: AstExpr): Bool { match (value) { Function(_, _, _, isMethod) => !isMethod, _ => false } };

export let isDirectFunction: (Stmt) -> Bool = fn(statement) {
  match (statement) {
    LetStmt(_, _, pattern, _, annotation, value) => isBindPattern(pattern) && (annotation == null) && _isFunctionValue(value),
    _ => false,
  }
};

let _addFunction = fn(name: Bytes, params: Array<Parameter>, result: ?AstType, expected: I32): I32 {
  let fits = (expected >= 0) && H.isKind(expected, Kind.Function) && (H.typeArgCount(expected) == params.len());
  let names = Array.new<Bytes>(0);
  let types = Array.new<I32>(0);
  let i = 0;

  while (i < params.len()) {
    match (params[i]) { Parameter(paramName, paramType, kind) => {
      match (kind) {
        Required => null, _ => {
          throw "only required parameters are supported";
          null
        }
      };
      let j = 0;

      while (j < names.len()) {
        if (names[j] == paramName) { throw "duplicate parameter: " + paramName; }
        j++;
      }
      let ty = paramType != null ? checkType(paramType) : fits ? H.typeArg(expected, i) : -1;
      if (ty < 0) { throw "parameter " + paramName + " of " + name + " needs a type"; }
      names.push(paramName);
      types.push(ty);
    } };
    i++;
  }
  let resultType = result != null ? checkType(result) : fits ? H.innerOf(expected) : -1;
  _functionNames.push(name);
  _functionTypes.push(resultType < 0 ? -1 : H.functionType(types, resultType));
  _functionParams.push(names);
  _functionParamTypes.push(types);
  _functionNodes.push(-1);
  (_functionNames.len() - 1) as I32
};

let _declareFunction = fn(name: Bytes, typeParams: Array<Bytes>, value: AstExpr) {
  if (typeParams.len() != 0) { throw "generic functions are not supported yet: " + name; }

  match (value) {
    Function(params, result, _, _) => declareScoped(name, Binding.Function(_addFunction(name, params, result, -1))),
    _ => true,
  };
  null
};

export let declareFunctions: (Array<Stmt>) -> I32 = fn(statements) {
  let first = _functionNames.len() as I32;
  let i = 0;

  while (i < statements.len()) {
    let outer = enterSyntax(syntaxChild(i));

    match (statements[i]) {
      LetStmt(_, _, pattern, typeParams, _, value) when (isDirectFunction(statements[i])) =>
        _declareFunction(bindPatternName(pattern), typeParams, value),
      _ => null,
    };
    enterSyntax(outer);
    i++;
  }
  first
};

let _checkLocal = fn(pattern: Pattern, isConst: Bool, typeParams: Array<Bytes>, annotation: ?AstType, value: AstExpr): I32 {
  let name = bindPatternName(pattern);
  if (typeParams.len() != 0) { throw "local bindings do not support type parameters"; }
  if (_find(name, _scopeStart) >= 0) { throw "duplicate local: " + name; }
  let ty = annotation == null ? -1 : checkType(annotation);
  let checked = checkOperand(value, 0, ty);
  if (ty < 0) { ty = H.typeOf(checked); } else if (ty != H.typeOf(checked)) { throw "binding annotation type mismatch: " + name; }
  H.node(isConst ? Op.Const : Op.Let, ty, _declare(name, ty, !isConst), H.bytesId(name), [checked])
};

let _checkResult = fn(value: AstExpr, index: I32, message: Bytes): I32 {
  let checked = checkOperand(value, index, _result);
  if (_result < 0) { _result = H.typeOf(checked); } else if (H.typeOf(checked) != _result) { throw message; }
  checked
};

let _checkStatement: (Stmt, Syntax) -> I32 = fn(_statement, _statementSyntax) { -1 };
let _checkIfStatement: (AstExpr, AstExpr, AstExpr) -> I32 = fn(_condition, _thenBranch, _elseBranch) { -1 };

export let checkEffect: (AstExpr, I32) -> I32 = fn(value, index) {
  match (value) {
    If(condition, thenBranch, elseBranch) => {
      let outer = enterSyntax(syntaxChild(index));
      let id = _checkIfStatement(condition, thenBranch, elseBranch);
      enterSyntax(outer);
      id
    },
    Match(_, _) => {
      let outer = enterSyntax(syntaxChild(index));
      let id = _checkEnum(value, -1, true);
      enterSyntax(outer);
      id
    },
    _ => _unary(Op.Expression, 0, checkOperand(value, index, -1)),
  }
};

let _STATEMENT_TAIL = 0;
let _VALUE_TAIL = 1;
let _RESULT_TAIL = 2;

let _checkBlockBody = fn(prefix: Array<I32>, statements: Array<Stmt>, tail: ?AstExpr, first: I32, expected: I32, tailKind: I32): I32 {
  let outerStart = _scopeStart;
  _scopeStart = tailKind == _RESULT_TAIL ? 0 : _names.len();
  let children = prefix;
  let ends = false;
  let i = 0;

  while (i < statements.len()) {
    if (ends) {
      enterSyntax(syntaxChild(first + i));
      throw "unreachable statement";
    }
    let statement = _checkStatement(statements[i], syntaxChild(first + i));
    ends = H.endsPath(statement);
    children.push(statement);
    i++;
  }
  let ty = 0;
  let hasTail = false;

  if (tail != null) {
    let index = first + (statements.len() as I32);

    if ((tailKind == _STATEMENT_TAIL) && !ends) { children.push(checkEffect(tail, index)); } else {
      let checked = ((tailKind == _RESULT_TAIL) && !ends) ? _checkResult(tail, index, "function result type mismatch")
        : checkOperand(tail, index, tailKind == _RESULT_TAIL ? _result : expected);
      ty = H.typeOf(checked);
      hasTail = true;
      children.push(checked);
    }
  } else if ((tailKind == _RESULT_TAIL) && !ends) { throw "function can fall through without a value"; }
  _popTo(_scopeStart);
  _scopeStart = outerStart;
  H.node(Op.Block, ty, 0, hasTail ? 1 : 0, children)
};

export let checkArm: (Array<Bytes>, Array<I32>, Array<Stmt>, ?AstExpr, I32, I32, Bool) -> I32 = fn(names, values, statements, tail, first, expected, statement) {
  let mark = _names.len();
  let prefix = Array.new<I32>(0);
  let i = 0;

  while (i < names.len()) {
    let value = values[i];
    prefix.push(_unary(Op.Declare, 0, H.node(Op.Const, H.typeOf(value), _declare(names[i], H.typeOf(value), false), H.bytesId(names[i]), [value])));
    i++;
  }
  let block = _checkBlockBody(prefix, statements, tail, first, expected, statement ? _STATEMENT_TAIL : _VALUE_TAIL);
  _popTo(mark);
  block
};

export let newBinding: () -> I32 = fn() {
  let id = _nextBinding;
  _nextBinding++;
  id
};

let _checkBranch = fn(branch: AstExpr, index: I32): I32 {
  let outer = enterSyntax(syntaxChild(index));

  let block = match (branch) {
    BlockExpr(body) => match (body) { Block(statements, tail) => _checkBlockBody([], statements, tail, 0, -1, _STATEMENT_TAIL) },
    _ => {
      throw "if branch must be a block";
      -1
    },
  };
  enterSyntax(outer);
  block
};

_checkIfStatement = fn(condition, thenBranch, elseBranch) {
  let checkedCondition = _value(condition, 0);
  if (H.typeOf(checkedCondition) != H.TYPE_BOOL) { throw "if condition must be bool"; }
  let children = [checkedCondition, _checkBranch(thenBranch, 1)];

  match (elseBranch) {
    Null => null,
    If(_, _, _) => {
      children.push(checkEffect(elseBranch, 2));
      null
    },
    _ => {
      children.push(_checkBranch(elseBranch, 2));
      null
    },
  };
  H.node(Op.IfStatement, 0, 0, 0, children)
};

_checkStatement = fn(statement, syntax) {
  let outer = enterSyntax(syntax);

  let id = match (statement) {
    LetStmt(isConst, exported, pattern, typeParams, annotation, value) when (!exported && isBindPattern(pattern)) =>
      _unary(Op.Declare, 0, _checkLocal(pattern, isConst, typeParams, annotation, value)),
    Expression(value) => checkEffect(value, 0),
    Return(value) => {
      if (value == null) { throw "value function requires a return value"; }
      _unary(Op.Return, 0, _checkResult(value, 0, "return type mismatch"))
    },
    Throw(value) => _unary(Op.Throw, 0, _value(value, 0)),
    Break => {
      if (_loops == 0) { throw "break outside loop"; }
      _leaf(Op.Break, 0, 0)
    },
    Continue => {
      if (_loops == 0) { throw "continue outside loop"; }
      _leaf(Op.Continue, 0, 0)
    },
    While(condition, body) => {
      let checkedCondition = _value(condition, 0);
      if (H.typeOf(checkedCondition) != H.TYPE_BOOL) { throw "while condition must be bool"; }
      _loops++;
      let checkedBody = _checkBlockBody([], body, null, 1, -1, _STATEMENT_TAIL);
      _loops--;
      H.node(Op.While, 0, 0, 0, [checkedCondition, checkedBody])
    },
    _ => {
      throw "unsupported statement in function body";
      -1
    },
  };
  enterSyntax(outer);
  id
};

export let checkFunctionBody: (I32, AstBlock, Syntax) -> Bool = fn(index, body, syntax) {
  let outer = enterSyntax(syntax);
  let outerNames = _names;
  let outerIds = _ids;
  let outerTypes = _types;
  let outerMutable = _mutable;
  let outerLoops = _loops;
  let outerStart = _scopeStart;
  let enclosing = _enclosing.len();
  let k = 0;

  while (k < outerNames.len()) {
    _enclosing.push(outerNames[k]);
    k++;
  }
  _names = Array.new<Bytes>(0);
  _ids = Array.new<I32>(0);
  _types = Array.new<I32>(0);
  _mutable = Array.new<Bool>(0);
  _loops = 0;
  _scopeStart = 0;
  let ty = _functionTypes[index];
  let name = _functionNames[index];
  let paramNames = _functionParams[index];
  let paramTypes = _functionParamTypes[index];
  let outerResult = _result;
  _result = ty < 0 ? -1 : H.innerOf(ty);
  let children = Array.new<I32>(0);
  let i = 0;

  while (i < paramNames.len()) {
    let paramType = paramTypes[i];
    let parent = enterSyntax(syntaxChild(i));
    children.push(H.node(Op.Parameter, paramType, _declare(paramNames[i], paramType, false), H.bytesId(paramNames[i]), []));
    enterSyntax(parent);
    i++;
  }
  let first = paramNames.len() as I32;

  match (body) { Block(statements, tail) => {
    let checked = _checkBlockBody([], statements, tail, first, -1, _RESULT_TAIL);
    if (_result < 0) { throw name + " never returns a value; annotate its result type"; }

    if (ty < 0) {
      ty = H.functionType(paramTypes, _result);
      _functionTypes[index] = ty;
    }
    children.push(checked);
    _functionNodes[index] = H.node(Op.Function, ty, H.bytesId(name), 0, children);
  } };
  _names = outerNames;
  _ids = outerIds;
  _types = outerTypes;
  _mutable = outerMutable;
  _result = outerResult;
  _loops = outerLoops;
  _scopeStart = outerStart;
  while (_enclosing.len() > enclosing) { _enclosing.pop(); }
  enterSyntax(outer);
  true
};

_checkFunctionLiteral = fn(params, result, body, expected) {
  let index = _addFunction("fn", params, result, expected);
  checkFunctionBody(index, body, _syntax);
  _leaf(Op.FunctionRef, _functionType(index), index + 1)
};

_checkBlock = fn(statements, tail, expected) { _checkBlockBody([], statements, tail, 0, expected, _VALUE_TAIL) };

export let beginCheck: () -> Bool = fn() {
  H.beginHir();
  _arrayI32 = H.arrayType(H.TYPE_I32);
  _tupleI32 = H.tupleType([H.TYPE_I32, H.TYPE_I32]);
  _nullI32 = H.nullType(H.TYPE_I32);
  _names = Array.new<Bytes>(0);
  _ids = Array.new<I32>(0);
  _types = Array.new<I32>(0);
  _mutable = Array.new<Bool>(0);
  _nextBinding = 0;
  _syntax = _noSyntax();
  _enclosing = Array.new<Bytes>(0);
  _scopeStart = 0;
  _loops = 0;
  _functionNames = Array.new<Bytes>(0);
  _functionTypes = Array.new<I32>(0);
  _functionParams = Array.new<Array<Bytes>>(0);
  _functionNodes = Array.new<I32>(0);
  _functionParamTypes = Array.new<Array<I32>>(0);
  _result = -1;
  true
};

export let finishProgram: (I32) -> Hir = fn(body) {
  _functionNodes.push(body);
  let hir = H.finishHir(H.node(Op.Program, 0, 0, 0, _functionNodes));
  _syntax = _noSyntax();
  hir
};

export let checkFailureSpan: () -> ?SourceSpan = fn() {
  let span: ?SourceSpan = null;
  match (_syntax) { Node(path, start, end, _) => { if (path != "") { span = SourceSpan.Span(path, start, end); } } };
  span
};
