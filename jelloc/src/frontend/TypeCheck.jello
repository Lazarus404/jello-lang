package frontend;

import type {
  AssignOp, BinaryOp, Block as AstBlock, Expr as AstExpr, FloatSize, IncDecOp, IntSize, Parameter, ParameterKind, Pattern, Stmt, Type as AstType, TypeParam, UnaryOp,
} from frontend.Ast;
import { Block as AstBlock, Expr as AstExpr, bindPatternName, integerIn, integerValue, isBindPattern, unsignedWideValue, wideIntegerValue } from frontend.Ast;
import { appendFrom, indexOf } from std.core.Arrays;
import type { Hir } from frontend.Hir;
import frontend.Hir as H;
import { Kind, Op } from frontend.Hir;
import {
  beginDoubt, beginTouch, doubt, endDoubt, endTouch, failureCount, noteFailure, poison, poisonLocal, recordFailure, resetFailures, touch, touchLocal, touched,
} from frontend.Failures;
import { internalError } from frontend.Internal;
import type { Binding } from frontend.ModuleScope;
import { Binding, currentModule, declareScoped, isImported, namespaceMember, scoped, scopedType, useModuleScope } from frontend.ModuleScope;
import {
  assignLocal, assignmentMark, enterLoop, isNarrowed, keepNarrowings, leaveLoop, narrow, narrowings, resetNarrowing, setNarrowings,
} from frontend.Narrowing;
import type { SourceSpan, Syntax } from frontend.Source;
import { SourceSpan, Syntax } from frontend.Source;

load { f64_low_bits, f64_high_bits, f32_bits, f16_bits } from std;
let _f64Low: (Bytes) -> I32 = f64_low_bits;
let _f64High: (Bytes) -> I32 = f64_high_bits;
let _f64Bits = fn(text: Bytes): I64 { ((_f64High(text) as I64) << 32) | ((_f64Low(text) as I64) & 4294967295) };
let _f32Bits: (Bytes) -> I32 = f32_bits;
let _f16Bits: (Bytes) -> I32 = f16_bits;

let _nameIds = Array.new<I32>(0);
let _ids = Array.new<I32>(0);
let _hidden = Array.new<I32>(0);
let _latest = Array.new<I32>(0);
let _nextBinding = 0;
let _bindingTypes = Array.new<I32>(0);
let _mutable = Array.new<Bool>(0);
let _declarations = Array.new<Syntax>(0);
let _globalDeclarations = Array.new<Syntax>(0);
let _scopeStart = 0;
let _loops = 0;
let _tries = 0;
enum Frame { Frame(nameIds: Array<I32>, ids: Array<I32>); }
let _frames = Array.new<Frame>(0);
let _captures = [Array.new<I32>(0)];
let _sources = [Array.new<I32>(0)];
let _functionNames = Array.new<Bytes>(0);
let _functionTypes = Array.new<I32>(0);
let _functionParams = Array.new<Array<Bytes>>(0);
let _functionNodes = Array.new<I32>(0);
let _functionParamTypes = Array.new<Array<I32>>(0);
let _functionDefaults = Array.new<Array<I32>>(0);
let _functionSyntaxes = Array.new<Syntax>(0);
let _resultSyntax = _noSyntax();
let _result = -1;
let _resultInferred = false;
let _results = Array.new<I32>(0);
let _resultsStart = 0;
let _noSyntax = fn(): Syntax { Syntax.Node("", 0, 0, Array.new<Syntax>(0), Array.new<Syntax>(0)) };
let _syntax = _noSyntax();
let _moduleSyntax = _noSyntax();
let _statements = Array.new<Stmt>(0);
let _directStatements = Array.new<I32>(0);
let _firstDirect = 0;
let _globals = Array.new<I32>(0);
let _bodyName = "";

enum Template {
  Template(
    name: Bytes, params: Array<I32>, value: AstExpr, syntax: Syntax, module: I32, bodyName: Bytes,
    names: Array<Bytes>, envTypes: Array<I32>, locals: Array<I32>, keys: Array<I32>, functions: Array<I32>
  );
}
let _templates = Array.new<Template>(0);
let _templateFunctions = Array.new<I32>(0);
let _envNames = Array.new<Bytes>(0);
let _envTypes = Array.new<I32>(0);
let _templateBody = false;
let _dropped = Array.new<Bool>(0);
let _captureFloor = 0;
let _pending = Array.new<Tuple<I32, I32, Array<I32>, I32>>(0);
let _instanceDepth = 0;
let _NO_NAMES = Array.new<Bytes>(0);
let _NO_TYPES = Array.new<I32>(0);

export let inTemplate: () -> Bool = fn() { _templateBody };

export let enterSyntax: (Syntax) -> Syntax = fn(syntax) {
  let outer = _syntax;
  _syntax = syntax;
  match (syntax) { Node(path, start, end, _, _) => H.setSpan(path, start, end) };
  outer
};

let _spanOf = fn(syntax: Syntax): ?SourceSpan {
  let span: ?SourceSpan = null;
  match (syntax) { Node(path, start, end, _, _) => { if (path != "") { span = SourceSpan.Span(path, start, end); } } };
  span
};

export let currentSpan: () -> ?SourceSpan = fn() { _spanOf(_syntax) };

export let recover: (Dynamic) -> Bool = fn(error) {
  if (!recordFailure(currentSpan(), error)) { throw error; }
  true
};

let _spanSyntax = fn(path: Bytes, start: I32, end: I32): Syntax { Syntax.Node(path, start, end, Array.new<Syntax>(0), Array.new<Syntax>(0)) };

let _childOf = fn(syntax: Syntax, index: I32): Syntax { match (syntax) { Node(_, _, _, children, _) => children[index] } };
export let syntaxChild: (I32) -> Syntax = fn(index) { _childOf(_syntax, index) };

let _rejectAt = fn(index: I32, failure: Bytes) {
  let outer = enterSyntax(syntaxChild(index));
  recover(failure as Dynamic);
  enterSyntax(outer);
  null
};
export let rejectAt: (I32, Bytes) -> Null = fn(index, failure) { _rejectAt(index, failure) };

export let syntaxPattern: (I32) -> Syntax = fn(index) { match (_syntax) { Node(_, _, _, _, patterns) => patterns[index] } };
export let subPattern: (Syntax, I32) -> Syntax = fn(syntax, index) { _childOf(syntax, index) };

let _find = fn(name: Bytes, start: I32): I32 {
  let nameId = H.findBytesId(name);
  if ((nameId < 0) || (nameId >= _latest.len())) { return -1; }
  let found = _latest[nameId];
  ((found >= start) && (found < _nameIds.len()) && (_nameIds[found] == nameId)) ? found : -1
};

export let newBinding: () -> I32 = fn() {
  let id = _nextBinding;
  _nextBinding++;
  _bindingTypes.push(-1);
  _mutable.push(false);
  _declarations.push(_syntax);
  id
};

let _declare = fn(name: Bytes, ty: I32, mutable: Bool): I32 {
  let id = newBinding();
  _bindingTypes[id] = ty;
  _mutable[id] = mutable;
  if (name == "_") { return id; }
  let nameId = H.bytesId(name);
  while (_latest.len() <= nameId) { _latest.push(-1); }
  _hidden.push(_latest[nameId]);
  _latest[nameId] = _nameIds.len() as I32;
  _nameIds.push(nameId);
  _ids.push(id);
  id
};

let _popTo = fn(start: I32) {
  while (_nameIds.len() > start) {
    let last = _nameIds.len() - 1;
    _latest[_nameIds[last]] = _hidden[last];
    _nameIds.pop();
    _ids.pop();
    _hidden.pop();
  }
  null
};

let _bindingTemplate = fn(id: I32): I32 {
  let ty = _bindingTypes[id];
  ty < -1 ? -2 - ty : -1
};

let _typeOfBinding = fn(id: I32): I32 {
  let ty = H.resolve(_bindingTypes[id]);
  _bindingTypes[id] = ty;
  ty
};

let _leaf = fn(op: Op, ty: I32, value: I32): I32 { H.node(op, ty, value, 0, []) };
let _unary = fn(op: Op, ty: I32, operand: I32): I32 { H.node(op, ty, 0, 0, [operand]) };
let _binary = fn(op: Op, ty: I32, left: I32, right: I32): I32 { H.node(op, ty, 0, 0, [left, right]) };

export let checkType: (AstType) -> I32 = fn(_ty) { -1 };

let _arityMismatch = fn(name: Bytes, params: I32, count: I32): Bytes {
  name + " takes " + Std.string(params) + (params == 1 ? " type argument" : " type arguments") + ", not " + Std.string(count)
};

export let checkTypeArgCount: (Bytes, I32, I32) -> Bool = fn(name, ty, count) {
  if (ty < 0) {
    touch(name);
    throw "unsupported type: " + name;
  }
  if (count != H.enumParamCount(ty)) { throw _arityMismatch(name, H.enumParamCount(ty), count); }
  true
};

export let needsBound: (I32, Bytes) -> Bytes = fn(param, bound) {
  "needs the bound " + bound + ": write <" + H.typeName(param) + ": " + bound + ">"
};

let _checkTypes = fn(types: Array<AstType>): Array<I32> {
  let checked = Array.new<I32>(0);
  let i = 0;

  while (i < types.len()) {
    checked.push(checkType(types[i]));
    i++;
  }
  checked
};

let _checkParamTypes = fn(types: Array<AstType>): Array<I32> {
  let checked = Array.new<I32>(0);
  let optional = false;
  let i = 0;

  while (i < types.len()) {
    let ty = match (types[i]) {
      OptionalArg(inner) => {
        optional = true;
        H.optionalType(checkType(inner))
      },
      VarargsArg(inner) => H.restType(checkType(inner)),
      _ => {
        if (optional) { throw "a required parameter cannot follow an optional one"; }
        checkType(types[i])
      },
    };
    checked.push(ty);
    i++;
  }
  checked
};

let _envType = fn(name: Bytes): I32 {
  let i = _envNames.len() - 1;
  while ((i >= 0) && (_envNames[i] != name)) { i--; }
  i >= 0 ? _envTypes[i] : -1
};

let _resultType = fn(ty: AstType): I32 {
  match (ty) { Named(name) when ((name == "Void") && (scopedType(name) < 0)) => H.TYPE_NULL, _ => checkType(ty) }
};
checkType = fn(ty) { match (ty) {
  Named(name) => match (name) {
    "I32" => H.TYPE_I32,
    "I64" => H.TYPE_I64,
    "Bool" => H.TYPE_BOOL,
    "Bytes" => H.TYPE_BYTES,
    "Dynamic" => H.TYPE_DYNAMIC,
    "Null" => H.TYPE_NULL,
    "I8" => H.TYPE_I8,
    "I16" => H.TYPE_I16,
    "U8" => H.TYPE_U8,
    "U16" => H.TYPE_U16,
    "U32" => H.TYPE_U32,
    "U64" => H.TYPE_U64,
    "F16" => H.TYPE_F16,
    "F32" => H.TYPE_F32,
    "F64" => H.TYPE_F64,
    _ => {
      let named = _envNames.len() != 0 ? _envType(name) : -1;

      if (named < 0) {
        named = scopedType(name);

        if ((named < 0) && (name == "Atom")) {
          named = H.TYPE_ATOM;
        } else {
          if ((named < 0) && (name == "Void")) { throw "Void cannot be used as a value type"; }
          if ((named < 0) && ((name == "Array") || (name == "List"))) { throw _arityMismatch(name, 1, 0); }
          checkTypeArgCount(name, named, 0);
        }
      }
      named
    },
  },
  Generic(name, args) => match (name) {
    "Array" when (args.len() == 1) => H.arrayType(checkType(args[0])),
    "List" when (args.len() == 1) => H.listType(checkType(args[0])),
    "Tuple" when (args.len() >= 2) => H.tupleType(_checkTypes(args)),
    "Null" when (args.len() == 1) => H.nullType(checkType(args[0])),
    "Array", "List", "Null" => {
      throw _arityMismatch(name, 1, args.len());
      -1
    },
    _ => {
      let named = scopedType(name);
      if ((named < 0) || (H.enumParamCount(named) == 0)) { throw "unsupported generic type: " + name; }
      checkTypeArgCount(name, named, args.len());
      H.appliedType(named, _checkTypes(args))
    },
  },
  Function(args, result) => H.functionType(_checkParamTypes(args), _resultType(result)),
  OptionalArg(inner) => H.nullType(checkType(inner)),
  VarargsArg(_) => {
    throw "T... is only the last parameter of a function type";
    -1
  },
  _ => {
    throw "tuple types are written Tuple<A, B>";
    -1
  },
} };

export let checkAnnotation: (Null<AstType>) -> I32 = fn(annotation) {
  if (annotation == null) { return -1; }
  let outer = enterSyntax(syntaxPattern(1));
  let ty = checkType(annotation);
  enterSyntax(outer);
  ty
};

let _checkExpr: (AstExpr, Syntax, I32) -> I32 = fn(_expr, _exprSyntax, _expected) { -1 };
let _checkBlock: (Array<Stmt>, Null<AstExpr>, I32) -> I32 = fn(_statements, _tail, _expected) { -1 };
let _checkTry: (AstBlock, Null<Bytes>, AstBlock, I32, Bool) -> I32 = fn(_body, _catchName, _handler, _expected, _statement) { -1 };
let _checkEnum: (AstExpr, I32, Bool) -> I32 = fn(_expr, _expected, _statement) { -1 };

export let useEnumChecks: ((AstExpr, I32, Bool) -> I32) -> Bool = fn(check) {
  _checkEnum = check;
  true
};

let _isEnumName = fn(base: AstExpr): Bool {
  match (base) { Variable(name), TypeApply(Variable(name), _) => (scopedType(name) >= 0) && !_isLocal(name), _ => false }
};
let _checkValue: (AstExpr, I32) -> I32 = fn(_expr, _expected) { -1 };

export let useValueChecks: ((AstExpr, I32) -> I32) -> Bool = fn(check) {
  _checkValue = check;
  true
};
let _checkAggregate: (AstExpr, I32) -> I32 = fn(_expr, _expected) { -1 };

export let useAggregateChecks: ((AstExpr, I32) -> I32) -> Bool = fn(check) {
  _checkAggregate = check;
  true
};
let _checkAssertion: (I32, Bytes, Bytes, Array<AstExpr>) -> I32 = fn(_module, _assertion, _name, _args) { -1 };

export let useAssertionChecks: ((I32, Bytes, Bytes, Array<AstExpr>) -> I32) -> Bool = fn(check) {
  _checkAssertion = check;
  true
};
let _structuralEquality: (BinaryOp, I32, I32) -> I32 = fn(_op, _left, _right) { -1 };

export let useStructuralEquality: ((BinaryOp, I32, I32) -> I32) -> Bool = fn(build) {
  _structuralEquality = build;
  true
};
let _unsupported: (I32, Bool) -> I32 = fn(_ty, _printing) { -1 };

export let useUnsupported: ((I32, Bool) -> I32) -> Bool = fn(find) {
  _unsupported = find;
  true
};

let _isEnumExpr = fn(expr: AstExpr): Bool {
  match (expr) {
    Match(_, _) => true,
    Member(base, _) => _isEnumName(base),
    Call(callee, _, _) => match (callee) { Member(base, _) => _isEnumName(base), _ => false },
    _ => false,
  }
};

export let checkArity: (Array<AstExpr>, I32, Bytes) -> Bool = fn(args, count, name) {
  if (args.len() != count) { throw name + " takes " + Std.string(count) + (count == 1 ? " argument" : " arguments"); }
  true
};

export let checkOperand: (AstExpr, I32, I32) -> I32 = fn(expr, index, expected) { _checkExpr(expr, syntaxChild(index), expected) };

let _known = fn(id: I32): Bool { match (H.opOf(id)) { Local => isNarrowed(H.valueOf(id)), _ => false } };
let _unwrap = fn(id: I32): I32 { H.node(Op.Unwrap, H.innerOf(H.typeOf(id)), _known(id) ? 0 : 1, 0, [id]) };
export let presentKnown: (I32) -> I32 = fn(id) { (H.isKind(H.typeOf(id), Kind.Null) && _known(id)) ? _unwrap(id) : id };

export let bufferHint: (I32) -> Bytes = fn(ty) {
  ty == H.TYPE_BYTE_BUFFER ? "; copy a buffer's bytes out with Bytes.slice(buffer, 0, buffer.len())" : ""
};

let _coerce = fn(id: I32, context: I32): I32 {
  let ty = H.typeOf(id);
  if ((context < 0) || (ty == context)) { return id; }
  let expected = H.resolve(context);

  if (H.endsPath(id)) {
    H.retype(id, expected);
    return id;
  }
  if (H.unify(ty, expected) || H.isUnknown(expected)) { return id; }

  if (H.holdsNull(expected)) {
    if (H.unify(ty, H.innerOf(expected))) { return _unary(Op.Present, H.resolve(expected), id); }

    if (ty == H.TYPE_NULL) {
      let typed = _leaf(Op.Null, expected, 0);
      return match (H.opOf(id)) { Null => typed, _ => H.node(Op.Block, expected, 0, 1, [_unary(Op.Expression, 0, id), typed]) };
    }
  }
  if (H.isKind(ty, Kind.Null) && H.unify(H.innerOf(ty), expected)) { return _unwrap(id); }
  if (ty == H.TYPE_BYTE_BUFFER) { throw "a buffer from Bytes.new is not " + H.typeName(expected) + bufferHint(ty); }
  if ((expected == H.TYPE_DYNAMIC) && (ty != H.TYPE_NULL)) { throw "a value becomes Dynamic only with `as Dynamic`"; }
  id
};

let _widens = fn(source: I32, target: I32): Bool {
  match ((H.kindOf(source), H.kindOf(target))) {
    (I8, I16), (I8, I32), (I8, I64), (I16, I32), (I16, I64), (I32, I64) => true,
    (U8, I16), (U8, U16), (U8, I32), (U8, U32), (U8, I64), (U8, U64) => true,
    (U16, I32), (U16, U32), (U16, I64), (U16, U64), (U32, I64), (U32, U64) => true,
    (F16, F32), (F16, F64), (F32, F64), (I8, F16), (U8, F16) => true,
    (I8, F32), (I16, F32), (U8, F32), (U16, F32), (I8, F64), (I16, F64), (I32, F64), (U8, F64), (U16, F64), (U32, F64) => true,
    _ => false,
  }
};

export let widened: (I32, I32) -> I32 = fn(value, declared) {
  if (declared < 0) { return value; }
  let target = H.resolve(declared);
  let nullable = H.isKind(target, Kind.Null) && (H.innerOf(target) >= 0);
  let number = nullable ? H.resolve(H.innerOf(target)) : target;
  if (!_widens(H.resolve(H.typeOf(value)), number)) { return value; }
  let converted = _unary(Op.Convert, number, value);
  nullable ? _coerce(converted, target) : converted
};

let _presentAt = fn(id: I32, index: I32): I32 {
  let ty = H.typeOf(id);
  if (!H.isKind(ty, Kind.Null) || (H.innerOf(ty) < 0)) { return id; }
  let outer = enterSyntax(syntaxChild(index));
  let present = _unwrap(id);
  enterSyntax(outer);
  present
};
export let presentAt: (I32, I32) -> I32 = fn(id, index) { _presentAt(id, index) };

let _coerceAt = fn(id: I32, expected: I32, index: I32): I32 {
  let outer = enterSyntax(syntaxChild(index));
  let coerced = _coerce(id, expected);
  enterSyntax(outer);
  coerced
};
export let coerceAt: (I32, I32, I32) -> I32 = fn(id, expected, index) { _coerceAt(id, expected, index) };

export let coerceTail: (I32, I32, I32) -> I32 = fn(block, ty, tail) {
  if (H.typeOf(block) == ty) { return block; }

  if (H.endsPath(block)) {
    H.retype(block, ty);
    return block;
  }
  let children = Array.new<I32>(0);
  let i = 0;

  while (i < H.childCount(block)) {
    children.push(H.childOf(block, i));
    i++;
  }
  children[children.len() - 1] = _coerceAt(children[children.len() - 1], ty, tail);
  H.node(Op.Block, ty, 0, 1, children)
};

export let unknownType: (Bytes) -> Bytes = fn(what) { "the type of " + what + " is not known here; annotate it" };

let _operand = fn(id: I32, expr: AstExpr, index: I32): I32 {
  if (H.isUnknown(H.typeOf(id))) {
    enterSyntax(syntaxChild(index));
    throw unknownType(match (expr) { Variable(name) => name, _ => "this value" });
  }
  id
};
let _value = fn(expr: AstExpr, index: I32, expected: I32): I32 { _operand(_presentAt(_checkExpr(expr, syntaxChild(index), expected), index), expr, index) };
export let checkPresent: (AstExpr, I32) -> I32 = fn(expr, index) { _value(expr, index, -1) };
export let checkPresentAs: (AstExpr, I32, I32) -> I32 = fn(expr, index, expected) { _value(expr, index, expected) };

export let joinTypes: (I32, I32) -> I32 = fn(a, b) {
  if (H.unify(a, b)) { return H.resolve(a); }
  if ((a == H.TYPE_NULL) || (H.isKind(b, Kind.Null) && H.unify(H.innerOf(b), a))) { return H.nullable(b); }
  if ((b == H.TYPE_NULL) || (H.isKind(a, Kind.Null) && H.unify(H.innerOf(a), b))) { return H.nullable(a); }
  -1
};

let joinBranches = fn(a: I32, b: I32): I32 {
  if (H.endsPath(b)) { return H.typeOf(a); }
  if (H.endsPath(a)) { return H.typeOf(b); }
  joinTypes(H.typeOf(a), H.typeOf(b))
};

let _isNull = fn(value: AstExpr): Bool { match (value) { Null => true, _ => false } };

let _isValueEquality = fn(op: BinaryOp, left: AstExpr, right: AstExpr): Bool {
  match (op) { Equal, NotEqual => !_isNull(left) && !_isNull(right), _ => false }
};

let _narrowBy = fn(cond: AstExpr, present: Bool) {
  match (cond) {
    Binary(op, left, right) => {
      let tests = match (op) { NotEqual => present, Equal => !present, _ => false };
      let name = match (left) { Variable(found) when (_isNull(right)) => found, _ => match (right) { Variable(found) when (_isNull(left)) => found, _ => "" } };
      let found = (tests && (name != "")) ? _find(name, 0) : -1;
      let id = found >= 0 ? _ids[found] : -1;
      if ((id >= 0) && H.isKind(_typeOfBinding(id), Kind.Null)) { narrow(id, _mutable[id]); }
      null
    },
    _ => null,
  }
};

let _literals = Array.new<Tuple<I32, Bytes, Bool>>(0);

let _openLiteral = fn(text: Bytes, negative: Bool, var: I32): I32 {
  let id = H.openLiteral(negative ? wideIntegerValue(text, true) : unsignedWideValue(text, false), var);
  _literals.push((id, text, negative));
  id
};

let _typedLiteral = fn(text: Bytes, negative: Bool, ty: I32): I32 {
  match (H.kindOf(ty)) {
    I32 => _leaf(Op.I32, ty, integerValue(text, negative)),
    I64 => H.wideLiteral(wideIntegerValue(text, negative), ty),
    U64 => H.wideLiteral(unsignedWideValue(text, negative), ty),
    _ => {
      let least = H.leastValue(ty);
      let most = H.mostValue(ty);
      let range = H.typeName(ty) + " (" + Std.string(least) + " to " + Std.string(most) + ")";
      _leaf(Op.I32, ty, integerIn(text, negative, least, most, range) as I32)
    },
  }
};

export let sizedType: (IntSize, I32) -> I32 = fn(size, inferred) {
  match (size) {
    Infer => inferred, I32 => H.TYPE_I32, I64 => H.TYPE_I64,
    I8 => H.TYPE_I8, I16 => H.TYPE_I16, U8 => H.TYPE_U8, U16 => H.TYPE_U16, U32 => H.TYPE_U32, U64 => H.TYPE_U64,
  }
};

let _floatLiteral = fn(text: Bytes, negative: Bool, ty: I32): I32 {
  let written = negative ? "-" + text : text;
  let pattern = ty == H.TYPE_F64 ? _f64Bits(written) : ((ty == H.TYPE_F32 ? _f32Bits(written) : _f16Bits(written)) as I64);
  let infinite = ty == H.TYPE_F64 ? (pattern & 9223372036854775807) == 9218868437227405312
    : ty == H.TYPE_F32 ? (pattern & 2147483647) == 2139095040 : (pattern & 32767) == 31744;
  if (infinite) { throw "float literal " + written + " is out of range for " + H.typeName(ty); }
  H.floatLiteral(pattern, ty)
};

let _checkFloat = fn(text: Bytes, size: FloatSize, negative: Bool, expected: I32): I32 {
  let context = expected < 0 ? -1 : H.resolve(expected);
  let ty = match (size) { Infer => H.isFloatType(context) ? context : H.TYPE_F64, F16 => H.TYPE_F16, F32 => H.TYPE_F32, F64 => H.TYPE_F64 };
  _floatLiteral(text, negative, ty)
};

let _exactFloat = fn(text: Bytes, negative: Bool, ty: I32): I32 {
  let magnitude = negative ? -wideIntegerValue(text, true) : unsignedWideValue(text, false);
  let greatest = 9223372036854775807;
  let power = 0;
  let width = 0;

  while ((magnitude != 0) && ((magnitude & 1) == 0)) {
    magnitude = (magnitude >> 1) & greatest;
    power++;
  }
  let rest = magnitude;

  while (rest != 0) {
    rest = (rest >> 1) & greatest;
    width++;
  }
  let room = ty == H.TYPE_F64 ? 53 : ty == H.TYPE_F32 ? 24 : 11;

  if ((width > room) || ((ty == H.TYPE_F16) && (width + power > 16))) {
    throw "integer literal " + (negative ? "-" : "") + text + " is not exactly a value of " + H.typeName(ty);
  }
  let digits = magnitude == 0 ? "0" : "";

  while (magnitude != 0) {
    digits = Bytes.slice("0123456789abcdef", (magnitude & 15) as I32, 1) + digits;
    magnitude = magnitude >> 4;
  }
  _floatLiteral("0x" + digits + "p" + Std.string(power), negative && (digits != "0"), ty)
};

let _checkInteger = fn(text: Bytes, size: IntSize, negative: Bool, expected: I32): I32 {
  let context = expected < 0 ? -1 : H.resolve(expected);
  if (H.isFloatType(context) && match (size) { Infer => true, _ => false }) { return _exactFloat(text, negative, context); }

  let ty = match (size) {
    Infer => H.isInteger(context) ? context : (context < 0) || H.isUnknown(context) ? H.integerVar() : H.TYPE_I32,
    _ => sizedType(size, -1),
  };
  H.isIntegerType(ty) ? _typedLiteral(text, negative, ty) : _openLiteral(text, negative, ty)
};

let _isNumber = fn(ty: I32): Bool { H.isInteger(ty) || H.isFloatType(H.resolve(ty)) };

let _checkUnary = fn(op: UnaryOp, value: AstExpr, expected: I32): I32 {
  match (op) {
    Negate => match (value) {
      Integer(digits, size) => _checkInteger(digits, size, true, expected),
      Float(text, size) => _checkFloat(text, size, true, expected),
      _ => {
        let operand = _value(value, 0, _isNumber(expected) ? expected : -1);
        let ty = H.typeOf(operand);
        if (!H.isInteger(ty) && !H.isFloatType(ty)) { throw "negation requires a number operand, not " + H.typeName(ty); }
        _unary(Op.Neg, ty, operand)
      },
    },
    _ => {
      let operand = _value(value, 0, -1);
      if (H.typeOf(operand) != H.TYPE_BOOL) { throw "operator ! requires a Bool operand, not " + H.typeName(H.typeOf(operand)); }
      _unary(Op.Not, H.TYPE_BOOL, operand)
    },
  }
};

let _checkNullComparison = fn(op: BinaryOp, value: AstExpr, index: I32): I32 {
  let operand = checkOperand(value, index, -1);
  let ty = H.typeOf(operand);

  if (!H.holdsNull(ty) || (ty == H.TYPE_NULL)) {
    enterSyntax(syntaxChild(index));
    throw "only Null<T> values can be compared with null, not " + H.typeName(ty);
  }

  match (op) {
    Equal => _unary(Op.IsNull, H.TYPE_BOOL, operand),
    NotEqual => _unary(Op.IsPresent, H.TYPE_BOOL, operand),
    _ => {
      throw "null supports only == and !=";
      -1
    },
  }
};

let _compare = fn(op: Op, left: I32, right: I32, negate: Bool): I32 {
  let compared = _binary(op, H.TYPE_BOOL, left, right);
  negate ? _unary(Op.Not, H.TYPE_BOOL, compared) : compared
};

export let isNullaryVariant: (I32) -> Bool = fn(id) { match (H.opOf(id)) { EnumNew => H.childCount(id) == 0, _ => false } };

let _variantEquality = fn(op: BinaryOp, left: I32, right: I32): I32 {
  let negate = match (op) {
    Equal => false, NotEqual => true, _ => {
      throw "enums support only == and !=";
      false
    }
  };
  let variant = isNullaryVariant(right) ? right : left;
  let value = isNullaryVariant(right) ? left : right;
  _compare(Op.Eq, _unary(Op.EnumTag, H.TYPE_I32, value), _leaf(Op.I32, H.TYPE_I32, H.valueOf(variant)), negate)
};

let _operatorText = fn(op: BinaryOp): Bytes {
  match (op) {
    Add => "+", Subtract => "-", Multiply => "*", Divide => "/", Remainder => "%",
    ShiftLeft => "<<", ShiftRight => ">>", BitAnd => "&", BitOr => "|", BitXor => "^",
    Equal => "==", NotEqual => "!=", Less => "<", LessEqual => "<=", Greater => ">", GreaterEqual => ">=",
    And => "&&", Or => "||",
  }
};

let _bitwiseHint = fn(op: BinaryOp, left: I32, right: I32): Bytes {
  let leftBool = H.typeOf(left) == H.TYPE_BOOL;
  let rightBool = H.typeOf(right) == H.TYPE_BOOL;
  let logical = match (op) { BitAnd => "&&", BitOr => "||", BitXor => "!=", _ => "" };
  if ((logical == "") || (!leftBool && !rightBool)) { return ""; }
  leftBool && rightBool ? "; use " + logical + " on Bool operands" : "; comparisons bind tighter, so write (a " + _operatorText(op) + " b) == c"
};

let _floatBinary = fn(op: BinaryOp, ty: I32, left: I32, right: I32): I32 {
  let arithmetic = match (op) { Add => Op.Add, Subtract => Op.Sub, Multiply => Op.Mul, Divide => Op.Div, _ => Op.Eq };
  if (arithmetic != Op.Eq) { return _binary(arithmetic, ty, left, right); }

  let comparison = match (op) {
    Equal, NotEqual => Op.Eq, Less => Op.Lt, LessEqual => Op.Le, Greater => Op.Gt, GreaterEqual => Op.Ge,
    _ => {
      throw "operator " + _operatorText(op) + " is not defined for " + H.typeName(ty);
      Op.Eq
    },
  };
  _compare(comparison, left, right, match (op) { NotEqual => true, _ => false })
};

export let binaryValues: (BinaryOp, I32, I32) -> I32 = fn(op, left, right) {
  let leftType = H.typeOf(left);
  let rightType = H.typeOf(right);

  if (H.isOpen(leftType) || H.isOpen(rightType)) {
    if (H.isInteger(leftType) && H.isInteger(rightType)) { H.unify(leftType, rightType); } else {
      H.defaultIntegers(leftType);
      H.defaultIntegers(rightType);
    }
    leftType = H.typeOf(left);
    rightType = H.typeOf(right);
    if (H.holdsUnknown(leftType) || H.holdsUnknown(rightType)) { throw unknownType("this value"); }
  }

  if ((leftType == H.TYPE_BYTE_BUFFER) || (rightType == H.TYPE_BYTE_BUFFER)) {
    throw "operator " + _operatorText(op) + " is not defined for a buffer from Bytes.new" + bufferHint(H.TYPE_BYTE_BUFFER);
  }

  if ((leftType == H.TYPE_DYNAMIC) || (rightType == H.TYPE_DYNAMIC)) {
    throw "a Dynamic value must be extracted with `as T` before use";
  }

  if ((leftType == H.TYPE_BYTES) && (rightType == H.TYPE_BYTES)) {
    return match (op) {
      Add => _binary(Op.BytesConcat, H.TYPE_BYTES, left, right),
      Equal => _binary(Op.BytesEq, H.TYPE_BOOL, left, right),
      NotEqual => _unary(Op.Not, H.TYPE_BOOL, _binary(Op.BytesEq, H.TYPE_BOOL, left, right)),
      _ => {
        throw "Bytes support only +, == and !=";
        -1
      },
    };
  }
  let same = rightType == leftType;
  let equality = match (op) { Equal, NotEqual => true, _ => false };
  if (same && H.isEnum(leftType) && (isNullaryVariant(left) || isNullaryVariant(right) || !equality)) { return _variantEquality(op, left, right); }
  let structural = match (H.kindOf(leftType)) { Tuple, Enum, Applied, Array, List => true, _ => false };
  if (same && equality && structural) { return _structuralEquality(op, left, right); }
  let bools = (leftType == H.TYPE_BOOL) && (rightType == H.TYPE_BOOL);
  let atoms = (leftType == H.TYPE_ATOM) && (rightType == H.TYPE_ATOM);

  match (op) {
    And, Or => {
      if (!bools) { throw "&& and || require Bool operands"; }
      return _binary(match (op) { And => Op.And, _ => Op.Or }, H.TYPE_BOOL, left, right);
    },
    Equal, NotEqual when (bools || atoms) => { return _compare(Op.Eq, left, right, match (op) { NotEqual => true, _ => false }); },
    _ when (atoms) => {
      throw "atoms support only == and !=";
      null
    },
    _ => null,
  };

  if (same && H.isKind(leftType, Kind.Param) && !H.isInteger(leftType)) {
    if (!equality || !H.hasBounds(leftType, H.BOUND_EQ)) { throw _operatorText(op) + " on " + H.typeName(leftType) + " " + needsBound(leftType, equality ? "Eq" : "Integer"); }
    return _compare(Op.Eq, left, right, match (op) { NotEqual => true, _ => false });
  }
  let ty = leftType;

  if (!H.isInteger(ty) || (rightType != ty)) {
    if (H.isFloatType(ty) && (rightType == ty)) { return _floatBinary(op, ty, left, right); }
    throw H.isInteger(ty) && H.isInteger(rightType)
      ? "integer operands must have the same type: " + H.typeName(ty) + " and " + H.typeName(rightType)
      : H.isFloatType(ty) && H.isFloatType(rightType) ? "float operands must have the same type: " + H.typeName(ty) + " and " + H.typeName(rightType)
      : "operator " + _operatorText(op) + " is not defined for " + H.typeName(ty) + " and " + H.typeName(rightType) + _bitwiseHint(op, left, right);
  }

  match (op) {
    Add => _binary(Op.Add, ty, left, right),
    Subtract => _binary(Op.Sub, ty, left, right),
    Multiply => _binary(Op.Mul, ty, left, right),
    Divide => _binary(Op.Div, ty, left, right),
    Remainder => _binary(Op.Rem, ty, left, right),
    ShiftLeft => _binary(Op.Shl, ty, left, right),
    ShiftRight => _binary(Op.Shr, ty, left, right),
    BitAnd => _binary(Op.BitAnd, ty, left, right),
    BitOr => _binary(Op.BitOr, ty, left, right),
    BitXor => _binary(Op.BitXor, ty, left, right),
    Equal => _compare(Op.Eq, left, right, false),
    NotEqual => _compare(Op.Eq, left, right, true),
    Less => _compare(Op.Lt, left, right, false),
    LessEqual => _compare(Op.Gt, left, right, true),
    Greater => _compare(Op.Gt, left, right, false),
    GreaterEqual => _compare(Op.Lt, left, right, true),
    _ => {
      throw "operator " + _operatorText(op) + " is not supported yet";
      -1
    },
  }
};

let _isOpenNumber = fn(expr: AstExpr): Bool {
  let literal = match (expr) { Unary(op, value) => match (op) { Negate => value, _ => expr }, _ => expr };

  match (literal) {
    Integer(_, size) => match (size) { Infer => true, _ => false },
    Float(_, size) => match (size) { Infer => true, _ => false },
    _ => false,
  }
};

let _checkBinary = fn(op: BinaryOp, leftExpr: AstExpr, rightExpr: AstExpr, expected: I32): I32 {
  let isEquality = match (op) { Equal, NotEqual => true, _ => false };

  if (isEquality && (_isNull(leftExpr) || _isNull(rightExpr))) {
    return _isNull(leftExpr) ? _checkNullComparison(op, rightExpr, 1) : _checkNullComparison(op, leftExpr, 0);
  }
  let arithmetic = match (op) { Add, Subtract, Multiply, Divide, Remainder, ShiftLeft, ShiftRight, BitAnd, BitOr, BitXor => true, _ => false };
  let context = arithmetic && _isNumber(expected) ? expected : -1;

  if ((context < 0) && _isOpenNumber(leftExpr) && !_isOpenNumber(rightExpr) && match (op) { And, Or => false, _ => true }) {
    let checkedRight = checkOperand(rightExpr, 1, -1);
    let rightType = H.typeOf(checkedRight);
    return binaryValues(op, _value(leftExpr, 0, H.isFloatType(rightType) ? rightType : -1), checkedRight);
  }
  let left = _value(leftExpr, 0, context);
  let before = narrowings();
  match (op) { And => _narrowBy(leftExpr, true), Or => _narrowBy(leftExpr, false), _ => null };
  let right = checkOperand(rightExpr, 1, H.typeOf(left) == H.TYPE_DYNAMIC ? -1 : H.typeOf(left));
  keepNarrowings(before);
  binaryValues(op, left, right)
};

export let checkDirect: (I32) -> Bool = fn(_index) { false };

let _functionType = fn(index: I32): I32 {
  if (_functionTypes[index] < 0) { checkDirect(index); }
  touch(_functionNames[index]);
  _functionTypes[index]
};

let _globalType = fn(id: I32): I32 {
  touch(H.globalNameOf(id));
  H.globalTypeOf(id)
};

let _enclosingFind = fn(name: Bytes): Tuple<I32, I32> {
  let nameId = H.findBytesId(name);
  let depth = _frames.len() - 1;

  while ((nameId >= 0) && (depth >= 0)) {
    let id = match (_frames[depth]) { Frame(nameIds, ids) => {
      let i = nameIds.len() - 1;
      while ((i >= 0) && (nameIds[i] != nameId)) { i--; }
      i >= 0 ? ids[i] : -1
    } };
    if (id >= 0) { return (depth as I32, id); }
    depth--;
  }
  (-1, -1)
};
let _isLocal = fn(name: Bytes): Bool { (_find(name, 0) >= 0) || (_enclosingFind(name).0 >= 0) };

let _genericValue = fn(name: Bytes): Bytes { name + " is generic, so it can only be called" };

let _capture = fn(name: Bytes): I32 {
  let (depth, id) = _enclosingFind(name);
  if (depth < 0) { return -1; }
  touchLocal(id);
  if (depth < _captureFloor) { throw "a generic local function cannot capture " + name + "; pass it as an argument"; }
  if (_bindingTemplate(id) >= 0) { throw _genericValue(name); }
  let ty = _typeOfBinding(id);
  depth++;

  while (depth < _captures.len()) {
    let captures = _captures[depth];
    let sources = _sources[depth];
    let i = 0;
    while ((i < sources.len()) && (H.valueOf(sources[i]) != id)) { i++; }

    if (i == sources.len()) {
      sources.push(_leaf(Op.Local, ty, id));
      let copy = newBinding();
      _bindingTypes[copy] = ty;
      _mutable[copy] = _mutable[id];
      captures.push(H.node(Op.Capture, ty, copy, H.bytesId(name), []));
    }
    id = H.valueOf(captures[i]);
    depth++;
  }
  id
};

let _aheadBinding: (Bytes, Bytes) -> Binding = fn(_name, _use) { Binding.Unbound };

let _scoped = fn(name: Bytes, use: Bytes): Binding {
  let binding = scoped(name);
  match (binding) { Unbound => _aheadBinding(name, use), _ => binding }
};
let _moduleBinding = fn(name: Bytes): Binding { _isLocal(name) ? Binding.Unbound : scoped(name) };

export let isBound: (Bytes) -> Bool = fn(name) {
  _isLocal(name) || match (scoped(name)) { Unbound => false, _ => true }
};

let _isNamespace = fn(name: Bytes): Bool { match (_moduleBinding(name)) { Namespace(_, _) => true, _ => false } };

let _inNamespace = fn(space: Bytes, name: Bytes): Binding {
  match (scoped(space)) { Namespace(module, path) => namespaceMember(module, path, name), _ => Binding.Unbound }
};

export let callFunction: (Binding, Bytes, Array<I32>) -> I32 = fn(binding, name, args) {
  match (binding) {
    Function(index) => H.node(Op.Call, H.innerOf(_functionType(index)), index + 1, 0, args), _ => {
      throw name + " is not a function";
      -1
    }
  }
};

export let generateFunction: (Bytes, Array<Bytes>, I32) -> I32 = fn(name, params, ty) {
  let types = Array.new<I32>(0);
  let i = 0;

  while (i < H.typeArgCount(ty)) {
    types.push(H.typeArg(ty, i));
    i++;
  }
  _functionNames.push(name);
  _functionTypes.push(ty);
  _functionSyntaxes.push(_noSyntax());
  _functionParams.push(params);
  _functionParamTypes.push(types);
  _functionDefaults.push(_NO_TYPES);
  _functionNodes.push(-1);
  _dropped.push(false);
  (_functionNames.len() - 1) as I32
};

export let defineFunction: (I32, I32) -> Bool = fn(index, function) {
  _functionNodes[index] = function;
  true
};

export let bindingType: (Binding) -> I32 = fn(binding) {
  match (binding) { Global(id) => _globalType(id), Function(index) => _functionType(index), _ => -1 }
};

let _unknownName = fn(name: Bytes): Bytes {
  touch(name);
  name == "_" ? "_ binds nothing, so it names no value" : "unknown name: " + name
};

let _bindingValue = fn(binding: Binding, name: Bytes): I32 {
  match (binding) {
    Global(id) => _leaf(Op.Global, _globalType(id), id),
    Function(index) => _leaf(Op.FunctionRef, _functionType(index), index + 1),
    Loaded(_, _) => {
      throw "native " + name + " needs a typed binding first: let f: (Bytes) -> I32 = " + name + ";";
      -1
    },
    Native(_) => {
      throw "native " + name + " can only be called; natives are not values yet";
      -1
    },
    Namespace(_, _) => {
      throw name + " is a module namespace, not a value; name one of its exports, as in " + name + ".x";
      -1
    },
    Intrinsic(_, _) => {
      throw name + " is an assertion the compiler expands; it can only be called";
      -1
    },
    Template(_) => {
      throw _genericValue(name);
      -1
    },
    Unbound => {
      throw _unknownName(name);
      -1
    },
  }
};

let _checkVariable = fn(name: Bytes): I32 {
  let found = _find(name, 0);
  if ((found >= 0) && (_bindingTemplate(_ids[found]) >= 0)) { throw _genericValue(name); }

  if (found >= 0) {
    touchLocal(_ids[found]);
    return _leaf(Op.Local, _typeOfBinding(_ids[found]), _ids[found]);
  }
  let captured = _capture(name);
  if (captured >= 0) { return _leaf(Op.Local, _typeOfBinding(captured), captured); }
  _bindingValue(_scoped(name, "read"), name)
};

export let hasSpread: (Array<AstExpr>) -> Bool = fn(args) {
  let i = 0;

  while (i < args.len()) {
    match (args[i]) { Spread(_) => { return true; }, _ => null };
    i++;
  }
  false
};

export let hideValue: (Array<I32>, Bytes, I32) -> I32 = fn(statements, name, value) {
  let binding = newBinding();
  statements.push(H.declareBinding(Op.Const, binding, name, value));
  binding
};

export let spreadOperand: (AstExpr, I32, I32, Bool, Bool) -> I32 = fn(operand, index, expected, tuple, array) {
  let outer = enterSyntax(syntaxChild(index));
  let checked = checkOperand(operand, 0, expected);
  enterSyntax(outer);
  let ty = H.typeOf(checked);

  if (!(tuple && H.isKind(ty, Kind.Tuple)) && !(array && H.isKind(ty, Kind.Array))) {
    enterSyntax(syntaxChild(index));
    throw "spread operand must be " + (!array ? "a tuple" : !tuple ? "an array" : "a tuple or an array") + ", not " + H.typeName(ty);
  }
  checked
};

let _spreadElements = fn(array: I32, index: I32, element: I32) {
  let wanted = H.arrayType(element);
  if (!H.unify(H.typeOf(array), wanted)) { _rejectAt(index, "spread operand must be " + H.typeName(wanted) + ", not " + H.typeName(H.typeOf(array))); }
  null
};

export let spreadArray: (AstExpr, I32, I32) -> I32 = fn(operand, index, element) {
  let array = spreadOperand(operand, index, element >= 0 ? H.arrayType(element) : -1, false, true);
  if (element >= 0) { _spreadElements(array, index, element); }
  array
};

export let tupleFields: (I32, I32, Array<I32>) -> Array<I32> = fn(tuple, index, statements) {
  let ty = H.typeOf(tuple);
  let binding = hideValue(statements, "tuple", tuple);
  let reads = Array.new<I32>(0);
  let field = 0;
  let outer = enterSyntax(syntaxChild(index));

  while (field < H.typeArgCount(ty)) {
    reads.push(H.node(Op.TupleField, H.typeArg(ty, field), field, 0, [H.local(binding, ty)]));
    field++;
  }
  enterSyntax(outer);
  reads
};

export let joinArrays: (Array<I32>, Array<I32>, I32) -> I32 = fn(parts, run, ty) {
  if ((run.len() > 0) || (parts.len() < 2)) { parts.push(H.node(Op.ArrayLiteral, ty, 0, 0, run)); }
  let joined = parts[0];
  let i = 1;

  while (i < parts.len()) {
    joined = H.node(Op.ArrayConcat, ty, 0, 0, [joined, parts[i]]);
    i++;
  }
  joined
};

export let declaredArgs: (I32) -> Array<I32> = fn(ty) {
  let types = Array.new<I32>(0);
  let i = 0;

  while (i < H.typeArgCount(ty)) {
    let param = H.slotType(H.typeArg(ty, i));
    types.push(H.isOpen(param) ? -1 : param);
    i++;
  }
  types
};

let _isConstant: (I32) -> Bool = fn(_id) { false };
_isConstant = fn(id) {
  match (H.opOf(id)) {
    Bool, I32, I64, Float, Bytes, Atom, Null => true,
    Global => !H.globalIsMutable(H.valueOf(id)),
    Convert, Neg, Present => _isConstant(H.childOf(id, 0)),
    _ => false,
  }
};
let _copyConstant: (I32, I32) -> I32 = fn(_id, _ty) { -1 };
_copyConstant = fn(id, ty) {
  let children = Array.new<I32>(0);
  let i = 0;

  while (i < H.childCount(id)) {
    let child = H.childOf(id, i);
    children.push(_copyConstant(child, H.typeOf(child)));
    i++;
  }
  H.node(H.opOf(id), ty, H.valueOf(id), H.auxOf(id), children)
};

let _wrongArgument = fn(name: Bytes, what: Bytes): Bytes {
  name == "" ? "wrong indirect call argument " + what : "wrong argument " + what + " for " + name
};

let _requiredCount = fn(function: I32, fixed: I32, index: I32): I32 {
  let required = fixed;
  while ((required > 0) && (H.kindOf(H.typeArg(function, required - 1)) == Kind.Optional)) { required--; }
  index >= 0 ? required - _functionDefaults[index].len() : required
};

let _omitted = fn(function: I32, index: I32, first: I32, required: I32, fixed: I32, children: Array<I32>) {
  let defaults = index >= 0 ? _functionDefaults[index] : _NO_TYPES;
  let i = first;

  while (i < fixed) {
    let at = i - required;
    let ty = H.slotType(H.typeArg(function, i));
    children.push(at < defaults.len() ? _copyConstant(defaults[at], ty) : _leaf(Op.Null, ty, 0));
    i++;
  }
};

let _spreadArguments = fn(function: I32, args: Array<AstExpr>, children: Array<I32>, name: Bytes, index: I32, statements: Array<I32>): Array<I32> {
  let fixed = H.typeArgCount(function);
  let element = -1;

  if ((fixed > 0) && (H.kindOf(H.typeArg(function, fixed - 1)) == Kind.Rest)) {
    fixed--;
    element = H.innerOf(H.typeArg(function, fixed));
  }
  let widths = declaredArgs(function);
  if (element >= 0) { widths[fixed] = H.isOpen(element) ? -1 : element; }
  let required = _requiredCount(function, fixed, index);
  let values = Array.new<I32>(0);
  let parts = Array.new<I32>(0);
  let run = Array.new<I32>(0);
  let i = 0;

  while (i < children.len()) {
    values.push(H.local(hideValue(statements, "callee", children[i]), H.typeOf(children[i])));
    i++;
  }
  let base = values.len();
  i = 0;

  while (i < args.len()) {
    let items = _NO_TYPES;
    let count = 1;

    match (args[i]) {
      Spread(operand) => {
        let spread = spreadOperand(operand, i + 1, -1, true, true);

        if (H.isKind(H.typeOf(spread), Kind.Tuple)) { items = tupleFields(spread, i + 1, statements); } else {
          if ((element < 0) || (values.len() - base < required)) { throw _wrongArgument(name, "count"); }
          _spreadElements(spread, i + 1, element);
          _omitted(function, index, values.len() - base, required, fixed, values);

          if (run.len() > 0) {
            parts.push(H.node(Op.ArrayLiteral, H.arrayType(element), 0, 0, run));
            run = Array.new<I32>(0);
          }
          parts.push(H.local(hideValue(statements, "spread", spread), H.typeOf(spread)));
        }
        count = items.len();
      },
      _ => null,
    };
    let j = 0;

    while (j < count) {
      let at = values.len() - base;
      if ((element < 0) && (at >= fixed)) { throw _wrongArgument(name, "count"); }
      let param = at < fixed ? at : fixed;
      let expected = at < fixed ? H.slotType(H.typeArg(function, at)) : element;
      let arg = items.len() > 0 ? _coerceAt(items[j], expected, i + 1) : _checkExpr(args[i], syntaxChild(i + 1), expected);
      arg = widened(arg, widths[param]);
      if (!H.unify(H.typeOf(arg), expected)) { _rejectAt(i + 1, _argumentMismatch(_wrongArgument(name, "type"), index, param, expected, H.typeOf(arg))); }
      let value = H.local(hideValue(statements, "argument", arg), H.typeOf(arg));
      if (at < fixed) { values.push(value); } else { run.push(value); }
      j++;
    }
    i++;
  }
  if (values.len() - base < required) { throw _wrongArgument(name, "count"); }
  _omitted(function, index, values.len() - base, required, fixed, values);
  if (element >= 0) { values.push(joinArrays(parts, run, H.arrayType(element))); }
  values
};

let _arguments = fn(function: I32, args: Array<AstExpr>, children: Array<I32>, name: Bytes, index: I32): Array<I32> {
  let fixed = H.typeArgCount(function);
  let rest = (fixed > 0) && (H.kindOf(H.typeArg(function, fixed - 1)) == Kind.Rest);
  if (rest) { fixed--; }
  let required = args.len() < fixed ? _requiredCount(function, fixed, index) : fixed;
  if ((args.len() < required) || (!rest && (args.len() > fixed))) { throw _wrongArgument(name, "count"); }
  let declared = declaredArgs(function);
  let element = -1;
  let values = children;
  let i = 0;

  if (rest) {
    element = H.innerOf(H.typeArg(function, fixed));
    declared[fixed] = H.isOpen(element) ? -1 : element;
  }

  while (i < args.len()) {
    let param = i < fixed ? i : fixed;
    let expected = declared[param];

    if (i >= fixed) {
      expected = element;
      if (i == fixed) { values = Array.new<I32>(0); }
    } else if (expected < 0) { expected = H.slotType(H.typeArg(function, i)); }
    let arg = widened(_checkExpr(args[i], syntaxChild(i + 1), expected), declared[param]);
    if (!H.unify(H.typeOf(arg), expected)) { _rejectAt(i + 1, _argumentMismatch(_wrongArgument(name, "type"), index, param, expected, H.typeOf(arg))); }
    values.push(arg);
    i++;
  }
  if (i < fixed) { _omitted(function, index, i, required, fixed, children); }
  if (rest) { children.push(H.node(Op.ArrayLiteral, H.arrayType(element), 0, 0, args.len() > fixed ? values : Array.new<I32>(0))); }
  children
};

let _call = fn(op: Op, value: I32, ty: I32, args: Array<AstExpr>, children: Array<I32>, name: Bytes, index: I32): I32 {
  if (!hasSpread(args)) { return H.node(op, H.innerOf(ty), value, 0, _arguments(ty, args, children, name, index)); }
  let statements = Array.new<I32>(0);
  statements.push(H.node(op, H.innerOf(ty), value, 0, _spreadArguments(ty, args, children, name, index, statements)));
  H.node(Op.Block, H.innerOf(ty), 0, 1, statements)
};

let _argumentMismatch = fn(message: Bytes, index: I32, i: I32, expected: I32, actual: I32): Bytes {
  let declared: ?SourceSpan = null;
  if (index >= 0) { match (_functionSyntaxes[index]) { Node(_, _, _, children, _) => { if (i < children.len()) { declared = _spanOf(children[i]); } } }; }
  noteFailure(declared, "the parameter is declared here", message + ": the parameter is " + H.typeName(expected) + ", but this argument is " + H.typeName(actual))
};

let _checkIndirectCall = fn(callee: I32, args: Array<AstExpr>): I32 {
  let ty = H.typeOf(callee);
  if (!H.isKind(ty, Kind.Function)) { throw "call target is not a function"; }
  _call(Op.CallIndirect, 0, ty, args, [callee], "", -1)
};

let _checkDirectCall = fn(index: I32, args: Array<AstExpr>): I32 {
  let ty = _functionType(index);
  _call(Op.Call, index + 1, ty, args, [], _functionNames[index], index)
};

let _checkNativeCall = fn(native: I32, name: Bytes, args: Array<AstExpr>): I32 {
  let ty = H.nativeTypeOf(native);
  _call(Op.CallNative, native, ty, args, [], name, -1)
};

let _checkTemplate: (I32, Bool) -> Bool = fn(_t, _local) { false };

let _checkTypeArgs = fn(t: I32, name: Bytes, types: Array<I32>) {
  match (_templates[t]) { Template(_, params, _, _, _, _, _, _, _, _, _) => {
    let i = 0;

    while (i < types.len()) {
      let ty = H.resolve(types[i]);
      let param = params[i];
      let paramName = H.typeName(param);
      let missing = H.isUnknown(ty) ? ""
        : H.hasBounds(param, H.BOUND_INTEGER) && !H.isInteger(ty) ? "Integer"
        : H.hasBounds(param, H.BOUND_EQ) && (_unsupported(ty, false) >= 0) ? "Eq"
        : H.hasBounds(param, H.BOUND_SHOW) && (_unsupported(ty, true) >= 0) ? "Show" : "";
      if (missing != "") { throw H.typeName(ty) + " does not satisfy the bound " + missing + " of " + paramName + " in " + name; }

      if (H.isNulled(param)) {
        if (H.isKind(ty, Kind.Param)) { H.nullType(ty); }
        if (H.isKind(ty, Kind.List) || H.holdsNull(ty)) { throw paramName + " is used as Null<" + paramName + "> in " + name + ", so it cannot be " + H.typeName(ty); }
      }
      i++;
    }
  } };
  null
};

let _instanceType = fn(params: Array<I32>, function: I32, name: Bytes, typeArgs: Array<AstType>, expected: I32, checked: I32): Tuple<Array<I32>, I32> {
  if ((typeArgs.len() != 0) && (typeArgs.len() != params.len())) { throw _arityMismatch(name, params.len(), typeArgs.len()); }
  let types = _checkTypes(typeArgs);
  if (checked >= 0) { types.push(H.innerOf(H.typeOf(checked))); }
  while (types.len() < params.len()) { types.push(H.newVar(false)); }
  let ty = H.substitute(function, params, types);
  if (expected >= 0) { H.unify(H.innerOf(ty), expected); }
  (types, ty)
};

export let checkInstance: (Array<I32>, I32, Bytes, Array<AstType>, Array<AstExpr>, I32, Array<Bytes>, I32, I32) -> Tuple<Array<I32>, I32, Array<I32>> = fn(params, function, name, typeArgs, args, expected, messages, checked, at) {
  let (types, ty) = _instanceType(params, function, name, typeArgs, expected, checked);
  let count = H.typeArgCount(ty);
  let shift = count - args.len();
  if ((checked < 0) && (shift != 0)) { throw "wrong argument count for " + name; }
  let declared = declaredArgs(ty);
  let children = Array.new<I32>(0);
  let p = 0;

  while (p < count) {
    if ((checked >= 0) && (p == at)) { children.push(checked); } else {
      let param = H.typeArg(ty, p);
      let arg = widened(_checkExpr(args[p - shift], syntaxChild(p - shift + 1), param), declared[p]);

      if (!H.unify(H.typeOf(arg), param)) {
        let message = messages[p < messages.len() ? p : messages.len() - 1];
        _rejectAt(p - shift + 1, Bytes.get_u8(message, message.len() - 1) == 32 ? message + H.typeName(param) : message);
      }
      children.push(arg);
    }
    p++;
  }
  (types, ty, children)
};

let _checkGenericCall = fn(t: I32, name: Bytes, typeArgs: Array<AstType>, args: Array<AstExpr>, expected: I32): I32 {
  _checkTemplate(t, false);

  match (_templates[t]) { Template(_, params, _, _, _, _, _, _, _, _, _) => {
    let index = _templateFunctions[t];
    let (types, ty) = _instanceType(params, _functionTypes[index], name, typeArgs, expected, -1);
    let made = _call(Op.Call, 0, ty, args, [], name, index);
    let call = H.opOf(made) == Op.Block ? H.lastChild(made) : made;
    _checkTypeArgs(t, name, types);
    if (!_templateBody) { _pending.push((call, t, types, _instanceDepth + 1)); }
    made
  } }
};

let _localTemplate = fn(name: Bytes): I32 {
  let found = _find(name, 0);
  let id = found >= 0 ? _ids[found] : _enclosingFind(name).1;
  id >= 0 ? _bindingTemplate(id) : -1
};

let _declareTemplate = fn(t: I32) {
  match (_templates[t]) { Template(name, _, _, _, _, _, _, _, _, _, _) => _declare(name, -2 - t, false) };
  null
};

let _checkBindingCall = fn(binding: Binding, name: Bytes, callee: AstExpr, typeArgs: Array<AstType>, args: Array<AstExpr>, expected: I32): I32 {
  let t = match (binding) { Template(index) => index, Unbound => _localTemplate(name), _ => -1 };
  if (t >= 0) { return _checkGenericCall(t, name, typeArgs, args, expected); }
  if (typeArgs.len() != 0) { throw "only a generic function takes type arguments"; }

  match (binding) {
    Function(index) => _checkDirectCall(index, args),
    Native(native) => _checkNativeCall(native, name, args),
    Intrinsic(module, assertion) => _checkAssertion(module, assertion, name, args),
    _ => _checkIndirectCall(_value(callee, 0, -1), args),
  }
};

let _checkCall = fn(callee: AstExpr, typeArgs: Array<AstType>, args: Array<AstExpr>, expected: I32): I32 {
  match (callee) {
    Variable(name) => _checkBindingCall(_moduleBinding(name), name, callee, typeArgs, args, expected),
    Member(Variable(space), name) => _checkBindingCall(_inNamespace(space, name), space + "." + name, callee, typeArgs, args, expected),
    _ => _checkBindingCall(Binding.Unbound, "", callee, typeArgs, args, expected),
  }
};

export let branchMismatch = fn(what: Bytes, first: I32, second: I32, child: I32): Bytes {
  if (child >= 0) { enterSyntax(syntaxChild(child)); }
  let firstName = H.typeName(first);
  let secondName = H.typeName(second);
  let message = what + " must have the same type, not " + firstName + " and " + secondName;
  let dynamic = H.resolve(first) == H.TYPE_DYNAMIC;

  if ((dynamic != (H.resolve(second) == H.TYPE_DYNAMIC)) && !H.isUnknown(dynamic ? second : first)) {
    let other = dynamic ? secondName : firstName;
    message += "; a Dynamic value becomes " + other + " only with `as " + other + "`";
  }
  message
};

let _requireBool = fn(what: Bytes, condition: I32, index: I32) {
  let ty = H.typeOf(condition);
  if (ty != H.TYPE_BOOL) { _rejectAt(index, what + " condition must be Bool, not " + H.typeName(ty)); }
  null
};

let _checkIf = fn(condition: AstExpr, thenBranch: AstExpr, elseBranch: AstExpr, expected: I32): I32 {
  let checkedCondition = _value(condition, 0, -1);
  _requireBool("if", checkedCondition, 0);
  let before = narrowings();
  _narrowBy(condition, true);
  let checkedThen = checkOperand(thenBranch, 1, expected);
  let afterThen = narrowings();
  let thenType = H.typeOf(checkedThen);
  let elseContext = (expected >= 0) || H.isKind(thenType, Kind.Null) || (thenType == H.TYPE_DYNAMIC) || H.isUnknown(thenType) ? expected : thenType;
  setNarrowings(before);
  _narrowBy(condition, false);
  let checkedElse = checkOperand(elseBranch, 2, elseContext);
  keepNarrowings(afterThen);
  let ty = joinBranches(checkedThen, checkedElse);

  if (ty < 0) {
    enterSyntax(syntaxChild(2));
    let tail = match (elseBranch) { BlockExpr(Block(statements, tail)) => tail == null ? -1 : statements.len() as I32, _ => -1 };
    throw branchMismatch("if branches", H.typeOf(checkedThen), H.typeOf(checkedElse), tail);
  }
  H.node(Op.If, ty, 0, 0, [checkedCondition, _coerceAt(checkedThen, ty, 1), _coerceAt(checkedElse, ty, 2)])
};

let _importedTarget = fn(name: Bytes): Bytes { "cannot assign to imported binding: " + name };

let _assignable = fn(name: Bytes): Tuple<Bool, I32, I32> {
  let found = _find(name, 0);
  let (_, outer) = found >= 0 ? (0, _ids[found]) : _enclosingFind(name);

  if (outer >= 0) {
    touchLocal(outer);
    if (!_mutable[outer]) { throw "cannot assign to immutable local: " + name; }
    let id = found >= 0 ? outer : _capture(name);
    return (false, id, _typeOfBinding(id));
  }

  let id = match (_scoped(name, "assigned")) {
    Global(target) => target,
    Function(_), Template(_) => {
      throw "cannot assign to function: " + name;
      -1
    },
    Intrinsic(_, _) => {
      throw "cannot assign to assertion: " + name;
      -1
    },
    Loaded(_, _), Native(_) => {
      throw "cannot assign to native: " + name;
      -1
    },
    Namespace(_, _) => {
      throw "cannot assign to module namespace: " + name;
      -1
    },
    Unbound => {
      throw _unknownName(name);
      -1
    },
  };
  if (isImported(name)) { throw _importedTarget(name); }
  if (!H.globalIsMutable(id)) { throw "cannot assign to immutable global: " + name; }
  (true, id, _globalType(id))
};

let _checkVariableAssignment = fn(op: AssignOp, name: Bytes, value: AstExpr): I32 {
  let (global, id, declared) = _assignable(name);
  let operand = checkOperand(value, 1, declared);
  let checked = match (op) { Assign => widened(operand, declared), _ => operand };
  let fits = H.unify(H.typeOf(checked), declared);
  let ty = H.resolve(declared);
  let assign = global ? Op.SetGlobal : Op.Assign;

  if (!fits) {
    let message = name + " is " + H.typeName(declared) + ", but the value assigned is " + H.typeName(H.typeOf(checked));
    _rejectAt(1, noteFailure(_spanOf(global ? _globalDeclarations[id] : _declarations[id]), name + " is declared here", message));
    return H.node(assign, ty, id, 0, [checked]);
  }
  if (!global && H.isKind(ty, Kind.Null)) { assignLocal(id, H.typeOf(checked) == ty && match (H.opOf(checked)) { Present => true, _ => false }); }

  match (op) {
    Assign => H.node(assign, ty, id, 0, [checked]),
    Compound(binary) => {
      let outer = enterSyntax(syntaxChild(0));
      let target = _leaf(global ? Op.Global : Op.Local, ty, id);
      enterSyntax(outer);
      H.node(assign, ty, id, 0, [binaryValues(binary, target, checked)])
    },
  }
};

let _rejectNamespaceTarget = fn(target: AstExpr): Bool {
  match (target) {
    Member(Variable(space), name) when (_isNamespace(space)) => {
      _inNamespace(space, name);
      throw _importedTarget(space + "." + name);
      false
    },
    _ => true,
  }
};

let _checkAssignment = fn(expr: AstExpr, op: AssignOp, target: AstExpr, value: AstExpr): I32 {
  _rejectNamespaceTarget(target);

  match (target) {
    Variable(name) => _checkVariableAssignment(op, name, value),
    Index(_, _) => _checkAggregate(expr, -1),
    Member(_, _) => {
      throw "assigning to a field is not supported yet";
      -1
    },
    _ => {
      throw "only a variable or an element can be assigned";
      -1
    },
  }
};

export let one: (I32) -> I32 = fn(ty) { _checkInteger("1", IntSize.Infer, false, ty) };
export let integerLiteral: (Bytes, Bool, I32) -> I32 = fn(digits, negative, ty) { _checkInteger(digits, IntSize.Infer, negative, ty) };

let _conversions = Array.new<I32>(0);

export let integerConversion: (I32, I32) -> I32 = fn(value, target) {
  let id = _unary(Op.Convert, target, value);
  _conversions.push(id);
  id
};

let _checkIncDec = fn(op: IncDecOp, prefix: Bool, target: AstExpr, discarded: Bool): I32 {
  _rejectNamespaceTarget(target);
  if (match (target) { Index(_, _) => true, _ => false }) { return _checkAggregate(AstExpr.IncDec(op, prefix || discarded, target), -1); }

  let name = match (target) {
    Variable(found) => found, _ => {
      throw "only a variable or an element can be incremented or decremented";
      ""
    }
  };
  let (global, id, ty) = _assignable(name);
  if (!H.isInteger(ty)) { throw "increment and decrement require an integer variable: " + name; }
  let outer = enterSyntax(syntaxChild(0));
  let current = _leaf(global ? Op.Global : Op.Local, ty, id);
  enterSyntax(outer);
  let increment = match (op) { Increment => true, _ => false };
  let updated = H.node(global ? Op.SetGlobal : Op.Assign, ty, id, 0, [_binary(increment ? Op.Add : Op.Sub, ty, current, one(ty))]);
  if (prefix || discarded) { return updated; }
  _binary(increment ? Op.Sub : Op.Add, ty, updated, one(ty))
};

let _unsupportedExpr = fn(expr: AstExpr): Bytes {
  let feature = match (expr) {
    RegExp(_, _) => "regexp values outside a match pattern are",
    This => "`this` is",
    Super => "`super` is",
    List(_) => "lists are",
    Object(_) => "objects are",
    Spread(_) => "a spread here is",
    Bits(_) => "bit syntax is",
    TypeApply(_, _) => "type application outside a call is",
    New(_, _) => "`new` is",
    Function(_, _, _, _) => "methods are",
    With(_, _, _) => "`with` expressions are",
    LetExpr(_, _, _, _) => "`let` expressions are",
    Await(_) => "`await` is",
    Quote(_, _), Unquote(_) => "macros are",
    _ => "this expression is",
  };
  feature + " not supported yet"
};

export let unsupportedStatement: (Stmt) -> Bytes = fn(statement) {
  let feature = match (statement) {
    Prototype(_, _, _, _) => "prototypes are",
    Typedef(_, _, _, _) => "typedefs are",
    Macro(_, _, _, _) => "macros are",
    ImportModule(_, _, _), ImportFrom(_, _, _) => "imports inside a function are",
    Enum(_, _, _, _) => "enums declared inside a function are",
    LetStmt(_, _, _, _, _, _) => "exports inside a function are",
    Return(_) => "`return` outside a function is",
    Break => {
      return "break outside loop";
      ""
    },
    Continue => {
      return "continue outside loop";
      ""
    },
    _ => "this statement is",
  };
  feature + " not supported yet"
};

let _checkFunctionLiteral: (Array<Parameter>, Null<AstType>, AstBlock, I32) -> I32 = fn(_params, _result, _body, _expected) { -1 };

let _checkPipe = fn(value: AstExpr, body: AstExpr, topic: Bool, expected: I32): I32 {
  let checked = checkOperand(value, 0, -1);
  let mark = _nameIds.len();
  let declared = H.declareBinding(Op.Const, _declare("%", H.typeOf(checked), false), "%", checked);
  let syntax = syntaxChild(1);
  let piped = body;

  if (!topic) {
    match (body) {
      Call(callee, typeArgs, args) => {
        let withTopic = [AstExpr.Topic];
        appendFrom(withTopic, args, 0);
        piped = AstExpr.Call(callee, typeArgs, withTopic);
        syntax = match (syntax) { Node(path, start, end, children, patterns) => {
          let shifted = [children[0], _spanSyntax(path, start, end)];
          appendFrom(shifted, children, 1);
          Syntax.Node(path, start, end, shifted, patterns)
        } };
      },
      _ => {
        enterSyntax(syntax);
        throw "a pipeline body that does not use % must be a call";
      },
    };
  }
  let result = _checkExpr(piped, syntax, expected);
  _popTo(mark);
  H.node(Op.Block, H.typeOf(result), 0, 1, [declared, result])
};

_checkExpr = fn(expr, syntax, expected) {
  let outer = enterSyntax(syntax);
  let literal = H.isKind(expected, Kind.Null) ? H.innerOf(expected) : expected;

  let id = match (expr) {
    _ when (_isEnumExpr(expr)) => _checkEnum(expr, expected, false),
    Bytes(value) => _leaf(Op.Bytes, H.TYPE_BYTES, H.bytesId(value)),
    Bool(value) => _leaf(Op.Bool, H.TYPE_BOOL, value ? 1 : 0),
    Null => _leaf(Op.Null, H.holdsNull(expected) ? expected : H.TYPE_NULL, 0),
    Integer(digits, size) => _checkInteger(digits, size, false, literal),
    Float(text, size) => _checkFloat(text, size, false, literal),
    Unary(op, value) => _checkUnary(op, value, literal),
    Binary(op, left, right) when (_isValueEquality(op, left, right)) => _checkValue(expr, expected),
    Binary(op, left, right) => _checkBinary(op, left, right, literal),
    Cast(_, _), Is(_, _) => _checkValue(expr, expected),
    Variable(name) => _checkVariable(name),
    Topic => _checkVariable("%"),
    Pipe(value, body, topic) => _checkPipe(value, body, topic, expected),
    Member(Variable(space), name) when (_isNamespace(space)) => _bindingValue(_inNamespace(space, name), space + "." + name),
    Tuple(_), Array(_), Member(_, _), Index(_, _) => _checkAggregate(expr, literal),
    Call(callee, typeArgs, args) when (match (callee) { Member(Variable(space), _) => _isNamespace(space), _ => false }) => _checkCall(callee, typeArgs, args, expected),
    Call(callee, _, _) when (match (callee) { Member(_, _), TypeApply(_, _) => true, _ => false }) => _checkAggregate(expr, literal),
    Call(callee, typeArgs, args) => _checkCall(callee, typeArgs, args, expected),
    If(_, _, elseBranch) when (_isNull(elseBranch)) => {
      throw "an if used as a value needs an else branch";
      -1
    },
    If(condition, thenBranch, elseBranch), Conditional(condition, thenBranch, elseBranch) => _checkIf(condition, thenBranch, elseBranch, expected),
    Try(body, catchName, handler) => _checkTry(body, catchName, handler, expected, false),
    IncDec(op, prefix, target) => _checkIncDec(op, prefix, target, false),
    BlockExpr(block) => match (block) { Block(statements, tail) => {
      let checked = _checkBlock(statements, tail, expected);
      if ((tail == null) && !H.endsPath(checked)) { throw "value block requires a trailing expression"; }
      checked
    } },
    Assign(op, target, value) => _checkAssignment(expr, op, target, value),
    Function(params, result, body, isMethod) when (!isMethod) => _checkFunctionLiteral(params, result, body, expected),
    Atom(name) => _leaf(Op.Atom, H.TYPE_ATOM, H.bytesId(name)),
    _ => {
      throw _unsupportedExpr(expr);
      -1
    },
  };
  let coerced = _coerce(id, expected);
  enterSyntax(outer);
  coerced
};

let _isFunctionValue = fn(value: AstExpr): Bool { match (value) { Function(_, _, _, isMethod) => !isMethod, _ => false } };

let _isFunctionLet = fn(statement: Stmt, generic: Bool): Bool {
  match (statement) {
    LetStmt(_, _, pattern, typeParams, annotation, value) => ((typeParams.len() != 0) == generic) && isBindPattern(pattern) && (annotation == null) && _isFunctionValue(value),
    _ => false,
  }
};
export let isDirectFunction: (Stmt) -> Bool = fn(statement) { _isFunctionLet(statement, false) };
export let isTemplate: (Stmt) -> Bool = fn(statement) { _isFunctionLet(statement, true) };

let _notConstant = fn(name: Bytes): Bytes {
  enterSyntax(syntaxChild(0));
  "the default of " + name + " must be a constant"
};

let _bindingStatement = fn(name: Bytes): I32 {
  let i = 0;

  while (i < _statements.len()) {
    match (_statements[i]) { LetStmt(_, _, pattern, _, _, _) when (isBindPattern(pattern) && (bindPatternName(pattern) == name)) => { return i; }, _ => null };
    i++;
  }
  -1
};

let _constantValue = fn(value: AstExpr, param: Bytes): AstExpr {
  let found = value;
  let steps = 0;

  while (steps <= _statements.len()) {
    let name = match (found) { Variable(name) => name, _ => { return found; } };
    let at = isBound(name) ? -1 : _bindingStatement(name);
    if (at < 0) { return found; }

    match (_statements[at]) {
      LetStmt(isConst, _, _, _, _, init) => {
        if (!isConst) { throw _notConstant(param); }
        found = init;
      }, _ => null
    };
    steps++;
  }
  found
};

let _checkDefault = fn(name: Bytes, ty: I32, kind: ParameterKind): I32 {
  let value = match (kind) { Default(value) => value, Optional(value) => value, _ => null };
  if (value == null) { return -1; }
  let optional = match (kind) { Optional(_) => true, _ => false };
  if (!optional && H.isKind(ty, Kind.Null)) { throw "a parameter with a default cannot be nullable; write ?" + name + ": " + H.typeName(H.innerOf(ty)); }
  if (!optional && _isNull(value)) { throw "the default of " + name + " cannot be null; write ?" + name + ": " + H.typeName(ty); }
  let checked = widened(checkOperand(_constantValue(value, name), 0, ty), ty);

  if (!H.unify(H.typeOf(checked), ty)) {
    enterSyntax(syntaxChild(0));
    throw "the default of " + name + " must be " + H.typeName(ty) + ", not " + H.typeName(H.typeOf(checked));
  }
  if (!_isConstant(checked)) { throw _notConstant(name); }
  checked
};

let _paramType = fn(kind: ParameterKind, declared: I32): I32 {
  match (kind) { Varargs => H.restType(declared), Optional(value) => value == null ? H.optionalType(declared) : H.nullType(declared), _ => declared }
};

let _paramRank = fn(kind: ParameterKind): I32 {
  match (kind) { Required => 0, Default(_) => 1, Optional(value) => value == null ? 2 : 1, Varargs => 3 }
};

let _fitsParams = fn(params: Array<Parameter>, expected: I32): Bool {
  if (!H.isKind(expected, Kind.Function) || (H.typeArgCount(expected) != params.len())) { return false; }
  let i = 0;

  while (i < params.len()) {
    let kind = H.kindOf(H.typeArg(expected, i));
    let wraps = (kind == Kind.Optional) ? 2 : (kind == Kind.Rest) ? 3 : 0;
    let rank = match (params[i]) { Parameter(_, _, paramKind) => _paramRank(paramKind) };
    if ((rank < 2 ? 0 : rank) != wraps) { return false; }
    i++;
  }
  true
};

let _withDefault = fn(defaults: Array<I32>, value: I32): Array<I32> {
  let table = defaults.len() == 0 ? Array.new<I32>(0) : defaults;
  table.push(value);
  table
};

let _addFunction = fn(name: Bytes, params: Array<Parameter>, result: ?AstType, expected: I32, syntax: Syntax): I32 {
  let fits = _fitsParams(params, expected);
  let names = Array.new<Bytes>(0);
  let types = Array.new<I32>(0);
  let defaults = _NO_TYPES;
  let rank = 0;
  let i = 0;
  let outer = _syntax;

  while (i < params.len()) {
    enterSyntax(_childOf(syntax, i));

    match (params[i]) { Parameter(paramName, paramType, kind) => {
      if ((paramName != "_") && (indexOf(names, paramName) >= 0)) { throw "duplicate parameter: " + paramName; }
      let own = _paramRank(kind);
      if (own < rank) { throw own == 0 ? "required parameter " + paramName + " cannot follow an optional one" : "parameter " + paramName + " with a default cannot follow an optional one without"; }
      rank = own;
      let ty = paramType != null ? _paramType(kind, checkType(paramType)) : fits && (own != 3) ? H.typeArg(expected, i) : -1;

      if ((ty < 0) && H.isKind(expected, Kind.Function) && (H.typeArgCount(expected) < params.len()) && H.isKind(H.innerOf(expected), Kind.Function)) {
        enterSyntax(outer);
        throw "chained arrow types are not curried; use parentheses for multi-arg fn types";
      }
      if (ty < 0) { throw own == 3 ? "variadic parameter " + paramName + " needs a type" : "parameter " + paramName + " of " + name + " needs a type"; }
      if (own == 1) { defaults = _withDefault(defaults, _checkDefault(paramName, ty, kind)); }
      names.push(paramName);
      types.push(ty);
    } };
    i++;
  }
  enterSyntax(outer);
  let resultType = result != null ? _resultType(result) : fits ? H.innerOf(expected) : -1;
  _functionNames.push(name);
  _functionTypes.push(resultType < 0 ? -1 : H.functionType(types, resultType));
  _functionSyntaxes.push(syntax);
  _functionParams.push(names);
  _functionParamTypes.push(types);
  _functionDefaults.push(defaults);
  _functionNodes.push(-1);
  _dropped.push(_templateBody);
  (_functionNames.len() - 1) as I32
};

let _declareFunction = fn(name: Bytes, value: AstExpr) {
  match (value) {
    Function(params, result, _, _) => declareScoped(name, Binding.Function(_addFunction(name, params, result, -1, syntaxChild(0)))),
    _ => true,
  };
  null
};

let _bound = fn(bound: Bytes): I32 {
  match (bound) {
    "Eq" => H.BOUND_EQ, "Show" => H.BOUND_SHOW, "Integer" => H.BOUND_INTEGER,
    _ => {
      throw "unknown bound " + bound + ": the bounds are Eq, Show and Integer";
      0
    },
  }
};

let _isTypeName = fn(name: Bytes): Bool {
  match (name) {
    "I32", "I64", "Bool", "Bytes", "Dynamic", "Null", "Array", "List", "Tuple", "Atom", "I8", "I16", "U8", "U16", "U32", "U64", "F16", "F32", "F64" => true,
    _ => scopedType(name) >= 0,
  }
};

export let checkTypeParams: (Array<TypeParam>, Bool) -> Array<I32> = fn(typeParams, bounded) {
  let params = Array.new<I32>(0);
  let names = Array.new<Bytes>(0);
  let i = 0;
  let path = match (_syntax) { Node(file, _, _, _, _) => file };

  while (i < typeParams.len()) {
    match (typeParams[i]) { TypeParam(param, bounds, start, end) => {
      let outer = enterSyntax(_spanSyntax(path, start, end));
      if (_isTypeName(param)) { throw "type parameter " + param + " hides the type " + param; }
      if (!bounded && (bounds.len() != 0)) { throw "an enum's type parameters take no bounds"; }
      if (indexOf(names, param) >= 0) { throw "duplicate type parameter: " + param; }
      let j = 0;
      let required = 0;

      while (j < bounds.len()) {
        required = required | _bound(bounds[j]);
        j++;
      }
      params.push(H.newParam(param, required));
      names.push(param);
      enterSyntax(outer);
    } };
    i++;
  }
  params
};

export let paramNames: (Array<I32>) -> Array<Bytes> = fn(params) {
  let names = Array.new<Bytes>(0);
  let i = 0;

  while (i < params.len()) {
    names.push(H.typeName(params[i]));
    i++;
  }
  names
};

export let useTypeParams: (Array<Bytes>, Array<I32>) -> Bool = fn(names, types) {
  _envNames = names;
  _envTypes = types;
  true
};

let _newTemplate = fn(name: Bytes, typeParams: Array<TypeParam>, value: AstExpr, syntax: Syntax, bodyName: Bytes): I32 {
  let params = checkTypeParams(typeParams, true);
  let names = paramNames(params);
  let all = appendFrom(appendFrom(Array.new<Bytes>(0), _envNames, 0), names, 0);
  _templates.push(Template.Template(
    name, params, value, syntax, currentModule(), bodyName, all, _envTypes, Array.new<I32>(0), Array.new<I32>(0), Array.new<I32>(0)
  ));
  _templateFunctions.push(-1);
  (_templates.len() - 1) as I32
};

export let declareFunctions: (Array<Stmt>) -> I32 = fn(statements) {
  let first = _functionNames.len() as I32;
  let i = 0;
  _moduleSyntax = _syntax;
  _statements = statements;
  _directStatements = Array.new<I32>(0);
  _firstDirect = first;
  _globals = Array.new<I32>(0);

  while (i < statements.len()) {
    let outer = enterSyntax(syntaxChild(i));

    match (statements[i]) {
      LetStmt(_, _, pattern, _, _, value) when (isDirectFunction(statements[i])) => {
        _declareFunction(bindPatternName(pattern), value);
        _directStatements.push(i);
      },
      LetStmt(_, _, pattern, typeParams, _, value) when (isTemplate(statements[i])) => {
        let name = bindPatternName(pattern);
        declareScoped(name, Binding.Template(_newTemplate(name, typeParams, value, syntaxChild(0), name)));
      },
      _ => null,
    };
    _globals.push(-1);
    enterSyntax(outer);
    i++;
  }
  first
};

export let isLoaded: (AstExpr) -> Bool = fn(value) {
  match (value) { Variable(name) => match (scoped(name)) { Loaded(_, _) => true, _ => false }, _ => false }
};

export let declareStatementGlobal = fn(name: Bytes, ty: I32, mutable: Bool): I32 {
  let global = H.declareGlobal(name, ty, mutable);
  while (_globalDeclarations.len() <= global) { _globalDeclarations.push(_noSyntax()); }
  _globalDeclarations[global] = _syntax;
  global
};

export let annotatedGlobal: (I32) -> I32 = fn(statement) {
  if (_globals[statement] < 0) {
    match (_statements[statement]) {
      LetStmt(isConst, _, pattern, _, annotation, _) => {
        let outer = enterSyntax(_childOf(_moduleSyntax, statement));
        let name = bindPatternName(pattern);
        let global = declareStatementGlobal(name, checkAnnotation(annotation), !isConst);
        declareScoped(name, Binding.Global(global));
        _globals[statement] = global;
        enterSyntax(outer);
      },
      _ => internalError("a binding expected"),
    };
  }
  _globals[statement]
};

_aheadBinding = fn(name, use) {
  if ((name == "_") || (_bodyName == "") || (_frames.len() == 0)) { return Binding.Unbound; }
  let i = _bindingStatement(name);
  if ((i < 0) || isDirectFunction(_statements[i])) { return Binding.Unbound; }

  match (_statements[i]) {
    LetStmt(_, _, _, _, annotation, value) when (!isLoaded(value)) => {
      if (annotation == null) { throw name + " is " + use + " by " + _bodyName + " before " + name + "'s initializer is checked; annotate " + name; }
      Binding.Global(annotatedGlobal(i))
    },
    _ => Binding.Unbound,
  }
};

let _inferred = Array.new<Tuple<Bytes, Syntax, I32>>(0);

let _annotationMismatch = fn(name: Bytes, annotated: I32, actual: I32): Bytes {
  name + " is annotated " + H.typeName(annotated) + ", but its value is " + H.typeName(actual)
};

let checkInitializer = fn(value: AstExpr, ty: I32, name: Bytes): Tuple<I32, Bool> {
  let outerDoubt = beginDoubt();
  let checked = widened(checkOperand(value, 0, ty), ty);
  let valueType = H.typeOf(checked);
  let suspect = endDoubt(outerDoubt) || touched();

  if ((ty >= 0) && ((valueType == H.TYPE_NULL) || !H.unify(valueType, ty))) {
    _rejectAt(0, valueType == H.TYPE_NULL ? "only Null<T> can hold null, not " + H.typeName(ty) : _annotationMismatch(name, ty, valueType));
    return (_leaf(Op.Null, H.resolve(ty), 0), false);
  }
  if (valueType == H.TYPE_NULL) { checked = _coerce(checked, H.nullType(H.newVar(true))); }
  if (H.holdsUnknown(H.typeOf(checked))) { _inferred.push((name, syntaxPattern(0), H.typeOf(checked))); }
  (checked, suspect && (ty < 0))
};

export let checkGlobalInitializer: (AstExpr, I32, Bytes) -> Tuple<I32, Bool> = fn(value, ty, name) {
  _bodyName = name;
  let result = checkInitializer(value, ty, name);
  _bodyName = "";
  result
};

let _checkLocal = fn(pattern: Pattern, isConst: Bool, typeParams: Array<TypeParam>, annotation: ?AstType, value: AstExpr): I32 {
  let name = bindPatternName(pattern);
  if (typeParams.len() != 0) { throw "local bindings do not support type parameters"; }
  if (_find(name, _scopeStart) >= 0) { throw "duplicate local: " + name; }
  let annotated = checkAnnotation(annotation);
  let (checked, suspect) = checkInitializer(value, annotated, name);
  let ty = H.typeOf(checked);
  let binding = _declare(name, ty, !isConst);
  if (suspect) { poisonLocal(binding); }
  match (H.opOf(checked)) { Present => narrow(binding, !isConst), _ => false };
  H.node(isConst ? Op.Const : Op.Let, ty, binding, H.bytesId(name), [checked])
};

let _nullResult = fn(message: Bytes): I32 {
  let fits = (_result < 0) || (_result == H.TYPE_NULL) || (_resultInferred && H.holdsNull(H.resolve(_result)));
  if (!fits) { throw message + H.typeName(_result); }
  if (_result < 0) { _result = H.TYPE_NULL; }
  let value = _leaf(Op.Null, H.TYPE_NULL, 0);
  if (_resultInferred) { _results.push(value); }
  value
};

let _checkResult = fn(value: AstExpr, index: I32): I32 {
  let checked = checkOperand(value, index, _result);
  if (!_resultInferred) { checked = widened(checked, _result); }
  let ty = H.typeOf(checked);
  let joined = _result < 0 ? ty : _resultInferred ? joinTypes(ty, _result) : H.unify(ty, _result) ? _result : -1;

  if (joined < 0) {
    let returns = _result == H.TYPE_NULL ? "no value" : H.typeName(_result);
    _rejectAt(index, noteFailure(_spanOf(_resultSyntax), "the function is declared here", "the function returns " + returns + ", but this value is " + H.typeName(ty)));
  } else { _result = joined; }
  if (_resultInferred) { _results.push(checked); }
  checked
};

export let enterNode: (I32) -> Syntax = fn(id) {
  match (H.spanOf(id)) { Span(path, start, end) => enterSyntax(_spanSyntax(path, start, end)) }
};

let _rebuild: (I32, I32, I32, Array<Bool>) -> I32 = fn(_id, _ty, _first, _results) { -1 };
_rebuild = fn(id, ty, first, results) {
  if (id < first) { return id; }
  let children = Array.new<I32>(0);
  let changed = false;
  let i = 0;

  while (i < H.childCount(id)) {
    let child = H.childOf(id, i);
    children.push(_rebuild(child, ty, first, results));
    changed = changed || (children[i] != child);
    i++;
  }
  let tail = match (H.opOf(id)) { Block => H.auxOf(id) == 1, _ => false };
  let rebuilt = !changed ? id : H.copyNode(id, tail ? H.typeOf(children[children.len() - 1]) : H.typeOf(id), children);
  if (!results[id - first] || (H.typeOf(rebuilt) == ty)) { return rebuilt; }
  let outer = enterNode(id);
  let converted = _coerce(rebuilt, ty);
  enterSyntax(outer);
  converted
};

let _joinResults = fn(body: I32): I32 {
  let ty = H.resolve(_result);
  let first = -1;
  let i = _resultsStart;

  while (i < _results.len()) {
    if ((H.typeOf(_results[i]) != ty) && ((first < 0) || (_results[i] < first))) { first = _results[i]; }
    i++;
  }
  if (first < 0) { return body; }
  let marks = Array.new<Bool>(body - first + 1);
  i = _resultsStart;

  while (i < _results.len()) {
    if (_results[i] >= first) { marks[_results[i] - first] = true; }
    i++;
  }
  _rebuild(body, ty, first, marks)
};

let _checkStatement: (Stmt, Syntax) -> I32 = fn(_statement, _statementSyntax) { -1 };
let _checkIfStatement: (AstExpr, AstExpr, AstExpr) -> I32 = fn(_condition, _thenBranch, _elseBranch) { -1 };
let _checkBranch: (AstExpr, I32) -> I32 = fn(_branch, _index) { -1 };

export let checkEffect: (AstExpr, I32) -> I32 = fn(value, index) {
  match (value) {
    If(condition, thenBranch, elseBranch) => {
      let outer = enterSyntax(syntaxChild(index));
      let id = _checkIfStatement(condition, thenBranch, elseBranch);
      enterSyntax(outer);
      id
    },
    Match(_, _) => {
      let outer = enterSyntax(syntaxChild(index));
      let id = _checkEnum(value, -1, true);
      enterSyntax(outer);
      id
    },
    Try(body, catchName, handler) => {
      let outer = enterSyntax(syntaxChild(index));
      let id = _checkTry(body, catchName, handler, -1, true);
      enterSyntax(outer);
      id
    },
    IncDec(op, prefix, target) => {
      let outer = enterSyntax(syntaxChild(index));
      let id = _unary(Op.Expression, 0, _checkIncDec(op, prefix, target, true));
      enterSyntax(outer);
      id
    },
    BlockExpr(_) => _checkBranch(value, index),
    _ => _unary(Op.Expression, 0, checkOperand(value, index, -1)),
  }
};

let _STATEMENT_TAIL = 0;
let _VALUE_TAIL = 1;
let _RESULT_TAIL = 2;

export let poisonDeclared: (Stmt, Bool) -> Bool = fn(statement, local) {
  let names = Array.new<Bytes>(0);
  let patterns = Array.new<Pattern>(0);

  match (statement) {
    LetStmt(_, _, pattern, _, _, _) => patterns.push(pattern),
    Prototype(_, name, _, _), Typedef(_, name, _, _), Macro(_, name, _, _) => { if (!local) { poison(name); } null },
    _ => null,
  };

  while (patterns.len() > 0) {
    let pattern = patterns[patterns.len() - 1];
    patterns.pop();

    match (pattern) {
      BindPattern(name) => names.push(name),
      Object(fields) => {
        let i = 0;

        while (i < fields.len()) {
          patterns.push(fields[i].1);
          i++;
        } null
      },
      Tuple(items), Array(items), Enum(_, items) => {
        appendFrom(patterns, items, 0);
        null
      },
      ArrayCons(head, rest) => {
        patterns.push(head);
        names.push(rest)
      },
      ArrayRest(items, rest) => {
        appendFrom(patterns, items, 0);
        names.push(rest)
      },
      RegExp(_, _, binding), IsType(_, binding) => { if (binding != null) { names.push(binding); } null },
      _ => null,
    };
  }
  let i = 0;

  while (i < names.len()) {
    if (!local) { poison(names[i]); } else if (_find(names[i], _scopeStart) < 0) { poisonLocal(_declare(names[i], H.newVar(false), false)); }
    i++;
  }
  true
};

let _recoverStatement = fn(error: Dynamic, syntax: Syntax, scopeStart: I32, loops: I32, tries: I32, mark: I32, last: Bool): I32 {
  recover(error);
  _popTo(mark);
  enterSyntax(syntax);
  _scopeStart = scopeStart;
  _loops = loops;
  _tries = tries;
  last ? _unary(Op.Throw, 0, _leaf(Op.Null, H.TYPE_NULL, 0)) : H.node(Op.Block, 0, 0, 0, [])
};

let _checkBlockBody = fn(prefix: Array<I32>, statements: Array<Stmt>, tail: ?AstExpr, first: I32, expected: I32, tailKind: I32): I32 {
  let outerStart = _scopeStart;
  _scopeStart = tailKind == _RESULT_TAIL ? 0 : _nameIds.len();
  let before = narrowings();
  let children = prefix;
  let ends = false;
  let i = 0;
  let syntax = _syntax;
  let scope = _scopeStart;
  let loops = _loops;
  let tries = _tries;

  while (i < statements.len()) {
    if (ends) {
      enterSyntax(syntaxChild(first + i));
      throw "unreachable statement";
    }
    let mark = _nameIds.len() as I32;
    let outerTouched = beginTouch();
    let outerDoubt = beginDoubt();

    try {
      let statement = _checkStatement(statements[i], syntaxChild(first + i));
      ends = H.endsPath(statement);
      children.push(statement);
    } catch (e) {
      let last = (tailKind != _STATEMENT_TAIL) && (i + 1 == statements.len()) && (tail == null);
      let recovered = _recoverStatement(e, syntax, scope, loops, tries, mark, last);
      poisonDeclared(statements[i], true);
      ends = H.endsPath(recovered);
      children.push(recovered);
    }
    endTouch(outerTouched);
    endDoubt(outerDoubt);
    i++;
  }
  let ty = 0;
  let hasTail = false;
  let statementTail = (tailKind == _STATEMENT_TAIL)
    || ((tailKind == _RESULT_TAIL) && (tail != null) && match (tail) { BlockExpr(Block(_, inner)) => inner == null, _ => false });

  if (tail != null) {
    let index = first + (statements.len() as I32);
    let mark = _nameIds.len() as I32;
    let outerTouched = beginTouch();
    let outerDoubt = beginDoubt();

    try {
      if (statementTail) {
        let effect = checkEffect(tail, index);
        if (!ends) { children.push(effect); }
        ends = ends || H.endsPath(effect);
      } else {
        let checked = tailKind == _RESULT_TAIL ? _checkResult(tail, index) : checkOperand(tail, index, expected);

        if ((tailKind == _RESULT_TAIL) || !ends) {
          ty = H.typeOf(checked);
          hasTail = true;
          children.push(checked);
        }
      }
    } catch (e) {
      let recovered = _recoverStatement(e, syntax, scope, loops, tries, mark, tailKind != _STATEMENT_TAIL);

      if (!ends) {
        children.push(recovered);
        ends = H.endsPath(recovered);
      }
    }
    endTouch(outerTouched || touched());
    if (endDoubt(outerDoubt)) { doubt(); }
  }
  if ((tailKind == _VALUE_TAIL) && ends) { ty = H.noValueType(expected); }

  if ((tailKind == _RESULT_TAIL) && !hasTail && !ends) {
    children.push(_nullResult("function can fall through without a value of type "));
    ty = H.TYPE_NULL;
    hasTail = true;
  }
  _popTo(_scopeStart);
  _scopeStart = outerStart;
  keepNarrowings(before);
  H.node(Op.Block, ty, 0, hasTail ? 1 : 0, children)
};

export let checkArm: (Array<Bytes>, Array<I32>, Array<Stmt>, Null<AstExpr>, I32, I32, Bool) -> I32 = fn(names, values, statements, tail, first, expected, statement) {
  let mark = _nameIds.len();
  let prefix = Array.new<I32>(0);
  let i = 0;

  while (i < names.len()) {
    let value = values[i];
    prefix.push(_unary(Op.Declare, 0, H.node(Op.Const, H.typeOf(value), _declare(names[i], H.typeOf(value), false), H.bytesId(names[i]), [value])));
    i++;
  }
  let block = _checkBlockBody(prefix, statements, tail, first, expected, statement ? _STATEMENT_TAIL : _VALUE_TAIL);
  _popTo(mark);
  block
};

_checkBranch = fn(branch, index) {
  let outer = enterSyntax(syntaxChild(index));

  let block = match (branch) {
    BlockExpr(body) => match (body) { Block(statements, tail) => _checkBlockBody([], statements, tail, 0, -1, _STATEMENT_TAIL) },
    _ => {
      internalError("statement block expected");
      -1
    },
  };
  enterSyntax(outer);
  block
};

_checkIfStatement = fn(condition, thenBranch, elseBranch) {
  let checkedCondition = _value(condition, 0, -1);
  _requireBool("if", checkedCondition, 0);
  let before = narrowings();
  _narrowBy(condition, true);
  let children = [checkedCondition, _checkBranch(thenBranch, 1)];
  let afterThen = narrowings();
  setNarrowings(before);
  _narrowBy(condition, false);

  match (elseBranch) {
    Null => null,
    If(_, _, _) => {
      children.push(checkEffect(elseBranch, 2));
      null
    },
    _ => {
      children.push(_checkBranch(elseBranch, 2));
      null
    },
  };
  let thenEnds = H.endsPath(children[1]);
  let elseEnds = (children.len() == 3) && H.endsPath(children[2]);
  if (thenEnds == elseEnds) { keepNarrowings(afterThen); } else if (elseEnds) { setNarrowings(afterThen); }
  H.node(Op.IfStatement, 0, 0, 0, children)
};

_checkTry = fn(body, catchName, handler, expected, statement) {
  if (_tries == 16) { throw "try regions nest more than 16 deep in one function"; }
  let tailKind = statement ? _STATEMENT_TAIL : _VALUE_TAIL;
  let before = narrowings();
  let mark = assignmentMark();
  _tries++;

  let checkedBody = match (body) { Block(statements, tail) => {
    let checked = _checkBlockBody([], statements, tail, 0, expected, tailKind);
    if (!statement && (tail == null) && !H.endsPath(checked)) { throw "a try used as a value needs a value at the end of its body"; }
    checked
  } };
  _tries--;
  let afterBody = narrowings();
  leaveLoop(before, mark);
  let scope = _nameIds.len();
  let binding = catchName == null ? -1 : _declare(catchName, H.TYPE_DYNAMIC, false);
  let first = match (body) { Block(statements, tail) => (statements.len() as I32) + (tail == null ? 0 : 1) };

  let checkedHandler = match (handler) { Block(statements, tail) => {
    let checked = _checkBlockBody([], statements, tail, first, expected, tailKind);
    if (!statement && (tail == null) && !H.endsPath(checked)) { throw "a try used as a value needs a value at the end of its catch"; }
    checked
  } };
  _popTo(scope);
  if (H.endsPath(checkedHandler)) { setNarrowings(afterBody); } else if (!H.endsPath(checkedBody)) { keepNarrowings(afterBody); }
  let name = catchName == null ? 0 : H.bytesId(catchName);
  if (statement) { return H.node(Op.TryStatement, 0, binding, name, [checkedBody, checkedHandler]); }
  let ty = joinBranches(checkedBody, checkedHandler);
  let bodyTail = match (body) { Block(statements, _) => statements.len() as I32 };
  let handlerTail = match (handler) { Block(statements, _) => first + (statements.len() as I32) };
  if (ty < 0) { throw branchMismatch("try and catch values", H.typeOf(checkedBody), H.typeOf(checkedHandler), handlerTail); }
  H.node(Op.Try, ty, binding, name, [coerceTail(checkedBody, ty, bodyTail), coerceTail(checkedHandler, ty, handlerTail)])
};

let _checkDestructure = fn(pattern: Pattern, isConst: Bool, typeParams: Array<TypeParam>, annotation: ?AstType, value: AstExpr): I32 {
  let items = match (pattern) {
    Tuple(items) => items,
    _ => {
      enterSyntax(syntaxPattern(0));
      throw "this binding pattern is not supported yet";
      Array.new<Pattern>(0)
    },
  };
  if (typeParams.len() != 0) { throw "local bindings do not support type parameters"; }
  let ty = checkAnnotation(annotation);
  let checked = checkOperand(value, 0, ty);
  let tuple = H.typeOf(checked);

  if ((ty >= 0) && !H.unify(tuple, ty)) {
    enterSyntax(syntaxChild(0));
    throw _annotationMismatch("this tuple", ty, tuple);
  }

  if (!H.isKind(tuple, Kind.Tuple) || (H.typeArgCount(tuple) != items.len())) {
    throw "cannot destructure " + H.typeName(tuple) + " into " + Std.string(items.len()) + " names";
  }
  let hidden = newBinding();
  let children = [H.node(Op.Const, tuple, hidden, H.bytesId("tuple"), [checked])];
  let i = 0;

  while (i < items.len()) {
    let field = H.typeArg(tuple, i);
    let outer = enterSyntax(subPattern(syntaxPattern(0), i));

    match (items[i]) {
      Wildcard => null,
      BindPattern(name) => {
        if (_find(name, _scopeStart) >= 0) { throw "duplicate local: " + name; }
        let read = H.node(Op.TupleField, field, i, 0, [_leaf(Op.Local, tuple, hidden)]);
        children.push(H.node(isConst ? Op.Const : Op.Let, field, _declare(name, field, !isConst), H.bytesId(name), [read]));
        null
      },
      _ => {
        throw "nested patterns in let are not supported yet";
        null
      },
    };
    enterSyntax(outer);
    i++;
  }
  H.node(Op.Declare, 0, 0, 0, children)
};

export let checkWhile: (AstExpr, Array<Stmt>) -> I32 = fn(condition, body) {
  let before = narrowings();
  let mark = assignmentMark();
  enterLoop();
  let checkedCondition = -1;

  try { checkedCondition = _value(condition, 0, -1); } catch (e) {
    setNarrowings(before);
    throw e;
  }
  _requireBool("while", checkedCondition, 0);
  _narrowBy(condition, true);
  _loops++;
  let checkedBody = _checkBlockBody([], body, null, 1, -1, _STATEMENT_TAIL);
  _loops--;
  leaveLoop(before, mark);
  H.node(Op.While, 0, 0, 0, [checkedCondition, checkedBody])
};

export let checkDoWhile: (Array<Stmt>, AstExpr) -> I32 = fn(body, condition) {
  let before = narrowings();
  let mark = assignmentMark();
  enterLoop();
  _loops++;
  let checkedBody = _checkBlockBody([], body, null, 0, -1, _STATEMENT_TAIL);
  _loops--;
  let checkedCondition = -1;

  try { checkedCondition = _value(condition, body.len(), -1); } catch (e) {
    setNarrowings(before);
    throw e;
  }
  _requireBool("do-while", checkedCondition, body.len());
  leaveLoop(before, mark);
  H.node(Op.While, 0, 0, 1, [checkedCondition, checkedBody])
};

export let checkThrow: (AstExpr) -> I32 = fn(value) {
  let thrown = _value(value, 0, -1);

  if (H.typeOf(thrown) == H.TYPE_BYTE_BUFFER) {
    enterSyntax(syntaxChild(0));
    throw "a buffer from Bytes.new cannot be thrown" + bufferHint(H.typeOf(thrown));
  }

  if (H.isKind(H.typeOf(thrown), Kind.List)) {
    enterSyntax(syntaxChild(0));
    throw "a list cannot be thrown: its nil would read as null";
  }
  _unary(Op.Throw, 0, thrown)
};

_checkStatement = fn(statement, syntax) {
  let outer = enterSyntax(syntax);

  let id = match (statement) {
    LetStmt(_, exported, pattern, typeParams, _, value) when (!exported && isTemplate(statement)) =>
      _checkLocalTemplate(bindPatternName(pattern), typeParams, value),
    LetStmt(isConst, exported, pattern, typeParams, annotation, value) when (!exported && isBindPattern(pattern)) =>
      _unary(Op.Declare, 0, _checkLocal(pattern, isConst, typeParams, annotation, value)),
    LetStmt(isConst, exported, pattern, typeParams, annotation, value) when (!exported) =>
      _checkDestructure(pattern, isConst, typeParams, annotation, value),
    Expression(value) => checkEffect(value, 0),
    Return(value) => {
      _unary(Op.Return, 0, value == null ? _nullResult("return needs a value of type ") : _checkResult(value, 0))
    },
    Throw(value) => checkThrow(value),
    Break => {
      if (_loops == 0) { throw "break outside loop"; }
      _leaf(Op.Break, 0, 0)
    },
    Continue => {
      if (_loops == 0) { throw "continue outside loop"; }
      _leaf(Op.Continue, 0, 0)
    },
    While(condition, body) => checkWhile(condition, body),
    DoWhile(body, condition) => checkDoWhile(body, condition),
    _ => {
      throw unsupportedStatement(statement);
      -1
    },
  };
  enterSyntax(outer);
  id
};

let _checkFunction = fn(index: I32, body: AstBlock, syntax: Syntax): Array<I32> {
  let outer = enterSyntax(syntax);
  let outerNameIds = _nameIds;
  let outerIds = _ids;
  let outerHidden = _hidden;
  let outerLoops = _loops;
  let outerTries = _tries;
  let outerStart = _scopeStart;
  let outerKnown = narrowings();
  setNarrowings(Array.new<I32>(0));
  _frames.push(Frame.Frame(outerNameIds, outerIds));
  _captures.push(Array.new<I32>(0));
  _sources.push(Array.new<I32>(0));
  _nameIds = Array.new<I32>(0);
  _ids = Array.new<I32>(0);
  _hidden = Array.new<I32>(0);
  _loops = 0;
  _tries = 0;
  _scopeStart = 0;
  let ty = _functionTypes[index];
  let name = _functionNames[index];
  let paramNames = _functionParams[index];
  let paramTypes = _functionParamTypes[index];
  let inferred = ty < 0;

  if (inferred) {
    ty = H.functionType(paramTypes, H.newVar(false));
    _functionTypes[index] = ty;
  }
  let outerResult = _result;
  _result = inferred ? -1 : H.innerOf(ty);
  let outerResultSyntax = _resultSyntax;
  _resultSyntax = inferred ? _noSyntax() : syntax;
  let outerInferred = _resultInferred;
  let outerResultsStart = _resultsStart;
  _resultInferred = inferred;
  _resultsStart = _results.len() as I32;
  let failure: ?Bytes = null;
  let failures = failureCount();
  let outerDoubt = beginDoubt();
  let doubted = false;

  try {
    let children = Array.new<I32>(0);
    let i = 0;

    while (i < paramNames.len()) {
      let paramType = H.slotType(paramTypes[i]);
      let parent = enterSyntax(syntaxChild(i));
      children.push(H.node(Op.Parameter, paramType, _declare(paramNames[i], paramType, false), H.bytesId(paramNames[i]), []));
      enterSyntax(parent);
      i++;
    }
    let first = paramNames.len() as I32;

    match (body) { Block(statements, tail) => {
      let checked = _checkBlockBody([], statements, tail, first, -1, _RESULT_TAIL);
      if (_result < 0) { _result = H.TYPE_NULL; }
      let bodyFailed = failureCount() != failures;

      if (inferred) {
        doubted = bodyFailed;
        checked = _joinResults(checked);
        let used = H.innerOf(ty);

        if (!H.unifyResult(used, _result) && !bodyFailed) {
          throw name + " returns " + H.typeName(H.resolve(_result)) + ", but a call uses its result as " + H.typeName(H.resolve(used)) + "; annotate its result type";
        }
        ty = H.functionType(paramTypes, _result);
        _functionTypes[index] = ty;
      }
      let captures = _captures[_frames.len()];
      let c = 0;

      while (c < captures.len()) {
        children.push(captures[c]);
        c++;
      }
      children.push(checked);
      _functionNodes[index] = H.node(Op.Function, ty, H.bytesId(name), 0, children);
    } };
  } catch (e) {
    failure = Std.string(e);
    _popTo(0);
  }
  let sources = _sources[_frames.len()];
  _frames.pop();
  _captures.pop();
  _sources.pop();
  _nameIds = outerNameIds;
  _ids = outerIds;
  _hidden = outerHidden;
  _result = outerResult;
  _resultSyntax = outerResultSyntax;
  _resultInferred = outerInferred;
  Array.resize(_results, _resultsStart);
  _resultsStart = outerResultsStart;
  _loops = outerLoops;
  _tries = outerTries;
  _scopeStart = outerStart;
  setNarrowings(outerKnown);
  endDoubt(outerDoubt);
  if (doubted) { doubt(); }
  if (failure != null) { throw failure; }
  enterSyntax(outer);
  sources
};

let _checkIsolated = fn(index: I32, body: AstBlock, syntax: Syntax, name: Bytes, names: Array<Bytes>, types: Array<I32>, template: Bool, locals: Array<I32>) {
  let outerFrames = _frames;
  let outerCaptures = _captures;
  let outerSources = _sources;
  let outerNameIds = _nameIds;
  let outerIds = _ids;
  let outerHidden = _hidden;
  let outerName = _bodyName;
  let outerNames = _envNames;
  let outerTypes = _envTypes;
  let outerTemplate = _templateBody;
  let outerFloor = _captureFloor;
  _frames = Array.new<Frame>(0);
  _captures = [Array.new<I32>(0)];
  _sources = [Array.new<I32>(0)];
  _nameIds = Array.new<I32>(0);
  _ids = Array.new<I32>(0);
  _hidden = Array.new<I32>(0);
  _bodyName = name;
  _envNames = names;
  _envTypes = types;
  _templateBody = template;
  _captureFloor = 0;
  let i = 0;
  let failure: ?Bytes = null;

  while (i < locals.len()) {
    _declareTemplate(locals[i]);
    i++;
  }
  try { _checkFunction(index, body, syntax); } catch (e) { failure = Std.string(e); }
  _popTo(0);
  _frames = outerFrames;
  _captures = outerCaptures;
  _sources = outerSources;
  _nameIds = outerNameIds;
  _ids = outerIds;
  _hidden = outerHidden;
  _bodyName = outerName;
  _envNames = outerNames;
  _envTypes = outerTypes;
  _templateBody = outerTemplate;
  _captureFloor = outerFloor;
  if (failure != null) { throw failure; }
  null
};

checkDirect = fn(index) {
  if (_functionNodes[index] >= 0) { return true; }
  let statement = _directStatements[index - _firstDirect];
  let inferred = _functionTypes[index] < 0;
  let outer = _syntax;
  let outerTouched = beginTouch();
  let outerDoubt = beginDoubt();

  try {
    match (_statements[statement]) {
      LetStmt(_, _, _, _, _, Function(_, _, body, _)) =>
        _checkIsolated(index, body, _childOf(_childOf(_moduleSyntax, statement), 0), _functionNames[index], _NO_NAMES, _NO_TYPES, false, _NO_TYPES),
      _ => internalError("a direct function expected"),
    };
  } catch (e) {
    recover(e);
    enterSyntax(outer);
    _functionNodes[index] = H.node(Op.Block, 0, 0, 0, []);
    if (inferred) { doubt(); }
  }
  if (endDoubt(outerDoubt)) { poison(_functionNames[index]); }
  endTouch(outerTouched);
  true
};

let _joinTypes = fn(types: Array<I32>, more: Array<I32>): Array<I32> {
  appendFrom(appendFrom(Array.new<I32>(0), types, 0), more, 0)
};

_checkTemplate = fn(t, local) {
  if (_templateFunctions[t] >= 0) { return true; }

  match (_templates[t]) { Template(name, params, value, syntax, _, bodyName, names, envTypes, _, _, _) => match (value) {
    Function(fnParams, result, body, _) => {
      let types = _joinTypes(envTypes, params);
      let outerNames = _envNames;
      let outerTypes = _envTypes;
      let outerTemplate = _templateBody;
      let outerFloor = _captureFloor;
      _envNames = names;
      _envTypes = types;
      _templateBody = true;
      let failure: ?Bytes = null;

      try {
        let index = _addFunction(name, fnParams, result, -1, syntax);
        _templateFunctions[t] = index;

        if (local) {
          _captureFloor = _frames.len() + 1;
          _checkFunction(index, body, syntax);
        } else { _checkIsolated(index, body, syntax, bodyName, names, types, true, _NO_TYPES); }
      } catch (e) { failure = Std.string(e); }
      _envNames = outerNames;
      _envTypes = outerTypes;
      _templateBody = outerTemplate;
      _captureFloor = outerFloor;
      if (failure != null) { throw failure; }
    },
    _ => internalError("a function expected"),
  } };
  true
};

export let checkTemplate: (Bytes) -> Bool = fn(name) { match (scoped(name)) { Template(t) => _checkTemplate(t, false), _ => internalError("a template expected") } };

let _checkLocalTemplate = fn(name: Bytes, typeParams: Array<TypeParam>, value: AstExpr): I32 {
  if (_find(name, _scopeStart) >= 0) { throw "duplicate local: " + name; }
  let t = _newTemplate(name, typeParams, value, syntaxChild(0), _bodyName);
  _declareTemplate(t);

  match (_templates[t]) { Template(_, _, _, _, _, _, _, _, locals, _, _) => {
    let i = 0;

    while (i < _templates.len()) {
      match (_templates[i]) { Template(other, _, _, _, _, _, _, _, _, _, _) => { if (_localTemplate(other) == i) { locals.push(i); } } };
      i++;
    }
  } };
  _checkTemplate(t, true);
  H.node(Op.Block, 0, 0, 0, [])
};

let _instance = fn(t: I32, types: Array<I32>, depth: I32): I32 {
  match (_templates[t]) { Template(name, params, value, syntax, module, _, names, envTypes, locals, keys, functions) => match (value) {
    Function(_, _, body, _) => {
      let key = H.tupleType(types);
      let found = indexOf(keys, key);
      if (found >= 0) { return functions[found]; }
      if (depth > H.MAX_INSTANCE_DEPTH) { throw H.nestsTooDeep(name); }
      let template = _templateFunctions[t];
      let index = generateFunction(name + "<" + H.typeArgNames(key) + ">", _functionParams[template], H.substitute(_functionTypes[template], params, types));
      keys.push(key);
      functions.push(index);
      let outerScope = useModuleScope(module);
      let outerDepth = _instanceDepth;
      _instanceDepth = depth;
      _checkIsolated(index, body, syntax, "", names, _joinTypes(envTypes, types), false, locals);
      useModuleScope(outerScope);
      _instanceDepth = outerDepth;
      index
    },
    _ => {
      internalError("a function expected");
      -1
    },
  } }
};

export let instantiateTemplates: () -> Bool = fn() {
  let i = 0;

  while (i < _pending.len()) {
    let (call, t, types, depth) = _pending[i];
    let outer = enterNode(call);

    match (_templates[t]) { Template(name, params, _, _, _, _, _, _, _, _, _) => {
      let j = 0;

      while (j < types.len()) {
        types[j] = H.defaultIntegers(types[j]);
        if (H.isOpen(types[j])) { throw "cannot infer " + H.typeName(params[j]) + " of " + name + " here; annotate it"; }
        j++;
      }
      _checkTypeArgs(t, name, types);
    } };
    H.setCallee(call, _instance(t, types, depth));
    enterSyntax(outer);
    i++;
  }
  _pending = Array.new<Tuple<I32, I32, Array<I32>, I32>>(0);
  true
};

_checkFunctionLiteral = fn(params, result, body, expected) {
  let index = _addFunction("fn", params, result, expected, _syntax);
  let captured = _checkFunction(index, body, _syntax);
  H.node(Op.FunctionRef, _functionType(index), index + 1, 0, captured)
};

_checkBlock = fn(statements, tail, expected) { _checkBlockBody([], statements, tail, 0, expected, _VALUE_TAIL) };

let _regexpKeys = Array.new<Bytes>(0);
let _regexpGlobals = Array.new<I32>(0);
let _regexpInits = Array.new<I32>(0);

export let regexpGlobal: (Bytes, Bytes) -> I32 = fn(pattern, flags) {
  if (_templateBody) { return 0; }
  let key = flags + "/" + pattern;
  let found = indexOf(_regexpKeys, key);
  if (found >= 0) { return _regexpGlobals[found]; }
  let global = H.declareGlobal("~r/" + pattern + "/" + flags, H.TYPE_DYNAMIC, false);
  let compile = H.stdNative("regexp_compile", [H.TYPE_BYTES, H.TYPE_BYTES], H.TYPE_DYNAMIC);
  let compiled = H.node(Op.CallNative, H.TYPE_DYNAMIC, compile, 0, [_leaf(Op.Bytes, H.TYPE_BYTES, H.bytesId(pattern)), _leaf(Op.Bytes, H.TYPE_BYTES, H.bytesId(flags))]);
  _regexpInits.push(H.node(Op.Declare, 0, 0, 0, [H.node(Op.InitGlobal, H.TYPE_DYNAMIC, global, 0, [compiled])]));
  _regexpKeys.push(key);
  _regexpGlobals.push(global);
  global
};

export let takeRegexpInits: () -> Array<I32> = fn() {
  let inits = _regexpInits;
  _regexpKeys = Array.new<Bytes>(0);
  _regexpGlobals = Array.new<I32>(0);
  _regexpInits = Array.new<I32>(0);
  inits
};

export let beginCheck: () -> Bool = fn() {
  H.beginHir();
  resetNarrowing();
  _nameIds = Array.new<I32>(0);
  _ids = Array.new<I32>(0);
  _hidden = Array.new<I32>(0);
  _latest = Array.new<I32>(0);
  _nextBinding = 0;
  _bindingTypes = Array.new<I32>(0);
  _mutable = Array.new<Bool>(0);
  _declarations = Array.new<Syntax>(0);
  _globalDeclarations = Array.new<Syntax>(0);
  _syntax = _noSyntax();
  _resultSyntax = _noSyntax();
  _frames = Array.new<Frame>(0);
  _captures = [Array.new<I32>(0)];
  _sources = [Array.new<I32>(0)];
  _scopeStart = 0;
  _loops = 0;
  _tries = 0;
  _functionNames = Array.new<Bytes>(0);
  _functionTypes = Array.new<I32>(0);
  _functionSyntaxes = Array.new<Syntax>(0);
  _functionParams = Array.new<Array<Bytes>>(0);
  _functionNodes = Array.new<I32>(0);
  _functionDefaults = Array.new<Array<I32>>(0);
  _functionParamTypes = Array.new<Array<I32>>(0);
  _result = -1;
  _resultInferred = false;
  _results = Array.new<I32>(0);
  _resultsStart = 0;
  _inferred = Array.new<Tuple<Bytes, Syntax, I32>>(0);
  _bodyName = "";
  _templates = Array.new<Template>(0);
  _templateFunctions = Array.new<I32>(0);
  _envNames = Array.new<Bytes>(0);
  _envTypes = Array.new<I32>(0);
  _templateBody = false;
  _dropped = Array.new<Bool>(0);
  _captureFloor = 0;
  _pending = Array.new<Tuple<I32, I32, Array<I32>, I32>>(0);
  _instanceDepth = 0;
  _literals = Array.new<Tuple<I32, Bytes, Bool>>(0);
  _conversions = Array.new<I32>(0);
  takeRegexpInits();
  resetFailures();
  true
};

let _fits = fn(id: I32, ty: I32, negative: Bool): Bool {
  if (H.isKind(H.resolve(ty), Kind.Param)) { return true; }
  if (!negative && (H.wideValueOf(id) < 0)) { return ty == H.TYPE_U64; }
  if (ty == H.TYPE_I64) { return true; }
  if ((ty == H.TYPE_I32) || !H.isIntegerType(ty)) { return H.fitsI32(id); }
  let value = H.wideValueOf(id);
  ty == H.TYPE_U64 ? value >= 0 : (value >= H.leastValue(ty)) && (value <= H.mostValue(ty))
};

let _checkLiteralRange = fn(id: I32, text: Bytes, negative: Bool, ty: I32) {
  if (!_fits(id, ty, negative)) {
    enterNode(id);
    _typedLiteral(text, negative, H.isIntegerType(ty) ? ty : H.TYPE_I32);
  }
  null
};

export let checkLiteralRanges: () -> Bool = fn() {
  let i = 0;
  let going = true;
  beginTouch();

  while (going && (i < _literals.len())) {
    let (id, text, negative) = _literals[i];
    try { _checkLiteralRange(id, text, negative, H.resolve(H.typeOf(id))); } catch (e) { going = recordFailure(currentSpan(), e); }
    i++;
  }
  true
};

let _settleTypes = fn() {
  let i = 0;

  while (i < _literals.len()) {
    let (id, text, negative) = _literals[i];
    let ty = H.defaultIntegers(H.typeOf(id));
    _checkLiteralRange(id, text, negative, ty);
    H.settleLiteral(id, ty);
    i++;
  }
  i = 0;

  while (i < _conversions.len()) {
    H.settleConversion(_conversions[i]);
    i++;
  }
  _literals = Array.new<Tuple<I32, Bytes, Bool>>(0);
  _conversions = Array.new<I32>(0);
  i = 0;

  while (i < _inferred.len()) {
    let (name, syntax, declared) = _inferred[i];
    let ty = H.resolve(declared);

    if (H.isOpen(ty)) {
      enterSyntax(syntax);
      throw "cannot infer the type of " + name + "; annotate it" + (H.isKind(ty, Kind.Null) ? " as Null<T>" : "");
    }
    i++;
  }
  let open = H.resolveTypes();

  if (open >= 0) {
    enterNode(open);
    throw "cannot infer the type of this value; annotate it";
  }
  null
};

let _dropTemplates = fn() {
  let numbers = Array.new<I32>(0);
  let kept = Array.new<I32>(0);
  let i = 0;

  while (i < _functionNodes.len()) {
    numbers.push(kept.len());
    if (!_dropped[i]) { kept.push(_functionNodes[i]); }
    i++;
  }
  i = 0;
  let count = H.nodeCount();

  while (i < count) {
    let op = H.opOf(i);
    if (((op == Op.Call) || (op == Op.FunctionRef)) && (H.valueOf(i) > 0)) { H.setCallee(i, numbers[H.valueOf(i) - 1]); }
    i++;
  }
  _functionNodes = kept;
  null
};

export let finishProgram: (I32) -> Hir = fn(body) {
  _functionNodes.push(body);
  _dropped.push(false);
  if (_templateFunctions.len() > 0) { _dropTemplates(); }
  _settleTypes();
  let hir = H.finishHir(H.node(Op.Program, 0, 0, 0, _functionNodes));
  _syntax = _noSyntax();
  hir
};

export let enterSpan: (Null<SourceSpan>) -> Bool = fn(span) {
  let syntax = _noSyntax();
  if (span != null) { match (span) { Span(path, start, end) => { syntax = _spanSyntax(path, start, end); } }; }
  enterSyntax(syntax);
  true
};

export let recoverTopLevel: (Dynamic, Syntax) -> Bool = fn(error, syntax) {
  recover(error);
  _popTo(0);
  enterSyntax(syntax);
  _scopeStart = 0;
  _loops = 0;
  _tries = 0;
  _bodyName = "";
  resetNarrowing()
};
