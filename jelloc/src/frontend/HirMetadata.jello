package frontend;

import type { Binding, Expr, FunctionBody, FunctionDecl, NodeInfo, Program, Statement } from frontend.Hir;
import { NodeId, NodeInfo, NodeKind } from frontend.Hir;
import { SourceSpan } from frontend.Source;
import type { SyntaxInfo, SyntaxKind } from frontend.Source;
import { SyntaxKind } from frontend.Source;

let _syntax = Array.new<SyntaxInfo>(0);

let _matches = fn(kind: NodeKind, syntax: SyntaxKind): Bool {
  match (kind) {
    Expression => match (syntax) { Expression => true, _ => false },
    Parameter => match (syntax) { Parameter => true, _ => false },
    Binding, Statement, Function => match (syntax) { Statement => true, _ => false },
  }
};

let _add = fn(nodes: Array<NodeInfo>, kind: NodeKind, path: Bytes) {
  let index = nodes.len();
  if (index >= _syntax.len()) { throw "missing ordered HIR source metadata"; }

  let span = match (_syntax[index]) { Node(sourceKind, sourcePath, start, end) => {
    if (!_matches(kind, sourceKind)) { throw "ordered HIR source metadata kind mismatch"; }
    if ((sourcePath.len() == 0) || (start < 0) || (end <= start)) { throw "invalid ordered HIR source span"; }
    SourceSpan.Span(sourcePath, start, end)
  } };
  nodes.push(NodeInfo.Node(NodeId.Id(nodes.len() as I32), kind, span));
  null
};

let _expr: (Expr, Array<NodeInfo>, Bytes) -> Bool = fn(expr, nodes, path) {
  match (expr) {
    AssignLocal(_, value, _) => _expr(value, nodes, path),
    NegateI32Wrap(value), NotBool(value), SignExtendI32ToI64(value), TruncateI64ToI32(value) => _expr(value, nodes, path),
    AddI32Wrap(left, right), SubI32Wrap(left, right), EqualI32(left, right),
    MultiplyI32Wrap(left, right), LessI32Signed(left, right), GreaterI32Signed(left, right) => {
      _expr(left, nodes, path);
      _expr(right, nodes, path);
      false
    },
    CallDirect(_, args, _) => {
      let i = 0;

      while (i < args.len()) {
        _expr(args[i], nodes, path);
        i++;
      }
      false
    },
    Block(bindings, tail) => {
      let i = 0;

      while (i < bindings.len()) {
        match (bindings[i]) { Binding(_, _, _, _, value) => _expr(value, nodes, path) };
        _add(nodes, NodeKind.Binding, path);
        i++;
      }
      _expr(tail, nodes, path)
    },
    If(condition, thenBranch, elseBranch, _) => {
      _expr(condition, nodes, path);
      _expr(thenBranch, nodes, path);
      _expr(elseBranch, nodes, path)
    },
    _ => false,
  };
  _add(nodes, NodeKind.Expression, path);
  true
};

let _statements: (Array<Statement>, Array<NodeInfo>, Bytes) -> Bool = fn(_statements, _nodes, _path) { false };

_statements = fn(statements, nodes, path) {
  let i = 0;

  while (i < statements.len()) {
    match (statements[i]) {
      Bind(binding) => match (binding) { Binding(_, _, _, _, value) => {
        _expr(value, nodes, path);
        _add(nodes, NodeKind.Binding, path);
      } },
      Expression(value), ReturnValue(value), ThrowValue(value) => {
        _expr(value, nodes, path);
        null
      },
      WhileLoop(condition, body) => {
        _expr(condition, nodes, path);
        _statements(body, nodes, path);
        null
      },
      _ => null,
    };
    _add(nodes, NodeKind.Statement, path);
    i++;
  }
  true
};

let _pathForName = fn(name: Bytes, entryPath: Bytes): Bytes {
  let marker = name.indexOf("#");
  if (marker < 0) { entryPath } else { Bytes.slice(name, 0, marker) }
};

export let collectNodes: (Program, Array<SyntaxInfo>, Bytes) -> Array<NodeInfo> = fn(program, sourceSyntax, entryPath) {
  _syntax = sourceSyntax;
  let nodes = Array.new<NodeInfo>(0);

  match (program) { Program(functions, bindings, tail, _) => {
    let i = 0;

    while (i < functions.len()) {
      match (functions[i]) { FunctionDecl(_, name, params, _, FunctionBody(statements, functionTail)) => {
        let path = _pathForName(name, entryPath);
        let j = 0;

        while (j < params.len()) {
          _add(nodes, NodeKind.Parameter, path);
          j++;
        }
        _statements(statements, nodes, path);
        if (functionTail != null) { _expr(functionTail, nodes, path); }
        _add(nodes, NodeKind.Function, path);
      } };
      i++;
    }
    i = 0;

    while (i < bindings.len()) {
      match (bindings[i]) { Binding(_, name, _, _, value) => {
        let path = _pathForName(name, entryPath);
        _expr(value, nodes, path);
        _add(nodes, NodeKind.Binding, path);
      } };
      i++;
    }
    _expr(tail, nodes, entryPath);
  } };
  if (nodes.len() != _syntax.len()) { throw "extra ordered HIR source metadata"; }
  nodes
};
