package frontend;

let _concat: (Array<Bytes>, I32, I32) -> Bytes = fn(parts, lo, hi) {
  if (hi - lo == 1) {
    parts[lo]
  } else if (hi <= lo) {
    ""
  } else {
    let mid = lo + (hi - lo) / 2;
    _concat(parts, lo, mid) + _concat(parts, mid, hi)
  }
};

export let concatAll: (Array<Bytes>) -> Bytes = fn(parts) { _concat(parts, 0, parts.len()) };
