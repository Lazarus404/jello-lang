package frontend.semantics;

/** @file
 * Checks `Function.bind` and `Function.callWith` into HIR, as `f.bind(...)` and
 * `f.callWith(...)` too. A function's `this` is its first parameter; a prototype's method, which
 * `o.m` reads, takes its receiver there. `callWith(f, thisArg, args)` calls `f` with `thisArg` as
 * its `this` and then `args`; `bind(f, thisArg, args)` evaluates them once and gives a function of
 * the parameters after them, which calls `f` with them first. `frontend.semantics.Aggregates`
 * passes the calls here, with the call's syntax current and `args[i]` its child `i + 1`. */

import type { Expr as AstExpr } from frontend.syntax.Ast;
import frontend.hir.Hir as H;
import { Kind, Op } from frontend.hir.Hir;
import { E0600, E0601, E0604, coded } from support.Codes;
import {
  checkArguments,
  checkIndirectCall,
  defineFunction,
  enterSyntax,
  generateClosure,
  hasSpread,
  newBinding,
  syntaxChild
} from frontend.semantics.TypeCheck;

// Checks whether `name` is a function of `Function`.
export let isFunctionIntrinsic = fn(name: Bytes): Bool {
  match (name) { "bind", "callWith" => true, _ => false }
};

/** Checks `bind(f, thisArg, args)`, the function that calls `f` with `thisArg` and `args` first
 * and then its own arguments; they are evaluated once, when it is made, and are its captures.
 * @param function  the checked `f`
 * @param args  `thisArg` and the arguments it fixes
 * @return the closure
 * @throws a located error if there is no `thisArg`, if `f` takes fewer parameters than are fixed,
 *   or a fixed argument would fill a `T...` */
let _bind = fn(function: I32, args: Array<AstExpr>): I32 {
  let ty = H.typeOf(function);
  let count = H.typeArgCount(ty);
  let fixed = ((count > 0) && H.isKind(H.typeArg(ty, count - 1), Kind.Rest)) ? count - 1 : count;

  if (args.len() == 0) {
    throw coded(E0600, "Function.bind requires the `this` it passes, as bind(f, thisArg, args...)");
  }

  if (args.len() > fixed) {
    let takes = (fixed < count) ? `has ${fixed} before its ` + "`T...`" : `takes ${fixed}`;
    let fixes = `Function.bind fixes ${args.len()} parameters of ${H.typeName(ty)}`;
    throw coded(E0600, `${fixes}, which ${takes}`);
  }

  let prefix = Array.new<I32>(0);
  let i = 0;

  while (i < args.len()) {
    prefix.push(H.typeArg(ty, i));
    i++;
  }
  let fixedType = H.functionType(prefix, H.innerOf(ty));
  let captured = [function].appendFrom(checkArguments(fixedType, args, "Function.bind"), 0);

  // The closure takes the parameters after those fixed, and passes its captures before them.
  let params = Array.new<I32>(0);
  let names = Array.new<Bytes>(0);
  let children = Array.new<I32>(0);
  let reads = Array.new<I32>(0);

  while (i < count) {
    let param = H.typeArg(ty, i);
    let slot = H.slotType(param);
    let binding = newBinding();
    let name = `p${i}`;
    params.push(param);
    names.push(name);
    children.push(H.node(Op.Parameter, slot, binding, H.bytesId(name), []));
    reads.push(H.local(binding, slot));
    i++;
  }
  let passed = Array.new<I32>(0);

  for (i, value in captured) {
    let copy = newBinding();
    let held = H.typeOf(value);
    let name = (i == 0) ? "function" : "bound";
    children.push(H.node(Op.Capture, held, copy, H.bytesId(name), []));
    passed.push(H.local(copy, held));
  }

  let result = H.innerOf(ty);
  let closure = H.functionType(params, result);
  let call = H.opNode(Op.CallIndirect, result, passed.appendFrom(reads, 0));
  children.push(H.node(Op.Block, result, 0, 1, [call]));
  let index = generateClosure("bound", names, closure);
  defineFunction(index, H.node(Op.Function, closure, H.bytesId("bound"), 0, children));
  H.node(Op.FunctionRef, closure, index + 1, 0, captured)
};

/** Checks `Function.name(function, args)`, or `function.name(args)`, for a function of
 * `Function` (`isFunctionIntrinsic`).
 * @param function  the checked function value
 * @param args  `thisArg` and the other arguments
 * @return the checked call, or the bound function
 * @throws a located error if `function` is no function, or the arguments do not fit it */
export let checkFunctionIntrinsic = fn(name: Bytes, function: I32, args: Array<AstExpr>): I32 {
  if (!H.isKind(H.typeOf(function), Kind.Function)) {
    enterSyntax(syntaxChild(0));
    let actual = H.typeName(H.typeOf(function));
    throw coded(E0601, `Function.${name} requires a function, not ${actual}`);
  }

  if (hasSpread(args)) {
    throw coded(
      E0604,
      `Function.${name} cannot take a spread; it passes its arguments to the function in order`
    );
  }
  (name == "bind") ? _bind(function, args) : checkIndirectCall(function, -1, args)
};
