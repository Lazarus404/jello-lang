package frontend.semantics;

import type { Expr as AstExpr } from frontend.syntax.Ast;
import frontend.hir.Hir as H;
import { Kind, Op } from frontend.hir.Hir;
import { appendFrom } from support.Arrays;
import { checkArguments, checkIndirectCall, defineFunction, enterSyntax, generateClosure, hasSpread, newBinding, syntaxChild } from frontend.semantics.TypeCheck;

export let isFunctionIntrinsic: (Bytes) -> Bool = fn(name) { match (name) { "bind", "callWith" => true, _ => false } };

let _bind = fn(function: I32, args: Array<AstExpr>): I32 {
  let ty = H.typeOf(function);
  let count = H.typeArgCount(ty);
  let fixed = ((count > 0) && H.isKind(H.typeArg(ty, count - 1), Kind.Rest)) ? count - 1 : count;
  if (args.len() == 0) { throw "Function.bind requires the `this` it passes, as bind(f, thisArg, args...)"; }
  if (args.len() > fixed) { throw "Function.bind fixes " + Std.string(args.len()) + " parameters of " + H.typeName(ty) + ", which " + (fixed < count ? "has " + Std.string(fixed) + " before its `T...`" : "takes " + Std.string(fixed)); }
  let prefix = Array.new<I32>(0);
  let i = 0;

  while (i < args.len()) {
    prefix.push(H.typeArg(ty, i));
    i++;
  }
  let captured = appendFrom([function], checkArguments(H.functionType(prefix, H.innerOf(ty)), args, "Function.bind"), 0);
  let params = Array.new<I32>(0);
  let names = Array.new<Bytes>(0);
  let children = Array.new<I32>(0);
  let reads = Array.new<I32>(0);

  while (i < count) {
    let param = H.typeArg(ty, i);
    let slot = H.slotType(param);
    let binding = newBinding();
    let name = "p" + Std.string(i);
    params.push(param);
    names.push(name);
    children.push(H.node(Op.Parameter, slot, binding, H.bytesId(name), []));
    reads.push(H.local(binding, slot));
    i++;
  }
  let passed = Array.new<I32>(0);
  i = 0;

  while (i < captured.len()) {
    let copy = newBinding();
    let held = H.typeOf(captured[i]);
    children.push(H.node(Op.Capture, held, copy, H.bytesId(i == 0 ? "function" : "bound"), []));
    passed.push(H.local(copy, held));
    i++;
  }
  let result = H.innerOf(ty);
  let closure = H.functionType(params, result);
  children.push(H.node(Op.Block, result, 0, 1, [H.node(Op.CallIndirect, result, 0, 0, appendFrom(passed, reads, 0))]));
  let index = generateClosure("bound", names, closure);
  defineFunction(index, H.node(Op.Function, closure, H.bytesId("bound"), 0, children));
  H.node(Op.FunctionRef, closure, index + 1, 0, captured)
};

export let checkFunctionIntrinsic: (Bytes, I32, Array<AstExpr>) -> I32 = fn(name, function, args) {
  if (!H.isKind(H.typeOf(function), Kind.Function)) {
    enterSyntax(syntaxChild(0));
    throw "Function." + name + " requires a function, not " + H.typeName(H.typeOf(function));
  }
  if (hasSpread(args)) { throw "Function." + name + " cannot take a spread; it passes its arguments to the function in order"; }
  name == "bind" ? _bind(function, args) : checkIndirectCall(function, -1, args)
};
