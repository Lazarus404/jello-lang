package frontend.semantics;

/** @file
 * Checks patterns into HIR: a `let` that destructures, an `if` or `while` condition that tests a
 * pattern with `let`, and `match` expressions, called through `Enums.checkEnumExpr`. A match
 * tries its arms in order and compiles to a chain of `Op.If` (or `Op.IfStatement`) nodes. An arm's
 * condition is its pattern's tests, left to right and outside in, and then its guard; the names it
 * binds are declared again, from fresh reads, at the start of its body. The subject is bound once;
 * when it is a tuple literal that every arm matches with a tuple pattern or `_`, each item is
 * bound instead, so no tuple is built. Each arm must be useful and the arms together exhaustive,
 * which the usefulness check of Maranget's "Warnings for pattern matching" decides. */

import type {
  Block as AstBlock, Expr as AstExpr, MatchArm, MatchArms, Pattern, Type as AstType, TypeParam,
  WithClause,
} from frontend.syntax.Ast;
import { warn } from frontend.semantics.Failures;
import { BinaryOp, Pattern, unsignedWideValue, wideIntegerValue } from frontend.syntax.Ast;
import {
  E0105, E0400, E0406, E0410, E0605, E0700, E0701, E0702, E0703, E0704, E0705, E0706, E0800,
  E0802, E0803, E1001, coded,
} from support.Codes;
import {
  Kind, Op, TYPE_ATOM, TYPE_BOOL, TYPE_BYTES, TYPE_DYNAMIC, TYPE_I32, TYPE_I64, TYPE_OBJECT, auxOf,
  bindingNode, bytesId, bytesOf, declareBinding, endsPath,
  fieldCount, fieldType, innerOf, isEnum, isFloatType, isInteger, isKind, isLayout, isLinked,
  isObject, isRecord, local, memberCount, memberType, node, noValueType, nullable, nullType, opNode,
  opOf, recordField, resolve, segmentType, segmentWidth, stdNative, tupleType, typeArg,
  typeArgCount, typeName, typeOf, unify, variantCount, variantName, variantTag,
} from frontend.hir.Hir;
import type { Syntax } from frontend.syntax.Source;
import {
  checkSegmentLiteral, layoutField, layoutFits, layoutRecord, placeSegments, restOf, segmentCode,
} from frontend.semantics.Bits;
import { scopedType } from frontend.semantics.ModuleScope;
import {
  boolOf, expressionOf, i32Of, indexLoop, lengthTest, steppedWhile,
} from frontend.semantics.Derived;
import {
  equalValues, functionTest, isAnyFunction, kindTest, toDynamic,
} from frontend.semantics.Values;
import { namedKey, readTyped } from frontend.semantics.Objects;
import {
  branchMismatch, bufferHint, checkArm, joinBranches, checkKnown, checkOperand, checkPatternName,
  checkPresent, checkType, coerceTail, enterSyntax, floatLiteral, integerLiteral, joinTypes,
  newBinding, regexpGlobal, sizedType, checkAnnotated, coerceAt, currentSpan, declareGlobal,
  declareLocal, declareNames, endNames, linkedMember, objectValue, present, prototypeField,
  mayBeNull, presentAt, requireBool, subPattern, syntaxChild, syntaxPattern, testsPattern, unlift,
} from frontend.semantics.TypeCheck;

/** A match's subject. `roots` and `types` are its bindings and their types; one, or one per item
 * of a tuple-literal subject, whose tuple type is `tuple` (else -1). Checking the arms appends
 * further roots; one per regexp pattern that binds its match, and one per name that alternatives
 * share. `tag` binds the enum tag of a single root when the subject is an enum of several
 * variants and the match has several arms, or is -1. */
typedef Subject = {
  let roots: Array<I32>;
  let types: Array<I32>;
  let tuple: I32;
  let tag: I32;
};

// Returns a `Subject` with no roots yet, for the tests of a condition or a `with`.
let _noSubject = fn(): Subject {
  { roots: Array.new<I32>(0), types: Array.new<I32>(0), tuple: -1, tag: -1 }
};

// Returns a `Subject` whose one root is the binding `root`, of type `ty`.
let _rootSubject = fn(root: I32, ty: I32): Subject {
  { roots: [root], types: [ty], tuple: -1, tag: -1 }
};

/** Appends a fresh root of type `ty` to `subject`.
 * @return its index */
let _addRoot = fn(subject: Subject, ty: I32): I32 {
  subject.roots.push(newBinding());
  subject.types.push(ty);
  subject.roots.len() - 1
};

// A path step to the T of a Null<T> known to be present; its index is 0.
const _UNWRAP = -2;
// A path step to the value a Dynamic holds, known to be of the type in the step's index.
const _FROM_DYNAMIC = -3;
/** A path step to an array or list element known to exist; its index counts from the start, or,
 * in an array, from the end when negative, -1 being the last. */
const _ELEMENT = -4;
/** A path step to the items a bound spread spans; a fresh array or tuple, or a list's tail. Its
 * index is the number of items before the spread, and a second `_SLICE` step holds the number
 * after it. */
const _SLICE = -5;
/** A path step to a bits segment; its index is the segment's bit offset * 256 plus its code
 * (`frontend.semantics.Bits`). */
const _SEGMENT = -6;
// A path step to the bytes after a bits pattern's fixed segments; its index is their length.
const _REST = -7;
// A path step to the record of a bytes layout that bytes hold; its index is the layout's type.
const _LAYOUT = -8;
// A path step to an Object's field, known to be there; its index is the field's name.
const _KEY = -9;
/** A path step to a copy of an Object without the fields a pattern names; its index is their
 * names' entry in `_named`. */
const _WITHOUT = -10;
/** A path step to a field of a linked prototype's Object, read as its typedef declares; its index
 * is the field's name. */
const _LINKED = -11;
// By `_WITHOUT` step, the names of the fields an Object pattern names before its rest.
let _named = Array.new<Array<I32>>(0);

/** Returns `path` extended by one step. A path is a root index, or -1 for the tuple of all roots,
 * followed by (tag, field) steps into enum payloads, (-1, item) steps into tuples and records, and
 * `_UNWRAP`, `_FROM_DYNAMIC`, `_ELEMENT`, `_SLICE`, `_SEGMENT`, `_REST`, `_LAYOUT`, `_KEY`,
 * `_LINKED` and `_WITHOUT` steps. From -1, a step goes straight to root `index`, ignoring `tag`.
 * @param path  the path so far
 * @param tag  the variant's tag, -1 for a tuple item, or one of the steps named above
 * @param index  the field, item or element, the type a Dynamic holds, or a spread's extent
 * @return the extended path, a fresh array */
let _step = fn(path: Array<I32>, tag: I32, index: I32): Array<I32> {
  if (path[0] < 0) { return [index]; }
  let out = path.copy();
  out.push(tag);
  out.push(index);
  out
};

// Returns the T of `ty` when it is a Null<T>, which `null` and `is T` patterns match, or -1.
let _nullInner = fn(ty: I32): I32 {
  let t = resolve(ty);
  isKind(t, Kind.Null) ? innerOf(t) : -1
};

/** Returns a fresh array of the elements of `array` from index `before` up to `after` from its
 * end; a block that makes it at its length and copies each element. */
let _slice = fn(array: I32, before: I32, after: I32): I32 {
  let ty = typeOf(array);
  let element = innerOf(resolve(ty));
  let source = newBinding();
  let count = newBinding();
  let out = newBinding();
  let loop = indexLoop(fn() { local(count, TYPE_I32) });
  let at = fn(): I32 { local(loop.index, TYPE_I32) };
  let skipped = opNode(Op.Add, TYPE_I32, [at(), i32Of(before)]);
  let read = opNode(Op.ArrayGet, element, [local(source, ty), skipped]);
  let copy = opNode(Op.ArraySet, element, [local(out, ty), at(), read]);
  let length = opNode(Op.ArrayLen, TYPE_I32, [local(source, ty)]);
  let spanned = opNode(Op.Sub, TYPE_I32, [length, i32Of(before + after)]);
  node(Op.Block, ty, 0, 1, [
    declareBinding(Op.Const, source, "array", array),
    declareBinding(Op.Const, count, "count", spanned),
    declareBinding(Op.Const, out, "spread", opNode(Op.ArrayNew, ty, [local(count, TYPE_I32)])),
    loop.start,
    steppedWhile(loop.more, [expressionOf(copy)], [loop.next]),
    local(out, ty)
  ])
};

// Returns the list `value`, of type `ty`, without its first `count` elements, which exist.
let _drop = fn(value: I32, ty: I32, count: I32): I32 {
  let out = value;
  let i = 0;

  while (i < count) {
    out = opNode(Op.ListTail, ty, [out]);
    i++;
  }
  out
};

// Returns a copy of the Object `object` without the fields `names`, by their names' bytes.
let _without = fn(object: I32, names: Array<I32>): I32 {
  let copy = newBinding();
  let copied = opNode(Op.ObjectCopy, TYPE_OBJECT, [object]);
  let statements = [declareBinding(Op.Const, copy, "rest", copied)];

  for (name in names) {
    let key = node(Op.Atom, TYPE_ATOM, name, 0, []);
    let removed = opNode(Op.ObjectRemove, TYPE_BOOL, [local(copy, TYPE_OBJECT), key]);
    statements.push(expressionOf(removed));
  }
  statements.push(local(copy, TYPE_OBJECT));
  node(Op.Block, TYPE_OBJECT, 0, 1, statements)
};

/** Returns a fresh read of the value at `path` in `subject`, through `Op.TupleField`,
 * `Op.EnumField`, unchecked `Op.Unwrap`, `Op.FromDynamic`, `Op.ArrayGet`, `Op.ListHead` and
 * `Op.ListTail` nodes, or a fresh array or tuple of a spread's items. The path never starts at -1,
 * since only tuple patterns and `_` match the tuple of all roots. */
let _read = fn(subject: Subject, path: Array<I32>): I32 {
  let ty = subject.types[path[0]];
  let value = local(subject.roots[path[0]], ty);
  let i = 1;

  while (i < path.len()) {
    let tag = path[i];
    let index = path[i + 1];

    if (tag == _UNWRAP) {
      ty = _nullInner(ty);
      value = opNode(Op.Unwrap, ty, [value]);
    } else if (tag == _FROM_DYNAMIC) {
      ty = index;
      value = opNode(Op.FromDynamic, ty, [value]);
    } else if ((tag == _ELEMENT) && isKind(resolve(ty), Kind.List)) {
      value = _drop(value, ty, index);
      ty = innerOf(resolve(ty));
      value = opNode(Op.ListHead, ty, [value]);
    } else if (tag == _ELEMENT) {
      // An element counted from the end reads the array again for its length.
      let at = i32Of(index);

      if (index < 0) {
        let length = opNode(Op.ArrayLen, TYPE_I32, [_read(subject, path.slice(0, i))]);
        at = opNode(Op.Add, TYPE_I32, [length, at]);
      }
      ty = innerOf(resolve(ty));
      value = opNode(Op.ArrayGet, ty, [value, at]);
    } else if ((tag == _SLICE) && isKind(ty, Kind.Tuple)) {
      // Each item reads the tuple again.
      let items = Array.new<I32>(0);
      let types = Array.new<I32>(0);
      let prefix = path.slice(0, i);
      let item = index;

      while (item < typeArgCount(ty) - path[i + 3]) {
        types.push(typeArg(ty, item));
        let tuple = _read(subject, prefix);
        items.push(node(Op.TupleField, typeArg(ty, item), item, 0, [tuple]));
        item++;
      }
      ty = tupleType(types);
      value = opNode(Op.Tuple, ty, items);
      i += 2;
    } else if ((tag == _SLICE) && isKind(resolve(ty), Kind.List)) {
      value = _drop(value, ty, index);
      i += 2;
    } else if (tag == _SLICE) {
      value = _slice(value, index, path[i + 3]);
      i += 2;
    } else if (tag == _SEGMENT) {
      ty = segmentType(index % 256);
      value = node(Op.BitsRead, ty, index / 256, index % 256, [value]);
    } else if (tag == _REST) {
      // The rest reads the bytes again for their length.
      value = restOf(value, _read(subject, path.slice(0, i)), index);
    } else if (tag == _LAYOUT) {
      // A record's fields read the bytes again; a step to one field reads only that field.
      let bytes = path.slice(0, i);
      let read = fn(): I32 { _read(subject, bytes) };

      if ((i + 2 < path.len()) && (path[i + 2] == -1)) {
        ty = memberType(index, path[i + 3]);
        value = layoutField(index, path[i + 3], read);
        i += 2;
      } else {
        ty = index;
        value = layoutRecord(index, read);
      }
    } else if (tag == _KEY) {
      ty = TYPE_DYNAMIC;
      value = node(Op.ObjectGet, ty, index, 0, [value]);
    } else if (tag == _LINKED) {
      let name = bytesOf(index);
      ty = prototypeField(resolve(ty), name);
      value = readTyped(objectValue(value), namedKey(name), ty);
    } else if (tag == _WITHOUT) {
      value = _without(value, _named[index]);
    } else if (tag < 0) {
      ty = memberType(ty, index);
      value = node(Op.TupleField, ty, index, 0, [value]);
    } else {
      ty = fieldType(ty, tag, index);
      value = node(Op.EnumField, ty, index, tag, [value]);
    }
    i += 2;
  }
  value
};

/** Returns fresh reads of the values at `paths` in `subject`, each located at the pattern that
 * binds it.
 * @param places  each path's pattern syntax */
let _reads = fn(subject: Subject, paths: Array<Array<I32>>, places: Array<Syntax>): Array<I32> {
  let out = Array.new<I32>(0);

  for (i, path in paths) {
    let outer = enterSyntax(places[i]);
    out.push(_read(subject, path));
    enterSyntax(outer);
  }
  out
};

/** Rejects a pattern that cannot match a value of type `ty`.
 * @param what  the kind of pattern with its article, such as "a variant"
 * @throws a located error naming the pattern and the type, always */
let _mismatch = fn(what: Bytes, ty: I32): Bool {
  throw coded(E0703, `${what} pattern cannot match ${typeName(ty)}${bufferHint(ty)}`);
};

/** Returns the tag of variant `name` of `ty`, the matched value's type.
 * @throws a located error if `ty` is not an enum or has no such variant */
let _tagOf = fn(ty: I32, name: Bytes): I32 {
  if (!isEnum(ty)) { _mismatch("a variant", ty); }
  let tag = variantTag(ty, name);
  if (tag < 0) { throw coded(E0802, `unknown variant ${name} of ${typeName(ty)}`); }
  tag
};

// Returns the index of the first spread in `items` at or after `start`, or -1.
let _spreadIndex = fn(items: Array<Pattern>, start: I32): I32 {
  let i = start;

  while (i < items.len()) {
    if (let Spread(_) = items[i]) { return i; }
    i++;
  }
  -1
};
// Checks whether `pattern` is `null`.
let _isNull = fn(pattern: Pattern): Bool { match (pattern) { Null => true, _ => false } };

/** Returns the pattern a present T must match for `pattern`, which is not `null`, to match its
 * Null<T>; for `is T`, which tests only presence, the name it binds or `_`, and otherwise the
 * pattern itself. */
let _present = fn(pattern: Pattern): Pattern {
  match (pattern) {
    IsType(_, binding) => binding != null ? Pattern.BindPattern(binding) : Pattern.Wildcard,
    _ => pattern,
  }
};

/** Checks whether `pattern` may match a null of type Null<`inner`> without testing presence: `_`,
 * a name, `null`, and a pin or a constant, which compare as `==` does. */
let _takesNull = fn(pattern: Pattern, inner: I32): Bool {
  match (pattern) {
    Wildcard, BindPattern(_), Null, Pin(_) => true,
    // A bare name that is no variant is a constant.
    Enum(name, args) => (args.len() == 0) && !(isEnum(inner) && (variantTag(inner, name) >= 0)),
    _ => false,
  }
};
// Returns a fresh copy of `row` without its first column, for patterns and for their types.
let _tail<T> = fn(row: Array<T>): Array<T> { Array.new<T>(0).appendFrom(row, 1) };

/** Appends to `tests` a test that the value at `path` in `subject`, of type `ty`, equals `value`,
 * as `==` compares them. A Null<T> equals a value that cannot be null only when it is present.
 * @param what  how a diagnostic names the pattern, such as `^n`
 * @throws a located error if `value` is not of type `ty`, or of its T */
let _equalTo = fn(
  subject: Subject,
  path: Array<I32>,
  ty: I32,
  value: I32,
  what: Bytes,
  tests: Array<I32>
) {
  let inner = _nullInner(ty);
  let at = path;
  let against = ty;

  if ((inner >= 0) && (_nullInner(typeOf(value)) < 0)) {
    tests.push(opNode(Op.IsPresent, TYPE_BOOL, [_read(subject, path)]));
    at = _step(path, _UNWRAP, 0);
    against = inner;
  }

  if (!unify(typeOf(value), against)) {
    let given = `${what} is ${typeName(typeOf(value))}`;
    throw coded(E0703, `${given}, but the value it matches is ${typeName(against)}`);
  }
  tests.push(equalValues(BinaryOp.Equal, _read(subject, at), value));
  null
};

/** The names a pattern binds, the path of each one's value (`paths`), the pattern syntax that
 * binds it (`places`), and the names it pins (`pins`). */
typedef Bound = {
  let names: Array<Bytes>;
  let paths: Array<Array<I32>>;
  let places: Array<Syntax>;
  let pins: Array<Bytes>;
};

// Returns an empty `Bound`.
let _noBound = fn(): Bound {
  {
    names: Array.new<Bytes>(0),
    paths: Array.new<Array<I32>>(0),
    places: Array.new<Syntax>(0),
    pins: Array.new<Bytes>(0)
  }
};

/** Records in `bound` that a pattern binds `name` to the value at `path`.
 * @param place  the binding pattern's syntax
 * @throws if the pattern also pins `name`, or a located error if it binds `name` already */
let _bind = fn(bound: Bound, name: Bytes, path: Array<I32>, place: Syntax) {
  if (bound.pins.indexOf(name) >= 0) {
    throw coded(E0705, `cannot pin ${name}: this pattern binds it`);
  }

  if (bound.names.indexOf(name) >= 0) {
    enterSyntax(place);
    throw coded(E0704, `${name} is bound more than once in this pattern`);
  }
  bound.names.push(name);
  bound.paths.push(path);
  bound.places.push(place);
  null
};

// Returns fresh reads, in binding order, of the values the names in `bound` hold in `subject`.
let _boundReads = fn(subject: Subject, bound: Bound): Array<I32> {
  _reads(subject, bound.paths, bound.places)
};

/** Returns the diagnostic for enum variant `name`, which has `count` fields, written with `given`
 * arguments.
 * @param called  whether the variant is written with parentheses
 * @return the diagnostic */
export let payloadMismatch = fn(name: Bytes, count: I32, given: I32, called: Bool): Bytes {
  if (called && (count == 0)) {
    return coded(E0803, `${name} has no fields, so it is written without parentheses`);
  }
  let fields = `${count} ${count == 1 ? "field" : "fields"}`;

  if (!called) {
    return coded(E0803, `${name} has ${fields}, so it needs parentheses: ${name}(...)`);
  }
  coded(E0803, `${name} has ${fields}, not ${given}`)
};

/** Returns the index of the spread among `items`, an array or tuple pattern's, or -1.
 * @throws a located error at a second spread */
let _spreadOf = fn(items: Array<Pattern>, syntax: Syntax): I32 {
  let spread = _spreadIndex(items, 0);
  let again = spread < 0 ? -1 : _spreadIndex(items, spread + 1);

  if (again >= 0) {
    enterSyntax(subPattern(syntax, again));
    throw coded(E0704, "a pattern may spread only once");
  }
  spread
};

/** Appends the tests of the items of a tuple, array or list pattern, of type `ty`, and binds its
 * spread, at index `spread` or -1. An item after the spread counts from the end. */
let _items = fn(
  subject: Subject,
  items: Array<Pattern>,
  syntax: Syntax,
  path: Array<I32>,
  ty: I32,
  spread: I32,
  tests: Array<I32>,
  bound: Bound
) {
  let tuple = isKind(ty, Kind.Tuple);

  for (i, pattern in items) {
    let item = subPattern(syntax, i);
    let at = (spread < 0) || (i < spread) ? i : (tuple ? typeArgCount(ty) : 0) + i - items.len();

    match (pattern) {
      Spread(binding) => {
        if (binding != null) {
          let spanned = _step(_step(path, _SLICE, spread), _SLICE, items.len() - 1 - spread);
          _bind(bound, binding, spanned, item);
        }
        null
      },
      _ => {
        let step = _step(path, tuple ? -1 : _ELEMENT, at);
        let itemType = tuple ? typeArg(ty, at) : innerOf(resolve(ty));
        _test(subject, pattern, item, step, itemType, tests, bound);
        null
      },
    };
  }
  null
};

/** Appends to `tests`, in order, the Bool tests `pattern` makes of the value at `path`, and records
 * the names it binds in `bound`. A variant pattern tests the tag unless the enum has one variant,
 * and a capitalised name that is no variant compares with the constant it names, as a pin does
 * with its value; a regexp pattern that binds stores its match in a further root. On a Null<T>,
 * a pattern other than `_`, a name, `null`, a pin and a constant tests that the value is present
 * and then matches its T. The tests take the span of the pattern that makes them.
 * @param syntax  the pattern's syntax
 * @param path  the matched value's path
 * @param ty  the matched value's type
 * @param tests  the tests so far
 * @param bound  the names bound so far
 * @throws a located error if the pattern cannot match `ty`, has the wrong payload count, or is a
 *     kind of pattern that is not supported */
let _test = fn(
  subject: Subject,
  pattern: Pattern,
  syntax: Syntax,
  path: Array<I32>,
  ty: I32,
  tests: Array<I32>,
  bound: Bound
): Bool {
  let outer = enterSyntax(syntax);
  let present = _nullInner(ty);
  let inner = (present >= 0) && !_takesNull(pattern, present) ? present : -1;

  if (inner >= 0) {
    match (pattern) {
      IsType(written, _) when (isAnyFunction(written)) => {
        if (!isKind(resolve(inner), Kind.Function)) {
          throw coded(E0703, `is fn cannot match a value of type ${typeName(ty)}`);
        }
        null
      },
      IsType(written, _) => {
        let target = checkType(written);

        if (!unify(target, inner)) {
          let test = `is ${typeName(target)}`;
          throw coded(E0703, `${test} cannot match a value of type ${typeName(ty)}`);
        }
        null
      },
      _ => null,
    };
    tests.push(opNode(Op.IsPresent, TYPE_BOOL, [_read(subject, path)]));
    enterSyntax(outer);
    return _test(subject, _present(pattern), syntax, _step(path, _UNWRAP, 0), inner, tests, bound);
  }

  match (pattern) {
    Wildcard => null,
    BindPattern(name) => _bind(bound, name, path, syntax),
    // `H(p)` matches bytes that hold a record of the bytes layout H, which `p` matches.
    Enum(name, args) when ((resolve(ty) == TYPE_BYTES) && isLayout(scopedType(name))) => {
      let layout = scopedType(name);

      if (args.len() != 1) {
        let written = `the bytes layout pattern ${name}(…)`;
        throw coded(E0703, `${written} takes one pattern, for the record`);
      }
      tests.push(layoutFits(layout, opNode(Op.BytesLen, TYPE_I32, [_read(subject, path)])));
      let step = _step(path, _LAYOUT, layout);
      _test(subject, args[0], subPattern(syntax, 0), step, layout, tests, bound)
    },
    Enum(name, args) => {
      // A capitalised name that is no variant of the matched enum may be a constant.
      let known = isEnum(ty) ? variantTag(ty, name) : -1;
      let constant = ((known < 0) && (args.len() == 0)) ? checkPatternName(name, true) : -1;

      if (constant >= 0) {
        _equalTo(subject, path, ty, constant, name, tests);
      } else {
        // A Null<T> reaches here only with a name that is no variant of its T, named in the error.
        let tag = known >= 0 ? known : _tagOf(present >= 0 ? present : ty, name);
        let count = fieldCount(ty, tag);

        if (args.len() != count) {
          throw payloadMismatch(name, count, args.len(), args.len() != 0);
        }

        if (variantCount(ty) > 1) {
          let read = if ((path.len() == 1) && (subject.tag >= 0)) {
            local(subject.tag, TYPE_I32)
          } else {
            opNode(Op.EnumTag, TYPE_I32, [_read(subject, path)])
          };
          // Before the fields' tests, so that the lowering decides arms on the tag.
          tests.push(opNode(Op.Eq, TYPE_BOOL, [read, i32Of(tag)]));
        }

        for (f, arg in args) {
          let step = _step(path, tag, f);
          _test(subject, arg, subPattern(syntax, f), step, fieldType(ty, tag, f), tests, bound);
        }
      }
      null
    },
    Tuple(items) => {
      let spread = _spreadOf(items, syntax);
      let count = spread < 0 ? items.len() : items.len() - 1;

      if (!isKind(ty, Kind.Tuple) || ((spread < 0) && (typeArgCount(ty) != count))) {
        _mismatch(`a ${count}-item tuple`, ty);
      }

      if (typeArgCount(ty) < count) {
        let pattern = `a tuple pattern of ${count} or more items`;
        throw coded(E0703, `${pattern} cannot match ${typeName(ty)}`);
      }
      _items(subject, items, syntax, path, ty, spread, tests, bound)
    },
    Bool(value) => {
      if (ty != TYPE_BOOL) { _mismatch("a Bool", ty); }
      let read = _read(subject, path);
      tests.push(value ? read : opNode(Op.Not, TYPE_BOOL, [read]));
      null
    },
    Integer(digits, size) => {
      if (!isInteger(ty) || !unify(sizedType(size, ty), ty)) { _mismatch("an integer", ty); }
      let literal = integerLiteral(digits, false, ty);
      tests.push(opNode(Op.Eq, TYPE_BOOL, [_read(subject, path), literal]));
      null
    },
    Bytes(value) => {
      if (ty != TYPE_BYTES) { _mismatch("a string", ty); }
      let read = _read(subject, path);
      let literal = node(Op.Bytes, TYPE_BYTES, bytesId(value), 0, []);
      tests.push(opNode(Op.BytesEq, TYPE_BOOL, [read, literal]));
      null
    },
    RegExp(source, flags, binding) => {
      if (ty != TYPE_BYTES) { _mismatch("a regexp", ty); }
      let regexp = node(Op.Global, TYPE_DYNAMIC, regexpGlobal(source, flags), 0, []);
      let matchPrefix = stdNative("regexp_match_prefix", [TYPE_BYTES, TYPE_DYNAMIC], TYPE_DYNAMIC);
      let read = _read(subject, path);
      let found = node(Op.CallNative, TYPE_DYNAMIC, matchPrefix, 0, [read, regexp]);

      // The match is kept in a further root, which the arm binds.
      if (binding != null) {
        let root = _addRoot(subject, TYPE_DYNAMIC);
        found = node(Op.Assign, TYPE_DYNAMIC, subject.roots[root], 0, [found]);
        _bind(bound, binding, [root], syntax);
      }
      tests.push(opNode(Op.IsPresent, TYPE_BOOL, [found]));
      null
    },
    Float(literal, size) => {
      if (!isFloatType(resolve(ty))) { _mismatch("a float", ty); }
      _equalTo(subject, path, ty, floatLiteral(literal, size, false, ty), literal, tests)
    },
    Atom(name) => {
      if (resolve(ty) != TYPE_ATOM) { _mismatch("an atom", ty); }
      let atom = node(Op.Atom, TYPE_ATOM, bytesId(name), 0, []);
      _equalTo(subject, path, ty, atom, `:${name}`, tests)
    },
    // A name the pattern binds is not yet bound when the pattern is tested.
    Pin(name) => {
      if (bound.names.indexOf(name) >= 0) {
        throw coded(E0705, `cannot pin ${name}: this pattern binds it`);
      }
      bound.pins.push(name);
      _equalTo(subject, path, ty, checkPatternName(name, false), `^${name}`, tests)
    },
    Null => {
      if (_nullInner(ty) < 0) { _mismatch("a null", ty); }
      tests.push(opNode(Op.IsNull, TYPE_BOOL, [_read(subject, path)]));
      null
    },
    // A Null<T>'s `is T` is a presence test, made above.
    IsType(written, binding) => {
      if (resolve(ty) != TYPE_DYNAMIC) {
        throw coded(E0406, `is tests a Dynamic or nullable value, not ${typeName(ty)}`);
      }

      if (isAnyFunction(written)) {
        // A Dynamic function's signature is not known, so it cannot be bound and called.
        if (binding != null) {
          throw coded(E0406, "is fn binds no name, since it does not fix the function's type");
        }
        tests.push(functionTest(_read(subject, path)));
      } else {
        let target = checkType(written);
        tests.push(kindTest(_read(subject, path), target));

        if (binding != null) {
          _bind(bound, binding, _step(path, _FROM_DYNAMIC, target), syntax);
        }
      }
      null
    },
    Unquote(_) => { throw coded(E1001, "unquote is only allowed inside a quote"); },
    /* An array's length is tested once, before any element is read; a list is tested for each
     * cell it must have, and for its end when it has no spread. Only an array's bound spread
     * is copied. */
    Array(items) => {
      let linked = isKind(resolve(ty), Kind.List);
      if (!linked && !isKind(resolve(ty), Kind.Array)) { _mismatch("an array", ty); }
      let spread = _spreadOf(items, syntax);
      let count = spread < 0 ? items.len() : items.len() - 1;

      if (linked && (spread >= 0) && (spread < count)) {
        enterSyntax(subPattern(syntax, spread));
        throw coded(E0704, "a list pattern may spread only at its end");
      }

      if (linked) {
        let cell = 0;

        while (cell < count) {
          tests.push(opNode(Op.Not, TYPE_BOOL, [_ends(subject, path, ty, cell)]));
          cell++;
        }
        if (spread < 0) { tests.push(_ends(subject, path, ty, count)); }
      } else if ((spread < 0) || (count > 0)) {
        let length = opNode(Op.ArrayLen, TYPE_I32, [_read(subject, path)]);
        tests.push(lengthTest(length, count, spread >= 0));
      }
      _items(subject, items, syntax, path, ty, spread, tests, bound)
    },
    // The parser makes a spread only as an item, which the arms above take.
    Spread(_) => null,
    /* An Object pattern matches an Object that has every field it names, its own or one it
     * delegates to, each read as a Dynamic; a linked prototype's value has the fields its
     * typedef declares, of their types. */
    Object(fields) when (isObject(resolve(ty))) => {
      let names = Array.new<I32>(0);

      for (f, (name, field) in fields) {
        let at = subPattern(syntax, f);

        match (field) {
          Spread(binding) => {
            if (binding != null) {
              _named.push(names);
              _bind(bound, binding, _step(path, _WITHOUT, _named.len() - 1), at);
            }
            null
          },
          _ => {
            let id = bytesId(name);

            if (names.indexOf(id) >= 0) {
              enterSyntax(at);
              throw coded(E0704, `field ${name} is matched twice`);
            }
            names.push(id);
            let outer = enterSyntax(at);
            let linked = prototypeField(resolve(ty), name);
            enterSyntax(outer);

            if (linked >= 0) {
              _test(subject, field, at, _step(path, _LINKED, id), linked, tests, bound);
            } else {
              tests.push(node(Op.ObjectHas, TYPE_BOOL, id, 0, [_read(subject, path)]));
              _test(subject, field, at, _step(path, _KEY, id), TYPE_DYNAMIC, tests, bound);
            }
          },
        };
      }
      null
    },
    Object(fields) => {
      if (!isRecord(ty)) { _mismatch("an object", ty); }
      let matched = Array.new<Bool>(memberCount(ty));

      for (f, (name, field) in fields) {
        let index = recordField(ty, name);
        let at = subPattern(syntax, f);

        if (name == "...") {
          enterSyntax(at);
          let named = "a record pattern names its fields";
          throw coded(E0703, `${named}; ${typeName(ty)} has no rest`);
        }

        if (index < 0) {
          enterSyntax(at);
          throw coded(E0800, `${typeName(ty)} has no field ${name}`);
        }

        if (matched[index]) {
          enterSyntax(at);
          throw coded(E0704, `field ${name} is matched twice`);
        }
        matched[index] = true;
        let step = _step(path, -1, index);
        _test(subject, field, at, step, memberType(ty, index), tests, bound);
      }
      null
    },
    // The length is tested before any segment is read.
    Bits(segments) => {
      if (resolve(ty) != TYPE_BYTES) { _mismatch("a bits", ty); }
      let codes = Array.new<I32>(0);

      for ({ width, endian, kind } in segments) {
        codes.push(segmentCode(width, endian, kind));
      }
      let (offsets, fixed) = placeSegments(codes);
      let rest = (codes.len() > 0) && (segmentWidth(codes[codes.len() - 1]) == 0);
      let length = opNode(Op.BytesLen, TYPE_I32, [_read(subject, path)]);
      tests.push(lengthTest(length, fixed, rest));

      for (s, { signed, value: segment } in segments) {
        let at = subPattern(syntax, s);

        if (let Integer(digits, _) = segment) {
          enterSyntax(at);
          checkSegmentLiteral(codes[s], signed, digits, false);
          enterSyntax(syntax);
        }

        let step = if (segmentWidth(codes[s]) == 0) {
          _step(path, _REST, fixed)
        } else {
          _step(path, _SEGMENT, offsets[s] * 256 + codes[s])
        };
        _test(subject, segment, at, step, segmentType(codes[s]), tests, bound);
      }
      null
    },
  };
  enterSyntax(outer);
  true
};

// Returns a test that the list at `path`, of type `ty`, ends after `cell` cells.
let _ends = fn(subject: Subject, path: Array<I32>, ty: I32, cell: I32): I32 {
  opNode(Op.ListIsNil, TYPE_BOOL, [_drop(_read(subject, path), ty, cell)])
};

// Returns how a diagnostic names `pattern`, with payloads and tuple items elided as `(…)`.
let _describe = fn(pattern: Pattern): Bytes {
  match (pattern) {
    Wildcard => "_",
    BindPattern(name) => name,
    Enum(name, args) => args.len() == 0 ? name : `${name}(…)`,
    Tuple(_) => "(…)",
    Object(_) => "{…}",
    Bits(_) => "bits[…]",
    Array(items) => `[${items.map(_describe).join(", ")}]`,
    Spread(binding) => `...${binding ?? "_"}`,
    Bool(value) => value ? "true" : "false",
    Integer(digits, _) => digits,
    Float(literal, _) => literal,
    Atom(name) => `:${name}`,
    Pin(name) => `^${name}`,
    Null => "null",
    IsType(written, _) => `is ${isAnyFunction(written) ? "fn" : typeName(checkType(written))}`,
    Bytes(value) => `"${value}"`,
    RegExp(source, flags, _) => `~r/${source}/${flags}`,
    Unquote(_) => "unquote(…)",
  }
};

/** Checks whether `pattern` matches every value without a test; `_`, a name, or an Object
 * pattern that names no field. */
let _wild = fn(pattern: Pattern): Bool {
  match (pattern) {
    Wildcard, BindPattern(_) => true,
    Object(fields) => (fields.len() == 0) || ((fields.len() == 1) && (fields[0].0 == "...")),
    _ => false,
  }
};

// Returns the bits of an integer pattern's `text`; a U64 one may exceed the greatest I64.
let _bits = fn(text: Bytes): I64 {
  Bytes.get_u8(text, 0) == "-".code ? wideIntegerValue(text, false) : unsignedWideValue(text, false)
};

/** Checks whether patterns `a` and `b` of one column, neither wild, have the same head
 * constructor. Integers compare by value, floats by their text, atoms and constants by name, and
 * type tests by type; tuples, and nulls, always share one. A regexp or a pin shares one with
 * nothing, since it may fail for any subject; a guard between two pins may assign the pinned
 * name. */
let _same = fn(a: Pattern, b: Pattern): Bool {
  match ((a, b)) {
    (Enum(x, _), Enum(y, _)) => x == y,
    (Bool(x), Bool(y)) => x == y,
    (Integer(x, _), Integer(y, _)) => _bits(x) == _bits(y),
    (Float(x, _), Float(y, _)) => x == y,
    (Bytes(x), Bytes(y)) => x == y,
    (Atom(x), Atom(y)) => x == y,
    (IsType(x, _), IsType(y, _)) => if (isAnyFunction(x) || isAnyFunction(y)) {
      isAnyFunction(x) && isAnyFunction(y)
    } else {
      checkType(x) == checkType(y)
    },
    (Null, Null), (Tuple(_), Tuple(_)) => true,
    _ => false,
  }
};

/** Returns the sub-patterns of `head`, which is not wild and has no spread; a variant's payloads,
 * a tuple's items or an array's elements.
 * @return the sub-patterns, none for a literal */
let _args = fn(head: Pattern): Array<Pattern> {
  match (head) {
    Enum(_, args) => args,
    Tuple(items), Array(items) => items,
    _ => Array.new<Pattern>(0),
  }
};

/** Returns the number of sub-patterns of constructor `head`; for an array, of its elements other
 * than its spread. */
let _arity = fn(head: Pattern): I32 {
  match (head) {
    Array(items) => items.len() - (_spreadIndex(items, 0) >= 0 ? 1 : 0),
    _ => _args(head).len(),
  }
};

/** Returns the types of the sub-patterns of constructor `head`, of type `ty`; the payload field
 * types, a bytes layout's record type, the tuple item types or the array's element type. */
let _argTypes = fn(head: Pattern, ty: I32): Array<I32> {
  if (let Enum(name, _) = head) {
    if ((resolve(ty) == TYPE_BYTES) && isLayout(scopedType(name))) { return [scopedType(name)]; }
  }
  let out = Array.new<I32>(0);
  let i = 0;
  let count = _arity(head);

  while (i < count) {
    out.push(match (head) {
      Enum(name, _) => fieldType(ty, variantTag(ty, name), i),
      Array(_) => innerOf(resolve(ty)),
      _ => memberType(ty, i),
    });
    i++;
  }
  out
};

// Returns `count` wildcard patterns.
let _wilds = fn(count: I32): Array<Pattern> {
  let out = Array.new<Pattern>(0);
  while (out.len() < count) { out.push(Pattern.Wildcard); }
  out
};

/** Returns a fresh array of `front` followed by `row` without its first column, for patterns and
 * for their types. */
let _join<T> = fn(front: Array<T>, row: Array<T>): Array<T> {
  front.copy().appendFrom(row, 1)
};

/** Returns the sub-patterns by which `pattern` matches constructor `head`, or null if it cannot;
 * wildcards for a wild pattern, and for an array or tuple, its items with wildcards for those its
 * spread spans, as many as `head` has.
 * @param head  the constructor, as a pattern that is not wild; for an array, a length
 *     (`_lengths`) */
let _cut = fn(pattern: Pattern, head: Pattern): ?Array<Pattern> {
  if (_wild(pattern)) { return _wilds(_arity(head)); }

  match ((pattern, head)) {
    (Array(items), Array(cells)), (Tuple(items), Tuple(cells)) => {
      let width = _arity(head);
      let open = width < cells.len();
      let spread = _spreadIndex(items, 0);
      if (spread < 0) { return !open && (items.len() == width) ? items : null; }
      if (!open && (items.len() - 1 > width)) { return null; }
      let spanned = items.slice(0, spread).appendFrom(_wilds(width - items.len() + 1), 0);
      spanned.appendFrom(items, spread + 1)
    },
    _ => _same(pattern, head) ? _args(pattern) : null,
  }
};

/** Returns `rows` specialised by `head`'s constructor; the rows whose first column matches it,
 * with the sub-patterns `_cut` gives in place of that column.
 * @param head  the constructor, as a pattern that is not wild */
let _specialize = fn(rows: Array<Array<Pattern>>, head: Pattern): Array<Array<Pattern>> {
  let out = Array.new<Array<Pattern>>(0);

  for (row in rows) {
    let cut = _cut(row[0], head);
    if (cut != null) { out.push(_join(cut, row)); }
  }
  out
};

// Returns the greater of `a` and `b`.
let _max = fn(a: I32, b: I32): I32 { a > b ? a : b };

// Returns the first column of `rows`, a fresh array.
let _column = fn(rows: Array<Array<Pattern>>): Array<Pattern> {
  let out = Array.new<Pattern>(0);
  while (out.len() < rows.len()) { out.push(rows[out.len()][0]); }
  out
};

// Checks whether `ty` is an Array or a List, whose patterns match by length.
let _sequence = fn(ty: I32): Bool {
  let t = resolve(ty);
  isKind(t, Kind.Array) || isKind(t, Kind.List)
};

/** Returns the constructors of an array or list column, as arrays of wildcards; one per length
 * below the least that every pattern of the column treats alike, and a spread for the longer ones,
 * with as many elements, the last as many as the most any pattern names after its spread. These
 * are the slice constructors of rustc's exhaustiveness check.
 * @param column  the column's patterns */
let _lengths = fn(column: Array<Pattern>): Array<Pattern> {
  let fixed = -1;
  let before = 0;
  let after = 0;

  for (pattern in column) {
    if (let Array(items) = pattern) {
      let spread = _spreadIndex(items, 0);

      if (spread < 0) {
        fixed = _max(fixed, items.len());
      } else {
        before = _max(before, spread);
        after = _max(after, items.len() - 1 - spread);
      }
    }
  }
  let longest = _max(fixed + 1, before + after);
  let out = Array.new<Pattern>(0);
  while (out.len() < longest) { out.push(Pattern.Array(_wilds(out.len()))); }
  let spread = _wilds(longest - after);
  spread.push(Pattern.Spread(null));
  out.push(Pattern.Array(spread.appendFrom(_wilds(after), 0)));
  out
};

/** Returns every constructor of `ty`, each with wild arguments; both Bools, the one of a tuple,
 * every variant of an enum, or the lengths of an array or list (`_lengths`) that the first column
 * of `rows` tells apart. A type whose values cannot be listed has none. */
let _constructors = fn(rows: Array<Array<Pattern>>, ty: I32): Array<Pattern> {
  if (ty == TYPE_BOOL) { return [Pattern.Bool(false), Pattern.Bool(true)]; }
  if (isKind(ty, Kind.Tuple) || isRecord(ty)) { return [Pattern.Tuple(_wilds(memberCount(ty)))]; }
  if (_sequence(ty)) { return _lengths(_column(rows)); }
  let all = Array.new<Pattern>(0);
  let tag = 0;

  while (isEnum(ty) && (tag < variantCount(ty))) {
    all.push(Pattern.Enum(variantName(ty, tag), _wilds(fieldCount(ty, tag))));
    tag++;
  }
  all
};

/** Returns the constructors of `ty` when the first column of `rows` names them all; an array's and
 * a list's always, and otherwise none.
 * @param rows  the pattern rows
 * @param ty  the first column's type
 * @return the constructors, or none if the signature is incomplete */
let _signature = fn(rows: Array<Array<Pattern>>, ty: I32): Array<Pattern> {
  let all = _constructors(rows, ty);
  if (_sequence(ty)) { return all; }

  /* A tuple's or record's one constructor counts only when a pattern names it, which keeps a
   * record that holds itself finite. */
  for (head in all) {
    let r = 0;
    let seen = false;

    while (!seen && (r < rows.len())) {
      seen = !_wild(rows[r][0]) && _same(rows[r][0], head);
      r++;
    }
    if (!seen) { return Array.new<Pattern>(0); }
  }
  all
};

/** Returns `pattern`, of record type `ty`, as the tuple pattern of the record's fields in order, a
 * field it does not name being `_`; any other pattern is itself. */
let _fieldItems = fn(pattern: Pattern, ty: I32): Pattern {
  match (pattern) {
    Object(fields) => {
      let items = _wilds(memberCount(ty));

      for ((name, field) in fields) {
        items[recordField(ty, name)] = field;
      }
      Pattern.Tuple(items)
    },
    _ => pattern,
  }
};

/** Returns `pattern`, of a linked prototype's type `ty`, as `_` when it tests nothing; an Object
 * pattern whose fields are linked typedef fields bound by `_wild` patterns, or a rest. */
let _linkedItems = fn(pattern: Pattern, ty: I32): Pattern {
  match (pattern) {
    Object(fields) => {
      for ((name, field) in fields) {
        let tested = match (field) {
          Spread(_) => false,
          _ => !_wild(field) || (linkedMember(ty, name).0 < 0),
        };
        if (tested) { return pattern; }
      }
      Pattern.Wildcard
    },
    _ => pattern,
  }
};

/** Returns `rows` with each first-column pattern as `_fieldItems` gives it when the column's type
 * `ty` is a record, or `_linkedItems` when it is a linked prototype's, or else `rows` itself. */
let _recordRows = fn(rows: Array<Array<Pattern>>, ty: I32): Array<Array<Pattern>> {
  if (!isRecord(ty) && !isLinked(ty)) { return rows; }
  let out = Array.new<Array<Pattern>>(0);

  for (row in rows) {
    let head = row[0];
    let items = isRecord(ty) ? _fieldItems(head, ty) : _linkedItems(head, ty);
    out.push(_join([items], row));
  }
  out
};

/** Checks whether the pattern row `row` is useful with respect to the earlier rows `given`; whether
 * some value matches `row` but no row of `given` (Maranget, "Warnings for pattern matching"). The
 * patterns are already checked against their column types, and `types` holds the type of each
 * column. A record pattern matches as the tuple of its fields (`_fieldItems`). */
let _useful = fn(given: Array<Array<Pattern>>, row: Array<Pattern>, types: Array<I32>): Bool {
  if (row.len() == 0) { return given.len() == 0; }
  let ty = types[0];
  if (_nullInner(ty) >= 0) { return _usefulNullable(given, row, types); }
  let rows = _recordRows(given, ty);
  let q = _recordRows([row], ty)[0];

  let spreads = match (q[0]) {
    Array(items), Tuple(items) => _spreadIndex(items, 0) >= 0,
    _ => false,
  };

  if (!_wild(q[0]) && !spreads) {
    let specialized = _specialize(rows, q[0]);
    return _useful(specialized, _join(_args(q[0]), q), _join(_argTypes(q[0], ty), types));
  }
  // A wild `q`, or an array or tuple with a spread, tries each constructor it matches.
  let heads = _signature(rows, ty);

  if (spreads && _sequence(ty)) {
    let column = _column(rows);
    column.push(q[0]);
    heads = _lengths(column);
  }

  for (head in heads) {
    let cut = _cut(q[0], head);

    if (cut != null) {
      let specialized = _specialize(rows, head);

      if (_useful(specialized, _join(cut, q), _join(_argTypes(head, ty), types))) {
        return true;
      }
    }
  }
  if (heads.len() > 0) { return false; }
  // Some constructor is missing from the first column, so only its wild rows can match it.
  let rest = Array.new<Array<Pattern>>(0);

  for (other in rows) {
    if (_wild(other[0])) { rest.push(_tail(other)); }
  }
  _useful(rest, _tail(q), _tail(types))
};

/** Checks `_useful` for a first column of a Null<T> type, whose constructors are `null` and a
 * present T. A present T's one argument is the pattern itself, or its name or `_` for `is T`. */
let _usefulNullable = fn(rows: Array<Array<Pattern>>, q: Array<Pattern>, types: Array<I32>): Bool {
  if (!_isNull(q[0])) {
    let presents = Array.new<Array<Pattern>>(0);

    for (row in rows) {
      if (!_isNull(row[0])) { presents.push(_join([_present(row[0])], row)); }
    }
    let present = _join([_present(q[0])], q);
    if (_useful(presents, present, _join([_nullInner(types[0])], types))) { return true; }
  }
  if (!_takesNull(q[0], _nullInner(types[0]))) { return false; }
  _useful(_specialize(rows, Pattern.Null), _tail(q), _tail(types))
};

/** Returns how a diagnostic names a value that no row of `rows` matches, given that the wildcard
 * is useful against them: the first missing case, `null` for a Null<T> or a constructor
 * (`_constructors`) of any type but a tuple, or else `_`.
 * @param rows  the unguarded patterns, as one-column rows
 * @param ty  the matched value's type */
let _missing = fn(rows: Array<Array<Pattern>>, ty: I32): Bytes {
  let inner = _nullInner(ty);
  let base = inner >= 0 ? inner : ty;
  let cases = inner >= 0 ? [Pattern.Null] : Array.new<Pattern>(0);

  if (!isKind(base, Kind.Tuple) && !isRecord(base)) {
    cases.appendFrom(_constructors(rows, base), 0);
  }

  for (candidate in cases) {
    if (_useful(rows, [candidate], [ty])) { return _describe(candidate); }
  }
  "_"
};

/** Rejects a non-exhaustive match, given that the wildcard is useful against `rows`.
 * @param rows  the unguarded patterns, as one-column rows
 * @param ty  the subject's type
 * @throws a located error naming the case `_missing` finds, or asking for a `_` arm */
let _notExhaustive = fn(rows: Array<Array<Pattern>>, ty: I32): Bool {
  let missing = _missing(rows, ty);
  let advice = missing == "_" ? "add a `_` arm" : `missing ${missing}`;
  throw coded(E0700, `match is not exhaustive: ${advice}`);
};

/** Joins `tests`, left-associated, by the short-circuit `op`.
 * @param op  `Op.And` or `Op.Or`
 * @param tests  the Bool tests
 * @param value  the result when there are no tests
 * @return the joined test, or a Bool constant */
let _fold = fn(op: Op, tests: Array<I32>, value: Bool): I32 {
  if (tests.len() == 0) { return boolOf(value); }
  let out = tests[0];
  let i = 1;

  while (i < tests.len()) {
    out = opNode(op, TYPE_BOOL, [out, tests[i]]);
    i++;
  }
  out
};

/** Returns the subject of a match of `value` with `arms` arms, bound once, and its tag too when
 * several arms test an enum's variants.
 * @param children  the match block's statements, to which the bindings are appended */
let _valueSubject = fn(value: I32, arms: I32, children: Array<I32>): Subject {
  let ty = typeOf(value);
  let binding = newBinding();
  children.push(declareBinding(Op.Const, binding, "match", value));
  let tag = -1;

  if (isEnum(ty) && (variantCount(ty) > 1) && (arms > 1)) {
    tag = newBinding();
    let read = opNode(Op.EnumTag, TYPE_I32, [local(binding, ty)]);
    children.push(declareBinding(Op.Const, tag, "match.tag", read));
  }
  { roots: [binding], types: [ty], tuple: -1, tag }
};

/** Binds the subject once, as a Null<T> converted to its T unless some alternative is `null` or
 * `is T`, or binds each item of a tuple literal that every alternative matches with a tuple
 * pattern of its length or `_`. Also binds the enum tag when the subject is an enum of several
 * variants and there are several arms.
 * @param subject  the subject, syntax child 0
 * @param arms  the arms
 * @param children  the match block's statements, to which the declarations are appended
 * @return the `Subject` that records the bindings */
let _subject = fn(subject: AstExpr, arms: Array<MatchArm>, children: Array<I32>): Subject {
  let items = match (subject) { Tuple(items) => items, _ => Array.new<AstExpr>(0) };
  let fits = items.len() > 0;
  let aware = false;

  for ({ alternatives } in arms) {
    for ({ pattern } in alternatives) {
      fits = fits && match (pattern) {
        Tuple(patterns) => (patterns.len() == items.len()) && (_spreadIndex(patterns, 0) < 0),
        Wildcard => true,
        _ => false,
      };
      aware = aware || match (pattern) { Null, IsType(_, _) => true, _ => false };
    }
  }
  let roots = Array.new<I32>(0);
  let types = Array.new<I32>(0);

  if (fits) {
    let outer = enterSyntax(syntaxChild(0));

    for (i, item in items) {
      let value = checkOperand(item, i, -1);
      let binding = newBinding();
      children.push(declareBinding(Op.Const, binding, "match", value));
      roots.push(binding);
      types.push(typeOf(value));
    }
    enterSyntax(outer);
    return { roots, types, tuple: tupleType(types), tag: -1 };
  }
  _valueSubject(aware ? checkKnown(subject, 0) : checkPresent(subject, 0), arms.len(), children)
};

/** Returns the bindings of the roots of `subject` from `first` on, the ones checking the arms
 * appended; the regexp matches that arms bind, and the names that alternatives share. Each is a
 * mutable binding, null (or nil, for a list) until an arm's tests assign it.
 * @param first  the first root to bind */
let _matchBindings = fn(subject: Subject, first: I32): Array<I32> {
  let bindings = Array.new<I32>(0);
  let r = first;

  while (r < subject.roots.len()) {
    let ty = subject.types[r];
    let empty = opNode(isKind(ty, Kind.List) ? Op.ListNil : Op.Null, ty, []);
    bindings.push(bindingNode(Op.Let, subject.roots[r], "match.bound", empty));
    r++;
  }
  bindings
};

/** Declares the roots of `subject` from `first` on, as `_matchBindings` binds them.
 * @param children  the match block's statements, to which the declarations are appended */
let _declareMatches = fn(subject: Subject, first: I32, children: Array<I32>) {
  let bindings = _matchBindings(subject, first);

  for (binding in bindings) {
    children.push(opNode(Op.Declare, 0, [binding]));
  }
  null
};

/** Returns the type of a root that holds a name that alternatives share, given the name's type
 * `ty`; Null<`ty`>, or `ty` itself for a list, which is never nullable. */
let _rootType = fn(ty: I32): I32 { isKind(ty, Kind.List) ? ty : nullType(ty) };

/** Appends a root to `subject` for each name that alternatives share. Those alternatives bind the
 * same names, each from its own place, so each name is stored in a root of its own.
 * @param values  the first alternative's reads of the names
 * @return the indexes of the roots */
let _alternativeRoots = fn(subject: Subject, values: Array<I32>): Array<I32> {
  let out = Array.new<I32>(0);

  for (value in values) {
    out.push(_addRoot(subject, _rootType(typeOf(value))));
  }
  out
};

// The names that alternatives sharing a body bind, their types, and the indexes of their roots.
typedef Group = {
  let names: Array<Bytes>;
  let types: Array<I32>;
  let roots: Array<I32>;
};

// Returns an empty `Group`, for an arm with one alternative.
let _noGroup = fn(): Group {
  { names: Array.new<Bytes>(0), types: Array.new<I32>(0), roots: Array.new<I32>(0) }
};

/** Returns a Bool block that stores `value` in root `root` of `subject` and holds;
 * `{ root = value; true }`. A value is lifted with `Op.Present` when the root is a Null<T>. */
let _store = fn(subject: Subject, root: I32, value: I32): I32 {
  let ty = subject.types[root];
  let stored = typeOf(value) == ty ? value : opNode(Op.Present, ty, [value]);
  let assign = expressionOf(node(Op.Assign, ty, subject.roots[root], 0, [stored]));
  node(Op.Block, TYPE_BOOL, 0, 1, [assign, boolOf(true)])
};

/** Appends to `tests` the stores of the names an alternative binds into its group's roots. The
 * first alternative of a body makes the group; every alternative must bind the same names, with
 * types that unify.
 * @param subject  the match's subject
 * @param current  the group so far
 * @param first  whether this is the body's first alternative
 * @param bound  the names the alternative binds
 * @param tests  the alternative's tests
 * @return the group
 * @throws a located error if a name is not bound by every alternative or has a different type
 *     in each */
let _bindAlternative = fn(
  subject: Subject,
  current: Group,
  first: Bool,
  bound: Bound,
  tests: Array<I32>
): Group {
  let names = bound.names;
  let values = _boundReads(subject, bound);
  let group = current;

  if (first) {
    group = { names, types: values.map(typeOf), roots: _alternativeRoots(subject, values) };
  }

  for (name in names) {
    if (group.names.indexOf(name) < 0) {
      throw coded(E0704, `${name} must be bound by every alternative`);
    }
  }

  for (g, name in group.names) {
    let k = names.indexOf(name);
    if (k < 0) { throw coded(E0704, `${name} must be bound by every alternative`); }
    let ty = group.types[g];
    let found = typeOf(values[k]);

    if (!unify(found, ty)) {
      let differs = `${name} has a different type in each alternative`;
      throw coded(E0704, `${differs}: ${typeName(ty)} and ${typeName(found)}`);
    }
    tests.push(_store(subject, group.roots[g], values[k]));
  }
  group
};

/** Returns reads, in the group's order, of the values of `group`'s names in its roots in
 * `subject`. They are stored before any guard or body runs, so a Null<T> root is read with an
 * unchecked `Op.Unwrap`. */
let _stored = fn(subject: Subject, group: Group): Array<I32> {
  let out = Array.new<I32>(0);

  for (g, root in group.roots) {
    let value = _read(subject, [root]);
    let ty = group.types[g];
    out.push(typeOf(value) == ty ? value : opNode(Op.Unwrap, ty, [value]));
  }
  out
};

/** Checks an alternative's pattern; appends its tests to `tests` and records the names it binds in
 * `bound` (`_test`), then requires the pattern to be useful.
 * @param syntax  the pattern's syntax
 * @param path  the subject's path
 * @param ty  the subject's type
 * @param rows  the earlier unguarded patterns, as one-column rows
 * @param tests  the alternative's tests
 * @param bound  the names it binds
 * @throws a located error if earlier arms already match every value the pattern does */
let _armPattern = fn(
  subject: Subject,
  pattern: Pattern,
  syntax: Syntax,
  path: Array<I32>,
  ty: I32,
  rows: Array<Array<Pattern>>,
  tests: Array<I32>,
  bound: Bound
) {
  _test(subject, pattern, syntax, path, ty, tests, bound);

  if (!_useful(rows, [pattern], [ty])) {
    throw coded(E0701, `unreachable match arm: earlier arms already match ${_describe(pattern)}`);
  }
  null
};

/** Checks an arm's body with the names its pattern binds. Without an `expected` type, a later arm
 * of a value match takes its context from the earlier arms' `resultType`, as Null<T> so that a
 * nullable arm is joined, not unwrapped (`A => [1], _ => []`); the lift that context gives a T tail
 * is then removed. A list's type is used as itself, since a list is never nullable.
 * @param names  the names the body sees
 * @param values  their values
 * @param body  the body
 * @param index  the syntax child of its first statement
 * @param expected  the type the match's context requires, or -1 for none
 * @param resultType  the earlier arms' joined type, or -1
 * @param statement  whether the match is a statement
 * @return the arm's block
 * @throws a located error if a value match's arm has no trailing expression */
let _armBody = fn(
  names: Array<Bytes>,
  values: Array<I32>,
  body: AstBlock,
  index: I32,
  expected: I32,
  resultType: I32,
  statement: Bool
): I32 {
  let { statements, tail } = body;
  let joins = (expected < 0) && (resultType >= 0) && !statement;
  // As an `if`'s else branch does (`TypeCheck._checkIf`), a later arm lifts only what may be null.
  let lifts = joins && !isKind(resultType, Kind.List) && (tail != null) && mayBeNull(tail);
  let context = lifts ? nullable(resultType) : joins && (tail != null) ? resultType : expected;
  let block = checkArm(names, values, statements, tail, index, context, statement);
  if (lifts) { block = unlift(block); }

  if (!statement && (auxOf(block) == 0) && !endsPath(block)) {
    throw coded(E0410, "match arm requires a trailing expression");
  }
  block
};

/** Returns fresh reads of the names a guard or body sees; the group's stored values when its
 * alternatives share them, else the values the pattern bound.
 * @param shared  whether the arm has several alternatives
 * @param group  their group
 * @param bound  the names the pattern bound */
let _armReads = fn(subject: Subject, shared: Bool, group: Group, bound: Bound): Array<I32> {
  shared ? _stored(subject, group) : _boundReads(subject, bound)
};

/** Checks a guard, with the names its pattern binds, as a Bool test.
 * @param names  the names the guard sees
 * @param values  their values
 * @param guard  the guard expression
 * @param index  its syntax child
 * @return the guard's block
 * @throws a located error if the guard is not a Bool */
let _guard = fn(names: Array<Bytes>, values: Array<I32>, guard: ?AstExpr, index: I32): I32 {
  let block = checkArm(names, values, [], guard, index, TYPE_BOOL, false);

  if (typeOf(block) != TYPE_BOOL) {
    enterSyntax(syntaxChild(index));
    throw coded(E0400, "match guard must be a Bool");
  }
  block
};

/** Checks the arms of a match of `checked`, whose bindings `children` already holds, as
 * `checkMatch` describes; the arms' syntax children start at `first`, and their patterns at
 * `firstPattern`.
 * @return the match block */
let _matchArms = fn(
  checked: Subject,
  arms: Array<MatchArm>,
  first: I32,
  firstPattern: I32,
  expected: I32,
  statement: Bool,
  children: Array<I32>
): I32 {
  let subjectRoots = checked.roots.len();
  let ty = checked.tuple >= 0 ? checked.tuple : checked.types[0];
  let top = checked.tuple >= 0 ? [-1] : [0];
  // The unguarded patterns so far, as one-column rows.
  let rows = Array.new<Array<Pattern>>(0);
  /* Each arm's condition, checked body, and its tail's syntax index; and whether the latest arm's
   * condition has effects, which matters only for the last arm. */
  let conditions = Array.new<I32>(0);
  let bodies = Array.new<I32>(0);
  let tails = Array.new<I32>(0);
  let effects = false;
  let resultType = -1;
  let index = first;
  let patternIndex = firstPattern;

  for ({ alternatives, guard, body } in arms) {
    /* Alternatives that share the body store what they bind into `group`'s roots as they test
     * (`tested`), and the body reads them there; `last` is the last alternative's tests, and
     * `bound` what it binds. */
    let shared = alternatives.len() > 1;
    let group = _noGroup();
    let bound = _noBound();
    let firstRow = rows.len();
    let tested = Array.new<I32>(0);
    let last = Array.new<I32>(0);
    let ownGuard = false;

    for (j, { pattern, guard: own } in alternatives) {
      // The pattern's errors, tests and stores are located at the pattern.
      let place = syntaxPattern(patternIndex);
      let outer = enterSyntax(place);
      patternIndex++;
      let tests = Array.new<I32>(0);
      bound = _noBound();
      _armPattern(checked, pattern, place, top, ty, rows, tests, bound);
      if (shared) { group = _bindAlternative(checked, group, j == 0, bound, tests); }
      enterSyntax(outer);

      /* An alternative's own guard applies to that alternative only, so a guarded one
       * covers no row. */
      if (own == null) {
        rows.push([pattern]);
      } else {
        ownGuard = true;
        tests.push(_guard(bound.names, _boundReads(checked, bound), own, index));
        index++;
      }
      if (shared) { tested.push(_fold(Op.And, tests, true)); }
      last = tests;
    }
    /* The arm's guard follows all of its alternatives, which then count as covering no value,
     * and sees the names of the one that matched, as the body does, through fresh reads. */
    let names = bound.names;
    let tests = last;

    if (shared) {
      names = group.names;
      tests = [_fold(Op.Or, tested, false)];
    }

    if (guard != null) {
      Array.resize(rows, firstRow);
      tests.push(_guard(names, _armReads(checked, shared, group, bound), guard, index));
      index++;
    }
    conditions.push(_fold(Op.And, tests, true));
    let reads = _armReads(checked, shared, group, bound);
    let block = _armBody(names, reads, body, index, expected, resultType, statement);
    let { statements, tail } = body;
    let count = statements.len() + (tail == null ? 0 : 1);

    // An arm that ends every path gives no value, so it takes no part in the join.
    if (!statement && !endsPath(block)) {
      // Arms join like if branches; T, null and Null<T> give Null<T>.
      let found = typeOf(block);
      let joined = resultType < 0 ? found : joinTypes(resultType, found);

      if (joined < 0) {
        let at = count == 0 ? -1 : index + count - 1;
        throw branchMismatch("match arms", resultType, found, at);
      }
      resultType = joined;
    }
    tails.push(index + statements.len());
    index += count;
    bodies.push(block);
    // Guards, and the stores of shared names, have effects; only the last arm's value is used.
    effects = ownGuard || (guard != null) || (shared && (names.len() > 0));
  }
  _declareMatches(checked, subjectRoots, children);
  if (_useful(rows, [Pattern.Wildcard], [ty])) { _notExhaustive(rows, ty); }
  if (!statement && (resultType < 0)) { resultType = noValueType(expected); }

  if (!statement) {
    for (b, block in bodies) {
      bodies[b] = coerceTail(block, resultType, tails[b]);
    }
  }
  /* The match is exhaustive, so a value no earlier arm takes matches an unguarded pattern of the
   * last, and its body runs without a test. Guards there, and the stores of alternatives' names,
   * still run for their effects. */
  let last = bodies.len() - 1;
  let result = bodies[last];

  if (effects) {
    let discard = expressionOf(conditions[last]);
    result = if (statement) {
      opNode(Op.Block, 0, [discard, result])
    } else {
      node(Op.Block, resultType, 0, 1, [discard, result])
    };
  }
  let i = last - 1;

  while (i >= 0) {
    let op = statement ? Op.IfStatement : Op.If;
    result = opNode(op, statement ? 0 : resultType, [conditions[i], bodies[i], result]);
    i--;
  }
  children.push(result);
  statement ? opNode(Op.Block, 0, children) : node(Op.Block, resultType, 0, 1, children)
};

/** Checks `match (subject) { arms }` as a block; the subject's bindings, the further roots, and a
 * chain of `Op.If` (`Op.IfStatement` for a statement) whose last arm runs without a test. The
 * current syntax is the match's; its children are the subject, then each arm's alternatives'
 * guards, its guard, statements and tail; its patterns are numbered apart, one per alternative.
 * @param arms  the arms
 * @param expected  the type the context requires, or -1 for none
 * @param statement  whether the match is a statement, which discards its arms' values
 * @return the match block
 * @throws a located error if there are no arms, an arm is unreachable, the arms are not exhaustive
 *     or their types do not join, or a pattern, guard or body is invalid */
export let checkMatch = fn(
  subject: AstExpr,
  arms: Array<MatchArm>,
  expected: I32,
  statement: Bool
): I32 {
  if (arms.len() == 0) { throw coded(E0700, "match requires at least one arm"); }
  let children = Array.new<I32>(0);
  _matchArms(_subject(subject, arms, children), arms, 1, 0, expected, statement, children)
};

// Returns whether `pattern`, whose tests are `tests`, can fail on a value of type `ty`.
let _canFail = fn(pattern: Pattern, tests: Array<I32>, ty: I32): Bool {
  (tests.len() > 0) && _useful([[pattern]], [Pattern.Wildcard], [ty])
};

/** Fails at `place` because `pattern` can fail on a value of type `ty`, naming a value it misses
 * and giving `advice`.
 * @throws a located error, always */
let _failsHere = fn(pattern: Pattern, ty: I32, place: Syntax, advice: Bytes): Bool {
  let missing = _missing([[pattern]], ty);
  enterSyntax(place);
  let example = missing == "_" ? "" : `, as on ${missing}`;
  throw coded(E0702, `this pattern can fail${example}${advice}`);
};

/** Binds the names `pattern` binds, at `syntax`, from `value`, bound once, each declared, as a
 * local or a global, from a fresh read of it. Without `leave`, the pattern must match every
 * value; with it, a value the pattern does not match runs `leave`, which must leave, before any
 * name is declared, and the tests then read the value inside the block that initialises the
 * hidden binding.
 * @param leave  the checked block that a value the pattern does not match runs, or -1
 * @return the `Declare` of the hidden binding and the names
 * @throws a located error if the pattern does not fit the value, can fail without `leave`, or
 *     binds a name twice */
let _bindLet = fn(
  pattern: Pattern,
  syntax: Syntax,
  mutable: Bool,
  value: I32,
  leave: I32,
  global: Bool
): I32 {
  let ty = typeOf(value);
  let subject = _rootSubject(newBinding(), ty);
  let roots = subject.roots;
  let tests = Array.new<I32>(0);
  let bound = _noBound();
  _test(subject, pattern, syntax, [0], ty, tests, bound);

  if ((leave < 0) && _canFail(pattern, tests, ty)) {
    _failsHere(pattern, ty, syntax, ": use `if (let ...)` or `let ... else`");
  }
  let children = _matchBindings(subject, 1);
  let initial = value;

  // A pattern that cannot fail tests nothing, so `leave` never runs.
  if ((leave >= 0) && (tests.len() > 0)) {
    let fails = opNode(Op.Not, TYPE_BOOL, [_fold(Op.And, tests, true)]);
    let check = opNode(Op.IfStatement, 0, [fails, leave]);
    let declared = declareBinding(Op.Const, roots[0], "let", value);
    initial = node(Op.Block, ty, 0, 1, [declared, check, local(roots[0], ty)]);
    // The names read the value from the binding that the block initialises.
    roots[0] = newBinding();
  }
  children.push(bindingNode(Op.Const, roots[0], "let", initial));
  let reads = _boundReads(subject, bound);
  let declare = global ? declareGlobal : declareLocal;

  for (i, name in bound.names) {
    let at = enterSyntax(bound.places[i]);
    children.push(declare(name, reads[i], mutable));
    enterSyntax(at);
  }
  opNode(Op.Declare, 0, children)
};

/** Checks a `let` whose pattern, syntax pattern 0, is not a single name, the current syntax being
 * the statement's, as `_bindLet` binds it. An `else` block runs for a value the pattern does not
 * match.
 * @param mutable  whether the names may be assigned; a `let`'s may, a `const`'s may not
 * @param value  the checked value, syntax child 0
 * @param otherwise  the `else` block, whose statements follow the value among the syntax children,
 *     or null
 * @param global  whether the names are globals, for a module's statement
 * @return the `Declare` of the hidden binding and the names
 * @throws a located error as `_bindLet` does, or if the `else` block can finish */
export let checkLet = fn(
  pattern: Pattern,
  mutable: Bool,
  value: I32,
  otherwise: Null<AstBlock>,
  global: Bool
): I32 {
  let leave = -1;

  if (otherwise != null) {
    // As a value block, a failed last statement counts as leaving, so its error stands alone.
    leave = checkArm([], [], otherwise.statements, otherwise.tail, 1, -1, false);

    if (!endsPath(leave)) {
      throw coded(E0105, "the else of a let must leave, by return, throw, break or continue");
    }
  }
  _bindLet(pattern, syntaxPattern(0), mutable, value, leave, global)
};

/** Binds a list comprehension generator's pattern, syntax pattern `index` of the current syntax,
 * to `value`, an item of its source, at the start of the loop over the source, as `_bindLet`
 * binds a `let` with an `else`: an item the pattern does not match continues the loop.
 * @return the `Declare` of the hidden binding and the names, which are locals
 * @throws a located error if the pattern does not fit the value or binds a name twice */
export let bindGenerator = fn(pattern: Pattern, index: I32, value: I32): I32 {
  let skip = opNode(Op.Block, 0, [opNode(Op.Continue, 0, [])]);
  _bindLet(pattern, syntaxPattern(index), false, value, skip, false)
};

/** A condition's `let` tests so far: the roots that hold the names they bind, the names, and the
 * statement's name, for a diagnostic. */
typedef Chain = {
  let subject: Subject;
  let group: Group;
  let what: Bytes;
};

/** Checks a Bool part of a condition, `test`, which is child `index` of the current syntax, as a
 * plain condition is, a Null<Bool> being unwrapped; the names that the condition's `let` tests
 * have bound so far are declared while it is checked. */
let _conditionTest = fn(test: AstExpr, index: I32, chain: Chain): I32 {
  let names = chain.group.names;

  let checked = if (names.len() == 0) {
    presentAt(checkOperand(test, index, -1), index)
  } else {
    let stored = _stored(chain.subject, chain.group);
    present(checkArm(names, stored, [], test, index, -1, false))
  };
  requireBool(chain.what, checked, index);
  checked
};

/** Adds the names that `tested`'s pattern binds, in `bound`, to the chain of `subject`'s roots in
 * `group`; the tests that store them are appended to `tests`.
 * @param what  the construct that chains them, for the error
 * @return the names, their types and roots
 * @throws a located error for a name that the chain binds already */
let _chainBound = fn(
  subject: Subject,
  group: Group,
  tested: Subject,
  bound: Bound,
  tests: Array<I32>,
  what: Bytes
): Group {
  let names = bound.names;
  let values = _boundReads(tested, bound);
  let stored = _alternativeRoots(subject, values);
  let added: Group = { names, types: Array.new<I32>(0), roots: stored };

  for (i, name in names) {
    if (group.names.indexOf(name) >= 0) {
      enterSyntax(bound.places[i]);
      throw coded(E0704, `${name} is bound more than once in ${what}`);
    }
    tests.push(_store(subject, stored[i], values[i]));
    group.names.push(name);
    group.types.push(typeOf(values[i]));
    group.roots.push(stored[i]);
    added.types.push(typeOf(values[i]));
  }
  added
};

/** Checks a condition's `let pattern = value`, the current syntax being its own, into a Bool block
 * that binds the value once and tests it. A pattern that is just the name of a variant of the
 * value's enum tests for that variant, so `if (let Red = light)` means what it says. When `binds`
 * holds, as in a chain of `&&`, the tests also store each name the pattern binds in a root of the
 * chain's subject for what follows.
 * @throws a located error for type parameters, a value that does not fit the annotation or the
 *     pattern, or a name that the condition binds twice */
let _letTest = fn(
  pattern: Pattern,
  typeParams: Array<TypeParam>,
  annotation: ?AstType,
  value: AstExpr,
  binds: Bool,
  chain: Chain
): I32 {
  if (typeParams.len() != 0) {
    throw coded(E0605, "a `let` test does not take type parameters");
  }
  let subject = chain.subject;
  let group = chain.group;
  // The names that earlier tests bound are in scope for the value and for any pin.
  let (mark, children) = declareNames(group.names, _stored(subject, group));
  let checked = checkAnnotated(annotation, value);
  let ty = typeOf(checked);
  let root = newBinding();
  let tested = _rootSubject(root, ty);
  let tests = Array.new<I32>(0);
  let bound = _noBound();
  /* A bare name of one of the subject's variants tests for it, as in `match`, null failing the
   * test when the subject may be null; others bind. */
  let variants = _nullInner(ty) >= 0 ? _nullInner(ty) : ty;

  let shaped = match (pattern) {
    BindPattern(name) when (isEnum(variants) && (variantTag(variants, name) >= 0)) => {
      Pattern.Enum(name, [])
    },
    _ => pattern,
  };
  _test(tested, shaped, syntaxPattern(0), [0], ty, tests, bound);
  endNames(mark);
  children.push(declareBinding(Op.Const, root, "let", checked));
  _declareMatches(tested, 1, children);
  if (binds) { _chainBound(subject, group, tested, bound, tests, "this condition"); }
  children.push(_fold(Op.And, tests, true));
  node(Op.Block, TYPE_BOOL, 0, 1, children)
};

/** Checks part `index` of the current syntax, `part`, of a condition that tests a pattern; a
 * `let` there binds names only along the chain of `&&` from the condition's top, not under `||`
 * or `!`.
 * @return the part's Bool node */
let _conditionPart = fn(part: AstExpr, index: I32, binds: Bool, chain: Chain): I32 {
  if (!testsPattern(part)) { return _conditionTest(part, index, chain); }
  let outer = enterSyntax(syntaxChild(index));

  let checked = match (part) {
    Binary(And, left, right) => {
      let parts = [_conditionPart(left, 0, binds, chain), _conditionPart(right, 1, binds, chain)];
      opNode(Op.And, TYPE_BOOL, parts)
    },
    Binary(_, left, right) => {
      let parts = [_conditionPart(left, 0, false, chain), _conditionPart(right, 1, false, chain)];
      opNode(Op.Or, TYPE_BOOL, parts)
    },
    Unary(_, inner) => opNode(Op.Not, TYPE_BOOL, [_conditionPart(inner, 0, false, chain)]),
    LetExpr(pattern, typeParams, annotation, value) => {
      _letTest(pattern, typeParams, annotation, value, binds, chain)
    },
    _ => -1,
  };
  enterSyntax(outer);
  checked
};

/** Checks an `if` or `while` condition, syntax child 0 of the current syntax, that tests a pattern
 * with `let`. The names that its tests bind are stored in roots that are declared before the
 * statement, so that the condition can assign them and the body can read them.
 * @param what  the statement's name, for a diagnostic
 * @return the roots' declarations, the condition, the names it binds, and a function that makes a
 *     read of each */
export let checkCondition = fn(
  condition: AstExpr,
  what: Bytes
): Tuple<Array<I32>, I32, Array<Bytes>, () -> Array<I32>> {
  let subject = _noSubject();
  let group = _noGroup();
  let checked = _conditionPart(condition, 0, true, { subject, group, what });
  let declarations = Array.new<I32>(0);
  _declareMatches(subject, 0, declarations);
  (declarations, checked, group.names, fn(): Array<I32> { _stored(subject, group) })
};

/** Returns the error for a failing `with` clause's value of type `ty`, which does not join the
 * `with`'s type `target`. */
let _withMismatch = fn(ty: I32, target: I32): Bytes {
  let gives = `a clause that fails gives its value, of type ${typeName(ty)}`;
  let but = ", but the `with` gives " + typeName(target);
  coded(E0706, `${gives}${but}; add an else to give another`)
};

/** Checks `with clauses { body }`, with or without `else { arms }`, as a block. Each clause is
 * tested in turn, as a condition's `let` tests chain; its value is bound once, and the names its
 * pattern binds are stored in roots for the clauses after it and the body. When every clause
 * matches, the body gives the value; else the clause that failed stores its value in a root of its
 * own, and, without arms, that value is the with's, and with them, the arms match it as a match
 * does its subject. The current syntax is the with's; its children are each clause's guard and
 * value, the body's statements and tail, then the arms', as a match's are; its patterns are the
 * clauses', then the arms'.
 * @param expected  the type the context requires, or -1
 * @return the block
 * @throws a located error if a `let` clause can fail, a guard is not a Bool, a name is bound
 *     twice, the arms are empty, not exhaustive or have no clause to take a value from, or the
 *     body's type and the failing values', or the arms', do not join */
export let checkWith = fn(
  clauses: Array<WithClause>,
  body: AstBlock,
  elseArms: MatchArms,
  expected: I32
): I32 {
  let subject = _noSubject();
  let group = _noGroup();
  /* Each clause's statements and tests; the binding of its value, the value's type and syntax
   * child; and the clauses that can fail, and the `<-` ones. */
  let blocks = Array.new<Array<I32>>(0);
  let tested = Array.new<Array<I32>>(0);
  let valueRoots = Array.new<I32>(0);
  let valueTypes = Array.new<I32>(0);
  let valueIndexes = Array.new<I32>(0);
  let failing = Array.new<I32>(0);
  let arrows = Array.new<I32>(0);
  let index = 0;

  for (c, clause in clauses) {
    let (pattern, value) = match (clause) { Clause(p, _, v) => (p, v), Let(p, v) => (p, v) };
    let guard = match (clause) { Clause(_, g, _) => g, Let(_, _) => null };
    let bound = match (clause) { Let(_, _) => true, _ => false };
    let valueIndex = guard == null ? index : index + 1;
    // The names that earlier clauses bound are in scope for the value, any pin and the guard.
    let (mark, children) = declareNames(group.names, _stored(subject, group));
    let checked = checkOperand(value, valueIndex, -1);
    let ty = typeOf(checked);
    let root = newBinding();
    let own = _rootSubject(root, ty);
    let tests = Array.new<I32>(0);
    let found = _noBound();
    let place = syntaxPattern(c);
    _test(own, pattern, place, [0], ty, tests, found);
    let fails = _canFail(pattern, tests, ty);
    if (bound && fails) { _failsHere(pattern, ty, place, ": use `<-`"); }

    if (!bound && !fails && (guard == null)) {
      let outer = enterSyntax(place);
      warn(currentSpan(), "this clause cannot fail: use `let`");
      enterSyntax(outer);
    }
    children.push(declareBinding(Op.Const, root, "with", checked));
    _declareMatches(own, 1, children);
    let added = _chainBound(subject, group, own, found, tests, "this `with`");

    if (guard != null) {
      let stored = _stored(subject, added);
      let checkedGuard = checkArm(added.names, stored, [], guard, index, TYPE_BOOL, false);

      if (typeOf(checkedGuard) != TYPE_BOOL) {
        enterSyntax(syntaxChild(index));
        throw coded(E0400, "a `with` guard must be a Bool");
      }
      tests.push(checkedGuard);
    }
    endNames(mark);
    blocks.push(children);
    tested.push(tests);
    valueRoots.push(root);
    valueTypes.push(ty);
    valueIndexes.push(valueIndex);
    if (fails || (guard != null)) { failing.push(c); }
    if (!bound) { arrows.push(c); }
    index = valueIndex + 1;
  }
  let { statements, tail } = body;
  let stored = _stored(subject, group);
  let checkedBody = checkArm(group.names, stored, statements, tail, index, expected, false);
  let tailIndex = index + statements.len();

  if ((tail == null) && !endsPath(checkedBody)) {
    enterSyntax(syntaxChild(tailIndex - 1));
    throw coded(E0410, "a `with` body requires a trailing expression");
  }
  index = tailIndex + (tail == null ? 0 : 1);

  let (arms, otherwise) = match (elseArms) {
    Some(arms) => (arms, true),
    None => (Array.new<MatchArm>(0), false),
  };

  if (otherwise && (arms.len() == 0)) {
    throw coded(E0706, "a `with` else requires at least one arm");
  }

  if (otherwise && (failing.len() == 0)) {
    if (arrows.len() == 0) {
      throw coded(E0706, "a `with` of `let` clauses cannot fail, so its else never runs");
    }
    // Arms no value reaches still match the `<-` clauses' values, as they would if they failed.
    failing = arrows;
  }
  let children = Array.new<I32>(0);
  let conditions = Array.new<I32>(0);

  if (failing.len() == 0) {
    for (c, block in blocks) {
      block.push(_fold(Op.And, tested[c], true));
      conditions.push(node(Op.Block, TYPE_BOOL, 0, 1, block));
    }
    _declareMatches(subject, 0, children);
    children.push(expressionOf(_fold(Op.And, conditions, true)));
    children.push(checkedBody);
    return node(Op.Block, typeOf(checkedBody), 0, 1, children);
  }
  /* The failing values go to the result without arms, joined with the body's; with them, to one
   * type the arms match, Dynamic when they differ. */
  let target = otherwise || (expected < 0) ? -1 : expected;
  if (!otherwise && (target < 0) && !endsPath(checkedBody)) { target = typeOf(checkedBody); }
  let f = 0;

  while ((f < failing.len()) && (otherwise || (expected < 0))) {
    let ty = valueTypes[failing[f]];
    let joined = target < 0 ? ty : joinTypes(target, ty);

    if (joined < 0) {
      if (!otherwise) {
        enterSyntax(syntaxChild(valueIndexes[failing[f]]));
        throw _withMismatch(ty, target);
      }
      joined = TYPE_DYNAMIC;
    }
    target = joined;
    f++;
  }
  let failedRoot = _addRoot(subject, _rootType(target));

  for (c, block in blocks) {
    let condition = _fold(Op.And, tested[c], true);

    if (failing.indexOf(c) >= 0) {
      let ty = valueTypes[c];
      let outer = enterSyntax(syntaxChild(valueIndexes[c]));
      let read = local(valueRoots[c], ty);
      if ((target == TYPE_DYNAMIC) && (ty != TYPE_DYNAMIC)) { read = toDynamic(read); }
      enterSyntax(outer);
      let converted = coerceAt(read, target, valueIndexes[c]);

      if (!unify(typeOf(converted), target)) {
        enterSyntax(syntaxChild(valueIndexes[c]));
        throw _withMismatch(ty, target);
      }
      // A clause that fails stores its value; the store gives true.
      let stores = opNode(Op.Not, TYPE_BOOL, [_store(subject, failedRoot, converted)]);
      condition = opNode(Op.Or, TYPE_BOOL, [condition, stores]);
    }
    block.push(condition);
    conditions.push(node(Op.Block, TYPE_BOOL, 0, 1, block));
  }
  _declareMatches(subject, 0, children);
  let otherValue = _stored(subject, { names: ["with"], types: [target], roots: [failedRoot] })[0];

  if (otherwise) {
    let armChildren = Array.new<I32>(0);
    let checked = _valueSubject(otherValue, arms.len(), armChildren);
    otherValue = _matchArms(checked, arms, index, clauses.len(), expected, false, armChildren);
  }
  let result = expected >= 0 ? expected : joinBranches(checkedBody, otherValue);

  if (result < 0) {
    let at = tail == null ? -1 : tailIndex;
    throw branchMismatch("with body and else", typeOf(checkedBody), typeOf(otherValue), at);
  }
  let otherIndex = otherwise ? index : valueIndexes[failing[0]];
  let test = _fold(Op.And, conditions, true);
  let given = coerceTail(checkedBody, result, tailIndex);
  let other = coerceAt(otherValue, result, otherIndex);
  children.push(opNode(Op.If, result, [test, given, other]));
  node(Op.Block, result, 0, 1, children)
};
