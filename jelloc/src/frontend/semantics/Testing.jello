package frontend.semantics;

import type { Expr as AstExpr } from frontend.syntax.Ast;
import { BinaryOp } from frontend.syntax.Ast;
import frontend.hir.Hir as H;
import { Kind, Op } from frontend.hir.Hir;
import { bytesOf, joinOf, literalOf } from frontend.semantics.Derived;
import { bindOnce, equalBindings, equalityOperands, orThrow } from frontend.semantics.Values;
import {
  Binding, declareScoped, exportScoped, exportedType, namespaceMember,
} from frontend.semantics.ModuleScope;
import type { SourceSpan } from frontend.syntax.Source;
import { locate } from frontend.syntax.Locations;
import {
  callFunction, checkArity, checkOperand, currentSpan, enterSyntax, rejectAt, syntaxChild, widened,
} from frontend.semantics.TypeCheck;
import { E0400, E0408, E0600, coded } from support.Codes;

let _ASSERTIONS = ["equal", "notEqual", "isTrue", "isNull", "throws"];

export let declareAssertions = fn(module: I32): Bool {
  for (name in _ASSERTIONS) {
    declareScoped(name, Binding.Intrinsic(module, name));
    exportScoped(module, name, true);
  }
  true
};

let _located = fn(span: SourceSpan): Bytes {
  let (line, column) = locate(span.path, span.start);
  `${span.path}:${line}:${column}`
};

let _location = fn(): Bytes {
  let span = currentSpan();
  span == null ? "" : _located(span)
};

let _argument = fn(args: Array<AstExpr>, index: I32, ty: I32, name: Bytes, what: Bytes): I32 {
  let value = widened(checkOperand(args[index], index + 1, ty), ty);

  if (!H.unify(H.typeOf(value), ty)) {
    let wanted = `${name} takes ${what} of type ${H.typeName(ty)}`;
    rejectAt(index + 1, coded(E0400, `${wanted}, not ${H.typeName(H.typeOf(value))}`));
  }
  value
};

let _shown = fn(binding: I32, value: I32): I32 {
  literalOf(binding < 0 ? value : H.local(binding, H.typeOf(value)))
};

let _report = fn(module: I32, reporter: Bytes, args: Array<I32>): I32 {
  callFunction(namespaceMember(module, "std.testing", reporter), `std.testing.${reporter}`, args)
};

let _unless = fn(condition: I32, failure: I32): I32 {
  let passed = H.opNode(Op.Null, H.TYPE_NULL, []);
  H.opNode(Op.If, H.TYPE_NULL, [condition, passed, failure])
};

export let checkSystemAssertion = fn(assertion: Bytes, name: Bytes, args: Array<AstExpr>): I32 {
  let at = `${_location()}: `;

  if (assertion == "assert") {
    checkArity(args, 1, name);
    let condition = _argument(args, 0, H.TYPE_BOOL, name, "a condition");
    return orThrow(condition, bytesOf(`${at}assertion failed`));
  }

  if ((args.len() < 2) || (args.len() > 3)) {
    throw coded(E0600, `${name} takes 2 or 3 arguments`);
  }
  let statements = Array.new<I32>(0);
  let (got, want) = equalityOperands(args[0], args[1], 1);
  let g = bindOnce(statements, "got", got);
  let w = bindOnce(statements, "want", want);
  let message = [
    bytesOf(`${at}assertEq failed: `), _shown(g, got), bytesOf(" != "), _shown(w, want)
  ];

  if (args.len() == 3) {
    let text = _argument(args, 2, H.TYPE_BYTES, name, "a message");
    let context = bindOnce(statements, "message", text);
    message.push(bytesOf(": "));
    message.push(H.local(context, H.TYPE_BYTES));
  }
  let same = equalBindings(BinaryOp.Equal, g, got, w, want);
  statements.push(orThrow(same, joinOf(message)));
  H.node(Op.Block, H.TYPE_NULL, 0, 1, statements)
};

export let checkAssertion = fn(
  module: I32,
  assertion: Bytes,
  name: Bytes,
  args: Array<AstExpr>
): I32 {
  checkArity(args, (assertion == "equal") || (assertion == "notEqual") ? 3 : 2, name);
  let testType = exportedType(module, "Test");
  let at = bytesOf(_location());
  let test = _argument(args, 0, testType, name, "a test");

  if (assertion == "throws") {
    let callback = H.functionType(Array.new<I32>(0), H.TYPE_NULL);
    let run = _argument(args, 1, callback, name, "a function");
    return _report(module, "throwsAt", [test, at, run]);
  }

  let statements = Array.new<I32>(0);
  let t = H.opOf(test) == Op.Local ? H.valueOf(test) : bindOnce(statements, "t", test);

  let check = match (assertion) {
    "isTrue" => {
      let condition = _argument(args, 1, H.TYPE_BOOL, name, "a condition");
      _unless(condition, _report(module, "failFalse", [H.local(t, testType), at]))
    },
    "isNull" => {
      let value = checkOperand(args[1], 2, -1);
      let ty = H.typeOf(value);

      if (!H.isKind(ty, Kind.Null)) {
        enterSyntax(syntaxChild(2));
        throw coded(E0408, `${name} takes a nullable value, not ${H.typeName(ty)}`);
      }
      let v = bindOnce(statements, "value", value);
      let missing = H.opNode(Op.IsNull, H.TYPE_BOOL, [H.local(v, ty)]);
      let shown = [H.local(t, testType), at, _shown(v, value)];
      _unless(missing, _report(module, "failNotNull", shown))
    },
    _ => {
      let (got, want) = equalityOperands(args[1], args[2], 2);
      let g = bindOnce(statements, "got", got);
      let w = bindOnce(statements, "want", want);
      let same = equalBindings(BinaryOp.Equal, g, got, w, want);
      let shownGot = _shown(g, got);

      if (assertion == "equal") {
        let shown = [H.local(t, testType), at, shownGot, _shown(w, want)];
        _unless(same, _report(module, "failEqual", shown))
      } else {
        let different = H.opNode(Op.Not, H.TYPE_BOOL, [same]);
        let shown = [H.local(t, testType), at, shownGot];
        _unless(different, _report(module, "failNotEqual", shown))
      }
    },
  };
  statements.push(check);
  H.node(Op.Block, H.TYPE_NULL, 0, 1, statements)
};
