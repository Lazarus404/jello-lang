package frontend.semantics;

import type {
  AssignOp, BinaryOp, Block as AstBlock, Expr as AstExpr, FloatSize, IncDecOp, IntSize, Parameter,
  ParameterKind, Pattern, PrototypeField, Stmt, Type as AstType, TypeParam, UnaryOp,
} from frontend.syntax.Ast;
import {
  Expr as AstExpr, Type as AstType, bindPatternName, integerIn, integerValue, isBindPattern,
  unsignedWideValue, wideIntegerValue,
} from frontend.syntax.Ast;
import type { Hir } from frontend.hir.Hir;
import frontend.hir.Hir as H;
import { Kind, Op } from frontend.hir.Hir;
import {
  beginDoubt, beginTouch, doubt, endDoubt, endTouch, failureCount, instanceNeed, keepNote,
  needInstance, noteFailure, poison, poisonLocal, recordFailure, resetFailures, touch,
  touchLocal, touched,
} from frontend.semantics.Failures;
import type { Need } from frontend.semantics.Failures;
import { internalError } from support.Internal;
import type { Binding } from frontend.semantics.ModuleScope;
import {
  Binding, currentModule, declareScoped, exportedType, isImported, namespaceMember, scoped,
  scopedType, useModuleScope,
} from frontend.semantics.ModuleScope;
import {
  assignLocal, assignmentMark, enterLoop, isNarrowed, keepNarrowings, leaveLoop, narrow, narrowings,
  resetNarrowing, setNarrowings,
} from frontend.semantics.Narrowing;
import type { SourceSpan, Syntax } from frontend.syntax.Source;
import { syntaxSpan } from frontend.syntax.Source;
import type { Located } from frontend.syntax.Rewrite;
import { Located, rewrite } from frontend.syntax.Rewrite;
import {
  E0007, E0102, E0103, E0108, E0109, E0213, E0300, E0301, E0302, E0303, E0304, E0305,
  E0306, E0307, E0308, E0400, E0401, E0402, E0403, E0404, E0408, E0409, E0410, E0411,
  E0413, E0500, E0501, E0600, E0601, E0602, E0603, E0604, E0605, E0701, E0705, E0800,
  E0809, E0804, E0900, E0901, E1000, E1001, coded,
} from support.Codes;

load { f64_low_bits, f64_high_bits, f32_bits, f16_bits, regexp_check } from std;
let _f64Low: (Bytes) -> I32 = f64_low_bits;
let _f64High: (Bytes) -> I32 = f64_high_bits;

let _f64Bits = fn(text: Bytes): I64 {
  ((_f64High(text) as I64) << 32) | ((_f64Low(text) as I64) & 4294967295)
};
let _f32Bits: (Bytes) -> I32 = f32_bits;
let _f16Bits: (Bytes) -> I32 = f16_bits;
let _regexpProblem: (Bytes, Bytes) -> Bytes = regexp_check;

let _nameIds = Array.new<I32>(0);
let _ids = Array.new<I32>(0);
let _hidden = Array.new<I32>(0);
let _latest = Array.new<I32>(0);
let _nextBinding = 0;
let _bindingTypes = Array.new<I32>(0);
let _mutable = Array.new<Bool>(0);
let _declarations = Array.new<Syntax>(0);
let _globalDeclarations = Array.new<Syntax>(0);
let _globalConstants = Array.new<I32>(0);
let _scopeStart = 0;
let _loops = 0;
let _barrier = "";
let _tries = 0;

typedef Frame = {
  let nameIds: Array<I32>;
  let ids: Array<I32>;
};
let _frames = Array.new<Frame>(0);

typedef Closure = {
  let captures: Array<I32>;
  let sources: Array<I32>;
};
let _newClosure = fn(): Closure { { captures: Array.new<I32>(0), sources: Array.new<I32>(0) } };
let _closures = [_newClosure()];

typedef FunctionInfo = {
  let name: Bytes;
  let ty: I32;
  let params: Array<Bytes>;
  let node: I32;
  let paramTypes: Array<I32>;
  let defaults: Array<I32>;
  let syntax: Syntax;
  let dropped: Bool;
  let methodKind: I32;
};
let _functions = Array.new<FunctionInfo>(0);
let _resultSyntax = _noSyntax();
let _result = -1;
let _resultInferred = false;
let _results = Array.new<I32>(0);
let _resultsStart = 0;

let _spanSyntax = fn(path: Bytes, start: I32, end: I32): Syntax {
  {
    path,
    start,
    end,
    children: Array.new<Syntax>(0),
    patterns: Array.new<Syntax>(0)
  }
};

let _noSyntax = fn(): Syntax { _spanSyntax("", 0, 0) };
let _syntax = _noSyntax();
let _moduleSyntax = _noSyntax();
let _statements = Array.new<Stmt>(0);
let _directStatements = Array.new<I32>(0);
let _directLets = Array.new<Bool>(0);
let _firstDirect = 0;
let _globals = Array.new<I32>(0);
let _bodyName = "";

typedef Template = {
  let name: Bytes;
  let params: Array<I32>;
  let value: AstExpr;
  let syntax: Syntax;
  let module: I32;
  let bodyName: Bytes;
  let names: Array<Bytes>;
  let envTypes: Array<I32>;
  let locals: Array<I32>;
  let keys: Array<I32>;
  let functions: Array<I32>;
  let checker: I32;
};
let _templates = Array.new<Template>(0);
let _envNames = Array.new<Bytes>(0);
let _envTypes = Array.new<I32>(0);
let _aliases = Array.new<I32>(0);

typedef Alias = {
  let params: Array<I32>;
  let body: I32;
};
let _aliasTypes = Array.new<Alias>(0);
let _templateBody = false;

typedef Method = {
  let function: I32;
  let field: Bytes;
};
let _prototypeMethods = Array.new<Method>(0);
let _instanceMethods = Array.new<Method>(0);

typedef MethodCall = {
  let call: I32;
  let origin: I32;
  let name: Bytes;
  let exact: Bool;
};
let _methodCalls = Array.new<MethodCall>(0);
let _methods = Array.new<I32>(0);
let _prototypes = Array.new<I32>(0);

typedef PrototypeInfo = {
  let global: I32;
  let parent: I32;
};
let _prototypeInfos = Array.new<PrototypeInfo>(0);
let _initFields = Array.new<I32>(0);

typedef Generic = {
  let module: I32;
  let statement: Stmt;
  let syntax: Syntax;
  let placeholder: I32;
};
let _generics = Array.new<I32>(0);
let _genericPrototypes = Array.new<Generic>(0);

typedef Instance = {
  let global: I32;
  let init: I32;
  let nesting: I32;
  let need: Need;
};
let _instanceTypes = Array.new<I32>(0);
let _instances = Array.new<Instance>(0);
let _built = 0;

typedef OpenRead = {
  let read: I32;
  let depth: I32;
  let need: Need;
};
let _openReads = Array.new<OpenRead>(0);
let _directFields = Array.new<I32>(0);
let _captureFloor = 0;

typedef PendingCall = {
  let call: I32;
  let template: I32;
  let types: Array<I32>;
  let depth: I32;
  let need: Need;
};
let _pending = Array.new<PendingCall>(0);
let _instanceDepth = 0;
let _NO_NAMES = Array.new<Bytes>(0);
let _NO_TYPES = Array.new<I32>(0);

export let inTemplate = fn(): Bool { _templateBody };

export let enterSyntax = fn(syntax: Syntax): Syntax {
  let outer = _syntax;
  _syntax = syntax;
  H.setSpan(syntax.path, syntax.start, syntax.end);
  outer
};

let _spanOf = fn(syntax: Syntax): ?SourceSpan {
  syntax.path != "" ? syntaxSpan(syntax) : null
};

export let currentSpan = fn(): ?SourceSpan { _spanOf(_syntax) };

export let recover = fn(error: Dynamic): Bool {
  if (!recordFailure(currentSpan(), error)) { throw error; }
  true
};

let _needHere = fn(): Need {
  let need = instanceNeed();
  need.0 != null ? need : (currentSpan(), "")
};

let _needing = fn(need: Need, name: Bytes): Need {
  needInstance(need.0, need.1 != "" ? need.1 : `in ${name}, which is needed here`)
};

let _withChildren = fn(syntax: Syntax, children: Array<Syntax>): Syntax {
  { ...syntax, children }
};

export let syntaxChild = fn(index: I32): Syntax { _syntax.children[index] };

export let withoutCallee = fn(): Syntax {
  _withChildren(_syntax, Array.new<Syntax>(0).appendFrom(_syntax.children, 1))
};

let _rejectAt = fn(index: I32, failure: Bytes) {
  let outer = enterSyntax(syntaxChild(index));
  recover(failure as Dynamic);
  enterSyntax(outer);
  null
};
export let rejectAt = fn(index: I32, failure: Bytes): Null { _rejectAt(index, failure) };

export let syntaxPattern = fn(index: I32): Syntax {
  _syntax.patterns[index]
};
export let subPattern = fn(syntax: Syntax, index: I32): Syntax { syntax.children[index] };

let _find = fn(name: Bytes, start: I32): I32 {
  let nameId = H.findBytesId(name);
  if ((nameId < 0) || (nameId >= _latest.len())) { return -1; }
  let found = _latest[nameId];
  ((found >= start) && (found < _nameIds.len()) && (_nameIds[found] == nameId)) ? found : -1
};

export let newBinding = fn(): I32 {
  let id = _nextBinding;
  _nextBinding++;
  _bindingTypes.push(-1);
  _mutable.push(false);
  _declarations.push(_syntax);
  id
};

let _declare = fn(name: Bytes, ty: I32, mutable: Bool): I32 {
  let id = newBinding();
  _bindingTypes[id] = ty;
  _mutable[id] = mutable;
  if (name == "_") { return id; }
  let nameId = H.bytesId(name);
  while (_latest.len() <= nameId) { _latest.push(-1); }
  _hidden.push(_latest[nameId]);
  _latest[nameId] = _nameIds.len();
  _nameIds.push(nameId);
  _ids.push(id);
  id
};

let _popTo = fn(start: I32) {
  while (_nameIds.len() > start) {
    let last = _nameIds.len() - 1;
    _latest[_nameIds[last]] = _hidden[last];
    _nameIds.pop();
    _ids.pop();
    _hidden.pop();
  }
  null
};

let _bindingTemplate = fn(id: I32): I32 {
  let ty = _bindingTypes[id];
  ty < -1 ? -2 - ty : -1
};

let _typeOfBinding = fn(id: I32): I32 {
  let ty = H.resolve(_bindingTypes[id]);
  _bindingTypes[id] = ty;
  ty
};

let _leaf = fn(op: Op, ty: I32, value: I32): I32 { H.node(op, ty, value, 0, []) };
let _unary = fn(op: Op, ty: I32, operand: I32): I32 { H.opNode(op, ty, [operand]) };

let _binary = fn(op: Op, ty: I32, left: I32, right: I32): I32 {
  H.opNode(op, ty, [left, right])
};

let _laterType: (Bytes) -> I32 = fn(_name) { -1 };

export let useTypedefs = fn(later: (Bytes) -> I32): Bool {
  _laterType = later;
  true
};

let _namedType = fn(name: Bytes): I32 {
  let named = scopedType(name);
  named >= 0 ? named : _laterType(name)
};
let _aliasIndex = fn(ty: I32): I32 { H.isKind(ty, Kind.Param) ? _aliases.indexOf(ty) : -1 };

export let declareGenericAlias = fn(name: Bytes, params: Array<I32>, body: I32): I32 {
  let alias = H.newParam(name, 0);
  _aliases.push(alias);
  _aliasTypes.push({ params, body });
  alias
};

let _typeParamCount = fn(ty: I32): I32 {
  let alias = _aliasIndex(ty);
  alias >= 0 ? _aliasTypes[alias].params.len() : H.enumParamCount(ty)
};

let _arityMismatch = fn(name: Bytes, params: I32, count: I32): Bytes {
  coded(E0402,
    `${name} takes ${params}${params == 1 ? " type argument" : " type arguments"}, not ${count}`)
};

export let checkTypeArgCount = fn(name: Bytes, ty: I32, count: I32): Bool {
  if (ty < 0) {
    touch(name);
    throw coded(E0401, `unknown type: ${name}`);
  }
  if (count != _typeParamCount(ty)) { throw _arityMismatch(name, _typeParamCount(ty), count); }
  true
};

export let needsBound = fn(param: I32, bound: Bytes): Bytes {
  `needs the bound ${bound}: write <${H.typeName(param)}: ${bound}>`
};
let _checkTypes = fn(types: Array<AstType>): Array<I32> { types.map(checkType) };

let _checkParamTypes = fn(types: Array<AstType>): Array<I32> {
  let checked = Array.new<I32>(0);
  let optional = false;

  for (param in types) {
    let ty = match (param) {
      OptionalArg(inner) => {
        optional = true;
        H.optionalType(checkType(inner))
      },
      VarargsArg(inner) => H.restType(checkType(inner)),
      _ => {
        if (optional) {
          throw coded(E0102, "a required parameter cannot follow an optional one");
        }
        checkType(param)
      },
    };
    checked.push(ty);
  }
  checked
};

let _envType = fn(name: Bytes): I32 {
  let i = _envNames.len() - 1;
  while ((i >= 0) && (_envNames[i] != name)) { i--; }
  i >= 0 ? _envTypes[i] : -1
};

let _resultType = fn(ty: AstType): I32 {
  match (ty) {
    Named(name) when ((name == "Void") && (scopedType(name) < 0)) => H.TYPE_NULL,
    _ => checkType(ty),
  }
};

let _heldFields = fn(ty: I32): I32 {
  let count = H.isLinked(ty) ? H.fieldCount(ty, 0) : 0;
  let f = 0;

  while (f < count) {
    let field = H.fieldType(ty, 0, f);

    if (!H.isOpen(field) && !H.isParametric(field) && !H.readsTyped(field)) {
      let named = `field ${H.fieldName(ty, 0, f)} of ${H.typeName(ty)}`;
      throw coded(E0804,
        `${named} is ${H.typeName(field)}, which a prototype's Object cannot hold as itself`);
    }
    f++;
  }
  ty
};

export let checkType = fn(ty: AstType): I32 { match (ty) {
  Named(name) => match (name) {
    "I32" => H.TYPE_I32,
    "I64" => H.TYPE_I64,
    "Bool" => H.TYPE_BOOL,
    "Bytes" => H.TYPE_BYTES,
    "Dynamic" => H.TYPE_DYNAMIC,
    "Null" => H.TYPE_NULL,
    "I8" => H.TYPE_I8,
    "I16" => H.TYPE_I16,
    "U8" => H.TYPE_U8,
    "U16" => H.TYPE_U16,
    "U32" => H.TYPE_U32,
    "U64" => H.TYPE_U64,
    "F16" => H.TYPE_F16,
    "F32" => H.TYPE_F32,
    "F64" => H.TYPE_F64,
    _ => {
      let named = _envNames.len() != 0 ? _envType(name) : -1;

      if (named < 0) {
        named = _namedType(name);

        if (named >= 0) {
          checkTypeArgCount(name, named, 0);
        } else {
          named = match (name) {
            "Atom" => H.TYPE_ATOM,
            "Object" => H.TYPE_OBJECT,
            "ByteBuffer" => H.TYPE_BYTE_BUFFER,
            "Void" => { throw coded(E0401, "Void cannot be used as a value type") },
            "Array", "List" => { throw _arityMismatch(name, 1, 0) },
            _ => {
              checkTypeArgCount(name, -1, 0);
              -1
            },
          };
        }
      }
      named
    },
  },
  Generic(name, args) => match (name) {
    "Array" when (args.len() == 1) => H.arrayType(checkType(args[0])),
    "List" when (args.len() == 1) => H.listType(checkType(args[0])),
    "Tuple" when (args.len() >= 1) => H.tupleType(_checkTypes(args)),
    "Null" when (args.len() == 1) => H.nullType(checkType(args[0])),
    "Array", "List", "Null" => { throw _arityMismatch(name, 1, args.len()) },
    _ => {
      let named = _namedType(name);
      if (named < 0) { throw coded(E0401, `unknown type: ${name}`); }
      checkTypeArgCount(name, named, args.len());
      let alias = _aliasIndex(named);
      alias >= 0
        ? H.substitute(_aliasTypes[alias].body, _aliasTypes[alias].params, _checkTypes(args))
        : _heldFields(H.appliedType(named, _checkTypes(args)))
    },
  },
  Function(args, result) => H.functionType(_checkParamTypes(args), _resultType(result)),
  OptionalArg(inner) => H.nullType(checkType(inner)),
  VarargsArg(_) => { throw coded(E0102, "T... is only the last parameter of a function type") },
  Unquote(_) => { throw coded(E1001, "unquote is only allowed inside a quote") },
  Tuple(_) => { throw coded(E0401, "tuple types are written Tuple<A, B>") },
} };

export let checkAnnotation = fn(annotation: Null<AstType>): I32 {
  if (annotation == null) { return -1; }
  let outer = enterSyntax(syntaxPattern(1));
  let ty = checkType(annotation);
  enterSyntax(outer);
  ty
};

let _checkEnum: (AstExpr, I32, Bool) -> I32 = fn(_expr, _expected, _statement) { -1 };

export let useEnumChecks = fn(check: (AstExpr, I32, Bool) -> I32): Bool {
  _checkEnum = check;
  true
};
let _checkLetPattern: (Pattern, Bool, I32, Null<AstBlock>, Bool) -> I32 =
  fn(_pattern, _mutable, _value, _otherwise, _global) { -1 };

export let useLetChecks = fn(check: (Pattern, Bool, I32, Null<AstBlock>, Bool) -> I32): Bool {
  _checkLetPattern = check;
  true
};
typedef CheckedCondition = Tuple<Array<I32>, I32, Array<Bytes>, () -> Array<I32>>;
let _noReads = fn(): Array<I32> { Array.new<I32>(0) };
let _checkLetCondition: (AstExpr, Bytes) -> CheckedCondition =
  fn(_condition, _what) { (Array.new<I32>(0), -1, Array.new<Bytes>(0), _noReads) };

export let useConditionChecks = fn(check: (AstExpr, Bytes) -> CheckedCondition): Bool {
  _checkLetCondition = check;
  true
};

let _isEnumName = fn(base: AstExpr): Bool {
  match (base) {
    Variable(name), TypeApply(Variable(name), _) => H.isEnum(scopedType(name)) && !_isLocal(name),
    _ => false,
  }
};
let _checkValue: (AstExpr, I32) -> I32 = fn(_expr, _expected) { -1 };

export let useValueChecks = fn(check: (AstExpr, I32) -> I32): Bool {
  _checkValue = check;
  true
};
let _checkAggregate: (AstExpr, I32) -> I32 = fn(_expr, _expected) { -1 };

let _prototypeOf = fn(ty: I32): I32 {
  let template = ty >= 0 ? H.templateOf(ty) : -1;
  template >= 0 ? template : ty
};

export let prototypeParent = fn(ty: I32): I32 {
  let at = _prototypes.indexOf(_prototypeOf(ty));
  at < 0 ? -2 : _prototypeInfos[at].parent
};

export let delegates = fn(source: I32, target: I32): Bool {
  let at = prototypeParent(source);
  let steps = 0;

  while ((at >= 0) && (at != target) && (steps < _prototypes.len())) {
    at = prototypeParent(at);
    steps++;
  }
  (target >= 0) && (at == target)
};
export let hasInitField = fn(ty: I32): Bool { _initFields.indexOf(_prototypeOf(ty)) >= 0 };

export let upcasts = fn(source: I32, target: I32): Bool {
  H.isPrototype(source) && ((target == H.TYPE_OBJECT) || delegates(source, target))
};

let _methodContext = fn(): I32 {
  let i = _methods.len() - 1;
  while ((i >= 0) && (_methods[i] == -2)) { i--; }
  i >= 0 ? _methods[i] : -1
};

export let requireThis = fn(what: Bytes): I32 {
  let ty = _methodContext();
  if (ty >= 0) { return ty; }
  let i = _methods.len() - 1;
  while ((i >= 0) && (_methods[i] < 0)) { i--; }
  throw coded(E0306, i >= 0
    ? what + " is the `this` of the method around this `fn`, which does not see it;"
    + " write `method fn`"
    : `${what} is only inside a prototype's method`);
};

export let useAggregateChecks = fn(check: (AstExpr, I32) -> I32): Bool {
  _checkAggregate = check;
  true
};
let _checkAssertion: (I32, Bytes, Bytes, Array<AstExpr>) -> I32 =
  fn(_module, _assertion, _name, _args) { -1 };

export let useAssertionChecks = fn(check: (I32, Bytes, Bytes, Array<AstExpr>) -> I32): Bool {
  _checkAssertion = check;
  true
};
let _structuralEquality: (BinaryOp, I32, I32) -> I32 = fn(_op, _left, _right) { -1 };

export let useStructuralEquality = fn(build: (BinaryOp, I32, I32) -> I32): Bool {
  _structuralEquality = build;
  true
};
let _unsupported: (I32, Bool) -> I32 = fn(_ty, _printing) { -1 };

export let useUnsupported = fn(find: (I32, Bool) -> I32): Bool {
  _unsupported = find;
  true
};

let _isEnumExpr = fn(expr: AstExpr): Bool {
  match (expr) {
    Match(_, _) => true,
    With(_, _, _) => true,
    Member(base, _) => _isEnumName(base),
    Call(callee, _, _) => match (callee) { Member(base, _) => _isEnumName(base), _ => false },
    _ => false,
  }
};

export let checkArity = fn(args: Array<AstExpr>, count: I32, name: Bytes): Bool {
  if (args.len() != count) {
    throw coded(E0600, `${name} takes ${count}${count == 1 ? " argument" : " arguments"}`);
  }
  true
};

export let checkOperand = fn(expr: AstExpr, index: I32, expected: I32): I32 {
  _checkExpr(expr, syntaxChild(index), expected)
};

let _known = fn(id: I32): Bool {
  match (H.opOf(id)) { Local => isNarrowed(H.valueOf(id)), _ => false }
};

let _unwrap = fn(id: I32): I32 {
  H.node(Op.Unwrap, H.innerOf(H.typeOf(id)), _known(id) ? 0 : 1, 0, [id])
};

export let presentKnown = fn(id: I32): I32 {
  (H.isKind(H.typeOf(id), Kind.Null) && _known(id)) ? _unwrap(id) : id
};

export let bufferHint = fn(ty: I32): Bytes {
  ty == H.TYPE_BYTE_BUFFER ? "; copy a buffer's bytes out with buffer.toString()" : ""
};

let _coerce = fn(id: I32, context: I32): I32 {
  let ty = H.typeOf(id);
  if ((context < 0) || (ty == context)) { return id; }
  let expected = H.resolve(context);

  if (H.endsPath(id)) {
    H.retype(id, expected);
    return id;
  }
  if (H.unify(ty, expected) || H.isUnknown(expected)) { return id; }
  if (upcasts(ty, expected)) { return _unary(Op.Convert, expected, id); }

  if (H.holdsNull(expected)) {
    if (H.unify(ty, H.innerOf(expected))) { return _unary(Op.Present, H.resolve(expected), id); }
    let inner = H.isKind(expected, Kind.Null) ? H.resolve(H.innerOf(expected)) : -1;
    if (upcasts(ty, inner)) { return _unary(Op.Present, expected, _unary(Op.Convert, inner, id)); }
    let nulled = H.isKind(ty, Kind.Null) && (H.innerOf(ty) >= 0);

    if (nulled && upcasts(H.resolve(H.innerOf(ty)), inner)) {
      return _unary(Op.Convert, expected, id);
    }

    if (ty == H.TYPE_NULL) {
      let typed = _leaf(Op.Null, expected, 0);
      return match (H.opOf(id)) {
        Null => typed,
        _ => H.node(Op.Block, expected, 0, 1, [_unary(Op.Expression, 0, id), typed]),
      };
    }
  }
  if (H.isKind(ty, Kind.Null) && H.unify(H.innerOf(ty), expected)) { return _unwrap(id); }

  if (ty == H.TYPE_BYTE_BUFFER) {
    throw coded(E0411, `a buffer from Bytes.new is not ${H.typeName(expected)}${bufferHint(ty)}`);
  }

  if ((expected == H.TYPE_DYNAMIC) && (ty != H.TYPE_NULL)) {
    throw coded(E0404, "a value becomes Dynamic only with `as Dynamic`");
  }
  id
};

export let objectValue = fn(value: I32): I32 {
  H.isPrototype(H.typeOf(value)) ? _unary(Op.Convert, H.TYPE_OBJECT, value) : value
};

let _widens = fn(source: I32, target: I32): Bool {
  match ((H.kindOf(source), H.kindOf(target))) {
    (I8, I16), (I8, I32), (I8, I64), (I16, I32), (I16, I64), (I32, I64) => true,
    (U8, I16), (U8, U16), (U8, I32), (U8, U32), (U8, I64), (U8, U64) => true,
    (U16, I32), (U16, U32), (U16, I64), (U16, U64), (U32, I64), (U32, U64) => true,
    (F16, F32), (F16, F64), (F32, F64), (I8, F16), (U8, F16) => true,
    (I8, F32), (I16, F32), (U8, F32), (U16, F32) => true,
    (I8, F64), (I16, F64), (I32, F64), (U8, F64), (U16, F64), (U32, F64) => true,
    _ => false,
  }
};

export let widened = fn(value: I32, declared: I32): I32 {
  if (declared < 0) { return value; }
  let target = H.resolve(declared);
  let nullable = H.isKind(target, Kind.Null) && (H.innerOf(target) >= 0);
  let number = nullable ? H.resolve(H.innerOf(target)) : target;
  if (!_widens(H.resolve(H.typeOf(value)), number)) { return value; }
  let converted = _unary(Op.Convert, number, value);
  nullable ? _coerce(converted, target) : converted
};

export let fieldMismatch = fn(owner: I32, name: Bytes, ty: I32, value: I32): Bytes {
  let field = `field ${name} of ${H.typeName(owner)}`;
  coded(E0400, `${field} is ${H.typeName(ty)}, but this value is ${H.typeName(H.typeOf(value))}`)
};

let _presentAt = fn(id: I32, index: I32): I32 {
  let ty = H.typeOf(id);
  if (!H.isKind(ty, Kind.Null) || (H.innerOf(ty) < 0)) { return id; }
  let outer = enterSyntax(syntaxChild(index));
  let present = _unwrap(id);
  enterSyntax(outer);
  present
};
export let presentAt = fn(id: I32, index: I32): I32 { _presentAt(id, index) };

export let present = fn(id: I32): I32 {
  let ty = H.typeOf(id);
  H.isKind(ty, Kind.Null) && (H.innerOf(ty) >= 0) ? _unwrap(id) : id
};

let _coerceAt = fn(id: I32, expected: I32, index: I32): I32 {
  let outer = enterSyntax(syntaxChild(index));
  let coerced = _coerce(id, expected);
  enterSyntax(outer);
  coerced
};

export let coerceAt = fn(id: I32, expected: I32, index: I32): I32 {
  _coerceAt(id, expected, index)
};

export let coerceTail = fn(block: I32, ty: I32, tail: I32): I32 {
  if (H.typeOf(block) == ty) { return block; }

  if (H.endsPath(block)) {
    H.retype(block, ty);
    return block;
  }
  let children = H.children(block);
  children[children.len() - 1] = _coerceAt(children[children.len() - 1], ty, tail);
  H.node(Op.Block, ty, 0, 1, children)
};

export let unknownType = fn(what: Bytes): Bytes {
  coded(E0403, `the type of ${what} is not known here; annotate it`)
};

let _operand = fn(id: I32, expr: AstExpr, index: I32): I32 {
  if (H.isUnknown(H.typeOf(id))) {
    enterSyntax(syntaxChild(index));
    throw unknownType(match (expr) { Variable(name) => name, _ => "this value" });
  }
  id
};

let _value = fn(expr: AstExpr, index: I32, expected: I32): I32 {
  _operand(_presentAt(_checkExpr(expr, syntaxChild(index), expected), index), expr, index)
};

export let checkKnown = fn(expr: AstExpr, index: I32): I32 {
  _operand(_checkExpr(expr, syntaxChild(index), -1), expr, index)
};
export let checkPresent = fn(expr: AstExpr, index: I32): I32 { _value(expr, index, -1) };

export let checkPresentAs = fn(expr: AstExpr, index: I32, expected: I32): I32 {
  _value(expr, index, expected)
};

export let joinTypes = fn(a: I32, b: I32): I32 {
  if (H.unify(a, b)) { return H.resolve(a); }

  if ((a == H.TYPE_NULL) || (H.isKind(b, Kind.Null) && H.unify(H.innerOf(b), a))) {
    return H.nullable(b);
  }

  if ((b == H.TYPE_NULL) || (H.isKind(a, Kind.Null) && H.unify(H.innerOf(a), b))) {
    return H.nullable(a);
  }
  -1
};

export let joinBranches = fn(a: I32, b: I32): I32 {
  if (H.endsPath(b)) { return H.typeOf(a); }
  if (H.endsPath(a)) { return H.typeOf(b); }
  joinTypes(H.typeOf(a), H.typeOf(b))
};

let _unlifted = fn(id: I32): I32 {
  match (H.opOf(id)) {
    Present => H.childOf(id, 0),
    Local when (_known(id)) => {
      let { path, start, end } = H.spanOf(id);
      H.setSpan(path, start, end);
      let unwrapped = _unwrap(id);
      enterSyntax(_syntax);
      unwrapped
    },
    Block when (H.auxOf(id) == 1) => {
      let last = H.childCount(id) - 1;
      let value = _unlifted(H.childOf(id, last));
      if (value < 0) { return -1; }
      let rebuilt = H.children(id);
      rebuilt[last] = value;
      H.copyNode(id, H.typeOf(value), rebuilt)
    },
    If => _unliftedBranches(id, 1),
    Try => _unliftedBranches(id, 0),
    _ => -1,
  }
};

let _unliftedBranches = fn(id: I32, first: I32): I32 {
  let (one, other) = (H.childOf(id, first), H.childOf(id, first + 1));
  if (H.endsPath(one) && H.endsPath(other)) { return -1; }
  let oneValue = H.endsPath(one) ? one : _unlifted(one);
  let otherValue = H.endsPath(other) ? other : _unlifted(other);
  if ((oneValue < 0) || (otherValue < 0)) { return -1; }
  let ty = H.typeOf(H.endsPath(one) ? otherValue : oneValue);

  let typed = fn(branch: I32): I32 {
    H.endsPath(branch) ? H.copyNode(branch, ty, H.children(branch)) : branch
  };
  let rebuilt = H.children(id);
  rebuilt[first] = typed(oneValue);
  rebuilt[first + 1] = typed(otherValue);
  H.copyNode(id, ty, rebuilt)
};

export let unlift = fn(value: I32): I32 {
  let unlifted = _unlifted(value);
  unlifted < 0 ? value : unlifted
};

let _isNull = fn(value: AstExpr): Bool { match (value) { Null => true, _ => false } };

let _isValueEquality = fn(op: BinaryOp, left: AstExpr, right: AstExpr): Bool {
  match (op) { Equal, NotEqual => !_isNull(left) && !_isNull(right), _ => false }
};

let _narrowBy = fn(cond: AstExpr, present: Bool) {
  match (cond) {
    Binary(op, left, right) => {
      let tests = match (op) { NotEqual => present, Equal => !present, _ => false };

      let name = match (left) {
        Variable(found) when (_isNull(right)) => found,
        _ => match (right) { Variable(found) when (_isNull(left)) => found, _ => "" },
      };
      let found = (tests && (name != "")) ? _find(name, 0) : -1;
      let id = found >= 0 ? _ids[found] : -1;
      if ((id >= 0) && H.isKind(_typeOfBinding(id), Kind.Null)) { narrow(id, _mutable[id]); }
      null
    },
    _ => null,
  }
};

typedef OpenLiteral = {
  let id: I32;
  let text: Bytes;
  let negative: Bool;
};
let _literals = Array.new<OpenLiteral>(0);

let _openLiteral = fn(text: Bytes, negative: Bool, var: I32): I32 {
  let id = H.openLiteral(
    negative ? wideIntegerValue(text, true) : unsignedWideValue(text, false), var
  );
  _literals.push({ id, text, negative });
  id
};

let _typedLiteral = fn(text: Bytes, negative: Bool, ty: I32): I32 {
  match (H.kindOf(ty)) {
    I32 => _leaf(Op.I32, ty, integerValue(text, negative)),
    I64 => H.wideLiteral(wideIntegerValue(text, negative), ty),
    U64 => H.wideLiteral(unsignedWideValue(text, negative), ty),
    _ => {
      let least = H.leastValue(ty);
      let most = H.mostValue(ty);
      let range = `${H.typeName(ty)} (${least} to ${most})`;
      _leaf(Op.I32, ty, integerIn(text, negative, least, most, range) as I32)
    },
  }
};

export let sizedType = fn(size: IntSize, inferred: I32): I32 {
  match (size) {
    Infer => inferred, I32 => H.TYPE_I32, I64 => H.TYPE_I64,
    I8 => H.TYPE_I8, I16 => H.TYPE_I16, U8 => H.TYPE_U8,
    U16 => H.TYPE_U16, U32 => H.TYPE_U32, U64 => H.TYPE_U64,
  }
};

let _floatLiteral = fn(text: Bytes, negative: Bool, ty: I32): I32 {
  let written = negative ? `-${text}` : text;
  let pattern = ty == H.TYPE_F64 ? _f64Bits(written)
    : ((ty == H.TYPE_F32 ? _f32Bits(written) : _f16Bits(written)) as I64);
  let infinite = ty == H.TYPE_F64 ? (pattern & 9223372036854775807) == 9218868437227405312
    : ty == H.TYPE_F32 ? (pattern & 2147483647) == 2139095040 : (pattern & 32767) == 31744;

  if (infinite) {
    throw coded(E0007, `float literal ${written} is out of range for ${H.typeName(ty)}`);
  }
  H.floatLiteral(pattern, ty)
};

let _checkFloat = fn(text: Bytes, size: FloatSize, negative: Bool, expected: I32): I32 {
  let context = expected < 0 ? -1 : H.resolve(expected);

  let ty = match (size) {
    Infer => H.isFloatType(context) ? context : H.TYPE_F64,
    F16 => H.TYPE_F16,
    F32 => H.TYPE_F32,
    F64 => H.TYPE_F64,
  };
  _floatLiteral(text, negative, ty)
};

let _exactFloat = fn(text: Bytes, negative: Bool, ty: I32): I32 {
  let magnitude = negative ? -wideIntegerValue(text, true) : unsignedWideValue(text, false);
  let greatest = 9223372036854775807;
  let power = 0;
  let width = 0;

  while ((magnitude != 0) && ((magnitude & 1) == 0)) {
    magnitude = (magnitude >> 1) & greatest;
    power++;
  }
  let rest = magnitude;

  while (rest != 0) {
    rest = (rest >> 1) & greatest;
    width++;
  }
  let room = ty == H.TYPE_F64 ? 53 : ty == H.TYPE_F32 ? 24 : 11;

  if ((width > room) || ((ty == H.TYPE_F16) && (width + power > 16))) {
    throw coded(E0007,
      `integer literal ${negative ? "-" : ""}${text} is not exactly a value of ${H.typeName(ty)}`);
  }
  let digits = magnitude == 0 ? "0" : "";

  while (magnitude != 0) {
    digits = Bytes.slice("0123456789abcdef", (magnitude & 15) as I32, 1) + digits;
    magnitude = magnitude >> 4;
  }
  _floatLiteral(`0x${digits}p${power}`, negative && (digits != "0"), ty)
};

let _checkInteger = fn(text: Bytes, size: IntSize, negative: Bool, expected: I32): I32 {
  let context = expected < 0 ? -1 : H.resolve(expected);

  if (H.isFloatType(context) && match (size) { Infer => true, _ => false }) {
    return _exactFloat(text, negative, context);
  }

  let ty = match (size) {
    Infer =>
      H.isInteger(context) ? context
      : (context < 0) || H.isUnknown(context) ? H.integerVar()
      : H.TYPE_I32,
    _ => sizedType(size, -1),
  };
  H.isIntegerType(ty) ? _typedLiteral(text, negative, ty) : _openLiteral(text, negative, ty)
};

let _isNumber = fn(ty: I32): Bool { H.isInteger(ty) || H.isFloatType(H.resolve(ty)) };

let _checkUnary = fn(op: UnaryOp, value: AstExpr, expected: I32): I32 {
  match (op) {
    Negate => match (value) {
      Integer(digits, size) => _checkInteger(digits, size, true, expected),
      Float(text, size) => _checkFloat(text, size, true, expected),
      _ => {
        let operand = _value(value, 0, _isNumber(expected) ? expected : -1);
        let ty = H.typeOf(operand);

        if (!H.isInteger(ty) && !H.isFloatType(ty)) {
          throw coded(E0500, `negation requires a number operand, not ${H.typeName(ty)}`);
        }
        _unary(Op.Neg, ty, operand)
      },
    },
    _ => {
      let operand = _value(value, 0, -1);

      if (H.typeOf(operand) != H.TYPE_BOOL) {
        throw coded(E0500,
          `operator ! requires a Bool operand, not ${H.typeName(H.typeOf(operand))}`);
      }
      _unary(Op.Not, H.TYPE_BOOL, operand)
    },
  }
};

let _checkNullComparison = fn(op: BinaryOp, value: AstExpr, index: I32): I32 {
  let operand = checkOperand(value, index, -1);
  let ty = H.typeOf(operand);

  if (!H.holdsNull(ty) || (ty == H.TYPE_NULL)) {
    enterSyntax(syntaxChild(index));
    throw coded(E0408, `only Null<T> values can be compared with null, not ${H.typeName(ty)}`);
  }

  match (op) {
    Equal => _unary(Op.IsNull, H.TYPE_BOOL, operand),
    NotEqual => _unary(Op.IsPresent, H.TYPE_BOOL, operand),
    _ => { throw coded(E0408, "null supports only == and !=") },
  }
};

let _compare = fn(op: Op, left: I32, right: I32, negate: Bool): I32 {
  let compared = _binary(op, H.TYPE_BOOL, left, right);
  negate ? _unary(Op.Not, H.TYPE_BOOL, compared) : compared
};

export let isNullaryVariant = fn(id: I32): Bool {
  match (H.opOf(id)) { EnumNew => H.childCount(id) == 0, _ => false }
};

let _variantEquality = fn(op: BinaryOp, left: I32, right: I32): I32 {
  let negate = match (op) {
    Equal => false,
    NotEqual => true,
    _ => { throw coded(E0500, "enums support only == and !=") },
  };
  let variant = isNullaryVariant(right) ? right : left;
  let value = isNullaryVariant(right) ? left : right;
  _compare(
    Op.Eq, _unary(Op.EnumTag, H.TYPE_I32, value), _leaf(Op.I32, H.TYPE_I32, H.valueOf(variant)),
    negate
  )
};

let _operatorText = fn(op: BinaryOp): Bytes {
  match (op) {
    Add => "+", Subtract => "-", Multiply => "*", Divide => "/", Remainder => "%",
    ShiftLeft => "<<", ShiftRight => ">>", BitAnd => "&", BitOr => "|", BitXor => "^",
    Equal => "==", NotEqual => "!=",
    Less => "<", LessEqual => "<=", Greater => ">", GreaterEqual => ">=",
    And => "&&", Or => "||",
  }
};

let _bitwiseHint = fn(op: BinaryOp, left: I32, right: I32): Bytes {
  let leftBool = H.typeOf(left) == H.TYPE_BOOL;
  let rightBool = H.typeOf(right) == H.TYPE_BOOL;
  let logical = match (op) { BitAnd => "&&", BitOr => "||", BitXor => "!=", _ => "" };
  if ((logical == "") || (!leftBool && !rightBool)) { return ""; }
  leftBool && rightBool ? `; use ${logical} on Bool operands`
    : `; comparisons bind tighter, so write (a ${_operatorText(op)} b) == c`
};

let _floatBinary = fn(op: BinaryOp, ty: I32, left: I32, right: I32): I32 {
  let arithmetic = match (op) {
    Add => Op.Add,
    Subtract => Op.Sub,
    Multiply => Op.Mul,
    Divide => Op.Div,
    _ => Op.Eq,
  };
  if (arithmetic != Op.Eq) { return _binary(arithmetic, ty, left, right); }

  let comparison = match (op) {
    Equal, NotEqual => Op.Eq,
    Less => Op.Lt, LessEqual => Op.Le, Greater => Op.Gt, GreaterEqual => Op.Ge,
    _ => {
      throw coded(E0500, `operator ${_operatorText(op)} is not defined for ${H.typeName(ty)}`);
      Op.Eq
    },
  };
  _compare(comparison, left, right, match (op) { NotEqual => true, _ => false })
};

export let binaryValues = fn(op: BinaryOp, leftValue: I32, rightValue: I32): I32 {
  let objects = H.isObject(H.typeOf(leftValue)) && H.isObject(H.typeOf(rightValue));
  let left = objects ? objectValue(leftValue) : leftValue;
  let right = objects ? objectValue(rightValue) : rightValue;
  let leftType = H.typeOf(left);
  let rightType = H.typeOf(right);

  if (H.isOpen(leftType) || H.isOpen(rightType)) {
    if (H.isInteger(leftType) && H.isInteger(rightType)) {
      H.unify(leftType, rightType);
    } else {
      H.defaultIntegers(leftType);
      H.defaultIntegers(rightType);
    }
    leftType = H.typeOf(left);
    rightType = H.typeOf(right);
    if (H.holdsUnknown(leftType) || H.holdsUnknown(rightType)) { throw unknownType("this value"); }
  }

  if ((leftType == H.TYPE_BYTE_BUFFER) || (rightType == H.TYPE_BYTE_BUFFER)) {
    let hint = bufferHint(H.TYPE_BYTE_BUFFER);
    throw coded(E0500,
      `operator ${_operatorText(op)} is not defined for a buffer from Bytes.new${hint}`);
  }

  if ((leftType == H.TYPE_DYNAMIC) || (rightType == H.TYPE_DYNAMIC)) {
    throw coded(E0404, "a Dynamic value must be extracted with `as T` before use");
  }

  if ((leftType == H.TYPE_BYTES) && (rightType == H.TYPE_BYTES)) {
    return match (op) {
      Add => _binary(Op.BytesConcat, H.TYPE_BYTES, left, right),
      Equal => _binary(Op.BytesEq, H.TYPE_BOOL, left, right),
      NotEqual => _unary(Op.Not, H.TYPE_BOOL, _binary(Op.BytesEq, H.TYPE_BOOL, left, right)),
      _ => { throw coded(E0500, "Bytes support only +, == and !=") },
    };
  }
  let same = rightType == leftType;
  let equality = match (op) { Equal, NotEqual => true, _ => false };

  if (same && H.isEnum(leftType)
    && (isNullaryVariant(left) || isNullaryVariant(right) || !equality)) {
    return _variantEquality(op, left, right);
  }

  let structural = match (H.kindOf(leftType)) {
    Tuple, Enum, Applied, Record, Array, List => true,
    _ => false,
  };
  if (same && equality && structural) { return _structuralEquality(op, left, right); }
  let bools = (leftType == H.TYPE_BOOL) && (rightType == H.TYPE_BOOL);
  let atoms = (leftType == H.TYPE_ATOM) && (rightType == H.TYPE_ATOM);
  let identity = same && match (H.kindOf(leftType)) { Function, Object => true, _ => false };

  match (op) {
    And, Or => {
      if (!bools) { throw coded(E0500, "&& and || require Bool operands"); }
      return _binary(match (op) { And => Op.And, _ => Op.Or }, H.TYPE_BOOL, left, right);
    },
    Equal, NotEqual when (bools || atoms || identity) => {
      return _compare(Op.Eq, left, right, match (op) { NotEqual => true, _ => false });
    },
    _ when (atoms) => { throw coded(E0500, "atoms support only == and !=") },
    _ => null,
  };

  if (same && H.isKind(leftType, Kind.Param) && !H.isInteger(leftType)) {
    if (!equality || !H.hasBounds(leftType, H.BOUND_EQ)) {
      let bound = needsBound(leftType, equality ? "Eq" : "Integer");
      throw coded(E0501, `${_operatorText(op)} on ${H.typeName(leftType)} ${bound}`);
    }
    return _compare(Op.Eq, left, right, match (op) { NotEqual => true, _ => false });
  }
  let ty = leftType;

  if (!H.isInteger(ty) || (rightType != ty)) {
    if (H.isFloatType(ty) && (rightType == ty)) { return _floatBinary(op, ty, left, right); }
    let types = `${H.typeName(ty)} and ${H.typeName(rightType)}`;
    let hint = _bitwiseHint(op, left, right);
    throw coded(E0500, H.isInteger(ty) && H.isInteger(rightType)
      ? `integer operands must have the same type: ${types}`
      : H.isFloatType(ty) && H.isFloatType(rightType)
      ? `float operands must have the same type: ${types}`
      : `operator ${_operatorText(op)} is not defined for ${types}${hint}`);
  }

  match (op) {
    Add => _binary(Op.Add, ty, left, right),
    Subtract => _binary(Op.Sub, ty, left, right),
    Multiply => _binary(Op.Mul, ty, left, right),
    Divide => _binary(Op.Div, ty, left, right),
    Remainder => _binary(Op.Rem, ty, left, right),
    ShiftLeft => _binary(Op.Shl, ty, left, right),
    ShiftRight => _binary(Op.Shr, ty, left, right),
    BitAnd => _binary(Op.BitAnd, ty, left, right),
    BitOr => _binary(Op.BitOr, ty, left, right),
    BitXor => _binary(Op.BitXor, ty, left, right),
    Equal => _compare(Op.Eq, left, right, false),
    NotEqual => _compare(Op.Eq, left, right, true),
    Less => _compare(Op.Lt, left, right, false),
    LessEqual => _compare(Op.Gt, left, right, true),
    Greater => _compare(Op.Gt, left, right, false),
    GreaterEqual => _compare(Op.Lt, left, right, true),
    _ => { throw coded(E0900, `operator ${_operatorText(op)} is not supported yet`) },
  }
};

let _isOpenNumber = fn(expr: AstExpr): Bool {
  let literal = match (expr) {
    Unary(op, value) => match (op) { Negate => value, _ => expr },
    _ => expr,
  };

  match (literal) {
    Integer(_, size) => match (size) { Infer => true, _ => false },
    Float(_, size) => match (size) { Infer => true, _ => false },
    _ => false,
  }
};

let _checkBinary = fn(op: BinaryOp, leftExpr: AstExpr, rightExpr: AstExpr, expected: I32): I32 {
  let isEquality = match (op) { Equal, NotEqual => true, _ => false };

  if (isEquality && (_isNull(leftExpr) || _isNull(rightExpr))) {
    return _isNull(leftExpr) ? _checkNullComparison(op, rightExpr, 1)
      : _checkNullComparison(op, leftExpr, 0);
  }

  let arithmetic = match (op) {
    Add, Subtract, Multiply, Divide, Remainder => true,
    ShiftLeft, ShiftRight, BitAnd, BitOr, BitXor => true,
    _ => false,
  };
  let context = arithmetic && _isNumber(expected) ? expected : -1;
  let logical = match (op) { And, Or => true, _ => false };

  if ((context < 0) && _isOpenNumber(leftExpr) && !_isOpenNumber(rightExpr) && !logical) {
    let checkedRight = checkOperand(rightExpr, 1, -1);
    let rightType = H.typeOf(checkedRight);
    return binaryValues(
      op, _value(leftExpr, 0, H.isFloatType(rightType) ? rightType : -1), checkedRight
    );
  }
  let left = _value(leftExpr, 0, context);
  let before = narrowings();
  match (op) { And => _narrowBy(leftExpr, true), Or => _narrowBy(leftExpr, false), _ => null };
  let right = checkOperand(rightExpr, 1, H.typeOf(left) == H.TYPE_DYNAMIC ? -1 : H.typeOf(left));
  keepNarrowings(before);
  binaryValues(op, left, right)
};

let _functionType = fn(index: I32): I32 {
  if (_functions[index].ty < 0) { checkDirect(index); }
  touch(_functions[index].name);
  _functions[index].ty
};

let _receivers = fn(index: I32): I32 { _functions[index].methodKind >= 0 ? 1 : 0 };

let ownMethod = fn(ty: I32, name: Bytes): I32 {
  let declaring = _prototypeOf(ty);

  for (entry in _prototypeMethods) {
    if ((_functions[entry.function].methodKind == declaring) && (entry.field == name)) {
      return entry.function;
    }
  }
  -1
};

let _instanceMethod = fn(ty: I32, name: Bytes): I32 {
  for ({ function, field } in _instanceMethods) {
    if ((_functions[function].methodKind == ty) && (field == name)) { return function; }
  }
  -1
};

export let findMethod = fn(ty: I32, name: Bytes): I32 {
  let at = ty;
  let steps = 0;

  while ((at >= 0) && (steps <= _prototypes.len())) {
    let found = ownMethod(at, name);
    if (found >= 0) { return found; }
    at = prototypeParent(at);
    steps++;
  }
  -1
};

let _chainFind = fn(ty: I32, stop: (I32) -> Bool): I32 {
  let at = ty;
  let steps = 0;

  while ((at >= 0) && !stop(at) && (steps <= _prototypes.len())) {
    at = prototypeParent(at);
    steps++;
  }
  at
};

export let sealedPrototype = fn(ty: I32): Bool {
  let end = _chainFind(ty, fn(at) { H.isLinked(at) });
  (end >= 0) || (end == -1)
};

export let noteMethodCall = fn(call: I32, origin: I32, name: Bytes, exact: Bool): Bool {
  _methodCalls.push({ call, origin, name, exact });
  true
};

let _declaring = fn(ty: I32, name: Bytes): I32 {
  _chainFind(ty, fn(at) { ownMethod(at, name) >= 0 })
};

export let sealedMethod = fn(ty: I32, name: Bytes): Bool {
  let declaring = _declaring(ty, name);
  (declaring >= 0) && sealedPrototype(declaring)
};

let _overrides = fn(): Array<Tuple<I32, Bytes>> {
  let pairs = Array.new<Tuple<I32, Bytes>>(0);

  for ({ function, field } in _prototypeMethods) {
    let at = prototypeParent(_functions[function].methodKind);
    let steps = 0;

    while ((at >= 0) && (steps <= _prototypes.len())) {
      pairs.push((_prototypeOf(at), field));
      at = prototypeParent(at);
      steps++;
    }
    if (at == -1) { pairs.push((-1, field)); }
  }
  pairs
};

let _fixedMethod = fn(call: MethodCall, overrides: Array<Tuple<I32, Bytes>>): I32 {
  let start = H.resolve(call.origin);
  let declaring = _declaring(start, call.name);
  if ((declaring < 0) || !sealedPrototype(declaring)) { return -1; }
  let below = _prototypeOf(start);

  for ((over, name) in call.exact ? [] : overrides) {
    if (((over == below) || (over == -1)) && (name == call.name)) { return -1; }
  }
  let function = H.templateOf(declaring) < 0
    ? ownMethod(declaring, call.name)
    : _instanceMethod(declaring, call.name);
  (function < 0) || _functions[function].dropped ? -1 : function
};

export let prototypeMethod = fn(value: I32, name: Bytes): I32 {
  H.isPrototype(H.typeOf(value)) ? findMethod(H.typeOf(value), name) : -1
};

export let linkedMember = fn(ty: I32, name: Bytes): Tuple<I32, Bool> {
  let at = H.isPrototype(ty) ? ty : -1;
  let steps = 0;
  let closed = at >= 0;

  while ((at >= 0) && (steps <= _prototypes.len())) {
    let field = H.isLinked(at) ? H.recordField(at, name) : -1;
    if (field >= 0) { return (H.fieldType(at, 0, field), true); }
    closed = closed && H.isLinked(at);
    at = prototypeParent(at);
    steps++;
  }
  (-1, closed && (at == -2))
};

export let prototypeField = fn(ty: I32, name: Bytes): I32 {
  if (name == "__proto__") { return -1; }
  let (field, closed) = linkedMember(ty, name);
  if ((field < 0) && closed) { throw coded(E0800, `${H.typeName(ty)} has no field ${name}`); }
  field
};

export let receiverMethodType = fn(index: I32, ty: I32): I32 {
  let template = H.templateOf(ty);
  (template >= 0) && (template == _functions[index].methodKind)
    ? H.substitute(_functionType(index), H.enumParams(template), H.templateArgs(ty))
    : _functionType(index)
};

let _globalType = fn(id: I32): I32 {
  touch(H.globalNameOf(id));
  H.globalTypeOf(id)
};

let _enclosingFind = fn(name: Bytes): Tuple<I32, I32> {
  let nameId = H.findBytesId(name);
  let depth = _frames.len() - 1;

  while ((nameId >= 0) && (depth >= 0)) {
    let frame = _frames[depth];
    let i = frame.nameIds.len() - 1;
    while ((i >= 0) && (frame.nameIds[i] != nameId)) { i--; }
    let id = i >= 0 ? frame.ids[i] : -1;
    if (id >= 0) { return (depth, id); }
    depth--;
  }
  (-1, -1)
};
let _isLocal = fn(name: Bytes): Bool { (_find(name, 0) >= 0) || (_enclosingFind(name).0 >= 0) };

let _genericValue = fn(name: Bytes): Bytes {
  coded(E0602, `${name} is generic, so it can only be called`)
};

let _capture = fn(name: Bytes): I32 {
  let (depth, id) = _enclosingFind(name);
  if (depth < 0) { return -1; }
  touchLocal(id);

  if (depth < _captureFloor) {
    throw coded(E0308, `a generic local function cannot capture ${name}; pass it as an argument`);
  }
  if (_bindingTemplate(id) >= 0) { throw _genericValue(name); }
  let ty = _typeOfBinding(id);
  depth++;

  while (depth < _closures.len()) {
    let captures = _closures[depth].captures;
    let sources = _closures[depth].sources;
    let i = 0;
    while ((i < sources.len()) && (H.valueOf(sources[i]) != id)) { i++; }

    if (i == sources.len()) {
      sources.push(_leaf(Op.Local, ty, id));
      let copy = newBinding();
      _bindingTypes[copy] = ty;
      _mutable[copy] = _mutable[id];
      captures.push(H.node(Op.Capture, ty, copy, H.bytesId(name), []));
    }
    id = H.valueOf(captures[i]);
    depth++;
  }
  id
};

let _instanceGlobal = fn(ty: I32, depth: I32, need: Need): I32 {
  let at = _instanceTypes.indexOf(ty);
  if (at >= 0) { return _instances[at].global; }
  let global = H.declareGlobal(H.typeName(ty), ty, false);
  _instanceTypes.push(_heldFields(ty));
  _instances.push({ global, init: -1, nesting: depth + 1, need });
  global
};

export let prototypeGlobal = fn(ty: I32): I32 {
  let at = _prototypes.indexOf(ty);
  if (at >= 0) { return _prototypeInfos[at].global; }

  if (H.templateOf(ty) < 0) {
    internalError(`the module of prototype ${H.typeName(ty)} does not run`);
  }
  _instanceGlobal(ty, _instanceDepth, _needHere())
};

export let prototypeValue = fn(ty: I32): I32 {
  if (_templateBody) { return H.opNode(Op.ObjectNew, ty, []); }
  if (!H.isOpen(ty)) { return _leaf(Op.Global, ty, prototypeGlobal(ty)); }
  let read = _leaf(Op.Global, ty, -1);
  _openReads.push({ read, depth: _instanceDepth, need: _needHere() });
  read
};

let _prototypeBinding = fn(at: I32, name: Bytes): Binding {
  let global = _prototypeInfos[at].global;

  if (global < 0) {
    throw coded(E0602,
      `${name} is generic, so as a value it takes type arguments, as ${name}<...>`);
  }
  Binding.Global(global)
};

let _scoped = fn(name: Bytes, use: Bytes): Binding {
  let binding = scoped(name);

  match (binding) {
    Unbound => {
      let at = _prototypes.indexOf(scopedType(name));
      at >= 0 ? _prototypeBinding(at, name) : _aheadBinding(name, use)
    },
    _ => binding,
  }
};
let _moduleBinding = fn(name: Bytes): Binding { _isLocal(name) ? Binding.Unbound : scoped(name) };

export let isBound = fn(name: Bytes): Bool {
  _isLocal(name) || match (scoped(name)) { Unbound => false, _ => true }
};

let _isNamespace = fn(name: Bytes): Bool {
  match (_moduleBinding(name)) { Namespace(_, _) => true, _ => false }
};

let _isNamespaceCall = fn(callee: AstExpr): Bool {
  match (callee) { Member(Variable(space), _) => _isNamespace(space), _ => false }
};

let _inNamespace = fn(space: Bytes, name: Bytes): Binding {
  match (scoped(space)) {
    Namespace(module, path) => {
      let at = _prototypes.indexOf(exportedType(module, name));
      at >= 0 ? _prototypeBinding(at, name) : namespaceMember(module, path, name)
    },
    _ => Binding.Unbound,
  }
};

export let callFunction = fn(binding: Binding, name: Bytes, args: Array<I32>): I32 {
  match (binding) {
    Function(index) => H.node(Op.Call, H.innerOf(_functionType(index)), index + 1, 0, args),
    _ => { throw coded(E0601, `${name} is not a function`) },
  }
};

export let paramNames = fn(params: Array<I32>): Array<Bytes> { params.map(H.typeName) };

export let useTypeParams = fn(
  names: Array<Bytes>, types: Array<I32>
): Tuple<Array<Bytes>, Array<I32>> {
  let outer = (_envNames, _envTypes);
  _envNames = names;
  _envTypes = types;
  outer
};

export let generateFunction = fn(name: Bytes, params: Array<Bytes>, ty: I32): I32 {
  let types = Array.new<I32>(0);
  let i = 0;

  while (i < H.typeArgCount(ty)) {
    types.push(H.typeArg(ty, i));
    i++;
  }
  _functions.push({
    name, ty, params, node: -1, paramTypes: types, defaults: _NO_TYPES, syntax: _noSyntax(),
    dropped: false, methodKind: -1
  });
  _functions.len() - 1
};

export let generateClosure = fn(name: Bytes, params: Array<Bytes>, ty: I32): I32 {
  let index = generateFunction(name, params, ty);
  _functions[index].dropped = _templateBody;
  index
};

export let defineFunction = fn(index: I32, function: I32): Bool {
  _functions[index].node = function;
  true
};

export let bindingType = fn(binding: Binding): I32 {
  match (binding) {
    Global(id) => _globalType(id),
    Function(index) => _functionType(index),
    _ => -1,
  }
};

let _unknownName = fn(name: Bytes): Bytes {
  touch(name);
  name == "_" ? coded(E0301, "_ binds nothing, so it names no value")
    : scopedType(name) >= 0 ? coded(E0301, `${name} is a type, not a value`)
    : coded(E0300, `unknown name: ${name}`)
};

let _bindingValue = fn(binding: Binding, name: Bytes): I32 {
  match (binding) {
    Global(id) => {
      let constant = id < _globalConstants.len() ? _globalConstants[id] : -1;
      let ty = _globalType(id);
      constant >= 0 ? _copyConstant(constant, ty) : _leaf(Op.Global, ty, id)
    },
    Function(index) => _leaf(Op.FunctionRef, _functionType(index), index + 1),
    Loaded(_, _) => {
      throw coded(E0213,
        `native ${name} needs a typed binding first: let f: (Bytes) -> I32 = ${name};`);
      -1
    },
    Native(_) => {
      throw coded(E0602, `native ${name} can only be called; natives are not values yet`);
      -1
    },
    Namespace(_, _) => {
      throw coded(E0602,
        `${name} is a module namespace, not a value; name one of its exports, as in ${name}.x`);
      -1
    },
    Intrinsic(_, _) => {
      throw coded(E0602, `${name} is an assertion the compiler expands; it can only be called`);
      -1
    },
    Template(_) => { throw _genericValue(name) },
    Unbound => { throw _unknownName(name) },
  }
};

let _checkVariable = fn(name: Bytes): I32 {
  let found = _find(name, 0);
  if ((found >= 0) && (_bindingTemplate(_ids[found]) >= 0)) { throw _genericValue(name); }

  if (found >= 0) {
    touchLocal(_ids[found]);
    return _leaf(Op.Local, _typeOfBinding(_ids[found]), _ids[found]);
  }
  let captured = _capture(name);
  if (captured >= 0) { return _leaf(Op.Local, _typeOfBinding(captured), captured); }
  _bindingValue(_scoped(name, "read"), name)
};

export let checkPatternName = fn(name: Bytes, constant: Bool): I32 {
  if (constant) {
    let found = _find(name, 0);
    let local = found >= 0 ? _ids[found] : _enclosingFind(name).1;
    let mutable = local >= 0 ? (_mutable[local] ? 1 : 0) : match (_scoped(name, "read")) {
      Global(id) => H.globalIsMutable(id) ? 1 : 0,
      _ => -1,
    };
    if (mutable < 0) { return -1; }

    if (mutable > 0) {
      throw coded(E0705, `${name} can be assigned, so it is no constant; pin it as ^${name}`);
    }
  }
  _checkVariable(name)
};

export let hasSpread = fn(args: Array<AstExpr>): Bool {
  for (arg in args) {
    if (let Spread(_) = arg) {
      return true;
    }
  }
  false
};

export let hideValue = fn(statements: Array<I32>, name: Bytes, value: I32): I32 {
  let binding = newBinding();
  statements.push(H.declareBinding(Op.Const, binding, name, value));
  binding
};

export let spreadOperand = fn(
  operand: AstExpr, index: I32, expected: I32, tuple: Bool, array: Bool
): I32 {
  let outer = enterSyntax(syntaxChild(index));
  let checked = checkOperand(operand, 0, expected);
  enterSyntax(outer);
  let ty = H.typeOf(checked);

  if (!(tuple && H.isKind(ty, Kind.Tuple)) && !(array && H.isKind(ty, Kind.Array))) {
    enterSyntax(syntaxChild(index));
    let wanted = !array ? "a tuple" : !tuple ? "an array" : "a tuple or an array";
    throw coded(E0604, `spread operand must be ${wanted}, not ${H.typeName(ty)}`);
  }
  checked
};

let _spreadElements = fn(array: I32, index: I32, element: I32) {
  let wanted = H.arrayType(element);

  if (!H.unify(H.typeOf(array), wanted)) {
    let actual = H.typeName(H.typeOf(array));
    _rejectAt(index, coded(E0604, `spread operand must be ${H.typeName(wanted)}, not ${actual}`));
  }
  null
};

export let spreadArray = fn(operand: AstExpr, index: I32, element: I32): I32 {
  let array = spreadOperand(operand, index, element >= 0 ? H.arrayType(element) : -1, false, true);
  if (element >= 0) { _spreadElements(array, index, element); }
  array
};

export let tupleFields = fn(tuple: I32, index: I32, statements: Array<I32>): Array<I32> {
  let ty = H.typeOf(tuple);
  let binding = hideValue(statements, "tuple", tuple);
  let reads = Array.new<I32>(0);
  let field = 0;
  let outer = enterSyntax(syntaxChild(index));

  while (field < H.typeArgCount(ty)) {
    reads.push(H.node(Op.TupleField, H.typeArg(ty, field), field, 0, [H.local(binding, ty)]));
    field++;
  }
  enterSyntax(outer);
  reads
};

export let joinArrays = fn(parts: Array<I32>, run: Array<I32>, ty: I32): I32 {
  if ((run.len() > 0) || (parts.len() < 2)) { parts.push(H.opNode(Op.ArrayLiteral, ty, run)); }
  let joined = parts[0];
  let i = 1;

  while (i < parts.len()) {
    joined = H.opNode(Op.ArrayConcat, ty, [joined, parts[i]]);
    i++;
  }
  joined
};

export let declaredArgs = fn(ty: I32): Array<I32> {
  let types = Array.new<I32>(0);
  let i = 0;

  while (i < H.typeArgCount(ty)) {
    let param = H.slotType(H.typeArg(ty, i));
    types.push(H.isOpen(param) ? -1 : param);
    i++;
  }
  types
};

let _isConstant = fn(id: I32): Bool {
  match (H.opOf(id)) {
    Bool, I32, I64, Float, Bytes, Atom, Null => true,
    Global => !H.globalIsMutable(H.valueOf(id)),
    Convert, Neg, Present => _isConstant(H.childOf(id, 0)),
    _ => false,
  }
};

let _copyConstant = fn(id: I32, ty: I32): I32 {
  let children = Array.new<I32>(0);
  let i = 0;

  while (i < H.childCount(id)) {
    let child = H.childOf(id, i);
    children.push(_copyConstant(child, H.typeOf(child)));
    i++;
  }
  H.node(H.opOf(id), ty, H.valueOf(id), H.auxOf(id), children)
};

let _wrongArgument = fn(name: Bytes, what: Bytes): Bytes {
  name == "" ? `wrong indirect call argument ${what}` : `wrong argument ${what} for ${name}`
};

let _wrongCount = fn(name: Bytes): Bytes { coded(E0600, _wrongArgument(name, "count")) };

let _requiredCount = fn(function: I32, fixed: I32, index: I32): I32 {
  let required = fixed;

  while ((required > 0) && (H.kindOf(H.typeArg(function, required - 1)) == Kind.Optional)) {
    required--;
  }
  index >= 0 ? required - _functions[index].defaults.len() : required
};

let _omitted = fn(
  function: I32, index: I32, first: I32, required: I32, fixed: I32, children: Array<I32>
) {
  let defaults = index >= 0 ? _functions[index].defaults : _NO_TYPES;
  let i = first;

  while (i < fixed) {
    let at = i - required;
    let ty = H.slotType(H.typeArg(function, i));
    children.push(at < defaults.len() ? _copyConstant(defaults[at], ty) : _leaf(Op.Null, ty, 0));
    i++;
  }
};

let _spreadArguments = fn(
  function: I32, args: Array<AstExpr>, children: Array<I32>, name: Bytes, index: I32, receiver: I32,
  statements: Array<I32>
): Array<I32> {
  let fixed = H.typeArgCount(function);
  let element = -1;

  if ((fixed > 0) && (H.kindOf(H.typeArg(function, fixed - 1)) == Kind.Rest)) {
    fixed--;
    element = H.innerOf(H.typeArg(function, fixed));
  }
  let widths = declaredArgs(function);
  if (element >= 0) { widths[fixed] = H.isOpen(element) ? -1 : element; }
  let required = _requiredCount(function, fixed, index);
  let values = Array.new<I32>(0);
  let parts = Array.new<I32>(0);
  let run = Array.new<I32>(0);

  for (child in children) {
    values.push(H.local(hideValue(statements, "callee", child), H.typeOf(child)));
  }
  let base = values.len();

  if (receiver >= 0) {
    let first = _receiver(function, fixed, receiver, widths, name, index);
    values.push(H.local(hideValue(statements, "receiver", first), H.typeOf(first)));
  }

  for (i, expr in args) {
    let items = _NO_TYPES;
    let count = 1;

    match (expr) {
      Spread(operand) => {
        let spread = spreadOperand(operand, i + 1, -1, true, true);

        if (H.isKind(H.typeOf(spread), Kind.Tuple)) {
          items = tupleFields(spread, i + 1, statements);
        } else {
          if ((element < 0) || (values.len() - base < required)) { throw _wrongCount(name); }
          _spreadElements(spread, i + 1, element);
          _omitted(function, index, values.len() - base, required, fixed, values);

          if (run.len() > 0) {
            parts.push(H.opNode(Op.ArrayLiteral, H.arrayType(element), run));
            run = Array.new<I32>(0);
          }
          parts.push(H.local(hideValue(statements, "spread", spread), H.typeOf(spread)));
        }
        count = items.len();
      },
      _ => null,
    };
    let j = 0;

    while (j < count) {
      let at = values.len() - base;
      if ((element < 0) && (at >= fixed)) { throw _wrongCount(name); }
      let param = at < fixed ? at : fixed;
      let expected = at < fixed ? H.slotType(H.typeArg(function, at)) : element;
      let arg = items.len() > 0 ? _coerceAt(items[j], expected, i + 1)
        : _checkExpr(expr, syntaxChild(i + 1), expected);
      arg = widened(arg, widths[param]);

      if (!H.unify(H.typeOf(arg), expected)) {
        _rejectAt(
          i + 1,
          _argumentMismatch(_wrongArgument(name, "type"), index, param, expected, H.typeOf(arg))
        );
      }
      let value = H.local(hideValue(statements, "argument", arg), H.typeOf(arg));
      if (at < fixed) { values.push(value); } else { run.push(value); }
      j++;
    }
  }
  if (values.len() - base < required) { throw _wrongCount(name); }
  _omitted(function, index, values.len() - base, required, fixed, values);
  if (element >= 0) { values.push(joinArrays(parts, run, H.arrayType(element))); }
  values
};

let _receiver = fn(
  function: I32, fixed: I32, receiver: I32, widths: Array<I32>, name: Bytes, index: I32
): I32 {
  if (fixed == 0) { throw _wrongCount(name); }
  let expected = H.slotType(H.typeArg(function, 0));
  let first = widened(receiver, widths[0]);

  if (!H.unify(H.typeOf(first), expected)) {
    _rejectAt(
      0, _argumentMismatch(_wrongArgument(name, "type"), index, 0, expected, H.typeOf(first))
    );
  }
  first
};

let _arguments = fn(
  function: I32, args: Array<AstExpr>, children: Array<I32>, name: Bytes, index: I32, receiver: I32
): Array<I32> {
  let fixed = H.typeArgCount(function);
  let rest = (fixed > 0) && (H.kindOf(H.typeArg(function, fixed - 1)) == Kind.Rest);
  if (rest) { fixed--; }
  let skip = receiver >= 0 ? 1 : 0;
  let count = args.len() + skip;
  let required = count < fixed ? _requiredCount(function, fixed, index) : fixed;
  if ((count < required) || (!rest && (count > fixed))) { throw _wrongCount(name); }
  let declared = declaredArgs(function);
  let element = -1;
  let values = children;

  if (rest) {
    element = H.innerOf(H.typeArg(function, fixed));
    declared[fixed] = H.isOpen(element) ? -1 : element;
  }
  if (receiver >= 0) { children.push(_receiver(function, fixed, receiver, declared, name, index)); }

  for (i, expr in args) {
    let at = i + skip;
    let param = at < fixed ? at : fixed;
    let expected = declared[param];

    if (at >= fixed) {
      expected = element;
      if (at == fixed) { values = Array.new<I32>(0); }
    } else if (expected < 0) {
      expected = H.slotType(H.typeArg(function, at));
    }
    let arg = widened(_checkExpr(expr, syntaxChild(i + 1), expected), declared[param]);

    if (!H.unify(H.typeOf(arg), expected)) {
      _rejectAt(
        i + 1,
        _argumentMismatch(_wrongArgument(name, "type"), index, param, expected, H.typeOf(arg))
      );
    }
    values.push(arg);
  }
  if (count < fixed) { _omitted(function, index, count, required, fixed, children); }

  if (rest) {
    children.push(H.opNode(
      Op.ArrayLiteral, H.arrayType(element), count > fixed ? values : Array.new<I32>(0)
    ));
  }
  children
};

export let checkArguments = fn(function: I32, args: Array<AstExpr>, name: Bytes): Array<I32> {
  _arguments(function, args, Array.new<I32>(0), name, -1, -1)
};

let _call = fn(
  op: Op, value: I32, ty: I32, args: Array<AstExpr>, children: Array<I32>, name: Bytes, index: I32,
  receiver: I32
): I32 {
  if (!hasSpread(args)) {
    return H.node(
      op, H.innerOf(ty), value, 0, _arguments(ty, args, children, name, index, receiver)
    );
  }
  let statements = Array.new<I32>(0);
  statements.push(H.node(
    op, H.innerOf(ty), value, 0,
    _spreadArguments(ty, args, children, name, index, receiver, statements)
  ));
  H.node(Op.Block, H.innerOf(ty), 0, 1, statements)
};

let _argumentMismatch = fn(message: Bytes, index: I32, i: I32, expected: I32, actual: I32): Bytes {
  let declared: ?SourceSpan = null;
  let at = index >= 0 ? i - _receivers(index) : -1;

  if (at >= 0) {
    let params = _functions[index].syntax.children;
    if (at < params.len()) { declared = _spanOf(params[at]); }
  }
  let parameter = `${message}: the parameter is ${H.typeName(expected)}`;
  let failure = coded(E0400, `${parameter}, but this argument is ${H.typeName(actual)}`);
  noteFailure(declared, "the parameter is declared here", failure)
};

export let checkIndirectCall = fn(callee: I32, receiver: I32, args: Array<AstExpr>): I32 {
  let ty = H.typeOf(callee);
  if (!H.isKind(ty, Kind.Function)) { throw coded(E0601, "call target is not a function"); }
  _call(Op.CallIndirect, 0, ty, args, [callee], "", -1, receiver)
};

export let checkMethodCall = fn(callee: I32, index: I32, receiver: I32, args: Array<AstExpr>): I32 {
  _call(
    Op.CallIndirect, 0, H.typeOf(callee), args, [callee], _functions[index].name, index, receiver
  )
};

let _checkDirectCall = fn(index: I32, args: Array<AstExpr>, receiver: I32): I32 {
  let ty = _functionType(index);
  _call(Op.Call, index + 1, ty, args, [], _functions[index].name, index, receiver)
};

let _checkNativeCall = fn(native: I32, name: Bytes, args: Array<AstExpr>, receiver: I32): I32 {
  let ty = H.nativeTypeOf(native);
  _call(Op.CallNative, native, ty, args, [], name, -1, receiver)
};

let _checkTypeArgs = fn(t: I32, name: Bytes, types: Array<I32>) {
  let params = _templates[t].params;

  for (i, typeArg in types) {
    let ty = H.resolve(typeArg);
    let param = params[i];
    let paramName = H.typeName(param);
    let missing = H.isUnknown(ty) ? ""
      : H.hasBounds(param, H.BOUND_INTEGER) && !H.isInteger(ty) ? "Integer"
      : H.hasBounds(param, H.BOUND_EQ) && (_unsupported(ty, false) >= 0) ? "Eq"
      : H.hasBounds(param, H.BOUND_SHOW) && (_unsupported(ty, true) >= 0) ? "Show" : "";

    if (missing != "") {
      throw coded(E0501,
        `${H.typeName(ty)} does not satisfy the bound ${missing} of ${paramName} in ${name}`);
    }

    if (H.isNulled(param)) {
      if (H.isKind(ty, Kind.Param)) { H.nullType(ty); }

      if (H.isKind(ty, Kind.List) || H.holdsNull(ty)) {
        let used = `${paramName} is used as Null<${paramName}> in ${name}`;
        throw coded(E0408, `${used}, so it cannot be ${H.typeName(ty)}`);
      }
    }
  }
  null
};

let _defersResult = fn(ty: I32, expected: I32): Bool {
  let result = H.innerOf(ty);
  if ((expected < 0) || !H.isKind(expected, Kind.Null) || !H.isUnknown(result)) { return false; }
  let held = false;
  let i = 0;

  while (!held && (i < H.typeArgCount(ty))) {
    let param = H.typeArg(ty, i);
    held = !H.isKind(param, Kind.Function) && H.occursWithin(result, param);
    i++;
  }
  held
};

let _instanceType = fn(
  params: Array<I32>, function: I32, name: Bytes, typeArgs: Array<AstType>, expected: I32,
  checked: I32
): Tuple<Array<I32>, I32, Bool> {
  if ((typeArgs.len() != 0) && (typeArgs.len() != params.len())) {
    throw _arityMismatch(name, params.len(), typeArgs.len());
  }
  let types = _checkTypes(typeArgs);
  if (checked >= 0) { types.push(H.innerOf(H.typeOf(checked))); }
  while (types.len() < params.len()) { types.push(H.newVar(false)); }
  let ty = H.substitute(function, params, types);
  let deferred = _defersResult(ty, expected);
  if ((expected >= 0) && !deferred) { H.unify(H.innerOf(ty), expected); }
  (types, ty, deferred)
};

export let checkInstance = fn(
  params: Array<I32>, function: I32, name: Bytes, typeArgs: Array<AstType>, args: Array<AstExpr>,
  expected: I32, messages: Array<Bytes>, checked: I32, at: I32
): Tuple<Array<I32>, I32, Array<I32>> {
  let (types, ty, deferred) = _instanceType(params, function, name, typeArgs, expected, checked);
  let count = H.typeArgCount(ty);
  let shift = count - args.len();
  if ((checked < 0) && (shift != 0)) { throw _wrongCount(name); }
  let declared = declaredArgs(ty);
  let children = Array.new<I32>(0);
  let p = 0;

  while (p < count) {
    if ((checked >= 0) && (p == at)) {
      children.push(checked);
    } else {
      let param = H.typeArg(ty, p);
      let arg = widened(
        _checkExpr(args[p - shift], syntaxChild(p - shift + 1), param), declared[p]
      );

      if (!H.unify(H.typeOf(arg), param)) {
        let message = messages[p < messages.len() ? p : messages.len() - 1];

        if (Bytes.get_u8(message, message.len() - 1) == 32) {
          message += H.typeName(param);
        } else if (H.kindOf(H.resolve(H.typeOf(arg))) == H.kindOf(H.resolve(param))) {
          message = `${name} requires ${H.typeName(param)}, not ${H.typeName(H.typeOf(arg))}`;
        }
        _rejectAt(p - shift + 1, coded(E0400, message));
      }
      children.push(arg);
    }
    p++;
  }
  if (deferred) { H.unify(H.innerOf(ty), expected); }
  (types, ty, children)
};

let _checkGenericCall = fn(
  t: I32, name: Bytes, typeArgs: Array<AstType>, args: Array<AstExpr>, expected: I32, receiver: I32
): I32 {
  _checkTemplate(t, false);
  let index = _templates[t].checker;
  let (types, ty, deferred) =
    _instanceType(_templates[t].params, _functions[index].ty, name, typeArgs, expected, -1);
  let made = _call(Op.Call, 0, ty, args, [], name, index, receiver);
  let call = H.opOf(made) == Op.Block ? H.lastChild(made) : made;
  if (deferred) { H.unify(H.innerOf(ty), expected); }
  _checkTypeArgs(t, name, types);

  if (!_templateBody) {
    _pending.push({ call, template: t, types, depth: _instanceDepth + 1, need: _needHere() });
  }
  made
};

let _localTemplate = fn(name: Bytes): I32 {
  let found = _find(name, 0);
  let id = found >= 0 ? _ids[found] : _enclosingFind(name).1;
  id >= 0 ? _bindingTemplate(id) : -1
};

let _declareTemplate = fn(t: I32) {
  _declare(_templates[t].name, -2 - t, false);
  null
};

let _plainCall = fn(typeArgs: Array<AstType>) {
  if (typeArgs.len() != 0) {
    throw coded(E0402, "only a generic function takes type arguments");
  }
  null
};

export let checkFunctionCall = fn(
  binding: Binding, name: Bytes, typeArgs: Array<AstType>, receiver: I32, args: Array<AstExpr>,
  expected: I32
): I32 {
  match (binding) {
    Template(t) => _checkGenericCall(t, name, typeArgs, args, expected, receiver),
    Function(index) => {
      _plainCall(typeArgs);
      _checkDirectCall(index, args, receiver)
    },
    Native(native) => {
      _plainCall(typeArgs);
      _checkNativeCall(native, name, args, receiver)
    },
    _ => {
      throw coded(E0601, `${name} is not a function; an extension module exports functions`);
      -1
    },
  }
};

let _checkBindingCall = fn(
  binding: Binding, name: Bytes, callee: AstExpr, typeArgs: Array<AstType>, args: Array<AstExpr>,
  expected: I32
): I32 {
  let t = match (binding) { Unbound => _localTemplate(name), _ => -1 };
  if (t >= 0) { return _checkGenericCall(t, name, typeArgs, args, expected, -1); }

  match (binding) {
    Template(_), Function(_), Native(_) =>
      checkFunctionCall(binding, name, typeArgs, -1, args, expected),
    Intrinsic(module, assertion) => {
      _plainCall(typeArgs);
      _checkAssertion(module, assertion, name, args)
    },
    _ => {
      _plainCall(typeArgs);
      checkIndirectCall(_value(callee, 0, -1), -1, args)
    },
  }
};

let _checkCall = fn(
  callee: AstExpr, typeArgs: Array<AstType>, args: Array<AstExpr>, expected: I32
): I32 {
  match (callee) {
    Variable(name) =>
      _checkBindingCall(_moduleBinding(name), name, callee, typeArgs, args, expected),
    Member(Variable(space), name) => {
      let qualified = `${space}.${name}`;
      _checkBindingCall(_inNamespace(space, name), qualified, callee, typeArgs, args, expected)
    },
    _ => _checkBindingCall(Binding.Unbound, "", callee, typeArgs, args, expected),
  }
};

export let branchMismatch = fn(what: Bytes, first: I32, second: I32, child: I32): Bytes {
  if (child >= 0) { enterSyntax(syntaxChild(child)); }
  let firstName = H.typeName(first);
  let secondName = H.typeName(second);
  let message = `${what} must have the same type, not ${firstName} and ${secondName}`;
  let dynamic = H.resolve(first) == H.TYPE_DYNAMIC;
  let oneDynamic = dynamic != (H.resolve(second) == H.TYPE_DYNAMIC);

  if (oneDynamic && !H.isUnknown(dynamic ? second : first)) {
    let other = dynamic ? secondName : firstName;
    message += "; a Dynamic value becomes " + other + " only with `as " + other + "`";
  }
  coded(E0400, message)
};

export let requireBool = fn(what: Bytes, condition: I32, index: I32) {
  let ty = H.typeOf(condition);

  if (ty != H.TYPE_BOOL) {
    _rejectAt(index, coded(E0400, `${what} condition must be Bool, not ${H.typeName(ty)}`));
  }
  null
};

export let testsPattern = fn(condition: AstExpr): Bool {
  match (condition) {
    LetExpr(_, _, _, _) => true,
    Binary(And, left, right), Binary(Or, left, right) => testsPattern(left) || testsPattern(right),
    Unary(Not, inner) => testsPattern(inner),
    _ => false,
  }
};

let _isBlock = fn(expr: AstExpr): Bool { match (expr) { BlockExpr(_) => true, _ => false } };

let _checkCondition = fn(condition: AstExpr, what: Bytes, block: Bool): CheckedCondition {
  if (block && testsPattern(condition)) { return _checkLetCondition(condition, what); }
  let checked = _value(condition, 0, -1);
  requireBool(what, checked, 0);
  (Array.new<I32>(0), checked, _NO_NAMES, _noReads)
};

let _after = fn(declarations: Array<I32>, last: I32, value: Bool): I32 {
  if (declarations.len() == 0) { return last; }
  declarations.push(last);
  H.node(Op.Block, value ? H.typeOf(last) : 0, 0, value ? 1 : 0, declarations)
};

export let mayBeNull = fn(value: AstExpr): Bool {
  match (value) {
    Bytes(_), RegExp(_, _), Atom(_), Bool(_), Integer(_, _), Float(_, _), Null => false,
    Array(_), List(_), Tuple(_), Object(_), Bits(_), Interpolation(_, _), New(_, _) => false,
    Function(_, _, _, _), Unary(_, _), Binary(_, _, _), IncDec(_, _, _), Is(_, _) => false,
    _ => true,
  }
};

let _checkIf = fn(
  condition: AstExpr, thenBranch: AstExpr, elseBranch: AstExpr, expected: I32
): I32 {
  let (declarations, checkedCondition, names, reads) =
    _checkCondition(condition, "if", _isBlock(thenBranch));
  let before = narrowings();
  _narrowBy(condition, true);
  let checkedThen = _checkThen(thenBranch, names, reads, expected, false);
  let afterThen = narrowings();
  let thenType = H.typeOf(checkedThen);
  let free = (expected >= 0) || H.isKind(thenType, Kind.Null) || (thenType == H.TYPE_DYNAMIC)
    || H.isUnknown(thenType);
  let lifts = !free && mayBeNull(elseBranch) && !H.isKind(thenType, Kind.List)
    && !H.isKind(thenType, Kind.Param);
  let elseContext = free ? expected : lifts ? H.nullable(thenType) : thenType;
  setNarrowings(before);
  _narrowBy(condition, false);
  let elseValue = checkOperand(elseBranch, 2, elseContext);
  let checkedElse = lifts ? unlift(elseValue) : elseValue;
  keepNarrowings(afterThen);
  let ty = joinBranches(checkedThen, checkedElse);

  if (ty < 0) {
    enterSyntax(syntaxChild(2));

    let tail = match (elseBranch) {
      BlockExpr({ statements, tail }) => tail == null ? -1 : statements.len(),
      _ => -1,
    };
    throw branchMismatch("if branches", H.typeOf(checkedThen), H.typeOf(checkedElse), tail);
  }
  let branches = [checkedCondition, _coerceAt(checkedThen, ty, 1), _coerceAt(checkedElse, ty, 2)];
  _after(declarations, H.opNode(Op.If, ty, branches), true)
};

let _importedTarget = fn(name: Bytes): Bytes {
  coded(E0303, `cannot assign to imported binding: ${name}`)
};

let _assignable = fn(name: Bytes): Tuple<Bool, I32, I32> {
  let found = _find(name, 0);
  let (_, outer) = found >= 0 ? (0, _ids[found]) : _enclosingFind(name);

  if (outer >= 0) {
    touchLocal(outer);
    if (!_mutable[outer]) { throw coded(E0303, `cannot assign to immutable local: ${name}`); }
    let id = found >= 0 ? outer : _capture(name);
    return (false, id, _typeOfBinding(id));
  }

  let id = match (_scoped(name, "assigned")) {
    Global(target) => target,
    Function(_), Template(_) => { throw coded(E0303, `cannot assign to function: ${name}`) },
    Intrinsic(_, _) => { throw coded(E0303, `cannot assign to assertion: ${name}`) },
    Loaded(_, _), Native(_) => { throw coded(E0303, `cannot assign to native: ${name}`) },
    Namespace(_, _) => { throw coded(E0303, `cannot assign to module namespace: ${name}`) },
    Unbound => { throw _unknownName(name) },
  };
  if (isImported(name)) { throw _importedTarget(name); }
  if (!H.globalIsMutable(id)) { throw coded(E0303, `cannot assign to immutable global: ${name}`); }
  (true, id, _globalType(id))
};

let _checkVariableAssignment = fn(op: AssignOp, name: Bytes, value: AstExpr): I32 {
  let (global, id, declared) = _assignable(name);
  let operand = checkOperand(value, 1, declared);
  let checked = match (op) { Assign => widened(operand, declared), _ => operand };
  let fits = H.unify(H.typeOf(checked), declared);
  let ty = H.resolve(declared);
  let assign = global ? Op.SetGlobal : Op.Assign;

  if (!fits) {
    let assigned = H.typeName(H.typeOf(checked));
    let message =
      coded(E0400, `${name} is ${H.typeName(declared)}, but the value assigned is ${assigned}`);
    let declaration = _spanOf(global ? _globalDeclarations[id] : _declarations[id]);
    _rejectAt(1, noteFailure(declaration, `${name} is declared here`, message));
    return H.node(assign, ty, id, 0, [checked]);
  }

  if (!global && H.isKind(ty, Kind.Null)) {
    let present = match (H.opOf(checked)) { Present => true, _ => false };
    assignLocal(id, (H.typeOf(checked) == ty) && present);
  }

  match (op) {
    Assign => H.node(assign, ty, id, 0, [checked]),
    Compound(binary) => {
      let outer = enterSyntax(syntaxChild(0));
      let target = _leaf(global ? Op.Global : Op.Local, ty, id);
      enterSyntax(outer);
      H.node(assign, ty, id, 0, [binaryValues(binary, target, checked)])
    },
  }
};

let _rejectNamespaceTarget = fn(target: AstExpr): Bool {
  match (target) {
    Member(Variable(space), name) when (_isNamespace(space)) => {
      _inNamespace(space, name);
      throw _importedTarget(`${space}.${name}`);
      false
    },
    _ => true,
  }
};

let _checkAssignment = fn(expr: AstExpr, op: AssignOp, target: AstExpr, value: AstExpr): I32 {
  _rejectNamespaceTarget(target);

  match (target) {
    Variable(name) => _checkVariableAssignment(op, name, value),
    Index(_, _), Member(_, _) => _checkAggregate(expr, -1),
    _ => { throw coded(E0103, "only a variable, an element or a field can be assigned") },
  }
};

export let one = fn(ty: I32): I32 { _checkInteger("1", IntSize.Infer, false, ty) };

export let integerLiteral = fn(digits: Bytes, negative: Bool, ty: I32): I32 {
  _checkInteger(digits, IntSize.Infer, negative, ty)
};

export let floatLiteral = fn(text: Bytes, size: FloatSize, negative: Bool, ty: I32): I32 {
  _checkFloat(text, size, negative, ty)
};

let _conversions = Array.new<I32>(0);

export let integerConversion = fn(value: I32, target: I32): I32 {
  let id = _unary(Op.Convert, target, value);
  _conversions.push(id);
  id
};

let _checkIncDec = fn(op: IncDecOp, prefix: Bool, target: AstExpr, discarded: Bool): I32 {
  _rejectNamespaceTarget(target);

  if (match (target) { Index(_, _), Member(_, _) => true, _ => false }) {
    return _checkAggregate(AstExpr.IncDec(op, prefix || discarded, target), -1);
  }

  let name = match (target) {
    Variable(found) => found,
    _ => {
      throw coded(E0103, "only a variable, an element or a field can be incremented or decremented")
    },
  };
  let (global, id, ty) = _assignable(name);

  if (!H.isInteger(ty)) {
    throw coded(E0500, `increment and decrement require an integer variable: ${name}`);
  }
  let outer = enterSyntax(syntaxChild(0));
  let current = _leaf(global ? Op.Global : Op.Local, ty, id);
  enterSyntax(outer);
  let increment = match (op) { Increment => true, _ => false };
  let updated = H.node(
    global ? Op.SetGlobal : Op.Assign, ty, id, 0,
    [_binary(increment ? Op.Add : Op.Sub, ty, current, one(ty))]
  );
  if (prefix || discarded) { return updated; }
  _binary(increment ? Op.Sub : Op.Add, ty, updated, one(ty))
};

export let prototypeNamed = fn(expr: AstExpr): I32 {
  let ty = match (expr) {
    Variable(name) => _isLocal(name) ? -1 : scopedType(name),
    Member(Variable(space), name) when (_isNamespace(space)) => match (scoped(space)) {
      Namespace(module, _) => exportedType(module, name),
      _ => -1,
    },
    _ => -1,
  };
  H.isPrototype(ty) ? ty : -1
};

let _regexpKeys = Array.new<Bytes>(0);
let _regexpGlobals = Array.new<I32>(0);
let _regexpInits = Array.new<I32>(0);
let _regexpChecked = Array.new<Bytes>(0);

export let regexpGlobal = fn(pattern: Bytes, flags: Bytes): I32 {
  let key = `${flags}/${pattern}`;

  if (_regexpChecked.indexOf(key) < 0) {
    let problem = _regexpProblem(pattern, flags);
    if (problem != "") { throw coded(E0809, problem); }
    _regexpChecked.push(key);
  }
  if (_templateBody) { return 0; }
  let found = _regexpKeys.indexOf(key);
  if (found >= 0) { return _regexpGlobals[found]; }
  let global = H.declareGlobal(`~r/${pattern}/${flags}`, H.TYPE_DYNAMIC, false);
  let compile = H.stdNative("regexp_compile", [H.TYPE_BYTES, H.TYPE_BYTES], H.TYPE_DYNAMIC);
  let compiled = H.node(
    Op.CallNative, H.TYPE_DYNAMIC, compile, 0,
    [
      _leaf(Op.Bytes, H.TYPE_BYTES, H.bytesId(pattern)),
      _leaf(Op.Bytes, H.TYPE_BYTES, H.bytesId(flags))
    ]
  );
  _regexpInits.push(H.opNode(
    Op.Declare, 0, [H.node(Op.InitGlobal, H.TYPE_DYNAMIC, global, 0, [compiled])]
  ));
  _regexpKeys.push(key);
  _regexpGlobals.push(global);
  global
};

export let takeRegexpInits = fn(): Array<I32> {
  let inits = _regexpInits;
  _regexpKeys = Array.new<Bytes>(0);
  _regexpGlobals = Array.new<I32>(0);
  _regexpInits = Array.new<I32>(0);
  inits
};

let _unsupportedExpr = fn(expr: AstExpr): Bytes {
  let feature = match (expr) {
    LetExpr(_, _, _, _) => {
      return coded(E0109, "a `let` test can only be the condition of an `if` or a `while`");
      ""
    },
    Spread(_) => "a spread here is",
    TypeApply(_, _) => "type application outside a call is",
    With(_, _, _) => "`with` expressions are",
    Await(_) => "`await` is",
    Quote(_, _) => {
      return coded(E1001, "quote is only allowed in a macro body");
      ""
    },
    Unquote(_) => {
      return coded(E1001, "unquote is only allowed inside a quote");
      ""
    },
    _ => "this expression is",
  };
  coded(E0900, `${feature} not supported yet`)
};

export let unsupportedStatement = fn(statement: Stmt): Bytes {
  let feature = match (statement) {
    Prototype(_, _, _, _) => "prototypes declared inside a function are",
    Typedef(_, _, _, _) => "typedefs declared inside a function are",
    Macro(_, _, _, _) => {
      return coded(E1000, "a macro is defined only at the top level of a module");
      ""
    },
    ImportModule(_, _, _), ImportFrom(_, _, _) => "imports inside a function are",
    Enum(_, _, _, _) => "enums declared inside a function are",
    LetStmt(_, _, _, _, _, _, _) => "exports inside a function are",
    Return(_) => {
      return coded(E0307, "return outside a function");
      ""
    },
    Break => {
      return coded(E0307, "break outside loop");
      ""
    },
    Continue => {
      return coded(E0307, "continue outside loop");
      ""
    },
    _ => "this statement is",
  };
  coded(E0900, `${feature} not supported yet`)
};

let _checkPipe = fn(value: AstExpr, body: AstExpr, topic: Bool, expected: I32): I32 {
  let checked = checkOperand(value, 0, -1);
  let mark = _nameIds.len();
  let declared = H.declareBinding(Op.Const, _declare("%", H.typeOf(checked), false), "%", checked);
  let syntax = syntaxChild(1);
  let piped = body;

  if (!topic) {
    match (body) {
      Call(callee, typeArgs, args) => {
        let withTopic = [AstExpr.Topic];
        withTopic.appendFrom(args, 0);
        piped = AstExpr.Call(callee, typeArgs, withTopic);
        let shifted = [syntax.children[0], _spanSyntax(syntax.path, syntax.start, syntax.end)];
        shifted.appendFrom(syntax.children, 1);
        syntax = _withChildren(syntax, shifted);
      },
      _ => {
        enterSyntax(syntax);
        throw coded(E0413, "a pipeline body that does not use % must be a call");
      },
    };
  }
  let result = _checkExpr(piped, syntax, expected);
  _popTo(mark);
  H.node(Op.Block, H.typeOf(result), 0, 1, [declared, result])
};

let _checkCoalesce = fn(value: AstExpr, fallback: AstExpr, expected: I32): I32 {
  let checked = checkOperand(value, 0, -1);
  let ty = H.typeOf(checked);

  if (H.isUnknown(ty)) {
    enterSyntax(syntaxChild(0));
    throw coded(E0408, "?? needs a value of known type; annotate the result it comes from");
  }

  let before = narrowings();
  let checkedFallback = checkOperand(fallback, 1, expected);
  keepNarrowings(before);
  if (!H.holdsNull(ty)) { return checked; }

  let mark = _nameIds.len();
  let binding = _declare("??", ty, false);
  let declared = H.declareBinding(Op.Const, binding, "??", checked);

  let result = if (ty == H.TYPE_NULL) {
    checkedFallback
  } else {
    let outer = enterSyntax(syntaxChild(0));
    let isNull = _unary(Op.IsNull, H.TYPE_BOOL, _leaf(Op.Local, ty, binding));
    let held = _leaf(Op.Local, ty, binding);
    let present = H.isKind(ty, Kind.Null) ? H.node(Op.Unwrap, H.innerOf(ty), 0, 0, [held]) : held;
    enterSyntax(outer);
    let joined = joinBranches(checkedFallback, present);

    if (joined < 0) {
      throw branchMismatch("?? operands", H.typeOf(present), H.typeOf(checkedFallback), 1);
    }
    let branches = [isNull, _coerceAt(checkedFallback, joined, 1), _coerceAt(present, joined, 0)];
    H.opNode(Op.If, joined, branches)
  };
  _popTo(mark);
  H.node(Op.Block, H.typeOf(result), 0, 1, [declared, result])
};

let _checkExpr = fn(expr: AstExpr, syntax: Syntax, expected: I32): I32 {
  let outer = enterSyntax(syntax);
  let literal = H.isKind(expected, Kind.Null) ? H.innerOf(expected) : expected;

  let id = match (expr) {
    _ when (_isEnumExpr(expr)) => _checkEnum(expr, expected, false),
    Bytes(value) => _leaf(Op.Bytes, H.TYPE_BYTES, H.bytesId(value)),
    RegExp(pattern, flags) => _leaf(Op.Global, H.TYPE_DYNAMIC, regexpGlobal(pattern, flags)),
    Bool(value) => _leaf(Op.Bool, H.TYPE_BOOL, value ? 1 : 0),
    Null => _leaf(Op.Null, H.holdsNull(expected) ? expected : H.TYPE_NULL, 0),
    Integer(digits, size) => _checkInteger(digits, size, false, literal),
    Float(text, size) => _checkFloat(text, size, false, literal),
    Unary(op, value) => _checkUnary(op, value, literal),
    Binary(op, left, right) when (_isValueEquality(op, left, right)) => _checkValue(expr, expected),
    Binary(op, left, right) => _checkBinary(op, left, right, literal),
    Cast(_, _), Is(_, _) => _checkValue(expr, expected),
    Variable(name) => _checkVariable(name),
    TypeApply(base, types) when (prototypeNamed(base) >= 0) => {
      let named = prototypeNamed(base);
      checkTypeArgCount(H.typeName(named), named, types.len());
      prototypeValue(_heldFields(H.appliedType(named, _checkTypes(types))))
    },
    Topic => _checkVariable("%"),
    Pipe(value, body, topic) => _checkPipe(value, body, topic, expected),
    Coalesce(value, fallback) => _checkCoalesce(value, fallback, expected),
    Member(Variable(space), name) when (_isNamespace(space)) =>
      _bindingValue(_inNamespace(space, name), `${space}.${name}`),
    Tuple(_), Array(_), List(_), Interpolation(_, _), Member(_, _), Index(_, _), Bits(_) =>
      _checkAggregate(expr, literal),
    Call(callee, typeArgs, args) when (_isNamespaceCall(callee)) =>
      _checkCall(callee, typeArgs, args, expected),
    Call(Member(_, _), _, _), Call(TypeApply(_, _), _, _) => _checkAggregate(expr, literal),
    Call(callee, typeArgs, args) => _checkCall(callee, typeArgs, args, expected),
    Object(_) => _checkAggregate(expr, H.isRecord(H.resolve(literal)) ? H.resolve(literal) : -1),
    If(_, _, elseBranch) when (_isNull(elseBranch)) => {
      throw coded(E0410, "an if used as a value needs an else branch")
    },
    If(condition, thenBranch, elseBranch), Conditional(condition, thenBranch, elseBranch) =>
      _checkIf(condition, thenBranch, elseBranch, expected),
    Try(body, catchName, handler) => _checkTry(body, catchName, handler, expected, false),
    IncDec(op, prefix, target) => _checkIncDec(op, prefix, target, false),
    BlockExpr({ statements, tail }) => {
      let checked = _checkBlock(statements, tail, expected);

      if ((tail == null) && !H.endsPath(checked)) {
        throw coded(E0410, "value block requires a trailing expression");
      }
      checked
    },
    Assign(op, target, value) => _checkAssignment(expr, op, target, value),
    Function(params, result, body, isMethod) =>
      _checkFunctionLiteral(params, result, body, literal, isMethod),
    This => {
      requireThis("`this`");
      _checkVariable("this")
    },
    New(_, _), Super => _checkAggregate(expr, expected),
    Atom(name) => _leaf(Op.Atom, H.TYPE_ATOM, H.bytesId(name)),
    _ => { throw _unsupportedExpr(expr) },
  };
  let coerced = _coerce(id, expected);
  enterSyntax(outer);
  coerced
};

let _isFunctionValue = fn(value: AstExpr): Bool {
  match (value) { Function(_, _, _, isMethod) => !isMethod, _ => false }
};

export let isTemplate = fn(statement: Stmt): Bool {
  match (statement) {
    LetStmt(_, _, pattern, typeParams, annotation, value, _) =>
      (typeParams.len() != 0) && isBindPattern(pattern) && (annotation == null)
      && _isFunctionValue(value),
    _ => false,
  }
};

export let isDirectFunction = fn(index: I32): Bool { _directLets[index] };

let _notConstant = fn(name: Bytes): Bytes {
  enterSyntax(syntaxChild(0));
  coded(E0603, `the default of ${name} must be a constant`)
};

export let patternNames = fn(pattern: Pattern): Array<Bytes> {
  let names = Array.new<Bytes>(0);
  let patterns = [pattern];

  while (patterns.len() > 0) {
    let next = patterns[patterns.len() - 1];
    patterns.pop();

    match (next) {
      BindPattern(name) => names.push(name),
      Object(fields) => {
        for ((_, field) in fields) {
          patterns.push(field);
        }
        null
      },
      Tuple(items), Array(items), Enum(_, items) => {
        patterns.appendFrom(items, 0);
        null
      },
      RegExp(_, _, binding), IsType(_, binding), Spread(binding) => {
        if (binding != null) { names.push(binding); } null
      },
      _ => null,
    };
  }
  names
};

let _bindingStatement = fn(name: Bytes): I32 {
  for (i, statement in _statements) {
    match (statement) {
      LetStmt(_, _, pattern, _, _, _, _) => {
        let binds = isBindPattern(pattern) ? bindPatternName(pattern) == name
          : patternNames(pattern).indexOf(name) >= 0;
        if (binds) { return i; }
      },
      _ => null,
    };
  }
  -1
};

let _constantValue = fn(value: AstExpr, param: Bytes): AstExpr {
  let found = value;
  let steps = 0;

  while (steps <= _statements.len()) {
    let name = match (found) { Variable(name) => name, _ => { return found; } };
    let at = isBound(name) ? -1 : _bindingStatement(name);
    if (at < 0) { return found; }

    match (_statements[at]) {
      LetStmt(isConst, _, pattern, _, _, init, _) => {
        if (!isConst || !isBindPattern(pattern)) { throw _notConstant(param); }
        found = init;
      },
      _ => null,
    };
    steps++;
  }
  found
};

let _checkDefault = fn(name: Bytes, ty: I32, kind: ParameterKind): I32 {
  let value = match (kind) { Default(value) => value, Optional(value) => value, _ => null };
  if (value == null) { return -1; }
  let optional = match (kind) { Optional(_) => true, _ => false };

  if (!optional && H.isKind(ty, Kind.Null)) {
    let inner = H.typeName(H.innerOf(ty));
    throw coded(E0603, `a parameter with a default cannot be nullable; write ?${name}: ${inner}`);
  }

  if (!optional && _isNull(value)) {
    throw coded(E0603, `the default of ${name} cannot be null; write ?${name}: ${H.typeName(ty)}`);
  }
  let checked = widened(checkOperand(_constantValue(value, name), 0, ty), ty);

  if (!H.unify(H.typeOf(checked), ty)) {
    enterSyntax(syntaxChild(0));
    throw coded(E0400,
      `the default of ${name} must be ${H.typeName(ty)}, not ${H.typeName(H.typeOf(checked))}`);
  }
  if (!_isConstant(checked)) { throw _notConstant(name); }
  checked
};

let _paramType = fn(kind: ParameterKind, declared: I32): I32 {
  match (kind) {
    Varargs => H.restType(declared),
    Optional(value) => value == null ? H.optionalType(declared) : H.nullType(declared),
    _ => declared,
  }
};

let _paramRank = fn(kind: ParameterKind): I32 {
  match (kind) {
    Required => 0,
    Default(_) => 1,
    Optional(value) => value == null ? 2 : 1,
    Varargs => 3,
  }
};

let _fitsParams = fn(params: Array<Parameter>, expected: I32): Bool {
  if (!H.isKind(expected, Kind.Function) || (H.typeArgCount(expected) != params.len())) {
    return false;
  }

  for (i, param in params) {
    let kind = H.kindOf(H.typeArg(expected, i));
    let wraps = (kind == Kind.Optional) ? 2 : (kind == Kind.Rest) ? 3 : 0;
    let rank = _paramRank(param.kind);
    if ((rank < 2 ? 0 : rank) != wraps) { return false; }
  }
  true
};

let _withDefault = fn(defaults: Array<I32>, value: I32): Array<I32> {
  let table = defaults.len() == 0 ? Array.new<I32>(0) : defaults;
  table.push(value);
  table
};

let _addFunction = fn(
  name: Bytes, params: Array<Parameter>, result: ?AstType, expected: I32, syntax: Syntax, kind: I32
): I32 {
  let fits = _fitsParams(params, expected);
  let names = Array.new<Bytes>(0);
  let types = Array.new<I32>(0);
  let defaults = _NO_TYPES;
  let rank = 0;
  let outer = _syntax;

  if (kind >= 0) {
    names.push("this");
    types.push(H.isTemplateEnum(kind) ? H.appliedType(kind, H.enumParams(kind)) : kind);
  }

  for (i, { name: paramName, annotation: paramType, kind } in params) {
    enterSyntax(syntax.children[i]);

    if ((paramName != "_") && (names.indexOf(paramName) >= 0)) {
      throw coded(E0302, `duplicate parameter: ${paramName}`);
    }
    let own = _paramRank(kind);

    if (own < rank) {
      throw coded(E0102,
        own == 0 ? `required parameter ${paramName} cannot follow an optional one`
        : `parameter ${paramName} with a default cannot follow an optional one without`);
    }
    rank = own;
    let ty = paramType != null ? _paramType(kind, checkType(paramType))
      : fits && (own != 3) ? H.typeArg(expected, i)
      : -1;

    if ((ty < 0) && H.isKind(expected, Kind.Function) && (H.typeArgCount(expected) < params.len())
      && H.isKind(H.innerOf(expected), Kind.Function)) {
      enterSyntax(outer);
      throw coded(E0108,
        "chained arrow types are not curried; use parentheses for multi-arg fn types");
    }

    if (ty < 0) {
      throw coded(E0403,
        own == 3 ? `variadic parameter ${paramName} needs a type`
        : `parameter ${paramName} of ${name} needs a type`);
    }
    if (own == 1) { defaults = _withDefault(defaults, _checkDefault(paramName, ty, kind)); }
    names.push(paramName);
    types.push(ty);
  }
  enterSyntax(outer);
  let resultType = result != null ? _resultType(result) : fits ? H.innerOf(expected) : -1;
  _functions.push({
    name, ty: resultType < 0 ? -1 : H.functionType(types, resultType), params: names, node: -1,
    paramTypes: types, defaults, syntax, dropped: _templateBody, methodKind: kind
  });
  _functions.len() - 1
};

let _declareFunction = fn(
  name: Bytes, annotation: ?AstType, value: AstExpr, assigned: Array<Bytes>
): Bool {
  let Function(params, result, _, false) = value else { return false; };

  if (annotation == null) {
    let index = _addFunction(name, params, result, -1, syntaxChild(0), -1);
    declareScoped(name, Binding.Function(index));
    return true;
  }
  if (assigned.indexOf(name) >= 0) { return false; }

  try {
    let expected = checkType(annotation);
    if (!_fitsParams(params, expected)) { return false; }
    let index = _addFunction(name, params, result, expected, syntaxChild(0), -1);

    if (_functions[index].ty != expected) {
      _functions.pop();
      return false;
    }
    declareScoped(name, Binding.Function(index));
    true
  } catch (_) {
    false
  }
};

let _assignedFunctions = fn(statements: Array<Stmt>): Array<Bytes> {
  let candidates = Array.new<Bytes>(0);

  for (statement in statements) {
    match (statement) {
      LetStmt(_, _, BindPattern(name), _, annotation, Function(_, _, _, false), _)
        when (annotation != null) => { candidates.push(name); },
      _ => {},
    };
  }
  let assigned = Array.new<Bytes>(0);
  if (candidates.len() == 0) { return assigned; }

  let note = fn(target: AstExpr) {
    if (let Variable(name) = target) {
      if (candidates.indexOf(name) >= 0) { assigned.push(name); }
    };
  };
  rewrite(Located.Statements(statements, _syntax.children), fn(node: Located): ?Located {
    match (node) {
      Expression(Assign(_, target, _), _), Expression(IncDec(_, _, target), _) => note(target),
      _ => {},
    };
    null
  });
  assigned
};

let _declarePrototype = fn(statement: I32, name: Bytes, ty: I32, fields: Array<PrototypeField>) {
  let parent = -2;
  let typeParams = H.enumParams(ty);
  let generic = typeParams.len() > 0;
  _prototypes.push(ty);
  let info: PrototypeInfo = {
    global: generic ? -1 : declareStatementGlobal(name, ty, false), parent: -2
  };
  _prototypeInfos.push(info);

  if (generic) {
    _generics.push(ty);
    _genericPrototypes.push({
      module: currentModule(), statement: _statements[statement], syntax: _syntax, placeholder: -1
    });
  }
  let (outerNames, outerTypes) = useTypeParams(paramNames(typeParams), typeParams);
  let failure: ?Bytes = null;

  try {
    for (f, member in fields) {
      match (member) {
        { name: field, value: Function(params, result, _, true) } => {
          let index = _addFunction(`${name}.${field}`, params, result, -1, syntaxChild(f), ty);
          _functions[index].dropped = generic;
          _prototypeMethods.push({ function: index, field });
          _directStatements.push(statement);
          _directFields.push(f);
        },
        { name: "__proto__", value } => {
          let other = match (value) { Variable(proto) => scopedType(proto), _ => -1 };
          let named = H.isPrototype(other) && !H.isTemplateEnum(other);
          parent = match (value) { Null => -2, _ => named ? other : -1 };
        },
        { name: "init" } => {
          _initFields.push(ty);
          null
        },
        _ => null,
      };
    }
  } catch (e) { failure = Std.string(e); }
  useTypeParams(outerNames, outerTypes);
  info.parent = parent;
  if (failure != null) { throw failure; }
  null
};

let _bound = fn(bound: Bytes): I32 {
  match (bound) {
    "Eq" => H.BOUND_EQ, "Show" => H.BOUND_SHOW, "Integer" => H.BOUND_INTEGER,
    _ => { throw coded(E0501, `unknown bound ${bound}: the bounds are Eq, Show and Integer`) },
  }
};

let _isTypeName = fn(name: Bytes): Bool {
  match (name) {
    "I32", "I64", "Bool", "Bytes", "Dynamic", "Null", "Array", "List", "Tuple", "Atom" => true,
    "I8", "I16", "U8", "U16", "U32", "U64", "F16", "F32", "F64" => true,
    _ => scopedType(name) >= 0,
  }
};

export let checkTypeParams = fn(typeParams: Array<TypeParam>, bounded: Bool): Array<I32> {
  let params = Array.new<I32>(0);
  let names = Array.new<Bytes>(0);
  let path = _syntax.path;

  for ({ name: param, bounds, start, end } in typeParams) {
    let outer = enterSyntax(_spanSyntax(path, start, end));

    if (_isTypeName(param)) {
      throw coded(E0305, `type parameter ${param} hides the type ${param}`);
    }

    if (!bounded && (bounds.len() != 0)) {
      throw coded(E0501, "only a function's type parameters take bounds");
    }
    if (names.indexOf(param) >= 0) { throw coded(E0302, `duplicate type parameter: ${param}`); }
    let required = 0;

    for (bound in bounds) {
      required = required | _bound(bound);
    }
    params.push(H.newParam(param, required));
    names.push(param);
    enterSyntax(outer);
  }
  params
};

let _newTemplate = fn(
  name: Bytes, typeParams: Array<TypeParam>, value: AstExpr, syntax: Syntax, bodyName: Bytes
): I32 {
  let params = checkTypeParams(typeParams, true);
  let names = paramNames(params);
  let all = _envNames.copy().appendFrom(names, 0);
  _templates.push({
    name, params, value, syntax, module: currentModule(), bodyName, names: all,
    envTypes: _envTypes, locals: Array.new<I32>(0), keys: Array.new<I32>(0),
    functions: Array.new<I32>(0), checker: -1
  });
  _templates.len() - 1
};

export let declareStatementGlobal = fn(name: Bytes, ty: I32, mutable: Bool): I32 {
  let global = H.declareGlobal(name, ty, mutable);
  while (_globalDeclarations.len() <= global) { _globalDeclarations.push(_noSyntax()); }
  _globalDeclarations[global] = _syntax;
  global
};

export let declareFunctions = fn(statements: Array<Stmt>): I32 {
  let first = _functions.len();
  let assigned = _assignedFunctions(statements);
  _moduleSyntax = _syntax;
  _statements = statements;
  _directLets = Array.new<Bool>(0);
  _directStatements = Array.new<I32>(0);
  _firstDirect = first;
  _directFields = Array.new<I32>(0);
  _globals = Array.new<I32>(0);

  for (i, statement in statements) {
    let outer = enterSyntax(syntaxChild(i));

    let direct = match (statement) {
      LetStmt(_, _, pattern, typeParams, _, value, _) when (isTemplate(statement)) => {
        let name = bindPatternName(pattern);
        declareScoped(
          name, Binding.Template(_newTemplate(name, typeParams, value, syntaxChild(0), name))
        );
        false
      },
      LetStmt(_, _, pattern, typeParams, annotation, value, _)
        when ((typeParams.len() == 0) && isBindPattern(pattern)) =>
        _declareFunction(bindPatternName(pattern), annotation, value, assigned),
      _ => false,
    };
    _directLets.push(direct);

    if (direct) {
      _directStatements.push(i);
      _directFields.push(-1);
    }
    _globals.push(-1);
    enterSyntax(outer);
  }

  for (i, statement in statements) {
    match (statement) {
      Prototype(_, name, _, fields) when (H.isPrototype(scopedType(name))) => {
        let outer = enterSyntax(syntaxChild(i));
        _declarePrototype(i, name, scopedType(name), fields);
        enterSyntax(outer);
      },
      _ => null,
    };
  }
  first
};

export let isLoaded = fn(value: AstExpr): Bool {
  match (value) {
    Variable(name) => match (scoped(name)) { Loaded(_, _) => true, _ => false },
    _ => false,
  }
};

export let annotatedGlobal = fn(statement: I32): I32 {
  if (_globals[statement] < 0) {
    match (_statements[statement]) {
      LetStmt(isConst, _, pattern, _, annotation, _, _) => {
        let outer = enterSyntax(_moduleSyntax.children[statement]);
        let name = bindPatternName(pattern);
        let global = declareStatementGlobal(name, checkAnnotation(annotation), !isConst);
        declareScoped(name, Binding.Global(global));
        _globals[statement] = global;
        enterSyntax(outer);
      },
      _ => internalError("a binding expected"),
    };
  }
  _globals[statement]
};

let _aheadBinding = fn(name: Bytes, use: Bytes): Binding {
  if ((name == "_") || (_bodyName == "") || (_frames.len() == 0)) { return Binding.Unbound; }
  let i = _bindingStatement(name);
  if ((i < 0) || isDirectFunction(i)) { return Binding.Unbound; }

  match (_statements[i]) {
    LetStmt(_, _, pattern, _, annotation, value, _) when (!isLoaded(value)) => {
      let bound = isBindPattern(pattern);

      if (!bound || (annotation == null)) {
        let ahead = `${name} is ${use} by ${_bodyName} before`;
        throw coded(E0304, !bound
          ? ahead + " the `let` that destructures it is checked; move that `let` earlier"
          : `${ahead} ${name}'s initialiser is checked; annotate ${name}`);
      }
      Binding.Global(annotatedGlobal(i))
    },
    _ => Binding.Unbound,
  }
};

typedef Inferred = {
  let what: Bytes;
  let syntax: Syntax;
  let ty: I32;
};
let _inferred = Array.new<Inferred>(0);

export let inferLater = fn(what: Bytes, ty: I32): Bool {
  _inferred.push({ what, syntax: _syntax, ty });
  true
};

let _annotationMismatch = fn(name: Bytes, annotated: I32, actual: I32): Bytes {
  coded(E0400,
    `${name} is annotated ${H.typeName(annotated)}, but its value is ${H.typeName(actual)}`)
};

let checkInitializer = fn(value: AstExpr, ty: I32, name: Bytes): Tuple<I32, Bool> {
  let outerDoubt = beginDoubt();
  let checked = widened(checkOperand(value, 0, ty), ty);
  let valueType = H.typeOf(checked);
  let suspect = endDoubt(outerDoubt) || touched();

  if ((ty >= 0) && ((valueType == H.TYPE_NULL) || !H.unify(valueType, ty))) {
    _rejectAt(0, valueType == H.TYPE_NULL
      ? coded(E0408, `only Null<T> can hold null, not ${H.typeName(ty)}`)
      : _annotationMismatch(name, ty, valueType));
    return (_leaf(Op.Null, H.resolve(ty), 0), false);
  }
  if (valueType == H.TYPE_NULL) { checked = _coerce(checked, H.nullType(H.newVar(true))); }

  if (H.holdsUnknown(H.typeOf(checked))) {
    _inferred.push({ what: name, syntax: syntaxPattern(0), ty: H.typeOf(checked) });
  }
  (checked, suspect && (ty < 0))
};

export let checkGlobalInitializer = fn(value: AstExpr, ty: I32, name: Bytes): Tuple<I32, Bool> {
  _bodyName = name;
  let result = checkInitializer(value, ty, name);
  _bodyName = "";
  result
};

let _requireFresh = fn(name: Bytes) {
  if (_find(name, _scopeStart) >= 0) { throw coded(E0302, `duplicate local: ${name}`); } null
};

let _checkLocal = fn(
  pattern: Pattern, isConst: Bool, typeParams: Array<TypeParam>, annotation: ?AstType,
  value: AstExpr
): I32 {
  let name = bindPatternName(pattern);

  if (typeParams.len() != 0) {
    throw coded(E0605, "local bindings do not support type parameters");
  }
  _requireFresh(name);
  let annotated = checkAnnotation(annotation);
  let own = _literalType(value, annotated);
  if ((own >= 0) && !_names(value, name)) { own = -1; }
  let early = own >= 0 ? _declare(name, own, !isConst) : -1;
  let (checked, suspect) = checkInitializer(value, own >= 0 ? own : annotated, name);
  let ty = H.typeOf(checked);
  let binding = early >= 0 ? early : _declare(name, ty, !isConst);
  if (suspect) { poisonLocal(binding); }
  match (H.opOf(checked)) { Present => narrow(binding, !isConst), _ => false };
  H.node(isConst ? Op.Const : Op.Let, ty, binding, H.bytesId(name), [checked])
};

let _names = fn(value: AstExpr, name: Bytes): Bool {
  let found = false;
  rewrite(Located.Expression(value, syntaxChild(0)), fn(node: Located): ?Located {
    match (node) {
      Expression(Variable(read), _) when (read == name) => { found = true; },
      _ => {},
    };
    null
  });
  found
};

let _literalType = fn(value: AstExpr, annotated: I32): I32 {
  let params = Array.new<Parameter>(0);
  let result: ?AstType = null;
  let literal = false;

  match (value) {
    Function(written, returned, _, false) => {
      params = written;
      result = returned;
      literal = true;
    },
    _ => {},
  };
  if (!literal) { return -1; }
  if (annotated >= 0) { return H.isKind(annotated, Kind.Function) ? annotated : -1; }
  let types = Array.new<I32>(0);
  let known = true;
  let i = 0;

  while (known && (i < params.len())) {
    let { annotation: written, kind } = params[i];

    if ((written == null) || (_paramRank(kind) != 0)) {
      known = false;
    } else {
      try { types.push(checkType(written)); } catch { known = false; }
    }
    i++;
  }
  if (!known) { return -1; }
  if (result == null) { return H.functionType(types, H.newVar(false)); }
  try { H.functionType(types, checkType(result)) } catch { -1 }
};

let _nullResult = fn(message: Bytes): I32 {
  let fits = (_result < 0) || (_result == H.TYPE_NULL)
    || (_resultInferred && H.holdsNull(H.resolve(_result)));
  if (!fits) { throw coded(E0400, message + H.typeName(_result)); }
  if (_result < 0) { _result = H.TYPE_NULL; }
  let value = _leaf(Op.Null, H.TYPE_NULL, 0);
  if (_resultInferred) { _results.push(value); }
  value
};

let _checkResult = fn(value: AstExpr, index: I32): I32 {
  let checked = checkOperand(value, index, _result);
  if (!_resultInferred) { checked = widened(checked, _result); }
  let ty = H.typeOf(checked);
  let joined = _result < 0 ? ty
    : _resultInferred ? joinTypes(ty, _result)
    : H.unify(ty, _result) ? _result
    : -1;

  if (joined < 0) {
    let returns = _result == H.TYPE_NULL ? "no value" : H.typeName(_result);
    let message =
      coded(E0400, `the function returns ${returns}, but this value is ${H.typeName(ty)}`);
    _rejectAt(index, noteFailure(_spanOf(_resultSyntax), "the function is declared here", message));
  } else { _result = joined; }
  if (_resultInferred) { _results.push(checked); }
  checked
};

export let enterNode = fn(id: I32): Syntax {
  let { path, start, end } = H.spanOf(id);
  enterSyntax(_spanSyntax(path, start, end))
};

let _rebuild = fn(id: I32, ty: I32, first: I32, results: Array<Bool>): I32 {
  if (id < first) { return id; }
  let children = Array.new<I32>(0);
  let changed = false;
  let i = 0;

  while (i < H.childCount(id)) {
    let child = H.childOf(id, i);
    children.push(_rebuild(child, ty, first, results));
    changed = changed || (children[i] != child);
    i++;
  }
  let tail = match (H.opOf(id)) { Block => H.auxOf(id) == 1, _ => false };
  let rebuilt = !changed ? id
    : H.copyNode(id, tail ? H.typeOf(children[children.len() - 1]) : H.typeOf(id), children);
  if (!results[id - first] || (H.typeOf(rebuilt) == ty)) { return rebuilt; }
  let outer = enterNode(id);
  let converted = _coerce(rebuilt, ty);
  enterSyntax(outer);
  converted
};

let _joinResults = fn(body: I32): I32 {
  let ty = H.resolve(_result);
  let first = -1;
  let i = _resultsStart;

  while (i < _results.len()) {
    if ((H.typeOf(_results[i]) != ty) && ((first < 0) || (_results[i] < first))) {
      first = _results[i];
    }
    i++;
  }
  if (first < 0) { return body; }
  let marks = Array.new<Bool>(body - first + 1);
  i = _resultsStart;

  while (i < _results.len()) {
    if (_results[i] >= first) { marks[_results[i] - first] = true; }
    i++;
  }
  _rebuild(body, ty, first, marks)
};

export let checkEffect = fn(value: AstExpr, index: I32): I32 {
  match (value) {
    If(condition, thenBranch, elseBranch) => {
      let outer = enterSyntax(syntaxChild(index));
      let id = _checkIfStatement(condition, thenBranch, elseBranch);
      enterSyntax(outer);
      id
    },
    Match(_, _) => {
      let outer = enterSyntax(syntaxChild(index));
      let id = _checkEnum(value, -1, true);
      enterSyntax(outer);
      id
    },
    Try(body, catchName, handler) => {
      let outer = enterSyntax(syntaxChild(index));
      let id = _checkTry(body, catchName, handler, -1, true);
      enterSyntax(outer);
      id
    },
    IncDec(op, prefix, target) => {
      let outer = enterSyntax(syntaxChild(index));
      let id = _unary(Op.Expression, 0, _checkIncDec(op, prefix, target, true));
      enterSyntax(outer);
      id
    },
    BlockExpr(_) => _checkBranch(value, index),
    _ => _unary(Op.Expression, 0, checkOperand(value, index, -1)),
  }
};

enum Tail {
  Statement;
  Value;
  Result;
}

export let poisonDeclared = fn(statement: Stmt, local: Bool): Bool {
  let names = match (statement) {
    LetStmt(_, _, pattern, _, _, _, _) => patternNames(pattern),
    Prototype(_, name, _, _), Typedef(_, name, _, _), Macro(_, name, _, _) => {
      if (!local) { poison(name); }
      Array.new<Bytes>(0)
    },
    _ => Array.new<Bytes>(0),
  };

  for (name in names) {
    if (!local) {
      poison(name);
    } else if (_find(name, _scopeStart) < 0) {
      poisonLocal(_declare(name, H.newVar(false), false));
    }
  }
  true
};

let _recoverStatement = fn(
  error: Dynamic, syntax: Syntax, scopeStart: I32, loops: I32, barrier: Bytes, tries: I32,
  mark: I32, last: Bool
): I32 {
  recover(error);
  _popTo(mark);
  enterSyntax(syntax);
  _scopeStart = scopeStart;
  _loops = loops;
  _barrier = barrier;
  _tries = tries;
  last ? _unary(Op.Throw, 0, _leaf(Op.Null, H.TYPE_NULL, 0)) : H.opNode(Op.Block, 0, [])
};

let _valueless = fn(expr: AstExpr): Bool {
  match (expr) {
    BlockExpr({ tail }) => tail == null,
    If(_, thenBranch, elseBranch) =>
      _valueless(thenBranch) && (_isNull(elseBranch) || _valueless(elseBranch)),
    Try(body, _, handler) => (body.tail == null) && (handler.tail == null),
    _ => false,
  }
};

let _checkBlockBody = fn(
  prefix: Array<I32>,
  statements: Array<Stmt>,
  tail: ?AstExpr,
  first: I32,
  expected: I32,
  tailKind: Tail
): I32 {
  let isResult = tailKind == Tail.Result;
  let isStatement = tailKind == Tail.Statement;

  let outerStart = _scopeStart;
  _scopeStart = isResult ? 0 : _nameIds.len();
  let before = narrowings();

  let children = prefix;
  let ends = false;
  let syntax = _syntax;
  let scope = _scopeStart;
  let loops = _loops;
  let barrier = _barrier;
  let tries = _tries;

  for (i, stmt in statements) {
    if (ends) {
      enterSyntax(syntaxChild(first + i));
      throw coded(E0701, "unreachable statement");
    }
    let mark = _nameIds.len();
    let outerTouched = beginTouch();
    let outerDoubt = beginDoubt();

    try {
      let statement = _checkStatement(stmt, syntaxChild(first + i));
      ends = H.endsPath(statement);
      children.push(statement);
    } catch (e) {
      let last = !isStatement && (i + 1 == statements.len()) && (tail == null);
      let recovered = _recoverStatement(e, syntax, scope, loops, barrier, tries, mark, last);
      poisonDeclared(stmt, true);
      ends = H.endsPath(recovered);
      children.push(recovered);
    }
    endTouch(outerTouched);
    endDoubt(outerDoubt);
  }

  let ty = 0;
  let hasTail = false;
  let statementTail = isStatement || (isResult && (tail != null) && _valueless(tail));

  if (tail != null) {
    let index = first + statements.len();
    let mark = _nameIds.len();
    let outerTouched = beginTouch();
    let outerDoubt = beginDoubt();

    try {
      if (statementTail) {
        let effect = checkEffect(tail, index);
        if (!ends) { children.push(effect); }
        ends = ends || H.endsPath(effect);
      } else {
        let checked = isResult ? _checkResult(tail, index) : checkOperand(tail, index, expected);

        if (isResult || !ends) {
          ty = H.typeOf(checked);
          hasTail = true;
          children.push(checked);
        }
      }
    } catch (e) {
      let recovered = _recoverStatement(
        e, syntax, scope, loops, barrier, tries, mark, !isStatement
      );

      if (!ends) {
        children.push(recovered);
        ends = H.endsPath(recovered);
      }
    }
    endTouch(outerTouched || touched());
    if (endDoubt(outerDoubt)) { doubt(); }
  }

  if ((tailKind == Tail.Value) && ends) { ty = H.noValueType(expected); }

  if (isResult && !hasTail && !ends) {
    children.push(_nullResult("function can fall through without a value of type "));
    ty = H.TYPE_NULL;
    hasTail = true;
  }

  _popTo(_scopeStart);
  _scopeStart = outerStart;
  keepNarrowings(before);
  H.node(Op.Block, ty, 0, hasTail ? 1 : 0, children)
};

export let declareNames = fn(names: Array<Bytes>, values: Array<I32>): Tuple<I32, Array<I32>> {
  let mark = _nameIds.len();
  let prefix = Array.new<I32>(0);

  for (i, name in names) {
    let value = values[i];
    prefix.push(H.declareBinding(
      Op.Const, _declare(name, H.typeOf(value), false), name, value
    ));
  }
  (mark, prefix)
};

export let endNames = fn(mark: I32) {
  _popTo(mark);
  null
};

export let beginLoopScope = fn(what: Bytes): Tuple<I32, I32, Bytes> {
  let outer = (_scopeStart, _loops, _barrier);
  _scopeStart = _nameIds.len();
  _loops = 0;
  _barrier = what;
  outer
};

export let endLoopScope = fn(outer: Tuple<I32, I32, Bytes>): Bool {
  _popTo(_scopeStart);
  let (start, loops, barrier) = outer;
  _scopeStart = start;
  _loops = loops;
  _barrier = barrier;
  true
};

export let checkArm = fn(
  names: Array<Bytes>, values: Array<I32>, statements: Array<Stmt>, tail: Null<AstExpr>, first: I32,
  expected: I32, statement: Bool
): I32 {
  let (mark, prefix) = declareNames(names, values);
  let block = _checkBlockBody(
    prefix, statements, tail, first, expected, statement ? Tail.Statement : Tail.Value
  );
  _popTo(mark);
  block
};

let _checkBranch = fn(branch: AstExpr, index: I32): I32 {
  let outer = enterSyntax(syntaxChild(index));

  let block = match (branch) {
    BlockExpr({ statements, tail }) =>
      _checkBlockBody([], statements, tail, 0, -1, Tail.Statement),
    _ => {
      internalError("statement block expected");
      -1
    },
  };
  enterSyntax(outer);
  block
};

let _checkIfStatement = fn(condition: AstExpr, thenBranch: AstExpr, elseBranch: AstExpr): I32 {
  let (declarations, checkedCondition, names, reads) =
    _checkCondition(condition, "if", _isBlock(thenBranch));
  let before = narrowings();
  _narrowBy(condition, true);
  let children = [checkedCondition, _checkThen(thenBranch, names, reads, -1, true)];
  let afterThen = narrowings();
  setNarrowings(before);
  _narrowBy(condition, false);

  match (elseBranch) {
    Null => null,
    If(_, _, _) => {
      children.push(checkEffect(elseBranch, 2));
      null
    },
    _ => {
      children.push(_checkBranch(elseBranch, 2));
      null
    },
  };
  let thenEnds = H.endsPath(children[1]);
  let elseEnds = (children.len() == 3) && H.endsPath(children[2]);

  if (thenEnds == elseEnds) {
    keepNarrowings(afterThen);
  } else if (elseEnds) {
    setNarrowings(afterThen);
  }
  _after(declarations, H.opNode(Op.IfStatement, 0, children), false)
};

let _checkThen = fn(
  branch: AstExpr, names: Array<Bytes>, reads: () -> Array<I32>, expected: I32, statement: Bool
): I32 {
  if (names.len() == 0) {
    return statement ? _checkBranch(branch, 1) : checkOperand(branch, 1, expected);
  }
  let outer = enterSyntax(syntaxChild(1));

  let block = match (branch) {
    BlockExpr({ statements, tail }) =>
      checkArm(names, reads(), statements, tail, 0, expected, statement),
    _ => {
      internalError("a block expected after a `let` test");
      -1
    },
  };
  enterSyntax(outer);
  block
};

let _checkTry = fn(
  body: AstBlock, catchName: Null<Bytes>, handler: AstBlock, expected: I32, statement: Bool
): I32 {
  if (_tries == 16) { throw coded(E0901, "try regions nest more than 16 deep in one function"); }
  let tailKind = statement ? Tail.Statement : Tail.Value;
  let before = narrowings();
  let mark = assignmentMark();
  _tries++;
  let checkedBody = _checkBlockBody([], body.statements, body.tail, 0, expected, tailKind);

  if (!statement && (body.tail == null) && !H.endsPath(checkedBody)) {
    throw coded(E0410, "a try used as a value needs a value at the end of its body");
  }
  _tries--;
  let afterBody = narrowings();
  leaveLoop(before, mark);
  let scope = _nameIds.len();
  let binding = catchName == null ? -1 : _declare(catchName, H.TYPE_DYNAMIC, false);
  let first = body.statements.len() + (body.tail == null ? 0 : 1);
  let checkedHandler =
    _checkBlockBody([], handler.statements, handler.tail, first, expected, tailKind);

  if (!statement && (handler.tail == null) && !H.endsPath(checkedHandler)) {
    throw coded(E0410, "a try used as a value needs a value at the end of its catch");
  }
  _popTo(scope);

  if (H.endsPath(checkedHandler)) {
    setNarrowings(afterBody);
  } else if (!H.endsPath(checkedBody)) { keepNarrowings(afterBody); }
  let name = catchName == null ? 0 : H.bytesId(catchName);

  if (statement) {
    return H.node(Op.TryStatement, 0, binding, name, [checkedBody, checkedHandler]);
  }
  let ty = joinBranches(checkedBody, checkedHandler);
  let bodyTail = body.statements.len();
  let handlerTail = first + handler.statements.len();

  if (ty < 0) {
    throw branchMismatch(
      "try and catch values", H.typeOf(checkedBody), H.typeOf(checkedHandler), handlerTail
    );
  }
  H.node(
    Op.Try, ty, binding, name,
    [coerceTail(checkedBody, ty, bodyTail), coerceTail(checkedHandler, ty, handlerTail)]
  )
};

export let checkAnnotated = fn(annotation: ?AstType, value: AstExpr): I32 {
  let ty = checkAnnotation(annotation);
  let checked = checkOperand(value, 0, ty);
  let got = H.typeOf(checked);

  if ((ty >= 0) && !H.unify(got, ty)) {
    enterSyntax(syntaxChild(0));
    throw _annotationMismatch("this pattern", ty, got);
  }
  checked
};

export let checkDestructure = fn(
  pattern: Pattern, isConst: Bool, typeParams: Array<TypeParam>, annotation: ?AstType,
  value: AstExpr, otherwise: ?AstBlock, global: Bool
): I32 {
  if (typeParams.len() != 0) {
    throw coded(E0605,
      global ? "globals do not support type parameters"
      : "local bindings do not support type parameters");
  }
  _checkLetPattern(pattern, !isConst, checkAnnotated(annotation, value), otherwise, global)
};

export let declareLocal = fn(name: Bytes, value: I32, mutable: Bool): I32 {
  _requireFresh(name);
  let ty = H.typeOf(value);
  H.node(mutable ? Op.Let : Op.Const, ty, _declare(name, ty, mutable), H.bytesId(name), [value])
};

export let declareGlobal = fn(name: Bytes, value: I32, mutable: Bool): I32 {
  let global = declareStatementGlobal(name, H.typeOf(value), mutable);
  declareScoped(name, Binding.Global(global));
  initGlobal(global, value)
};

let _boxesEachRead = fn(value: I32): Bool {
  let root = value;
  while (H.childCount(root) > 0) { root = H.childOf(root, 0); }
  let ty = H.typeOf(value);
  let boxed = H.isKind(ty, Kind.Dynamic) || H.isKind(ty, Kind.Null);
  boxed && match (H.opOf(root)) { I64, Float => true, _ => false }
};

export let initGlobal = fn(global: I32, value: I32): I32 {
  if (!H.globalIsMutable(global) && _isConstant(value) && !_boxesEachRead(value)) {
    while (_globalConstants.len() <= global) { _globalConstants.push(-1); }
    _globalConstants[global] = value;
  }
  H.node(Op.InitGlobal, H.typeOf(value), global, 0, [value])
};

export let checkWhile = fn(condition: AstExpr, body: Array<Stmt>): I32 {
  let before = narrowings();
  let mark = assignmentMark();
  enterLoop();

  let (declarations, checkedCondition, names, reads) = try {
    _checkCondition(condition, "while", true)
  } catch (e) {
    setNarrowings(before);
    throw e;
  };
  _narrowBy(condition, true);
  _loops++;
  let checkedBody = checkArm(names, reads(), body, null, 1, -1, true);
  _loops--;
  leaveLoop(before, mark);
  _after(declarations, H.opNode(Op.While, 0, [checkedCondition, checkedBody]), false)
};

export let checkFor = fn(index: ?Pattern, item: Pattern, items: AstExpr, body: Array<Stmt>): I32 {
  let source = _value(items, 0, -1);
  let ty = H.typeOf(source);
  let isList = H.isKind(ty, Kind.List);
  let isArray = H.isKind(ty, Kind.Array);

  if (!isList && !isArray && (ty != H.TYPE_BYTES) && (ty != H.TYPE_BYTE_BUFFER)) {
    enterSyntax(syntaxChild(0));
    throw coded(E0400, `for walks an Array, Bytes or a List, not ${H.typeName(ty)}`);
  }

  let mark = _nameIds.len();
  let outerStart = _scopeStart;
  _scopeStart = mark;
  let element = isList || isArray ? H.innerOf(ty) : H.TYPE_I32;
  let held = _declare("for", ty, isList);
  let read = fn(): I32 { H.local(held, ty) };
  let setup = [H.declareBinding(isList ? Op.Let : Op.Const, held, "for", source)];
  let counter = (!isList || (index != null)) ? _declare("for.index", H.TYPE_I32, true) : -1;
  let count = fn(): I32 { H.local(counter, H.TYPE_I32) };

  if (counter >= 0) {
    setup.push(H.declareBinding(Op.Let, counter, "for.index", _leaf(Op.I32, H.TYPE_I32, 0)));
  }

  let (more, current) = if (isList) {
    let nil = _unary(Op.ListIsNil, H.TYPE_BOOL, read());
    (_unary(Op.Not, H.TYPE_BOOL, nil), _unary(Op.ListHead, element, read()))
  } else {
    let (len, get) = isArray ? (Op.ArrayLen, Op.ArrayGet) : (Op.BytesLen, Op.BytesGet);
    let length = _unary(len, H.TYPE_I32, read());
    (H.opNode(Op.Lt, H.TYPE_BOOL, [count(), length]), H.opNode(get, element, [read(), count()]))
  };

  let before = narrowings();
  let assigned = assignmentMark();
  enterLoop();
  let prefix = Array.new<I32>(0);

  if (index != null) {
    let name = bindPatternName(index);
    prefix.push(H.declareBinding(Op.Const, _declare(name, H.TYPE_I32, false), name, count()));
  }
  let itemSyntax = syntaxPattern(index == null ? 0 : 1);

  if (let Wildcard = item) {
    null
  } else if (isBindPattern(item)) {
    let name = bindPatternName(item);
    let outer = enterSyntax(itemSyntax);
    _requireFresh(name);
    enterSyntax(outer);
    prefix.push(H.declareBinding(Op.Const, _declare(name, element, false), name, current));
  } else {
    let loop = _syntax;
    let alone: Syntax = { ...loop, patterns: [itemSyntax] };
    enterSyntax(alone);
    prefix.push(_checkLetPattern(item, false, current, null, false));
    enterSyntax(loop);
  }

  _loops++;
  let checkedBody = _checkBlockBody(prefix, body, null, 1, -1, Tail.Statement);
  _loops--;
  leaveLoop(before, assigned);
  _popTo(mark);
  _scopeStart = outerStart;
  let step = Array.new<I32>(0);

  if (isList) {
    let rest = H.node(Op.Assign, ty, held, 0, [_unary(Op.ListTail, ty, read())]);
    step.push(_unary(Op.Expression, 0, rest));
  }

  if (counter >= 0) {
    let next = H.opNode(Op.Add, H.TYPE_I32, [count(), _leaf(Op.I32, H.TYPE_I32, 1)]);
    step.push(_unary(Op.Expression, 0, H.node(Op.Assign, H.TYPE_I32, counter, 0, [next])));
  }
  setup.push(H.opNode(Op.While, 0, [more, checkedBody, H.opNode(Op.Block, 0, step)]));
  H.node(Op.Block, 0, 0, 0, setup)
};

export let checkDoWhile = fn(body: Array<Stmt>, condition: AstExpr): I32 {
  let before = narrowings();
  let mark = assignmentMark();
  enterLoop();
  _loops++;
  let checkedBody = _checkBlockBody([], body, null, 0, -1, Tail.Statement);
  _loops--;
  let checkedCondition = -1;

  try {
    checkedCondition = _value(condition, body.len(), -1);
  } catch (e) {
    setNarrowings(before);
    throw e;
  }
  requireBool("do-while", checkedCondition, body.len());
  leaveLoop(before, mark);
  H.node(Op.While, 0, 0, 1, [checkedCondition, checkedBody])
};

export let checkThrow = fn(value: AstExpr): I32 {
  let thrown = _value(value, 0, -1);

  if (H.typeOf(thrown) == H.TYPE_BYTE_BUFFER) {
    enterSyntax(syntaxChild(0));
    throw coded(E0409, `a buffer from Bytes.new cannot be thrown${bufferHint(H.typeOf(thrown))}`);
  }

  if (H.isKind(H.typeOf(thrown), Kind.List)) {
    enterSyntax(syntaxChild(0));
    throw coded(E0409, "a list cannot be thrown: its nil would read as null");
  }
  _unary(Op.Throw, 0, thrown)
};

let _checkStatement = fn(statement: Stmt, syntax: Syntax): I32 {
  let outer = enterSyntax(syntax);

  let id = match (statement) {
    LetStmt(_, false, pattern, typeParams, _, value, _) when (isTemplate(statement)) =>
      _checkLocalTemplate(bindPatternName(pattern), typeParams, value),
    LetStmt(isConst, false, pattern, typeParams, annotation, value, _)
      when (isBindPattern(pattern)) =>
      _unary(Op.Declare, 0, _checkLocal(pattern, isConst, typeParams, annotation, value)),
    LetStmt(isConst, false, pattern, typeParams, annotation, value, otherwise) =>
      checkDestructure(pattern, isConst, typeParams, annotation, value, otherwise, false),
    Expression(value) => checkEffect(value, 0),
    Return(value) => {
      if (_frames.len() == 0) { throw unsupportedStatement(statement); }
      _unary(
        Op.Return, 0,
        value == null ? _nullResult("return needs a value of type ") : _checkResult(value, 0)
      )
    },
    Throw(value) => checkThrow(value),
    Break => {
      if (_loops == 0) {
        throw coded(E0307,
          _barrier == "" ? "break outside loop" : `break cannot leave ${_barrier}`);
      }
      _leaf(Op.Break, 0, 0)
    },
    Continue => {
      if (_loops == 0) {
        throw coded(E0307,
          _barrier == "" ? "continue outside loop" : `continue cannot leave ${_barrier}`);
      }
      _leaf(Op.Continue, 0, 0)
    },
    While(condition, body) => checkWhile(condition, body),
    DoWhile(body, condition) => checkDoWhile(body, condition),
    For(index, item, items, body) => checkFor(index, item, items, body),
    _ => { throw unsupportedStatement(statement) },
  };
  enterSyntax(outer);
  id
};

let _checkFunction = fn(index: I32, body: AstBlock, syntax: Syntax): Array<I32> {
  let outer = enterSyntax(syntax);
  let outerNameIds = _nameIds;
  let outerIds = _ids;
  let outerHidden = _hidden;
  let outerLoops = _loops;
  let outerBarrier = _barrier;
  let outerTries = _tries;
  let outerStart = _scopeStart;
  let outerKnown = narrowings();
  setNarrowings(Array.new<I32>(0));
  _frames.push({ nameIds: outerNameIds, ids: outerIds });
  _closures.push(_newClosure());
  _nameIds = Array.new<I32>(0);
  _ids = Array.new<I32>(0);
  _hidden = Array.new<I32>(0);
  _loops = 0;
  _barrier = "";
  _tries = 0;
  _scopeStart = 0;
  let info = _functions[index];
  let ty = info.ty;
  let name = info.name;
  let paramNames = info.params;
  let paramTypes = info.paramTypes;
  let inferred = ty < 0;
  let receivers = _receivers(index);
  _methods.push(info.methodKind);

  if (inferred) {
    ty = H.functionType(paramTypes, H.newVar(false));
    info.ty = ty;
  }
  let outerResult = _result;
  _result = inferred ? -1 : H.innerOf(ty);
  let outerResultSyntax = _resultSyntax;
  _resultSyntax = inferred ? _noSyntax() : syntax;
  let outerInferred = _resultInferred;
  let outerResultsStart = _resultsStart;
  _resultInferred = inferred;
  _resultsStart = _results.len();
  let failure: ?Bytes = null;
  let failures = failureCount();
  let outerDoubt = beginDoubt();
  let doubted = false;

  try {
    let children = Array.new<I32>(0);

    for (i, paramName in paramNames) {
      let paramType = H.slotType(paramTypes[i]);
      let parent = enterSyntax(i < receivers ? syntax : syntaxChild(i - receivers));
      children.push(H.node(
        Op.Parameter, paramType, _declare(paramName, paramType, false),
        H.bytesId(paramName), []
      ));
      enterSyntax(parent);
    }
    let first = paramNames.len() - receivers;
    let { statements, tail } = body;
    let checked = _checkBlockBody([], statements, tail, first, -1, Tail.Result);
    if (_result < 0) { _result = H.TYPE_NULL; }
    let bodyFailed = failureCount() != failures;

    if (inferred) {
      doubted = bodyFailed;
      checked = _joinResults(checked);
      let used = H.innerOf(ty);

      if (!H.unifyResult(used, _result) && !bodyFailed) {
        let returns = `${name} returns ${H.typeName(H.resolve(_result))}`;
        let uses = `a call uses its result as ${H.typeName(H.resolve(used))}`;
        throw coded(E0403, `${returns}, but ${uses}; annotate its result type`);
      }
      ty = H.functionType(paramTypes, _result);
      info.ty = ty;
    }
    children.appendFrom(_closures[_frames.len()].captures, 0);
    children.push(checked);
    info.node = H.node(Op.Function, ty, H.bytesId(name), 0, children);
  } catch (e) {
    failure = Std.string(e);
    _popTo(0);
  }
  let sources = _closures[_frames.len()].sources;
  _frames.pop();
  _closures.pop();
  _methods.pop();
  _nameIds = outerNameIds;
  _ids = outerIds;
  _hidden = outerHidden;
  _result = outerResult;
  _resultSyntax = outerResultSyntax;
  _resultInferred = outerInferred;
  Array.resize(_results, _resultsStart);
  _resultsStart = outerResultsStart;
  _loops = outerLoops;
  _barrier = outerBarrier;
  _tries = outerTries;
  _scopeStart = outerStart;
  setNarrowings(outerKnown);
  endDoubt(outerDoubt);
  if (doubted) { doubt(); }
  if (failure != null) { throw failure; }
  enterSyntax(outer);
  sources
};

let _checkIsolated = fn(
  index: I32, body: AstBlock, syntax: Syntax, name: Bytes, names: Array<Bytes>, types: Array<I32>,
  template: Bool, locals: Array<I32>
) {
  let outerFrames = _frames;
  let outerClosures = _closures;
  let outerNameIds = _nameIds;
  let outerIds = _ids;
  let outerHidden = _hidden;
  let outerName = _bodyName;
  let outerNames = _envNames;
  let outerTypes = _envTypes;
  let outerTemplate = _templateBody;
  let outerFloor = _captureFloor;
  _frames = Array.new<Frame>(0);
  _closures = [_newClosure()];
  _nameIds = Array.new<I32>(0);
  _ids = Array.new<I32>(0);
  _hidden = Array.new<I32>(0);
  _bodyName = name;
  _envNames = names;
  _envTypes = types;
  _templateBody = template;
  _captureFloor = 0;
  let failure: ?Bytes = null;

  for (local in locals) {
    _declareTemplate(local);
  }
  let outerMethods = _methods;
  _methods = Array.new<I32>(0);
  try { _checkFunction(index, body, syntax); } catch (e) { failure = Std.string(e); }
  _methods = outerMethods;
  _popTo(0);
  _frames = outerFrames;
  _closures = outerClosures;
  _nameIds = outerNameIds;
  _ids = outerIds;
  _hidden = outerHidden;
  _bodyName = outerName;
  _envNames = outerNames;
  _envTypes = outerTypes;
  _templateBody = outerTemplate;
  _captureFloor = outerFloor;
  if (failure != null) { throw failure; }
  null
};

export let checkDirect = fn(index: I32): Bool {
  if (_functions[index].node >= 0) { return true; }
  let statement = _directStatements[index - _firstDirect];
  let inferred = _functions[index].ty < 0;
  let outer = _syntax;
  let outerTouched = beginTouch();
  let outerDoubt = beginDoubt();

  try {
    match (_statements[statement]) {
      LetStmt(_, _, _, _, _, Function(_, _, body, _), _) => {
        let syntax = _moduleSyntax.children[statement].children[0];
        let name = _functions[index].name;
        _checkIsolated(index, body, syntax, name, _NO_NAMES, _NO_TYPES, false, _NO_TYPES)
      },
      Prototype(_, name, _, fields) => {
        let field = _directFields[index - _firstDirect];
        let params = H.enumParams(_functions[index].methodKind);

        match (fields[field]) {
          { value: Function(_, _, body, _) } => {
            let syntax = _moduleSyntax.children[statement].children[field];
            let names = paramNames(params);
            _checkIsolated(index, body, syntax, name, names, params, params.len() > 0, _NO_TYPES)
          },
          _ => internalError("a method expected"),
        }
      },
      _ => internalError("a direct function expected"),
    };
  } catch (e) {
    recover(e);
    enterSyntax(outer);
    _functions[index].node = H.opNode(Op.Block, 0, []);
    if (inferred) { doubt(); }
  }
  if (endDoubt(outerDoubt)) { poison(_functions[index].name); }
  endTouch(outerTouched);
  true
};

let _joinTypes = fn(types: Array<I32>, more: Array<I32>): Array<I32> {
  types.copy().appendFrom(more, 0)
};

let _checkTemplate = fn(t: I32, local: Bool): Bool {
  if (_templates[t].checker >= 0) { return true; }
  let template = _templates[t];

  match (template.value) {
    Function(fnParams, result, body, _) => {
      let types = _joinTypes(template.envTypes, template.params);
      let outerNames = _envNames;
      let outerTypes = _envTypes;
      let outerTemplate = _templateBody;
      let outerFloor = _captureFloor;
      _envNames = template.names;
      _envTypes = types;
      _templateBody = true;
      let failure: ?Bytes = null;

      try {
        let index = _addFunction(template.name, fnParams, result, -1, template.syntax, -1);
        template.checker = index;

        if (local) {
          _captureFloor = _frames.len() + 1;
          _checkFunction(index, body, template.syntax);
        } else {
          _checkIsolated(
            index, body, template.syntax, template.bodyName, template.names, types, true, _NO_TYPES
          );
        }
      } catch (e) { failure = Std.string(e); }
      _envNames = outerNames;
      _envTypes = outerTypes;
      _templateBody = outerTemplate;
      _captureFloor = outerFloor;
      if (failure != null) { throw failure; }
    },
    _ => internalError("a function expected"),
  };
  true
};

export let checkTemplate = fn(name: Bytes): Bool {
  match (scoped(name)) {
    Template(t) => _checkTemplate(t, false),
    _ => internalError("a template expected"),
  }
};

let _checkLocalTemplate = fn(name: Bytes, typeParams: Array<TypeParam>, value: AstExpr): I32 {
  _requireFresh(name);
  let t = _newTemplate(name, typeParams, value, syntaxChild(0), _bodyName);
  _declareTemplate(t);
  let locals = _templates[t].locals;

  for (i, template in _templates) {
    if (_localTemplate(template.name) == i) { locals.push(i); }
  }
  _checkTemplate(t, true);
  H.opNode(Op.Block, 0, [])
};

let _instance = fn(t: I32, types: Array<I32>, depth: I32, need: Need): I32 {
  let template = _templates[t];

  match (template.value) {
    Function(_, _, body, _) => {
      let key = H.tupleType(types);
      let found = template.keys.indexOf(key);
      if (found >= 0) { return template.functions[found]; }
      if (depth > H.MAX_INSTANCE_DEPTH) { throw H.nestsTooDeep(template.name); }
      let checker = template.checker;
      let instance = `${template.name}<${H.typeArgNames(key)}>`;
      let ty = H.substitute(_functions[checker].ty, template.params, types);
      let index = generateFunction(instance, _functions[checker].params, ty);
      template.keys.push(key);
      template.functions.push(index);
      let outerScope = useModuleScope(template.module);
      let outerDepth = _instanceDepth;
      let outerNeed = _needing(need, instance);
      let failure: ?Bytes = null;
      _instanceDepth = depth;
      let scope = _joinTypes(template.envTypes, types);

      try {
        _checkIsolated(
          index, body, template.syntax, "", template.names, scope, false, template.locals
        );
      } catch (e) { failure = keepNote(Std.string(e)); }
      useModuleScope(outerScope);
      _instanceDepth = outerDepth;
      needInstance(outerNeed.0, outerNeed.1);
      if (failure != null) { throw failure; }
      index
    },
    _ => {
      internalError("a function expected");
      -1
    },
  }
};

let _settleTypeArgs = fn(types: Array<I32>, params: Array<I32>, name: Bytes) {
  for (j, ty in types) {
    let settled = H.defaultIntegers(ty);
    types[j] = settled;

    if (H.isOpen(settled)) {
      throw coded(E0403, `cannot infer ${H.typeName(params[j])} of ${name} here; annotate it`);
    }
  }
  null
};

export let instantiateTemplates = fn(): Bool {
  let i = 0;

  while (i < _pending.len()) {
    let pending = _pending[i];
    let outer = enterNode(pending.call);
    let template = _templates[pending.template];
    _settleTypeArgs(pending.types, template.params, template.name);
    _checkTypeArgs(pending.template, template.name, pending.types);
    H.setCallee(
      pending.call, _instance(pending.template, pending.types, pending.depth, pending.need)
    );
    enterSyntax(outer);
    i++;
  }
  _pending = Array.new<PendingCall>(0);
  true
};

export let checkGenericPrototype = fn(ty: I32, check: () -> I32): I32 {
  let params = H.enumParams(ty);
  let outerTemplate = _templateBody;
  let failure: ?Bytes = null;
  let (outerNames, outerTypes) = useTypeParams(paramNames(params), params);
  _templateBody = true;
  try { check(); } catch (e) { failure = Std.string(e); }
  useTypeParams(outerNames, outerTypes);
  _templateBody = outerTemplate;
  if (failure != null) { throw failure; }
  let placeholder = H.opNode(Op.Block, 0, []);
  _genericPrototypes[_generics.indexOf(ty)].placeholder = placeholder;
  placeholder
};

export let methodValue = fn(ty: I32, name: Bytes, f: I32, body: AstBlock): I32 {
  let found = ownMethod(ty, name);
  let index = found;
  let generic = H.templateOf(ty) >= 0;
  if (!generic) { checkDirect(found); }
  let outer = enterSyntax(syntaxChild(f));

  if (generic) {
    index = generateFunction(
      `${H.typeName(ty)}.${name}`, _functions[found].params, receiverMethodType(found, ty)
    );
    _functions[index].methodKind = ty;
    _instanceMethods.push({ function: index, field: name });
    _checkIsolated(index, body, _syntax, "", _envNames, _envTypes, false, _NO_TYPES);
  }
  let ref = H.node(Op.FunctionRef, _functionType(index), index + 1, 0, []);
  enterSyntax(outer);
  ref
};

export let resolveInstanceReads = fn(): Bool {
  let i = 0;
  let any = _openReads.len() > 0;

  while (i < _openReads.len()) {
    let open = _openReads[i];
    let outer = enterNode(open.read);
    let template = H.templateOf(H.typeOf(open.read));
    let args = H.templateArgs(H.typeOf(open.read));
    _settleTypeArgs(args, H.enumParams(template), H.typeName(template));
    H.setGlobal(open.read, _instanceGlobal(H.appliedType(template, args), open.depth, open.need));
    enterSyntax(outer);
    i++;
  }
  _openReads = Array.new<OpenRead>(0);
  any
};

export let buildInstances = fn(build: (I32, Bytes, Array<PrototypeField>) -> I32): Bool {
  let any = _built < _instances.len();

  while (_built < _instances.len()) {
    let instance = _instances[_built];
    let ty = _instanceTypes[_built];
    let template = H.templateOf(ty);
    let generic = _genericPrototypes[_generics.indexOf(template)];
    let outerScope = useModuleScope(generic.module);
    let outer = enterSyntax(generic.syntax);
    if (instance.nesting > H.MAX_INSTANCE_DEPTH) { throw H.nestsTooDeep(H.typeName(template)); }
    let (outerNames, outerTypes) =
      useTypeParams(paramNames(H.enumParams(template)), H.templateArgs(ty));
    let outerDepth = _instanceDepth;
    let failure: ?Bytes = null;
    let outerNeed = _needing(instance.need, H.typeName(ty));
    _instanceDepth = instance.nesting;
    _built++;

    try {
      match (generic.statement) {
        Prototype(_, name, _, fields) => { instance.init = build(ty, name, fields); },
        _ => internalError("a prototype expected"),
      };
    } catch (e) { failure = keepNote(Std.string(e)); }
    useTypeParams(outerNames, outerTypes);
    _instanceDepth = outerDepth;
    useModuleScope(outerScope);
    needInstance(outerNeed.0, outerNeed.1);
    if (failure != null) { throw failure; }
    enterSyntax(outer);
  }
  any
};

export let withInstances = fn(statements: Array<I32>): Array<I32> {
  if (_generics.len() == 0) { return statements; }
  let out = Array.new<I32>(0);

  for (statement in statements) {
    let g = 0;
    while ((g < _generics.len()) && (_genericPrototypes[g].placeholder != statement)) { g++; }

    if (g == _generics.len()) {
      out.push(statement);
    } else {
      for (j, instance in _instances) {
        if (H.templateOf(_instanceTypes[j]) == _generics[g]) { out.push(instance.init); }
      }
    }
  }
  out
};

let _checkFunctionLiteral = fn(
  params: Array<Parameter>, result: Null<AstType>, body: AstBlock, expected: I32, isMethod: Bool
): I32 {
  if (isMethod && (_methodContext() < 0)) {
    throw coded(E0306, "a `method fn` sees the `this` of the method around it,"
      + " so it is only inside a prototype's method");
  }
  let index = _addFunction(
    isMethod ? "method fn" : "fn", params, result, expected, _syntax, isMethod ? -2 : -1
  );
  let captured = _checkFunction(index, body, _syntax);
  H.node(Op.FunctionRef, _functionType(index), index + 1, 0, captured)
};

let _checkBlock = fn(statements: Array<Stmt>, tail: Null<AstExpr>, expected: I32): I32 {
  _checkBlockBody([], statements, tail, 0, expected, Tail.Value)
};

export let beginCheck = fn(): Bool {
  H.beginHir();
  resetNarrowing();
  _nameIds = Array.new<I32>(0);
  _ids = Array.new<I32>(0);
  _hidden = Array.new<I32>(0);
  _latest = Array.new<I32>(0);
  _nextBinding = 0;
  _bindingTypes = Array.new<I32>(0);
  _mutable = Array.new<Bool>(0);
  _declarations = Array.new<Syntax>(0);
  _globalDeclarations = Array.new<Syntax>(0);
  _globalConstants = Array.new<I32>(0);
  _syntax = _noSyntax();
  _resultSyntax = _noSyntax();
  _frames = Array.new<Frame>(0);
  _closures = [_newClosure()];
  _scopeStart = 0;
  _loops = 0;
  _barrier = "";
  _tries = 0;
  _functions = Array.new<FunctionInfo>(0);
  _result = -1;
  _resultInferred = false;
  _results = Array.new<I32>(0);
  _resultsStart = 0;
  _inferred = Array.new<Inferred>(0);
  _bodyName = "";
  _templates = Array.new<Template>(0);
  _envNames = Array.new<Bytes>(0);
  _envTypes = Array.new<I32>(0);
  _templateBody = false;
  _captureFloor = 0;
  _prototypeMethods = Array.new<Method>(0);
  _instanceMethods = Array.new<Method>(0);
  _methodCalls = Array.new<MethodCall>(0);
  _methods = Array.new<I32>(0);
  _prototypes = Array.new<I32>(0);
  _prototypeInfos = Array.new<PrototypeInfo>(0);
  _initFields = Array.new<I32>(0);
  _generics = Array.new<I32>(0);
  _genericPrototypes = Array.new<Generic>(0);
  _instanceTypes = Array.new<I32>(0);
  _instances = Array.new<Instance>(0);
  _openReads = Array.new<OpenRead>(0);
  _built = 0;
  _aliases = Array.new<I32>(0);
  _aliasTypes = Array.new<Alias>(0);
  _laterType = fn(_name: Bytes): I32 { -1 };
  _pending = Array.new<PendingCall>(0);
  _instanceDepth = 0;
  _literals = Array.new<OpenLiteral>(0);
  _conversions = Array.new<I32>(0);
  takeRegexpInits();
  _regexpChecked = Array.new<Bytes>(0);
  resetFailures();
  true
};

let _fits = fn(id: I32, ty: I32, negative: Bool): Bool {
  if (H.isKind(H.resolve(ty), Kind.Param)) { return true; }
  if (!negative && (H.wideValueOf(id) < 0)) { return ty == H.TYPE_U64; }
  if (ty == H.TYPE_I64) { return true; }
  if ((ty == H.TYPE_I32) || !H.isIntegerType(ty)) { return H.fitsI32(id); }
  let value = H.wideValueOf(id);
  ty == H.TYPE_U64 ? value >= 0 : (value >= H.leastValue(ty)) && (value <= H.mostValue(ty))
};

let _checkLiteralRange = fn(literal: OpenLiteral, ty: I32) {
  if (!_fits(literal.id, ty, literal.negative)) {
    enterNode(literal.id);
    _typedLiteral(literal.text, literal.negative, H.isIntegerType(ty) ? ty : H.TYPE_I32);
  }
  null
};

export let checkLiteralRanges = fn(): Bool {
  let i = 0;
  let going = true;
  beginTouch();

  while (going && (i < _literals.len())) {
    let literal = _literals[i];

    try {
      _checkLiteralRange(literal, H.resolve(H.typeOf(literal.id)));
    } catch (e) {
      going = recordFailure(currentSpan(), e);
    }
    i++;
  }
  true
};

let _settleTypes = fn() {
  for (literal in _literals) {
    let ty = H.defaultIntegers(H.typeOf(literal.id));
    _checkLiteralRange(literal, ty);
    H.settleLiteral(literal.id, ty);
  }

  for (conversion in _conversions) {
    H.settleConversion(conversion);
  }
  _literals = Array.new<OpenLiteral>(0);
  _conversions = Array.new<I32>(0);

  for (inferred in _inferred) {
    let ty = H.resolve(inferred.ty);

    if (H.isOpen(ty)) {
      enterSyntax(inferred.syntax);
      let hint = H.isKind(ty, Kind.Null) ? " as Null<T>" : "";
      throw coded(E0403, `cannot infer the type of ${inferred.what}; annotate it${hint}`);
    }
  }
  let open = H.resolveTypes();

  if (open >= 0) {
    enterNode(open);
    throw coded(E0403, "cannot infer the type of this value; annotate it");
  }
  null
};

let _programFunctions = fn(body: I32): Array<I32> {
  let numbers = Array.new<I32>(0);
  let kept = Array.new<I32>(0);

  for (function in _functions) {
    numbers.push(function.dropped ? -1 : kept.len());
    if (!function.dropped) { kept.push(function.node); }
  }
  kept.push(body);
  if (kept.len() > _functions.len()) { return kept; }
  let i = 0;
  let count = H.nodeCount();

  while (i < count) {
    let op = H.opOf(i);

    if (((op == Op.Call) || (op == Op.FunctionRef)) && (H.valueOf(i) > 0)) {
      H.setCallee(i, numbers[H.valueOf(i) - 1]);
    }
    i++;
  }
  kept
};

export let finishProgram = fn(body: I32): Hir {
  let overrides = _overrides();

  for (call in _methodCalls) {
    let function = _fixedMethod(call, overrides);
    if (function >= 0) { H.callDirectly(call.call, function); }
  }
  let functions = _programFunctions(body);
  _settleTypes();
  let hir = H.finishHir(H.opNode(Op.Program, 0, functions));
  _syntax = _noSyntax();
  hir
};

export let enterSpan = fn(span: Null<SourceSpan>): Bool {
  let syntax = _noSyntax();
  if (span != null) { syntax = _spanSyntax(span.path, span.start, span.end); }
  enterSyntax(syntax);
  true
};

export let recoverTopLevel = fn(error: Dynamic, syntax: Syntax): Bool {
  recover(error);
  _popTo(0);
  enterSyntax(syntax);
  _scopeStart = 0;
  _loops = 0;
  _barrier = "";
  _tries = 0;
  _bodyName = "";
  resetNarrowing()
};
