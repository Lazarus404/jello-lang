package frontend.semantics;

import type { Expr as AstExpr, ListGenerator, ListLiteral } from frontend.syntax.Ast;
import frontend.hir.Hir as H;
import { Kind, Op } from frontend.hir.Hir;
import { assignmentMark, enterLoop, leaveLoop, narrowings } from frontend.semantics.Narrowing;
import { bindGenerator } from frontend.semantics.Match;
import { expressionOf, steppedWhile } from frontend.semantics.Derived;
import {
  beginLoopScope, checkOperand, endLoopScope, enterSyntax, hideValue, newBinding, rejectAt,
  syntaxChild, widened,
} from frontend.semantics.TypeCheck;
import { E0400, coded } from support.Codes;

let _element = fn(expected: I32, inferred: Bool): I32 {
  if (H.isKind(expected, Kind.List)) { return H.innerOf(expected); }
  inferred ? H.newVar(false) : -1
};

let _items = fn(items: Array<AstExpr>, first: I32, element: I32, values: Array<I32>): I32 {
  let declared = H.isOpen(element) ? -1 : element;
  let ty = element;

  for (i, item in items) {
    let value = widened(checkOperand(item, first + i, ty), declared);
    if (ty < 0) { ty = H.typeOf(value); }

    if (!H.unify(H.typeOf(value), ty)) {
      rejectAt(first + i, coded(E0400, `list element must be ${H.typeName(ty)}`));
    }
    values.push(value);
  }
  ty
};

let _listOperand = fn(operand: AstExpr, index: I32, element: I32, what: Bytes): I32 {
  let checked = checkOperand(operand, index, element >= 0 ? H.listType(element) : -1);
  let ty = H.typeOf(checked);

  if (!H.isKind(ty, Kind.List)) {
    enterSyntax(syntaxChild(index));
    throw coded(E0400, `${what} must be a List, not ${H.typeName(ty)}`);
  }

  if ((element >= 0) && !H.unify(ty, H.listType(element))) {
    let wanted = H.typeName(H.listType(element));
    rejectAt(index, coded(E0400, `${what} must be ${wanted}, not ${H.typeName(ty)}`));
    return H.opNode(Op.ListNil, H.listType(element), []);
  }
  checked
};

let _consed = fn(values: Array<I32>, tail: I32, ty: I32): I32 {
  let list = tail;
  let i = values.len() - 1;

  while (i >= 0) {
    list = H.opNode(Op.ListCons, ty, [values[i], list]);
    i--;
  }
  list
};

let _more = fn(binding: I32, ty: I32): I32 {
  let empty = H.opNode(Op.ListIsNil, H.TYPE_BOOL, [H.local(binding, ty)]);
  H.opNode(Op.Not, H.TYPE_BOOL, [empty])
};

let _assign = fn(binding: I32, ty: I32, value: I32): I32 {
  expressionOf(H.node(Op.Assign, ty, binding, 0, [value]))
};

let _reverseOnto = fn(source: I32, onto: I32, ty: I32, statements: Array<I32>) {
  let head = H.opNode(Op.ListHead, H.innerOf(ty), [H.local(source, ty)]);
  let push = _assign(onto, ty, H.opNode(Op.ListCons, ty, [head, H.local(onto, ty)]));
  let tail = H.opNode(Op.ListTail, ty, [H.local(source, ty)]);
  statements.push(steppedWhile(_more(source, ty), [push], [_assign(source, ty, tail)]));
  null
};

let _variable = fn(statements: Array<I32>, name: Bytes, ty: I32, value: I32): I32 {
  let binding = newBinding();
  statements.push(H.declareBinding(Op.Let, binding, name, value));
  binding
};

let _prefixed = fn(
  prefix: Array<AstExpr>,
  tail: AstExpr,
  expected: I32,
  what: Bytes
): Tuple<Array<I32>, I32> {
  let values = Array.new<I32>(0);
  let element = _items(prefix, 0, _element(expected, false), values);
  (values, _listOperand(tail, prefix.len(), element, what))
};

let _spread = fn(
  prefix: Array<AstExpr>,
  rest: AstExpr,
  suffix: Array<AstExpr>,
  expected: I32
): I32 {
  let (values, list) = _prefixed(prefix, rest, expected, "spread operand");
  let ty = H.typeOf(list);
  if (suffix.len() == 0) { return _consed(values, list, ty); }

  let statements = Array.new<I32>(0);
  let reads = Array.new<I32>(0);

  for (value in values) {
    reads.push(H.local(hideValue(statements, "item", value), H.typeOf(value)));
  }
  let copied = _variable(statements, "rest", ty, list);
  let after = Array.new<I32>(0);
  _items(suffix, prefix.len() + 1, H.innerOf(ty), after);
  let suffixed = _consed(after, H.opNode(Op.ListNil, ty, []), ty);
  let out = _variable(statements, "list", ty, suffixed);
  let reversed = _variable(statements, "reversed", ty, H.opNode(Op.ListNil, ty, []));
  _reverseOnto(copied, reversed, ty, statements);
  _reverseOnto(reversed, out, ty, statements);
  statements.push(_consed(reads, H.local(out, ty), ty));
  H.node(Op.Block, ty, 0, 1, statements)
};

let _collect = fn(body: AstExpr, index: I32, result: I32, element: I32, loop: Array<I32>) {
  let values = Array.new<I32>(0);
  _items([body], index, element, values);
  let ty = H.listType(element);
  let cons = H.opNode(Op.ListCons, ty, [values[0], H.local(result, ty)]);
  loop.push(_assign(result, ty, cons));
  null
};

let _guard = fn(guard: AstExpr, index: I32, loop: Array<I32>) {
  let test = checkOperand(guard, index, H.TYPE_BOOL);

  if (H.typeOf(test) != H.TYPE_BOOL) {
    enterSyntax(syntaxChild(index));
    throw coded(E0400, "comprehension guard must be a Bool");
  }
  let skip = H.opNode(Op.Block, 0, [H.opNode(Op.Continue, 0, [])]);
  loop.push(H.opNode(Op.IfStatement, 0, [H.opNode(Op.Not, H.TYPE_BOOL, [test]), skip]));
  null
};

let _generator = fn(
  generators: Array<ListGenerator>,
  g: I32,
  index: I32,
  body: AstExpr,
  result: I32,
  element: I32
): Array<I32> {
  let statements = Array.new<I32>(0);
  let loop = Array.new<I32>(0);
  let next = index + 1;
  let { pattern, source, guard } = generators[g];
  let list = _listOperand(source, index, -1, "comprehension source");
  let ty = H.typeOf(list);
  let item = H.innerOf(ty);
  let cursor = _variable(statements, "source", ty, list);
  let head = hideValue(loop, "item", H.opNode(Op.ListHead, item, [H.local(cursor, ty)]));
  loop.push(bindGenerator(pattern, g, H.local(head, item)));

  if (guard != null) {
    _guard(guard, next, loop);
    next++;
  }

  if (g + 1 < generators.len()) {
    let inner = _generator(generators, g + 1, next, body, result, element);
    loop.push(H.opNode(Op.Block, 0, inner));
  } else {
    _collect(body, next, result, element, loop);
  }
  let more = _more(cursor, ty);
  let step = _assign(cursor, ty, H.opNode(Op.ListTail, ty, [H.local(cursor, ty)]));
  statements.push(steppedWhile(more, loop, [step]));
  statements
};

let _comprehension = fn(generators: Array<ListGenerator>, body: AstExpr, expected: I32): I32 {
  let element = _element(expected, true);
  let ty = H.listType(element);
  let statements = Array.new<I32>(0);
  let result = _variable(statements, "list", ty, H.opNode(Op.ListNil, ty, []));

  let before = narrowings();
  let mark = assignmentMark();
  enterLoop();
  let outer = beginLoopScope("a list comprehension");
  let loops = _generator(generators, 0, 0, body, result, element);
  endLoopScope(outer);
  leaveLoop(before, mark);

  statements.push(H.opNode(Op.Block, 0, loops));
  let out = _variable(statements, "reversed", ty, H.opNode(Op.ListNil, ty, []));
  _reverseOnto(result, out, ty, statements);
  statements.push(H.local(out, ty));
  H.node(Op.Block, ty, 0, 1, statements)
};

export let checkList = fn(value: ListLiteral, expected: I32): I32 {
  match (value) {
    Empty => H.opNode(Op.ListNil, H.listType(_element(expected, true)), []),
    Elements(items) => {
      let values = Array.new<I32>(0);
      let element = _items(items, 0, _element(expected, false), values);
      let ty = H.listType(H.resolve(element));
      _consed(values, H.opNode(Op.ListNil, ty, []), ty)
    },
    Cons(prefix, tail) => {
      let (values, list) = _prefixed(prefix, tail, expected, "list tail");
      _consed(values, list, H.typeOf(list))
    },
    Spread(prefix, rest, suffix) => _spread(prefix, rest, suffix, expected),
    Comprehension(generators, body) => _comprehension(generators, body, expected),
  }
};
