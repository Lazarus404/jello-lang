package frontend.semantics;

/** @file
 * Checks `bits[...]` expressions into HIR and lays out the segments that bits expressions and
 * patterns share. A segment holds an integer of 1 to 8, 16 or 32 bits, an `f32`, or the rest of
 * the bytes; its value is an I32, an F32 or Bytes. Segments of 1 to 7 bits pack most significant
 * bit first, a wider one starts on a byte boundary, the fixed segments fill whole bytes, and a
 * `rest` segment, at most one, comes last. A segment is described by its code (see
 * `Hir.BITS_BIG`). A bytes layout's record is packed and read as the bits value of its fields'
 * segments. `frontend.semantics.Aggregates` checks bits expressions with `checkBits` and a
 * layout's `pack` and `unpack`, and `frontend.semantics.Match` places a bits pattern's segments
 * with `placeSegments` and reads a layout pattern's record with `layoutRecord`. */

import type { BitExprSegment, Endian, Expr as AstExpr, ObjectEntry } from frontend.syntax.Ast;
import { BitValueKind, wideIntegerValue } from frontend.syntax.Ast;
import frontend.hir.Hir as H;
import {
  BITS_BIG, BITS_BYTES, BITS_FLOAT, Op, layoutConstant, layoutFieldIndex, layoutSizeField, segmentType, segmentWidth
} from frontend.hir.Hir;
import { bytesOf, i32Of, lengthTest } from frontend.semantics.Derived;
import { checkOperand, enterSyntax, hideValue, syntaxChild, widened } from frontend.semantics.TypeCheck;
import { orThrow } from frontend.semantics.Values;
import { E0007, E0104, E0400, coded } from support.Codes;

/** Returns the code of a segment of `width` bits (0 for `rest`), byte order `endian`, holding
 * `kind`. */
export let segmentCode = fn(width: I32, endian: Endian, kind: BitValueKind): I32 {
  let order = match (endian) { Big => BITS_BIG, Little => 0 };
  width + order + (match (kind) { Float => BITS_FLOAT, Bytes => BITS_BYTES, _ => 0 })
};

/** Returns the bit offset of each segment, in order, with the current syntax locating an error.
 * @param codes  the segments' codes
 * @return the offsets, and then the number of bytes the fixed segments fill
 * @throws a located error for a second `rest`, a `rest` that is not last, a segment of 8 or more
 *   bits off a byte boundary, or fixed segments that do not fill whole bytes */
export let placeSegments = fn(codes: Array<I32>): Tuple<Array<I32>, I32> {
  let offsets = Array.new<I32>(0);
  let bit = 0;

  for (i, code in codes) {
    let width = segmentWidth(code);

    if (width == 0) {
      let later = i + 1;

      while (later < codes.len()) {
        if (segmentWidth(codes[later]) == 0) {
          throw coded(E0104, "a bits value has at most one rest segment");
        }
        later++;
      }
      if (later > i + 1) { throw coded(E0104, "a rest segment must be the last"); }
    }

    if (((width == 0) || (width >= 8)) && (bit % 8 != 0)) {
      throw coded(E0104, "a segment of 8 or more bits, or a rest, must start on a byte boundary");
    }
    offsets.push(bit);
    bit += width;
  }
  if (bit % 8 != 0) { throw coded(E0104, "the segments of a bits value must fill whole bytes"); }
  (offsets, bit / 8)
};

/** Checks that the integer literal `digits`, negated when `negative`, fits a segment of code
 * `code`; a signed `i32` takes any I32, which the literal's own check covers.
 * @throws a located error if it does not fit */
export let checkSegmentLiteral = fn(code: I32, signed: Bool, digits: Bytes, negative: Bool): Bool {
  let width = segmentWidth(code);
  if (signed || (width >= 32) || ((code & BITS_FLOAT) != 0)) { return true; }
  let value = wideIntegerValue(digits, negative);

  if ((value < 0) || (value >= ((1 as I64) << (width as I64)))) {
    let sign = negative ? "-" : "";
    let unit = width == 1 ? "bit" : "bits";
    throw coded(E0007, `${sign}${digits} does not fit in ${width} ${unit}`);
  }
  true
};

/** Checks that `value`, when an integer literal, fits a segment of code `code`
 * (`checkSegmentLiteral`). */
let _fits = fn(code: I32, signed: Bool, value: AstExpr): Bool {
  match (value) {
    Integer(digits, _) => checkSegmentLiteral(code, signed, digits, false),
    Unary(Negate, Integer(digits, _)) => checkSegmentLiteral(code, signed, digits, true),
    _ => true,
  }
};

/** Checks that each integer literal of the record literal `entries`, the current syntax, fits the
 * segment of its field of the bytes layout `ty`.
 * @throws a located error at a literal that does not fit */
export let checkLayoutLiterals = fn(ty: I32, entries: Array<ObjectEntry>): Bool {
  let codes = H.layoutCodes(ty);

  for (i, entry in entries) {
    match (entry) {
      Field(name, value) => {
        let field = H.recordField(ty, name);

        if (field >= 0) {
          let outer = enterSyntax(syntaxChild(i));
          _fits(codes[field], false, value);
          enterSyntax(outer);
        }
      },
      _ => null,
    };
  }
  true
};

/** Returns an `Op.BitsPack` of `Op.BitsField`s of `values`, which fill segments of codes `codes`
 * at the bit offsets `offsets`, in `fixed` bytes and a rest. */
let _pack = fn(codes: Array<I32>, offsets: Array<I32>, fixed: I32, values: Array<I32>): I32 {
  let fields = Array.new<I32>(0);

  for (i, code in codes) {
    fields.push(H.node(Op.BitsField, segmentType(code), offsets[i], code, [values[i]]));
  }
  H.node(Op.BitsPack, H.TYPE_BYTES, fixed, 0, fields)
};

// Checks fixed `bytes(N)` values before their whole-byte blits.
let _checkedPack = fn(codes: Array<I32>, offsets: Array<I32>, fixed: I32, values: Array<I32>): I32 {
  let statements = Array.new<I32>(0);

  for (i, code in codes) {
    if ((code & BITS_BYTES) != 0) {
      // The exact-length check and blit both consume this value, so evaluate it once.
      let binding = hideValue(statements, "bytes", values[i]);
      values[i] = H.local(binding, H.TYPE_BYTES);
      let length = H.opNode(Op.BytesLen, H.TYPE_I32, [H.local(binding, H.TYPE_BYTES)]);
      let expected = i32Of(segmentWidth(code) / 8);
      let valid = H.opNode(Op.Eq, H.TYPE_BOOL, [length, expected]);
      statements.push(H.opNode(Op.Expression, 0, [orThrow(valid, bytesOf("bytes segment has the wrong length"))]));
    }
  }
  let packed = _pack(codes, offsets, fixed, values);
  statements.len() == 0 ? packed : H.node(Op.Block, H.TYPE_BYTES, 0, 1, statements.appendFrom([packed], 0))
};

/** Checks `bits[...]`, the current syntax, as an `Op.BitsPack` node of `Op.BitsField` children.
 * @param segments  the segments, whose values are the syntax children
 * @return the checked node, of type Bytes
 * @throws a located error for a misplaced segment, a value of the wrong type, or a literal that
 *   does not fit its segment */
export let checkBits = fn(segments: Array<BitExprSegment>): I32 {
  let dynamic = false;
  for (segment in segments) { if (segment.size != null) { dynamic = true; } }

  if (dynamic) {
    let parts = Array.new<I32>(0);
    let codes = Array.new<I32>(0);
    let values = Array.new<I32>(0);
    let child = 0;

    let flush = fn() {
      if (codes.len() > 0) {
        let (offsets, fixed) = placeSegments(codes);
        parts.push(_checkedPack(codes, offsets, fixed, values));
        codes = Array.new<I32>(0);
        values = Array.new<I32>(0);
      }
      null
    };

    for ({ width, endian, signed, kind, size, value } in segments) {
      if (size != null) {
        flush();
        let checkedSize = widened(checkOperand(size as AstExpr, child, H.TYPE_I32), H.TYPE_I32);
        child++;
        let checkedValue = widened(checkOperand(value, child, H.TYPE_BYTES), H.TYPE_BYTES);
        child++;
        let statements = Array.new<I32>(0);
        let sizeBinding = hideValue(statements, "size", checkedSize);
        let valueBinding = hideValue(statements, "bytes", checkedValue);
        let length = H.opNode(Op.BytesLen, H.TYPE_I32, [H.local(valueBinding, H.TYPE_BYTES)]);
        let nonnegative = H.opNode(Op.Gt, H.TYPE_BOOL, [H.local(sizeBinding, H.TYPE_I32), i32Of(-1)]);
        let exact = H.opNode(Op.Eq, H.TYPE_BOOL, [length, H.local(sizeBinding, H.TYPE_I32)]);
        let valid = H.opNode(Op.And, H.TYPE_BOOL, [nonnegative, exact]);
        statements.push(H.opNode(Op.Expression, 0, [orThrow(valid, bytesOf("bytes segment has the wrong length"))]));
        statements.push(H.local(valueBinding, H.TYPE_BYTES));
        parts.push(H.node(Op.Block, H.TYPE_BYTES, 0, 1, statements));
      } else {
        let code = segmentCode(width, endian, kind);
        _fits(code, signed, value);
        let ty = segmentType(code);
        let checked = widened(checkOperand(value, child, ty), ty);
        child++;
        codes.push(code);
        values.push(checked);
      }
    }
    flush();
    let out = parts[0];
    for (i, part in parts) { if (i > 0) { out = H.opNode(Op.BytesConcat, H.TYPE_BYTES, [out, part]); } }
    return out;
  }

  let codes = Array.new<I32>(0);

  for ({ width, endian, kind } in segments) {
    codes.push(segmentCode(width, endian, kind));
  }
  let (offsets, fixed) = placeSegments(codes);
  let values = Array.new<I32>(0);

  for (i, { signed, value } in segments) {
    _fits(codes[i], signed, value);
    let ty = segmentType(codes[i]);
    let checked = widened(checkOperand(value, i, ty), ty);
    let got = H.typeOf(checked);

    if (got != ty) {
      enterSyntax(syntaxChild(i));
      throw coded(E0400, `this segment holds ${H.typeName(ty)}, not ${H.typeName(got)}`);
    }
    values.push(checked);
  }
  _checkedPack(codes, offsets, fixed, values)
};

// Rebuilds a declaration literal at the caller's current span.
let _constantAt = fn(value: I32): I32 {
  H.node(H.opOf(value), H.typeOf(value), H.valueOf(value), H.auxOf(value), [])
};

/** Returns the pack of a record of the bytes layout `ty` (see `Hir.declareLayout`) as an
 * `Op.BitsPack`.
 * @param values  the record's field values, in order
 * @return the node, of type Bytes */
export let packLayout = fn(ty: I32, values: Array<I32>): I32 {
  let physical = Array.new<I32>(0);
  let input = 0;

  for (field, _ in H.layoutCodes(ty)) {
    let constant = layoutConstant(ty, field);

    if (constant >= 0) {
      physical.push(_constantAt(constant));
    } else {
      physical.push(values[input]);
      input++;
    }
  }
  let dynamic = -1;
  for (field, _ in H.layoutCodes(ty)) { if (layoutSizeField(ty, field) >= 0) { dynamic = field; } }
  if (dynamic < 0) { return _checkedPack(H.layoutCodes(ty), H.layoutOffsets(ty), H.layoutBytes(ty), physical); }

  let statements = Array.new<I32>(0);
  let sizeBinding = hideValue(statements, "size", physical[layoutSizeField(ty, dynamic)]);
  let bytesBinding = hideValue(statements, "bytes", physical[dynamic]);
  let size = fn(): I32 { H.local(sizeBinding, H.TYPE_I32) };
  let payload = fn(): I32 { H.local(bytesBinding, H.TYPE_BYTES) };
  let nonnegative = H.opNode(Op.Gt, H.TYPE_BOOL, [size(), i32Of(-1)]);
  let exact = H.opNode(Op.Eq, H.TYPE_BOOL, [H.opNode(Op.BytesLen, H.TYPE_I32, [payload()]), size()]);
  statements.push(H.opNode(Op.Expression, 0, [orThrow(H.opNode(Op.And, H.TYPE_BOOL, [nonnegative, exact]),
    bytesOf("bytes segment has the wrong length"))]));
  physical[layoutSizeField(ty, dynamic)] = size();
  let prefix = _checkedPack(H.layoutCodes(ty).slice(0, dynamic), H.layoutOffsets(ty).slice(0, dynamic),
    H.layoutBytes(ty), physical.slice(0, dynamic));
  statements.push(H.opNode(Op.BytesConcat, H.TYPE_BYTES, [prefix, payload()]));
  H.node(Op.Block, H.TYPE_BYTES, 0, 1, statements)
};

/** Returns the bytes after the first `fixed` of `bytes`, which `again` reads again for their
 * length. */
export let restOf = fn(bytes: I32, again: I32, fixed: I32): I32 {
  let total = H.opNode(Op.BytesLen, H.TYPE_I32, [again]);
  let length = H.opNode(Op.Sub, H.TYPE_I32, [total, i32Of(fixed)]);
  H.opNode(Op.BytesSlice, H.TYPE_BYTES, [bytes, i32Of(fixed), length])
};

// Returns fixed bytes at the segment's byte offset and width.
let _fixedBytes = fn(bytes: I32, offset: I32, code: I32): I32 {
  H.opNode(Op.BytesSlice, H.TYPE_BYTES, [bytes, i32Of(offset / 8), i32Of(segmentWidth(code) / 8)])
};

/** Returns field `field` of the record of the bytes layout `ty` that bytes hold.
 * @param read  makes a fresh read of the bytes */
export let layoutField = fn(ty: I32, field: I32, read: () -> I32): I32 {
  let code = H.layoutCodes(ty)[field];
  if (segmentWidth(code) == 0) { return restOf(read(), read(), H.layoutBytes(ty)); }
  if ((code & BITS_BYTES) != 0) { return _fixedBytes(read(), H.layoutOffsets(ty)[field], code); }
  H.node(Op.BitsRead, segmentType(code), H.layoutOffsets(ty)[field], code, [read()])
};

/** Returns a record of the bytes layout `ty` read from bytes that hold it.
 * @param read  makes a fresh read of the bytes, which each field reads
 * @return the `Op.Tuple` node, of type `ty` */
export let layoutRecord = fn(ty: I32, read: () -> I32): I32 {
  let values = Array.new<I32>(0);

  while (values.len() < H.fieldCount(ty, 0)) {
    let physical = layoutFieldIndex(ty, values.len());
    let source = layoutSizeField(ty, physical);

    if (source < 0) {
      values.push(layoutField(ty, physical, read));
    } else {
      values.push(H.opNode(Op.BytesSlice, H.TYPE_BYTES,
        [read(), i32Of(H.layoutOffsets(ty)[physical] / 8), layoutField(ty, source, read)]));
    }
  }
  H.opNode(Op.Tuple, ty, values)
};

/** Returns the test that bytes of length `length`, an I32 node, hold a record of the bytes layout
 * `ty`; their length is that of its fixed fields, or more with a rest. */
export let layoutFits = fn(ty: I32, length: I32): I32 {
  let codes = H.layoutCodes(ty);
  let rest = (codes.len() > 0) && (segmentWidth(codes[codes.len() - 1]) == 0);
  lengthTest(length, H.layoutBytes(ty), rest)
};

// Returns whether `bytes` has the layout's length and every hidden constant field's value.
export let layoutValid = fn(ty: I32, read: () -> I32): I32 {
  let valid = layoutFits(ty, H.opNode(Op.BytesLen, H.TYPE_I32, [read()]));

  for (field, _ in H.layoutCodes(ty)) {
    let constant = layoutConstant(ty, field);

    if (constant >= 0) {
      let actual = layoutField(ty, field, read);
      let equal = H.opNode(Op.Eq, H.TYPE_BOOL, [actual, _constantAt(constant)]);
      valid = H.opNode(Op.And, H.TYPE_BOOL, [valid, equal]);
    }
  }

  for (field, _ in H.layoutCodes(ty)) {
    let source = layoutSizeField(ty, field);

    if (source >= 0) {
      let size = fn(): I32 { layoutField(ty, source, read) };
      let nonnegative = H.opNode(Op.Gt, H.TYPE_BOOL, [size(), i32Of(-1)]);
      let end = H.opNode(Op.Add, H.TYPE_I32, [i32Of(H.layoutOffsets(ty)[field] / 8), size()]);
      let length = H.opNode(Op.BytesLen, H.TYPE_I32, [read()]);
      let enough = H.opNode(Op.Not, H.TYPE_BOOL, [H.opNode(Op.Gt, H.TYPE_BOOL, [end, length])]);
      valid = H.opNode(Op.And, H.TYPE_BOOL, [valid, H.opNode(Op.And, H.TYPE_BOOL, [nonnegative, enough])]);
    }
  }
  valid
};

/** Returns `H.unpack(bytes)` of the bytes layout `ty`; its record when the bytes hold one, and
 * otherwise null.
 * @param read  makes a fresh read of the bytes
 * @return the `Op.If` node, of type Null<`ty`> */
export let unpackLayout = fn(ty: I32, read: () -> I32): I32 {
  let result = H.nullType(ty);
  let record = H.opNode(Op.Present, result, [layoutRecord(ty, read)]);
  let fits = layoutValid(ty, read);
  H.opNode(Op.If, result, [fits, record, H.opNode(Op.Null, result, [])])
};
