package frontend.semantics;

import type { BitExprSegment, Endian, Expr as AstExpr, ObjectEntry } from frontend.syntax.Ast;
import { BitValueKind, wideIntegerValue } from frontend.syntax.Ast;
import frontend.hir.Hir as H;
import { BITS_BIG, BITS_FLOAT, Op, segmentType, segmentWidth } from frontend.hir.Hir;
import { i32Of, lengthTest } from frontend.semantics.Derived;
import { checkOperand, enterSyntax, syntaxChild, widened } from frontend.semantics.TypeCheck;
import { E0007, E0104, E0400, coded } from support.Codes;

export let segmentCode = fn(width: I32, endian: Endian, kind: BitValueKind): I32 {
  let order = match (endian) { Big => BITS_BIG, Little => 0 };
  width + order + (match (kind) { Float => BITS_FLOAT, _ => 0 })
};

export let placeSegments = fn(codes: Array<I32>): Tuple<Array<I32>, I32> {
  let offsets = Array.new<I32>(0);
  let bit = 0;
  let i = 0;

  while (i < codes.len()) {
    let width = segmentWidth(codes[i]);

    if (width == 0) {
      let later = i + 1;

      while (later < codes.len()) {
        if (segmentWidth(codes[later]) == 0) {
          throw coded(E0104, "a bits value has at most one rest segment");
        }
        later++;
      }
      if (later > i + 1) { throw coded(E0104, "a rest segment must be the last"); }
    }

    if (((width == 0) || (width >= 8)) && (bit % 8 != 0)) {
      throw coded(E0104, "a segment of 8 or more bits, or a rest, must start on a byte boundary");
    }
    offsets.push(bit);
    bit += width;
    i++;
  }
  if (bit % 8 != 0) { throw coded(E0104, "the segments of a bits value must fill whole bytes"); }
  (offsets, bit / 8)
};

export let checkSegmentLiteral = fn(code: I32, signed: Bool, digits: Bytes, negative: Bool): Bool {
  let width = segmentWidth(code);
  if (signed || (width >= 32) || ((code & BITS_FLOAT) != 0)) { return true; }
  let value = wideIntegerValue(digits, negative);

  if ((value < 0) || (value >= ((1 as I64) << (width as I64)))) {
    let sign = negative ? "-" : "";
    let unit = width == 1 ? "bit" : "bits";
    throw coded(E0007, `${sign}${digits} does not fit in ${width} ${unit}`);
  }
  true
};

let _fits = fn(code: I32, signed: Bool, value: AstExpr): Bool {
  match (value) {
    Integer(digits, _) => checkSegmentLiteral(code, signed, digits, false),
    Unary(Negate, Integer(digits, _)) => checkSegmentLiteral(code, signed, digits, true),
    _ => true,
  }
};

export let checkLayoutLiterals = fn(ty: I32, entries: Array<ObjectEntry>): Bool {
  let codes = H.layoutCodes(ty);
  let i = 0;

  while (i < entries.len()) {
    match (entries[i]) {
      Field(name, value) => {
        let field = H.recordField(ty, name);

        if (field >= 0) {
          let outer = enterSyntax(syntaxChild(i));
          _fits(codes[field], false, value);
          enterSyntax(outer);
        }
      },
      _ => null,
    };
    i++;
  }
  true
};

let _pack = fn(codes: Array<I32>, offsets: Array<I32>, fixed: I32, values: Array<I32>): I32 {
  let fields = Array.new<I32>(0);
  let i = 0;

  while (i < codes.len()) {
    let code = codes[i];
    fields.push(H.node(Op.BitsField, segmentType(code), offsets[i], code, [values[i]]));
    i++;
  }
  H.node(Op.BitsPack, H.TYPE_BYTES, fixed, 0, fields)
};

export let checkBits = fn(segments: Array<BitExprSegment>): I32 {
  let codes = Array.new<I32>(0);
  let i = 0;

  while (i < segments.len()) {
    let { width, endian, kind } = segments[i];
    codes.push(segmentCode(width, endian, kind));
    i++;
  }
  let (offsets, fixed) = placeSegments(codes);
  let values = Array.new<I32>(0);
  i = 0;

  while (i < segments.len()) {
    let { signed, value } = segments[i];
    _fits(codes[i], signed, value);
    let ty = segmentType(codes[i]);
    let checked = widened(checkOperand(value, i, ty), ty);
    let got = H.typeOf(checked);

    if (got != ty) {
      enterSyntax(syntaxChild(i));
      throw coded(E0400, `this segment holds ${H.typeName(ty)}, not ${H.typeName(got)}`);
    }
    values.push(checked);
    i++;
  }
  _pack(codes, offsets, fixed, values)
};

export let packLayout = fn(ty: I32, values: Array<I32>): I32 {
  _pack(H.layoutCodes(ty), H.layoutOffsets(ty), H.layoutBytes(ty), values)
};

export let restOf = fn(bytes: I32, again: I32, fixed: I32): I32 {
  let total = H.opNode(Op.BytesLen, H.TYPE_I32, [again]);
  let length = H.opNode(Op.Sub, H.TYPE_I32, [total, i32Of(fixed)]);
  H.opNode(Op.BytesSlice, H.TYPE_BYTES, [bytes, i32Of(fixed), length])
};

export let layoutField = fn(ty: I32, field: I32, read: () -> I32): I32 {
  let code = H.layoutCodes(ty)[field];
  if (segmentWidth(code) == 0) { return restOf(read(), read(), H.layoutBytes(ty)); }
  H.node(Op.BitsRead, segmentType(code), H.layoutOffsets(ty)[field], code, [read()])
};

export let layoutRecord = fn(ty: I32, read: () -> I32): I32 {
  let values = Array.new<I32>(0);

  while (values.len() < H.layoutCodes(ty).len()) {
    values.push(layoutField(ty, values.len(), read));
  }
  H.opNode(Op.Tuple, ty, values)
};

export let layoutFits = fn(ty: I32, length: I32): I32 {
  let codes = H.layoutCodes(ty);
  let rest = (codes.len() > 0) && (segmentWidth(codes[codes.len() - 1]) == 0);
  lengthTest(length, H.layoutBytes(ty), rest)
};

export let unpackLayout = fn(ty: I32, read: () -> I32): I32 {
  let result = H.nullType(ty);
  let record = H.opNode(Op.Present, result, [layoutRecord(ty, read)]);
  let fits = layoutFits(ty, H.opNode(Op.BytesLen, H.TYPE_I32, [read()]));
  H.opNode(Op.If, result, [fits, record, H.opNode(Op.Null, result, [])])
};
