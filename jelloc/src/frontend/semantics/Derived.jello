package frontend.semantics;

import type { BinaryOp } from frontend.syntax.Ast;
import { BinaryOp } from frontend.syntax.Ast;
import frontend.hir.Hir as H;
import { Kind, Op } from frontend.hir.Hir;
import { equalValues } from frontend.semantics.Values;
import { Binding } from frontend.semantics.ModuleScope;
import {
  bufferHint, callFunction, defineFunction, enterSyntax, generateFunction, inTemplate,
  isNullaryVariant, needsBound, newBinding, syntaxChild, unknownType,
} from frontend.semantics.TypeCheck;
import { E0500, coded } from support.Codes;

let _deciding = Array.new<I32>(0);

let _fieldsUnsupported = fn(ty: I32, printing: Bool): I32 {
  _deciding.push(ty);
  let tag = 0;
  let found = -1;

  while ((found < 0) && (tag < H.variantCount(ty))) {
    let field = 0;

    while ((found < 0) && (field < H.fieldCount(ty, tag))) {
      found = _unsupported(H.fieldType(ty, tag, field), printing);
      field++;
    }
    tag++;
  }
  _deciding.pop();
  found
};

let _unsupported = fn(ty: I32, printing: Bool): I32 {
  match (H.kindOf(ty)) {
    Function => printing ? ty : -1,
    ByteBuffer => ty,
    Dynamic => printing ? -1 : ty,
    Null => H.innerOf(ty) < 0 ? -1 : _unsupported(H.innerOf(ty), printing),
    Array, List => _unsupported(H.innerOf(ty), printing),
    Tuple => {
      let i = 0;
      let found = -1;

      while ((found < 0) && (i < H.typeArgCount(ty))) {
        found = _unsupported(H.typeArg(ty, i), printing);
        i++;
      }
      found
    },
    Enum, Applied, Record => _deciding.indexOf(ty) < 0 ? _fieldsUnsupported(ty, printing) : -1,
    Param => H.hasBounds(ty, printing ? H.BOUND_SHOW : H.BOUND_EQ) ? -1 : ty,
    _ => -1,
  }
};
export let unsupported = fn(ty: I32, printing: Bool): I32 { _unsupported(ty, printing) };

let _boundHint = fn(bad: I32, printing: Bool): Bytes {
  H.isKind(bad, Kind.Param) ? `; it ${needsBound(bad, printing ? "Show" : "Eq")}` : ""
};

let _tagOnly = fn(ty: I32): Bool {
  let tag = 0;

  while (tag < H.variantCount(ty)) {
    if (H.fieldCount(ty, tag) > 0) { return false; }
    tag++;
  }
  true
};

export let boolOf = fn(value: Bool): I32 { H.node(Op.Bool, H.TYPE_BOOL, value ? 1 : 0, 0, []) };
export let i32Of = fn(value: I32): I32 { H.node(Op.I32, H.TYPE_I32, value, 0, []) };

export let lengthTest = fn(length: I32, count: I32, open: Bool): I32 {
  if (open) {
    H.opNode(Op.Gt, H.TYPE_BOOL, [length, i32Of(count - 1)])
  } else {
    H.opNode(Op.Eq, H.TYPE_BOOL, [length, i32Of(count)])
  }
};
let _and = fn(left: I32, right: I32): I32 { H.opNode(Op.And, H.TYPE_BOOL, [left, right]) };
let _not = fn(value: I32): I32 { H.opNode(Op.Not, H.TYPE_BOOL, [value]) };
let _tag = fn(value: I32): I32 { H.opNode(Op.EnumTag, H.TYPE_I32, [value]) };

let _unlessEqual = fn(equal: I32): I32 {
  let unequal = _not(equal);
  let bail = H.opNode(Op.Block, 0, [H.opNode(Op.Return, 0, [boolOf(false)])]);
  H.opNode(Op.IfStatement, 0, [unequal, bail])
};
export let expressionOf = fn(value: I32): I32 { H.opNode(Op.Expression, 0, [value]) };

export let steppedWhile = fn(more: I32, body: Array<I32>, step: Array<I32>): I32 {
  H.opNode(Op.While, 0, [more, H.opNode(Op.Block, 0, body), H.opNode(Op.Block, 0, step)])
};

export typedef IndexLoop = {
  let index: I32;
  let start: I32;
  let more: I32;
  let next: I32;
};

export let indexLoop = fn(length: () -> I32): IndexLoop {
  let index = newBinding();
  let start = H.declareBinding(Op.Let, index, "index", i32Of(0));
  let more = H.opNode(Op.Lt, H.TYPE_BOOL, [H.local(index, H.TYPE_I32), length()]);
  let sum = H.opNode(Op.Add, H.TYPE_I32, [H.local(index, H.TYPE_I32), i32Of(1)]);
  { index, start, more, next: expressionOf(H.node(Op.Assign, H.TYPE_I32, index, 0, [sum])) }
};

let _tuples = fn(left: I32, right: I32, ty: I32): Array<I32> {
  let equal = -1;
  let i = H.memberCount(ty) - 1;

  while (i >= 0) {
    let field = H.memberType(ty, i);
    let mine = H.node(Op.TupleField, field, i, 0, [H.local(left, ty)]);
    let theirs = H.node(Op.TupleField, field, i, 0, [H.local(right, ty)]);
    let same = equalValues(BinaryOp.Equal, mine, theirs);
    equal = equal < 0 ? same : _and(same, equal);
    i--;
  }
  [equal < 0 ? boolOf(true) : equal]
};

let _field = fn(binding: I32, ty: I32, tag: I32, field: I32): I32 {
  H.node(Op.EnumField, H.fieldType(ty, tag, field), field, tag, [H.local(binding, ty)])
};

let _enums = fn(left: I32, right: I32, ty: I32): Array<I32> {
  let fields = boolOf(true);
  let tag = H.variantCount(ty) - 1;

  while (tag >= 0) {
    let count = H.fieldCount(ty, tag);

    if (count > 0) {
      let equal = -1;
      let field = count - 1;

      while (field >= 0) {
        let mine = _field(left, ty, tag, field);
        let same = equalValues(BinaryOp.Equal, mine, _field(right, ty, tag, field));
        equal = equal < 0 ? same : _and(same, equal);
        field--;
      }
      let chosen = H.opNode(Op.Eq, H.TYPE_BOOL, [_tag(H.local(left, ty)), i32Of(tag)]);
      fields = H.opNode(Op.If, H.TYPE_BOOL, [chosen, equal, fields]);
    }
    tag--;
  }
  let tags = H.opNode(Op.Eq, H.TYPE_BOOL, [_tag(H.local(left, ty)), _tag(H.local(right, ty))]);
  [_and(tags, fields)]
};

let _arrays = fn(left: I32, right: I32, ty: I32): Array<I32> {
  let length = newBinding();
  let loop = indexLoop(fn() { H.local(length, H.TYPE_I32) });
  let element = H.innerOf(ty);

  let lengthOf = fn(binding: I32): I32 {
    H.opNode(Op.ArrayLen, H.TYPE_I32, [H.local(binding, ty)])
  };

  let at = fn(binding: I32): I32 {
    H.opNode(Op.ArrayGet, element, [H.local(binding, ty), H.local(loop.index, H.TYPE_I32)])
  };
  let unequal = _unlessEqual(equalValues(BinaryOp.Equal, at(left), at(right)));
  [
    H.declareBinding(Op.Const, length, "length", lengthOf(left)),
    _unlessEqual(H.opNode(Op.Eq, H.TYPE_BOOL, [H.local(length, H.TYPE_I32), lengthOf(right)])),
    loop.start,
    steppedWhile(loop.more, [unequal], [loop.next]),
    boolOf(true)
  ]
};

let _lists = fn(left: I32, right: I32, ty: I32): Array<I32> {
  let a = newBinding();
  let b = newBinding();
  let element = H.innerOf(ty);

  let isNil = fn(binding: I32): I32 {
    H.opNode(Op.ListIsNil, H.TYPE_BOOL, [H.local(binding, ty)])
  };
  let head = fn(binding: I32): I32 { H.opNode(Op.ListHead, element, [H.local(binding, ty)]) };

  let advance = fn(binding: I32): I32 {
    let tail = H.opNode(Op.ListTail, ty, [H.local(binding, ty)]);
    expressionOf(H.node(Op.Assign, ty, binding, 0, [tail]))
  };
  let more = _not(isNil(b));
  let heads = equalValues(BinaryOp.Equal, head(a), head(b));
  let same = H.opNode(Op.And, H.TYPE_BOOL, [more, heads]);
  [
    H.declareBinding(Op.Let, a, "left", H.local(left, ty)),
    H.declareBinding(Op.Let, b, "right", H.local(right, ty)),
    steppedWhile(_not(isNil(a)), [_unlessEqual(same)], [advance(a), advance(b)]),
    isNil(b)
  ]
};

let _equalTypes = Array.new<I32>(0);
let _equalFunctions = Array.new<I32>(0);
let _stringTypes = Array.new<I32>(0);
let _stringFunctions = Array.new<I32>(0);

export let resetDerived = fn(): Bool {
  _equalTypes = Array.new<I32>(0);
  _equalFunctions = Array.new<I32>(0);
  _stringTypes = Array.new<I32>(0);
  _stringFunctions = Array.new<I32>(0);
  true
};

let _derived = fn(
  types: Array<I32>,
  functions: Array<I32>,
  name: Bytes,
  params: Array<Bytes>,
  ty: I32,
  result: I32,
  body: (Array<I32>, I32) -> Array<I32>
): I32 {
  if (H.isOpen(ty)) { throw unknownType("this value"); }
  let found = types.indexOf(ty);
  if (found >= 0) { return functions[found]; }
  let paramTypes = Array.new<I32>(0);
  let bindings = Array.new<I32>(0);
  let children = Array.new<I32>(0);

  for (param in params) {
    let binding = newBinding();
    paramTypes.push(ty);
    bindings.push(binding);
    children.push(H.node(Op.Parameter, ty, binding, H.bytesId(param), []));
  }
  let fnType = H.functionType(paramTypes, result);
  let index = generateFunction(name, params, fnType);
  types.push(ty);
  functions.push(index);
  children.push(H.node(Op.Block, result, 0, 1, body(bindings, ty)));
  defineFunction(index, H.node(Op.Function, fnType, H.bytesId(name), 0, children));
  index
};

let _equalBody = fn(params: Array<I32>, ty: I32): Array<I32> {
  match (H.kindOf(ty)) {
    Tuple, Record => _tuples(params[0], params[1], ty),
    Enum => _enums(params[0], params[1], ty),
    Array => _arrays(params[0], params[1], ty),
    _ => _lists(params[0], params[1], ty),
  }
};

export let structuralEquality = fn(op: BinaryOp, left: I32, right: I32): I32 {
  let ty = H.defaultIntegers(H.typeOf(left));
  let bad = _unsupported(ty, false);

  if (bad >= 0) {
    let undefined = `operator == is not defined for ${H.typeName(ty)}`;
    throw coded(E0500, `${undefined}, which holds ${H.typeName(bad)}${_boundHint(bad, false)}`);
  }

  let equal = if (inTemplate()) {
    H.opNode(Op.Eq, H.TYPE_BOOL, [left, right])
  } else if (H.isKind(ty, Kind.Enum) && _tagOnly(ty)) {
    H.opNode(Op.Eq, H.TYPE_BOOL, [_tag(left), _tag(right)])
  } else {
    let derived = _derived(
      _equalTypes, _equalFunctions, "equal", ["left", "right"], ty, H.TYPE_BOOL, _equalBody
    );
    callFunction(Binding.Function(derived), "equal", [left, right])
  };
  match (op) { NotEqual => _not(equal), _ => equal }
};

export let bytesOf = fn(value: Bytes): I32 {
  H.node(Op.Bytes, H.TYPE_BYTES, H.bytesId(value), 0, [])
};

export let concatOf = fn(left: I32, right: I32): I32 {
  H.opNode(Op.BytesConcat, H.TYPE_BYTES, [left, right])
};

export let joinOf = fn(parts: Array<I32>): I32 {
  if (parts.len() == 0) { return bytesOf(""); }
  if (parts.len() == 1) { return parts[0]; }
  if (parts.len() == 2) { return concatOf(parts[0], parts[1]); }
  H.opNode(Op.BytesConcatMany, H.TYPE_BYTES, parts)
};

let _listed = fn(open: Bytes, names: Array<Bytes>, texts: Array<I32>, close: Bytes): I32 {
  let parts = Array.new<I32>(0);

  for (i, text in texts) {
    let lead = i == 0 ? open : ", ";
    parts.push(bytesOf(names.len() > 0 ? `${lead}${names[i]}: ` : lead));
    parts.push(text);
  }
  parts.push(bytesOf(texts.len() == 0 ? `${open}${close}` : close));
  joinOf(parts)
};

let _tupleText = fn(value: I32, ty: I32): Array<I32> {
  let record = H.isKind(ty, Kind.Record);
  let names = Array.new<Bytes>(0);
  let texts = Array.new<I32>(0);
  let i = 0;

  while (i < H.memberCount(ty)) {
    if (record) { names.push(H.fieldName(ty, 0, i)); }
    let field = H.node(Op.TupleField, H.memberType(ty, i), i, 0, [H.local(value, ty)]);
    texts.push(_shown(field, true));
    i++;
  }

  if (record) {
    [_listed("{", names, texts, "}")]
  } else {
    [_listed("(", names, texts, texts.len() == 1 ? ",)" : ")")]
  }
};

let _variantName = fn(ty: I32, tag: I32): Bytes { `${H.enumName(ty)}.${H.variantName(ty, tag)}` };

let _variantText = fn(value: I32, ty: I32, tag: I32): I32 {
  let name = _variantName(ty, tag);
  if (H.fieldCount(ty, tag) == 0) { return bytesOf(name); }
  let texts = Array.new<I32>(0);
  let field = 0;

  while (field < H.fieldCount(ty, tag)) {
    texts.push(_shown(_field(value, ty, tag, field), true));
    field++;
  }
  _listed(`${name}(`, Array.new<Bytes>(0), texts, ")")
};

let _enumText = fn(value: I32, ty: I32): Array<I32> {
  let tag = H.variantCount(ty) - 1;
  let text = _variantText(value, ty, tag);

  while (tag > 0) {
    tag--;
    let same = H.opNode(Op.Eq, H.TYPE_BOOL, [_tag(H.local(value, ty)), i32Of(tag)]);
    text = H.opNode(Op.If, H.TYPE_BYTES, [same, _variantText(value, ty, tag), text]);
  }
  [text]
};

let _bracketed = fn(setup: I32, more: I32, element: I32, next: I32): Array<I32> {
  let texts = newBinding();
  let ty = H.arrayType(H.TYPE_BYTES);
  let push = H.opNode(Op.ArrayPush, H.TYPE_I32, [H.local(texts, ty), _shown(element, true)]);
  let joined = H.opNode(Op.BytesJoin, H.TYPE_BYTES, [H.local(texts, ty), bytesOf(", ")]);
  [
    setup,
    H.declareBinding(Op.Let, texts, "texts", H.opNode(Op.ArrayLiteral, ty, [])),
    steppedWhile(more, [expressionOf(push)], [next]),
    joinOf([bytesOf("["), joined, bytesOf("]")])
  ]
};

let _arrayText = fn(value: I32, ty: I32): Array<I32> {
  let loop = indexLoop(fn() { H.opNode(Op.ArrayLen, H.TYPE_I32, [H.local(value, ty)]) });
  let at = H.local(loop.index, H.TYPE_I32);
  let item = H.innerOf(ty);
  let element = H.opNode(Op.ArrayGet, item, [H.local(value, ty), at]);

  let shown = match (H.kindOf(item)) {
    Bytes, Tuple, Record, Enum, Array => H.opNode(Op.Present, H.nullType(item), [element]),
    _ => element,
  };
  _bracketed(loop.start, loop.more, shown, loop.next)
};

let _listText = fn(value: I32, ty: I32): Array<I32> {
  let rest = newBinding();
  let more = _not(H.opNode(Op.ListIsNil, H.TYPE_BOOL, [H.local(rest, ty)]));
  let head = H.opNode(Op.ListHead, H.innerOf(ty), [H.local(rest, ty)]);
  let tail = H.opNode(Op.ListTail, ty, [H.local(rest, ty)]);
  let next = expressionOf(H.node(Op.Assign, ty, rest, 0, [tail]));
  _bracketed(H.declareBinding(Op.Let, rest, "rest", H.local(value, ty)), more, head, next)
};

let _nullableText = fn(value: I32, ty: I32, quoted: Bool): I32 {
  let present = _shown(H.opNode(Op.Unwrap, H.innerOf(ty), [H.local(value, ty)]), quoted);
  let missing = H.opNode(Op.IsNull, H.TYPE_BOOL, [H.local(value, ty)]);
  H.opNode(Op.If, H.TYPE_BYTES, [missing, bytesOf("null"), present])
};

let _stringBody = fn(params: Array<I32>, ty: I32): Array<I32> {
  match (H.kindOf(ty)) {
    Tuple, Record => _tupleText(params[0], ty),
    Enum => _enumText(params[0], ty),
    Array => _arrayText(params[0], ty),
    List => _listText(params[0], ty),
    _ => [_nullableText(params[0], ty, true)],
  }
};

let _shown = fn(value: I32, quoted: Bool): I32 {
  let present = H.typeOf(value);
  let ty = H.isInteger(present) ? present : H.defaultIntegers(present);
  if (isNullaryVariant(value)) { return bytesOf(_variantName(ty, H.valueOf(value))); }

  match (H.kindOf(ty)) {
    Bytes => quoted ? H.callStd("quote", [H.TYPE_BYTES], H.TYPE_BYTES, [value]) : value,
    Atom when (quoted) => concatOf(bytesOf(":"), _shown(value, false)),
    Bool, I32, I64, Atom, I8, I16, U8, U16, U32, F64, F32, F16, Var => {
      let boxed = H.opNode(Op.ToDynamic, H.TYPE_DYNAMIC, [value]);
      H.callStd("to_string", [H.TYPE_DYNAMIC], H.TYPE_BYTES, [boxed])
    },
    U64 => H.callStd("u64_string", [H.TYPE_U64], H.TYPE_BYTES, [value]),
    Dynamic => H.callStd(quoted ? "object_string" : "to_string", [H.TYPE_DYNAMIC], H.TYPE_BYTES,
      [value]),
    Object => {
      let boxed = H.opNode(Op.ToDynamic, H.TYPE_DYNAMIC, [value]);
      H.callStd("object_string", [H.TYPE_DYNAMIC], H.TYPE_BYTES, [boxed])
    },
    Null when (H.innerOf(ty) < 0) => {
      H.node(Op.Block, H.TYPE_BYTES, 0, 1, [expressionOf(value), bytesOf("null")])
    },
    Null when (!quoted) => {
      let held = newBinding();
      let declared = H.declareBinding(Op.Let, held, "held", value);
      H.node(Op.Block, H.TYPE_BYTES, 0, 1, [declared, _nullableText(held, ty, false)])
    },
    Abstract => {
      let name = bytesOf(`<${H.typeName(ty)}>`);
      H.node(Op.Block, H.TYPE_BYTES, 0, 1, [expressionOf(value), name])
    },
    _ when (inTemplate()) => {
      H.node(Op.Block, H.TYPE_BYTES, 0, 1, [expressionOf(value), bytesOf("")])
    },
    _ => {
      let derived = _derived(
        _stringTypes, _stringFunctions, "string", ["value"], ty, H.TYPE_BYTES, _stringBody
      );
      callFunction(Binding.Function(derived), "string", [value])
    },
  }
};

export let printed = fn(value: I32, what: Bytes, at: I32): I32 {
  let ty = H.typeOf(value);
  let bad = _unsupported(ty, true);

  if (bad >= 0) {
    if (at >= 0) { enterSyntax(syntaxChild(at)); }
    let shown = `${what} cannot print ${H.typeName(ty)}`;
    let held = bad == ty ? "" : `, which holds ${H.typeName(bad)}`;
    throw coded(E0500, `${shown}${held}${bufferHint(bad)}${_boundHint(bad, true)}`);
  }
  _shown(value, false)
};

export let literalOf = fn(value: I32): I32 { _shown(value, true) };
