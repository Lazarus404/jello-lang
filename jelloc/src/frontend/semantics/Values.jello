package frontend.semantics;

import type { BinaryOp, Expr as AstExpr, Type as AstType } from frontend.syntax.Ast;
import { BinaryOp, Type as AstType } from frontend.syntax.Ast;
import frontend.hir.Hir as H;
import { internalError } from support.Internal;
import { Kind, Op } from frontend.hir.Hir;
import {
  binaryValues, bufferHint, checkOperand, checkType, enterSyntax, hideValue, inTemplate,
  integerConversion, isNullaryVariant, presentAt, presentKnown, prototypeValue, syntaxChild,
  upcasts,
} from frontend.semantics.TypeCheck;
import { E0405, E0406, E0407, E0500, coded } from support.Codes;

let _bool = fn(op: Op, children: Array<I32>): I32 { H.opNode(op, H.TYPE_BOOL, children) };

let _lifted = fn(id: I32): I32 {
  match (H.opOf(id)) {
    Present => H.childOf(id, 0),
    _ => id,
  }
};

let _present = fn(binding: I32, ty: I32): I32 {
  if (H.isKind(ty, Kind.Null)) {
    H.opNode(Op.Unwrap, H.innerOf(ty), [H.local(binding, ty)])
  } else {
    H.local(binding, ty)
  }
};

export let equalityOperands = fn(
  leftExpr: AstExpr,
  rightExpr: AstExpr,
  first: I32
): Tuple<I32, I32> {
  let left = presentKnown(checkOperand(leftExpr, first, -1));
  let leftType = H.typeOf(left);
  let inner = H.isKind(leftType, Kind.Null) ? H.innerOf(leftType) : leftType;

  let context = if (leftType == H.TYPE_DYNAMIC) {
    -1
  } else if (H.isKind(inner, Kind.List)) {
    inner
  } else {
    H.nullType(inner)
  };
  let right = presentKnown(_lifted(checkOperand(rightExpr, first + 1, context)));
  (left, right)
};

export let bindOnce = fn(statements: Array<I32>, name: Bytes, value: I32): I32 {
  isNullaryVariant(value) ? -1 : hideValue(statements, name, value)
};

export let orThrow = fn(condition: I32, message: I32): I32 {
  let raise = H.opNode(Op.Throw, 0, [message]);
  let thrown = H.node(Op.Block, H.TYPE_NULL, 0, 1, [raise, H.opNode(Op.Null, H.TYPE_NULL, [])]);
  let passed = H.opNode(Op.Null, H.TYPE_NULL, []);
  H.opNode(Op.If, H.TYPE_NULL, [condition, passed, thrown])
};

let _read = fn(binding: I32, value: I32): I32 {
  binding < 0 ? value : H.local(binding, H.typeOf(value))
};

let _negated = fn(op: BinaryOp, equal: I32): I32 {
  match (op) {
    NotEqual => _bool(Op.Not, [equal]),
    _ => equal,
  }
};

let _dynamicPresentEqual = fn(d: I32, ty: I32, value: I32): I32 {
  if (ty == H.TYPE_DYNAMIC) {
    throw coded(E0407, "two Dynamic values cannot be compared; extract one with `as T`");
  }

  if (ty == H.TYPE_U64) {
    throw coded(E0407, "a Dynamic cannot be compared with a U64, which it never holds");
  }

  if (!H.isIntegerType(ty) && (checkedKind(ty) < 0)) {
    throw coded(E0407, "a Dynamic compares only with null or a value `is` can test, not "
      + H.typeName(ty) + UNCHECKED_KINDS);
  }
  let held = H.isIntegerType(ty) ? H.TYPE_I64 : ty;
  let compared = (ty == held) ? value : H.opNode(Op.Convert, held, [value]);
  let extracted = H.opNode(Op.FromDynamic, held, [H.local(d, H.TYPE_DYNAMIC)]);
  let holds = kindTest(H.local(d, H.TYPE_DYNAMIC), held);
  _bool(Op.And, [holds, binaryValues(BinaryOp.Equal, extracted, compared)])
};

let _dynamicEqual = fn(d: I32, v: I32, value: I32): I32 {
  let ty = H.defaultIntegers(H.typeOf(value));
  if (!H.isKind(ty, Kind.Null)) { return _dynamicPresentEqual(d, ty, _read(v, value)); }
  let present = _dynamicPresentEqual(d, H.innerOf(ty), _present(v, ty));
  let absent = _bool(Op.IsNull, [H.local(v, ty)]);
  let empty = _bool(Op.IsNull, [H.local(d, H.TYPE_DYNAMIC)]);
  H.opNode(Op.If, H.TYPE_BOOL, [absent, empty, present])
};

export let equalBindings = fn(op: BinaryOp, a: I32, left: I32, b: I32, right: I32): I32 {
  let leftType = H.typeOf(left);
  let rightType = H.typeOf(right);
  if (leftType == H.TYPE_DYNAMIC) { return _negated(op, _dynamicEqual(a, b, right)); }
  if (rightType == H.TYPE_DYNAMIC) { return _negated(op, _dynamicEqual(b, a, left)); }
  let leftNull = H.isKind(leftType, Kind.Null);
  let rightNull = H.isKind(rightType, Kind.Null);
  if (!leftNull && !rightNull) { return binaryValues(op, _read(a, left), _read(b, right)); }
  let inner = leftNull ? H.innerOf(leftType) : leftType;

  if ((rightNull ? H.innerOf(rightType) : rightType) != inner) {
    throw coded(E0500, `cannot compare ${H.typeName(leftType)} with ${H.typeName(rightType)}`);
  }
  let mine = a < 0 ? left : _present(a, leftType);
  let equal = binaryValues(BinaryOp.Equal, mine, b < 0 ? right : _present(b, rightType));

  let compared = if (leftNull && rightNull) {
    let leftAbsent = _bool(Op.IsNull, [H.local(a, leftType)]);
    let rightAbsent = _bool(Op.IsNull, [H.local(b, rightType)]);
    let both = _bool(Op.And, [_bool(Op.IsPresent, [H.local(b, rightType)]), equal]);
    H.opNode(Op.If, H.TYPE_BOOL, [leftAbsent, rightAbsent, both])
  } else {
    let nullable = leftNull ? H.local(a, leftType) : H.local(b, rightType);
    _bool(Op.And, [_bool(Op.IsPresent, [nullable]), equal])
  };
  _negated(op, compared)
};

export let equalValues = fn(op: BinaryOp, left: I32, right: I32): I32 {
  let plain = fn(ty: I32): Bool { !H.isKind(ty, Kind.Null) && (ty != H.TYPE_DYNAMIC) };
  if (plain(H.typeOf(left)) && plain(H.typeOf(right))) { return binaryValues(op, left, right); }
  let statements = Array.new<I32>(0);
  let a = bindOnce(statements, "left", left);
  let b = bindOnce(statements, "right", right);
  statements.push(equalBindings(BinaryOp.Equal, a, left, b, right));
  _negated(op, H.node(Op.Block, H.TYPE_BOOL, 0, 1, statements))
};

let _equality = fn(op: BinaryOp, leftExpr: AstExpr, rightExpr: AstExpr): I32 {
  let (left, right) = equalityOperands(leftExpr, rightExpr, 0);
  equalValues(op, left, right)
};

export let checkedKind = fn(ty: I32): I32 {
  match (H.kindOf(ty)) {
    Bool => H.KIND_BOOL,
    I32 => H.KIND_I32,
    Bytes => H.KIND_BYTES,
    I64 => H.KIND_I64,
    Atom => H.KIND_ATOM,
    Enum => H.KIND_ENUM,
    F64 => H.KIND_F64,
    F32 => H.KIND_F32,
    F16 => H.KIND_F16,
    Object => ty == H.TYPE_OBJECT ? H.KIND_OBJECT : -1,
    _ => -1,
  }
};

export let UNCHECKED_KINDS: Bytes =
  ": only Bool, I32, I64, F16, F32, F64, Atom, Bytes, enums and Object are checked";

let _negative = fn(ty: I32, limit: Bytes): Bytes {
  let boxing = `a ${H.typeName(ty)} cannot become Dynamic`;
  coded(E0405, `${boxing}: one above the greatest ${limit} would read as negative`)
};

let _boxable = fn(operand: I32) {
  let ty = H.typeOf(operand);

  if (ty == H.TYPE_BYTE_BUFFER) {
    throw coded(E0405, `a buffer from Bytes.new cannot become Dynamic${bufferHint(ty)}`);
  }

  if (H.isKind(ty, Kind.List)) {
    throw coded(E0405, "a list cannot become Dynamic: its nil would read as null");
  }
  let held = (H.isKind(ty, Kind.Null) && (H.innerOf(ty) >= 0)) ? H.resolve(H.innerOf(ty)) : ty;
  if (held == H.TYPE_U64) { throw _negative(ty, "I64"); }
  if ((held == H.TYPE_U32) && (held != ty)) { throw _negative(ty, "I32"); }
  null
};

export let toDynamic = fn(operand: I32): I32 {
  _boxable(operand);
  H.opNode(Op.ToDynamic, H.TYPE_DYNAMIC, [operand])
};

let _delegatesTo = fn(operand: I32, ty: I32): I32 {
  let parent = toDynamic(prototypeValue(ty));
  H.callStd("object_delegates", [H.TYPE_DYNAMIC, H.TYPE_DYNAMIC], H.TYPE_BOOL, [operand, parent])
};

let _asPrototype = fn(operand: I32, ty: I32): I32 {
  let statements = Array.new<I32>(0);
  let boxed = H.typeOf(operand) == H.TYPE_DYNAMIC ? operand : toDynamic(operand);
  let held = hideValue(statements, "value", boxed);
  let failed = toDynamic(H.opNode(Op.Bool, H.TYPE_BOOL, []));
  let delegates = _delegatesTo(H.local(held, H.TYPE_DYNAMIC), ty);
  let value = H.local(held, H.TYPE_DYNAMIC);
  let checked = H.opNode(Op.If, H.TYPE_DYNAMIC, [delegates, value, failed]);
  statements.push(H.opNode(Op.FromDynamic, ty, [checked]));
  H.node(Op.Block, ty, 0, 1, statements)
};

export let storable = fn(operand: I32): I32 {
  if (H.typeOf(operand) == H.TYPE_U32) { return toDynamic(operand); }
  _boxable(operand);
  operand
};

let _deferred = fn(target: I32): Bool { inTemplate() && H.isParametric(target) };

let _wideLiteral = fn(id: I32): Bool {
  match (H.opOf(id)) {
    I32 => {
      let value = H.wideValueOf(id);
      (value < -2147483648) || (value > 2147483647)
    },
    _ => false,
  }
};

let _cast = fn(value: AstExpr, targetType: AstType): I32 {
  let target = checkType(targetType);
  let operand = checkOperand(value, 0, -1);
  let ty = H.typeOf(operand);
  if (ty == target) { return operand; }

  if (ty == H.TYPE_BYTE_BUFFER) {
    throw coded(E0406, "`as` cannot convert a buffer from Bytes.new" + bufferHint(ty));
  }
  if (target == H.TYPE_DYNAMIC) { return toDynamic(operand); }
  if (upcasts(ty, target)) { return H.opNode(Op.Convert, target, [operand]); }

  if (H.isPrototype(target) && (H.isObject(ty) || (ty == H.TYPE_DYNAMIC))) {
    return _asPrototype(operand, target);
  }

  if (ty == H.TYPE_DYNAMIC) {
    if (!_deferred(target) && (checkedKind(target) < 0)) {
      throw coded(E0406, `cannot extract ${H.typeName(target)} from Dynamic${UNCHECKED_KINDS}`);
    }
    return H.opNode(Op.FromDynamic, target, [operand]);
  }
  let present = presentAt(operand, 0);
  let source = H.typeOf(present);
  if (source == target) { return present; }

  match ((H.kindOf(source), H.kindOf(target))) {
    (Var, _) when (H.isIntegerType(target) && _wideLiteral(present)) => {
      H.unify(source, target);
      present
    },
    (Var, _) when (H.isFloatType(target) && _wideLiteral(present)) => {
      H.unify(source, H.TYPE_I64);
      H.opNode(Op.Convert, target, [present])
    },
    (Var, _) when (H.isInteger(source) && H.isIntegerType(target)) => {
      integerConversion(present, target)
    },
    _ when (H.isIntegerType(source) && H.isIntegerType(target)) => {
      H.opNode(Op.Convert, target, [present])
    },
    _ when ((H.isInteger(source) || H.isFloatType(source)) && H.isNumberType(target)) => {
      H.defaultIntegers(source);
      H.opNode(Op.Convert, target, [present])
    },
    _ => { throw coded(E0406, `cannot convert ${H.typeName(ty)} to ${H.typeName(target)}`); },
  }
};

export let kindTest = fn(operand: I32, target: I32): I32 {
  if (H.isPrototype(target)) { return _delegatesTo(operand, target); }
  if (_deferred(target)) { return H.opNode(Op.IsKind, H.TYPE_BOOL, [operand]); }
  let code = checkedKind(target);

  if (code < 0) {
    throw coded(E0406, `is cannot test for ${H.typeName(target)}${UNCHECKED_KINDS}`);
  }
  H.node(Op.IsKind, H.TYPE_BOOL, code, code == H.KIND_ENUM ? target : 0, [operand])
};

export let isAnyFunction = fn(written: AstType): Bool {
  match (written) { Named(name) => name == "__fn__", _ => false }
};

export let functionTest = fn(operand: I32): I32 {
  H.node(Op.IsKind, H.TYPE_BOOL, H.KIND_FUNCTION, 0, [operand])
};

let _is = fn(value: AstExpr, targetType: AstType): I32 {
  let operand = checkOperand(value, 0, -1);

  if (H.typeOf(operand) != H.TYPE_DYNAMIC) {
    enterSyntax(syntaxChild(0));
    throw coded(E0406, `is tests a Dynamic value, not ${H.typeName(H.typeOf(operand))}`);
  }

  if (isAnyFunction(targetType)) {
    functionTest(operand)
  } else {
    kindTest(operand, checkType(targetType))
  }
};

export let checkValueExpr = fn(expr: AstExpr, _expected: I32): I32 {
  match (expr) {
    Binary(op, left, right) => _equality(op, left, right),
    Cast(value, ty) => _cast(value, ty),
    Is(value, ty) => _is(value, ty),
    _ => {
      internalError("expected a cast, kind test or comparison");
      -1
    },
  }
};
