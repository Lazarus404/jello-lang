package frontend.semantics;

import type { Expr as AstExpr, PrototypeField, Type as AstType } from frontend.syntax.Ast;
import { Expr as AstExpr } from frontend.syntax.Ast;
import frontend.hir.Hir as H;
import { Op } from frontend.hir.Hir;
import { expressionOf } from frontend.semantics.Derived;
import { storable, toDynamic } from frontend.semantics.Values;
import { callField, namedKey, readObject, storeField, writeField } from frontend.semantics.Objects;
import { scopedType } from frontend.semantics.ModuleScope;
import { E0302, E0402, E0805, coded } from support.Codes;
import {
  buildInstances, checkGenericPrototype, checkMethodCall, checkOperand, checkPresent, delegates,
  enterSyntax, fieldMismatch, findMethod, hasInitField, hideValue, linkedMember, methodValue,
  noteMethodCall, objectValue, prototypeGlobal, prototypeField, prototypeNamed, prototypeParent,
  prototypeValue, receiverMethodType, rejectAt, requireThis, resolveInstanceReads, sealedPrototype,
  syntaxChild, widened,
} from frontend.semantics.TypeCheck;

let _methodCall = fn(
  holder: I32,
  receiver: I32,
  index: I32,
  origin: I32,
  exact: Bool,
  name: Bytes,
  args: Array<AstExpr>
): I32 {
  let ty = receiverMethodType(index, H.typeOf(receiver));
  let self = H.typeArg(ty, 0);
  let statements = Array.new<I32>(0);
  let held = hideValue(statements, "receiver", receiver);
  let source = holder < 0 ? H.local(held, H.typeOf(receiver)) : holder;
  let callee = readObject(objectValue(source), namedKey(name), ty);
  let first = H.local(held, H.typeOf(receiver));
  if (H.typeOf(receiver) != self) { first = H.opNode(Op.Convert, self, [first]); }
  let call = checkMethodCall(callee, index, first, args);
  let site = H.opOf(call) == Op.Block ? H.lastChild(call) : call;
  noteMethodCall(site, origin, name, exact);
  statements.push(call);
  H.node(Op.Block, H.typeOf(call), 0, 1, statements)
};

export let checkPrototypeCall = fn(receiver: I32, name: Bytes, args: Array<AstExpr>): I32 {
  let found = findMethod(H.typeOf(receiver), name);
  found < 0 ? -1 : _methodCall(-1, receiver, found, H.typeOf(receiver), false, name, args)
};

export let checkSuperCall = fn(name: Bytes, types: Array<AstType>, args: Array<AstExpr>): I32 {
  let outer = enterSyntax(syntaxChild(0));
  let ty = requireThis("`super`");
  let receiver = checkPresent(AstExpr.This, 0);
  let parent = prototypeParent(ty);

  if (parent == -2) {
    throw coded(E0805, H.typeName(ty) + " has no __proto__, so `super` has nothing to call");
  }
  let holder = readObject(prototypeValue(ty), namedKey("__proto__"), H.TYPE_OBJECT);
  enterSyntax(outer);
  if (types.len() != 0) { throw coded(E0402, `super.${name} does not take type arguments`); }
  let found = parent >= 0 ? findMethod(parent, name) : -1;

  if (found >= 0) {
    _methodCall(holder, receiver, found, parent, true, name, args)
  } else {
    callField(holder, receiver, name, args)
  }
};

let _writeMethod = fn(object: I32, ty: I32, name: Bytes, value: I32): I32 {
  if (!sealedPrototype(ty)) { return writeField(object, name, value); }
  let args = [toDynamic(object), toDynamic(namedKey(name)), toDynamic(value)];
  H.callStd("object_seal", [H.TYPE_DYNAMIC, H.TYPE_DYNAMIC, H.TYPE_DYNAMIC], H.TYPE_BOOL, args)
};

let _prototypeObject = fn(ty: I32, name: Bytes, fields: Array<PrototypeField>): I32 {
  let statements = Array.new<I32>(0);
  let object = hideValue(statements, "prototype", H.opNode(Op.ObjectNew, ty, []));
  let names = Array.new<Bytes>(0);

  for (f, { name: field, value } in fields) {
    if (names.indexOf(field) >= 0) {
      enterSyntax(syntaxChild(f));
      throw coded(E0302, `${name} declares ${field} twice`);
    }
    names.push(field);

    let stored = match (value) {
      Function(_, _, body, true) => {
        let (declared, _) = linkedMember(ty, field);

        if (declared >= 0) {
          enterSyntax(syntaxChild(f));
          throw coded(E0302, `${field} is a method of ${name} and a field of its typedef`);
        }
        _writeMethod(H.local(object, ty), ty, field, methodValue(ty, field, f, body))
      },
      _ => {
        let outer = enterSyntax(syntaxChild(f));
        let declared = prototypeField(ty, field);
        enterSyntax(outer);
        let checked = declared < 0 ? -1 : widened(checkOperand(value, f, declared), declared);

        if ((declared >= 0) && !H.unify(H.typeOf(checked), declared)) {
          rejectAt(f, fieldMismatch(ty, field, declared, checked));
        }

        if (declared < 0) {
          storeField(H.local(object, ty), field, value, f)
        } else {
          writeField(H.local(object, ty), field, storable(checked))
        }
      },
    };
    statements.push(expressionOf(stored));
  }
  statements.push(H.local(object, ty));
  let global = prototypeGlobal(ty);
  let body = H.node(Op.Block, ty, 0, 1, statements);
  H.opNode(Op.Declare, 0, [H.node(Op.InitGlobal, ty, global, 0, [body])])
};

export let checkPrototype = fn(name: Bytes, fields: Array<PrototypeField>): I32 {
  let ty = scopedType(name);
  if (delegates(ty, ty)) { throw coded(E0805, `${name} delegates to itself through __proto__`); }

  if (H.isTemplateEnum(ty)) {
    checkGenericPrototype(ty, fn() { _prototypeObject(ty, name, fields) })
  } else {
    _prototypeObject(ty, name, fields)
  }
};

export let instantiatePrototypes = fn(): Bool {
  let resolved = resolveInstanceReads();
  buildInstances(_prototypeObject) || resolved
};

let _checkNew = fn(proto: AstExpr, args: Array<AstExpr>): I32 {
  let template = prototypeNamed(proto);
  let inferred = H.isTemplateEnum(template);
  let vars = Array.new<I32>(0);
  while (inferred && (vars.len() < H.enumParamCount(template))) { vars.push(H.newVar(false)); }
  let named = inferred ? H.appliedType(template, vars) : template;
  let checked = named >= 0 ? prototypeValue(named) : checkPresent(proto, 0);
  let ty = H.typeOf(checked);

  if (!H.isObject(ty)) {
    enterSyntax(syntaxChild(0));
    throw coded(E0805, "`new` makes an Object that delegates to an Object, not " + H.typeName(ty));
  }
  let made = H.isPrototype(ty) ? ty : H.TYPE_OBJECT;
  let statements = Array.new<I32>(0);
  let link = hideValue(statements, "prototype", checked);
  let object = hideValue(statements, "object", H.opNode(Op.ObjectNew, made, []));
  statements.push(expressionOf(writeField(H.local(object, made), "__proto__", H.local(link, ty))));
  let init = H.isPrototype(ty) ? findMethod(ty, "init") : -1;

  if (init >= 0) {
    let call = _methodCall(-1, H.local(object, made), init, ty, named >= 0, "init", args);
    statements.push(expressionOf(call));
  } else if (args.len() != 0) {
    if (hasInitField(ty)) {
      throw coded(E0805, "the init of " + H.typeName(ty)
        + " is a field; `new` passes its arguments to an init method, `init(params) { ... }`");
    }
    throw coded(E0805, H.isPrototype(ty)
      ? H.typeName(ty) + " has no init method, so `new` passes it no arguments"
      : "`new` passes arguments only to a prototype's init method");
  }
  statements.push(H.local(object, made));
  H.node(Op.Block, made, 0, 1, statements)
};

export let checkPrototypeExpr = fn(expr: AstExpr): I32 {
  match (expr) {
    New(proto, args) => _checkNew(proto, args),
    _ => {
      requireThis("`super`");
      throw coded(E0805,
        "`super` calls a method of the Object the prototype delegates to, as `super.m(...)`");
    },
  }
};
