package frontend.semantics;

/** @file
 * Checks prototypes into HIR; `prototype P { fields }`, `new P(args)` and `super.m(args)`. A
 * prototype is a constant Object, the global P, and its values are Objects of type P that delegate
 * to it through `__proto__`. A field is an Object's field, read as a Dynamic; a method,
 * `m(params) { ... }`, is a function whose first parameter is its `this`, of type P, so a call
 * `o.m(args)` of a value of type P is checked against it, and reads the method from `o`, which may
 * hold its own; `o.m` alone reads it as that function. A prototype whose `__proto__` names another
 * prototype Q delegates to it; its values are of type Q too, and find Q's methods. `new P(args)`
 * makes an Object that delegates to P and calls its `init` method with the arguments. A generic
 * prototype, `prototype P<T> { fields }`, is checked once with its type parameters, and each
 * instance the program uses, `P<A>`, is a prototype of its own, whose methods are checked with
 * its type arguments; `new P(args)` infers them as a generic call does.
 * `frontend.semantics.TypeCheck` declares each module's prototypes, and
 * `frontend.semantics.Aggregates` passes `new` and `super` here. */

import type { Expr as AstExpr, PrototypeField, Type as AstType } from frontend.syntax.Ast;
import { Expr as AstExpr } from frontend.syntax.Ast;
import frontend.hir.Hir as H;
import { Op } from frontend.hir.Hir;
import { expressionOf } from frontend.semantics.Derived;
import { storable, toDynamic } from frontend.semantics.Values;
import { callField, namedKey, readObject, storeField, writeField } from frontend.semantics.Objects;
import { scopedType } from frontend.semantics.ModuleScope;
import { E0302, E0402, E0805, coded } from support.Codes;
import { internalError } from support.Internal;
import {
  buildInstances, checkGenericMethod, checkGenericMethodCall, checkGenericPrototype,
  checkMethodBounds, checkMethodCall, checkOperand, checkPresent, checkTypeArgs, declaredArgs,
  delegates, enterSyntax, fieldMismatch, findMethod, hasGenericMethod, hasInitField, hideValue,
  linkedMember, methodValue, noteMethodCall, objectValue, prototypeField, prototypeGlobal,
  prototypeNamed, prototypeParent, prototypeValue, receiverMethodType, rejectAt, requireThis,
  resolveInstanceReads, sealedPrototype, syntaxChild, widened,
} from frontend.semantics.TypeCheck;

/** Returns a call of the method value `callee` on `first`, its `this`, with the checked `values`,
 * widened to the method's parameters. */
let _callWith = fn(callee: I32, first: I32, values: Array<I32>): I32 {
  let function = H.typeOf(callee);
  let declared = declaredArgs(function);
  let children = [callee, first];
  for (i, value in values) { children.push(widened(value, declared[i + 1])); }
  H.node(Op.CallIndirect, H.innerOf(function), 0, 0, children)
};

/** Checks a call of method `index`, named `name`, which `holder` finds, with `receiver` as its
 * `this`; `holder` is the receiver itself for `o.m(args)`, or the prototype's `__proto__` for
 * `super.m(args)`. The method is read from `holder` as its own type, which the VM checks, so an
 * Object that holds a function of that name in its place calls that.
 * @param holder  the checked Object the method is read from, or -1 for `receiver`
 * @param receiver  the checked value of a prototype type
 * @param origin  the prototype type the method is found from
 * @param exact  whether `receiver` is of type `origin` exactly (`noteMethodCall`)
 * @param args  the arguments, syntax children from 1 on, when `values` is null
 * @param values  the arguments checked already, which fit the method's parameters, or null
 * @return the block that binds the values and calls the method */
let _methodCall = fn(
  holder: I32,
  receiver: I32,
  index: I32,
  origin: I32,
  exact: Bool,
  name: Bytes,
  args: Array<AstExpr>,
  values: ?Array<I32>
): I32 {
  let ty = receiverMethodType(index, H.typeOf(receiver));
  let self = H.typeArg(ty, 0);
  let statements = Array.new<I32>(0);
  let held = hideValue(statements, "receiver", receiver);
  let source = holder < 0 ? H.local(held, H.typeOf(receiver)) : holder;
  let callee = readObject(objectValue(source), namedKey(name), ty);
  let first = H.local(held, H.typeOf(receiver));
  if (H.typeOf(receiver) != self) { first = H.opNode(Op.Convert, self, [first]); }
  let call = values == null
    ? checkMethodCall(callee, index, first, args)
    : _callWith(callee, first, values);
  // Spread arguments are bound first, in a block that ends with the call.
  let site = H.opOf(call) == Op.Block ? H.lastChild(call) : call;
  noteMethodCall(site, origin, name, exact);
  statements.push(call);
  H.node(Op.Block, H.typeOf(call), 0, 1, statements)
};

/** Returns a call of the method `name` that `receiver`, a checked value of a prototype type, finds,
 * with the checked `values` as its arguments; they fit its parameters, as the caller has checked.
 */
export let methodCallWith = fn(receiver: I32, name: Bytes, values: Array<I32>): I32 {
  let ty = H.typeOf(receiver);
  let found = findMethod(ty, name);
  if (found < 0) { internalError(`${H.typeName(ty)} has no method ${name}`); }
  checkMethodBounds(found, ty);
  _methodCall(-1, receiver, found, ty, false, name, [], values)
};

/** Checks `o.name(args)` for `receiver`, a checked value of a prototype type, when it finds a
 * method of that name (`findMethod`).
 * @return the checked call, or -1 when it finds none */
export let checkPrototypeCall = fn(receiver: I32, name: Bytes, args: Array<AstExpr>): I32 {
  let found = findMethod(H.typeOf(receiver), name);
  if (found < 0) { return -1; }
  checkMethodBounds(found, H.typeOf(receiver));
  _methodCall(-1, receiver, found, H.typeOf(receiver), false, name, args, null)
};

// Installs the custom `Std.string` route without making Derived depend on prototype internals.
export let checkPrototypeString = fn(value: I32): I32 {
  let found = findMethod(H.typeOf(value), "toString");
  if (found < 0) { return -1; }
  let ty = receiverMethodType(found, H.typeOf(value));
  if ((H.typeArgCount(ty) != 1) || (H.innerOf(ty) != H.TYPE_BYTES)) { return -1; }
  checkMethodBounds(found, H.typeOf(value));
  _methodCall(-1, value, found, H.typeOf(value), false, "toString", [], null)
};

/** Checks `super.name(args)`, the call's syntax current with `super` the first child of its
 * callee's; the method `name` of the Object that the prototype of the method being checked
 * delegates to, with its `this`. A prototype that `__proto__` names gives the method's type, and
 * any other Object's function is called as `callObjectField` calls one.
 * @param expected  the type the context requires, which a generic method's call infers from, or -1
 * @throws a located error outside a prototype's method, or for a prototype without `__proto__` */
export let checkSuperCall = fn(
  name: Bytes, types: Array<AstType>, args: Array<AstExpr>, expected: I32
): I32 {
  let outer = enterSyntax(syntaxChild(0));
  let ty = requireThis("`super`");
  let receiver = checkPresent(AstExpr.This, 0);
  let parent = prototypeParent(ty);

  if (parent == -2) {
    throw coded(E0805, H.typeName(ty) + " has no __proto__, so `super` has nothing to call");
  }
  let holder = readObject(prototypeValue(ty), namedKey("__proto__"), H.TYPE_OBJECT);
  enterSyntax(outer);
  // A generic method is called directly, as the prototype that declares it.
  let generic =
    parent >= 0 ? checkGenericMethodCall(receiver, parent, name, types, args, expected) : -1;
  if (generic >= 0) { return generic; }
  if (types.len() != 0) { throw coded(E0402, `super.${name} does not take type arguments`); }
  let found = parent >= 0 ? findMethod(parent, name) : -1;

  if (found >= 0) {
    _methodCall(holder, receiver, found, parent, true, name, args, null)
  } else {
    callField(holder, receiver, name, args)
  }
};

/** Returns the write of the method `name`, `value`, on `object`, the prototype of type `ty`; a
 * sealed one's (`sealedPrototype`) seals it, so that calls of it can be direct. */
let _writeMethod = fn(object: I32, ty: I32, name: Bytes, value: I32): I32 {
  if (!sealedPrototype(ty)) { return writeField(object, name, value); }
  let args = [toDynamic(object), toDynamic(namedKey(name)), toDynamic(value)];
  H.callStd("object_seal", [H.TYPE_DYNAMIC, H.TYPE_DYNAMIC, H.TYPE_DYNAMIC], H.TYPE_BOOL, args)
};

/** Rejects the method `field` of the prototype type `ty`, named `name`, declared as its field `f`,
 * when its linked typedef declares a field of that name too, or it would override a method it
 * delegates to, or be overridden, where either is generic. A generic method is called as the
 * receiver's type finds it, never read from the Object, so it can neither override nor be
 * overridden.
 * @param generic  whether the method is generic
 * @throws a located error if it does */
let _methodField = fn(ty: I32, name: Bytes, field: Bytes, f: I32, generic: Bool) {
  let (declared, _) = linkedMember(ty, field);
  let parent = prototypeParent(ty);
  let inherited = (parent >= 0) && hasGenericMethod(parent, field);
  let why = declared >= 0 ? `${field} is a method of ${name} and a field of its typedef`
    : generic && (inherited || ((parent >= 0) && (findMethod(parent, field) >= 0)))
      ? `${name}.${field} is generic, so it cannot override the ${field} it delegates to`
    : inherited ? `${name}.${field} cannot override ${field}, a generic method it delegates to`
    : "";

  if (why != "") {
    enterSyntax(syntaxChild(f));
    throw coded(E0302, why);
  }
  null
};

/** Returns the `Declare` of the global of the prototype type `ty`, `prototype name { fields }`,
 * at its syntax; each field's value is its child. Its fields and methods are set, in order, on a
 * new Object, which initialises the global. A generic method is no field of it; it is checked
 * here, and its calls are direct.
 * @throws a located error if a field is declared twice */
let _prototypeObject = fn(ty: I32, name: Bytes, fields: Array<PrototypeField>): I32 {
  let statements = Array.new<I32>(0);
  let object = hideValue(statements, "prototype", H.opNode(Op.ObjectNew, ty, []));
  let names = Array.new<Bytes>(0);

  for (f, { name: field, typeParams, value } in fields) {
    if (names.indexOf(field) >= 0) {
      enterSyntax(syntaxChild(f));
      throw coded(E0302, `${name} declares ${field} twice`);
    }
    names.push(field);

    if (typeParams.len() != 0) {
      _methodField(ty, name, field, f, true);
      checkGenericMethod(ty, field);
      continue;
    }

    let stored = match (value) {
      Function(_, _, body, true) => {
        _methodField(ty, name, field, f, false);
        _writeMethod(H.local(object, ty), ty, field, methodValue(ty, field, f, body))
      },
      _ => {
        // A linked typedef declares the prototype's fields, and their types.
        let outer = enterSyntax(syntaxChild(f));
        let declared = prototypeField(ty, field);
        enterSyntax(outer);
        let checked = declared < 0 ? -1 : widened(checkOperand(value, f, declared), declared);

        if ((declared >= 0) && !H.unify(H.typeOf(checked), declared)) {
          rejectAt(f, fieldMismatch(ty, field, declared, checked));
        }

        if (declared < 0) {
          storeField(H.local(object, ty), field, value, f)
        } else {
          writeField(H.local(object, ty), field, storable(checked))
        }
      },
    };
    statements.push(expressionOf(stored));
  }
  statements.push(H.local(object, ty));
  let global = prototypeGlobal(ty);
  let body = H.node(Op.Block, ty, 0, 1, statements);
  H.opNode(Op.Declare, 0, [H.node(Op.InitGlobal, ty, global, 0, [body])])
};

/** Checks `prototype name { fields }` of the current module, at its syntax. A generic one is
 * checked as a template's body, and each instance the program uses has a global of its own
 * (`instantiatePrototypes`).
 * @return the `Declare` of the global, or the node where a generic one's instances' are
 * @throws a located error if a field is declared twice, or the prototype delegates to itself */
export let checkPrototype = fn(name: Bytes, fields: Array<PrototypeField>): I32 {
  let ty = scopedType(name);
  if (delegates(ty, ty)) { throw coded(E0805, `${name} delegates to itself through __proto__`); }

  if (H.isTemplateEnum(ty)) {
    checkGenericPrototype(ty, fn() { _prototypeObject(ty, name, fields) })
  } else {
    _prototypeObject(ty, name, fields)
  }
};

/** Checks the instances of generic prototypes that the program uses, after every module is
 * checked, each once; the global of each is initialised where its prototype is declared
 * (`withInstances`). Their methods may use more instances, and generic functions, so the caller
 * repeats it, with `instantiateTemplates`, until there are none.
 * @return whether there were any
 * @throws a located error if an instance's type arguments cannot be inferred */
export let instantiatePrototypes = fn(): Bool {
  let resolved = resolveInstanceReads();
  buildInstances(_prototypeObject) || resolved
};

/** Returns `new P(args)` for the prototype `checked`, an instance of `template` or -1; `exact` when
 * it is named as a type, so that the Object is known to delegate to it.
 * @throws a located error if the type arguments miss their bounds, `checked` is no Object, or the
 *   arguments do not suit its init */
let _newObject = fn(template: I32, exact: Bool, checked: I32, args: Array<AstExpr>): I32 {
  let ty = H.typeOf(checked);

  if (H.isTemplateEnum(template)) {
    checkTypeArgs(H.enumParams(template), H.typeName(template), H.templateArgs(ty));
  }

  if (!H.isObject(ty)) {
    enterSyntax(syntaxChild(0));
    throw coded(E0805, "`new` makes an Object that delegates to an Object, not " + H.typeName(ty));
  }
  let made = H.isPrototype(ty) ? ty : H.TYPE_OBJECT;
  let statements = Array.new<I32>(0);
  let link = hideValue(statements, "prototype", checked);
  let object = hideValue(statements, "object", H.opNode(Op.ObjectNew, made, []));
  statements.push(expressionOf(writeField(H.local(object, made), "__proto__", H.local(link, ty))));
  let init = H.isPrototype(ty) ? findMethod(ty, "init") : -1;

  if (init >= 0) {
    let call = _methodCall(-1, H.local(object, made), init, ty, exact, "init", args, null);
    statements.push(expressionOf(call));
  } else if (args.len() != 0) {
    if (hasInitField(ty)) {
      throw coded(E0805, "the init of " + H.typeName(ty)
        + " is a field; `new` passes its arguments to an init method, `init(params) { ... }`");
    }
    throw coded(E0805, H.isPrototype(ty)
      ? H.typeName(ty) + " has no init method, so `new` passes it no arguments"
      : "`new` passes arguments only to a prototype's init method");
  }
  statements.push(H.local(object, made));
  H.node(Op.Block, made, 0, 1, statements)
};

/** Returns a new Object of the prototype type `ty`, an instance of a generic prototype, made as
 * `new P<T>()` makes one.
 * @throws a located error if its type arguments miss their bounds */
export let newInstance = fn(ty: I32): I32 {
  _newObject(H.templateOf(ty), true, prototypeValue(ty), [])
};

/** Checks `new proto(args)`, the current syntax being its own, with `proto` its first child; an
 * Object that delegates to `proto`, after the `init` method that `proto`'s prototype type finds
 * runs with the arguments. Its type is that prototype type, or Object for an Object.
 * @throws a located error if `proto` is no Object, or there are arguments and no `init` */
let _checkNew = fn(proto: AstExpr, args: Array<AstExpr>): I32 {
  /* A prototype named as a type is made from its type, even where its value is not in scope, as
   * when its module is imported for its types; a generic one named without type arguments has them
   * inferred, as a generic call's are. */
  let template = prototypeNamed(proto);
  let inferred = H.isTemplateEnum(template);
  let vars = Array.new<I32>(0);
  while (inferred && (vars.len() < H.enumParamCount(template))) { vars.push(H.newVar(false)); }
  let named = inferred ? H.appliedType(template, vars) : template;
  let checked = named >= 0 ? prototypeValue(named) : checkPresent(proto, 0);
  _newObject(template, named >= 0, checked, args)
};

// Checks `new P(args)`, or rejects a bare `super`, with the expression's syntax current.
export let checkPrototypeExpr = fn(expr: AstExpr): I32 {
  match (expr) {
    New(proto, args) => _checkNew(proto, args),
    _ => {
      requireThis("`super`");
      throw coded(E0805,
        "`super` calls a method of the Object the prototype delegates to, as `super.m(...)`");
    },
  }
};
