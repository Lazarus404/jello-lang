package frontend;

import type { Token, IntegerSize, FloatSize } from frontend.Lexer;
import { concatAll } from frontend.Text;

let _integerSize = fn(size: IntegerSize) {
  match (size) {
    Infer => "Infer",
    I8 => "I8",
    I16 => "I16",
    I32 => "I32",
    I64 => "I64",
    U8 => "U8",
    U16 => "U16",
    U32 => "U32",
    U64 => "U64",
  }
};

let _floatSize = fn(size: FloatSize) {
  match (size) {
    Infer => "Infer",
    F16 => "F16",
    F32 => "F32",
    F64 => "F64"
  }
};

export let bytesLiteral: (Bytes) -> Bytes = fn(value) {
  let out = Array.new<Bytes>(0);
  out.push("\"");
  let i = 0;

  while (i < value.len()) {
    let c = Bytes.get_u8(value, i);
    out.push(match (c) {
      "\n".code => "\\n",
      "\r".code => "\\r",
      "\t".code => "\\t",
      "\"".code => "\\\"",
      "\\".code => "\\\\",
      _ => ((c >= 32) && (c <= 126))
        ? Bytes.slice(value, i, 1)
        : "\\x" + Bytes.slice("0123456789abcdef", c / 16, 1) + Bytes.slice("0123456789abcdef", c % 16, 1),
    });
    i++;
  }
  out.push("\"");
  concatAll(out)
};

export let tokenName: (Token) -> Bytes = fn(token) {
  match (token) {
    Ident(name) => "Ident(" + bytesLiteral(name) + ")",
    IntegerConstant(digits, size) => "IntegerConstant(" + digits + ", " + _integerSize(size) + ")",
    FloatConstant(literal, size) => "FloatConstant(" + literal + ", " + _floatSize(size) + ")",
    BytesLiteral(value) => "BytesLiteral(" + bytesLiteral(value) + ")",
    RegExpLiteral(pattern, flags) => "RegExpLiteral(" + bytesLiteral(pattern) + ", " + bytesLiteral(flags) + ")",
    As => "As", Await => "Await", Bits => "Bits", Break => "Break", Catch => "Catch", Const => "Const",
    Continue => "Continue", Do => "Do",
    Else => "Else", EnumDecl => "EnumDecl", Export => "Export", False => "False", Fn => "Fn",
    For => "For", From => "From", If => "If", Import => "Import", Is => "Is", Let => "Let",
    ListLiteral => "ListLiteral", Load => "Load", Macro => "Macro", Match => "Match", New => "New", Null => "Null",
    Package => "Package", Prototype => "Prototype", Return => "Return",
    Super => "Super", This => "This", Throw => "Throw",
    True => "True", Try => "Try", Type => "Type", Typedef => "Typedef", When => "When", While => "While", With => "With",
    LParen => "LParen",
    RParen => "RParen",
    LBrace => "LBrace",
    RBrace => "RBrace",
    LBracket => "LBracket",
    RBracket => "RBracket",
    Semicolon => "Semicolon",
    Colon => "Colon",
    Comma => "Comma",
    Question => "Question",
    Dot => "Dot",
    DotDotDot => "DotDotDot",
    Equal => "Equal",
    EqualEqual => "EqualEqual",
    FatArrow => "FatArrow",
    Not => "Not",
    NotEqual => "NotEqual",
    Less => "Less",
    LessEqual => "LessEqual",
    LessMinus => "LessMinus",
    Greater => "Greater",
    GreaterEqual => "GreaterEqual",
    Plus => "Plus",
    PlusPlus => "PlusPlus",
    PlusEqual => "PlusEqual",
    Minus => "Minus",
    MinusMinus => "MinusMinus",
    MinusEqual => "MinusEqual",
    Arrow => "Arrow",
    Star => "Star",
    StarEqual => "StarEqual",
    Slash => "Slash",
    SlashEqual => "SlashEqual",
    Percent => "Percent",
    LessLess => "LessLess",
    GreaterGreater => "GreaterGreater",
    Ampersand => "Ampersand",
    And => "And",
    Pipe => "Pipe",
    PipePipe => "PipePipe",
    PipeGreater => "PipeGreater",
    Caret => "Caret",
    Eof => "Eof",
  }
};

export let tokenText: (Token) -> Bytes = fn(token) {
  match (token) {
    Ident(name) => name,
    IntegerConstant(digits, _) => digits,
    FloatConstant(literal, _) => literal,
    BytesLiteral(value) => bytesLiteral(value),
    RegExpLiteral(pattern, flags) => "~r/" + pattern + "/" + flags,
    As => "as", Await => "await", Bits => "bits", Break => "break", Catch => "catch", Const => "const",
    Continue => "continue", Do => "do", Else => "else", EnumDecl => "enum", Export => "export",
    False => "false", Fn => "fn", For => "for", From => "from", If => "if", Import => "import",
    Is => "is", Let => "let", ListLiteral => "list", Load => "load", Macro => "macro", Match => "match",
    New => "new", Null => "null", Package => "package", Prototype => "prototype", Return => "return",
    Super => "super", This => "this", Throw => "throw", True => "true", Try => "try", Type => "type",
    Typedef => "typedef", When => "when", While => "while", With => "with",
    LParen => "(", RParen => ")", LBrace => "{", RBrace => "}", LBracket => "[", RBracket => "]",
    Semicolon => ";", Colon => ":", Comma => ",", Question => "?", Dot => ".", DotDotDot => "...",
    Equal => "=", EqualEqual => "==", FatArrow => "=>", Not => "!", NotEqual => "!=",
    Less => "<", LessEqual => "<=", LessMinus => "<-", Greater => ">", GreaterEqual => ">=",
    Plus => "+", PlusPlus => "++", PlusEqual => "+=", Minus => "-", MinusMinus => "--", MinusEqual => "-=",
    Arrow => "->", Star => "*", StarEqual => "*=", Slash => "/", SlashEqual => "/=", Percent => "%",
    LessLess => "<<", GreaterGreater => ">>", Ampersand => "&", And => "&&", Pipe => "|",
    PipePipe => "||", PipeGreater => "|>", Caret => "^", Eof => "",
  }
};

export let isKeyword: (Token) -> Bool = fn(token) {
  match (token) {
    As, Await, Bits, Break, Catch, Const, Continue, Do, Else, EnumDecl, Export, False, Fn, For,
    From, If, Import, Is, Let, ListLiteral, Load, Macro, Match, New, Null, Package, Prototype,
    Return, Super, This, Throw, True, Try, Type, Typedef, When, While, With => true,
    _ => false,
  }
};

export let printTokens: (Array<Token>) -> Bytes = fn(tokens) {
  let lines = Array.new<Bytes>(0);
  let i = 0;

  while (i < tokens.len()) {
    lines.push(tokenName(tokens[i]) + "\n");
    i++;
  }
  concatAll(lines)
};
