package frontend;

import type { Hir } from frontend.Hir;
import {
  auxOf, bytesOf, childCount, childOf, globalNameOf, innerOf, lastChild, opOf, rootNode, typeName, typeOf, useHir, valueOf, variantName,
} from frontend.Hir;
import { bytesLiteral } from frontend.Tokens;

let _typed = fn(id: I32): Bytes { ": " + typeName(typeOf(id)) + "\n" };
let _id = fn(id: I32): Bytes { Std.string(valueOf(id)) };

let _expr: (I32, Bytes) -> Bytes = fn(_id, _indent) { "" };
let _statements: (I32, Bytes) -> Bytes = fn(_id, _indent) { "" };

let _children = fn(parent: I32, start: I32, end: I32, indent: Bytes): Bytes {
  let output = "";
  let i = start;

  while (i < end) {
    output += _expr(childOf(parent, i), indent + "  ");
    i++;
  }
  output
};

let _binding = fn(id: I32, indent: Bytes): Bytes {
  let header = match (opOf(id)) {
    Let => "let %" + _id(id) + " " + bytesOf(auxOf(id)),
    InitGlobal => "global g" + _id(id) + " " + globalNameOf(valueOf(id)),
    _ => "const %" + _id(id) + " " + bytesOf(auxOf(id)),
  };
  indent + header + _typed(id) + _expr(childOf(id, 0), indent + "  ")
};

let _operation = fn(name: Bytes, id: I32, indent: Bytes): Bytes { indent + name + _typed(id) + _children(id, 0, childCount(id), indent) };

let _section = fn(name: Bytes, id: I32, index: I32, indent: Bytes): Bytes {
  indent + "  " + name + "\n" + _expr(childOf(id, index), indent + "    ")
};

_expr = fn(id, indent) {
  match (opOf(id)) {
    Bool => indent + "bool " + (valueOf(id) == 1 ? "true" : "false") + _typed(id),
    I32 => indent + "i32 " + _id(id) + _typed(id),
    Bytes => indent + "bytes " + bytesLiteral(bytesOf(valueOf(id))) + _typed(id),
    Null => indent + "null" + _typed(id),
    Local => indent + "local %" + _id(id) + _typed(id),
    Global => indent + "global g" + _id(id) + _typed(id),
    SetGlobal => _operation("global.set g" + _id(id), id, indent),
    FunctionRef => indent + "function @" + _id(id) + _typed(id),
    Assign => _operation("assign %" + _id(id), id, indent),
    TupleField => _operation("tuple.get " + _id(id), id, indent),
    EnumNew => _operation("enum.new " + variantName(typeOf(id), valueOf(id)), id, indent),
    EnumTag => _operation("enum.tag", id, indent),
    EnumField => _operation("enum.field " + variantName(typeOf(childOf(id, 0)), auxOf(id)) + "." + _id(id), id, indent),
    Call => _operation("call @" + _id(id), id, indent),
    CallIndirect => _operation("call.indirect", id, indent),
    Add => _operation("add.wrap", id, indent),
    Sub => _operation("sub.wrap", id, indent),
    Mul => _operation("mul.wrap", id, indent),
    Neg => _operation("neg.wrap", id, indent),
    Not => _operation("not.bool", id, indent),
    And => _operation("and", id, indent),
    Or => _operation("or", id, indent),
    Eq => _operation("eq.i32", id, indent),
    Lt => _operation("lt.s.i32", id, indent),
    Gt => _operation("gt.s.i32", id, indent),
    Sext => _operation("sext.i32.i64", id, indent),
    Trunc => _operation("trunc.i64.i32", id, indent),
    Present => _operation("present", id, indent),
    IsNull => _operation("is_null", id, indent),
    IsPresent => _operation("is_present", id, indent),
    ArrayNew => _operation("array.new", id, indent),
    ArrayLen => _operation("array.len", id, indent),
    ArrayGet => _operation("array.get", id, indent),
    ArraySet => _operation("array.set", id, indent),
    BytesGet => _operation("bytes.get_u8", id, indent),
    Tuple => _operation("tuple", id, indent),
    Block => indent + "block" + _typed(id) + _statements(id, indent + "  ") + _expr(lastChild(id), indent + "  "),
    If => indent + "if" + _typed(id) + _section("condition", id, 0, indent) + _section("then", id, 1, indent) + _section("else", id, 2, indent),
    _ => {
      throw "invalid HIR expression op";
      ""
    },
  }
};

let _statement: (I32, Bytes) -> Bytes = fn(_id, _indent) { "" };
_statement = fn(id, indent) {
  match (opOf(id)) {
    Declare => _binding(childOf(id, 0), indent),
    Expression => indent + "expression\n" + _expr(childOf(id, 0), indent + "  "),
    Block => indent + "block\n" + _statements(id, indent + "  "),
    Return => indent + "return\n" + _expr(childOf(id, 0), indent + "  "),
    Throw => indent + "throw\n" + _expr(childOf(id, 0), indent + "  "),
    Break => indent + "break\n",
    Continue => indent + "continue\n",
    While => indent + "while\n" + _section("condition", id, 0, indent) + indent + "  body\n" + _statements(childOf(id, 1), indent + "    "),
    IfStatement => {
      let output = indent + "if\n" + _section("condition", id, 0, indent) + indent + "  then\n" + _statements(childOf(id, 1), indent + "    ");
      if (childCount(id) < 3) { return output; }
      let otherwise = childOf(id, 2);
      output + indent + "  else\n" + match (opOf(otherwise)) { IfStatement => _statement(otherwise, indent + "    "), _ => _statements(otherwise, indent + "    ") }
    },
    _ => {
      throw "invalid HIR statement op";
      ""
    },
  }
};

_statements = fn(id, indent) {
  let output = "";
  let i = 0;

  while (i < childCount(id) - auxOf(id)) {
    output += _statement(childOf(id, i), indent);
    i++;
  }
  output
};

let _function = fn(id: I32, functionId: I32): Bytes {
  let output = "  fn @" + Std.string(functionId) + " " + bytesOf(valueOf(id)) + "(";
  let i = 0;

  while (i < childCount(id) - 1) {
    let param = childOf(id, i);
    if (i > 0) { output += ", "; }
    output += "%" + _id(param) + " " + bytesOf(auxOf(param)) + ": " + typeName(typeOf(param));
    i++;
  }
  let body = lastChild(id);
  output += ") -> " + typeName(innerOf(typeOf(id))) + "\n" + _statements(body, "    ");
  if (auxOf(body) == 1) { output += "    tail\n" + _expr(lastChild(body), "      "); }
  output
};

export let printHir: (Hir) -> Bytes = fn(program) {
  useHir(program);
  let root = rootNode();
  let output = "program\n";
  let i = 0;

  while (i < childCount(root) - 1) {
    output += _function(childOf(root, i), i + 1);
    i++;
  }
  let body = lastChild(root);
  output + _statements(body, "  ") + _expr(lastChild(body), "  ")
};
