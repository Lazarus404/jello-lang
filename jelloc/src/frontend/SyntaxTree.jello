package frontend;

import type { Block, Expr, ListLiteral, MatchArm, Parameter, Pattern, Program, Stmt } from frontend.Ast;
import { exprTag, patternTag, stmtTag } from frontend.Ast;
import type { Syntax, SyntaxKind, SyntaxMark } from frontend.Source;
import { Syntax, SyntaxKind } from frontend.Source;

let _marks = Array.new<SyntaxMark>(0);
let _next = 0;
let _path = "";

let _sameKind = fn(left: SyntaxKind, right: SyntaxKind): Bool {
  match ((left, right)) {
    (Expression, Expression), (Statement, Statement), (Parameter, Parameter), (Pattern, Pattern) => true,
    _ => false,
  }
};

let _contains = fn(start: I32, end: I32, inner: Array<Syntax>): Bool {
  let i = 0;

  while (i < inner.len()) {
    match (inner[i]) { Node(_, childStart, childEnd, _, _) => { if ((childStart < start) || (childEnd > end)) { return false; } } };
    i++;
  }
  true
};

let _takeWith = fn(kind: SyntaxKind, tag: I32, children: Array<Syntax>, patterns: Array<Syntax>): Syntax {
  if (_next >= _marks.len()) { throw "syntax marks end before the AST"; }

  match (_marks[_next]) { Mark(markKind, markTag, start, end) => {
    if (!_sameKind(markKind, kind) || (markTag != tag)) {
      throw "syntax mark " + Std.string(_next) + " does not match its AST node";
    }

    if (!_contains(start, end, children) || !_contains(start, end, patterns)) {
      throw "syntax mark " + Std.string(_next) + " does not contain its children";
    }
    _next++;
    Syntax.Node(_path, start, end, children, patterns)
  } }
};
let _take = fn(kind: SyntaxKind, tag: I32, children: Array<Syntax>): Syntax { _takeWith(kind, tag, children, []) };

let _expr: (Expr) -> Syntax = fn(_value) { Syntax.Node("", 0, 0, [], []) };
let _stmt: (Stmt) -> Syntax = fn(_value) { Syntax.Node("", 0, 0, [], []) };

let _pattern: (Pattern) -> Syntax = fn(_value) { Syntax.Node("", 0, 0, [], []) };

let _addPattern = fn(out: Array<Syntax>, value: Pattern) {
  out.push(_pattern(value));
  null
};

let _patternList = fn(values: Array<Pattern>, out: Array<Syntax>) {
  let i = 0;

  while (i < values.len()) {
    _addPattern(out, values[i]);
    i++;
  }
  null
};
_pattern = fn(value) {
  let out = Array.new<Syntax>(0);

  match (value) {
    Wildcard, BindPattern(_), Pin(_), Bool(_), Integer(_, _), Bytes(_), Atom(_), RegExp(_, _, _), IsType(_, _) => null,
    Object(fields) => {
      let i = 0;

      while (i < fields.len()) {
        _addPattern(out, fields[i].1);
        i++;
      } null
    },
    Tuple(items), Array(items), ArrayRest(items, _) => _patternList(items, out),
    ArrayCons(head, _) => _addPattern(out, head),
    Enum(_, args) => _patternList(args, out),
    Bits(segments) => {
      let i = 0;

      while (i < segments.len()) {
        match (segments[i]) { Segment(_, _, _, _, segment) => _addPattern(out, segment) };
        i++;
      }
      null
    },
  };
  _take(SyntaxKind.Pattern, patternTag(value), out)
};

let _add = fn(out: Array<Syntax>, value: Expr) {
  out.push(_expr(value));
  null
};

let _addStmt = fn(out: Array<Syntax>, value: Stmt) {
  out.push(_stmt(value));
  null
};

let _exprs = fn(values: Array<Expr>, out: Array<Syntax>) {
  let i = 0;

  while (i < values.len()) {
    _add(out, values[i]);
    i++;
  }
  null
};

let _optional = fn(value: ?Expr, out: Array<Syntax>) { if (value != null) { _add(out, value); } null };

let _stmts = fn(values: Array<Stmt>, out: Array<Syntax>) {
  let i = 0;

  while (i < values.len()) {
    _addStmt(out, values[i]);
    i++;
  }
  null
};

let _block = fn(block: Block, out: Array<Syntax>) {
  match (block) {
    Block(statements, tail) => {
      _stmts(statements, out);
      _optional(tail, out)
    }
  }
};

let _arms = fn(arms: Array<MatchArm>, out: Array<Syntax>, patterns: Array<Syntax>) {
  let i = 0;

  while (i < arms.len()) {
    match (arms[i]) {
      Arm(pattern, guard, body) => {
        _addPattern(patterns, pattern);
        _optional(guard, out);
        _block(body, out)
      },
      Alternative(pattern, guard) => {
        _addPattern(patterns, pattern);
        _optional(guard, out)
      },
    };
    i++;
  }
  null
};

let _parameters = fn(params: Array<Parameter>, out: Array<Syntax>) {
  let i = 0;

  while (i < params.len()) {
    let defaults = Array.new<Syntax>(0);

    match (params[i]) { Parameter(_, _, kind) => match (kind) {
      Default(value) => _add(defaults, value),
      Optional(value) => _optional(value, defaults),
      _ => null,
    } };
    out.push(_take(SyntaxKind.Parameter, 0, defaults));
    i++;
  }
  null
};

let _list = fn(value: ListLiteral, out: Array<Syntax>, patterns: Array<Syntax>) {
  match (value) {
    Empty => null,
    Elements(items) => _exprs(items, out),
    Cons(prefix, tail) => {
      _exprs(prefix, out);
      _add(out, tail);
      null
    },
    Spread(prefix, rest, suffix) => {
      _exprs(prefix, out);
      _add(out, rest);
      _exprs(suffix, out)
    },
    Comprehension(generators, body) => {
      let i = 0;

      while (i < generators.len()) {
        match (generators[i]) {
          Generator(pattern, source, guard) => {
            _addPattern(patterns, pattern);
            _add(out, source);
            _optional(guard, out)
          }
        };
        i++;
      }
      _add(out, body);
      null
    },
  }
};

_expr = fn(value) {
  let out = Array.new<Syntax>(0);
  let patterns = Array.new<Syntax>(0);

  match (value) {
    Bytes(_), RegExp(_, _), Atom(_), Bool(_), Integer(_, _), Float(_, _), Null, This, Super, Variable(_), Topic => null,
    Array(items), Tuple(items) => _exprs(items, out),
    List(list) => _list(list, out, patterns),
    Object(entries) => {
      let i = 0;

      while (i < entries.len()) {
        match (entries[i]) {
          Field(_, entry) => _add(out, entry),
          Computed(key, entry) => {
            _add(out, key);
            _add(out, entry)
          },
          Spread(entry) => _add(out, entry),
        };
        i++;
      }
      null
    },
    Spread(inner), Unary(_, inner), Await(inner), Unquote(inner), Member(inner, _), TypeApply(inner, _),
    IncDec(_, _, inner), Cast(inner, _), Is(inner, _) => _add(out, inner),
    LetExpr(pattern, _, _, inner) => {
      _addPattern(patterns, pattern);
      _add(out, inner)
    },
    Bits(segments) => {
      let i = 0;

      while (i < segments.len()) {
        match (segments[i]) { Segment(_, _, _, _, segment) => _add(out, segment) };
        i++;
      }
      null
    },
    Index(left, right), Binary(_, left, right), Pipe(left, right), Assign(_, left, right) => {
      _add(out, left);
      _add(out, right)
    },
    Call(callee, _, args) => {
      _add(out, callee);
      _exprs(args, out)
    },
    New(base, args) => {
      _add(out, base);
      _exprs(args, out)
    },
    Function(params, _, body, _) => {
      _parameters(params, out);
      _block(body, out)
    },
    BlockExpr(body) => _block(body, out),
    If(condition, thenBranch, elseBranch), Conditional(condition, thenBranch, elseBranch) => {
      _add(out, condition);
      _add(out, thenBranch);
      _add(out, elseBranch)
    },
    Match(subject, arms) => {
      _add(out, subject);
      _arms(arms, out, patterns)
    },
    With(clauses, body, elseArms) => {
      let i = 0;

      while (i < clauses.len()) {
        match (clauses[i]) {
          Clause(pattern, guard, clause) => {
            _addPattern(patterns, pattern);
            _optional(guard, out);
            _add(out, clause)
          }
        };
        i++;
      }
      _block(body, out);
      match (elseArms) { Some(arms) => _arms(arms, out, patterns), None => null }
    },
    Try(body, _, catchBody) => {
      _block(body, out);
      _block(catchBody, out)
    },
    Quote(_, body) => match (body) {
      Expression(inner) => _add(out, inner),
      Statement(inner) => _addStmt(out, inner),
      Statements(inner) => _stmts(inner, out),
      Pattern(pattern) => _addPattern(patterns, pattern),
      Type(_) => null,
    },
  };
  _takeWith(SyntaxKind.Expression, exprTag(value), out, patterns)
};

_stmt = fn(value) {
  let out = Array.new<Syntax>(0);
  let patterns = Array.new<Syntax>(0);

  match (value) {
    LetStmt(_, _, pattern, _, _, inner) => {
      _addPattern(patterns, pattern);
      _add(out, inner)
    },
    Throw(inner), Expression(inner) => _add(out, inner),
    Prototype(_, _, _, fields) => {
      let i = 0;

      while (i < fields.len()) {
        match (fields[i]) { Field(_, field) => _add(out, field) };
        i++;
      }
      null
    },
    Macro(_, _, _, body) => _stmts(body, out),
    While(condition, body) => {
      _add(out, condition);
      _stmts(body, out)
    },
    DoWhile(body, condition) => {
      _stmts(body, out);
      _add(out, condition)
    },
    Return(inner) => _optional(inner, out),
    Typedef(_, _, _, _), Enum(_, _, _, _), ImportModule(_, _, _), ImportFrom(_, _, _), Break, Continue => null,
  };
  _takeWith(SyntaxKind.Statement, stmtTag(value), out, patterns)
};

export let rootSyntax: (Bytes, Array<Syntax>) -> Syntax = fn(path, children) {
  let end = 1;
  if (children.len() > 0) { match (children[children.len() - 1]) { Node(_, _, last, _, _) => { if (last > end) { end = last; } } } };
  Syntax.Node(path, 0, end, children, [])
};

export let syntaxTree: (Program, Bytes, Array<SyntaxMark>) -> Syntax = fn(program, path, marks) {
  _marks = marks;
  _next = 0;
  _path = path;

  match (program) { Program(_, statements, tail) => {
    let out = Array.new<Syntax>(0);
    _stmts(statements, out);
    _optional(tail, out);
    if (_next != _marks.len()) { throw "syntax marks remain after the AST"; }
    rootSyntax(path, out)
  } }
};
