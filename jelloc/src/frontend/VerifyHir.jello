package frontend;

import type { Hir } from frontend.Hir;
import {
  Kind, TYPE_BOOL, TYPE_BYTES, TYPE_I32, TYPE_I64, auxOf, bytesCount, bytesOf, childCount, childOf, childrenInBounds, globalCount,
  globalIsMutable, globalTypeOf, innerOf, isKind, lastChild, nodeCount, opOf, rootNode, spanCount, spanEndOf, spanPathOf, spanStartOf,
  typeArg, typeArgCount, typeOf, useHir, valueOf,
} from frontend.Hir;

let _used = Array.new<Bool>(0);
let _functionTypes = Array.new<I32>(0);
let _visibleIds = Array.new<I32>(0);
let _visibleTypes = Array.new<I32>(0);
let _visibleMutable = Array.new<Bool>(0);
let _declared = Array.new<Bool>(0);
let _nextGlobal = 0;

let _fail = fn(message: Bytes) {
  throw "invalid HIR: " + message;
  null
};

let _child = fn(parent: I32, index: I32): I32 {
  if (!childrenInBounds(parent) || (index < 0) || (index >= childCount(parent))) { _fail("missing operand"); }
  let child = childOf(parent, index);
  if ((child < 0) || (child >= parent)) { _fail("node reference out of order"); }
  if (_used[child]) { _fail("node referenced twice"); }
  _used[child] = true;
  child
};

let _arity = fn(id: I32, count: I32) { if (childCount(id) != count) { _fail("wrong operand count"); } null };

let _spans = fn() {
  if (spanCount() != nodeCount()) { _fail("every node needs a source span"); }
  let id = 0;

  while (id < nodeCount()) {
    let path = spanPathOf(id);
    if ((path < 0) || (path >= bytesCount()) || (bytesOf(path).len() == 0)) { _fail("source span without a path"); }
    if ((spanStartOf(id) < 0) || (spanEndOf(id) <= spanStartOf(id))) { _fail("empty source span"); }
    let i = 0;

    while (i < childCount(id)) {
      let child = childOf(id, i);

      if ((spanPathOf(child) == path) && ((spanStartOf(child) < spanStartOf(id)) || (spanEndOf(child) > spanEndOf(id)))) {
        _fail("child span outside its parent");
      }
      i++;
    }
    id++;
  }
  null
};

let _visible = fn(id: I32): I32 {
  let i = _visibleIds.len() - 1;

  while (i >= 0) {
    if (_visibleIds[i] == id) { return i; }
    i--;
  }
  _fail("unknown local binding");
  -1
};

let _declare = fn(id: I32, ty: I32, mutable: Bool) {
  if (id < 0) { _fail("negative binding ID"); }
  while (_declared.len() <= id) { _declared.push(false); }
  if (_declared[id]) { _fail("binding declared twice"); }
  _declared[id] = true;
  _visibleIds.push(id);
  _visibleTypes.push(ty);
  _visibleMutable.push(mutable);
  null
};

let _popTo = fn(start: I32) {
  while (_visibleIds.len() > start) {
    _visibleIds.pop();
    _visibleTypes.pop();
    _visibleMutable.pop();
  }
  null
};

let _expr: (I32) -> I32 = fn(_id) { -1 };
let _operand = fn(parent: I32, index: I32): I32 { _expr(_child(parent, index)) };

let _global = fn(id: I32): I32 {
  if ((id < 0) || (id >= globalCount())) { _fail("unknown global"); }
  globalTypeOf(id)
};

let _binding = fn(parent: I32, index: I32, programBody: Bool) {
  let binding = _child(parent, index);
  _arity(binding, 1);
  if (_operand(binding, 0) != typeOf(binding)) { _fail("binding type mismatch"); }

  match (opOf(binding)) {
    Let, Const => _declare(valueOf(binding), typeOf(binding), match (opOf(binding)) { Let => true, _ => false }),
    InitGlobal => {
      if (!programBody) { _fail("global initialized outside the program body"); }
      if (valueOf(binding) != _nextGlobal) { _fail("globals must be initialized once, in order"); }
      if (_global(valueOf(binding)) != typeOf(binding)) { _fail("global type mismatch"); }
      _nextGlobal++;
      null
    },
    _ => {
      _fail("expected binding");
      null
    },
  };
  null
};

let _functionType = fn(functionId: I32): I32 {
  if ((functionId < 1) || (functionId > _functionTypes.len())) { _fail("unknown direct function"); }
  _functionTypes[functionId - 1]
};

let _arguments = fn(id: I32, functionType: I32, first: I32, message: Bytes): I32 {
  if (!isKind(functionType, Kind.Function) || (typeArgCount(functionType) != childCount(id) - first)) { _fail(message); }
  let i = 0;

  while (i < typeArgCount(functionType)) {
    if (_operand(id, first + i) != typeArg(functionType, i)) { _fail(message); }
    i++;
  }
  innerOf(functionType)
};

let _typed = fn(id: I32, operands: Array<I32>, result: I32, message: Bytes): I32 {
  _arity(id, operands.len() as I32);
  let i = 0;

  while (i < operands.len()) {
    if (_operand(id, i) != operands[i]) { _fail(message); }
    i++;
  }
  result
};

let _array = fn(id: I32, operands: I32): I32 {
  _arity(id, operands);
  let array = _operand(id, 0);
  if (!isKind(array, Kind.Array) || (_operand(id, 1) != TYPE_I32)) { _fail("array access operand type"); }
  if ((operands == 3) && (_operand(id, 2) != innerOf(array))) { _fail("array set value type"); }
  innerOf(array)
};

let _block = fn(id: I32, programBody: Bool): I32 {
  if (childCount(id) < 1) { _fail("block without tail"); }
  let scope = _visibleIds.len();
  let i = 0;

  while (i < childCount(id) - 1) {
    _binding(id, i, programBody);
    i++;
  }
  let tail = _operand(id, childCount(id) - 1);
  _popTo(scope);
  tail
};

_expr = fn(id) {
  let ty = typeOf(id);

  let actual = match (opOf(id)) {
    Bool => {
      if ((valueOf(id) != 0) && (valueOf(id) != 1)) { _fail("bool literal"); }
      _typed(id, [], TYPE_BOOL, "")
    },
    I32 => _typed(id, [], TYPE_I32, ""),
    Bytes => {
      if ((valueOf(id) < 0) || (valueOf(id) >= bytesCount())) { _fail("bytes index"); }
      _typed(id, [], TYPE_BYTES, "")
    },
    Null => {
      if (!isKind(ty, Kind.Null)) { _fail("null literal type"); }
      _typed(id, [], ty, "")
    },
    Local => {
      _arity(id, 0);
      _visibleTypes[_visible(valueOf(id))]
    },
    Assign => {
      let found = _visible(valueOf(id));
      if (!_visibleMutable[found]) { _fail("assignment to immutable local"); }
      _typed(id, [_visibleTypes[found]], _visibleTypes[found], "assignment type mismatch")
    },
    Global => {
      _arity(id, 0);
      _global(valueOf(id))
    },
    SetGlobal => {
      let global = _global(valueOf(id));
      if (!globalIsMutable(valueOf(id))) { _fail("assignment to immutable global"); }
      _typed(id, [global], global, "global assignment type mismatch")
    },
    FunctionRef => {
      _arity(id, 0);
      _functionType(valueOf(id))
    },
    Add, Sub, Mul => _typed(id, [TYPE_I32, TYPE_I32], TYPE_I32, "i32 operation requires i32 operands"),
    Eq, Lt, Gt => _typed(id, [TYPE_I32, TYPE_I32], TYPE_BOOL, "i32 operation requires i32 operands"),
    Neg => _typed(id, [TYPE_I32], TYPE_I32, "i32 negation requires i32 operand"),
    Not => _typed(id, [TYPE_BOOL], TYPE_BOOL, "bool not requires bool operand"),
    And, Or => _typed(id, [TYPE_BOOL, TYPE_BOOL], TYPE_BOOL, "logical operation requires bool operands"),
    Sext => _typed(id, [TYPE_I32], TYPE_I64, "i32 to i64 cast requires i32 operand"),
    Trunc => _typed(id, [TYPE_I64], TYPE_I32, "i64 to i32 cast requires i64 operand"),
    Present => {
      if (!isKind(ty, Kind.Null)) { _fail("present requires a nullable type"); }
      _typed(id, [innerOf(ty)], ty, "present requires the inner type")
    },
    IsNull, IsPresent => {
      _arity(id, 1);
      if (!isKind(_operand(id, 0), Kind.Null)) { _fail("null check requires a nullable operand"); }
      TYPE_BOOL
    },
    ArrayNew => {
      if (!isKind(ty, Kind.Array)) { _fail("array type"); }
      _typed(id, [TYPE_I32], ty, "array length must be i32")
    },
    ArrayLen => {
      _arity(id, 1);
      if (!isKind(_operand(id, 0), Kind.Array)) { _fail("array len source type"); }
      TYPE_I32
    },
    ArrayGet => _array(id, 2),
    ArraySet => _array(id, 3),
    BytesGet => _typed(id, [TYPE_BYTES, TYPE_I32], TYPE_I32, "bytes get operand type"),
    Tuple => {
      if (!isKind(ty, Kind.Tuple) || (typeArgCount(ty) != childCount(id))) { _fail("tuple shape"); }
      let i = 0;

      while (i < childCount(id)) {
        if (_operand(id, i) != typeArg(ty, i)) { _fail("tuple field type"); }
        i++;
      }
      ty
    },
    TupleField => {
      _arity(id, 1);
      let tuple = _operand(id, 0);
      if (!isKind(tuple, Kind.Tuple) || (valueOf(id) < 0) || (valueOf(id) >= typeArgCount(tuple))) { _fail("tuple field access"); }
      typeArg(tuple, valueOf(id))
    },
    Call => _arguments(id, _functionType(valueOf(id)), 0, "direct call signature mismatch"),
    CallIndirect => _arguments(id, _operand(id, 0), 1, "indirect call signature mismatch"),
    Block => _block(id, false),
    If => _typed(id, [TYPE_BOOL, ty, ty], ty, "if operand type"),
    _ => {
      _fail("expected expression");
      -1
    },
  };
  if (actual != ty) { _fail("expression type mismatch"); }
  ty
};

let _statements: (I32, I32, I32, I32, I32) -> Bool = fn(_parent, _from, _to, _result, _loopDepth) { false };

let _statement = fn(id: I32, result: I32, loopDepth: I32): Bool {
  let reachable = match (opOf(id)) {
    Declare => {
      _arity(id, 1);
      _binding(id, 0, false);
      true
    },
    Expression => {
      _arity(id, 1);
      _operand(id, 0);
      true
    },
    Return => {
      _typed(id, [result], 0, "return type mismatch");
      false
    },
    Throw => {
      _arity(id, 1);
      _operand(id, 0);
      false
    },
    Break => {
      if (loopDepth == 0) { _fail("break outside loop"); }
      _arity(id, 0);
      false
    },
    Continue => {
      if (loopDepth == 0) { _fail("continue outside loop"); }
      _arity(id, 0);
      false
    },
    While => {
      if (_operand(id, 0) != TYPE_BOOL) { _fail("while condition must be bool"); }
      let scope = _visibleIds.len();
      _statements(id, 1, childCount(id), result, loopDepth + 1);
      _popTo(scope);
      true
    },
    _ => {
      _fail("expected statement");
      false
    },
  };
  reachable
};

_statements = fn(parent, start, end, result, loopDepth) {
  let reachable = true;
  let i = start;

  while (i < end) {
    if (!reachable) { _fail("statement after return"); }
    reachable = _statement(_child(parent, i), result, loopDepth);
    i++;
  }
  reachable
};

let _function = fn(id: I32, functionId: I32) {
  let ty = typeOf(id);
  if (ty != _functionTypes[functionId - 1]) { _fail("function type mismatch"); }
  if (childCount(id) != typeArgCount(ty) + 1) { _fail("parameter count mismatch"); }
  _popTo(0);
  let i = 0;

  while (i < typeArgCount(ty)) {
    let param = _child(id, i);
    let isParameter = match (opOf(param)) { Parameter => true, _ => false };
    if (!isParameter || (typeOf(param) != typeArg(ty, i))) { _fail("parameter type mismatch"); }
    _arity(param, 0);
    _declare(valueOf(param), typeOf(param), false);
    i++;
  }
  let body = _child(id, typeArgCount(ty));

  match (opOf(body)) {
    Body => null, _ => {
      _fail("expected function body");
      null
    }
  };
  let hasTail = auxOf(body) == 1;
  if ((auxOf(body) != 0) && !hasTail) { _fail("function body tail flag"); }
  let statements = childCount(body) - auxOf(body);
  let reachable = _statements(body, 0, statements, innerOf(ty), 0);
  if (reachable && !hasTail) { _fail("function falls through without value"); }
  if (!reachable && hasTail) { _fail("unreachable function tail"); }
  if (hasTail && (_operand(body, statements) != innerOf(ty))) { _fail("function result type mismatch"); }
  null
};

export let verifyHir: (Hir) -> Bool = fn(program) {
  useHir(program);
  let root = rootNode();
  let count = nodeCount();
  let isProgram = (root == count - 1) && (match (opOf(root)) { Program => true, _ => false });
  if (!isProgram || !childrenInBounds(root) || (childCount(root) < 1)) { _fail("program must be the last node"); }
  _used = Array.new<Bool>(0);
  let i = 0;

  while (i < count) {
    _used.push(false);
    i++;
  }
  _functionTypes = Array.new<I32>(0);
  i = 0;

  while (i < childCount(root) - 1) {
    let function = childOf(root, i);
    let isFunction = (function >= 0) && (function < root) && (match (opOf(function)) { Function => true, _ => false });
    if (!isFunction || !isKind(typeOf(function), Kind.Function)) { _fail("expected function"); }
    _functionTypes.push(typeOf(function));
    i++;
  }
  _visibleIds = Array.new<I32>(0);
  _visibleTypes = Array.new<I32>(0);
  _visibleMutable = Array.new<Bool>(0);
  _declared = Array.new<Bool>(0);
  _nextGlobal = 0;
  i = 0;

  while (i < childCount(root) - 1) {
    _function(_child(root, i), i + 1);
    i++;
  }
  _popTo(0);
  let body = _child(root, childCount(root) - 1);

  match (opOf(body)) {
    Block => null, _ => {
      _fail("program body must be a block");
      null
    }
  };
  if (_block(body, true) != typeOf(body)) { _fail("expression type mismatch"); }
  if (_nextGlobal != globalCount()) { _fail("global never initialized"); }
  _spans();
  true
};
