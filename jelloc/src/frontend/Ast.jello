package frontend;

import { internalError } from frontend.Internal;

export enum IntSize {
  Infer;
  I8;
  I16;
  I32;
  I64;
  U8;
  U16;
  U32;
  U64;
}

export enum FloatSize {
  Infer;
  F16;
  F32;
  F64;
}

export enum UnaryOp {
  Not;
  Negate;
}

export enum IncDecOp {
  Increment;
  Decrement;
}

export enum BinaryOp {
  Add;
  Subtract;
  Multiply;
  Divide;
  Remainder;
  ShiftLeft;
  ShiftRight;
  BitAnd;
  BitOr;
  BitXor;
  Equal;
  NotEqual;
  Less;
  LessEqual;
  Greater;
  GreaterEqual;
  And;
  Or;
}

export enum AssignOp {
  Assign;
  Add;
  Subtract;
  Multiply;
  Divide;
}

export enum Type {
  Named(name: Bytes);
  Generic(name: Bytes, args: Array<Type>);
  OptionalArg(inner: Type);
  VarargsArg(inner: Type);
  Function(args: Array<Type>, result: Type);
  Tuple(items: Array<Type>);
}

export enum ParameterKind {
  Required;
  Default(value: Expr);
  Optional(defaultValue: ?Expr);
  Varargs;
}

export enum Parameter {
  Parameter(name: Bytes, annotation: ?Type, kind: ParameterKind);
}

export enum Block {
  Block(statements: Array<Stmt>, tail: ?Expr);
}

export enum TypeParam {
  TypeParam(name: Bytes, bounds: Array<Bytes>, start: I32, end: I32);
}

export enum QuoteKind {
  Auto;
  Expression;
  Statement;
  Statements;
  Type;
  Pattern;
}

export enum QuoteBody {
  Expression(value: Expr);
  Statement(value: Stmt);
  Statements(values: Array<Stmt>);
  Type(value: Type);
  Pattern(value: Pattern);
}

export enum ObjectEntry {
  Field(name: Bytes, value: Expr);
  Computed(key: Expr, value: Expr);
  Spread(value: Expr);
}

export enum ListGenerator {
  Generator(pattern: Pattern, source: Expr, guard: ?Expr);
}

export enum ListLiteral {
  Empty;
  Elements(items: Array<Expr>);
  Cons(prefix: Array<Expr>, tail: Expr);
  Spread(prefix: Array<Expr>, rest: Expr, suffix: Array<Expr>);
  Comprehension(generators: Array<ListGenerator>, body: Expr);
}

export enum Endian {
  Big;
  Little;
}

export enum BitValueKind {
  Integer;
  Float;
  Rest;
}

export enum BitExprSegment {
  Segment(width: I32, endian: Endian, signed: Bool, kind: BitValueKind, value: Expr);
}

export enum BitPatternSegment {
  Segment(width: I32, endian: Endian, signed: Bool, kind: BitValueKind, value: Pattern);
}

export enum MatchArm {
  Arm(alternatives: Array<MatchAlternative>, guard: ?Expr, body: Block);
}

export enum MatchAlternative {
  Alternative(pattern: Pattern, guard: ?Expr);
}

export enum WithClause {
  Clause(pattern: Pattern, guard: ?Expr, value: Expr);
}

export enum MatchArms {
  None;
  Some(arms: Array<MatchArm>);
}

export enum Pattern {
  Wildcard;
  BindPattern(name: Bytes);
  Pin(name: Bytes);
  Bool(value: Bool);
  Integer(digits: Bytes, size: IntSize);
  Bytes(value: Bytes);
  Atom(name: Bytes);
  Object(fields: Array<Tuple<Bytes, Pattern>>);
  Tuple(items: Array<Pattern>);
  Array(items: Array<Pattern>);
  ArrayCons(head: Pattern, tail: Bytes);
  ArrayRest(prefix: Array<Pattern>, rest: Bytes);
  Enum(name: Bytes, args: Array<Pattern>);
  RegExp(pattern: Bytes, flags: Bytes, binding: ?Bytes);
  IsType(ty: Type, binding: ?Bytes);
  Bits(segments: Array<BitPatternSegment>);
}

export enum Expr {
  Bytes(value: Bytes);
  RegExp(pattern: Bytes, flags: Bytes);
  Atom(name: Bytes);
  Bool(value: Bool);
  Integer(digits: Bytes, size: IntSize);
  Float(literal: Bytes, size: FloatSize);
  Null;
  This;
  Super;
  Variable(name: Bytes);

  Array(items: Array<Expr>);
  List(value: ListLiteral);
  Tuple(items: Array<Expr>);
  Object(entries: Array<ObjectEntry>);
  Spread(value: Expr);
  Bits(segments: Array<BitExprSegment>);

  Member(base: Expr, name: Bytes);
  Index(base: Expr, index: Expr);
  Call(callee: Expr, typeArgs: Array<Type>, args: Array<Expr>);
  TypeApply(base: Expr, args: Array<Type>);
  New(prototype: Expr, args: Array<Expr>);

  Function(params: Array<Parameter>, result: ?Type, body: Block, isMethod: Bool);
  BlockExpr(body: Block);
  If(condition: Expr, thenBranch: Expr, elseBranch: Expr);
  Match(subject: Expr, arms: Array<MatchArm>);
  With(clauses: Array<WithClause>, body: Block, elseArms: MatchArms);
  Try(body: Block, catchName: ?Bytes, catchBody: Block);
  LetExpr(pattern: Pattern, typeParams: Array<TypeParam>, annotation: ?Type, value: Expr);

  Unary(op: UnaryOp, value: Expr);
  Binary(op: BinaryOp, left: Expr, right: Expr);
  IncDec(op: IncDecOp, prefix: Bool, target: Expr);
  Cast(value: Expr, ty: Type);
  Is(value: Expr, ty: Type);
  Conditional(condition: Expr, thenBranch: Expr, elseBranch: Expr);
  Pipe(value: Expr, body: Expr);
  Topic;
  Assign(op: AssignOp, target: Expr, value: Expr);
  Await(value: Expr);
  Quote(kind: QuoteKind, body: QuoteBody);
  Unquote(value: Expr);
}

export enum ImportKind {
  Value;
  TypeOnly;
  MacroOnly;
  Native;
}

export enum ImportItem {
  Item(name: Bytes, alias: ?Bytes);
}

export enum StructField {
  Field(name: Bytes, ty: Type);
}

export enum EnumConstructor {
  Constructor(name: Bytes, fields: Array<StructField>);
}

export enum BytesLayoutType {
  U8;
  U16(endian: Endian);
  U32(endian: Endian);
  I32(endian: Endian);
  F32(endian: Endian);
  Bits(width: I32);
  Rest;
}

export enum BytesLayoutField {
  Field(name: Bytes, ty: BytesLayoutType);
}

export enum TypedefBody {
  Alias(ty: Type);
  Struct(fields: Array<StructField>);
  BytesLayout(fields: Array<BytesLayoutField>);
}

export enum PrototypeField {
  Field(name: Bytes, value: Expr);
}

export enum Stmt {
  LetStmt(isConst: Bool, exported: Bool, pattern: Pattern, typeParams: Array<TypeParam>, annotation: ?Type, value: Expr);
  Prototype(exported: Bool, name: Bytes, typeParams: Array<TypeParam>, fields: Array<PrototypeField>);
  Typedef(exported: Bool, name: Bytes, typeParams: Array<TypeParam>, body: TypedefBody);
  Enum(exported: Bool, name: Bytes, typeParams: Array<TypeParam>, constructors: Array<EnumConstructor>);
  Macro(exported: Bool, name: Bytes, params: Array<Bytes>, body: Array<Stmt>);

  ImportModule(kind: ImportKind, path: Array<Bytes>, alias: Bytes);
  ImportFrom(kind: ImportKind, items: Array<ImportItem>, path: Array<Bytes>);

  While(condition: Expr, body: Array<Stmt>);
  DoWhile(body: Array<Stmt>, condition: Expr);
  Break;
  Continue;
  Throw(value: Expr);
  Return(value: ?Expr);
  Expression(value: Expr);
}

export enum Package {
  None;
  Path(parts: Array<Bytes>);
}

export enum Program {
  Program(package: Package, statements: Array<Stmt>, tail: ?Expr);
}

export let isBindPattern: (Pattern) -> Bool = fn(pattern) { match (pattern) { BindPattern(_) => true, _ => false } };

export let bindPatternName: (Pattern) -> Bytes = fn(pattern) {
  match (pattern) {
    BindPattern(name) => name, _ => {
      internalError("pattern is not a binding");
      ""
    }
  }
};

export let exprTag: (Expr) -> I32 = fn(expr) {
  match (expr) {
    Bytes(_) => 1, RegExp(_, _) => 2, Atom(_) => 3, Bool(_) => 4, Integer(_, _) => 5, Float(_, _) => 6,
    Null => 7, This => 8, Super => 9, Variable(_) => 10, Array(_) => 11, List(_) => 12, Tuple(_) => 13,
    Object(_) => 14, Spread(_) => 15, Bits(_) => 16, Member(_, _) => 17, Index(_, _) => 18, Call(_, _, _) => 19,
    TypeApply(_, _) => 20, New(_, _) => 21, Function(_, _, _, _) => 22, BlockExpr(_) => 23, If(_, _, _) => 24,
    Match(_, _) => 25, With(_, _, _) => 26, Try(_, _, _) => 27, LetExpr(_, _, _, _) => 28, Unary(_, _) => 29,
    Binary(_, _, _) => 30, IncDec(_, _, _) => 31, Cast(_, _) => 32, Is(_, _) => 33, Conditional(_, _, _) => 34,
    Pipe(_, _) => 35, Topic => 36, Assign(_, _, _) => 37, Await(_) => 38, Quote(_, _) => 39, Unquote(_) => 40,
  }
};

export let patternTag: (Pattern) -> I32 = fn(pattern) {
  match (pattern) {
    Wildcard => 1, BindPattern(_) => 2, Pin(_) => 3, Bool(_) => 4, Integer(_, _) => 5, Bytes(_) => 6, Atom(_) => 7,
    Object(_) => 8, Tuple(_) => 9, Array(_) => 10, ArrayCons(_, _) => 11, ArrayRest(_, _) => 12, Enum(_, _) => 13,
    RegExp(_, _, _) => 14, IsType(_, _) => 15, Bits(_) => 16,
  }
};

export let stmtTag: (Stmt) -> I32 = fn(stmt) {
  match (stmt) {
    LetStmt(_, _, _, _, _, _) => 1, Prototype(_, _, _, _) => 2, Typedef(_, _, _, _) => 3, Enum(_, _, _, _) => 4,
    Macro(_, _, _, _) => 5, ImportModule(_, _, _) => 6, ImportFrom(_, _, _) => 7, While(_, _) => 8,
    DoWhile(_, _) => 9, Break => 10, Continue => 11, Throw(_) => 12, Return(_) => 13, Expression(_) => 14,
  }
};

let _digitValue = fn(c: I32): I32 {
  if (c <= "9".code) { c - "0".code } else if (c <= "F".code) { c - "A".code + 10 } else { c - "a".code + 10 }
};

let _integer = fn(text: Bytes, negative: Bool, wide: Bool): I64 {
  let i = 0;
  let sign = negative;

  if ((text.len() > 0) && (Bytes.get_u8(text, i) == "-".code)) {
    sign = !sign;
    i = 1;
  }
  let radix = 10;

  if ((text.len() > i + 2) && (Bytes.get_u8(text, i) == "0".code)) {
    radix = match (Bytes.get_u8(text, i + 1)) { "x".code, "X".code => 16, "b".code, "B".code => 2, "o".code, "O".code => 8, _ => 10 };
    if (radix != 10) { i += 2; }
  }
  let max: I64 = wide ? 9223372036854775807 : 2147483647;
  let least: I64 = sign ? -max - 1 : -max;
  let value: I64 = 0;

  while (i < text.len()) {
    let c = Bytes.get_u8(text, i);
    i++;

    if (c != "_".code) {
      let digit = _digitValue(c) as I64;

      if (value < (least + digit) / (radix as I64)) {
        throw "integer literal " + (negative ? "-" : "") + text + " is out of range for "
          + (wide ? "I64 (-9223372036854775808 to 9223372036854775807)" : "I32 (-2147483648 to 2147483647)");
      }
      value = value * (radix as I64) - digit;
    }
  }
  sign ? value : -value
};

export let integerValue: (Bytes, Bool) -> I32 = fn(text, negative) { _integer(text, negative, false) as I32 };
export let wideIntegerValue: (Bytes, Bool) -> I64 = fn(text, negative) { _integer(text, negative, true) };
