package frontend;

import type { Import, Module } from frontend.Modules;
import { Module, modulePath } from frontend.Modules;

export enum Binding {
  Global(id: I32); Function(index: I32); Loaded(library: Bytes, name: Bytes); Native(id: I32);
  Namespace(module: I32, path: Bytes); Unbound;
}

let _names = Array.new<Bytes>(0);
let _bindings = Array.new<Binding>(0);
let _imported = Array.new<Bool>(0);
let _typeNames = Array.new<Bytes>(0);
let _types = Array.new<I32>(0);
let _exportModules = Array.new<I32>(0);
let _exportNames = Array.new<Bytes>(0);
let _exportBindings = Array.new<Binding>(0);
let _exportTypeModules = Array.new<I32>(0);
let _exportTypeNames = Array.new<Bytes>(0);
let _exportTypes = Array.new<I32>(0);

let _indexIn = fn(names: Array<Bytes>, name: Bytes): I32 {
  let i = 0;

  while (i < names.len()) {
    if (names[i] == name) { return i; }
    i++;
  }
  -1
};
let _index = fn(name: Bytes): I32 { _indexIn(_names, name) };

let _unique = fn(name: Bytes) {
  if ((_index(name) >= 0) || (_indexIn(_typeNames, name) >= 0)) { throw "duplicate top-level name: " + name; }
  null
};

let _add = fn(name: Bytes, binding: Binding, imported: Bool) {
  _unique(name);
  _names.push(name);
  _bindings.push(binding);
  _imported.push(imported);
  null
};

let _addType = fn(name: Bytes, ty: I32) {
  _unique(name);
  _typeNames.push(name);
  _types.push(ty);
  null
};

let _export = fn(modules: Array<I32>, names: Array<Bytes>, module: I32, name: Bytes): I32 {
  let e = names.len() as I32 - 1;
  while ((e >= 0) && ((modules[e] != module) || (names[e] != name))) { e--; }
  e
};

let _unknownExport = fn(name: Bytes, path: Bytes): Bytes { "unknown export " + name + " in " + path };

export let resetExports: () -> Bool = fn() {
  _exportModules = Array.new<I32>(0);
  _exportNames = Array.new<Bytes>(0);
  _exportBindings = Array.new<Binding>(0);
  _exportTypeModules = Array.new<I32>(0);
  _exportTypeNames = Array.new<Bytes>(0);
  _exportTypes = Array.new<I32>(0);
  true
};

export let enterModule: (Array<Import>, Array<Module>, Bool) -> Bool = fn(imports, modules, typesOnly) {
  _names = Array.new<Bytes>(0);
  _bindings = Array.new<Binding>(0);
  _imported = Array.new<Bool>(0);
  _typeNames = Array.new<Bytes>(0);
  _types = Array.new<I32>(0);
  let i = 0;

  while (i < imports.len()) {
    match (imports[i]) {
      Import(local, module, name, typeOnly) => {
        let value = typeOnly ? -1 : _export(_exportModules, _exportNames, module, name);
        let ty = _export(_exportTypeModules, _exportTypeNames, module, name);
        if (value >= 0) { _add(local, _exportBindings[value], true); } else if (ty >= 0) { if (_indexIn(_typeNames, local) < 0) { _addType(local, _exportTypes[ty]); } } else if (!typesOnly) { throw _unknownExport(name, modulePath(modules[module])); }
      },
      Namespace(local, module) => _add(local, Binding.Namespace(module, modulePath(modules[module])), true),
    };
    i++;
  }
  true
};

export let declareScoped: (Bytes, Binding) -> Bool = fn(name, binding) {
  _add(name, binding, false);
  true
};

export let scoped: (Bytes) -> Binding = fn(name) {
  let found = _index(name);
  if (found < 0) { Binding.Unbound } else { _bindings[found] }
};

export let namespaceMember: (I32, Bytes, Bytes) -> Binding = fn(module, path, name) {
  let found = _export(_exportModules, _exportNames, module, name);
  if (found >= 0) { return _exportBindings[found]; }
  if (_export(_exportTypeModules, _exportTypeNames, module, name) >= 0) { throw name + " is a type; name it with import type { " + name + " } from the module"; }
  throw _unknownExport(name, path);
  Binding.Unbound
};

export let declareScopedType: (Bytes, I32) -> Bool = fn(name, ty) {
  _addType(name, ty);
  true
};

export let scopedType: (Bytes) -> I32 = fn(name) {
  let found = _indexIn(_typeNames, name);
  found < 0 ? -1 : _types[found]
};

export let exportScopedType: (I32, Bytes) -> Bool = fn(module, name) {
  _exportTypeModules.push(module);
  _exportTypeNames.push(name);
  _exportTypes.push(scopedType(name));
  true
};

export let isImported: (Bytes) -> Bool = fn(name) {
  let found = _index(name);
  (found >= 0) && _imported[found]
};

export let exportScoped: (I32, Bytes) -> Bool = fn(module, name) {
  _exportModules.push(module);
  _exportNames.push(name);
  _exportBindings.push(_bindings[_index(name)]);
  true
};
