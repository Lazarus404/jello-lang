package frontend.hir;

/** @file
 * Prints a checked HIR program as indented text for `jelloc --hir`, after the checker (and its
 * verifier) and before lowering. Each expression, binding and statement starts a line naming its
 * operation and immediates (a `Declare` prints only its bindings' lines, and parameters and
 * captures share their function's line). An expression's or binding's line then gives `: ` and
 * its type, and with `--spans` each of these ends with its source span. Operands and nested
 * statements follow, indented one level deeper.
 * Functions print first as `fn @N`, where `N` is the function ID, then the program body's
 * statements and tail. */

import type { Hir } from frontend.hir.Hir;
import {
  KIND_ENUM, auxOf, bytesOf, childCount, childOf, globalNameOf, hirTypeName, innerOf, isFloatType,
  isUnsigned, lastChild, nativeLibraryOf, nativeNameOf, opOf, rootNode, spanEndOf, spanOf,
  spanPathOf, spanStartOf, typeArgCount, typeOf, useHir, valueOf, variantName, wideValueOf,
} from frontend.hir.Hir;
import { internalError } from support.Internal;
import { bytesLiteral } from support.Text;

// Whether lines end with source spans, as for `jelloc --hir --spans`.
let _withSpans = false;

/** Returns the span suffix of node `id`'s line; ` @start..end`, followed by the source path when it
 * differs from the program root's. Compares paths by bytes ID.
 * @param id  the node
 * @return the suffix, or "" when spans are not being printed */
let _at = fn(id: I32): Bytes {
  if (!_withSpans) { return ""; }

  let range = ` @${spanStartOf(id)}..${spanEndOf(id)}`;
  if (spanPathOf(id) == spanPathOf(rootNode())) { return range; }
  `${range} ${spanOf(id).path}`
};

// Returns the end of an expression line; `: `, node `id`'s type, its span suffix and a newline.
let _typed = fn(id: I32): Bytes { `: ${hirTypeName(typeOf(id))}${_at(id)}\n` };

// Returns node `id`'s `value` immediate in decimal, such as a binding, global or function ID.
let _id = fn(id: I32): Bytes { Std.string(valueOf(id)) };

// Returns the type of the first child of node `id`, by name.
let _childType = fn(id: I32): Bytes { hirTypeName(typeOf(childOf(id, 0))) };

/** Prints the children of `parent` in `[start, end)` as expressions, one level deeper than
 * `indent`.
 * @param parent  the node whose children are printed
 * @param start  the first child index
 * @param end  the child index after the last
 * @param indent  the parent's indentation
 * @return the children's lines */
let _children = fn(parent: I32, start: I32, end: I32, indent: Bytes): Bytes {
  let output = Array.new<Bytes>(0);
  let i = start;

  while (i < end) {
    output.push(_expr(childOf(parent, i), `${indent}  `));
    i++;
  }
  output.join("")
};

/** Prints a `Let`, `Const` or `InitGlobal` binding of a `Declare`; a `let %id name`, `const %id
 * name` or `global gid name` header with its type, then its value one level deeper.
 * @param id  the binding node
 * @param indent  the header's indentation
 * @return the binding's lines */
let _binding = fn(id: I32, indent: Bytes): Bytes {
  let header = match (opOf(id)) {
    Let => `let %${_id(id)} ${bytesOf(auxOf(id))}`,
    InitGlobal => `global g${_id(id)} ${globalNameOf(valueOf(id))}`,
    _ => `const %${_id(id)} ${bytesOf(auxOf(id))}`,
  };
  `${indent}${header}${_typed(id)}${_expr(childOf(id, 0), indent + "  ")}`
};

/** Returns how a comparison of operands of type `ty` is named after its operator; `.u.` or `.s.`,
 * then the type. */
let _signed = fn(ty: I32): Bytes {
  let signedness = isFloatType(ty) ? "." : isUnsigned(ty) ? ".u." : ".s.";
  signedness + hirTypeName(ty)
};

/** Prints an operation as `name` and node `id`'s type, followed by all of its children as operands.
 * @param name  the operation's text, including any immediates
 * @param id  the node
 * @param indent  the line's indentation
 * @return the operation's lines */
let _operation = fn(name: Bytes, id: I32, indent: Bytes): Bytes {
  `${indent}${name}${_typed(id)}${_children(id, 0, childCount(id), indent)}`
};

/** Prints a labelled operand of a structured node such as `if`, `try` or `while`; `name` one level
 * deeper than `indent`, then child `index` of `id` as an expression two levels deeper.
 * @param name  the label
 * @param id  the structured node
 * @param index  the child to print
 * @param indent  the structured node's indentation
 * @return the section's lines */
let _section = fn(name: Bytes, id: I32, index: I32, indent: Bytes): Bytes {
  `${indent}  ${name}\n${_expr(childOf(id, index), indent + "    ")}`
};

// Returns child `index` of `id`, a block, as a section of statements labelled `name`.
let _blockSection = fn(name: Bytes, id: I32, index: I32, indent: Bytes): Bytes {
  `${indent}  ${name}\n${_statements(childOf(id, index), indent + "    ")}`
};

// Returns the key the object access `id` names, as " :name", or "" when a child holds it.
let _key = fn(id: I32): Bytes { valueOf(id) < 0 ? "" : ` :${bytesOf(valueOf(id))}` };

/** Returns the handler label of `Try` or `TryStatement` node `id`; `catch` for a bare catch, or
 * `catch %id name: Dynamic` when the thrown value is bound.
 * @param id  the try node
 * @return the label */
let _catch = fn(id: I32): Bytes {
  valueOf(id) < 0 ? "catch" : `catch %${_id(id)} ${bytesOf(auxOf(id))}: Dynamic`
};

// Returns the text of an `is_kind` test: the kind code, and for an enum its type.
let _isKind = fn(id: I32): Bytes {
  let enumType = valueOf(id) == KIND_ENUM ? ` ${hirTypeName(auxOf(id))}` : "";
  `is_kind ${_id(id)}${enumType}`
};

/** Prints expression node `id` and its operands.
 * @param id  the expression node
 * @param indent  the indentation of its first line
 * @return the node's lines
 * @throws an internal error if `id` is a statement op or anything else that is not an
 *   expression */
let _expr = fn(id: I32, indent: Bytes): Bytes {
  match (opOf(id)) {
    Bool => `${indent}bool ${valueOf(id) == 1 ? "true" : "false"}${_typed(id)}`,
    I32 => `${indent}i32 ${_id(id)}${_typed(id)}`,
    I64 => `${indent}i64 ${wideValueOf(id)}${_typed(id)}`,
    Float => `${indent}${hirTypeName(typeOf(id))} bits ${wideValueOf(id)}${_typed(id)}`,
    Bytes => `${indent}bytes ${bytesLiteral(bytesOf(valueOf(id)))}${_typed(id)}`,
    Atom => `${indent}atom :${bytesOf(valueOf(id))}${_typed(id)}`,
    Null => `${indent}null${_typed(id)}`,
    Local => `${indent}local %${_id(id)}${_typed(id)}`,
    Global => `${indent}global g${_id(id)}${_typed(id)}`,
    SetGlobal => _operation(`global.set g${_id(id)}`, id, indent),
    FunctionRef => _operation(`function @${_id(id)}`, id, indent),
    Assign => _operation(`assign %${_id(id)}`, id, indent),
    TupleField => _operation(`tuple.get ${_id(id)}`, id, indent),
    SetField => _operation(`field.set ${_id(id)}`, id, indent),
    EnumNew => _operation(`enum.new ${variantName(typeOf(id), valueOf(id))}`, id, indent),
    EnumTag => _operation("enum.tag", id, indent),
    ObjectNew => _operation("object.new", id, indent),
    ObjectGet => _operation(`object.get${_key(id)}`, id, indent),
    ObjectSet => _operation(`object.set${_key(id)}`, id, indent),
    ObjectHas => _operation(`object.has${_key(id)}`, id, indent),
    ObjectRemove => _operation("object.remove", id, indent),
    ObjectClear => _operation("object.clear", id, indent),
    ObjectCopy => _operation("object.copy", id, indent),
    ObjectKeys => _operation("object.keys", id, indent),
    EnumField => {
      let variant = variantName(typeOf(childOf(id, 0)), auxOf(id));
      _operation(`enum.field ${variant}.${_id(id)}`, id, indent)
    },
    Call => _operation(`call @${_id(id)}`, id, indent),
    CallIndirect => _operation("call.indirect", id, indent),
    CallNative => {
      let native = valueOf(id);
      _operation(`call.native ${nativeLibraryOf(native)}.${nativeNameOf(native)}`, id, indent)
    },
    Add => _operation("add.wrap", id, indent),
    Sub => _operation("sub.wrap", id, indent),
    Mul => _operation("mul.wrap", id, indent),
    Div => _operation("div.wrap", id, indent),
    Rem => _operation("rem.wrap", id, indent),
    Shl => _operation("shl", id, indent),
    Shr => _operation("shr.s", id, indent),
    BitAnd => _operation("bitand", id, indent),
    BitOr => _operation("bitor", id, indent),
    BitXor => _operation("bitxor", id, indent),
    Neg => _operation("neg.wrap", id, indent),
    Not => _operation("not.bool", id, indent),
    And => _operation("and", id, indent),
    Or => _operation("or", id, indent),
    Eq => _operation(`eq.${_childType(id)}`, id, indent),
    Lt => _operation(`lt${_signed(typeOf(childOf(id, 0)))}`, id, indent),
    Gt => _operation(`gt${_signed(typeOf(childOf(id, 0)))}`, id, indent),
    Le => _operation(`le.${_childType(id)}`, id, indent),
    Ge => _operation(`ge.${_childType(id)}`, id, indent),
    Convert => _operation(`convert.${_childType(id)}.${hirTypeName(typeOf(id))}`, id, indent),
    Present => _operation("present", id, indent),
    IsNull => _operation("is_null", id, indent),
    IsPresent => _operation("is_present", id, indent),
    Unwrap => _operation(valueOf(id) == 1 ? "unwrap" : "unwrap.known", id, indent),
    ToDynamic => _operation("to_dynamic", id, indent),
    FromDynamic => _operation("from_dynamic", id, indent),
    IsKind => _operation(_isKind(id), id, indent),
    ArrayNew => _operation("array.new", id, indent),
    ArrayLen => _operation("array.len", id, indent),
    ArrayGet => _operation("array.get", id, indent),
    ArraySet => _operation("array.set", id, indent),
    ArrayLiteral => _operation("array.literal", id, indent),
    ArrayConcat => _operation("array.concat", id, indent),
    ArrayPush => _operation("array.push", id, indent),
    ArrayPop => _operation("array.pop", id, indent),
    ArrayResize => _operation("array.resize", id, indent),
    ListNil => _operation("list.nil", id, indent),
    ListCons => _operation("list.cons", id, indent),
    ListHead => _operation("list.head", id, indent),
    ListTail => _operation("list.tail", id, indent),
    ListIsNil => _operation("list.is_nil", id, indent),
    BytesNew => _operation("bytes.new", id, indent),
    BytesSet => _operation("bytes.set_u8", id, indent),
    BitsPack => _operation("bits.pack", id, indent),
    BitsField => _operation(`bits.field ${_id(id)} ${auxOf(id)}`, id, indent),
    BitsRead => _operation(`bits.read ${_id(id)} ${auxOf(id)}`, id, indent),
    BytesLen => _operation("bytes.len", id, indent),
    BytesGet => _operation("bytes.get_u8", id, indent),
    BytesSlice => _operation("bytes.slice", id, indent),
    BytesConcat => _operation("bytes.concat", id, indent),
    BytesJoin => _operation("bytes.join", id, indent),
    BytesConcatMany => _operation("bytes.concat_many", id, indent),
    BytesEq => _operation("bytes.eq", id, indent),
    Tuple => _operation("tuple", id, indent),
    Block => {
      let deeper = `${indent}  `;
      // A block that ends every path may have no tail.
      let tail = auxOf(id) == 1 ? _expr(lastChild(id), deeper) : "";
      `${indent}block${_typed(id)}${_statements(id, deeper)}${tail}`
    },
    If => {
      `${indent}if${_typed(id)}`
        + _section("condition", id, 0, indent)
        + _section("then", id, 1, indent)
        + _section("else", id, 2, indent)
    },
    Try => {
      `${indent}try${_typed(id)}`
        + _section("body", id, 0, indent)
        + _section(_catch(id), id, 1, indent)
    },
    _ => {
      internalError("invalid HIR expression op");
      ""
    },
  }
};

/** Prints the `else` of `IfStatement` node `id`: a nested `if` prints as itself, so that an
 * `else if` chain reads as one, and any other block as its statements. */
let _otherwise = fn(id: I32, indent: Bytes): Bytes {
  let otherwise = childOf(id, 2);

  match (opOf(otherwise)) {
    IfStatement => _statement(otherwise, `${indent}    `),
    _ => _statements(otherwise, `${indent}    `),
  }
};

/** Prints statement node `id`. A `Declare` prints each of its bindings at `indent`, and an `else`
 * that is an `IfStatement` prints as a nested `if`.
 * @param id  the statement node
 * @param indent  the statement's indentation
 * @return the statement's lines
 * @throws an internal error if `id` is an expression op or anything else that is not a
 *   statement */
let _statement = fn(id: I32, indent: Bytes): Bytes {
  let deeper = `${indent}  `;

  match (opOf(id)) {
    Declare => {
      let output = Array.new<Bytes>(0);
      let i = 0;

      while (i < childCount(id)) {
        output.push(_binding(childOf(id, i), indent));
        i++;
      }
      output.join("")
    },
    Expression => `${indent}expression${_at(id)}\n${_expr(childOf(id, 0), deeper)}`,
    Block => `${indent}block${_at(id)}\n${_statements(id, deeper)}`,
    Return => `${indent}return${_at(id)}\n${_expr(childOf(id, 0), deeper)}`,
    Throw => `${indent}throw${_at(id)}\n${_expr(childOf(id, 0), deeper)}`,
    Break => `${indent}break${_at(id)}\n`,
    Continue => `${indent}continue${_at(id)}\n`,
    While => {
      let keyword = auxOf(id) == 0 ? "while" : "do-while";
      let step = childCount(id) < 3 ? "" : _blockSection("step", id, 2, indent);
      `${indent}${keyword}${_at(id)}\n`
        + _section("condition", id, 0, indent)
        + _blockSection("body", id, 1, indent)
        + step
    },
    IfStatement => {
      let output = `${indent}if${_at(id)}\n`
        + _section("condition", id, 0, indent)
        + _blockSection("then", id, 1, indent);
      if (childCount(id) < 3) { return output; }

      `${output}${indent}  else\n${_otherwise(id, indent)}`
    },
    TryStatement => {
      `${indent}try${_at(id)}\n`
        + _blockSection("body", id, 0, indent)
        + _blockSection(_catch(id), id, 1, indent)
    },
    _ => {
      internalError("invalid HIR statement op");
      ""
    },
  }
};

/** Prints the statements of block `id`, leaving out its tail; a block's `aux` is 1 when its last
 * child is a tail.
 * @param id  the block node
 * @param indent  the indentation of each statement
 * @return the statements' lines */
let _statements = fn(id: I32, indent: Bytes): Bytes {
  let output = Array.new<Bytes>(0);
  let i = 0;

  while (i < childCount(id) - auxOf(id)) {
    output.push(_statement(childOf(id, i), indent));
    i++;
  }
  output.join("")
};

/** Prints `Function` node `id` as `fn @functionId name(params) captures(...) -> result`, then its
 * body's statements and, when the body has one, its tail under a `tail` label. The first
 * `typeArgCount(typeOf(id))` children are the parameters, and any others before the body are
 * captures.
 * @param id  the function node
 * @param functionId  the function ID, as `Call` and `FunctionRef` name it
 * @return the function's lines */
let _function = fn(id: I32, functionId: I32): Bytes {
  let output = `  fn @${functionId} ${bytesOf(valueOf(id))}(`;
  let params = typeArgCount(typeOf(id));
  let i = 0;

  while (i < childCount(id) - 1) {
    let param = childOf(id, i);
    if (i == params) { output += ") captures("; } else if (i > 0) { output += ", "; }
    output += `%${_id(param)} ${bytesOf(auxOf(param))}: ${hirTypeName(typeOf(param))}${_at(param)}`;
    i++;
  }

  let body = lastChild(id);
  output += `) -> ${hirTypeName(innerOf(typeOf(id)))}${_at(id)}\n${_statements(body, "    ")}`;
  if (auxOf(body) == 1) { output += `    tail\n${_expr(lastChild(body), "      ")}`; }
  output
};

/** Prints `program`; a `program` line, its functions, then its body's statements and tail. Makes
 * `program` the current HIR (`Hir.useHir`).
 * @param program  the checked program
 * @return the listing */
let _print = fn(program: Hir): Bytes {
  useHir(program);
  let root = rootNode();
  let output = ["program\n"];
  let i = 0;

  while (i < childCount(root) - 1) {
    output.push(_function(childOf(root, i), i + 1));
    i++;
  }

  // The program body block prints its statements and tail at program level.
  let body = lastChild(root);
  output.push(_statements(body, "  "));
  output.push(_expr(lastChild(body), "  "));
  output.join("")
};

// Returns the listing of `program` without source spans, as for `jelloc --hir`.
export let printHir = fn(program: Hir): Bytes {
  _withSpans = false;
  _print(program)
};

// Returns the listing of `program` with each node's source span, as for `jelloc --hir --spans`.
export let printHirWithSpans = fn(program: Hir): Bytes {
  _withSpans = true;
  _print(program)
};
