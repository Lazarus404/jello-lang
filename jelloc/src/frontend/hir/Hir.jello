package frontend.hir;

import type { SourceSpan } from frontend.syntax.Source;
import { E0213, E0408, E0901, coded } from support.Codes;
import { internalError } from support.Internal;

export enum Op {
  Bool; I32; I64; Float; Bytes; Atom; Null;
  Local; Assign; Global; SetGlobal; InitGlobal; FunctionRef;
  Add; Sub; Mul; Div; Rem; Shl; Shr; BitAnd; BitOr; BitXor; Neg; Not; And; Or;
  Eq; Lt; Gt; Le; Ge;
  Convert; Present; IsNull; IsPresent; Unwrap; ToDynamic; FromDynamic; IsKind;
  ArrayNew; ArrayLiteral; ArrayConcat; ArrayLen; ArrayGet; ArraySet; ArrayPush; ArrayPop;
  ArrayResize;
  ListNil; ListCons; ListHead; ListTail; ListIsNil;
  BytesNew; BytesSet; BitsPack; BitsField; BitsRead; BytesLen; BytesGet; BytesSlice; BytesConcat;
  BytesConcatMany; BytesEq;
  Tuple; TupleField; SetField; EnumNew; EnumTag; EnumField;
  ObjectNew; ObjectGet; ObjectSet; ObjectHas; ObjectRemove; ObjectClear; ObjectCopy; ObjectKeys;
  Call; CallIndirect; CallNative; Block; If; Try;
  Let; Const; Parameter; Capture; Declare; Expression; Return; Throw; Break; Continue;
  IfStatement; TryStatement; While; Function; Program;
}

export enum Kind {
  Bool; I32; I64; Bytes; Array; Tuple; Null; Function; Enum; Dynamic; ByteBuffer; List;
  Var; Param; Applied; Atom;
  I8; I16; U8; U16; U32; U64; F16; F32; F64;
  Optional; Rest; Record; Object;
}

export typedef Hir = {
  let ops: Array<Op>;
  let nodes: Array<I32>;
  let edges: Array<I32>;
  let bytes: Array<Bytes>;
  let kinds: Array<Kind>;
  let types: Array<I32>;
  let typeEdges: Array<I32>;
  let root: I32;
  let spans: Array<I32>;
  let globals: Array<I32>;
  let natives: Array<I32>;
  let variants: Array<I32>;
  let fields: Array<I32>;
};

let _NODE_WIDTH = 5;
let _TYPE_WIDTH = 3;
let _GLOBAL_WIDTH = 3;
let _NATIVE_WIDTH = 3;
let _VARIANT_WIDTH = 3;
let _FIELD_WIDTH = 2;
let _SPAN_WIDTH = 3;

export let TYPE_BOOL: I32 = 0;
export let TYPE_I32: I32 = 1;
export let TYPE_I64: I32 = 2;
export let TYPE_BYTES: I32 = 3;
export let TYPE_NULL: I32 = 4;
export let TYPE_DYNAMIC: I32 = 5;
export let TYPE_BYTE_BUFFER: I32 = 6;
export let TYPE_ATOM: I32 = 7;
export let TYPE_I8: I32 = 8;
export let TYPE_I16: I32 = 9;
export let TYPE_U8: I32 = 10;
export let TYPE_U16: I32 = 11;
export let TYPE_U32: I32 = 12;
export let TYPE_U64: I32 = 13;
export let TYPE_F16: I32 = 14;
export let TYPE_F32: I32 = 15;
export let TYPE_F64: I32 = 16;
export let TYPE_OBJECT: I32 = 17;
export let isFloatType = fn(ty: I32): Bool { (ty >= TYPE_F16) && (ty <= TYPE_F64) };

export let isIntegerType = fn(ty: I32): Bool {
  ((ty >= TYPE_I32) && (ty <= TYPE_I64)) || ((ty >= TYPE_I8) && (ty <= TYPE_U64))
};

export let integerBits = fn(ty: I32): I32 {
  (ty == TYPE_I8) || (ty == TYPE_U8) ? 8
    : (ty == TYPE_I16) || (ty == TYPE_U16) ? 16
    : (ty == TYPE_I64) || (ty == TYPE_U64) ? 64
    : 32
};
export let BITS_BIG = 64;
export let BITS_FLOAT = 128;
export let segmentWidth = fn(code: I32): I32 { code & 63 };

export let segmentType = fn(code: I32): I32 {
  (code & BITS_FLOAT) != 0 ? TYPE_F32 : segmentWidth(code) == 0 ? TYPE_BYTES : TYPE_I32
};
export let isUnsigned = fn(ty: I32): Bool { (ty >= TYPE_U8) && (ty <= TYPE_U64) };
export let isNumberType = fn(ty: I32): Bool { isIntegerType(ty) || isFloatType(ty) };

export let leastValue = fn(ty: I32): I64 {
  isUnsigned(ty) ? 0 : -((1 as I64) << ((integerBits(ty) - 1) as I64))
};

export let mostValue = fn(ty: I32): I64 {
  let width = integerBits(ty) - (isUnsigned(ty) ? 0 : 1);
  ((1 as I64) << (width as I64)) - 1
};

export let KIND_BOOL: I32 = 1;
export let KIND_I32: I32 = 2;
export let KIND_ATOM: I32 = 3;
export let KIND_BYTES: I32 = 4;
export let KIND_OBJECT: I32 = 6;
export let KIND_I64: I32 = 7;
export let KIND_ENUM: I32 = 14;
export let KIND_FUNCTION: I32 = 12;
export let KIND_F64: I32 = 8;
export let KIND_F32: I32 = 9;
export let KIND_F16: I32 = 10;
export let isFloatKind = fn(code: I32): Bool { (code >= KIND_F64) && (code <= KIND_F16) };

export let BOUND_EQ: I32 = 1;
export let BOUND_SHOW: I32 = 2;
export let BOUND_INTEGER: I32 = 7;
let _NULLED = 8;

let _ops = Array.new<Op>(0);
let _nodes = Array.new<I32>(0);
let _edges = Array.new<I32>(0);
let _bytes = Array.new<Bytes>(0);
let _bytesSlots = Array.new<I32>(0);
let _kinds = Array.new<Kind>(0);
let _types = Array.new<I32>(0);
let _typeEdges = Array.new<I32>(0);
let _typeSlots = Array.new<I32>(0);
let _open = Array.new<Bool>(0);
let _parametric = Array.new<Bool>(0);
let _generic = Array.new<I32>(0);
let _checking = false;
let _root = -1;
let _spans = Array.new<I32>(0);
let _globals = Array.new<I32>(0);
let _natives = Array.new<I32>(0);
let _variants = Array.new<I32>(0);
let _fields = Array.new<I32>(0);
let _spanPath = -1;
let _spanStart = -1;
let _spanEnd = -1;

export let useHir = fn(program: Hir): Hir {
  _ops = program.ops;
  _nodes = program.nodes;
  _edges = program.edges;
  _bytes = program.bytes;
  _checking = false;
  _kinds = program.kinds;
  _types = program.types;
  _typeEdges = program.typeEdges;
  _root = program.root;
  _spans = program.spans;
  _globals = program.globals;
  _natives = program.natives;
  _variants = program.variants;
  _fields = program.fields;

  program
};

export let nodeCount = fn(): I32 { _ops.len() };
export let rootNode = fn(): I32 { _root };
export let opOf = fn(id: I32): Op { _ops[id] };
let _current = fn(ty: I32): I32 { (_checking && (ty >= 0) && _open[ty]) ? resolve(ty) : ty };

export let typeOf = fn(id: I32): I32 {
  let ty = _nodes[id * _NODE_WIDTH];
  (_checking && (ty >= 0) && _open[ty]) ? resolve(ty) : ty
};
export let valueOf = fn(id: I32): I32 { _nodes[id * _NODE_WIDTH + 1] };
export let auxOf = fn(id: I32): I32 { _nodes[id * _NODE_WIDTH + 2] };
export let childCount = fn(id: I32): I32 { _nodes[id * _NODE_WIDTH + 4] };
export let childOf = fn(id: I32, index: I32): I32 { _edges[_nodes[id * _NODE_WIDTH + 3] + index] };

export let wideValueOf = fn(id: I32): I64 {
  ((auxOf(id) as I64) << 32) | ((valueOf(id) as I64) & 4294967295)
};
export let lastChild = fn(id: I32): I32 { childOf(id, childCount(id) - 1) };

let _breaksOut = fn(id: I32): Bool { _hasBreak(childOf(id, 0)) || _hasBreak(childOf(id, 1)) };

let _hasBreak = fn(id: I32): Bool {
  match (opOf(id)) {
    Break => true,
    While => _hasBreak(childOf(id, 0)),
    _ => {
      let i = 0;
      while ((i < childCount(id)) && !_hasBreak(childOf(id, i))) { i++; }
      i < childCount(id)
    },
  }
};

let _endsPath = fn(id: I32): Bool {
  match (opOf(id)) {
    Return, Throw, Break, Continue => true,
    IfStatement => (childCount(id) == 3) && _endsPath(childOf(id, 1)) && _endsPath(childOf(id, 2)),
    TryStatement => _endsPath(childOf(id, 0)) && _endsPath(childOf(id, 1)),
    While => {
      let condition = childOf(id, 0);
      match (opOf(condition)) { Bool => (valueOf(condition) != 0) && !_breaksOut(id), _ => false }
    },
    Block => {
      let statements = childCount(id) - auxOf(id);
      (statements > 0) && _endsPath(childOf(id, statements - 1))
    },
    _ => false,
  }
};
export let endsPath = fn(id: I32): Bool { _endsPath(id) };

export let childrenInBounds = fn(id: I32): Bool {
  let first = _nodes[id * _NODE_WIDTH + 3];
  let count = childCount(id);
  (first >= 0) && (count >= 0) && (first + count <= _edges.len())
};
export let bytesOf = fn(id: I32): Bytes { _bytes[id] };
export let spanPathOf = fn(id: I32): I32 { _spans[id * _SPAN_WIDTH] };
export let spanStartOf = fn(id: I32): I32 { _spans[id * _SPAN_WIDTH + 1] };
export let spanEndOf = fn(id: I32): I32 { _spans[id * _SPAN_WIDTH + 2] };
export let spanCount = fn(): I32 { _spans.len() / _SPAN_WIDTH };

export let spanOf = fn(id: I32): SourceSpan {
  { path: _bytes[spanPathOf(id)], start: spanStartOf(id), end: spanEndOf(id) }
};
export let bytesCount = fn(): I32 { _bytes.len() };

export let globalCount = fn(): I32 { _globals.len() / _GLOBAL_WIDTH };
export let globalTypeOf = fn(global: I32): I32 { _current(_globals[global * _GLOBAL_WIDTH]) };
export let globalNameOf = fn(global: I32): Bytes { _bytes[_globals[global * _GLOBAL_WIDTH + 1]] };
export let globalIsMutable = fn(global: I32): Bool { _globals[global * _GLOBAL_WIDTH + 2] == 1 };
export let nativeCount = fn(): I32 { _natives.len() / _NATIVE_WIDTH };
export let nativeLibraryOf = fn(native: I32): Bytes { _bytes[_natives[native * _NATIVE_WIDTH]] };
export let nativeNameOf = fn(native: I32): Bytes { _bytes[_natives[native * _NATIVE_WIDTH + 1]] };
export let nativeTypeOf = fn(native: I32): I32 { _natives[native * _NATIVE_WIDTH + 2] };

let _kindCode = fn(kind: Kind): I32 {
  match (kind) {
    Bool => 0, I32 => 1, I64 => 2, Bytes => 3, Array => 4, Tuple => 5, Null => 6, Function => 7,
    Enum => 8, Dynamic => 9, ByteBuffer => 10, List => 11, Var => 12, Param => 13, Applied => 14,
    Atom => 15, I8 => 16, I16 => 17, U8 => 18, U16 => 19, U32 => 20, U64 => 21, F16 => 22,
    F32 => 23, F64 => 24, Optional => 25, Rest => 26, Record => 27, Object => 28,
  }
};

export let typeCount = fn(): I32 { _kinds.len() };
export let kindOf = fn(ty: I32): Kind { _kinds[ty] };
export let innerOf = fn(ty: I32): I32 { _types[ty * _TYPE_WIDTH] };
export let typeArgCount = fn(ty: I32): I32 { _types[ty * _TYPE_WIDTH + 2] };

export let typeArg = fn(ty: I32, index: I32): I32 {
  _typeEdges[_types[ty * _TYPE_WIDTH + 1] + index]
};

let _shape = fn(ty: I32): I32 {
  match (_kinds[ty]) { Applied => _types[ty * _TYPE_WIDTH], _ => ty }
};

let _variant = fn(ty: I32, tag: I32): I32 {
  let shape = match (_kinds[ty]) { Applied => _types[ty * _TYPE_WIDTH], _ => ty };
  (_types[shape * _TYPE_WIDTH + 1] + tag) * _VARIANT_WIDTH
};

let _field = fn(ty: I32, tag: I32, field: I32): I32 {
  (_variants[_variant(ty, tag) + 1] + field) * _FIELD_WIDTH
};

export let variantCount = fn(ty: I32): I32 {
  let shape = match (_kinds[ty]) { Applied => _types[ty * _TYPE_WIDTH], _ => ty };
  _types[shape * _TYPE_WIDTH + 2]
};
export let variantName = fn(ty: I32, tag: I32): Bytes { _bytes[_variants[_variant(ty, tag)]] };
export let fieldCount = fn(ty: I32, tag: I32): I32 { _variants[_variant(ty, tag) + 2] };

export let fieldName = fn(ty: I32, tag: I32, field: I32): Bytes {
  _bytes[_fields[_field(ty, tag, field)]]
};

export let fieldType = fn(ty: I32, tag: I32, field: I32): I32 {
  let declared = _fields[_field(ty, tag, field) + 1];
  match (_kinds[ty]) { Applied => _appliedField(ty, declared), _ => declared }
};

export let variantTag = fn(ty: I32, name: Bytes): I32 {
  let row = _shape(ty) * _TYPE_WIDTH;
  let first = _types[row + 1];
  let count = _types[row + 2];
  let tag = 0;

  while (tag < count) {
    if (_bytes[_variants[(first + tag) * _VARIANT_WIDTH]] == name) { return tag; }
    tag++;
  }

  -1
};

export let isKind = fn(ty: I32, kind: Kind): Bool {
  (ty >= 0) && (ty < typeCount()) && (_kinds[ty] == kind)
};

let _isNominal = fn(ty: I32, kind: Kind): Bool {
  if ((ty < 0) || (ty >= typeCount())) { return false; }
  (_kinds[ty] == kind)
    || ((_kinds[ty] == Kind.Applied) && (_kinds[_types[ty * _TYPE_WIDTH]] == kind))
};
export let isEnum = fn(ty: I32): Bool { _isNominal(ty, Kind.Enum) };
export let isRecord = fn(ty: I32): Bool { _isNominal(ty, Kind.Record) };
export let isObject = fn(ty: I32): Bool { _isNominal(ty, Kind.Object) };
export let isPrototype = fn(ty: I32): Bool { isObject(ty) && (ty != TYPE_OBJECT) };
export let isLinked = fn(ty: I32): Bool { isPrototype(ty) && (variantCount(ty) > 0) };

export let memberCount = fn(ty: I32): I32 {
  _kinds[ty] == Kind.Tuple ? typeArgCount(ty) : fieldCount(ty, 0)
};

export let memberType = fn(ty: I32, member: I32): I32 {
  _kinds[ty] == Kind.Tuple ? typeArg(ty, member) : fieldType(ty, 0, member)
};

export let recordField = fn(ty: I32, name: Bytes): I32 {
  let field = 0;
  let count = fieldCount(ty, 0);

  while (field < count) {
    if (fieldName(ty, 0, field) == name) { return field; }
    field++;
  }

  -1
};

export let node = fn(op: Op, ty: I32, value: I32, aux: I32, children: Array<I32>): I32 {
  let id = _ops.len();
  _ops.push(op);
  _spans.push(_spanPath);
  _spans.push(_spanStart);
  _spans.push(_spanEnd);
  _nodes.push(ty);
  _nodes.push(value);
  _nodes.push(aux);
  _nodes.push(_edges.len());
  _nodes.push(children.len());

  let i = 0;

  while (i < children.len()) {
    _edges.push(children[i]);
    i++;
  }

  id
};

export let opNode = fn(op: Op, ty: I32, children: Array<I32>): I32 {
  node(op, ty, 0, 0, children)
};

export let setCallee = fn(id: I32, function: I32): Bool {
  _nodes[id * _NODE_WIDTH + 1] = function + 1;
  true
};

export let setGlobal = fn(id: I32, global: I32): Bool {
  _nodes[id * _NODE_WIDTH + 1] = global;
  true
};

export let retype = fn(id: I32, ty: I32): Bool {
  if (!endsPath(id)) { internalError("only a block that ends every path is retyped"); }
  _nodes[id * _NODE_WIDTH] = ty;
  true
};
export let noValueType = fn(expected: I32): I32 { expected >= 0 ? resolve(expected) : TYPE_NULL };

export let copyNode = fn(id: I32, ty: I32, children: Array<I32>): I32 {
  let path = _spanPath;
  let start = _spanStart;
  let end = _spanEnd;
  _spanPath = spanPathOf(id);
  _spanStart = spanStartOf(id);
  _spanEnd = spanEndOf(id);

  let copy = node(opOf(id), ty, valueOf(id), auxOf(id), children);
  _spanPath = path;
  _spanStart = start;
  _spanEnd = end;
  copy
};

let _wideNode = fn(op: Op, ty: I32, value: I64): I32 {
  node(op, ty, value as I32, (value >> 32) as I32, [])
};
export let wideLiteral = fn(value: I64, ty: I32): I32 { _wideNode(Op.I64, ty, value) };
export let floatLiteral = fn(pattern: I64, ty: I32): I32 { _wideNode(Op.Float, ty, pattern) };

let _mix = fn(hash: I32, word: I32): I32 { (hash ^ word) * 16777619 };
let _slot = fn(hash: I32, capacity: I32): I32 { (hash & 2147483647) % capacity };

let _emptySlots = fn(capacity: I32): Array<I32> {
  let slots = Array.new<I32>(capacity);
  let i = 0;

  while (i < capacity) {
    slots[i] = -1;
    i++;
  }
  slots
};

let _bytesHash = fn(value: Bytes): I32 {
  let hash = -2128831035;
  let i = 0;

  while (i < value.len()) {
    hash = _mix(hash, Bytes.get_u8(value, i));
    i++;
  }
  hash
};

let _growBytes = fn() {
  let capacity = _bytesSlots.len() * 2;
  _bytesSlots = _emptySlots(capacity);
  let i = 0;

  while (i < _bytes.len()) {
    let slot = _slot(_bytesHash(_bytes[i]), capacity);
    while (_bytesSlots[slot] >= 0) { slot = (slot + 1) % capacity; }
    _bytesSlots[slot] = i;
    i++;
  }
  null
};

let _bytesSlot = fn(value: Bytes): I32 {
  let capacity = _bytesSlots.len();
  let slot = _slot(_bytesHash(value), capacity);

  while ((_bytesSlots[slot] >= 0) && (_bytes[_bytesSlots[slot]] != value)) {
    slot = (slot + 1) % capacity;
  }

  slot
};

export let bytesId = fn(value: Bytes): I32 {
  if ((_bytes.len() + 1) * 2 > _bytesSlots.len()) { _growBytes(); }
  let slot = _bytesSlot(value);

  if (_bytesSlots[slot] < 0) {
    _bytesSlots[slot] = _bytes.len();
    _bytes.push(value);
  }

  _bytesSlots[slot]
};

export let findBytesId = fn(value: Bytes): I32 { _bytesSlots[_bytesSlot(value)] };

export let declareGlobal = fn(name: Bytes, ty: I32, mutable: Bool): I32 {
  let id = globalCount();
  _globals.push(ty);
  _globals.push(bytesId(name));
  _globals.push(mutable ? 1 : 0);
  id
};

export let declareNative = fn(library: Bytes, name: Bytes, ty: I32): I32 {
  let i = 0;

  while (i < nativeCount()) {
    if ((nativeLibraryOf(i) == library) && (nativeNameOf(i) == name)) {
      if (nativeTypeOf(i) != ty) {
        throw coded(E0213, `native ${library}.${name} is declared with two different types`);
      }

      return i;
    }
    i++;
  }

  _natives.push(bytesId(library));
  _natives.push(bytesId(name));
  _natives.push(ty);
  nativeCount() - 1
};

export let setSpan = fn(path: Bytes, start: I32, end: I32): Bool {
  if ((_spanPath < 0) || (_bytes[_spanPath] != path)) { _spanPath = bytesId(path); }
  _spanStart = start;
  _spanEnd = end;
  true
};

let _typeHash = fn(kind: Kind, value: I32, args: Array<I32>): I32 {
  let hash = _mix(_mix(-2128831035, _kindCode(kind)), value);
  let i = 0;

  while (i < args.len()) {
    hash = _mix(hash, args[i]);
    i++;
  }

  _mix(hash, args.len())
};

let _typeArgs = fn(ty: I32): Array<I32> {
  let args = Array.new<I32>(0);
  let i = 0;

  while (i < typeArgCount(ty)) {
    args.push(typeArg(ty, i));
    i++;
  }

  args
};

let _sameType = fn(ty: I32, kind: Kind, value: I32, args: Array<I32>): Bool {
  if (!isKind(ty, kind) || (innerOf(ty) != value) || (typeArgCount(ty) != args.len())) {
    return false;
  }

  let i = 0;

  while (i < args.len()) {
    if (typeArg(ty, i) != args[i]) { return false; }
    i++;
  }

  true
};

let _growTypes = fn() {
  let capacity = _typeSlots.len() * 2;
  _typeSlots = _emptySlots(capacity);
  let ty = 0;

  while (ty < typeCount()) {
    match (_kinds[ty]) {
      Enum, Record, Var, Param => null,
      _ => {
        let slot = _slot(_typeHash(_kinds[ty], innerOf(ty), _typeArgs(ty)), capacity);
        while (_typeSlots[slot] >= 0) { slot = (slot + 1) % capacity; }
        _typeSlots[slot] = ty;
        null
      },
    };
    ty++;
  }
  null
};

let _holdsInner = fn(kind: Kind): Bool {
  match (kind) { Array, List, Null, Function, Optional, Rest => true, _ => false }
};

let _addType = fn(kind: Kind, value: I32, args: Array<I32>): I32 {
  let id = typeCount();
  _kinds.push(kind);
  _types.push(value);
  _types.push(_typeEdges.len());
  _types.push(args.len());

  let inner = _holdsInner(kind) && (value >= 0);
  let open = match (kind) { Var => true, _ => inner && _open[value] };
  let parametric = match (kind) { Param => true, _ => inner && _parametric[value] };
  let i = 0;

  while (i < args.len()) {
    _typeEdges.push(args[i]);
    open = open || _open[args[i]];
    parametric = parametric || _parametric[args[i]];
    i++;
  }

  _open.push(open);
  _parametric.push(parametric);
  _generic.push(-1);
  id
};

let _intern = fn(kind: Kind, value: I32, args: Array<I32>): I32 {
  if ((typeCount() + 1) * 2 > _typeSlots.len()) { _growTypes(); }
  let capacity = _typeSlots.len();
  let slot = _slot(_typeHash(kind, value, args), capacity);

  while (_typeSlots[slot] >= 0) {
    if (_sameType(_typeSlots[slot], kind, value, args)) { return _typeSlots[slot]; }
    slot = (slot + 1) % capacity;
  }
  let id = _addType(kind, value, args);
  _typeSlots[slot] = id;
  id
};

export let arrayType = fn(element: I32): I32 { _intern(Kind.Array, element, []) };
export let listType = fn(element: I32): I32 { _intern(Kind.List, element, []) };

export let nullType = fn(ty: I32): I32 {
  let inner = _current(ty);

  if (isKind(inner, Kind.Param)) {
    _types[inner * _TYPE_WIDTH + 1] = _types[inner * _TYPE_WIDTH + 1] | _NULLED;
  }

  if (isKind(inner, Kind.List)) {
    throw coded(E0408, "a list cannot be null: its empty value is nil; test it with List.is_nil");
  }

  (isKind(inner, Kind.Null) || isKind(inner, Kind.Dynamic)) ? inner : _intern(Kind.Null, inner, [])
};
export let holdsNull = fn(ty: I32): Bool { isKind(ty, Kind.Null) || isKind(ty, Kind.Dynamic) };

export let isReference = fn(ty: I32): Bool {
  match (kindOf(ty)) {
    Bytes, ByteBuffer, Array, Tuple, Function, Enum, Applied, Record, Object => true,
    _ => false,
  }
};

export let readsExactly = fn(ty: I32): Bool {
  let inner = isKind(ty, Kind.Null) ? innerOf(ty) : ty;
  let scalar = match (kindOf(ty)) { Bool, Atom, I32, I64, F16, F32, F64 => true, _ => false };
  scalar || ((inner >= 0) && isReference(inner) && !isKind(inner, Kind.ByteBuffer))
};

export let readsTyped = fn(ty: I32): Bool {
  (ty == TYPE_DYNAMIC)
    || readsExactly(ty)
    || (isKind(ty, Kind.Null) && (innerOf(ty) >= 0) && readsExactly(innerOf(ty)))
};
export let tupleType = fn(elements: Array<I32>): I32 { _intern(Kind.Tuple, -1, elements) };

export let functionType = fn(params: Array<I32>, result: I32): I32 {
  _intern(Kind.Function, result, params)
};

export let optionalType = fn(ty: I32): I32 {
  nullType(ty);
  _intern(Kind.Optional, ty, [])
};

export let restType = fn(ty: I32): I32 {
  arrayType(ty);
  _intern(Kind.Rest, ty, [])
};

export let slotType = fn(ty: I32): I32 {
  match (_kinds[ty]) { Optional => nullType(innerOf(ty)), Rest => arrayType(innerOf(ty)), _ => ty }
};

let _NEVER_NULL = 1;
let _INTEGER = 3;

let _newVar = fn(flags: I32): I32 {
  let var = _addType(Kind.Var, -1, []);
  _types[var * _TYPE_WIDTH + 1] = flags;
  var
};
export let newVar = fn(neverNull: Bool): I32 { _newVar(neverNull ? _NEVER_NULL : 0) };
export let integerVar = fn(): I32 { _newVar(_INTEGER) };
let _flags = fn(ty: I32): I32 { _types[ty * _TYPE_WIDTH + 1] };

export let newParam = fn(name: Bytes, bounds: I32): I32 {
  let param = _addType(Kind.Param, bytesId(name), []);
  _types[param * _TYPE_WIDTH + 1] = bounds;
  param
};
export let hasBounds = fn(ty: I32, bounds: I32): Bool { (_flags(ty) & bounds) == bounds };
export let isNulled = fn(ty: I32): Bool { (_flags(ty) & _NULLED) != 0 };

let _follow = fn(ty: I32): I32 {
  let at = ty;
  while (isKind(at, Kind.Var) && (innerOf(at) >= 0)) { at = innerOf(at); }
  at
};

let _resolveArgs = fn(ty: I32): Array<I32> {
  let args = _typeArgs(ty);
  let i = 0;

  while (i < args.len()) {
    args[i] = resolve(args[i]);
    i++;
  }

  args
};

export let resolve = fn(ty: I32): I32 {
  if ((ty < 0) || !_open[ty]) { return ty; }

  match (_kinds[ty]) {
    Var => innerOf(ty) < 0 ? ty : resolve(innerOf(ty)),
    Array => arrayType(resolve(innerOf(ty))),
    List => listType(resolve(innerOf(ty))),
    Null => nullType(resolve(innerOf(ty))),
    Optional => optionalType(resolve(innerOf(ty))),
    Rest => restType(resolve(innerOf(ty))),
    Tuple => tupleType(_resolveArgs(ty)),
    Function => functionType(_resolveArgs(ty), resolve(innerOf(ty))),
    Applied => _applied(innerOf(ty), _resolveArgs(ty)),
    _ => ty,
  }
};

let _substituteArgs = fn(ty: I32, params: Array<I32>, types: Array<I32>): Array<I32> {
  let args = _typeArgs(ty);
  let i = 0;

  while (i < args.len()) {
    args[i] = _substitute(args[i], params, types);
    i++;
  }

  args
};

let _wrapped = fn(kind: Kind, inner: I32): I32 {
  match (kind) {
    Array => arrayType(inner),
    List => listType(inner),
    Null => nullType(inner),
    Optional => optionalType(inner),
    _ => restType(inner),
  }
};

let _substitute = fn(ty: I32, params: Array<I32>, types: Array<I32>): I32 {
  let at = _follow(ty);

  match (_kinds[at]) {
    Param => {
      let i = 0;
      while ((i < params.len()) && (params[i] != at)) { i++; }
      i < params.len() ? types[i] : at
    },
    Null when (innerOf(at) < 0) => at,
    Array, List, Null, Optional, Rest => {
      _wrapped(_kinds[at], _substitute(innerOf(at), params, types))
    },
    Tuple => tupleType(_substituteArgs(at, params, types)),
    Function => {
      functionType(_substituteArgs(at, params, types), _substitute(innerOf(at), params, types))
    },
    Applied => _applied(innerOf(at), _substituteArgs(at, params, types)),
    _ => at,
  }
};

export let substitute = fn(ty: I32, params: Array<I32>, types: Array<I32>): I32 {
  _substitute(ty, params, types)
};

export let isOpen = fn(ty: I32): Bool { (ty >= 0) && _open[ty] && _open[resolve(ty)] };
export let isParametric = fn(ty: I32): Bool { (ty >= 0) && _parametric[ty] };

let _trail = Array.new<I32>(0);

let _occurs = fn(var: I32, ty: I32): Bool {
  let at = _follow(ty);
  if (at == var) { return true; }
  if ((at < 0) || !_open[at]) { return false; }
  let found = _holdsInner(_kinds[at]) && _occurs(var, innerOf(at));
  let i = 0;

  while (!found && (i < typeArgCount(at))) {
    found = _occurs(var, typeArg(at, i));
    i++;
  }

  found
};

export let occursWithin = fn(var: I32, ty: I32): Bool {
  let unbound = _follow(var);
  let at = _follow(ty);
  (at != unbound) && _occurs(unbound, at)
};

let _bind = fn(var: I32, ty: I32): Bool {
  if (isKind(ty, Kind.Var) && (_flags(var) > _flags(ty))) {
    _types[ty * _TYPE_WIDTH] = var;
    _trail.push(ty);
    return true;
  }

  let integerOnly = (_flags(var) == _INTEGER) && !isKind(ty, Kind.Var) && !isIntegerType(ty);
  if (integerOnly && !(isKind(ty, Kind.Param) && hasBounds(ty, BOUND_INTEGER))) { return false; }

  let nullable = isKind(ty, Kind.Null) || isKind(ty, Kind.Dynamic) || isKind(ty, Kind.List);
  let neverNull = (_flags(var) & _NEVER_NULL) != 0;
  if ((ty == TYPE_NULL) || (neverNull && nullable) || _occurs(var, ty)) { return false; }

  _types[var * _TYPE_WIDTH] = ty;
  _trail.push(var);
  true
};

let _application = fn(ty: I32): I32 {
  match (_kinds[ty]) {
    Applied => ty,
    Enum, Record, Object when ((_generic[ty] >= 0) && isKind(_generic[ty], Kind.Applied)) => {
      _generic[ty]
    },
    _ => -1,
  }
};

export let templateOf = fn(ty: I32): I32 {
  let application = _application(ty);
  application < 0 ? -1 : innerOf(application)
};
export let templateArgs = fn(ty: I32): Array<I32> { _typeArgs(_application(ty)) };

let _unifyApplied = fn(left: I32, right: I32): Bool {
  let leftArgs = _application(left);
  let rightArgs = _application(right);

  if ((leftArgs < 0) || (rightArgs < 0) || (innerOf(leftArgs) != innerOf(rightArgs))) {
    return false;
  }

  let same = true;
  let i = 0;

  while (same && (i < typeArgCount(leftArgs))) {
    same = _unify(typeArg(leftArgs, i), typeArg(rightArgs, i));
    i++;
  }

  same
};

let _unify = fn(a: I32, b: I32): Bool {
  let left = _follow(a);
  let right = _follow(b);
  if (left == right) { return true; }
  if ((left < 0) || (right < 0)) { return false; }
  if (isKind(left, Kind.Var)) { return _bind(left, right); }
  if (isKind(right, Kind.Var)) { return _bind(right, left); }
  if (!_open[left] && !_open[right]) { return false; }

  if (isKind(left, Kind.Applied) || isKind(right, Kind.Applied)) {
    return _unifyApplied(left, right);
  }

  if ((_kinds[left] != _kinds[right]) || (typeArgCount(left) != typeArgCount(right))) {
    return false;
  }

  let same = !_holdsInner(_kinds[left]) || _unify(innerOf(left), innerOf(right));
  let i = 0;

  while (same && (i < typeArgCount(left))) {
    same = _unify(typeArg(left, i), typeArg(right, i));
    i++;
  }

  same
};

export let unify = fn(a: I32, b: I32): Bool {
  if ((a < 0) || (b < 0) || (!_open[a] && !_open[b])) { return a == b; }
  let same = _unify(a, b);

  if (!same) {
    while (_trail.len() > 0) { _types[_trail.pop() * _TYPE_WIDTH] = -1; }
  }

  Array.resize(_trail, 0);
  same
};

export let unifyResult = fn(result: I32, ty: I32): Bool {
  let at = _follow(result);
  if ((ty != TYPE_NULL) || !isKind(at, Kind.Var) || (_flags(at) != 0)) { return unify(result, ty); }
  _types[at * _TYPE_WIDTH] = ty;
  true
};

export let nullable = fn(ty: I32): I32 {
  let inner = _current(ty);
  if (!isKind(inner, Kind.Var) || ((_flags(inner) & _NEVER_NULL) != 0)) { return nullType(inner); }
  let bound = nullType(newVar(true));
  unify(inner, bound);
  bound
};

export let isUnknown = fn(ty: I32): Bool {
  let at = _current(ty);
  isKind(at, Kind.Var) && (_flags(at) != _INTEGER)
};

export let isInteger = fn(ty: I32): Bool {
  if (isIntegerType(ty)) { return true; }
  let at = _current(ty);
  isIntegerType(at)
    || (isKind(at, Kind.Var) && (_flags(at) == _INTEGER))
    || (isKind(at, Kind.Param) && hasBounds(at, BOUND_INTEGER))
};

export let holdsUnknown = fn(ty: I32): Bool {
  (ty >= 0) && _open[ty] && !isInteger(ty) && _open[resolve(ty)]
};

let _defaultIntegers = fn(ty: I32): Bool {
  let at = _follow(ty);
  if ((at < 0) || !_open[at]) { return true; }

  if (isKind(at, Kind.Var)) {
    if (_flags(at) == _INTEGER) { _types[at * _TYPE_WIDTH] = TYPE_I32; }
    return true;
  }

  if (_holdsInner(_kinds[at])) { _defaultIntegers(innerOf(at)); }
  let i = 0;

  while (i < typeArgCount(at)) {
    _defaultIntegers(typeArg(at, i));
    i++;
  }

  true
};

export let defaultIntegers = fn(ty: I32): I32 {
  if ((ty < 0) || !_open[ty]) { return ty; }
  _defaultIntegers(ty);
  resolve(ty)
};

export let openLiteral = fn(value: I64, var: I32): I32 { _wideNode(Op.I32, var, value) };
export let fitsI32 = fn(id: I32): Bool { auxOf(id) == (valueOf(id) >> 31) };

export let settleLiteral = fn(id: I32, ty: I32): Bool {
  let slot = id * _NODE_WIDTH;
  _nodes[slot] = ty;
  if ((ty == TYPE_I64) || (ty == TYPE_U64)) { _ops[id] = Op.I64; } else { _nodes[slot + 2] = 0; }
  true
};

export let settleConversion = fn(id: I32): Bool {
  if (typeOf(childOf(id, 0)) == typeOf(id)) {
    _ops[id] = Op.Block;
    _nodes[id * _NODE_WIDTH + 2] = 1;
  }

  true
};

export let resolveTypes = fn(): I32 {
  let open = -1;
  let id = 0;
  let count = nodeCount();

  while (id < count) {
    let slot = id * _NODE_WIDTH;
    let ty = _nodes[slot];

    if ((ty >= 0) && _open[ty]) {
      ty = resolve(ty);
      _nodes[slot] = ty;
      if ((open < 0) && _open[ty]) { open = id; }
    }

    id++;
  }

  let global = 0;

  while (global < globalCount()) {
    let slot = global * _GLOBAL_WIDTH;
    _globals[slot] = resolve(_globals[slot]);
    global++;
  }

  open
};

export let stdNative = fn(name: Bytes, params: Array<I32>, result: I32): I32 {
  declareNative("std", name, functionType(params, result))
};

export let callStd = fn(name: Bytes, params: Array<I32>, result: I32, args: Array<I32>): I32 {
  node(Op.CallNative, result, stdNative(name, params, result), 0, args)
};
export let declareEnum = fn(name: Bytes): I32 { _addType(Kind.Enum, bytesId(name), []) };
export let declareRecord = fn(name: Bytes): I32 { _addType(Kind.Record, bytesId(name), []) };
export let declarePrototype = fn(name: Bytes): I32 { _addType(Kind.Object, bytesId(name), []) };

let _pending = Array.new<I32>(0);
let _nesting = 0;
export let MAX_INSTANCE_DEPTH: I32 = 64;

export let nestsTooDeep = fn(name: Bytes): Bytes {
  coded(E0901, `instantiating ${name} nests more than ${MAX_INSTANCE_DEPTH} deep`)
};

let _makeGeneric = fn(ty: I32, params: Array<I32>): I32 {
  _generic[ty] = tupleType(params);
  ty
};

export let declareGenericEnum = fn(name: Bytes, params: Array<I32>): I32 {
  _makeGeneric(declareEnum(name), params)
};

export let declareGenericRecord = fn(name: Bytes, params: Array<I32>): I32 {
  _makeGeneric(declareRecord(name), params)
};

export let declareGenericPrototype = fn(name: Bytes, params: Array<I32>): I32 {
  _makeGeneric(declarePrototype(name), params)
};
let _layouts = Array.new<I32>(0);
let _layoutCodes = Array.new<Array<I32>>(0);
let _layoutOffsets = Array.new<Array<I32>>(0);
let _layoutBytes = Array.new<I32>(0);

export let declareLayout = fn(
  name: Bytes, codes: Array<I32>, offsets: Array<I32>, fixed: I32
): I32 {
  let ty = declareRecord(name);
  while (_layouts.len() <= ty) { _layouts.push(-1); }

  _layouts[ty] = _layoutCodes.len();
  _layoutCodes.push(codes);
  _layoutOffsets.push(offsets);
  _layoutBytes.push(fixed);
  ty
};

export let isLayout = fn(ty: I32): Bool {
  (ty >= 0) && (ty < _layouts.len()) && (_layouts[ty] >= 0)
};
export let layoutCodes = fn(ty: I32): Array<I32> { _layoutCodes[_layouts[ty]] };
export let layoutOffsets = fn(ty: I32): Array<I32> { _layoutOffsets[_layouts[ty]] };
export let layoutBytes = fn(ty: I32): I32 { _layoutBytes[_layouts[ty]] };

export let isTemplateEnum = fn(ty: I32): Bool {
  (ty >= 0) && (ty < _generic.len()) && (_generic[ty] >= 0) && isKind(_generic[ty], Kind.Tuple)
};

export let enumParams = fn(ty: I32): Array<I32> {
  isTemplateEnum(ty) ? _typeArgs(_generic[ty]) : Array.new<I32>(0)
};

export let enumParamCount = fn(ty: I32): I32 {
  isTemplateEnum(ty) ? typeArgCount(_generic[ty]) : 0
};
export let enumName = fn(ty: I32): Bytes { _bytes[innerOf(_shape(ty))] };

let _defineInstance = fn(ty: I32, application: I32) {
  let template = innerOf(application);
  if (_nesting >= MAX_INSTANCE_DEPTH) { throw nestsTooDeep(enumName(template)); }
  _nesting++;

  let params = enumParams(template);
  let args = _typeArgs(application);
  let names = Array.new<Bytes>(0);
  let fieldNames = Array.new<Array<Bytes>>(0);
  let fieldTypes = Array.new<Array<I32>>(0);
  let tag = 0;

  while (tag < variantCount(template)) {
    let variantNames = Array.new<Bytes>(0);
    let variantTypes = Array.new<I32>(0);
    let f = 0;

    while (f < fieldCount(template, tag)) {
      variantNames.push(fieldName(template, tag, f));
      variantTypes.push(_substitute(fieldType(template, tag, f), params, args));
      f++;
    }

    names.push(variantName(template, tag));
    fieldNames.push(variantNames);
    fieldTypes.push(variantTypes);
    tag++;
  }

  defineVariants(ty, names, fieldNames, fieldTypes);
  _nesting--;
  null
};

let _applied = fn(template: I32, args: Array<I32>): I32 {
  let concrete = true;
  let i = 0;

  while (concrete && (i < args.len())) {
    concrete = !_open[args[i]] && !_parametric[args[i]];
    i++;
  }

  let application = _intern(Kind.Applied, template, args);
  if (!concrete) { return application; }
  if (_generic[application] >= 0) { return _generic[application]; }
  let ty = _addType(_kinds[template], innerOf(template), []);
  _generic[application] = ty;
  _generic[ty] = application;
  if (variantCount(template) > 0) { _defineInstance(ty, application); } else { _pending.push(ty); }
  ty
};
export let appliedType = fn(template: I32, args: Array<I32>): I32 { _applied(template, args) };

let _appliedField = fn(ty: I32, declared: I32): I32 {
  _substitute(declared, enumParams(innerOf(ty)), _typeArgs(ty))
};

export let defineVariants = fn(
  ty: I32, names: Array<Bytes>, fieldNames: Array<Array<Bytes>>, fieldTypes: Array<Array<I32>>
): Bool {
  _types[ty * _TYPE_WIDTH + 1] = _variants.len() / _VARIANT_WIDTH;
  _types[ty * _TYPE_WIDTH + 2] = names.len();

  let tag = 0;

  while (tag < names.len()) {
    _variants.push(bytesId(names[tag]));
    _variants.push(_fields.len() / _FIELD_WIDTH);
    _variants.push(fieldNames[tag].len());

    let f = 0;

    while (f < fieldNames[tag].len()) {
      _fields.push(bytesId(fieldNames[tag][f]));
      _fields.push(fieldTypes[tag][f]);
      f++;
    }

    tag++;
  }

  if (isTemplateEnum(ty)) {
    let pending = _pending.len();
    let i = 0;

    while (i < pending) {
      let application = _generic[_pending[i]];
      if (innerOf(application) == ty) { _defineInstance(_pending[i], application); }
      i++;
    }
  }

  true
};

export let beginHir = fn(): Bool {
  _ops = Array.new<Op>(0);
  _nodes = Array.new<I32>(0);
  _edges = Array.new<I32>(0);
  _bytes = Array.new<Bytes>(0);
  _bytesSlots = _emptySlots(64);
  _kinds = Array.new<Kind>(0);
  _types = Array.new<I32>(0);
  _typeEdges = Array.new<I32>(0);
  _typeSlots = _emptySlots(64);
  _open = Array.new<Bool>(0);
  _checking = true;
  _trail = Array.new<I32>(0);
  _root = -1;
  _spans = Array.new<I32>(0);
  _globals = Array.new<I32>(0);
  _natives = Array.new<I32>(0);
  _variants = Array.new<I32>(0);
  _fields = Array.new<I32>(0);
  _spanPath = -1;
  _spanStart = -1;
  _spanEnd = -1;
  _parametric = Array.new<Bool>(0);
  _generic = Array.new<I32>(0);
  _pending = Array.new<I32>(0);
  _nesting = 0;
  _layouts = Array.new<I32>(0);
  _layoutCodes = Array.new<Array<I32>>(0);
  _layoutOffsets = Array.new<Array<I32>>(0);
  _layoutBytes = Array.new<I32>(0);

  _intern(Kind.Bool, 0, []);
  _intern(Kind.I32, 0, []);
  _intern(Kind.I64, 0, []);
  _intern(Kind.Bytes, 0, []);
  _intern(Kind.Null, -1, []);
  _intern(Kind.Dynamic, -1, []);
  _intern(Kind.ByteBuffer, 0, []);
  _intern(Kind.Atom, 0, []);
  _intern(Kind.I8, 0, []);
  _intern(Kind.I16, 0, []);
  _intern(Kind.U8, 0, []);
  _intern(Kind.U16, 0, []);
  _intern(Kind.U32, 0, []);
  _intern(Kind.U64, 0, []);
  _intern(Kind.F16, 0, []);
  _intern(Kind.F32, 0, []);
  _intern(Kind.F64, 0, []);
  _intern(Kind.Object, 0, []);
  true
};

export let finishHir = fn(root: I32): Hir {
  _root = root;
  _checking = false;
  {
    ops: _ops,
    nodes: _nodes,
    edges: _edges,
    bytes: _bytes,
    kinds: _kinds,
    types: _types,
    typeEdges: _typeEdges,
    root,
    spans: _spans,
    globals: _globals,
    natives: _natives,
    variants: _variants,
    fields: _fields
  }
};

let _source = true;

let _typeArgNames = fn(ty: I32, params: Bool): Bytes {
  let output = "";
  let count = typeArgCount(ty);
  let i = 0;

  while (i < count) {
    let arg = typeArg(ty, i);
    let inner = (params && (_kinds[arg] == Kind.Null)) ? innerOf(arg) : -1;
    if (i > 0) { output += ", "; }
    output += inner >= 0 ? `${_source ? "Null<" : "null<"}${_typeName(inner)}>` : _typeName(arg);
    i++;
  }

  output
};

let _nullableName = fn(inner: I32): Bytes {
  let name = _typeName(inner);
  (kindOf(inner) == Kind.Function) ? `?(${name})` : `?${name}`
};

let _typeName = fn(ty: I32): Bytes {
  match (kindOf(ty)) {
    Bool => _source ? "Bool" : "bool",
    I32 => _source ? "I32" : "i32",
    I64 => _source ? "I64" : "i64",
    Bytes => _source ? "Bytes" : "bytes",
    Atom => _source ? "Atom" : "atom",
    I8 => _source ? "I8" : "i8",
    I16 => _source ? "I16" : "i16",
    U8 => _source ? "U8" : "u8",
    U16 => _source ? "U16" : "u16",
    U32 => _source ? "U32" : "u32",
    U64 => _source ? "U64" : "u64",
    F16 => _source ? "F16" : "f16",
    F32 => _source ? "F32" : "f32",
    F64 => _source ? "F64" : "f64",
    Array => `${_source ? "Array<" : "array<"}${_typeName(innerOf(ty))}>`,
    List => `${_source ? "List<" : "list<"}${_typeName(innerOf(ty))}>`,
    Null => innerOf(ty) < 0 ? (_source ? "Null" : "null") : _nullableName(innerOf(ty)),
    Tuple => `${_source ? "Tuple<" : "tuple<"}${_typeArgNames(ty, false)}>`,
    Function => `(${_typeArgNames(ty, true)}) -> ${_typeName(innerOf(ty))}`,
    Optional => _nullableName(innerOf(ty)),
    Rest => `${_typeName(innerOf(ty))}...`,
    Enum, Applied, Record => {
      let application = _application(ty);
      application < 0 ? enumName(ty) : `${enumName(ty)}<${_typeArgNames(application, false)}>`
    },
    Dynamic => _source ? "Dynamic" : "dynamic",
    ByteBuffer => _source ? "ByteBuffer" : "bytebuffer",
    Object when (_application(ty) >= 0) => {
      `${_bytes[_types[ty * _TYPE_WIDTH]]}<${_typeArgNames(_application(ty), false)}>`
    },
    Object => ty != TYPE_OBJECT ? _bytes[_types[ty * _TYPE_WIDTH]] : _source ? "Object" : "object",
    Var => innerOf(ty) >= 0 ? _typeName(innerOf(ty))
      : _flags(ty) == _INTEGER ? _typeName(TYPE_I32)
      : _source ? "Unknown" : "unknown",
    Param => _bytes[innerOf(ty)],
  }
};

export let typeName = fn(ty: I32): Bytes {
  _source = true;
  _typeName(ty)
};

export let hirTypeName = fn(ty: I32): Bytes {
  _source = false;
  _typeName(ty)
};

export let typeArgNames = fn(ty: I32): Bytes {
  _source = true;
  _typeArgNames(ty, false)
};

export let local = fn(binding: I32, ty: I32): I32 { node(Op.Local, ty, binding, 0, []) };

export let bindingNode = fn(op: Op, binding: I32, name: Bytes, value: I32): I32 {
  node(op, typeOf(value), binding, bytesId(name), [value])
};

export let declareBinding = fn(op: Op, binding: I32, name: Bytes, value: I32): I32 {
  opNode(Op.Declare, 0, [bindingNode(op, binding, name, value)])
};
