package frontend.hir;

/** @file
 * Verifies a checked HIR program independently of the checker, before lowering. Every node's type
 * is recomputed from its operands and compared with the type the checker recorded; locals are in
 * scope where they are read; each global is initialised exactly once, in the program body; `break`,
 * `continue` and `return` appear only where they may; every node has a source span; and no type
 * the program uses still holds an inference `Var`, a type `Param` or an `Applied`. The nodes form
 * a tree in which a node references only earlier nodes, each at most once.
 * `semantics.Modules.typeCheckModules` runs it on every program it checks, and a failure is an
 * internal error (a compiler bug) that the driver locates with `verifyFailureSpan`. */

import type { Hir } from frontend.hir.Hir;
import type { SourceSpan } from frontend.syntax.Source;
import { internalError } from support.Internal;
import {
  KIND_ATOM, KIND_BOOL, KIND_BYTES, KIND_ENUM, KIND_FUNCTION, KIND_HANDLE, KIND_I32, KIND_I64,
  KIND_OBJECT, Kind, TYPE_ATOM, TYPE_BOOL, TYPE_BYTES, TYPE_BYTE_BUFFER, TYPE_DYNAMIC, TYPE_I32,
  TYPE_I64, TYPE_OBJECT, TYPE_U64, auxOf, bytesCount, bytesOf, childCount, childOf,
  childrenInBounds, endsPath, fieldCount, fieldType, globalCount, globalIsMutable, globalTypeOf,
  holdsNull, innerOf, integerBits, isFloatKind, isFloatType, isKind, isNumberType, isObject,
  isPrototype, kindOf, memberCount, memberType, nativeCount, nativeTypeOf, nodeCount, opOf,
  readsExactly, rootNode, segmentType, slotType, spanCount, spanEndOf, spanOf, spanPathOf,
  spanStartOf, typeArg, typeArgCount, typeCount, typeOf, useHir, valueOf, variantCount,
} from frontend.hir.Hir;

// Whether each node, by ID, has been claimed as a child.
let _used = Array.new<Bool>(0);
// The type of each function, by function ID minus 1.
let _functionTypes = Array.new<I32>(0);
/** The types of each function's captures, in order, by function ID minus 1; what a `FunctionRef`
 * to it must supply; -1 for a capture whose node reference is out of range. */
let _captureTypes = Array.new<Array<I32>>(0);
// The binding IDs in scope, innermost last.
let _visibleIds = Array.new<I32>(0);
// The type of each binding in `_visibleIds`.
let _visibleTypes = Array.new<I32>(0);
// Whether each binding in `_visibleIds` is mutable; true only for a `Let` or a `Capture`.
let _visibleMutable = Array.new<Bool>(0);
/** Whether each binding, by ID, has been declared anywhere in the program, since binding IDs are
 * unique across the whole program. */
let _declared = Array.new<Bool>(0);
// The index in `_visibleIds` of each binding, by ID, or -1 when it is not in scope.
let _places = Array.new<I32>(0);
/** Whether an `InitGlobal` has initialised each global, by global ID. The program body initialises
 * each global once, in whatever order its modules run their initialisers (a module's regexps
 * first); the verifier does not check that order, since `frontend.semantics.InitOrder` already
 * rejects a read before the write. */
let _initialized = Array.new<Bool>(0);
/** The result type of the function being checked, or -1 in the program body, where `return` is
 * invalid. */
let _result = -1;
// The number of loops enclosing the statement being checked.
let _loops = 0;

/** The node being checked, or -1. Each check of a node sets it on entry and restores it on exit, so
 * after a failure it is the node that failed. */
let _at = -1;

// Raises the internal error `invalid HIR: ` followed by `message`, which says what is wrong.
let _fail = fn(message: Bytes): Null { internalError(`invalid HIR: ${message}`) };

/** Claims child `index` of `parent`, failing unless it exists, is an earlier node than `parent` and
 * has not been claimed before.
 * @param parent  the parent node
 * @param index  the child's position
 * @return the child's node ID */
let _child = fn(parent: I32, index: I32): I32 {
  if (!childrenInBounds(parent) || (index < 0) || (index >= childCount(parent))) {
    _fail("missing operand");
  }

  let child = childOf(parent, index);
  if ((child < 0) || (child >= parent)) { _fail("node reference out of order"); }
  if (_used[child]) { _fail("node referenced twice"); }

  _used[child] = true;
  child
};

// Fails unless node `id` has exactly `count` children.
let _arity = fn(id: I32, count: I32) {
  if (childCount(id) != count) { _fail("wrong operand count"); }
  null
};

// Returns the number of fields of `ty`, a tuple or a record, or -1 when it is neither.
let _fieldCount = fn(ty: I32): I32 {
  (isKind(ty, Kind.Tuple) || isKind(ty, Kind.Record)) ? memberCount(ty) : -1
};

/** Describes what is wrong with node `id`'s span; a path that is not a non-empty bytes entry, or a
 * negative or empty range.
 * @param id  the node
 * @return the problem, or "" when the span names a non-empty range of a file */
let _spanProblem = fn(id: I32): Bytes {
  let path = spanPathOf(id);

  if ((path < 0) || (path >= bytesCount()) || (bytesOf(path).len() == 0)) {
    return "source span without a path";
  }

  let start = spanStartOf(id);
  (start < 0) || (spanEndOf(id) <= start) ? "empty source span" : ""
};

/** Checks that every node has a span naming a non-empty range of a source file, and that a child
 * from the same file lies inside its parent's range. */
let _spans = fn() {
  if (spanCount() != nodeCount()) { _fail("every node needs a source span"); }

  let id = 0;

  while (id < nodeCount()) {
    _at = id;
    let problem = _spanProblem(id);
    if (problem != "") { _fail(problem); }

    let path = spanPathOf(id);
    let i = 0;

    while (i < childCount(id)) {
      let child = childOf(id, i);
      let outside = (spanStartOf(child) < spanStartOf(id)) || (spanEndOf(child) > spanEndOf(id));
      if ((spanPathOf(child) == path) && outside) { _fail("child span outside its parent"); }
      i++;
    }

    id++;
  }

  _at = -1;
  null
};

// Pushes each of `ty`'s type arguments, in order, onto `reached`.
let _reachArgs = fn(ty: I32, reached: Array<I32>) {
  let i = 0;

  while (i < typeArgCount(ty)) {
    reached.push(typeArg(ty, i));
    i++;
  }

  null
};

/** Checks that no type the program uses holds a `Var`, a `Param` or an `Applied`, so the checker
 * inferred every type and instantiated every generic; the types of the nodes in the tree, of the
 * globals and natives, and every type they reach, enum fields included. Nodes outside the tree,
 * such as a generic function's checked body, are not used. One pass over the type table finds
 * what holds one through elements and arguments, which relies on a type's parts preceding it; a
 * worklist then follows enum fields, which may come later. */
let _closedTypes = fn() {
  let open = Array.new<Bool>(0);
  let seen = Array.new<Bool>(typeCount());
  let queued = Array.new<Bool>(typeCount());
  let ty = 0;

  while (ty < typeCount()) {
    let held = match (kindOf(ty)) {
      Var, Param, Applied => true,
      Array, List, Null, Function, Optional, Rest => (innerOf(ty) >= 0) && open[innerOf(ty)],
      _ => false,
    };

    // An enum's count is of its variants, not type arguments.
    let i = 0;
    let args = match (kindOf(ty)) { Tuple, Function => typeArgCount(ty), _ => 0 };

    while (i < args) {
      held = held || open[typeArg(ty, i)];
      i++;
    }

    open.push(held);
    ty++;
  }

  // Many nodes share a type, which is queued once.
  let reached = Array.new<I32>(0);
  let root = rootNode();
  let id = 0;
  let count = nodeCount();

  while (id < count) {
    let ty = typeOf(id);

    if ((ty >= 0) && (_used[id] || (id == root))) {
      _at = id;
      if (open[ty]) { _fail("a type is not inferred"); }

      if (!queued[ty]) {
        queued[ty] = true;
        reached.push(ty);
      }
    }

    id++;
  }

  _at = -1;
  let global = 0;

  while (global < globalCount()) {
    let ty = globalTypeOf(global);
    if (open[ty]) { _fail("a global's type is not inferred"); }
    reached.push(ty);
    global++;
  }

  let native = 0;

  while (native < nativeCount()) {
    let ty = nativeTypeOf(native);
    if (open[ty]) { _fail("a native's type is not inferred"); }
    reached.push(ty);
    native++;
  }

  let next = 0;

  while (next < reached.len()) {
    let ty = reached[next];
    next++;

    if ((ty >= 0) && !seen[ty]) {
      seen[ty] = true;

      match (kindOf(ty)) {
        Array, List, Null, Optional, Rest => reached.push(innerOf(ty)),
        Function => {
          reached.push(innerOf(ty));
          _reachArgs(ty, reached)
        },
        Tuple => _reachArgs(ty, reached),
        Enum, Record => {
          let tag = 0;

          while (tag < variantCount(ty)) {
            let field = 0;
            let fields = fieldCount(ty, tag);

            while (field < fields) {
              let fieldTy = fieldType(ty, tag, field);
              if (open[fieldTy]) { _fail("an enum's field type is not inferred"); }
              reached.push(fieldTy);
              field++;
            }

            tag++;
          }
        },
        _ => null,
      };
    }
  }

  null
};

// Returns the index in `_visibleIds` of local binding `id`, failing when it is not in scope.
let _visible = fn(id: I32): I32 {
  if ((id < 0) || (id >= _places.len()) || (_places[id] < 0)) { _fail("unknown local binding"); }
  _places[id]
};

/** Brings binding `id` into scope, failing when the ID is negative or already declared.
 * @param id  the binding ID
 * @param ty  the binding's type
 * @param mutable  whether it can be assigned */
let _declare = fn(id: I32, ty: I32, mutable: Bool) {
  if (id < 0) { _fail("negative binding ID"); }

  while (_declared.len() <= id) {
    _declared.push(false);
    _places.push(-1);
  }

  if (_declared[id]) { _fail("binding declared twice"); }
  _declared[id] = true;
  _places[id] = _visibleIds.len();
  _visibleIds.push(id);
  _visibleTypes.push(ty);
  _visibleMutable.push(mutable);
  null
};

// Takes out of scope every binding after the first `start` visible ones. They stay declared.
let _popTo = fn(start: I32) {
  while (_visibleIds.len() > start) {
    _places[_visibleIds[_visibleIds.len() - 1]] = -1;
    _visibleIds.pop();
    _visibleTypes.pop();
    _visibleMutable.pop();
  }

  null
};

/** Claims child `index` of `parent` and checks it as an expression.
 * @param parent  the parent node
 * @param index  the child's position
 * @return the child's type */
let _operand = fn(parent: I32, index: I32): I32 { _expr(_child(parent, index)) };

// Returns the type of global `id`, failing when there is no such global.
let _global = fn(id: I32): I32 {
  if ((id < 0) || (id >= globalCount())) { _fail("unknown global"); }
  globalTypeOf(id)
};

/** Checks binding `index` of `Declare` node `parent` and its value. A `Let` or `Const` declares a
 * local; an `InitGlobal` is allowed only in the program body and marks its global initialised.
 * @param parent  the `Declare` node
 * @param index  the binding's position
 * @param programBody  whether the declaration is a statement of the program body */
let _binding = fn(parent: I32, index: I32, programBody: Bool) {
  let binding = _child(parent, index);
  _arity(binding, 1);

  // A local function may capture its own binding, to call itself, so that is declared first.
  let local = match (opOf(binding)) { Let, Const => true, _ => false };
  let mutable = match (opOf(binding)) { Let => true, _ => false };
  let early = local && match (opOf(childOf(binding, 0))) { FunctionRef => true, _ => false };
  if (early) { _declare(valueOf(binding), typeOf(binding), mutable); }
  if (_operand(binding, 0) != typeOf(binding)) { _fail("binding type mismatch"); }

  match (opOf(binding)) {
    Let, Const when (early) => null,
    Let, Const => _declare(valueOf(binding), typeOf(binding), mutable),
    InitGlobal => {
      if (!programBody) { _fail("global initialized outside the program body"); }

      let global = valueOf(binding);
      let ty = _global(global);
      if (_initialized[global]) { _fail("global initialized twice"); }
      _initialized[global] = true;
      if (ty != typeOf(binding)) { _fail("global type mismatch"); }
      null
    },
    _ => _fail("expected binding"),
  };
  null
};

/** Returns the type of the function with function ID `functionId`, as `Call` and `FunctionRef`
 * hold it, failing when there is none. */
let _functionType = fn(functionId: I32): I32 {
  if ((functionId < 1) || (functionId > _functionTypes.len())) { _fail("unknown direct function"); }
  _functionTypes[functionId - 1]
};

/** Checks the children of `id` from `first` on as arguments against the parameters of
 * `functionType`, failing with `message` when it is not a function type or the count or a type
 * differs.
 * @param id  the call node
 * @param functionType  the callee's type
 * @param first  the index of the first argument
 * @param message  the failure message
 * @return the function's result type */
let _arguments = fn(id: I32, functionType: I32, first: I32, message: Bytes): I32 {
  let arity = childCount(id) - first;

  if (!isKind(functionType, Kind.Function) || (typeArgCount(functionType) != arity)) {
    _fail(message);
  }

  let i = 0;

  while (i < typeArgCount(functionType)) {
    if (_operand(id, first + i) != slotType(typeArg(functionType, i))) { _fail(message); }
    i++;
  }

  innerOf(functionType)
};

/** Returns the type of node `id`'s first operand without claiming it, or -1 when it has none; the
 * type predicates all answer false for -1, as they would for no operand at all. */
let _firstType = fn(id: I32): I32 { childCount(id) > 0 ? typeOf(childOf(id, 0)) : -1 };

/** Returns the type a bytes read requires of node `id`'s first operand; ByteBuffer when the operand
 * is one, otherwise Bytes, so any other operand fails the operand check. Reads the operand's type
 * without claiming it.
 * @param id  the reading node
 * @return `TYPE_BYTE_BUFFER` or `TYPE_BYTES` */
let _readable = fn(id: I32): I32 {
  _firstType(id) == TYPE_BYTE_BUFFER ? TYPE_BYTE_BUFFER : TYPE_BYTES
};

/** Fails with `what` when `ty` cannot be boxed as a Dynamic or thrown; a ByteBuffer, which leaves
 * its type only through a copying slice, or a list, whose nil would box as null.
 * @param ty  the value's type
 * @param what  the failure message */
let _boxable = fn(ty: I32, what: Bytes): Bool {
  if ((ty == TYPE_BYTE_BUFFER) || isKind(ty, Kind.List)) { _fail(what); }
  true
};

/** Checks whether the VM checks a Dynamic's value against `ty` exactly, so that it can be extracted
 * as one. */
let _extractable = fn(ty: I32): Bool {
  match (kindOf(ty)) {
    Bool, I32, I64, F16, F32, F64, Atom, Bytes, Enum, Object, Abstract => true,
    _ => false,
  }
};

// Checks whether a Convert of `source` to `ty` widens a prototype's Object.
let _upcast = fn(ty: I32, source: I32): Bool { isObject(ty) && isPrototype(source) };

// Checks that node `id` has `count` operands, the first an Object.
let _objectOperand = fn(id: I32, count: I32) {
  _arity(id, count);
  if (!isObject(_operand(id, 0))) { _fail("object operand type"); }
  null
};

/** Checks the ObjectGet, ObjectSet or ObjectHas node `id`; an Object, then the Atom key when its
 * value is -1, then `extra` more operands.
 * @return the type of its first extra operand, or Object when it has none */
let _objectAccess = fn(id: I32, extra: I32): I32 {
  let keyed = valueOf(id) < 0;
  if (!keyed && (valueOf(id) >= bytesCount())) { _fail("object key name index"); }

  _arity(id, (keyed ? 2 : 1) + extra);
  if (!isObject(_operand(id, 0))) { _fail("object access of a non-object"); }
  if (keyed && (_operand(id, 1) != TYPE_ATOM)) { _fail("object key type"); }
  extra > 0 ? _operand(id, keyed ? 2 : 1) : TYPE_OBJECT
};

/** Returns the type a number operation checks against; `ty` if it is an integer or float type,
 * otherwise I32.
 * @param ty  the type that sets the width */
let _width = fn(ty: I32): I32 { isNumberType(ty) ? ty : TYPE_I32 };

/** Checks node `id` as an operation on fixed operand types, failing with `message` when its arity
 * or an operand's type differs.
 * @param id  the node
 * @param operands  the operands' expected types, in order
 * @param result  the operation's result type
 * @param message  the failure message
 * @return `result` */
let _typed = fn(id: I32, operands: Array<I32>, result: I32, message: Bytes): I32 {
  _arity(id, operands.len());

  for (i, expected in operands) {
    if (_operand(id, i) != expected) { _fail(message); }
  }

  result
};

/** Checks that every operand of node `id` has type `ty`, failing with `message` at the first that
 * does not.
 * @param id  the node
 * @param ty  the operands' type
 * @param message  the failure message */
let _uniform = fn(id: I32, ty: I32, message: Bytes) {
  let i = 0;

  while (i < childCount(id)) {
    if (_operand(id, i) != ty) { _fail(message); }
    i++;
  }

  null
};

/** Checks `ArrayGet` (two operands) or `ArraySet` (three) node `id`; an array, an I32 index and,
 * for a set, a value of the element type.
 * @param id  the node
 * @param operands  the number of operands, 2 or 3
 * @return the array's element type */
let _array = fn(id: I32, operands: I32): I32 {
  _arity(id, operands);

  let array = _operand(id, 0);

  if (!isKind(array, Kind.Array) || (_operand(id, 1) != TYPE_I32)) {
    _fail("array access operand type");
  }

  if ((operands == 3) && (_operand(id, 2) != innerOf(array))) { _fail("array set value type"); }
  innerOf(array)
};

/** Checks a `Try` or `TryStatement`; its body block, then its handler block with the thrown value
 * bound as an immutable Dynamic when `valueOf(id)` is a binding. For a value try both blocks must
 * have the try's type.
 * @param id  the try node
 * @param value  whether it is a `Try` expression */
let _try = fn(id: I32, value: Bool) {
  _arity(id, 2);

  let ty = typeOf(id);
  let body = _block(_child(id, 0), false);
  let scope = _visibleIds.len();
  if (valueOf(id) >= 0) { _declare(valueOf(id), TYPE_DYNAMIC, false); }

  let handler = _block(_child(id, 1), false);
  _popTo(scope);
  if (value && ((body != ty) || (handler != ty))) { _fail("try operand type"); }
  null
};

/** Checks that node `id`'s immediate is a valid index into the bytes table, failing with `message`
 * when it is not. */
let _bytesIndex = fn(id: I32, message: Bytes) {
  if ((valueOf(id) < 0) || (valueOf(id) >= bytesCount())) { _fail(message); }
  null
};

/** Checks whether `code` is a kind an `IsKind` node may test; one of the scalar or reference kinds,
 * a float kind, or an enum kind whose auxiliary is an enum type.
 * @param code  the kind code
 * @param aux  the node's auxiliary, the enum type for `KIND_ENUM` */
let _knownKind = fn(code: I32, aux: I32): Bool {
  (code == KIND_BOOL) || (code == KIND_I32) || (code == KIND_BYTES) || (code == KIND_I64)
    || (code == KIND_ATOM) || (code == KIND_OBJECT) || (code == KIND_FUNCTION)
    || (code == KIND_HANDLE) || isFloatKind(code)
    || ((code == KIND_ENUM) && isKind(aux, Kind.Enum))
};

/** Checks expression node `id` and its operands, failing unless the type recomputed from them
 * equals the node's recorded type.
 * @param id  the expression node
 * @return the node's type */
let _expr = fn(id: I32): I32 {
  let outer = _at;
  _at = id;
  let ty = typeOf(id);

  let actual = match (opOf(id)) {
    Bool => {
      if ((valueOf(id) != 0) && (valueOf(id) != 1)) { _fail("bool literal"); }
      _typed(id, [], TYPE_BOOL, "")
    },
    I32 => _typed(id, [], integerBits(ty) == 64 ? TYPE_I32 : _width(ty), ""),
    I64 => _typed(id, [], ty == TYPE_U64 ? TYPE_U64 : TYPE_I64, ""),
    Float => {
      if (!isFloatType(ty)) { _fail("float literal type"); }
      _typed(id, [], ty, "")
    },
    Bytes => {
      _bytesIndex(id, "bytes index");
      _typed(id, [], TYPE_BYTES, "")
    },
    Null => {
      if (!holdsNull(ty)) { _fail("null literal type"); }
      _typed(id, [], ty, "")
    },
    Local => {
      _arity(id, 0);
      _visibleTypes[_visible(valueOf(id))]
    },
    Assign => {
      let found = _visible(valueOf(id));
      if (!_visibleMutable[found]) { _fail("assignment to immutable local"); }
      _typed(id, [_visibleTypes[found]], _visibleTypes[found], "assignment type mismatch")
    },
    Global => {
      _arity(id, 0);
      _global(valueOf(id))
    },
    SetGlobal => {
      let global = _global(valueOf(id));
      if (!globalIsMutable(valueOf(id))) { _fail("assignment to immutable global"); }
      _typed(id, [global], global, "global assignment type mismatch")
    },
    FunctionRef => {
      let function = _functionType(valueOf(id));
      let captures = _captureTypes[valueOf(id) - 1];
      _typed(id, captures, function, "closure capture type mismatch")
    },

    /* Number operations take one number type; the result's, or a comparison's first
     * operand's. A float has no remainder, shifts or bitwise operations. */
    Rem, Shl, Shr, BitAnd, BitOr, BitXor when (isFloatType(ty)) => {
      _fail("integer operation on a float");
      ty
    },
    Add, Sub, Mul, Div, Rem, Shl, Shr, BitAnd, BitOr, BitXor => {
      let width = _width(ty);
      _typed(id, [width, width], width, "number operation requires operands of its type")
    },
    Eq when (_firstType(id) == TYPE_BOOL) => {
      _typed(id, [TYPE_BOOL, TYPE_BOOL], TYPE_BOOL, "bool equality requires bool operands")
    },
    // Atoms, Objects and native handles compare by identity.
    Eq when ((_firstType(id) == TYPE_ATOM) || isObject(_firstType(id))
      || isKind(_firstType(id), Kind.Abstract)) => {
      let t = _firstType(id);
      _typed(id, [t, t], TYPE_BOOL, "identity equality requires operands of one type")
    },
    Eq when (isKind(_firstType(id), Kind.Function)) => {
      let f = _firstType(id);
      _typed(id, [f, f], TYPE_BOOL, "function equality requires operands of one function type")
    },
    Le, Ge when (!isFloatType(_firstType(id))) => {
      _fail("float comparison of no float");
      TYPE_BOOL
    },
    Eq, Lt, Gt, Le, Ge => {
      let width = _width(_firstType(id));
      let message = "number comparison requires operands of one number type";
      _typed(id, [width, width], TYPE_BOOL, message)
    },
    Neg => {
      let width = _width(ty);
      _typed(id, [width], width, "number negation requires an operand of its type")
    },
    Not => _typed(id, [TYPE_BOOL], TYPE_BOOL, "bool not requires bool operand"),
    And, Or => {
      _typed(id, [TYPE_BOOL, TYPE_BOOL], TYPE_BOOL, "logical operation requires bool operands")
    },

    Convert => {
      _arity(id, 1);
      let source = _operand(id, 0);

      // A prototype's Object, or a nullable one, widens to Object or a prototype it delegates to.
      let objects = (isKind(ty, Kind.Null) && isKind(source, Kind.Null))
        ? _upcast(innerOf(ty), innerOf(source))
        : _upcast(ty, source);
      if (!(isNumberType(ty) && isNumberType(source)) && !objects) { _fail("conversion type"); }
      ty
    },
    Present => {
      if (!isKind(ty, Kind.Null) || (innerOf(ty) < 0)) {
        _fail("present requires a nullable type");
      }

      _typed(id, [innerOf(ty)], ty, "present requires the inner type")
    },
    IsNull, IsPresent => {
      _arity(id, 1);
      if (!holdsNull(_operand(id, 0))) { _fail("null check requires a nullable operand"); }
      TYPE_BOOL
    },
    ToDynamic => {
      _arity(id, 1);
      _boxable(_operand(id, 0), "a ByteBuffer or list boxed");
      TYPE_DYNAMIC
    },
    FromDynamic => {
      if (!_extractable(ty)) { _fail("extraction from Dynamic to an unchecked type"); }
      _typed(id, [TYPE_DYNAMIC], ty, "extraction requires a Dynamic operand")
    },
    IsKind => {
      if (!_knownKind(valueOf(id), auxOf(id))) { _fail("kind test of an unknown kind"); }
      _typed(id, [TYPE_DYNAMIC], TYPE_BOOL, "kind test requires a Dynamic operand")
    },
    Unwrap => {
      _arity(id, 1);
      let operand = _operand(id, 0);

      if (!isKind(operand, Kind.Null) || (innerOf(operand) != ty)) {
        _fail("unwrap requires a Null<T> operand and a T result");
      }

      ty
    },

    ArrayNew => {
      if (!isKind(ty, Kind.Array)) { _fail("array type"); }
      _typed(id, [TYPE_I32], ty, "array length must be i32")
    },
    ArrayLiteral => {
      if (!isKind(ty, Kind.Array)) { _fail("array type"); }
      _uniform(id, innerOf(ty), "array element type");
      ty
    },
    ArrayConcat => {
      if (!isKind(ty, Kind.Array)) { _fail("array type"); }
      _typed(id, [ty, ty], ty, "array concat operand type")
    },
    ArrayPush => {
      _arity(id, 2);
      let array = _operand(id, 0);

      if (!isKind(array, Kind.Array) || (_operand(id, 1) != innerOf(array))) {
        _fail("array push operand type");
      }

      TYPE_I32
    },
    ArrayPop => {
      _arity(id, 1);
      let array = _operand(id, 0);
      if (!isKind(array, Kind.Array)) { _fail("array pop operand type"); }
      innerOf(array)
    },
    ArrayResize => {
      _arity(id, 2);
      let array = _operand(id, 0);

      if (!isKind(array, Kind.Array) || (_operand(id, 1) != TYPE_I32)) {
        _fail("array resize operand type");
      }

      array
    },
    ArrayLen => {
      _arity(id, 1);
      if (!isKind(_operand(id, 0), Kind.Array)) { _fail("array len source type"); }
      TYPE_I32
    },
    ArrayGet => _array(id, 2),
    ArraySet => _array(id, 3),

    ListNil, ListCons => {
      if (!isKind(ty, Kind.List)) { _fail("list type"); }
      let operands = match (opOf(id)) { ListNil => Array.new<I32>(0), _ => [innerOf(ty), ty] };
      _typed(id, operands, ty, "list operand type")
    },
    ListHead, ListTail, ListIsNil => {
      _arity(id, 1);
      let list = _operand(id, 0);
      if (!isKind(list, Kind.List)) { _fail("list operand type"); }
      match (opOf(id)) { ListHead => innerOf(list), ListTail => list, _ => TYPE_BOOL }
    },

    BytesNew => _typed(id, [TYPE_I32], TYPE_BYTE_BUFFER, "bytes new length type"),
    BytesSet => {
      let operands = [TYPE_BYTE_BUFFER, TYPE_I32, TYPE_I32];
      _typed(id, operands, TYPE_I32, "bytes set operand type")
    },
    BitsPack => {
      let i = 0;

      while (i < childCount(id)) {
        match (opOf(childOf(id, i))) { BitsField => null, _ => _fail("bits pack field") };
        _operand(id, i);
        i++;
      }

      TYPE_BYTES
    },
    BitsField => {
      let segment = segmentType(auxOf(id));
      _typed(id, [segment], segment, "bits field type")
    },
    BitsRead => _typed(id, [TYPE_BYTES], segmentType(auxOf(id)), "bits read operand type"),
    BytesLen => _typed(id, [_readable(id)], TYPE_I32, "bytes len operand type"),
    BytesSlice => {
      let operands = [_readable(id), TYPE_I32, TYPE_I32];
      _typed(id, operands, TYPE_BYTES, "bytes slice operand type")
    },
    BytesConcat => _typed(id, [TYPE_BYTES, TYPE_BYTES], TYPE_BYTES, "bytes concat operand type"),
    BytesConcatMany => {
      _uniform(id, TYPE_BYTES, "bytes concat many operand type");
      TYPE_BYTES
    },
    BytesJoin => {
      _arity(id, 2);
      let parts = _operand(id, 0);

      if (!isKind(parts, Kind.Array) || (innerOf(parts) != TYPE_BYTES)) {
        _fail("bytes join of an array that does not hold Bytes");
      }
      if (_operand(id, 1) != TYPE_BYTES) { _fail("bytes join separator type"); }
      TYPE_BYTES
    },
    BytesEq => _typed(id, [TYPE_BYTES, TYPE_BYTES], TYPE_BOOL, "bytes eq operand type"),
    BytesGet => _typed(id, [_readable(id), TYPE_I32], TYPE_I32, "bytes get operand type"),

    Tuple => {
      if (_fieldCount(ty) != childCount(id)) { _fail("tuple shape"); }

      let i = 0;

      while (i < childCount(id)) {
        if (_operand(id, i) != memberType(ty, i)) { _fail("tuple field type"); }
        i++;
      }

      ty
    },
    TupleField => {
      _arity(id, 1);
      let tuple = _operand(id, 0);
      if ((valueOf(id) < 0) || (valueOf(id) >= _fieldCount(tuple))) { _fail("tuple field access"); }
      memberType(tuple, valueOf(id))
    },
    SetField => {
      _arity(id, 2);
      let record = _operand(id, 0);
      let field = valueOf(id);

      if (!isKind(record, Kind.Record) || (field < 0) || (field >= _fieldCount(record))) {
        _fail("record field assignment");
      }

      if (_operand(id, 1) != memberType(record, field)) { _fail("record field type"); }
      memberType(record, field)
    },

    EnumNew => {
      let tag = valueOf(id);
      let variant = isKind(ty, Kind.Enum) && (tag >= 0) && (tag < variantCount(ty));
      if (!variant || (childCount(id) != fieldCount(ty, tag))) { _fail("enum construction shape"); }

      let i = 0;

      while (i < childCount(id)) {
        if (_operand(id, i) != fieldType(ty, tag, i)) { _fail("enum payload type"); }
        i++;
      }

      ty
    },
    EnumTag => {
      _arity(id, 1);
      if (!isKind(_operand(id, 0), Kind.Enum)) { _fail("enum tag source type"); }
      TYPE_I32
    },
    EnumField => {
      _arity(id, 1);
      let source = _operand(id, 0);
      let tag = auxOf(id);
      let field = valueOf(id);
      let inRange = isKind(source, Kind.Enum)
        && (tag >= 0) && (tag < variantCount(source))
        && (field >= 0) && (field < fieldCount(source, tag));
      if (!inRange) { _fail("enum field access"); }
      fieldType(source, tag, field)
    },

    Call => {
      let function = _functionType(valueOf(id));

      if (_captureTypes[valueOf(id) - 1].len() != 0) {
        _fail("direct call of a function that captures");
      }

      _arguments(id, function, 0, "direct call signature mismatch")
    },
    CallIndirect => _arguments(id, _operand(id, 0), 1, "indirect call signature mismatch"),
    CallNative => {
      if ((valueOf(id) < 0) || (valueOf(id) >= nativeCount())) { _fail("native call target"); }
      _arguments(id, nativeTypeOf(valueOf(id)), 0, "native call signature mismatch")
    },

    Block => {
      if ((auxOf(id) != 1) && !endsPath(id)) { _fail("value block without a tail"); }
      _block(id, false)
    },
    If => _typed(id, [TYPE_BOOL, ty, ty], ty, "if operand type"),
    Try => {
      _try(id, true);
      ty
    },

    Atom => {
      _bytesIndex(id, "atom name index");
      _typed(id, [], TYPE_ATOM, "")
    },
    ObjectNew => {
      _arity(id, 0);
      if (!isObject(ty)) { _fail("object type"); }
      ty
    },
    // A field is read as Dynamic or as a type the VM checks.
    ObjectGet => {
      _objectAccess(id, 0);
      if ((ty != TYPE_DYNAMIC) && !readsExactly(ty)) { _fail("object read as an unchecked type"); }
      ty
    },
    ObjectSet => {
      let value = _objectAccess(id, 1);
      _boxable(value, "a ByteBuffer or list stored in an object");
      value
    },
    ObjectHas => {
      _objectAccess(id, 0);
      TYPE_BOOL
    },
    ObjectRemove => {
      _objectOperand(id, 2);
      if (_operand(id, 1) != TYPE_ATOM) { _fail("object key type"); }
      TYPE_BOOL
    },
    ObjectClear, ObjectCopy => {
      _objectOperand(id, 1);
      TYPE_OBJECT
    },
    ObjectKeys => {
      if (!isKind(ty, Kind.Array) || (innerOf(ty) != TYPE_ATOM)) { _fail("object keys type"); }
      _objectOperand(id, 1);
      ty
    },

    _ => {
      _fail("expected expression");
      -1
    },
  };

  if (actual != ty) { _fail("expression type mismatch"); }
  _at = outer;
  ty
};

/** Checks the `else` branch of `IfStatement` node `id`, if it has one; a block or another
 * `IfStatement`. */
let _otherwise = fn(id: I32) {
  if (childCount(id) != 3) { return null; }

  let otherwise = _child(id, 2);

  match (opOf(otherwise)) {
    Block => {
      _block(otherwise, false);
      null
    },
    IfStatement => {
      _statement(otherwise, false);
      null
    },
    _ => _fail("else branch must be a block or if"),
  }
};

/** Checks statement node `id` and its operands. An `else` branch must be a block or an
 * `IfStatement`.
 * @param id  the statement node
 * @param programBody  whether it is a statement of the program body */
let _statement = fn(id: I32, programBody: Bool): Bool {
  let outer = _at;
  _at = id;

  match (opOf(id)) {
    Declare => {
      if (childCount(id) < 1) { _fail("declaration without a binding"); }

      let i = 0;

      while (i < childCount(id)) {
        _binding(id, i, programBody);
        i++;
      }

      null
    },
    Expression => {
      _arity(id, 1);
      _operand(id, 0);
      null
    },
    Block => {
      if (auxOf(id) != 0) { _fail("statement block with a tail"); }
      _block(id, false);
      null
    },
    Return => {
      if (_result < 0) { _fail("return outside a function"); }
      _typed(id, [_result], 0, "return type mismatch");
      null
    },
    Throw => {
      _arity(id, 1);
      _boxable(_operand(id, 0), "a ByteBuffer or list thrown");
      null
    },
    Break => {
      if (_loops == 0) { _fail("break outside loop"); }
      _arity(id, 0)
    },
    Continue => {
      if (_loops == 0) { _fail("continue outside loop"); }
      _arity(id, 0)
    },
    While => {
      let stepped = childCount(id) == 3;
      if (!stepped) { _arity(id, 2); }
      if ((auxOf(id) != 0) && (auxOf(id) != 1)) { _fail("loop body-first flag"); }
      if (stepped && (auxOf(id) != 0)) { _fail("a do loop has no step"); }
      if (_operand(id, 0) != TYPE_BOOL) { _fail("while condition must be bool"); }

      _loops++;
      _block(_child(id, 1), false);
      _loops--;
      if (stepped) { _block(_child(id, 2), false); }
      null
    },
    TryStatement => _try(id, false),
    IfStatement => {
      if ((childCount(id) != 2) && (childCount(id) != 3)) { _fail("wrong operand count"); }
      if (_operand(id, 0) != TYPE_BOOL) { _fail("if condition must be bool"); }
      _block(_child(id, 1), false);
      _otherwise(id)
    },
    _ => _fail("expected statement"),
  };

  _at = outer;
  true
};

/** Checks block `id`; its statements in a scope of their own, then its tail if `aux` is 1. Fails
 * when a statement follows one that ends every path, or when the computed type differs from the
 * block's.
 * @param id  the block node
 * @param programBody  whether it is the program body, whose statements may initialise globals
 * @return the tail's type, or 0 when the block has no tail */
let _block = fn(id: I32, programBody: Bool): I32 {
  let outer = _at;
  _at = id;
  match (opOf(id)) { Block => null, _ => _fail("expected block") };
  if ((auxOf(id) != 0) && (auxOf(id) != 1)) { _fail("block tail flag"); }

  let statements = childCount(id) - auxOf(id);
  let scope = _visibleIds.len();
  let i = 0;

  while (i < statements) {
    if ((i > 0) && endsPath(childOf(id, i - 1))) { _fail("statement after the end of every path"); }
    _statement(_child(id, i), programBody);
    i++;
  }

  let tail = auxOf(id) == 1 ? _operand(id, statements) : 0;
  _popTo(scope);

  // A value block that ends every path gives no value, so its type is its context's.
  let ty = (auxOf(id) == 0) && endsPath(id) ? typeOf(id) : tail;
  if (ty != typeOf(id)) { _fail("block type mismatch"); }
  _at = outer;
  ty
};

/** Checks `Function` node `id`; its `Parameter` children against its type's parameters, then its
 * `Capture` children against `_captureTypes`, then its body in a scope holding only those. A body
 * that can fall through must end in a tail of the result type.
 * @param id  the function node
 * @param functionId  its function ID */
let _function = fn(id: I32, functionId: I32) {
  let outer = _at;
  _at = id;
  let ty = typeOf(id);
  let params = typeArgCount(ty);
  let captures = _captureTypes[functionId - 1];
  if (childCount(id) != params + captures.len() + 1) { _fail("parameter count mismatch"); }

  _popTo(0);
  let i = 0;

  while (i < params + captures.len()) {
    let param = _child(id, i);

    let expected = match (opOf(param)) {
      Parameter when (i < params) => slotType(typeArg(ty, i)),
      Capture when (i >= params) => captures[i - params],
      _ => -1,
    };
    if (typeOf(param) != expected) { _fail("parameter type mismatch"); }
    _arity(param, 0);

    // A capture may be assigned; the local it copies shares the write.
    _declare(valueOf(param), expected, i >= params);
    i++;
  }

  _result = innerOf(ty);
  _loops = 0;
  let body = _child(id, childCount(id) - 1);
  let tail = _block(body, false);

  // A tail that runs is the result; one after the end of every path never runs.
  if (!endsPath(body)) {
    if (auxOf(body) != 1) { _fail("function falls through without value"); }
    if (tail != innerOf(ty)) { _fail("function result type mismatch"); }
  }

  _at = outer;
  null
};

/** Returns the types of the captures of `Function` node `function`, which follow its parameters
 * and precede its body; -1 for one whose node reference is out of range. */
let _capturesOf = fn(function: I32): Array<I32> {
  let captures = Array.new<I32>(0);
  let c = typeArgCount(typeOf(function));

  while (c < childCount(function) - 1) {
    let capture = childOf(function, c);
    captures.push((capture >= 0) && (capture < function) ? typeOf(capture) : -1);
    c++;
  }

  captures
};

/** Verifies `program` and makes it the current HIR. The `Program` node must be the last node, with
 * the functions as its children and then the body block, which must have a tail. A failure names
 * the first problem found, and `verifyFailureSpan` then locates it.
 * @throws an internal error at the first node that fails a check */
export let verifyHir = fn(program: Hir): Bool {
  useHir(program);
  _at = -1;
  let root = rootNode();
  let count = nodeCount();
  let isProgram = (root == count - 1) && (match (opOf(root)) { Program => true, _ => false });

  if (!isProgram || !childrenInBounds(root) || (childCount(root) < 1)) {
    _fail("program must be the last node");
  }

  _used = Array.new<Bool>(count);

  // Direct calls may reach any function, so collect their types first.
  _functionTypes = Array.new<I32>(0);
  _captureTypes = Array.new<Array<I32>>(0);
  let i = 0;

  while (i < childCount(root) - 1) {
    let function = childOf(root, i);
    let isFunction = (function >= 0) && (function < root)
      && (match (opOf(function)) { Function => true, _ => false });

    if (!isFunction || !isKind(typeOf(function), Kind.Function) || !childrenInBounds(function)) {
      _fail("expected function");
    }

    _functionTypes.push(typeOf(function));
    _captureTypes.push(_capturesOf(function));
    i++;
  }

  _visibleIds = Array.new<I32>(0);
  _visibleTypes = Array.new<I32>(0);
  _visibleMutable = Array.new<Bool>(0);
  _declared = Array.new<Bool>(0);
  _places = Array.new<I32>(0);
  _initialized = Array.new<Bool>(globalCount());
  i = 0;

  while (i < childCount(root) - 1) {
    _function(_child(root, i), i + 1);
    i++;
  }

  _popTo(0);
  let body = _child(root, childCount(root) - 1);
  match (opOf(body)) { Block => null, _ => _fail("program body must be a block") };
  if (auxOf(body) != 1) { _fail("program body without a tail"); }

  _result = -1;
  _loops = 0;
  _block(body, true);

  for (initialized in _initialized) {
    if (!initialized) { _fail("global never initialized"); }
  }

  _spans();
  _closedTypes();
  true
};

/** Returns where the last verification failed, for the driver's diagnostic.
 * @return the span of the node it failed at, or null when it failed outside a node or at a node
 *   whose span is itself invalid */
export let verifyFailureSpan = fn(): ?SourceSpan {
  let valid = (_at >= 0) && (_at < spanCount()) && (_spanProblem(_at) == "");
  valid ? spanOf(_at) : null
};
