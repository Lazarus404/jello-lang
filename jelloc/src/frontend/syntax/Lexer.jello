package frontend.syntax;

/** @file
 * The lexer, where the pipeline begins; it turns a source file's bytes into the token array
 * that `Parser.parseProgram` reads, with each token's start and end byte offsets. It rejects
 * invalid UTF-8, skips whitespace and comments, decodes the escapes in bytes literals and
 * templates, and reports every error as a located diagnostic. A template's holes are lexed as
 * ordinary tokens between the texts around them. It scans by position, so lexing is linear in
 * the source's length. */

import type { FloatSize, IntSize } from frontend.syntax.Ast;
import { sourceDiagnostic, utf8CharLength } from frontend.syntax.Source;
import { E0001, E0002, E0003, E0004, E0005, E0006, coded } from support.Codes;
import { hexValue } from support.Text;
import { u8, utf8FromCodepoint, utf8Validate } from std.core.Bytes;

/** A lexical token. Keywords and punctuation carry no payload; `EnumDecl` is `enum`,
 * `ListLiteral` is `list`, `And` is `&&` and `PipePipe` is `||`. A token array ends with `Eof`. */
export enum Token {
  // A bytes literal, its escapes decoded.
  BytesLiteral(value: Bytes);
  // A float constant, its text without the suffix.
  FloatConstant(literal: Bytes, size: FloatSize);
  Ident(name: Bytes);
  /** An integer constant, its text without the suffix, keeping any `0x`, `0b` or `0o` prefix and
   * `_` separators. */
  IntegerConstant(digits: Bytes, size: IntSize);
  // A regexp literal, `~r/pattern/flags`, its pattern keeping its escapes.
  RegExpLiteral(pattern: Bytes, flags: Bytes);
  /** A template's text from its opening backtick to its first hole's `${`, its escapes decoded. A
   * template without holes is a `BytesLiteral`. */
  TemplateHead(text: Bytes);
  // A template's text from a hole's closing `}` to the next hole's `${`.
  TemplateMiddle(text: Bytes);
  // A template's text from its last hole's closing `}` to its closing backtick.
  TemplateTail(text: Bytes);

  As;
  Await;
  Bits;
  Break;
  Catch;
  Const;
  Continue;
  Do;
  Else;
  EnumDecl;
  Export;
  False;
  Fn;
  For;
  From;
  If;
  Import;
  Is;
  Let;
  ListLiteral;
  Load;
  Macro;
  Match;
  New;
  Null;
  Package;
  Prototype;
  Return;
  Super;
  This;
  Throw;
  True;
  Try;
  Type;
  Typedef;
  When;
  While;
  With;

  LBrace;
  LBracket;
  LParen;
  RBrace;
  RBracket;
  RParen;
  Colon;
  Comma;
  Dot;
  DotDotDot;
  Question;
  QuestionQuestion;
  Semicolon;

  Ampersand;
  AmpersandEqual;
  And;
  Arrow;
  Caret;
  CaretEqual;
  Equal;
  EqualEqual;
  FatArrow;
  Greater;
  GreaterEqual;
  GreaterGreater;
  GreaterGreaterEqual;
  Less;
  LessEqual;
  LessLess;
  LessLessEqual;
  LessMinus;
  Minus;
  MinusEqual;
  MinusMinus;
  Not;
  NotEqual;
  Percent;
  PercentEqual;
  Pipe;
  PipeEqual;
  PipeGreater;
  PipePipe;
  Plus;
  PlusEqual;
  PlusPlus;
  Slash;
  SlashEqual;
  Star;
  StarEqual;

  Eof;
};

/** Returns the byte of `src` at `i`.
 * @return the byte, or -1 if `i` is out of range */
let _byteAt = fn(src: Bytes, i: I32): I32 {
  ((i < 0) || (i >= src.len())) ? -1 : Bytes.get_u8(src, i)
};

/** Checks whether `c`, a byte or -1, is whitespace as the regexp `\s` defines it; space, tab,
 * newline, vertical tab, form feed or carriage return. */
let _isSpace = fn(c: I32): Bool {
  (c == " ".code) || ((c >= "\t".code) && (c <= "\r".code))
};

// Checks whether `c`, a byte or -1, is an ASCII decimal digit.
let _isDigit = fn(c: I32): Bool {
  (c >= "0".code) && (c <= "9".code)
};

/** Returns the end of the run of decimal digits that starts at `i` in `src`.
 * @return the position after the last digit, or `i` if there is none */
let _digitsEnd = fn(src: Bytes, i: I32): I32 {
  let end = i;
  while (_isDigit(_byteAt(src, end))) { end++; }
  end
};

// Checks whether `src` holds `text` at `i`.
let _startsAt = fn(src: Bytes, i: I32, text: Bytes): Bool {
  let k = 0;
  while ((k < text.len()) && (_byteAt(src, i + k) == Bytes.get_u8(text, k))) { k++; }
  k == text.len()
};

/** Finds the next occurrence of `text` in `src` at or after `i`.
 * @return the occurrence's position, or -1 if there is none */
let _find = fn(src: Bytes, text: Bytes, i: I32): I32 {
  let at = i;
  while ((at + text.len() <= src.len()) && !_startsAt(src, at, text)) { at++; }
  (at + text.len() <= src.len()) ? at : -1
};

/** Skips whitespace and comments. A line comment starts with `#` or `//` and runs to the
 * newline. A block comment runs from slash-star to the next star-slash after it, so a slash, star
 * and slash only open one. Block comments do not nest. An unterminated block comment is left in
 * place for `_lexOne` to report where it starts.
 * @param at  where scanning starts
 * @return the position of the next token, or the end of `src` */
let _skipSpace = fn(src: Bytes, at: I32): I32 {
  let pos = at;
  let cont = true;

  while (cont) {
    let c = _byteAt(src, pos);
    let next = pos;

    if (_isSpace(c)) {
      while (_isSpace(_byteAt(src, next))) { next++; }
    } else if ((c == "#".code) || ((c == "/".code) && (_byteAt(src, pos + 1) == "/".code))) {
      while ((next < src.len()) && (Bytes.get_u8(src, next) != "\n".code)) { next++; }
    } else if ((c == "/".code) && (_byteAt(src, pos + 1) == "*".code)) {
      let close = _find(src, "*/", pos + 2);
      if (close >= 0) { next = close + 2; }
    }
    cont = next != pos;
    pos = next;
  }
  pos
};

/** Returns the keyword token that `word` spells, or an identifier.
 * @param word  a word of letters, digits and `_`
 * @return the keyword's token, or `Ident(word)` */
let _keywordToken = fn(word: Bytes): Token {
  match (word) {
    "as" => Token.As,
    "await" => Token.Await,
    "bits" => Token.Bits,
    "break" => Token.Break,
    "catch" => Token.Catch,
    "const" => Token.Const,
    "continue" => Token.Continue,
    "do" => Token.Do,
    "else" => Token.Else,
    "enum" => Token.EnumDecl,
    "export" => Token.Export,
    "false" => Token.False,
    "fn" => Token.Fn,
    "for" => Token.For,
    "from" => Token.From,
    "if" => Token.If,
    "import" => Token.Import,
    "is" => Token.Is,
    "let" => Token.Let,
    "list" => Token.ListLiteral,
    "load" => Token.Load,
    "macro" => Token.Macro,
    "match" => Token.Match,
    "new" => Token.New,
    "null" => Token.Null,
    "package" => Token.Package,
    "prototype" => Token.Prototype,
    "return" => Token.Return,
    "super" => Token.Super,
    "this" => Token.This,
    "throw" => Token.Throw,
    "true" => Token.True,
    "try" => Token.Try,
    "type" => Token.Type,
    "typedef" => Token.Typedef,
    "when" => Token.When,
    "while" => Token.While,
    "with" => Token.With,
    _ => Token.Ident(word),
  }
};

// Checks whether `c`, a byte or -1, may continue a word; an ASCII letter, digit or `_`.
let _isWordChar = fn(c: I32): Bool {
  ((c >= "0".code) && (c <= "9".code))
    || ((c >= "A".code) && (c <= "Z".code))
    || ((c >= "a".code) && (c <= "z".code))
    || (c == "_".code)
};

/** Returns the integer size an integer suffix names.
 * @param suffix  the suffix, such as `i64`, or ""
 * @return the size, or `Infer` for "" */
let _integerSize = fn(suffix: Bytes): IntSize {
  match (suffix) {
    "i8" => IntSize.I8,
    "i16" => IntSize.I16,
    "i32" => IntSize.I32,
    "i64" => IntSize.I64,
    "u8" => IntSize.U8,
    "u16" => IntSize.U16,
    "u32" => IntSize.U32,
    "u64" => IntSize.U64,
    _ => IntSize.Infer,
  }
};

/** Returns the float size a float suffix names.
 * @param suffix  the suffix, such as `f32`, or ""
 * @return the size, or `Infer` for "" */
let _floatSize = fn(suffix: Bytes): FloatSize {
  match (suffix) {
    "f16" => FloatSize.F16,
    "f32" => FloatSize.F32,
    "f64" => FloatSize.F64,
    _ => FloatSize.Infer,
  }
};

/** Returns the byte that a single-character escape stands for; `\0`, `\a`, `\b`, `\f`, `\n`,
 * `\r`, `\t`, `\v`, or a quote, backslash or backtick escaped as itself.
 * @param c  the byte after the backslash
 * @return the escaped byte, or -1 if `c` does not form such an escape */
let _escapeByte = fn(c: I32): I32 {
  match (c) {
    "0".code => 0,
    "a".code => 7,
    "b".code => 8,
    "f".code => 12,
    "n".code => "\n".code,
    "r".code => "\r".code,
    "t".code => "\t".code,
    "v".code => 11,
    "'".code,
    "\"".code,
    "\\".code,
    "`".code => c,
    _ => -1,
  }
};

/** Returns the length of a suffix width at `i`; 16, 32 or 64, and 8 too when `eight` is set.
 * @param i  where the width's digits start
 * @param eight  whether 8 is allowed, as it is for integers
 * @return 1 or 2, or 0 if no allowed width is there */
let _widthLength = fn(src: Bytes, i: I32, eight: Bool): I32 {
  let a = _byteAt(src, i);
  let b = _byteAt(src, i + 1);
  if (eight && (a == "8".code)) { return 1; }
  let wide = ((a == "1".code) && (b == "6".code))
    || ((a == "3".code) && (b == "2".code))
    || ((a == "6".code) && (b == "4".code));
  wide ? 2 : 0
};

/** Returns the integer suffix at `i`; `i` or `u` followed by 8, 16, 32 or 64.
 * @param i  where the suffix would start
 * @return the suffix, or "" if there is none */
let _integerSuffix = fn(src: Bytes, i: I32): Bytes {
  let c = _byteAt(src, i);
  let width = ((c == "i".code) || (c == "u".code)) ? _widthLength(src, i + 1, true) : 0;
  Bytes.slice(src, i, (width > 0) ? width + 1 : 0)
};

/** Returns the float suffix at `i`; `f16`, `f32` or `f64`.
 * @param i  where the suffix would start
 * @return the suffix, or "" if there is none */
let _floatSuffix = fn(src: Bytes, i: I32): Bytes {
  let width = (_byteAt(src, i) == "f".code) ? _widthLength(src, i + 1, false) : 0;
  Bytes.slice(src, i, (width > 0) ? width + 1 : 0)
};

/** Checks whether the dot at `dot` starts a member, as in `16.le`; a word byte other than a
 * digit follows it, and no float suffix, as in `1.f32`. */
let _dotStartsMember = fn(src: Bytes, dot: I32): Bool {
  let next = _byteAt(src, dot + 1);
  _isWordChar(next) && !_isDigit(next) && (_floatSuffix(src, dot + 1).len() == 0)
};

/** Rejects a constant that runs straight into a word byte or a dot, such as `12ab` or `1.5.2`,
 * unless the dot starts a member.
 * @param start  where the constant starts
 * @param end  the position after the constant and its suffix
 * @throws an "invalid constant" error, naming the whole run of word bytes and dots from `start`,
 *   if the byte at `end` is a word byte, or a dot that does not start a member */
let _checkConstantEnd = fn(src: Bytes, start: I32, end: I32) {
  let c = _byteAt(src, end);

  if (_isWordChar(c) || ((c == ".".code) && !_dotStartsMember(src, end))) {
    let stop = end;

    let more = fn(at: I32): Bool {
      _isWordChar(_byteAt(src, at))
        || ((_byteAt(src, at) == ".".code) && _isWordChar(_byteAt(src, at + 1)))
    };
    while (more(stop)) { stop++; }
    throw coded(E0003, `invalid constant: ${Bytes.slice(src, start, stop - start)}`);
  }
  null
};

/** Lexes the suffix after an integer's digits. An integer suffix makes an `IntegerConstant` of
 * that size, and a float suffix, as in `1f32`, makes a `FloatConstant`.
 * @param digits  the integer's text
 * @param i  the position after the digits
 * @return the token and the position after it
 * @throws an "invalid constant" error if the constant runs into a word byte or a dot */
let _lexConstant = fn(src: Bytes, digits: Bytes, i: I32): Tuple<Token, I32> {
  let integer = _integerSuffix(src, i);
  let float = (integer.len() > 0) ? "" : _floatSuffix(src, i);
  // With no suffix at all, the integer's size is inferred.
  let token = (float.len() > 0)
    ? Token.FloatConstant(digits, _floatSize(float))
    : Token.IntegerConstant(digits, _integerSize(integer));
  let end = i + integer.len() + float.len();
  _checkConstantEnd(src, i - digits.len(), end);
  (token, end)
};

/** Finds the end of a `0x`, `0b` or `0o` integer (the prefix letter in either case) whose `0`
 * is at `i`. Its digits may be separated by `_`; the run may also be empty, which `_lexRadix`
 * rejects.
 * @param i  the position of the `0`
 * @return the position after the digits, or -1 if no radix prefix is at `i` */
let _radixEnd = fn(src: Bytes, i: I32): I32 {
  let kind = _byteAt(src, i + 1);
  let hex = (kind == "x".code) || (kind == "X".code);
  let binary = (kind == "b".code) || (kind == "B".code);
  let octal = (kind == "o".code) || (kind == "O".code);
  if ((_byteAt(src, i) != "0".code) || !(hex || binary || octal)) { return -1; }

  let end = i + 2;
  let more = true;

  while (more) {
    let c = _byteAt(src, end);
    more = (c == "_".code)
      || (hex && (hexValue(c) >= 0))
      || (binary && ((c == "0".code) || (c == "1".code)))
      || (octal && (c >= "0".code) && (c <= "7".code));
    if (more) { end++; }
  }
  end
};

/** Lexes a radix integer and any integer suffix after it.
 * @param i  the position of its `0`
 * @param end  the position after its digits, from `_radixEnd`
 * @return the `IntegerConstant` and the position after it
 * @throws an "invalid integer literal" error if it has no digits or has a float suffix, and an
 * "invalid constant" error if it runs into a word byte or a dot */
let _lexRadix = fn(src: Bytes, i: I32, end: I32): Tuple<Token, I32> {
  let text = Bytes.slice(src, i, end - i);
  let digits = 0;
  let k = 2;

  while (k < text.len()) {
    if (_byteAt(text, k) != "_".code) { digits++; }
    k++;
  }
  if (digits == 0) { throw coded(E0003, `invalid integer literal: ${text}`); }

  let (token, cur) = _lexConstant(src, text, end);

  match (token) {
    IntegerConstant(_, _) => (token, cur),
    _ => { throw coded(E0003, `invalid integer literal: ${text}`); },
  }
};

/** Finds the end of an exponent, `[Ee][+-]?[0-9]+`, at `i`.
 * @param i  where the `e` would be
 * @return the position after its digits, or -1 if there is no exponent */
let _exponentEnd = fn(src: Bytes, i: I32): I32 {
  let e = _byteAt(src, i);
  let sign = _byteAt(src, i + 1);
  let digits = ((sign == "+".code) || (sign == "-".code)) ? i + 2 : i + 1;
  let end = _digitsEnd(src, digits);
  (((e == "e".code) || (e == "E".code)) && (end > digits)) ? end : -1
};

/** Finds the end of a float at `i`, matching the regexp
 * `([0-9]*\.[0-9]+|[0-9]+\.?)[Ee][+-]?[0-9]+|[0-9]*\.[0-9]+|[0-9]+\.` and trying its
 * alternatives in order. So `1.`, `.5` and `1e3` are floats, and a plain run of digits is not;
 * nor is `16.` before a word byte, so that `16.le` is a member of 16, as a bits segment's byte
 * order is written.
 * @param i  where the float would start
 * @return the position after it, or -1 if no float starts at `i` */
let _floatEnd = fn(src: Bytes, i: I32): I32 {
  let whole = _digitsEnd(src, i);
  let dot = _byteAt(src, whole) == ".".code;
  let fraction = dot ? _digitsEnd(src, whole + 1) : whole;
  let hasFraction = dot && (fraction > whole + 1);
  let hasWhole = whole > i;
  let pointExponent = hasFraction ? _exponentEnd(src, fraction) : -1;
  let wholeExponent = hasWhole ? _exponentEnd(src, dot ? whole + 1 : whole) : -1;
  if (pointExponent >= 0) { return pointExponent; }
  if (wholeExponent >= 0) { return wholeExponent; }
  if (hasFraction) { return fraction; }
  (hasWhole && dot && !_dotStartsMember(src, whole)) ? whole + 1 : -1
};

/** Lexes a float and any float suffix after it.
 * @param i  where the float starts
 * @param end  the position after it, from `_floatEnd`
 * @return the `FloatConstant` and the position after it
 * @throws an "invalid constant" error if it runs into a word byte or a dot */
let _lexFloat = fn(src: Bytes, i: I32, end: I32): Tuple<Token, I32> {
  let lit = Bytes.slice(src, i, end - i);
  let suffix = _floatSuffix(src, end);
  let cur = end + suffix.len();
  _checkConstantEnd(src, i, cur);
  (Token.FloatConstant(lit, _floatSize(suffix)), cur)
};

/** The position an error being thrown should point at, when that is not the start of its token;
 * -1 otherwise. `lexFile` reads and resets it. */
let _failAt = -1;

/** A template hole being lexed; `depth` is the braces that were open in the hole around it when
 * it opened, or -1 if it is in none, and `tick` its template's opening backtick. */
typedef Hole = {
  let depth: I32;
  let tick: I32;
};

// The template holes `lexFile` is inside, innermost last.
let _holes = Array.new<Hole>(0);

/** Reads the hex digits of a `\u` escape; exactly four, or one to six between braces, as in
 * `\u{1F600}`. Rejects surrogates and values past U+10FFFF.
 * @param at  the position after the `u`
 * @return the code point, or -1 if the escape is invalid, and the position after the escape */
let _unicodeEscape = fn(src: Bytes, at: I32): Tuple<I32, I32> {
  let braced = _byteAt(src, at) == "{".code;
  let i = braced ? at + 1 : at;
  let limit = braced ? 6 : 4;
  let digits = 0;
  let cp = 0;
  let reading = true;

  while (reading) {
    let c = _byteAt(src, i);
    reading = braced ? (c != "}".code) : (digits < limit);

    if (reading) {
      let h = hexValue(c);
      if ((h < 0) || (digits >= limit)) { return (-1, i); }
      cp = cp * 16 + h;
      digits++;
      i++;
    }
  }

  if ((digits == 0)
    || (cp > 1114111)
    || ((cp >= 55296) && (cp <= 57343))
    || (braced && (_byteAt(src, i) != "}".code))) {
    return (-1, i);
  }
  let end = braced ? i + 1 : i;
  (cp, end)
};

/** Decodes the escape whose backslash is at `i`, followed by `esc`, onto `out`. A `\xHH` escape
 * gives any byte, so the value need not be UTF-8; a `\u` escape gives a code point's UTF-8
 * encoding.
 * @return the position after the escape, or -1 if `esc` starts none
 * @throws an "invalid unicode escape" or "invalid hex escape" error located at the backslash */
let _escape = fn(src: Bytes, i: I32, esc: I32, out: Array<Bytes>): I32 {
  if (esc == "u".code) {
    let (cp, end) = _unicodeEscape(src, i + 2);

    if (cp < 0) {
      _failAt = i;
      throw coded(E0004, "invalid unicode escape");
    }
    out.push(utf8FromCodepoint(cp));
    return end;
  }

  if (esc == "x".code) {
    let hi = hexValue(_byteAt(src, i + 2));
    let lo = hexValue(_byteAt(src, i + 3));

    if ((hi < 0) || (lo < 0)) {
      _failAt = i;
      throw coded(E0004, "invalid hex escape");
    }
    out.push(u8(hi * 16 + lo));
    return i + 4;
  }
  let byte = _escapeByte(esc);
  if (byte < 0) { return -1; }
  out.push(u8(byte));
  i + 2
};

// Throws the error for the unknown escape whose backslash is at `i`, located there.
let _unknownEscape = fn(src: Bytes, i: I32) {
  _failAt = i;
  throw coded(E0004, `unknown escape \\${Bytes.slice(src, i + 1, utf8CharLength(src, i + 1))}`);
};

/** Lexes a bytes literal delimited by `"` or `'`, which must end on the line it starts. Runs
 * without escapes are copied whole and joined once at the end.
 * @param at  the position of the opening delimiter
 * @return the `BytesLiteral` and the position after the closing delimiter
 * @throws an "unterminated bytes literal" error if a line or the file ends first, and an
 * "invalid unicode escape", "invalid hex escape" or "unknown escape" error located at the
 * escape's backslash */
let _lexBytesLiteral = fn(src: Bytes, at: I32): Tuple<Token, I32> {
  let delimiter = _byteAt(src, at);
  let i = at + 1;
  let run = i;
  let out = Array.new<Bytes>(0);
  let done = false;

  while (!done) {
    let c = _byteAt(src, i);

    if ((c < 0) || (c == "\n".code) || (c == "\r".code)) {
      throw coded(E0005, "unterminated bytes literal");
    } else if (c == delimiter) {
      out.push(Bytes.slice(src, run, i - run));
      i++;
      done = true;
    } else if (c == "\\".code) {
      out.push(Bytes.slice(src, run, i - run));
      let esc = _byteAt(src, i + 1);
      let end = _escape(src, i, esc, out);

      if (end < 0) {
        // A `\` that ends the line leaves the literal unterminated.
        if ((esc < 0) || (esc == "\n".code) || (esc == "\r".code)) {
          throw coded(E0005, "unterminated bytes literal");
        }
        _unknownEscape(src, i);
      }
      i = end;
      run = i;
    } else {
      i++;
    }
  }
  (Token.BytesLiteral(out.join("")), i)
};

/** Lexes a template's text from `at`, after its opening backtick or a hole's closing `}`, to its
 * closing backtick or the `${` of its next hole. The text may span lines, and keeps their line
 * breaks. It takes the escapes of a bytes literal, and `\$` for a `$`; any other `$` is itself.
 * @param tick  the position of the template's opening backtick, where an unterminated template
 *     is reported
 * @param head  whether `at` follows the opening backtick
 * @return the token, `BytesLiteral`, `TemplateHead`, `TemplateMiddle` or `TemplateTail`, and the
 *     position after it
 * @throws an "unterminated template" error if the file ends first, and the escape errors of
 *     `_lexBytesLiteral` */
let _lexTemplate = fn(src: Bytes, at: I32, tick: I32, head: Bool): Tuple<Token, I32> {
  let i = at;
  let run = i;
  let out = Array.new<Bytes>(0);

  while (true) {
    let c = _byteAt(src, i);

    if (c < 0) {
      _failAt = tick;
      throw coded(E0005, "unterminated template");
    }
    let hole = (c == "$".code) && (_byteAt(src, i + 1) == "{".code);

    if ((c == "`".code) || hole) {
      let text = Bytes.slice(src, run, i - run);

      if (out.len() > 0) {
        out.push(text);
        text = out.join("");
      }
      if (hole) { return (head ? Token.TemplateHead(text) : Token.TemplateMiddle(text), i + 2); }
      return (head ? Token.BytesLiteral(text) : Token.TemplateTail(text), i + 1);
    }

    if (c == "\\".code) {
      out.push(Bytes.slice(src, run, i - run));
      let esc = _byteAt(src, i + 1);
      // A `$` escapes itself, as the next run's first byte.
      let end = (esc == "$".code) ? i + 2 : _escape(src, i, esc, out);

      if (end < 0) {
        if (esc < 0) {
          _failAt = tick;
          throw coded(E0005, "unterminated template");
        }

        if ((esc == "\n".code) || (esc == "\r".code)) {
          _failAt = i;
          throw coded(E0006, "a backslash cannot end a template's line");
        }
        _unknownEscape(src, i);
      }
      run = (esc == "$".code) ? i + 1 : end;
      i = end;
    } else {
      i++;
    }
  }
  (Token.Eof, i)
};

// Checks whether `c`, a byte or -1, is an ASCII letter.
let _isLetter = fn(c: I32): Bool {
  ((c >= "A".code) && (c <= "Z".code))
    || ((c >= "a".code) && (c <= "z".code))
};

// Checks whether `text` is spelt as a name: a letter or `_`, then letters, digits and `_`.
export let isName = fn(text: Bytes): Bool {
  let first = _byteAt(text, 0);
  if (!_isLetter(first) && (first != "_".code)) { return false; }
  let i = 1;

  while (i < text.len()) {
    if (!_isWordChar(Bytes.get_u8(text, i))) { return false; }
    i++;
  }
  true
};

/** Lexes a regexp literal, `~r/pattern/flags`. The pattern keeps its escapes, so an escaped `/`
 * does not end it, and the flags are the letters after the closing `/`.
 * @param at  the position of the `~`
 * @return the `RegExpLiteral` and the position after its flags
 * @throws an "unterminated regexp literal" error if the file, or a line not ending in a
 * backslash, ends before the closing `/` */
let _lexRegExpLiteral = fn(src: Bytes, at: I32): Tuple<Token, I32> {
  let i = at + 3;
  let close = -1;

  while (close < 0) {
    let c = _byteAt(src, i);

    if ((c < 0) || (c == "\n".code) || (c == "\r".code)) {
      throw coded(E0005, "unterminated regexp literal");
    } else if (c == "\\".code) {
      if (_byteAt(src, i + 1) < 0) { throw coded(E0005, "unterminated regexp literal"); }
      i = i + 2;
    } else if (c == "/".code) {
      close = i;
    } else {
      i++;
    }
  }
  let flags = close + 1;
  let end = flags;
  while (_isLetter(_byteAt(src, end))) { end++; }
  let pattern = Bytes.slice(src, at + 3, close - at - 3);
  (Token.RegExpLiteral(pattern, Bytes.slice(src, flags, end - flags)), end)
};

/** Returns the two-byte operator that `op` spells.
 * @param op  two bytes of source
 * @return the operator's token, or `Eof` if `op` is not one */
let _opToken = fn(op: Bytes): Token {
  match (op) {
    "==" => Token.EqualEqual,
    "=>" => Token.FatArrow,
    "!=" => Token.NotEqual,
    "<-" => Token.LessMinus,
    "<=" => Token.LessEqual,
    ">=" => Token.GreaterEqual,
    "++" => Token.PlusPlus,
    "+=" => Token.PlusEqual,
    "--" => Token.MinusMinus,
    "-=" => Token.MinusEqual,
    "->" => Token.Arrow,
    "*=" => Token.StarEqual,
    "/=" => Token.SlashEqual,
    "<<" => Token.LessLess,
    ">>" => Token.GreaterGreater,
    "&&" => Token.And,
    "||" => Token.PipePipe,
    "|>" => Token.PipeGreater,
    "??" => Token.QuestionQuestion,
    "%=" => Token.PercentEqual,
    "&=" => Token.AmpersandEqual,
    "|=" => Token.PipeEqual,
    "^=" => Token.CaretEqual,
    _ => Token.Eof,
  }
};

/** Lexes the punctuation or operator at `i`, taking the longest match; `...`, `<<=` or `>>=`,
 * then a two-byte operator, then a single byte.
 * @return the token and the position after it
 * @throws an "unexpected character" error if no token starts at `i` */
let _lexOp = fn(src: Bytes, i: I32): Tuple<Token, I32> {
  if ((i + 3 <= src.len()) && _startsAt(src, i, "...")) { return (Token.DotDotDot, i + 3); }

  let two = (i + 2 <= src.len()) ? _opToken(Bytes.slice(src, i, 2)) : Token.Eof;

  match (two) {
    Eof => {
      let token = match (_byteAt(src, i)) {
        "(".code => Token.LParen,
        ")".code => Token.RParen,
        "{".code => Token.LBrace,
        "}".code => Token.RBrace,
        "[".code => Token.LBracket,
        "]".code => Token.RBracket,
        ";".code => Token.Semicolon,
        ":".code => Token.Colon,
        ",".code => Token.Comma,
        "?".code => Token.Question,
        ".".code => Token.Dot,
        "=".code => Token.Equal,
        "!".code => Token.Not,
        "<".code => Token.Less,
        ">".code => Token.Greater,
        "+".code => Token.Plus,
        "-".code => Token.Minus,
        "*".code => Token.Star,
        "/".code => Token.Slash,
        "%".code => Token.Percent,
        "&".code => Token.Ampersand,
        "|".code => Token.Pipe,
        "^".code => Token.Caret,
        _ => { throw coded(E0002, "unexpected character"); },
      };
      (token, i + 1)
    },
    LessLess, GreaterGreater
      when ((i + 3 <= src.len()) && (Bytes.get_u8(src, i + 2) == "=".code)) =>
      (two == Token.LessLess ? Token.LessLessEqual : Token.GreaterGreaterEqual, i + 3),
    _ => (two, i + 2),
  }
};

/** Lexes the token at `i`, which `_skipSpace` has already reached. A digit right after a member
 * dot is a field number, so `p.1.0` is two field accesses rather than the float `1.0`.
 * @return the token, `Eof` at the end of `src`, and the position after it
 * @throws an error if the token is malformed or `i` holds an unterminated block comment */
let _lexOne = fn(src: Bytes, i: I32): Tuple<Token, I32> {
  let c = _byteAt(src, i);
  let radix = _radixEnd(src, i);
  let float = _floatEnd(src, i);

  if (c < 0) {
    (Token.Eof, i)
  } else if (_isLetter(c) || (c == "_".code)) {
    let end = i + 1;
    while (_isWordChar(_byteAt(src, end))) { end++; }
    (_keywordToken(Bytes.slice(src, i, end - i)), end)
  } else if ((c == ".".code) && _isDigit(_byteAt(src, i + 1)) && _memberDot(src, i)) {
    _lexOp(src, i)
  } else if (_isDigit(c) && (_byteAt(src, i - 1) == ".".code) && _memberDot(src, i - 1)) {
    let end = _digitsEnd(src, i);
    (Token.IntegerConstant(Bytes.slice(src, i, end - i), IntSize.Infer), end)
  } else if ((c == "/".code) && (_byteAt(src, i + 1) == "*".code)) {
    // `_skipSpace` consumes every terminated block comment, so this one is unterminated.
    throw coded(E0005, "unterminated block comment");
  } else if (_startsAt(src, i, "~r/")) {
    _lexRegExpLiteral(src, i)
  } else if (radix >= 0) {
    _lexRadix(src, i, radix)
  } else if (float >= 0) {
    _lexFloat(src, i, float)
  } else if (_isDigit(c)) {
    let end = _digitsEnd(src, i);
    _lexConstant(src, Bytes.slice(src, i, end - i), end)
  } else if ((c == "\"".code) || (c == "'".code)) {
    _lexBytesLiteral(src, i)
  } else if (c == "`".code) {
    _lexTemplate(src, i + 1, i, true)
  } else {
    _lexOp(src, i)
  }
};

/** Checks whether the dot at `i` in `src` follows a value, which makes it member access rather
 * than the start of a float; it follows a word byte or a closing bracket, brace or
 * parenthesis. */
let _memberDot = fn(src: Bytes, i: I32): Bool {
  let c = _byteAt(src, i - 1);
  _isWordChar(c) || (c == ")".code) || (c == "]".code) || (c == "}".code)
};

/** Finds where `src` stops being valid UTF-8. Only invalid source pays for the walk, since valid
 * source passes `utf8Validate` first.
 * @return the position of the first invalid character, or -1 if all of `src` is valid */
let _invalidUtf8 = fn(src: Bytes): I32 {
  let i = utf8Validate(src) ? src.len() : 0;
  let bad = -1;

  while (i < src.len()) {
    let n = utf8CharLength(src, i);

    if (n == 0) {
      bad = i;
      i = src.len();
    } else {
      i = i + n;
    }
  }
  bad
};

/** Where the last `lexFile` failed, a byte offset, and why, with the error's code; -1 and empty
 * when it did not. */
let _failure: Tuple<I32, Bytes> = (-1, "");

// Returns where the last `lexFile` failed and why (`_failure`).
export let lexFailure = fn(): Tuple<I32, Bytes> { _failure };

// Records a failure at byte `at` of `src` because of `message`, and returns its diagnostic.
let _failed = fn(filename: Bytes, src: Bytes, at: I32, message: Bytes): Bytes {
  _failure = (at, message);
  sourceDiagnostic(filename, src, at, message)
};

/** Lexes a source file into the form `Parser.parseProgram` takes. The final token is `Eof`,
 * whose start and end are both the end of the source.
 * @param src  the file's text
 * @param filename  the file's path, used in diagnostics and passed on to the parser
 * @return the tokens, `filename`, and each token's start and end byte offsets, at the same index
 * @throws an error carrying a `path:line:column` diagnostic for invalid UTF-8 or any lexical
 * error */
export let lexFile = fn(
  src: Bytes,
  filename: Bytes
): Tuple<Array<Token>, Bytes, Array<I32>, Array<I32>> {
  let toks = Array.new<Token>(64);
  let starts = Array.new<I32>(64);
  let ends = Array.new<I32>(64);
  let count = 0;
  let cap = 64;
  let pos = 0;
  let invalid = _invalidUtf8(src);
  _failure = (-1, "");
  if (invalid >= 0) { throw _failed(filename, src, invalid, coded(E0001, "invalid UTF-8")); }

  // The braces open in the innermost template hole being lexed, or -1 outside any.
  let depth = -1;
  _holes = Array.new<Hole>(0);
  let done = false;

  while (!done) {
    let start = pos;

    let result: Tuple<Token, I32> = try {
      pos = _skipSpace(src, pos);
      start = pos;

      // A hole's own closing brace resumes its template's text.
      if ((depth == 0) && (_byteAt(src, pos) == "}".code)) {
        _lexTemplate(src, pos + 1, _holes[_holes.len() - 1].tick, false)
      } else {
        _lexOne(src, pos)
      }
    } catch (e) {
      if (_failAt >= 0) {
        pos = _failAt;
        _failAt = -1;
      }
      throw _failed(filename, src, pos, Std.string(e));
    };
    let (t, next) = result;

    if (count >= cap) {
      cap = cap * 2;
      Array.resize(toks, cap);
      Array.resize(starts, cap);
      Array.resize(ends, cap);
    }
    toks[count] = t;
    starts[count] = start;
    ends[count] = next;
    count++;
    pos = next;
    done = match (t) {
      Eof => true,
      LBrace when (depth >= 0) => {
        depth++;
        false
      },
      RBrace when (depth >= 0) => {
        depth--;
        false
      },
      TemplateHead(_) => {
        _holes.push({ depth: depth, tick: start });
        depth = 0;
        false
      },
      TemplateTail(_) => {
        depth = _holes.pop().depth;
        false
      },
      _ => false,
    };
  }

  if (depth >= 0) {
    let tick = _holes[_holes.len() - 1].tick;
    throw _failed(filename, src, tick, coded(E0005, "unterminated template"));
  }
  Array.resize(toks, count);
  Array.resize(starts, count);
  Array.resize(ends, count);
  (toks, filename, starts, ends)
};
