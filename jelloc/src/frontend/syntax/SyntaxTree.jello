package frontend.syntax;

import type {
  Block, Expr, ListLiteral, MatchArm, Parameter, Pattern, Program, Stmt, Type
} from frontend.syntax.Ast;
import { exprTag, patternTag, stmtTag } from frontend.syntax.Ast;
import type { Syntax, SyntaxKind, SyntaxMark } from frontend.syntax.Source;
import { SyntaxKind } from frontend.syntax.Source;
import { internalError } from support.Internal;

let _marks = Array.new<SyntaxMark>(0);
let _next = 0;
let _path = "";

let _sameKind = fn(left: SyntaxKind, right: SyntaxKind): Bool {
  match ((left, right)) {
    (Expression, Expression), (Statement, Statement), (Parameter, Parameter), (Pattern, Pattern),
    (Type, Type) => true,
    _ => false,
  }
};

let _contains = fn(start: I32, end: I32, inner: Array<Syntax>): Bool {
  let i = 0;

  while (i < inner.len()) {
    if ((inner[i].start < start) || (inner[i].end > end)) { return false; }
    i++;
  }
  true
};

let _takeWith = fn(
  kind: SyntaxKind,
  tag: I32,
  children: Array<Syntax>,
  patterns: Array<Syntax>
): Syntax {
  if (_next >= _marks.len()) { internalError("syntax marks end before the AST"); }
  let { kind: markKind, tag: markTag, start, end } = _marks[_next];

  if (!_sameKind(markKind, kind) || (markTag != tag)) {
    internalError(`syntax mark ${_next} does not match its AST node`);
  }

  if (!_contains(start, end, children) || !_contains(start, end, patterns)) {
    internalError(`syntax mark ${_next} does not contain its children`);
  }
  _next++;
  {
    path: _path,
    start,
    end,
    children,
    patterns
  }
};

let _take = fn(kind: SyntaxKind, tag: I32, children: Array<Syntax>): Syntax {
  _takeWith(kind, tag, children, [])
};

let _addPattern = fn(out: Array<Syntax>, value: Pattern) {
  out.push(_pattern(value));
  null
};

let _annotation = fn(): Syntax { _take(SyntaxKind.Type, 0, []) };

let _patternList = fn(values: Array<Pattern>, out: Array<Syntax>) {
  let i = 0;

  while (i < values.len()) {
    _addPattern(out, values[i]);
    i++;
  }
  null
};

let _pattern = fn(value: Pattern): Syntax {
  let out = Array.new<Syntax>(0);

  match (value) {
    Wildcard, BindPattern(_), Pin(_), Bool(_), Integer(_, _), Float(_, _), Bytes(_), Atom(_),
    RegExp(_, _, _), IsType(_, _), Null, Spread(_) => null,
    Object(fields) => {
      let i = 0;

      while (i < fields.len()) {
        _addPattern(out, fields[i].1);
        i++;
      }
      null
    },
    Tuple(items), Array(items) => _patternList(items, out),
    Enum(_, args) => _patternList(args, out),
    Bits(segments) => {
      let i = 0;

      while (i < segments.len()) {
        _addPattern(out, segments[i].value);
        i++;
      }
      null
    },
    Unquote(inner) => {
      out.push(_expr(inner));
      null
    },
  };
  _take(SyntaxKind.Pattern, patternTag(value), out)
};

let _add = fn(out: Array<Syntax>, value: Expr) {
  out.push(_expr(value));
  null
};

let _addStmt = fn(out: Array<Syntax>, value: Stmt) {
  out.push(_stmt(value));
  null
};

let _exprs = fn(values: Array<Expr>, out: Array<Syntax>) {
  let i = 0;

  while (i < values.len()) {
    _add(out, values[i]);
    i++;
  }
  null
};

let _optional = fn(value: ?Expr, out: Array<Syntax>) {
  if (value != null) { _add(out, value); }
  null
};

let _stmts = fn(values: Array<Stmt>, out: Array<Syntax>) {
  let i = 0;

  while (i < values.len()) {
    _addStmt(out, values[i]);
    i++;
  }
  null
};

let _block = fn(block: Block, out: Array<Syntax>) {
  _stmts(block.statements, out);
  _optional(block.tail, out)
};

let _arms = fn(arms: Array<MatchArm>, out: Array<Syntax>, patterns: Array<Syntax>) {
  let i = 0;

  while (i < arms.len()) {
    let { alternatives, guard, body } = arms[i];
    let j = 0;

    while (j < alternatives.len()) {
      _addPattern(patterns, alternatives[j].pattern);
      _optional(alternatives[j].guard, out);
      j++;
    }
    _optional(guard, out);
    _block(body, out);
    i++;
  }
  null
};

let _parameters = fn(params: Array<Parameter>, out: Array<Syntax>) {
  let i = 0;

  while (i < params.len()) {
    let defaults = Array.new<Syntax>(0);

    match (params[i].kind) {
      Default(value) => _add(defaults, value),
      Optional(value) => _optional(value, defaults),
      _ => null,
    };
    out.push(_take(SyntaxKind.Parameter, 0, defaults));
    i++;
  }
  null
};

let _list = fn(value: ListLiteral, out: Array<Syntax>, patterns: Array<Syntax>) {
  match (value) {
    Empty => null,
    Elements(items) => _exprs(items, out),
    Cons(prefix, tail) => {
      _exprs(prefix, out);
      _add(out, tail);
      null
    },
    Spread(prefix, rest, suffix) => {
      _exprs(prefix, out);
      _add(out, rest);
      _exprs(suffix, out)
    },
    Comprehension(generators, body) => {
      let i = 0;

      while (i < generators.len()) {
        let { pattern, source, guard } = generators[i];
        _addPattern(patterns, pattern);
        _add(out, source);
        _optional(guard, out);
        i++;
      }
      _add(out, body);
      null
    },
  }
};

let _expr = fn(value: Expr): Syntax {
  let out = Array.new<Syntax>(0);
  let patterns = Array.new<Syntax>(0);

  match (value) {
    Bytes(_), RegExp(_, _), Atom(_), Bool(_), Integer(_, _), Float(_, _), Null, This, Super,
    Variable(_), Topic => null,
    Array(items), Tuple(items), Interpolation(_, items) => _exprs(items, out),
    List(list) => _list(list, out, patterns),
    Object(entries) => {
      let i = 0;

      while (i < entries.len()) {
        match (entries[i]) {
          Field(_, entry) => _add(out, entry),
          Computed(key, entry) => {
            _add(out, key);
            _add(out, entry)
          },
          Spread(entry) => _add(out, entry),
        };
        i++;
      }
      null
    },
    Spread(inner), Unary(_, inner), Await(inner), Unquote(inner), Member(inner, _),
    TypeApply(inner, _), IncDec(_, _, inner), Cast(inner, _), Is(inner, _) => _add(out, inner),
    LetExpr(pattern, _, annotation, inner) => {
      _addPattern(patterns, pattern);
      if (annotation != null) { patterns.push(_annotation()); }
      _add(out, inner)
    },
    Bits(segments) => {
      let i = 0;

      while (i < segments.len()) {
        _add(out, segments[i].value);
        i++;
      }
      null
    },
    Index(left, right), Binary(_, left, right), Pipe(left, right, _), Assign(_, left, right) => {
      _add(out, left);
      _add(out, right)
    },
    Call(callee, _, args) => {
      _add(out, callee);
      _exprs(args, out)
    },
    New(base, args) => {
      _add(out, base);
      _exprs(args, out)
    },
    Function(params, _, body, _) => {
      _parameters(params, out);
      _block(body, out)
    },
    BlockExpr(body) => _block(body, out),
    If(condition, thenBranch, elseBranch), Conditional(condition, thenBranch, elseBranch) => {
      _add(out, condition);
      _add(out, thenBranch);
      _add(out, elseBranch)
    },
    Match(subject, arms) => {
      _add(out, subject);
      _arms(arms, out, patterns)
    },
    With(clauses, body, elseArms) => {
      let i = 0;

      while (i < clauses.len()) {
        match (clauses[i]) {
          Clause(pattern, guard, clause) => {
            _addPattern(patterns, pattern);
            _optional(guard, out);
            _add(out, clause)
          },
          Let(pattern, clause) => {
            _addPattern(patterns, pattern);
            _add(out, clause)
          },
        };
        i++;
      }
      _block(body, out);

      match (elseArms) {
        Some(arms) => _arms(arms, out, patterns),
        None => null,
      }
    },
    Try(body, _, catchBody) => {
      _block(body, out);
      _block(catchBody, out)
    },
    Quote(_, body) => match (body) {
      Expression(inner) => _add(out, inner),
      Statement(inner) => _addStmt(out, inner),
      Statements(inner) => _stmts(inner, out),
      Pattern(pattern) => _addPattern(patterns, pattern),
      Type(_) => null,
    },
  };
  _takeWith(SyntaxKind.Expression, exprTag(value), out, patterns)
};

let _stmt = fn(value: Stmt): Syntax {
  let out = Array.new<Syntax>(0);
  let patterns = Array.new<Syntax>(0);

  match (value) {
    LetStmt(_, _, pattern, _, annotation, inner, otherwise) => {
      _addPattern(patterns, pattern);
      if (annotation != null) { patterns.push(_annotation()); }
      _add(out, inner);
      if (otherwise != null) { _block(otherwise, out); }
      null
    },
    Throw(inner), Expression(inner) => _add(out, inner),
    Prototype(_, _, _, fields) => {
      let i = 0;

      while (i < fields.len()) {
        _add(out, fields[i].value);
        i++;
      }
      null
    },
    Macro(_, _, _, body) => _stmts(body, out),
    While(condition, body) => {
      _add(out, condition);
      _stmts(body, out)
    },
    DoWhile(body, condition) => {
      _stmts(body, out);
      _add(out, condition)
    },
    Return(inner) => _optional(inner, out),
    Typedef(_, _, _, _), Enum(_, _, _, _), ImportModule(_, _, _), ImportFrom(_, _, _), Break,
    Continue => null,
  };
  _takeWith(SyntaxKind.Statement, stmtTag(value), out, patterns)
};

let _rootSyntax = fn(path: Bytes, children: Array<Syntax>): Syntax {
  let end = 1;

  if (children.len() > 0) {
    let last = children[children.len() - 1].end;
    if (last > end) { end = last; }
  }
  {
    path,
    start: 0,
    end,
    children,
    patterns: []
  }
};

export let syntaxTree = fn(program: Program, path: Bytes, marks: Array<SyntaxMark>): Syntax {
  _marks = marks;
  _next = 0;
  _path = path;

  let out = Array.new<Syntax>(0);
  _stmts(program.statements, out);
  _optional(program.tail, out);
  if (_next != _marks.len()) { internalError("syntax marks remain after the AST"); }
  _rootSyntax(path, out)
};
