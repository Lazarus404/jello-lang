package frontend.syntax;

/** @file
 * Rewrites an AST together with its `Syntax` tree, for macro expansion: a hook sees each node
 * before its children and may replace it, and the nodes it leaves are rebuilt from their
 * rewritten children, each child taking its own syntax with it. A statement may become several,
 * or none. Children are visited in field order, as `frontend.syntax.SyntaxTree` pairs them, so
 * two rewrites of one tree meet its nodes in the same order. Types have no syntax of their own. */

import type {
  BitExprSegment, BitPatternSegment, Block, EnumConstructor, Expr, ListGenerator, ListLiteral,
  MatchAlternative, MatchArm, MatchArmValue, Parameter, Pattern, PrototypeField, Stmt, StructField,
  Type
} from frontend.syntax.Ast;
import {
  Expr, ListLiteral, MatchArms, ObjectEntry, ParameterKind, Pattern, QuoteBody, Stmt, Type,
  TypedefBody, WithClause
} from frontend.syntax.Ast;
import type { Syntax } from frontend.syntax.Source;
import { internalError } from support.Internal;

/** A node with its syntax, as a hook sees and replaces it; a statement comes as `Statements` of
 * one, and may be replaced by any number. */
export enum Located {
  Expression(value: Expr, syntax: Syntax);
  Statements(values: Array<Stmt>, syntax: Array<Syntax>);
  Pattern(value: Pattern, syntax: Syntax);
  Type(value: Type);
  MatchArms(values: Array<MatchArm>, syntax: Syntax);
}

/** The hook of the rewrite under way; it returns a node's replacement, of the node's kind, or null
 * to have its children rewritten instead. */
let _hook: (Located) -> ?Located = fn(_node) { null };

/** Where a node's rebuilding stands: its old children and patterns, which it takes in order from
 * `at` (two cursors), and the new ones it makes. */
typedef Cursor = {
  let children: Array<Syntax>;
  let patterns: Array<Syntax>;
  let at: Array<I32>;
  let made: Array<Syntax>;
  let madePatterns: Array<Syntax>;
};

// Starts rebuilding the node whose syntax is `syntax`.
let _cursor = fn(syntax: Syntax): Cursor {
  {
    children: syntax.children,
    patterns: syntax.patterns,
    at: [0, 0],
    made: [],
    madePatterns: []
  }
};

// Ends rebuilding the node whose syntax was `syntax`; its span with the children made.
let _made = fn(syntax: Syntax, cursor: Cursor): Syntax {
  { ...syntax, children: cursor.made, patterns: cursor.madePatterns }
};

// Takes the next old child of `cursor`.
let _nextChild = fn(cursor: Cursor): Syntax {
  let at = cursor.at;
  if (at[0] >= cursor.children.len()) { internalError("a rewrite ran out of syntax"); }
  at[0] = at[0] + 1;
  cursor.children[at[0] - 1]
};

// Takes the next old pattern of `cursor`.
let _nextPattern = fn(cursor: Cursor): Syntax {
  let at = cursor.at;
  if (at[1] >= cursor.patterns.len()) { internalError("a rewrite ran out of pattern syntax"); }
  at[1] = at[1] + 1;
  cursor.patterns[at[1] - 1]
};

// Rewrites `value`, when it is not null.
let _optionalType = fn(value: ?Type): ?Type { value == null ? null : _type(value) };

// Rewrites type `value`.
let _type = fn(value: Type): Type {
  let replaced = _hook(Located.Type(value));

  if (replaced != null) {
    return match (replaced) {
      Type(ty) => ty,
      _ => {
        internalError("a type's rewrite is no type");
        value
      },
    };
  }

  match (value) {
    Named(_), Unquote(_) => value,
    Generic(name, args) => Type.Generic(name, args.map(_type)),
    OptionalArg(inner) => Type.OptionalArg(_type(inner)),
    VarargsArg(inner) => Type.VarargsArg(_type(inner)),
    Function(args, result) => Type.Function(args.map(_type), _type(result)),
    Tuple(items) => Type.Tuple(items.map(_type)),
  }
};

// Rewrites the types of struct or constructor fields `fields`.
let _fields = fn(fields: Array<StructField>): Array<StructField> {
  let out = Array.new<StructField>(0);

  for (field in fields) {
    out.push({ name: field.name, ty: _type(field.ty) });
  }
  out
};

// Rewrites the sub-pattern `value`, a child of `cursor`.
let _subPattern = fn(cursor: Cursor, value: Pattern): Pattern {
  let (out, syntax) = _pattern(value, _nextChild(cursor));
  cursor.made.push(syntax);
  out
};

// Rewrites the sub-patterns `values`, children of `cursor`.
let _subPatterns = fn(cursor: Cursor, values: Array<Pattern>): Array<Pattern> {
  values.map(fn(value: Pattern): Pattern { _subPattern(cursor, value) })
};

// Rewrites the next child of `cursor`, the expression `value`.
let _child = fn(cursor: Cursor, value: Expr): Expr {
  let (out, syntax) = _expression(value, _nextChild(cursor));
  cursor.made.push(syntax);
  out
};

// Rewrites `value`, a child of `cursor`, when it is not null.
let _optionalChild = fn(cursor: Cursor, value: ?Expr): ?Expr {
  value == null ? null : _child(cursor, value)
};

// Rewrites the children `values` of `cursor`.
let _children = fn(cursor: Cursor, values: Array<Expr>): Array<Expr> {
  values.map(fn(value: Expr): Expr { _child(cursor, value) })
};

// Rewrites the statements `values`, children of `cursor`, into those they become.
let _statements = fn(cursor: Cursor, values: Array<Stmt>): Array<Stmt> {
  let out = Array.new<Stmt>(0);

  for (value in values) {
    let (made, syntax) = _statement(value, _nextChild(cursor));

    for (j, stmt in made) {
      out.push(stmt);
      cursor.made.push(syntax[j]);
    }
  }
  out
};

// Rewrites `block`, whose statements and tail are children of `cursor`.
let _block = fn(cursor: Cursor, block: Block): Block {
  let statements = _statements(cursor, block.statements);
  { statements, tail: _optionalChild(cursor, block.tail) }
};

// Rewrites the pattern `value`, the next pattern of `cursor`.
let _patternChild = fn(cursor: Cursor, value: Pattern): Pattern {
  let (out, syntax) = _pattern(value, _nextPattern(cursor));
  cursor.madePatterns.push(syntax);
  out
};

/** Rewrites the binding annotation `value`, whose syntax is the next pattern of `cursor`, when it
 * is not null. */
let _annotation = fn(cursor: Cursor, value: ?Type): ?Type {
  if (value == null) { return null; }
  cursor.madePatterns.push(_nextPattern(cursor));
  _type(value)
};

/** Rewrites the parameters `params`, children of `cursor`; a parameter's node has its default
 * value as its only child. */
let _parameters = fn(cursor: Cursor, params: Array<Parameter>): Array<Parameter> {
  let out = Array.new<Parameter>(0);

  for ({ name, annotation, kind } in params) {
    let syntax = _nextChild(cursor);
    let inner = _cursor(syntax);

    let made = match (kind) {
      Default(value) => ParameterKind.Default(_child(inner, value)),
      Optional(value) => ParameterKind.Optional(_optionalChild(inner, value)),
      _ => kind,
    };
    out.push({ name, annotation: _optionalType(annotation), kind: made });
    cursor.made.push(_made(syntax, inner));
  }
  out
};

// Rewrites one ordinary match arm, its patterns being patterns of `cursor` and the rest children.
let _arm = fn(cursor: Cursor, value: MatchArmValue): MatchArm {
  let { alternatives, guard, body } = value;
  let made = Array.new<MatchAlternative>(0);

  for ({ pattern, guard: own } in alternatives) {
    let rewritten = _patternChild(cursor, pattern);
    made.push({ pattern: rewritten, guard: _optionalChild(cursor, own) });
  }
  let shared = _optionalChild(cursor, guard);
  MatchArm.Arm({ alternatives: made, guard: shared, body: _block(cursor, body) })
};

// Rewrites match arms, their patterns being patterns of `cursor` and the rest its children.
let _arms = fn(cursor: Cursor, arms: Array<MatchArm>): Array<MatchArm> {
  let out = Array.new<MatchArm>(0);

  for (arm in arms) {
    match (arm) {
      Arm(value) => out.push(_arm(cursor, value)),
      Unquote(value) => {
        let syntax = _nextChild(cursor);
        let replaced = _hook(Located.MatchArms([arm], syntax));

        if (replaced == null) {
          let (made, at) = _expression(value, syntax.children[0]);
          out.push(MatchArm.Unquote(made));
          cursor.made.push({ ...syntax, children: [at] });
        } else {
          match (replaced) {
            MatchArms(values, at) => {
              out.appendFrom(values, 0);
              cursor.made.appendFrom(at.children, 0);
              cursor.madePatterns.appendFrom(at.patterns, 0)
            },
            _ => internalError("a match arm's rewrite is no match arm"),
          };
        }
      },
    };
  }
  out
};

// Rewrites the parts of a `list[...]` literal, children and patterns of `cursor`.
let _list = fn(cursor: Cursor, value: ListLiteral): ListLiteral {
  match (value) {
    Empty => value,
    Elements(items) => ListLiteral.Elements(_children(cursor, items)),
    Cons(prefix, tail) => {
      let p = _children(cursor, prefix);
      ListLiteral.Cons(p, _child(cursor, tail))
    },
    Spread(prefix, rest, suffix) => {
      let p = _children(cursor, prefix);
      let r = _child(cursor, rest);
      ListLiteral.Spread(p, r, _children(cursor, suffix))
    },
    Comprehension(generators, body) => {
      let made = Array.new<ListGenerator>(0);

      for ({ pattern, source, guard } in generators) {
        let p = _patternChild(cursor, pattern);
        let s = _child(cursor, source);
        made.push({ pattern: p, source: s, guard: _optionalChild(cursor, guard) });
      }
      ListLiteral.Comprehension(made, _child(cursor, body))
    },
  }
};

// Rewrites the entries of an object literal, children of `cursor`.
let _entries = fn(cursor: Cursor, entries: Array<ObjectEntry>): Array<ObjectEntry> {
  let made = Array.new<ObjectEntry>(0);

  for (member in entries) {
    made.push(match (member) {
      Field(name, entry) => ObjectEntry.Field(name, _child(cursor, entry)),
      Computed(key, entry) => {
        let k = _child(cursor, key);
        ObjectEntry.Computed(k, _child(cursor, entry))
      },
      Spread(entry) => ObjectEntry.Spread(_child(cursor, entry)),
    });
  }
  made
};

// Rewrites the segments of a bit-syntax expression, children of `cursor`.
let _bitSegments = fn(cursor: Cursor, segments: Array<BitExprSegment>): Array<BitExprSegment> {
  let made = Array.new<BitExprSegment>(0);

  for (original in segments) {
    let value = _child(cursor, original.value);
    let segment: BitExprSegment = { ...original, value };
    made.push(segment);
  }
  made
};

// Rewrites the clauses of a `with`, children and patterns of `cursor`.
let _clauses = fn(cursor: Cursor, clauses: Array<WithClause>): Array<WithClause> {
  let made = Array.new<WithClause>(0);

  for (withClause in clauses) {
    made.push(match (withClause) {
      Clause(pattern, guard, clause) => {
        let p = _patternChild(cursor, pattern);
        let g = _optionalChild(cursor, guard);
        WithClause.Clause(p, g, _child(cursor, clause))
      },
      Let(pattern, clause) => {
        let p = _patternChild(cursor, pattern);
        WithClause.Let(p, _child(cursor, clause))
      },
    });
  }
  made
};

// Rewrites what a quote holds, through `cursor`.
let _quoteBody = fn(cursor: Cursor, body: QuoteBody): QuoteBody {
  match (body) {
    Expression(inner) => QuoteBody.Expression(_child(cursor, inner)),
    Statement(inner) => {
      let made = _statements(cursor, [inner]);
      made.len() == 1 ? QuoteBody.Statement(made[0]) : QuoteBody.Statements(made)
    },
    Statements(inner) => QuoteBody.Statements(_statements(cursor, inner)),
    Pattern(pattern) => QuoteBody.Pattern(_patternChild(cursor, pattern)),
    Type(ty) => QuoteBody.Type(_type(ty)),
    Arm(arm) => {
      let made = _arms(cursor, [arm]);
      QuoteBody.Arm(made[0])
    },
  }
};

// Rewrites the children of expression `value`, through `cursor`.
let _expressionChildren = fn(cursor: Cursor, value: Expr): Expr {
  match (value) {
    Bytes(_), RegExp(_, _), Atom(_), Bool(_), Integer(_, _), Float(_, _), Null, This, Super,
    Variable(_), Topic => value,
    Array(items) => Expr.Array(_children(cursor, items)),
    Tuple(items) => Expr.Tuple(_children(cursor, items)),
    Interpolation(texts, holes) => Expr.Interpolation(texts, _children(cursor, holes)),
    List(list) => Expr.List(_list(cursor, list)),
    Object(entries) => Expr.Object(_entries(cursor, entries)),
    Spread(inner) => Expr.Spread(_child(cursor, inner)),
    Unary(op, inner) => Expr.Unary(op, _child(cursor, inner)),
    Await(inner) => Expr.Await(_child(cursor, inner)),
    Unquote(inner) => Expr.Unquote(_child(cursor, inner)),
    Member(inner, name) => Expr.Member(_child(cursor, inner), name),
    TypeApply(inner, args) => Expr.TypeApply(_child(cursor, inner), args.map(_type)),
    IncDec(op, prefix, inner) => Expr.IncDec(op, prefix, _child(cursor, inner)),
    Cast(inner, ty) => Expr.Cast(_child(cursor, inner), _type(ty)),
    Is(inner, ty) => Expr.Is(_child(cursor, inner), _type(ty)),
    LetExpr(pattern, typeParams, annotation, inner) => {
      let p = _patternChild(cursor, pattern);
      let a = _annotation(cursor, annotation);
      Expr.LetExpr(p, typeParams, a, _child(cursor, inner))
    },
    Bits(segments) => Expr.Bits(_bitSegments(cursor, segments)),
    Index(left, right) => {
      let l = _child(cursor, left);
      Expr.Index(l, _child(cursor, right))
    },
    Binary(op, left, right) => {
      let l = _child(cursor, left);
      Expr.Binary(op, l, _child(cursor, right))
    },
    Pipe(left, right, topic) => {
      let l = _child(cursor, left);
      Expr.Pipe(l, _child(cursor, right), topic)
    },
    Coalesce(left, right) => {
      let l = _child(cursor, left);
      Expr.Coalesce(l, _child(cursor, right))
    },
    Assign(op, left, right) => {
      let l = _child(cursor, left);
      Expr.Assign(op, l, _child(cursor, right))
    },
    Call(callee, typeArgs, args) => {
      let c = _child(cursor, callee);
      Expr.Call(c, typeArgs.map(_type), _children(cursor, args))
    },
    New(base, args) => {
      let b = _child(cursor, base);
      Expr.New(b, _children(cursor, args))
    },
    Function(params, result, body, isMethod) => {
      let p = _parameters(cursor, params);
      Expr.Function(p, _optionalType(result), _block(cursor, body), isMethod)
    },
    BlockExpr(body) => Expr.BlockExpr(_block(cursor, body)),
    If(condition, thenBranch, elseBranch) => {
      let c = _child(cursor, condition);
      let t = _child(cursor, thenBranch);
      Expr.If(c, t, _child(cursor, elseBranch))
    },
    Conditional(condition, thenBranch, elseBranch) => {
      let c = _child(cursor, condition);
      let t = _child(cursor, thenBranch);
      Expr.Conditional(c, t, _child(cursor, elseBranch))
    },
    Match(subject, arms) => {
      let s = _child(cursor, subject);
      Expr.Match(s, _arms(cursor, arms))
    },
    With(clauses, body, elseArms) => {
      let made = _clauses(cursor, clauses);
      let b = _block(cursor, body);

      let otherwise = match (elseArms) {
        Some(arms) => MatchArms.Some(_arms(cursor, arms)),
        None => elseArms,
      };
      Expr.With(made, b, otherwise)
    },
    Try(body, name, catchBody) => {
      let b = _block(cursor, body);
      Expr.Try(b, name, _block(cursor, catchBody))
    },
    Quote(kind, body) => Expr.Quote(kind, _quoteBody(cursor, body)),
  }
};

// Rewrites expression `value` with syntax `syntax`.
let _expression = fn(value: Expr, syntax: Syntax): Tuple<Expr, Syntax> {
  let replaced = _hook(Located.Expression(value, syntax));

  if (replaced != null) {
    return match (replaced) {
      Expression(out, made) => (out, made),
      _ => {
        internalError("an expression's rewrite is no expression");
        (value, syntax)
      },
    };
  }

  let cursor = _cursor(syntax);
  let out = _expressionChildren(cursor, value);
  (out, _made(syntax, cursor))
};

// Rewrites the children of statement `value`, through `cursor`.
let _statementChildren = fn(cursor: Cursor, value: Stmt): Stmt {
  match (value) {
    LetStmt(isConst, exported, pattern, typeParams, annotation, inner, otherwise) => {
      let p = _patternChild(cursor, pattern);
      let a = _annotation(cursor, annotation);
      let v = _child(cursor, inner);
      let o = otherwise == null ? null : _block(cursor, otherwise);
      Stmt.LetStmt(isConst, exported, p, typeParams, a, v, o)
    },
    Throw(inner) => Stmt.Throw(_child(cursor, inner)),
    Expression(inner) => Stmt.Expression(_child(cursor, inner)),
    Prototype(exported, name, typeParams, fields) => {
      let made = Array.new<PrototypeField>(0);

      for (field in fields) {
        made.push({ name: field.name, value: _child(cursor, field.value) });
      }
      Stmt.Prototype(exported, name, typeParams, made)
    },
    Macro(exported, name, params, body) =>
      Stmt.Macro(exported, name, params, _statements(cursor, body)),
    While(condition, body) => {
      let c = _child(cursor, condition);
      Stmt.While(c, _statements(cursor, body))
    },
    DoWhile(body, condition) => {
      let b = _statements(cursor, body);
      Stmt.DoWhile(b, _child(cursor, condition))
    },
    For(index, item, items, body) => {
      let i = index == null ? null : _patternChild(cursor, index);
      let p = _patternChild(cursor, item);
      let c = _child(cursor, items);
      Stmt.For(i, p, c, _statements(cursor, body))
    },
    Return(inner) => Stmt.Return(_optionalChild(cursor, inner)),
    Typedef(exported, name, typeParams, body) => {
      let made = match (body) {
        Alias(ty) => TypedefBody.Alias(_type(ty)),
        Struct(fields) => TypedefBody.Struct(_fields(fields)),
        BytesLayout(_), Abstract => body,
      };
      Stmt.Typedef(exported, name, typeParams, made)
    },
    Enum(exported, name, typeParams, constructors) => {
      let made = Array.new<EnumConstructor>(0);

      for (constructor in constructors) {
        made.push({ name: constructor.name, fields: _fields(constructor.fields) });
      }
      Stmt.Enum(exported, name, typeParams, made)
    },
    ImportModule(_, _, _), ImportFrom(_, _, _), Break, Continue => value,
  }
};

// Rewrites the statement `value` with syntax `syntax`, into the statements it becomes.
let _statement = fn(value: Stmt, syntax: Syntax): Tuple<Array<Stmt>, Array<Syntax>> {
  let replaced = _hook(Located.Statements([value], [syntax]));

  if (replaced != null) {
    return match (replaced) {
      Statements(out, made) => (out, made),
      _ => {
        internalError("a statement's rewrite is no statement");
        ([value], [syntax])
      },
    };
  }

  let cursor = _cursor(syntax);
  let out = _statementChildren(cursor, value);
  ([out], [_made(syntax, cursor)])
};

// Rewrites the segments of a bit-syntax pattern, children of `cursor`.
let _bitPatternSegments = fn(
  cursor: Cursor,
  segments: Array<BitPatternSegment>
): Array<BitPatternSegment> {
  let made = Array.new<BitPatternSegment>(0);

  for (original in segments) {
    let value = _subPattern(cursor, original.value);
    let segment: BitPatternSegment = { ...original, value };
    made.push(segment);
  }
  made
};

// Rewrites pattern `value` with syntax `syntax`.
let _pattern = fn(value: Pattern, syntax: Syntax): Tuple<Pattern, Syntax> {
  let replaced = _hook(Located.Pattern(value, syntax));

  if (replaced != null) {
    return match (replaced) {
      Pattern(out, made) => (out, made),
      _ => {
        internalError("a pattern's rewrite is no pattern");
        (value, syntax)
      },
    };
  }

  let cursor = _cursor(syntax);

  let out = match (value) {
    Wildcard, BindPattern(_), Pin(_), Bool(_), Integer(_, _), Float(_, _), Bytes(_), Atom(_),
    RegExp(_, _, _), Null, Spread(_) => value,
    IsType(ty, binding) => Pattern.IsType(_type(ty), binding),
    Object(fields) => {
      let made = Array.new<Tuple<Bytes, Pattern>>(0);

      for ((name, field) in fields) {
        made.push((name, _subPattern(cursor, field)));
      }
      Pattern.Object(made)
    },
    Tuple(items) => Pattern.Tuple(_subPatterns(cursor, items)),
    Array(items) => Pattern.Array(_subPatterns(cursor, items)),
    Enum(name, args) => Pattern.Enum(name, _subPatterns(cursor, args)),
    Bits(segments) => Pattern.Bits(_bitPatternSegments(cursor, segments)),
    Unquote(inner) => Pattern.Unquote(_child(cursor, inner)),
  };
  (out, _made(syntax, cursor))
};

/** Rewrites `node` with `hook`, which sees each node before its children; it returns a node's
 * replacement, which is not itself rewritten, or null to have the node's children rewritten. A
 * hook may start a rewrite of its own.
 * @return the rewritten node, of `node`'s kind */
export let rewrite = fn(node: Located, hook: (Located) -> ?Located): Located {
  let outer = _hook;
  _hook = hook;

  let out = try {
    match (node) {
      Expression(value, syntax) => {
        let (made, at) = _expression(value, syntax);
        Located.Expression(made, at)
      },
      Statements(values, syntax) => {
        let cursor: Cursor = {
          children: syntax, patterns: [], at: [0, 0], made: [], madePatterns: []
        };
        Located.Statements(_statements(cursor, values), cursor.made)
      },
      Pattern(value, syntax) => {
        let (made, at) = _pattern(value, syntax);
        Located.Pattern(made, at)
      },
      Type(value) => Located.Type(_type(value)),
      MatchArms(values, syntax) => {
        let replaced = _hook(node);

        if (replaced != null) { replaced } else {
          let cursor = _cursor(syntax);
          Located.MatchArms(_arms(cursor, values), _made(syntax, cursor))
        }
      },
    }
  } catch (e) {
    _hook = outer;
    throw e;
  };
  _hook = outer;
  out
};
