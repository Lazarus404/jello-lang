package frontend.syntax;

/** @file
 * Text forms of lexer tokens. `printTokens` writes the variant names that `jelloc --lex` prints,
 * and `tokenText` gives the source spelling the parser quotes in its errors. */

import type { FloatSize, IntSize } from frontend.syntax.Ast;
import type { Token } from frontend.syntax.Lexer;
import { bytesLiteral } from support.Text;

// Returns the variant name of integer suffix `size`, for `_tokenName`.
let _integerSize = fn(size: IntSize): Bytes {
  match (size) {
    Infer => "Infer",
    I8 => "I8",
    I16 => "I16",
    I32 => "I32",
    I64 => "I64",
    U8 => "U8",
    U16 => "U16",
    U32 => "U32",
    U64 => "U64",
  }
};

// Returns the variant name of float suffix `size`, for `_tokenName`.
let _floatSize = fn(size: FloatSize): Bytes {
  match (size) {
    Infer => "Infer",
    F16 => "F16",
    F32 => "F32",
    F64 => "F64",
  }
};

/** Returns the variant name of `token` with its payload, such as `Ident("x")` or
 * `IntegerConstant(1, I64)`, as `printTokens` writes it. */
let _tokenName = fn(token: Token): Bytes {
  match (token) {
    Ident(name) => `Ident(${bytesLiteral(name)})`,
    IntegerConstant(digits, size) => `IntegerConstant(${digits}, ${_integerSize(size)})`,
    FloatConstant(literal, size) => `FloatConstant(${literal}, ${_floatSize(size)})`,
    BytesLiteral(value) => `BytesLiteral(${bytesLiteral(value)})`,
    RegExpLiteral(pattern, flags) =>
      `RegExpLiteral(${bytesLiteral(pattern)}, ${bytesLiteral(flags)})`,
    TemplateHead(text) => `TemplateHead(${bytesLiteral(text)})`,
    TemplateMiddle(text) => `TemplateMiddle(${bytesLiteral(text)})`,
    TemplateTail(text) => `TemplateTail(${bytesLiteral(text)})`,
    As => "As",
    Await => "Await",
    Bits => "Bits",
    Break => "Break",
    Catch => "Catch",
    Const => "Const",
    Continue => "Continue",
    Do => "Do",
    Else => "Else",
    EnumDecl => "EnumDecl",
    Export => "Export",
    False => "False",
    Fn => "Fn",
    For => "For",
    From => "From",
    If => "If",
    Import => "Import",
    Is => "Is",
    Let => "Let",
    ListLiteral => "ListLiteral",
    Load => "Load",
    Macro => "Macro",
    Match => "Match",
    New => "New",
    Null => "Null",
    Package => "Package",
    Prototype => "Prototype",
    Return => "Return",
    Super => "Super",
    This => "This",
    Throw => "Throw",
    True => "True",
    Try => "Try",
    Type => "Type",
    Typedef => "Typedef",
    When => "When",
    While => "While",
    With => "With",
    LParen => "LParen",
    RParen => "RParen",
    LBrace => "LBrace",
    RBrace => "RBrace",
    LBracket => "LBracket",
    RBracket => "RBracket",
    Semicolon => "Semicolon",
    Colon => "Colon",
    Comma => "Comma",
    Question => "Question",
    QuestionQuestion => "QuestionQuestion",
    Dot => "Dot",
    DotDotDot => "DotDotDot",
    Equal => "Equal",
    EqualEqual => "EqualEqual",
    FatArrow => "FatArrow",
    Not => "Not",
    NotEqual => "NotEqual",
    Less => "Less",
    LessEqual => "LessEqual",
    LessMinus => "LessMinus",
    Greater => "Greater",
    GreaterEqual => "GreaterEqual",
    Plus => "Plus",
    PlusPlus => "PlusPlus",
    PlusEqual => "PlusEqual",
    Minus => "Minus",
    MinusMinus => "MinusMinus",
    MinusEqual => "MinusEqual",
    Arrow => "Arrow",
    Star => "Star",
    StarEqual => "StarEqual",
    Slash => "Slash",
    SlashEqual => "SlashEqual",
    Percent => "Percent",
    PercentEqual => "PercentEqual",
    LessLess => "LessLess",
    LessLessEqual => "LessLessEqual",
    GreaterGreater => "GreaterGreater",
    GreaterGreaterEqual => "GreaterGreaterEqual",
    Ampersand => "Ampersand",
    AmpersandEqual => "AmpersandEqual",
    And => "And",
    Pipe => "Pipe",
    PipeEqual => "PipeEqual",
    PipePipe => "PipePipe",
    PipeGreater => "PipeGreater",
    Caret => "Caret",
    CaretEqual => "CaretEqual",
    Eof => "Eof",
  }
};

/** Returns `token` as source spells it, near enough for a diagnostic; a constant's digits
 * without their suffix, a bytes literal double-quoted with its escapes normalised, a template's
 * text with its delimiters, and a keyword or operator exactly. The end of the file has no
 * spelling.
 * @return the spelling, or "" for `Eof` */
export let tokenText = fn(token: Token): Bytes {
  match (token) {
    Ident(name) => name,
    IntegerConstant(digits, _) => digits,
    FloatConstant(literal, _) => literal,
    BytesLiteral(value) => bytesLiteral(value),
    RegExpLiteral(pattern, flags) => `~r/${pattern}/${flags}`,
    TemplateHead(text) => "`" + text + "${",
    TemplateMiddle(text) => "}" + text + "${",
    TemplateTail(text) => "}" + text + "`",
    As => "as",
    Await => "await",
    Bits => "bits",
    Break => "break",
    Catch => "catch",
    Const => "const",
    Continue => "continue",
    Do => "do",
    Else => "else",
    EnumDecl => "enum",
    Export => "export",
    False => "false",
    Fn => "fn",
    For => "for",
    From => "from",
    If => "if",
    Import => "import",
    Is => "is",
    Let => "let",
    ListLiteral => "list",
    Load => "load",
    Macro => "macro",
    Match => "match",
    New => "new",
    Null => "null",
    Package => "package",
    Prototype => "prototype",
    Return => "return",
    Super => "super",
    This => "this",
    Throw => "throw",
    True => "true",
    Try => "try",
    Type => "type",
    Typedef => "typedef",
    When => "when",
    While => "while",
    With => "with",
    LParen => "(",
    RParen => ")",
    LBrace => "{",
    RBrace => "}",
    LBracket => "[",
    RBracket => "]",
    Semicolon => ";",
    Colon => ":",
    Comma => ",",
    Question => "?",
    QuestionQuestion => "??",
    Dot => ".",
    DotDotDot => "...",
    Equal => "=",
    EqualEqual => "==",
    FatArrow => "=>",
    Not => "!",
    NotEqual => "!=",
    Less => "<",
    LessEqual => "<=",
    LessMinus => "<-",
    Greater => ">",
    GreaterEqual => ">=",
    Plus => "+",
    PlusPlus => "++",
    PlusEqual => "+=",
    Minus => "-",
    MinusMinus => "--",
    MinusEqual => "-=",
    Arrow => "->",
    Star => "*",
    StarEqual => "*=",
    Slash => "/",
    SlashEqual => "/=",
    Percent => "%",
    PercentEqual => "%=",
    LessLess => "<<",
    LessLessEqual => "<<=",
    GreaterGreater => ">>",
    GreaterGreaterEqual => ">>=",
    Ampersand => "&",
    AmpersandEqual => "&=",
    And => "&&",
    Pipe => "|",
    PipeEqual => "|=",
    PipePipe => "||",
    PipeGreater => "|>",
    Caret => "^",
    CaretEqual => "^=",
    Eof => "",
  }
};

/** Checks whether `token` is a keyword. The parser still accepts a keyword as a member, field or
 * object-key name. */
export let isKeyword = fn(token: Token): Bool {
  match (token) {
    As, Await, Bits, Break, Catch, Const, Continue, Do, Else, EnumDecl, Export, False, Fn, For,
    From, If, Import, Is, Let, ListLiteral, Load, Macro, Match, New, Null, Package, Prototype,
    Return, Super, This, Throw, True, Try, Type, Typedef, When, While, With => true,
    _ => false,
  }
};

/** Lists tokens one per line by `_tokenName`, for `jelloc --lex`.
 * @param tokens  the tokens, ending with `Eof`
 * @return the listing, each line ending in a newline */
export let printTokens = fn(tokens: Array<Token>): Bytes {
  tokens.map(fn(token: Token): Bytes { `${_tokenName(token)}\n` }).join("")
};
