package frontend;

import type { Expr, Package, Stmt } from frontend.Ast;
import { lexFileSource } from frontend.Lexer;
import { parseSource, programSyntax } from frontend.Parser;
import type { Syntax } from frontend.Source;
import { readText } from std.io.File;

export enum Import { Import(local: Bytes, module: I32, name: Bytes, typeOnly: Bool); }

export enum Module {
  Module(path: Bytes, statements: Array<Stmt>, syntax: Syntax, tail: ?Expr, imports: Array<Import>);
}

let _directory = fn(path: Bytes): Bytes {
  let slash = -1;
  let i = 0;

  while (i < path.len()) {
    if (Bytes.get_u8(path, i) == "/".code) { slash = i; }
    i++;
  }
  if (slash < 0) { "." } else { Bytes.slice(path, 0, slash) }
};

let _modulePath = fn(root: Bytes, parts: Array<Bytes>): Bytes {
  let path = root;
  let i = 0;

  while (i < parts.len()) {
    path += "/" + parts[i];
    i++;
  }
  path + ".jello"
};

let _packageMatches = fn(packageName: Package, parts: Array<Bytes>): Bool {
  if (parts.len() == 1) { match (packageName) { None => true, _ => false } } else { match (packageName) {
    Path(packageParts) => {
      if (packageParts.len() != parts.len() - 1) { return false; }
      let i = 0;

      while (i < packageParts.len()) {
        if (packageParts[i] != parts[i]) { return false; }
        i++;
      }
      true
    },
    _ => false,
  } }
};

let _indexOf = fn(values: Array<Bytes>, value: Bytes): I32 {
  let i = 0;

  while (i < values.len()) {
    if (values[i] == value) { return i; }
    i++;
  }
  -1
};

let _modules = Array.new<Module>(0);
let _paths = Array.new<Bytes>(0);
let _visiting = Array.new<Bytes>(0);
let _root = ".";

let _load: (Bytes, Array<Bytes>) -> I32 = fn(_path, _parts) { -1 };
_load = fn(path, parts) {
  let loaded = _indexOf(_paths, path);
  if (loaded >= 0) { return loaded; }
  if (_indexOf(_visiting, path) >= 0) { throw "import cycle through " + path; }
  _visiting.push(path);
  let (tokens, sourcePath, starts, ends) = lexFileSource(readText(path), path);
  let program = parseSource(tokens, sourcePath, starts, ends);
  let syntax = programSyntax(program);

  let module = match (program) { Program(packageName, statements, tail) => {
    if (parts.len() == 0) {
      match (packageName) {
        None => null, _ => {
          throw "entry module must be package-less";
          null
        }
      };
    } else {
      if (!_packageMatches(packageName, parts)) { throw "module package does not match import path: " + path; }
      if (tail != null) { throw "dependency module cannot have a tail expression: " + path; }
    }
    let imports = Array.new<Import>(0);
    let locals = Array.new<Bytes>(0);
    let i = 0;

    while (i < statements.len()) {
      match (statements[i]) {
        ImportFrom(kind, items, importParts) => {
          let typeOnly = match (kind) {
            Value => false, TypeOnly => true, _ => {
              throw "macro and native imports are not supported";
              false
            }
          };
          let dependency = _load(_modulePath(_root, importParts), importParts);
          let j = 0;

          while (j < items.len()) {
            match (items[j]) { Item(name, alias) => {
              let local = name;
              if (alias != null) { local = alias; }
              if (_indexOf(locals, local) >= 0) { throw "duplicate import name: " + local; }
              locals.push(local);
              imports.push(Import.Import(local, dependency, name, typeOnly));
            } };
            j++;
          }
          null
        },
        ImportModule(_, _, _) => {
          throw "module namespace imports are not supported";
          null
        },
        _ => null,
      };
      i++;
    }
    Module.Module(sourcePath, statements, syntax, tail, imports)
  } };
  _visiting.pop();
  _modules.push(module);
  _paths.push(path);
  (_modules.len() - 1) as I32
};

export let loadModules: (Bytes) -> Array<Module> = fn(entryPath) {
  _modules = Array.new<Module>(0);
  _paths = Array.new<Bytes>(0);
  _visiting = Array.new<Bytes>(0);
  _root = _directory(entryPath);
  _load(entryPath, Array.new<Bytes>(0));
  _modules
};

export let modulePath: (Module) -> Bytes = fn(module) { match (module) { Module(path, _, _, _, _) => path } };
