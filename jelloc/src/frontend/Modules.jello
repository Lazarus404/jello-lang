package frontend;

import type {
  BinaryOp,
  Block as AstBlock,
  Expr,
  IntSize,
  ImportItem,
  ImportKind,
  Package,
  Pattern,
  Parameter,
  Program as AstProgram,
  Stmt,
} from frontend.Ast;
import { IntSize } from frontend.Ast;
import { lexFileSource } from frontend.Lexer;
import { parseSource, setSyntaxInfo } from frontend.Parser;
import type { SyntaxInfo, SyntaxKind } from frontend.Source;
import { readText } from std.io.File;

let _syntaxKindEq = fn(left: SyntaxKind, right: SyntaxKind): Bool {
  match (left) {
    Expression => match (right) { Expression => true, _ => false },
    Statement => match (right) { Statement => true, _ => false },
    Parameter => match (right) { Parameter => true, _ => false },
  }
};

let _appendStatementSyntax = fn(source: Array<SyntaxInfo>, ranges: Array<Tuple<I32, I32>>, statementIndex: I32, out: Array<SyntaxInfo>) {
  let (start, end) = ranges[statementIndex];
  let i = start;

  while (i < end) {
    out.push(source[i]);
    i++;
  }
  null
};

let _appendTailSyntax = fn(source: Array<SyntaxInfo>, start: I32, out: Array<SyntaxInfo>) {
  let i = start;

  while (i < source.len()) {
    out.push(source[i]);
    i++;
  }
  null
};

let _directory = fn(path: Bytes): Bytes {
  let slash = -1;
  let i = 0;

  while (i < path.len()) {
    if (Bytes.get_u8(path, i) == "/".code) { slash = i; }
    i++;
  }
  if (slash < 0) { "." } else { Bytes.slice(path, 0, slash) }
};

let _modulePath = fn(root: Bytes, parts: Array<Bytes>): Bytes {
  let path = root;
  let i = 0;

  while (i < parts.len()) {
    path += "/" + parts[i];
    i++;
  }
  path + ".jello"
};

let _packageMatches = fn(packageName: Package, parts: Array<Bytes>): Bool {
  if (parts.len() == 1) { match (packageName) { None => true, _ => false } } else { match (packageName) {
    Path(packageParts) => {
      if (packageParts.len() != parts.len() - 1) { return false; }
      let i = 0;

      while (i < packageParts.len()) {
        if (packageParts[i] != parts[i]) { return false; }
        i++;
      }
      true
    },
    _ => false,
  } }
};

let _constantExpr: (Expr) -> Bool = fn(expr) {
  match (expr) {
    Bool(_) => true,
    Integer(_, _) => true,
    Variable(_) => true,
    Binary(op, left, right) => match (op) {
      Add, Subtract, Equal, Less => _constantExpr(left) && _constantExpr(right),
      _ => false,
    },
    _ => false,
  }
};

let _indexOf = fn(values: Array<Bytes>, value: Bytes): I32 {
  let i = 0;

  while (i < values.len()) {
    if (values[i] == value) { return i; }
    i++;
  }
  -1
};

let _constantNames = Array.new<Bytes>(0);
let _constantKinds = Array.new<Bool>(0);
let _constantBools = Array.new<Bool>(0);
let _constantI32s = Array.new<I32>(0);
let _initializedModules = Array.new<Bytes>(0);

export let moduleInitializationOrder: () -> Array<Bytes> = fn() {
  let copy = Array.new<Bytes>(0);
  let i = 0;

  while (i < _initializedModules.len()) {
    copy.push(_initializedModules[i]);
    i++;
  }
  copy
};

let _constantValue: (Expr) -> Tuple<Bool, Bool, I32> = fn(expr) {
  match (expr) {
    Bool(value) => (true, value, 0),
    Integer(digits, _) => {
      let value = 0;
      let i = 0;

      while (i < digits.len()) {
        value = value * 10 + Bytes.get_u8(digits, i) - "0".code;
        i++;
      }
      (false, false, value)
    },
    Binary(op, left, right) => {
      let (leftBool, leftValue, leftI32) = _constantValue(left);
      let (rightBool, rightValue, rightI32) = _constantValue(right);
      if (leftBool || rightBool) { throw "imported constant arithmetic requires i32 operands"; }

      match (op) {
        Add => (false, false, leftI32 + rightI32),
        Subtract => (false, false, leftI32 - rightI32),
        Equal => (true, leftI32 == rightI32, 0),
        Less => (true, leftI32 < rightI32, 0),
        _ => {
          throw "unsupported imported constant operation";
          (false, false, 0)
        },
      }
    },
    _ => {
      throw "unsupported imported constant expression";
      (false, false, 0)
    },
  }
};

let _constantLiteral = fn(index: I32): Expr {
  if (_constantKinds[index]) { Expr.Bool(_constantBools[index]) } else { Expr.Integer(Std.string(_constantI32s[index]), IntSize.I32) }
};

let _copyNames = fn(names: Array<Bytes>): Array<Bytes> {
  let copy = Array.new<Bytes>(0);
  let i = 0;

  while (i < names.len()) {
    copy.push(names[i]);
    i++;
  }
  copy
};

let _renameName = fn(names: Array<Bytes>, canonical: Array<Bytes>, shadows: Array<Bytes>, name: Bytes): Bytes {
  if (_indexOf(shadows, name) >= 0) { return name; }
  let index = _indexOf(names, name);
  if (index < 0) { name } else { canonical[index] }
};

let _renameExpr: (Expr, Array<Bytes>, Array<Bytes>, Array<Bytes>) -> Expr = fn(expr, _a, _b, _c) { expr };

let _renameStatements: (Array<Stmt>, Array<Bytes>, Array<Bytes>, Array<Bytes>) -> Array<Stmt> =
  fn(statements, names, canonical, shadows) {
  let renamed = Array.new<Stmt>(0);
  let i = 0;

  while (i < statements.len()) {
    match (statements[i]) {
      LetStmt(isConst, exported, BindPattern(name), typeParams, annotation, value) => {
        renamed.push(Stmt.LetStmt(
          isConst, exported, Pattern.BindPattern(name), typeParams, annotation,
          _renameExpr(value, names, canonical, shadows)
        ));
        shadows.push(name);
      },
      Expression(value) => {
        renamed.push(Stmt.Expression(_renameExpr(value, names, canonical, shadows)));
        null
      },
      Return(value) => {
        let next: ?Expr = null;
        if (value != null) { next = _renameExpr(value, names, canonical, shadows); }
        renamed.push(Stmt.Return(next));
      },
      Throw(value) => {
        renamed.push(Stmt.Throw(_renameExpr(value, names, canonical, shadows)));
        null
      },
      While(condition, body) => {
        renamed.push(Stmt.While(
          _renameExpr(condition, names, canonical, shadows),
          _renameStatements(body, names, canonical, _copyNames(shadows))
        ));
        null
      },
      Break => {
        renamed.push(Stmt.Break);
        null
      },
      Continue => {
        renamed.push(Stmt.Continue);
        null
      },
      _ => {
        throw "unsupported statement while linking modules";
        null
      },
    };
    i++;
  }
  renamed
};

let _renameBlock = fn(block: AstBlock, names: Array<Bytes>, canonical: Array<Bytes>, shadows: Array<Bytes>): AstBlock {
  match (block) { Block(statements, tail) => {
    let localShadows = _copyNames(shadows);
    let renamedStatements = _renameStatements(statements, names, canonical, localShadows);
    let renamedTail: ?Expr = null;
    if (tail != null) { renamedTail = _renameExpr(tail, names, canonical, localShadows); }
    AstBlock.Block(renamedStatements, renamedTail)
  } }
};

_renameExpr = fn(expr, names, canonical, shadows) {
  match (expr) {
    Bool(value) => Expr.Bool(value),
    Integer(digits, size) => Expr.Integer(digits, size),
    Unary(op, value) => Expr.Unary(op, _renameExpr(value, names, canonical, shadows)),
    Variable(name) => {
      let renamed = _renameName(names, canonical, shadows, name);
      let constant = _indexOf(_constantNames, renamed);
      if (constant >= 0) { _constantLiteral(constant) } else { Expr.Variable(renamed) }
    },
    Binary(op, left, right) => Expr.Binary(
      op, _renameExpr(left, names, canonical, shadows), _renameExpr(right, names, canonical, shadows)
    ),
    Assign(op, Variable(name), value) => Expr.Assign(
      op, Expr.Variable(_renameName(names, canonical, shadows, name)),
      _renameExpr(value, names, canonical, shadows)
    ),
    Call(Variable(name), typeArgs, args) => {
      let renamedArgs = Array.new<Expr>(0);
      let i = 0;

      while (i < args.len()) {
        renamedArgs.push(_renameExpr(args[i], names, canonical, shadows));
        i++;
      }
      Expr.Call(Expr.Variable(_renameName(names, canonical, shadows, name)), typeArgs, renamedArgs)
    },
    If(condition, thenBranch, elseBranch) => Expr.If(
      _renameExpr(condition, names, canonical, shadows),
      _renameExpr(thenBranch, names, canonical, shadows),
      _renameExpr(elseBranch, names, canonical, shadows)
    ),
    BlockExpr(block) => Expr.BlockExpr(_renameBlock(block, names, canonical, shadows)),
    Function(params, result, body, isMethod) => {
      let functionShadows = _copyNames(shadows);
      let i = 0;

      while (i < params.len()) {
        match (params[i]) { Parameter(name, _, _) => functionShadows.push(name) };
        i++;
      }
      Expr.Function(params, result, _renameBlock(body, names, canonical, functionShadows), isMethod)
    },
    _ => {
      throw "unsupported expression while linking modules";
      Expr.Bool(false)
    },
  }
};

let _loadExport: (
  Bytes, Array<Bytes>, Bytes, Array<Stmt>, Array<SyntaxInfo>, Array<Bytes>, Array<Bytes>, Array<Bytes>
) -> Bytes = fn(root, parts, name, merged, mergedSyntax, loadedKeys, loadedModules, visiting) {
  let path = _modulePath(root, parts);
  let key = path + "#" + name;

  if (_indexOf(loadedModules, path) >= 0) {
    if (_indexOf(loadedKeys, key) < 0) { throw "unknown exported function: " + name; }
    return key;
  }
  if (_indexOf(visiting, path) >= 0) { throw "import cycle through " + path; }
  visiting.push(path);

  let (dependencyTokens, dependencyPath, dependencyStarts, dependencyEnds) = lexFileSource(readText(path), path);
  let (dependency, dependencySyntax, dependencyRanges, _) = parseSource(
    dependencyTokens, dependencyPath, dependencyStarts, dependencyEnds
  );
  let dependencyStatements = Array.new<Stmt>(0);

  match (dependency) {
    Program(dependencyPackage, statements, dependencyTail) => {
      if (!_packageMatches(dependencyPackage, parts)) { throw "module package does not match import path: " + path; }
      if (dependencyTail != null) { throw "dependency module cannot have a tail expression: " + path; }
      let statementIndex = 0;

      while (statementIndex < statements.len()) {
        dependencyStatements.push(statements[statementIndex]);
        statementIndex++;
      }
    },
  };

  let i = 0;

  while (i < dependencyStatements.len()) {
    match (dependencyStatements[i]) {
      ImportFrom(kind, _, _) => match (kind) {
        Value => null,
        _ => {
          throw "only named value imports are supported";
          null
        },
      },
      ImportModule(_, _, _) => {
        throw "module namespace imports are not supported";
        null
      },
      LetStmt(isConst, true, pattern, typeParams, annotation, value) => {
        match (pattern) {
          BindPattern(_) => null, _ => {
            throw "exported module values require names";
            null
          }
        };

        match (value) {
          Function(_, _, _, _) => null,
          _ => {
            if (!isConst || (typeParams.len() != 0) || (annotation != null) || !_constantExpr(value)) {
              throw "exported constants require an unannotated primitive constant expression";
            }
            null
          },
        }
      },
      _ => {
        throw "dependency modules may contain only imports and exported pure declarations";
        null
      },
    };
    i++;
  }

  let requestedExport = false;
  i = 0;

  while (i < dependencyStatements.len()) {
    match (dependencyStatements[i]) {
      LetStmt(_, true, BindPattern(exportName), _, _, _) => if (exportName == name) { requestedExport = true; },
      _ => null,
    };
    i++;
  }
  if (!requestedExport) { throw "unknown exported function: " + name; }
  let importNames = Array.new<Bytes>(0);
  let importCanonical = Array.new<Bytes>(0);
  i = 0;

  while (i < dependencyStatements.len()) {
    match (dependencyStatements[i]) {
      ImportFrom(_, items, importParts) => {
        let j = 0;

        while (j < items.len()) {
          match (items[j]) {
            Item(importName, alias) => {
              let importLocal = importName;
              if (alias != null) { importLocal = alias; }
              if (_indexOf(importNames, importLocal) >= 0) { throw "duplicate import name: " + importLocal; }
              importNames.push(importLocal);
              importCanonical.push(_loadExport(root, importParts, importName, merged, mergedSyntax, loadedKeys, loadedModules, visiting));
            },
          };
          j++;
        }
      },
      _ => null,
    };
    i++;
  }
  i = 0;

  while (i < dependencyStatements.len()) {
    match (dependencyStatements[i]) {
      LetStmt(isConst, true, BindPattern(exportName), typeParams, annotation, value) => {
        let exportKey = path + "#" + exportName;
        let renamedValue = _renameExpr(value, importNames, importCanonical, []);

        match (value) {
          Function(_, _, _, _) => {
            merged.push(Stmt.LetStmt(
              isConst, false, Pattern.BindPattern(exportKey), typeParams, annotation, renamedValue
            ));
            _appendStatementSyntax(dependencySyntax, dependencyRanges, i, mergedSyntax);
          },
          _ => {
            let (isBool, boolValue, i32Value) = _constantValue(renamedValue);
            _constantNames.push(exportKey);
            _constantKinds.push(isBool);
            _constantBools.push(boolValue);
            _constantI32s.push(i32Value);
          },
        };
        loadedKeys.push(exportKey);
      },
      _ => null,
    };
    i++;
  }
  loadedModules.push(path);
  _initializedModules.push(path);
  visiting.pop();
  key
};

export let loadProgramWithSyntax: (Bytes) -> Tuple<AstProgram, Array<SyntaxInfo>> = fn(entryPath) {
  let (entryTokens, parsedEntryPath, entryStarts, entryEnds) = lexFileSource(readText(entryPath), entryPath);
  let (entry, entrySyntax, entryRanges, entryTailStart) = parseSource(
    entryTokens, parsedEntryPath, entryStarts, entryEnds
  );

  match (entry) {
    Program(packageName, statements, tail) => {
      match (packageName) {
        None => null, _ => {
          throw "entry module must be package-less";
          null
        }
      };
      let merged = Array.new<Stmt>(0);
      let mergedSyntax = Array.new<SyntaxInfo>(0);
      let root = _directory(entryPath);
      let loadedKeys = Array.new<Bytes>(0);
      let loadedModules = Array.new<Bytes>(0);
      _constantNames = Array.new<Bytes>(0);
      _constantKinds = Array.new<Bool>(0);
      _constantBools = Array.new<Bool>(0);
      _constantI32s = Array.new<I32>(0);
      _initializedModules = Array.new<Bytes>(0);
      let visiting = Array.new<Bytes>(0);
      let importNames = Array.new<Bytes>(0);
      let importCanonical = Array.new<Bytes>(0);
      let entryStatements = Array.new<Stmt>(0);
      let i = 0;

      while (i < statements.len()) {
        match (statements[i]) {
          ImportFrom(kind, items, parts) => {
            match (kind) {
              Value => null, _ => {
                throw "only named value imports are supported";
                null
              }
            };
            let j = 0;

            while (j < items.len()) {
              match (items[j]) {
                Item(name, alias) => {
                  let localName = name;
                  if (alias != null) { localName = alias; }
                  if (_indexOf(importNames, localName) >= 0) { throw "duplicate import name: " + localName; }
                  importNames.push(localName);
                  importCanonical.push(_loadExport(root, parts, name, merged, mergedSyntax, loadedKeys, loadedModules, visiting));
                },
              };
              j++;
            }
            null
          },
          ImportModule(_, _, _) => {
            throw "module namespace imports are not supported";
            null
          },
          _ => {
            entryStatements.push(statements[i]);
            _appendStatementSyntax(entrySyntax, entryRanges, i, mergedSyntax);
            null
          },
        };
        i++;
      }
      let renamedEntry = _renameStatements(entryStatements, importNames, importCanonical, []);
      i = 0;

      while (i < renamedEntry.len()) {
        merged.push(renamedEntry[i]);
        i++;
      }
      let renamedTail: ?Expr = null;

      if (tail != null) {
        renamedTail = _renameExpr(tail, importNames, importCanonical, []);
        _appendTailSyntax(entrySyntax, entryTailStart, mergedSyntax);
      }
      _initializedModules.push(entryPath);
      (AstProgram.Program(Package.None, merged, renamedTail), mergedSyntax)
    },
  }
};

export let loadProgram: (Bytes) -> AstProgram = fn(entryPath) {
  let (program, sourceSyntax) = loadProgramWithSyntax(entryPath);
  setSyntaxInfo(sourceSyntax);
  program
};
