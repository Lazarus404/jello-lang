package frontend;

import type { Expr as AstExpr, Stmt } from frontend.Ast;
import { Op, declareEnum, defineVariants, fieldCount, fieldType, node, typeOf, variantTag } from frontend.Hir;
import { checkMatch } from frontend.CheckMatch;
import { internalError } from frontend.Internal;
import { declareScopedType, exportScopedType, scopedType } from frontend.ModuleScope;
import { checkOperand, checkType, enterSyntax, syntaxChild } from frontend.TypeCheck;

export let declareEnums: (Array<Stmt>, I32, Bool) -> Bool = fn(statements, module, opened) {
  let i = 0;

  while (i < statements.len()) {
    match (statements[i]) {
      Enum(exported, name, typeParams, _) => {
        let parent = enterSyntax(syntaxChild(i));
        if (typeParams.len() != 0) { throw "enum type parameters are not supported yet: " + name; }
        declareScopedType(name, declareEnum(name));
        if (exported || opened) { exportScopedType(module, name, exported); }
        enterSyntax(parent);
        null
      },
      _ => null,
    };
    i++;
  }
  i = 0;

  while (i < statements.len()) {
    match (statements[i]) {
      Enum(_, name, _, constructors) => {
        let parent = enterSyntax(syntaxChild(i));
        let names = Array.new<Bytes>(0);
        let fieldNames = Array.new<Array<Bytes>>(0);
        let fieldTypes = Array.new<Array<I32>>(0);
        let c = 0;

        while (c < constructors.len()) {
          match (constructors[c]) { Constructor(variant, fields) => {
            let v = 0;

            while (v < names.len()) {
              if (names[v] == variant) { throw "duplicate variant " + variant + " of " + name; }
              v++;
            }
            let fieldName = Array.new<Bytes>(0);
            let fieldType = Array.new<I32>(0);
            let f = 0;

            while (f < fields.len()) {
              match (fields[f]) {
                Field(field, ty) => {
                  fieldName.push(field);
                  fieldType.push(checkType(ty));
                }
              };
              f++;
            }
            names.push(variant);
            fieldNames.push(fieldName);
            fieldTypes.push(fieldType);
          } };
          c++;
        }
        defineVariants(scopedType(name), names, fieldNames, fieldTypes);
        enterSyntax(parent);
        null
      },
      _ => null,
    };
    i++;
  }
  true
};

let _construct = fn(enumName: Bytes, variant: Bytes, args: Array<AstExpr>, called: Bool): I32 {
  let ty = scopedType(enumName);
  let tag = variantTag(ty, variant);
  if (tag < 0) { throw "unknown variant " + variant + " of " + enumName; }
  let count = fieldCount(ty, tag);
  if ((called == (count == 0)) || (args.len() != count)) { throw "wrong payload count for enum variant " + enumName + "." + variant; }
  let fields = Array.new<I32>(0);
  let i = 0;

  while (i < count) {
    let field = checkOperand(args[i], i + 1, fieldType(ty, tag, i));

    if (typeOf(field) != fieldType(ty, tag, i)) {
      enterSyntax(syntaxChild(i + 1));
      throw "wrong payload type for enum variant " + enumName + "." + variant;
    }
    fields.push(field);
    i++;
  }
  node(Op.EnumNew, ty, tag, 0, fields)
};

export let checkEnumExpr: (AstExpr, I32, Bool) -> I32 = fn(expr, expected, statement) {
  match (expr) {
    Match(subject, arms) => checkMatch(subject, arms, expected, statement),
    Member(Variable(name), variant) => _construct(name, variant, Array.new<AstExpr>(0), false),
    Call(Member(Variable(name), variant), typeArgs, args) => {
      if (typeArgs.len() != 0) { throw "enum constructors do not take type arguments"; }
      _construct(name, variant, args, true)
    },
    _ => {
      internalError("expected an enum expression");
      -1
    },
  }
};
