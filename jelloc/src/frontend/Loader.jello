package frontend;

import type { Expr, Package, Stmt } from frontend.syntax.Ast;
import { bindPatternName, isBindPattern } from frontend.syntax.Ast;
import { appendFrom, indexOf } from support.Arrays;
import { lexFile } from frontend.syntax.Lexer;
import { noteFailure } from frontend.semantics.Failures;
import { packageSpan, parseProgram, programSyntax } from frontend.syntax.Parser;
import type { SourceSpan, Syntax } from frontend.syntax.Source;
import { SourceSpan } from frontend.syntax.Source;
import { locate } from frontend.syntax.Locations;
import { bytesLiteral, joined } from support.Text;
import { exists, readText } from std.io.File;

export enum Import {
  Import(local: Bytes, module: I32, name: Bytes, typeOnly: Bool, privately: Bool, statement: I32);
  Namespace(local: Bytes, module: I32, privately: Bool, statement: I32);
}

export enum Module {
  Module(path: Bytes, name: Bytes, statements: Array<Stmt>, syntax: Syntax, tail: ?Expr, imports: Array<Import>);
}

let _directory = fn(path: Bytes): Bytes {
  let slash = -1;
  let i = 0;

  while (i < path.len()) {
    if (Bytes.get_u8(path, i) == "/".code) { slash = i; }
    i++;
  }
  if (slash < 0) { "." } else { Bytes.slice(path, 0, slash) }
};

let _trimmed = fn(directory: Bytes): Bytes {
  let end = directory.len();
  while ((end > 1) && (Bytes.get_u8(directory, end - 1) == "/".code)) { end--; }
  Bytes.slice(directory, 0, end)
};

let _packageText = fn(parts: Array<Bytes>): Bytes {
  if (parts.len() == 0) { "no package" } else { "`package " + joined(parts, ".") + ";`" }
};

let _checkPackage = fn(path: Bytes, packageName: Package, parts: Array<Bytes>, declaration: ?SourceSpan): Bool {
  let declared = _packageText(match (packageName) { Path(packageParts) => packageParts, _ => Array.new<Bytes>(0) });
  let needed = appendFrom(Array.new<Bytes>(0), parts, 0);
  needed.pop();
  let expected = _packageText(needed);

  if (declared != expected) {
    throw noteFailure(declaration, "its package is declared here", path + " declares " + declared + ", but importing it as `" + joined(parts, ".") + "` needs " + expected);
  }
  true
};

let _localOf = fn(imported: Import): Bytes { match (imported) { Import(local, _, _, _, _, _), Namespace(local, _, _, _) => local } };

let _repeats = fn(imports: Array<Import>, added: Import): Bool {
  let i = 0;

  while (i < imports.len()) {
    if (_localOf(imports[i]) == _localOf(added)) {
      let allowed = match ((imports[i], added)) {
        (Import(_, module, name, typeOnly, _, _), Import(_, addedModule, addedName, addedTypeOnly, _, _)) =>
          (module == addedModule) && (name == addedName) && (typeOnly != addedTypeOnly),
        _ => false,
      };
      if (!allowed) { return true; }
    }
    i++;
  }
  false
};

let _modules = Array.new<Module>(0);
let _paths = Array.new<Bytes>(0);
let _importedAt = Array.new<?SourceSpan>(0);
let _visiting = Array.new<Bytes>(0);
let _roots = Array.new<Bytes>(0);
let _stdRoot = "";

let _extensionIndexes = Array.new<I32>(0);

let _failure: ?SourceSpan = null;

export let loadFailureSpan: () -> ?SourceSpan = fn() { _failure };

let _statementSpan = fn(syntax: Syntax, index: I32): SourceSpan {
  match (syntax) { Node(path, _, _, children, _) => match (children[index]) { Node(_, start, end, _, _) => SourceSpan.Span(path, start, end) } }
};

let _load: (Bytes, Array<Bytes>) -> I32 = fn(_path, _parts) { -1 };

let _modulePath = fn(parts: Array<Bytes>): Bytes {
  let roots = _roots;
  let relative = "";
  let i = 0;

  if (parts[0] == "std") {
    if (_stdRoot == "") { throw "module " + joined(parts, ".") + " is in the standard library; pass its directory with --std <dir> or set JELLO_STD_PATH"; }
    roots = [_stdRoot];
    i = 1;
  }

  while (i < parts.len()) {
    relative += "/" + parts[i];
    i++;
  }
  relative += ".jello";
  let tried = "";
  i = 0;

  while (i < roots.len()) {
    let path = roots[i] + relative;
    if ((indexOf(_paths, path) >= 0) || exists(path)) { return path; }
    tried += (i == 0 ? "" : ", ") + path;
    i++;
  }
  throw "module " + joined(parts, ".") + " not found: " + tried;
  ""
};

let _import = fn(parts: Array<Bytes>): I32 {
  let at = _failure;
  let dependency = _load(_modulePath(parts), parts);
  _failure = at;
  dependency
};

let _TEST = ".test";
let _TEST_FILE = _TEST + ".jello";

let _endsWith = fn(value: Bytes, suffix: Bytes): Bool {
  (value.len() >= suffix.len()) && (Bytes.slice(value, value.len() - suffix.len(), suffix.len()) == suffix)
};

let _tests = fn(parts: Array<Bytes>, imported: Array<Bytes>): Bool {
  if (parts.len() != imported.len()) { return false; }
  let last = parts.len() - 1;
  let i = 0;

  while (i < last) {
    if (parts[i] != imported[i]) { return false; }
    i++;
  }
  parts[last] == imported[last] + _TEST
};

export let isTestModule: (Bytes) -> Bool = fn(name) { _endsWith(name, _TEST) };

export let isTestName: (Bytes) -> Bool = fn(name) {
  (name.len() > 4) && (Bytes.slice(name, 0, 4) == "test") && (Bytes.get_u8(name, 4) >= "A".code) && (Bytes.get_u8(name, 4) <= "Z".code)
};

export let isHookName: (Bytes) -> Bool = fn(name) { (name == "beforeAll") || (name == "afterAll") };

let _module = fn(path: Bytes, text: Bytes, parts: Array<Bytes>, imports: Array<Import>): Module {
  let importing = _failure;
  _failure = null;
  let program = parseProgram(lexFile(text, path));
  let syntax = programSyntax(program);
  _failure = importing;

  match (program) { Program(packageName, statements, tail) => {
    if (parts.len() != 0) {
      _checkPackage(path, packageName, parts, packageSpan());

      if (tail != null) {
        _failure = _statementSpan(syntax, statements.len() as I32);
        throw "an imported module cannot end with an expression, since only the program's entry module has a result; end it with `;`";
      }
    }
    let dotted = joined(parts, ".");
    let testFile = isTestModule(dotted);
    let i = 0;

    while (i < statements.len()) {
      match (statements[i]) {
        ImportFrom(Native, _, _) => null,
        ImportFrom(kind, items, importParts) => {
          _failure = _statementSpan(syntax, i);

          let typeOnly = match (kind) {
            Value => false, TypeOnly => true, _ => {
              throw "macro imports are not supported";
              false
            }
          };
          let dependency = _import(importParts);
          let privately = testFile && _tests(parts, importParts);
          let j = 0;

          while (j < items.len()) {
            match (items[j]) { Item(name, alias) => {
              let added = Import.Import(alias == null ? name : alias, dependency, name, typeOnly, privately, i);
              if (_repeats(imports, added)) { throw "duplicate import name: " + _localOf(added); }
              imports.push(added);
            } };
            j++;
          }
          null
        },
        ImportModule(kind, importParts, alias) => {
          _failure = _statementSpan(syntax, i);

          match (kind) {
            Value => null,
            TypeOnly => {
              throw "a namespace import names values; import types with import type { T } from " + joined(importParts, ".");
              null
            },
            Native => {
              throw "a native library's exports are named: load { name } from " + joined(importParts, ".") + ";";
              null
            },
            _ => {
              throw "macro imports are not supported";
              null
            },
          };
          let added = Import.Namespace(alias, _import(importParts), testFile && _tests(parts, importParts), i);
          if (_repeats(imports, added)) { throw "duplicate import name: " + alias; }
          imports.push(added);
          null
        },
        _ => null,
      };
      i++;
    }
    _failure = null;
    Module.Module(path, dotted, statements, syntax, tail, imports)
  } }
};

let _add = fn(path: Bytes, module: Module, importedAt: ?SourceSpan): I32 {
  _modules.push(module);
  _paths.push(path);
  _importedAt.push(importedAt);
  (_modules.len() - 1) as I32
};

_load = fn(path, parts) {
  let loaded = indexOf(_paths, path);

  if (loaded >= 0) {
    let name = match (_modules[loaded]) { Module(_, dotted, _, _, _, _) => dotted };
    let dotted = joined(parts, ".");

    if (name != dotted) {
      throw noteFailure(_importedAt[loaded], "it is first imported here", path + " is imported as `" + name + "`, so it cannot also be imported as `" + dotted + "`");
    }
    return loaded;
  }
  if (indexOf(_visiting, path) >= 0) { throw "import cycle through " + path; }
  _visiting.push(path);
  let importing = _failure;
  let module = _module(path, readText(path), parts, Array.new<Import>(0));
  _visiting.pop();
  _add(path, module, importing)
};

export let hasExtension: (Bytes) -> Bool = fn(name) {
  try {
    _modulePath(["std", "core", name]);
    true
  } catch { false }
};

export let loadedExtensions: () -> Array<I32> = fn() { _extensionIndexes };

let _begin = fn(std: Bytes, roots: Array<Bytes>, extensions: Array<Bytes>) {
  _modules = Array.new<Module>(0);
  _paths = Array.new<Bytes>(0);
  _importedAt = Array.new<?SourceSpan>(0);
  _visiting = Array.new<Bytes>(0);
  _failure = null;
  _roots = Array.new<Bytes>(0);
  _stdRoot = _trimmed(std);
  let i = 0;

  while (i < roots.len()) {
    _roots.push(_trimmed(roots[i]));
    i++;
  }
  _extensionIndexes = Array.new<I32>(0);
  i = 0;

  while (i < extensions.len()) {
    let parts = ["std", "core", extensions[i]];
    _extensionIndexes.push(_load(_modulePath(parts), parts));
    i++;
  }
  null
};

export let loadModules: (Bytes, Bytes, Array<Bytes>, Array<Bytes>) -> Array<Module> = fn(entryPath, std, paths, extensions) {
  let roots = [_directory(entryPath)];
  let i = 0;

  while (i < paths.len()) {
    roots.push(paths[i]);
    i++;
  }
  _begin(std, roots, extensions);
  _load(entryPath, Array.new<Bytes>(0));
  _modules
};

let _testParts = fn(path: Bytes): Array<Bytes> {
  if (!_endsWith(path, _TEST_FILE)) { throw "a test file's name ends in " + _TEST_FILE + ": " + path; }
  let start = -1;
  let i = 0;

  while (i < _roots.len()) {
    let prefix = _roots[i] + "/";
    if ((prefix.len() > start) && (path.len() > prefix.len()) && (Bytes.slice(path, 0, prefix.len()) == prefix)) { start = prefix.len(); }
    i++;
  }
  if (start < 0) { throw "test file " + path + " is under no --path root"; }
  let parts = Array.new<Bytes>(0);
  let end = path.len() - _TEST_FILE.len() + _TEST.len();
  i = start;

  while (i <= end) {
    if ((i == end) || (Bytes.get_u8(path, i) == "/".code)) {
      parts.push(Bytes.slice(path, start, i - start));
      start = i + 1;
    }
    i++;
  }
  parts
};

let _suite = fn(index: I32, parts: Array<Bytes>, suites: Array<Bytes>, imports: Array<Import>) {
  let space = "_" + Std.string(imports.len());
  imports.push(Import.Namespace(space, index, true, -1));

  match (_modules[index]) { Module(path, _, statements, syntax, _, _) => {
    let file = joined(parts, "/");
    let name = Bytes.slice(file, 0, file.len() - _TEST.len());
    let cases = Array.new<Bytes>(0);
    let before = "none";
    let after = "none";
    let i = 0;

    while (i < statements.len()) {
      let declared = match (statements[i]) { LetStmt(_, _, pattern, _, _, _, _) when (isBindPattern(pattern)) => bindPatternName(pattern), _ => "" };

      if (declared == "beforeAll") { before = space + "." + declared; } else if (declared == "afterAll") { after = space + "." + declared; } else if (isTestName(declared)) {
        let (line, _) = match (_statementSpan(syntax, i)) { Span(_, start, _) => locate(path, start) };
        cases.push("(" + bytesLiteral(name + "/" + declared) + ", " + bytesLiteral(path + ":" + Std.string(line)) + ", " + space + "." + declared + ")");
      }
      i++;
    }
    if (cases.len() > 0) { suites.push("(" + bytesLiteral(name) + ", " + before + ", " + after + ", [" + joined(cases, ", ") + "])"); }
  } };
  null
};

let _relocated: (Syntax, Bytes, I32, I32) -> Syntax = fn(syntax, _path, _start, _end) { syntax };
_relocated = fn(syntax, path, start, end) {
  match (syntax) { Node(_, _, _, children, patterns) => {
    let movedChildren = Array.new<Syntax>(0);
    let movedPatterns = Array.new<Syntax>(0);
    let i = 0;

    while (i < children.len()) {
      movedChildren.push(_relocated(children[i], path, start, end));
      i++;
    }
    i = 0;

    while (i < patterns.len()) {
      movedPatterns.push(_relocated(patterns[i], path, start, end));
      i++;
    }
    Syntax.Node(path, start, end, movedChildren, movedPatterns)
  } }
};

export let loadTests: (Array<Bytes>, Bytes, Array<Bytes>, Array<Bytes>) -> Array<Module> = fn(files, std, paths, extensions) {
  _begin(std, paths, extensions);
  let names = Array.new<Array<Bytes>>(0);
  let i = 0;

  while (i < files.len()) {
    names.push(_testParts(files[i]));
    i++;
  }
  let testing = _import(["std", "testing"]);
  let suites = Array.new<Bytes>(0);
  let imports = Array.new<Import>(0);
  i = 0;

  while (i < files.len()) {
    if (indexOf(_paths, files[i]) < 0) { _suite(_load(files[i], names[i]), names[i], suites, imports); }
    i++;
  }
  let entry = "import { main } from std.testing;\nlet none = fn() { null };\nmain([" + joined(suites, ",\n  ") + "])\n";

  match (_module("", entry, Array.new<Bytes>(0), imports)) { Module(path, name, statements, syntax, tail, _) => {
    let relocated = match (_modules[testing]) { Module(_, _, _, at, _, _) => match (at) { Node(file, start, end, _, _) => _relocated(syntax, file, start, end) } };
    _add(path, Module.Module(path, name, statements, relocated, tail, imports), null);
  } };
  _modules
};

export let modulePath: (Module) -> Bytes = fn(module) { match (module) { Module(path, _, _, _, _, _) => path } };
export let moduleName: (Module) -> Bytes = fn(module) { match (module) { Module(_, name, _, _, _, _) => name } };
