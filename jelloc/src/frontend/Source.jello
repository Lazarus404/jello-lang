package frontend;

import { wideRanges, zeroWidthRanges } from frontend.UnicodeWidth;

export enum SourceSpan {
  Span(path: Bytes, start: I32, end: I32);
}

export enum SyntaxKind {
  Expression;
  Statement;
  Parameter;
  Pattern;
}

export enum SyntaxMark {
  Mark(kind: SyntaxKind, tag: I32, start: I32, end: I32);
}

export enum Syntax {
  Node(path: Bytes, start: I32, end: I32, children: Array<Syntax>, patterns: Array<Syntax>);
}

export let spanPath: (SourceSpan) -> Bytes = fn(span) { match (span) { Span(path, _, _) => path } };
export let spanStart: (SourceSpan) -> I32 = fn(span) { match (span) { Span(_, start, _) => start } };
export let spanEnd: (SourceSpan) -> I32 = fn(span) { match (span) { Span(_, _, end) => end } };

let _byteAt = fn(src: Bytes, i: I32): I32 {
  ((i < 0) || (i >= src.len())) ? -1 : Bytes.get_u8(src, i)
};

export let utf8CharLength: (Bytes, I32) -> I32 = fn(src, i) {
  let c = _byteAt(src, i);
  let n = (c < 0) ? 0 : (c < 128) ? 1 : (c < 194) ? 0 : (c < 224) ? 2 : (c < 240) ? 3 : (c < 245) ? 4 : 0;
  let lo = (c == 224) ? 160 : (c == 240) ? 144 : 128;
  let hi = (c == 237) ? 159 : (c == 244) ? 143 : 191;
  let k = 1;

  while ((k < n) && (_byteAt(src, i + k) >= ((k == 1) ? lo : 128))
    && (_byteAt(src, i + k) <= ((k == 1) ? hi : 191))) { k++; }
  (k == n) ? n : 0
};

let _codepoint = fn(src: Bytes, i: I32, n: I32): I32 {
  let c = Bytes.get_u8(src, i);
  let cp = (n == 1) ? c : (n == 2) ? c - 192 : (n == 3) ? c - 224 : c - 240;
  let k = 1;

  while (k < n) {
    cp = cp * 64 + Bytes.get_u8(src, i + k) - 128;
    k++;
  }
  cp
};

let _rangeBound = fn(table: Bytes, i: I32, end: I32): I32 {
  let v = 0;
  let k = 0;

  while (k < 6) {
    let c = Bytes.get_u8(table, i * 12 + end + k);
    v = v * 16 + ((c <= "9".code) ? c - "0".code : c - "a".code + 10);
    k++;
  }
  v
};

let _inRanges = fn(table: Bytes, cp: I32): Bool {
  let lo = 0;
  let hi = table.len() / 12;

  while (lo < hi) {
    let mid = (lo + hi) / 2;
    if (_rangeBound(table, mid, 6) < cp) { lo = mid + 1; } else { hi = mid; }
  }
  (lo < table.len() / 12) && (_rangeBound(table, lo, 0) <= cp)
};

let _codepointWidth = fn(cp: I32): I32 {
  (cp < 128) ? 1 : _inRanges(zeroWidthRanges, cp) ? 0 : _inRanges(wideRanges, cp) ? 2 : 1
};

let _step = fn(source: Bytes, i: I32): I32 {
  let n = utf8CharLength(source, i);
  (n == 0) ? 1 : n
};

let _lineStart = fn(source: Bytes, offset: I32): I32 {
  let i = offset;
  while ((i > 0) && (Bytes.get_u8(source, i - 1) != "\n".code)) { i--; }
  i
};

export let sourceLocation: (Bytes, I32) -> Tuple<I32, I32> = fn(source, offset) {
  let line = 1;
  let column = 1;
  let i = 0;

  while (i < offset) {
    if (Bytes.get_u8(source, i) == "\n".code) {
      line++;
      column = 1;
      i++;
    } else {
      column++;
      i += _step(source, i);
    }
  }
  (line, column)
};

export let lineStarts: (Bytes) -> Array<I32> = fn(source) {
  let starts = [0];
  let i = 0;

  while (i < source.len()) {
    if (Bytes.get_u8(source, i) == "\n".code) { starts.push(i + 1); }
    i++;
  }
  starts
};

export let lineColumn: (Bytes, Array<I32>, I32) -> Tuple<I32, I32> = fn(source, starts, offset) {
  let low = 0;
  let high = (starts.len() as I32) - 1;

  while (low < high) {
    let middle = (low + high + 1) / 2;
    if (starts[middle] <= offset) { low = middle; } else { high = middle - 1; }
  }
  let column = 1;
  let i = starts[low];

  while (i < offset) {
    column++;
    i += _step(source, i);
  }
  (low + 1, column)
};

export let sourceDiagnostic: (Bytes, Bytes, I32, Bytes) -> Bytes = fn(path, source, offset, message) {
  let (line, column) = sourceLocation(source, offset);
  let start = _lineStart(source, offset);
  let end = offset;
  while ((end < source.len()) && (Bytes.get_u8(source, end) != "\n".code)) { end++; }
  let caret = "";
  let i = start;

  while (i < offset) {
    let n = utf8CharLength(source, i);
    let width = (n == 0) ? 1 : _codepointWidth(_codepoint(source, i, n));
    caret += (Bytes.get_u8(source, i) == "\t".code) ? "\t" : (width == 2) ? "  " : (width == 1) ? " " : "";
    i += (n == 0) ? 1 : n;
  }
  path + ":" + Std.string(line) + ":" + Std.string(column) + ": " + message + "\n"
    + Bytes.slice(source, start, end - start) + "\n" + caret + "^"
};
