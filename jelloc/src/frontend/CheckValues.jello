package frontend;

import type { BinaryOp, Expr as AstExpr, Type as AstType } from frontend.Ast;
import { BinaryOp } from frontend.Ast;
import frontend.Hir as H;
import { internalError } from frontend.Internal;
import { Kind, Op } from frontend.Hir;
import { binaryValues, bufferHint, checkOperand, checkType, enterSyntax, hideValue, integerConversion, isNullaryVariant, presentAt, presentKnown, syntaxChild } from frontend.TypeCheck;

let _bool = fn(op: Op, children: Array<I32>): I32 { H.node(op, H.TYPE_BOOL, 0, 0, children) };

let _lifted = fn(id: I32): I32 { match (H.opOf(id)) { Present => H.childOf(id, 0), _ => id } };

let _present = fn(binding: I32, ty: I32): I32 {
  H.isKind(ty, Kind.Null) ? H.node(Op.Unwrap, H.innerOf(ty), 0, 0, [H.local(binding, ty)]) : H.local(binding, ty)
};

export let equalityOperands: (AstExpr, AstExpr, I32) -> Tuple<I32, I32> = fn(leftExpr, rightExpr, first) {
  let left = presentKnown(checkOperand(leftExpr, first, -1));
  let leftType = H.typeOf(left);
  let inner = H.isKind(leftType, Kind.Null) ? H.innerOf(leftType) : leftType;
  let context = (leftType == H.TYPE_DYNAMIC) ? -1 : H.isKind(inner, Kind.List) ? inner : H.nullType(inner);
  (left, presentKnown(_lifted(checkOperand(rightExpr, first + 1, context))))
};

export let bindOnce: (Array<I32>, Bytes, I32) -> I32 = fn(statements, name, value) {
  isNullaryVariant(value) ? -1 : hideValue(statements, name, value)
};

export let orThrow: (I32, I32) -> I32 = fn(condition, message) {
  let thrown = H.node(Op.Block, H.TYPE_NULL, 0, 1, [H.node(Op.Throw, 0, 0, 0, [message]), H.node(Op.Null, H.TYPE_NULL, 0, 0, [])]);
  H.node(Op.If, H.TYPE_NULL, 0, 0, [condition, H.node(Op.Null, H.TYPE_NULL, 0, 0, []), thrown])
};

let _read = fn(binding: I32, value: I32): I32 { binding < 0 ? value : H.local(binding, H.typeOf(value)) };

let _negated = fn(op: BinaryOp, equal: I32): I32 { match (op) { NotEqual => _bool(Op.Not, [equal]), _ => equal } };

let _dynamicPresentEqual = fn(d: I32, ty: I32, value: I32): I32 {
  if (ty == H.TYPE_DYNAMIC) { throw "two Dynamic values cannot be compared; extract one with `as T`"; }
  if (ty == H.TYPE_U64) { throw "a Dynamic cannot be compared with a U64, which it never holds"; }

  if (!H.isIntegerType(ty) && (_checkedKind(ty) < 0)) {
    throw "a Dynamic compares only with null or a value `is` can test, not " + H.typeName(ty) + _UNCHECKED;
  }
  let held = H.isIntegerType(ty) ? H.TYPE_I64 : ty;
  let compared = (ty == held) ? value : H.node(Op.Convert, held, 0, 0, [value]);
  let extracted = H.node(Op.FromDynamic, held, 0, 0, [H.local(d, H.TYPE_DYNAMIC)]);
  _bool(Op.And, [kindTest(H.local(d, H.TYPE_DYNAMIC), held), binaryValues(BinaryOp.Equal, extracted, compared)])
};

let _dynamicEqual = fn(d: I32, v: I32, value: I32): I32 {
  let ty = H.defaultIntegers(H.typeOf(value));
  if (!H.isKind(ty, Kind.Null)) { return _dynamicPresentEqual(d, ty, _read(v, value)); }
  let present = _dynamicPresentEqual(d, H.innerOf(ty), _present(v, ty));
  H.node(Op.If, H.TYPE_BOOL, 0, 0, [_bool(Op.IsNull, [H.local(v, ty)]), _bool(Op.IsNull, [H.local(d, H.TYPE_DYNAMIC)]), present])
};

export let equalBindings: (BinaryOp, I32, I32, I32, I32) -> I32 = fn(op, a, left, b, right) {
  let leftType = H.typeOf(left);
  let rightType = H.typeOf(right);
  if (leftType == H.TYPE_DYNAMIC) { return _negated(op, _dynamicEqual(a, b, right)); }
  if (rightType == H.TYPE_DYNAMIC) { return _negated(op, _dynamicEqual(b, a, left)); }
  let leftNull = H.isKind(leftType, Kind.Null);
  let rightNull = H.isKind(rightType, Kind.Null);
  if (!leftNull && !rightNull) { return binaryValues(op, _read(a, left), _read(b, right)); }
  let inner = leftNull ? H.innerOf(leftType) : leftType;
  if ((rightNull ? H.innerOf(rightType) : rightType) != inner) { throw "cannot compare " + H.typeName(leftType) + " with " + H.typeName(rightType); }
  let equal = binaryValues(BinaryOp.Equal, a < 0 ? left : _present(a, leftType), b < 0 ? right : _present(b, rightType));
  _negated(op, (leftNull && rightNull)
    ? H.node(Op.If, H.TYPE_BOOL, 0, 0, [
      _bool(Op.IsNull, [H.local(a, leftType)]), _bool(Op.IsNull, [H.local(b, rightType)]),
      _bool(Op.And, [_bool(Op.IsPresent, [H.local(b, rightType)]), equal])])
    : _bool(Op.And, [_bool(Op.IsPresent, [leftNull ? H.local(a, leftType) : H.local(b, rightType)]), equal]))
};

export let equalValues: (BinaryOp, I32, I32) -> I32 = fn(op, left, right) {
  let plain = fn(ty: I32): Bool { !H.isKind(ty, Kind.Null) && (ty != H.TYPE_DYNAMIC) };
  if (plain(H.typeOf(left)) && plain(H.typeOf(right))) { return binaryValues(op, left, right); }
  let statements = Array.new<I32>(0);
  let a = bindOnce(statements, "left", left);
  let b = bindOnce(statements, "right", right);
  statements.push(equalBindings(BinaryOp.Equal, a, left, b, right));
  _negated(op, H.node(Op.Block, H.TYPE_BOOL, 0, 1, statements))
};

let _equality = fn(op: BinaryOp, leftExpr: AstExpr, rightExpr: AstExpr): I32 {
  let (left, right) = equalityOperands(leftExpr, rightExpr, 0);
  equalValues(op, left, right)
};

let _checkedKind = fn(ty: I32): I32 {
  match (H.kindOf(ty)) {
    Bool => H.KIND_BOOL, I32 => H.KIND_I32, Bytes => H.KIND_BYTES, I64 => H.KIND_I64, Atom => H.KIND_ATOM, Enum => H.KIND_ENUM,
    F64 => H.KIND_F64, F32 => H.KIND_F32, F16 => H.KIND_F16,
    _ => -1,
  }
};
let _UNCHECKED: Bytes = ": only Bool, I32, I64, F16, F32, F64, Atom, Bytes and enums are checked";

export let toDynamic: (I32) -> I32 = fn(operand) {
  let ty = H.typeOf(operand);
  if (ty == H.TYPE_BYTE_BUFFER) { throw "a buffer from Bytes.new cannot become Dynamic" + bufferHint(ty); }
  if (H.isKind(ty, Kind.List)) { throw "a list cannot become Dynamic: its nil would read as null"; }
  let held = (H.isKind(ty, Kind.Null) && (H.innerOf(ty) >= 0)) ? H.resolve(H.innerOf(ty)) : ty;
  if (held == H.TYPE_U64) { throw "a " + H.typeName(ty) + " cannot become Dynamic: one above the greatest I64 would read as negative"; }
  if ((held == H.TYPE_U32) && (held != ty)) { throw "a " + H.typeName(ty) + " cannot become Dynamic: one above the greatest I32 would read as negative"; }
  H.node(Op.ToDynamic, H.TYPE_DYNAMIC, 0, 0, [operand])
};

let _cast = fn(value: AstExpr, targetType: AstType): I32 {
  let target = checkType(targetType);
  let operand = checkOperand(value, 0, -1);
  let ty = H.typeOf(operand);
  if (ty == target) { return operand; }
  if (ty == H.TYPE_BYTE_BUFFER) { throw "`as` cannot convert a buffer from Bytes.new" + bufferHint(ty); }
  if (target == H.TYPE_DYNAMIC) { return toDynamic(operand); }

  if (ty == H.TYPE_DYNAMIC) {
    if (_checkedKind(target) < 0) { throw "cannot extract " + H.typeName(target) + " from Dynamic" + _UNCHECKED; }
    return H.node(Op.FromDynamic, target, 0, 0, [operand]);
  }
  let present = presentAt(operand, 0);
  if (H.typeOf(present) == target) { return present; }

  match ((H.kindOf(H.typeOf(present)), H.kindOf(target))) {
    (Var, _) when (H.isInteger(H.typeOf(present)) && H.isIntegerType(target)) => integerConversion(present, target),
    _ when (H.isIntegerType(H.typeOf(present)) && H.isIntegerType(target)) => H.node(Op.Convert, target, 0, 0, [present]),
    _ when ((H.isInteger(H.typeOf(present)) || H.isFloatType(H.typeOf(present))) && H.isNumberType(target)) => {
      H.defaultIntegers(H.typeOf(present));
      H.node(Op.Convert, target, 0, 0, [present])
    },
    _ => {
      throw "cannot convert " + H.typeName(ty) + " to " + H.typeName(target);
      -1
    },
  }
};

export let kindTest: (I32, I32) -> I32 = fn(operand, target) {
  let code = _checkedKind(target);
  if (code < 0) { throw "is cannot test for " + H.typeName(target) + _UNCHECKED; }
  H.node(Op.IsKind, H.TYPE_BOOL, code, code == H.KIND_ENUM ? target : 0, [operand])
};

let _is = fn(value: AstExpr, targetType: AstType): I32 {
  let operand = checkOperand(value, 0, -1);

  if (H.typeOf(operand) != H.TYPE_DYNAMIC) {
    enterSyntax(syntaxChild(0));
    throw "is tests a Dynamic value, not " + H.typeName(H.typeOf(operand));
  }
  kindTest(operand, checkType(targetType))
};

export let checkValueExpr: (AstExpr, I32) -> I32 = fn(expr, _expected) {
  match (expr) {
    Binary(op, left, right) => _equality(op, left, right),
    Cast(value, ty) => _cast(value, ty),
    Is(value, ty) => _is(value, ty),
    _ => {
      internalError("expected a cast, kind test or comparison");
      -1
    },
  }
};
