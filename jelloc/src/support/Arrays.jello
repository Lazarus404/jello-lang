package support;

export let indexOf<T: Eq> = fn(values: Array<T>, value: T): I32 {
  let i = 0;

  while (i < values.len()) {
    if (values[i] == value) { return i; }
    i++;
  }
  -1
};

export let internIndex<T: Eq> = fn(values: Array<T>, value: T): I32 {
  let found = indexOf(values, value);
  if (found >= 0) { return found; }
  values.push(value);
  values.len() - 1
};

export let appendFrom<T> = fn(out: Array<T>, values: Array<T>, start: I32): Array<T> {
  let i = start;

  while (i < values.len()) {
    out.push(values[i]);
    i++;
  }
  out
};
