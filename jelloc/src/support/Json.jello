package support;

/** @file
 * A JSON reader for the project's manifest, `jello.json`, which `Project` reads. It parses
 * RFC 8259 JSON into `Json` values, each with the byte offset it starts at, so that a manifest's
 * errors point into the file. Numbers keep their text, since a manifest holds none it computes
 * with. */

import { hexValue } from support.Text;
import { u8, utf8FromCodepoint } from std.core.Bytes;

/** A JSON value, starting at byte offset `at` of its text. An object keeps its keys in order, a
 * repeated key once for each time it appears. */
export enum Json {
  Null(at: I32);
  Bool(at: I32, value: Bool);
  Number(at: I32, text: Bytes);
  Text(at: I32, value: Bytes);
  List(at: I32, items: Array<Json>);
  Object(at: I32, keys: Array<Bytes>, values: Array<Json>);
}

// Returns the byte offset that `value` starts at.
export let jsonAt = fn(value: Json): I32 {
  match (value) {
    Null(at), Bool(at, _), Number(at, _), Text(at, _), List(at, _), Object(at, _, _) => at,
  }
};

/** Returns the value of `key` in `value`, the last if it repeats, or null when `value` is no
 * object or has no such key. */
export let jsonField = fn(value: Json, key: Bytes): ?Json {
  match (value) {
    Object(_, keys, values) => {
      let i = keys.len() - 1;

      while (i >= 0) {
        if (keys[i] == key) { return values[i]; }
        i--;
      }
      null
    },
    _ => null,
  }
};

// The text being read, and the offset of the next byte.
let _text = "";
let _pos = 0;

// A parse error at `at`, which `parseJson` reports with its offset.
let _errorAt = -1;

// Throws `message`, located at offset `at`.
let _fail = fn(at: I32, message: Bytes): Null {
  _errorAt = at;
  throw message;
};

// Returns the next byte, or -1 at the end.
let _peek = fn(): I32 { _pos < _text.len() ? Bytes.get_u8(_text, _pos) : -1 };

// Skips spaces, tabs, newlines and carriage returns.
let _skipSpace = fn() {
  while ((_peek() == 32) || (_peek() == 9) || (_peek() == 10) || (_peek() == 13)) { _pos++; }
  null
};

/** Consumes `word` if it is next.
 * @return whether it was */
let _accept = fn(word: Bytes): Bool {
  let fits = _pos + word.len() <= _text.len();
  if (!fits || (Bytes.slice(_text, _pos, word.len()) != word)) { return false; }
  _pos += word.len();
  true
};

/** Reads the four hex digits of a `\u` escape, `_pos` at the first.
 * @return the code unit */
let _codeUnit = fn(): I32 {
  let unit = 0;
  let i = 0;

  while (i < 4) {
    let digit = hexValue(_peek());
    if (digit < 0) { _fail(_pos, "expected four hex digits after \\u"); }
    unit = unit * 16 + digit;
    _pos++;
    i++;
  }
  unit
};

/** Reads a string, `_pos` at its opening quote, decoding its escapes; a surrogate pair is one
 * codepoint, and a lone surrogate an error.
 * @return the string's bytes */
let _string = fn(): Bytes {
  let start = _pos;
  _pos++;

  let parts = Array.new<Bytes>(0);
  let run = _pos;

  while (_peek() != "\"".code) {
    let c = _peek();
    if (c < 0) { _fail(start, "unterminated string"); }
    if (c < 32) { _fail(_pos, "control character in string"); }

    if (c == "\\".code) {
      parts.push(Bytes.slice(_text, run, _pos - run));
      let escape = _pos;
      _pos++;
      let e = _peek();
      _pos++;
      parts.push(match (e) {
        "\"".code => "\"",
        "\\".code => "\\",
        "/".code => "/",
        "b".code => u8(8),
        "f".code => u8(12),
        "n".code => "\n",
        "r".code => "\r",
        "t".code => "\t",
        "u".code => {
          let lone = "lone surrogate in \\u escape";
          let unit = _codeUnit();
          if ((unit >= 0xDC00) && (unit <= 0xDFFF)) { _fail(escape, lone); }

          if ((unit >= 0xD800) && (unit <= 0xDBFF)) {
            if (!_accept("\\u")) { _fail(escape, lone); }
            let low = _codeUnit();
            if ((low < 0xDC00) || (low > 0xDFFF)) { _fail(escape, lone); }
            unit = 0x10000 + (unit - 0xD800) * 1024 + (low - 0xDC00);
          }
          utf8FromCodepoint(unit)
        },
        _ => {
          _fail(escape, "unknown escape in string");
          ""
        },
      });
      run = _pos;
    } else {
      _pos++;
    }
  }
  parts.push(Bytes.slice(_text, run, _pos - run));
  _pos++;
  parts.join("")
};

/** Consumes the digits next.
 * @return how many there were */
let _digits = fn(): I32 {
  let start = _pos;
  while ((_peek() >= "0".code) && (_peek() <= "9".code)) { _pos++; }
  _pos - start
};

// Reads a number, `_pos` at its first byte.
let _number = fn(): Json {
  let start = _pos;
  _accept("-");
  let first = _peek();
  let count = _digits();
  if (count == 0) { _fail(start, "expected a value"); }
  if ((first == "0".code) && (count > 1)) { _fail(start, "a number cannot start with 0"); }
  if (_accept(".") && (_digits() == 0)) { _fail(_pos, "expected digits after ."); }

  if ((_peek() == "e".code) || (_peek() == "E".code)) {
    _pos++;
    if (!_accept("+")) { _accept("-"); }
    if (_digits() == 0) { _fail(_pos, "expected digits in exponent"); }
  }
  Json.Number(start, Bytes.slice(_text, start, _pos - start))
};

// Reads a value, after any space before it.
let _value = fn(): Json {
  _skipSpace();
  let start = _pos;

  match (_peek()) {
    "{".code => {
      _pos++;
      _skipSpace();
      let keys = Array.new<Bytes>(0);
      let values = Array.new<Json>(0);
      if (_accept("}")) { return Json.Object(start, keys, values); }

      while (true) {
        _skipSpace();
        if (_peek() != "\"".code) { _fail(_pos, "expected a string key"); }
        keys.push(_string());
        _skipSpace();
        if (!_accept(":")) { _fail(_pos, "expected : after key"); }
        values.push(_value());
        _skipSpace();
        if (_accept("}")) { return Json.Object(start, keys, values); }
        if (!_accept(",")) { _fail(_pos, "expected , or } in object"); }
      }
      Json.Null(start)
    },
    "[".code => {
      _pos++;
      _skipSpace();
      let items = Array.new<Json>(0);
      if (_accept("]")) { return Json.List(start, items); }

      while (true) {
        items.push(_value());
        _skipSpace();
        if (_accept("]")) { return Json.List(start, items); }
        if (!_accept(",")) { _fail(_pos, "expected , or ] in array"); }
      }
      Json.Null(start)
    },
    "\"".code => Json.Text(start, _string()),
    _ => {
      if (_accept("null")) {
        Json.Null(start)
      } else if (_accept("true")) {
        Json.Bool(start, true)
      } else if (_accept("false")) {
        Json.Bool(start, false)
      } else {
        _number()
      }
    },
  }
};

/** Parses `text` as one JSON value, with nothing but space after it.
 * @return the value, or the message and offset of the first error */
export let parseJson = fn(text: Bytes): Tuple<?Json, Bytes, I32> {
  _text = text;
  _pos = 0;
  _errorAt = -1;

  try {
    let value = _value();
    _skipSpace();
    if (_pos < _text.len()) { _fail(_pos, "unexpected text after the value"); }
    (value, "", -1)
  } catch (e) {
    (null, Std.string(e), _errorAt)
  }
};
