package support;

/** @file
 * Text the compiler reads and writes: hex digits, bytes written back as a literal the lexer
 * reads, and the names closest to a misspelt one, for diagnostics. Indexes count bytes. */

import { toHex } from std.core.Bytes;

/** Returns the value of `c`, a byte or -1, as a hexadecimal digit in either case.
 * @return 0 to 15, or -1 if `c` is not a hex digit */
export let hexValue = fn(c: I32): I32 {
  if ((c >= "0".code) && (c <= "9".code)) {
    c - "0".code
  } else if ((c >= "a".code) && (c <= "f".code)) {
    c - "a".code + 10
  } else if ((c >= "A".code) && (c <= "F".code)) {
    c - "A".code + 10
  } else {
    -1
  }
};

/** Writes `value` as a double-quoted Jello bytes literal that lexes back to the same bytes. A
 * newline, carriage return, tab, double quote or backslash is written as its backslash escape,
 * other printable ASCII as itself, and every other byte as a lower-case `\xHH` escape. */
export let bytesLiteral = fn(value: Bytes): Bytes {
  let out = ["\""];

  for (i, c in value) {
    out.push(match (c) {
      "\n".code => "\\n",
      "\r".code => "\\r",
      "\t".code => "\\t",
      "\"".code => "\\\"",
      "\\".code => "\\\\",
      _ => ((c >= 32) && (c <= 126))
        ? Bytes.slice(value, i, 1)
        : `\\x${toHex(Bytes.slice(value, i, 1))}`,
    });
  }
  out.push("\"");
  out.join("")
};

/** Returns the edit distance between `a` and `b`; the fewest byte insertions, deletions and
 * substitutions that turn one into the other. */
let _editDistance = fn(a: Bytes, b: Bytes): I32 {
  let previous = Array.new<I32>(0);
  let j = 0;

  while (j <= b.len()) {
    previous.push(j);
    j++;
  }

  let i = 1;

  while (i <= a.len()) {
    let row = [i];
    j = 1;

    while (j <= b.len()) {
      let cost = Bytes.get_u8(a, i - 1) == Bytes.get_u8(b, j - 1) ? 0 : 1;
      let best = previous[j - 1] + cost;
      if (previous[j] + 1 < best) { best = previous[j] + 1; }
      if (row[j - 1] + 1 < best) { best = row[j - 1] + 1; }
      row.push(best);
      j++;
    }
    previous = row;
    i++;
  }
  previous[b.len()]
};

/** Returns up to three of `names` closest to `name` by edit distance, nearest first and in their
 * order among equals, leaving out any too far from it to be a likely misspelling. */
export let closestNames = fn(names: Array<Bytes>, name: Bytes): Array<Bytes> {
  let limit = name.len() / 3 > 2 ? name.len() / 3 : 2;
  let distances = Array.new<I32>(0);

  for (candidate in names) {
    distances.push(_editDistance(candidate, name));
  }

  // Nearest first: one sweep per distance, as names are few and typos fewer.
  let found = Array.new<Bytes>(0);
  let distance = 0;

  while ((distance <= limit) && (found.len() < 3)) {
    let i = 0;

    while ((i < names.len()) && (found.len() < 3)) {
      if (distances[i] == distance) { found.push(names[i]); }
      i++;
    }
    distance++;
  }
  found
};
