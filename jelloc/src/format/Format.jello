package format;

/** @file
 * The layout rules of `jelloc fmt`. `formatSource` lexes a file, splits it into lines of pieces
 * (`format.Trivia`), and then lays the lines out again: comments at the end of a line move above
 * it, statements sharing a line get a line each, an opening brace on a line of its own joins the
 * line before, each line is indented by the brackets left open above it, blank lines are
 * collapsed and added above blocks and functions, a comment alone on one line becomes a line
 * comment, and runs of line comments become block comments, wrapped to the line width. Newlines
 * are only whitespace to the lexer, so none of this changes what a program means; the result is
 * lexed again and must give the same tokens, or it is not used. */

import { Token, lexFile } from frontend.syntax.Lexer;
import type { Line, Piece } from format.Trivia;
import { PieceKind, codePiece, commentPiece, sourceLines } from format.Trivia;
import { indexOf, split } from std.core.Bytes;

// How files are laid out; the settings of a `.formatter` file.
export typedef Style = {
  // The spaces of one level of indentation.
  let indent: I32;
  // The code points a comment-only line may take, its indentation included.
  let lineWidth: I32;
  // Whether comments are removed.
  let stripComments: Bool;
  // Whether doc comments, which open with slash-star-star, survive `stripComments`.
  let keepDocComments: Bool;
  // Whether comments are rearranged; without it, each comment's text is kept as it is.
  let rewriteComments: Bool;
  // Whether a block or function on one line also gets a blank line above it.
  let blankBeforeOneLineBlocks: Bool;
};

// Returns the style used where a `.formatter` file says nothing.
export let defaultStyle = fn(): Style {
  {
    indent: 2,
    lineWidth: 100,
    stripComments: false,
    keepDocComments: true,
    rewriteComments: true,
    blankBeforeOneLineBlocks: false,
  }
};

// Checks whether `piece` is code, not a comment.
let _isCode = fn(piece: Piece): Bool {
  match (piece.kind) {
    Code => true,
    _ => false,
  }
};

// Checks whether `piece` is code that opens a bracket.
let _opens = fn(piece: Piece): Bool {
  _isCode(piece) && match (piece.token) {
    LBrace, LParen, LBracket => true,
    _ => false,
  }
};

// Checks whether `piece` is code that closes a bracket.
let _closes = fn(piece: Piece): Bool {
  _isCode(piece) && match (piece.token) {
    RBrace, RParen, RBracket => true,
    _ => false,
  }
};

// Checks whether `piece` is the code `token`.
let _is = fn(piece: Piece, token: Token): Bool { _isCode(piece) && (piece.token == token) };

// Returns the index of the first code piece of `line`, or -1 when it holds only comments.
let _firstCode = fn(line: Line): I32 {
  let k = 0;
  while ((k < line.pieces.len()) && !_isCode(line.pieces[k])) { k++; }
  k < line.pieces.len() ? k : -1
};

// Returns the index of the last code piece of `line`, or -1 when it holds only comments.
let _lastCode = fn(line: Line): I32 {
  let k = line.pieces.len() - 1;
  while ((k >= 0) && !_isCode(line.pieces[k])) { k--; }
  k
};

// Checks whether `line` ends with code that opens a bracket.
let _endsOpen = fn(line: Line): Bool {
  let last = line.pieces.len() - 1;
  _opens(line.pieces[last])
};

// Returns the pieces of `pieces` from `start` up to `to`.
let _range = fn(pieces: Array<Piece>, start: I32, to: I32): Array<Piece> {
  let out = Array.new<Piece>(0);
  let k = start;

  while (k < to) {
    out.push(pieces[k]);
    k++;
  }
  out
};

// Checks whether `piece` is a doc comment, one that opens with slash-star-star.
let _isDoc = fn(piece: Piece): Bool {
  match (piece.kind) {
    BlockComment => piece.text.startsWith("/**") && (piece.text != "/**/"),
    _ => false,
  }
};

/** Returns each line of `lines` that holds only a block comment on one line, slash-star or
 * slash-star-star, as the line comment of its text, so that a comment of one line is always a
 * line comment; but a doc comment when `keepDoc` says, since stripping comments would then remove
 * it. */
let _lineCommentsOfBlocks = fn(lines: Array<Line>, keepDoc: Bool): Array<Line> {
  lines.map(fn(line: Line): Line {
    if ((line.pieces.len() != 1) || (keepDoc && _isDoc(line.pieces[0]))) { return line; }
    let piece = line.pieces[0];

    let single = match (piece.kind) {
      BlockComment => indexOf(piece.text, "\n") < 0,
      _ => false,
    };
    if (!single) { return line; }
    let marker = (piece.text.startsWith("/**") && (piece.text.len() > 4)) ? 3 : 2;
    let text = _trimEnd(_trimStart(Bytes.slice(piece.text, marker,
      piece.text.len() - marker - 2)));
    if (text == "") { return line; }
    { pieces: [commentPiece(PieceKind.LineComment, `// ${text}`, "")], blanks: line.blanks }
  })
};

/** Removes the comments of `lines`, but doc comments when `keepDoc` says, and the lines that
 * held only comments; their blank lines go to the line below. */
let _stripComments = fn(lines: Array<Line>, keepDoc: Bool): Array<Line> {
  let out = Array.new<Line>(0);
  let carried = 0;

  for (line in lines) {
    let kept = line.pieces.filter(fn(piece: Piece): Bool {
      _isCode(piece) || (keepDoc && _isDoc(piece))
    });

    if (kept.len() == 0) {
      carried = carried + line.blanks;
    } else {
      out.push({ pieces: kept, blanks: carried + line.blanks });
      carried = 0;
    }
  }
  out
};

/** Moves the comments that end a line of code to a line of their own above it; or, when the
 * line ends by opening a bracket, to the first line inside. */
let _moveTrailingComments = fn(lines: Array<Line>): Array<Line> {
  let out = Array.new<Line>(0);

  for (line in lines) {
    let last = _lastCode(line);

    if ((last < 0) || (last == line.pieces.len() - 1)) {
      out.push(line);
    } else {
      let code = _range(line.pieces, 0, last + 1);
      let notes = _range(line.pieces, last + 1, line.pieces.len());

      if (_opens(line.pieces[last])) {
        out.push({ pieces: code, blanks: line.blanks });
        out.push({ pieces: notes, blanks: 0 });
      } else {
        out.push({ pieces: notes, blanks: line.blanks });
        out.push({ pieces: code, blanks: 0 });
      }
    }
  }
  out
};

// Checks whether a statement that starts with `token` ends at its closing brace, with no `;`.
let _blockStatement = fn(token: Token): Bool {
  match (token) {
    If, Match, While, For, Try, With, LBrace => true,
    _ => false,
  }
};

// Checks whether `token` can start a statement that follows a block statement on its line.
let _statementStart = fn(token: Token): Bool {
  match (token) {
    Let, Const, If, Match, While, For, Try, With, Do, Return, Throw, Break, Continue, Ident(_),
    This, Super, Export, Typedef, Prototype, EnumDecl, Import, Macro => true,
    _ => false,
  }
};

/** Returns where each statement after the first starts among `pieces` from `start` up to `to`,
 * which hold statements one after another; after a `;`, or after the closing brace of an `if`,
 * `match`, `while`, `for`, `try` or `with` that something other than `else` or `catch` follows.
 * A statement that only comments or closing brackets follow is the last, and brackets closed
 * from lines above are not counted. */
let _statementBreaks = fn(pieces: Array<Piece>, start: I32, to: I32): Array<I32> {
  let found = Array.new<I32>(0);

  let hasCode = fn(after: I32): Bool {
    let k = after;
    while ((k < to) && !_isCode(pieces[k])) { k++; }
    (k < to) && !_closes(pieces[k])
  };
  let depth = 0;
  let first = start;
  let k = start;

  while (k < to) {
    let piece = pieces[k];

    if (_opens(piece)) {
      depth++;
    } else if (_closes(piece) && (depth > 0)) {
      depth--;

      if ((depth == 0) && (piece.token == Token.RBrace) && _blockStatement(pieces[first].token)
        && (k + 1 < to) && _isCode(pieces[k + 1]) && _statementStart(pieces[k + 1].token)) {
        found.push(k + 1);
        first = k + 1;
      }
    } else if ((depth == 0) && _is(piece, Token.Semicolon) && hasCode(k + 1)) {
      found.push(k + 1);
      first = k + 1;
      while (!_isCode(pieces[first])) { first++; }
    }
    k++;
  }
  found
};

/** Checks whether the brace at `at` among `pieces` opens an enum's variants, which are not
 * statements. */
let _enumBody = fn(pieces: Array<Piece>, at: I32): Bool {
  let k = at - 1;

  while (k >= 0) {
    let piece = pieces[k];

    if (_isCode(piece)) {
      match (piece.token) {
        EnumDecl => { return true; },
        Semicolon, LBrace, RBrace, Equal, Comma, LParen => { return false; },
        _ => null,
      };
    }
    k--;
  }
  false
};

/** Splits the line `line` so that each statement starts a line. A block on the line that holds
 * more than one statement is opened up, its statements on lines of their own between its braces;
 * a block of one statement stays as it is.
 * @param inEnum  whether the line is among an enum's variants, which are not statements */
let _splitLine = fn(line: Line, inEnum: Bool): Array<Line> {
  let pieces = line.pieces;
  let breaks = Array.new<Bool>(pieces.len() + 1);

  if (!inEnum) {
    for (at in _statementBreaks(pieces, 0, pieces.len())) { breaks[at] = true; }
  }

  // Each bracket's partner on the line, or -1, and each brace's innermost enclosing brace, or -1.
  let partner = Array.new<I32>(pieces.len());
  let enclosing = Array.new<I32>(pieces.len());
  let open = Array.new<I32>(0);
  let braces = Array.new<I32>(0);
  let k = 0;

  while (k < pieces.len()) {
    partner[k] = -1;
    enclosing[k] = braces.len() == 0 ? -1 : braces[braces.len() - 1];
    let piece = pieces[k];

    if (_opens(piece)) {
      open.push(k);
      if (piece.token == Token.LBrace) { braces.push(k); }
    } else if (_closes(piece)) {
      if (open.len() > 0) {
        let opener = open.pop();
        partner[opener] = k;
        if (_is(pieces[opener], Token.LBrace)) { braces.pop(); }
      } else if ((k > 0) && _is(piece, Token.RBrace) && _is(pieces[k - 1], Token.Semicolon)) {
        // A brace closing a block from a line above goes on a line of its own.
        breaks[k] = true;
      }
    }
    k++;
  }

  /* A block is opened up when it holds statements after its first, or a block opened up; inner
   * braces come later on the line, so they are decided first. */
  let expanded = Array.new<Bool>(pieces.len());
  k = pieces.len() - 1;

  while (k >= 0) {
    if (_is(pieces[k], Token.LBrace) && !_enumBody(pieces, k)) {
      let end = partner[k] < 0 ? pieces.len() : partner[k];
      let inner = _statementBreaks(pieces, k + 1, end);

      if ((inner.len() > 0) || expanded[k]) {
        if (k + 1 < pieces.len()) { breaks[k + 1] = true; }
        for (at in inner) { breaks[at] = true; }
        if (partner[k] >= 0) { breaks[partner[k]] = true; }
        if (enclosing[k] >= 0) { expanded[enclosing[k]] = true; }
      }
    }
    k--;
  }

  let out = Array.new<Line>(0);
  let begin = 0;
  k = 1;

  while (k <= pieces.len()) {
    if ((k == pieces.len()) || breaks[k]) {
      out.push({ pieces: _range(pieces, begin, k), blanks: begin == 0 ? line.blanks : 0 });
      begin = k;
    }
    k++;
  }
  out
};

// Splits each of `lines` so that each statement starts a line (`_splitLine`).
let _splitLines = fn(lines: Array<Line>): Array<Line> {
  let out = Array.new<Line>(0);
  // Whether each bracket open above is an enum's brace.
  let enums = Array.new<Bool>(0);

  for (line in lines) {
    out.appendFrom(_splitLine(line, (enums.len() > 0) && enums[enums.len() - 1]), 0);
    let k = 0;

    while (k < line.pieces.len()) {
      let piece = line.pieces[k];

      if (_opens(piece)) {
        enums.push(_is(piece, Token.LBrace) && _enumBody(line.pieces, k));
      } else if (_closes(piece) && (enums.len() > 0)) {
        enums.pop();
      }
      k++;
    }
  }
  out
};

/** Joins each line that starts with an opening brace to the line above, as `if (c) {`, unless
 * that line ends a statement or an item, opens a bracket itself, or ends with a comment; and each
 * line that starts with `else` or `catch` to a closing brace above it, as `} else {`. */
let _joinBraces = fn(lines: Array<Line>): Array<Line> {
  let out = Array.new<Line>(0);

  for (line in lines) {
    let joined = false;
    let first = line.pieces[0];

    if ((out.len() > 0) && _isCode(first)) {
      let above = out[out.len() - 1];
      let last = above.pieces[above.pieces.len() - 1];

      let join = match (first.token) {
        LBrace => match (last.token) {
          Semicolon, LBrace, RBrace, Comma, LParen, LBracket => false,
          _ => true,
        },
        Else, Catch => last.token == Token.RBrace,
        _ => false,
      };

      if (_isCode(last) && join) {
        above.pieces.push(codePiece(line.pieces[0].text, line.pieces[0].token, " "));
        above.pieces.appendFrom(_range(line.pieces, 1, line.pieces.len()), 0);
        joined = true;
      }
    }
    if (!joined) { out.push(line); }
  }
  out
};

/** The layout of each line: its indentation, in levels, whether it continues the statement above,
 * whether it starts a statement in a block, and whether it leaves brackets open. */
typedef Layout = {
  let indents: Array<I32>;
  let statements: Array<Bool>;
  let opening: Array<Bool>;
};

// Checks whether a line after one whose last code is `last` continues its statement or item.
let _continues = fn(last: ?Token): Bool {
  if (last == null) { return false; }

  match (last) {
    Semicolon, Comma, LBrace, RBrace, LParen, LBracket => false,
    _ => true,
  }
};

/** Indents `lines`. A line is one level in from the line that opened the innermost bracket still
 * open above it, however many that line opened, and one level more when it continues a statement
 * in a block. A line that starts by closing brackets is level with the
 * line that opened the outermost of them, and so is a bracket opened after one is closed. */
let _layout = fn(lines: Array<Line>): Layout {
  let indents = Array.new<I32>(lines.len());
  let statements = Array.new<Bool>(lines.len());
  let opening = Array.new<Bool>(lines.len());
  // The open brackets, innermost last; each one's indentation and whether it is a brace.
  let openIndents = Array.new<I32>(0);
  let openBraces = Array.new<Bool>(0);
  let last: ?Token = null;
  let i = 0;

  while (i < lines.len()) {
    let line = lines[i];
    let first = _firstCode(line);
    let k = first < 0 ? line.pieces.len() : first;
    let indent = -1;

    while ((k < line.pieces.len()) && _closes(line.pieces[k])) {
      if (openIndents.len() > 0) {
        indent = openIndents.pop();
        openBraces.pop();
      }
      k++;
    }

    let inBlock = (openBraces.len() == 0) || openBraces[openBraces.len() - 1];
    let continued = (first >= 0) && (k == first) && _continues(last);
    if (first < 0) { continued = _continues(last); }

    if (indent < 0) {
      indent = openIndents.len() == 0 ? 0 : openIndents[openIndents.len() - 1] + 1;
      if (continued && inBlock) { indent++; }
    }
    indents[i] = indent;
    statements[i] = (first >= 0) && (k == first) && inBlock && !continued;

    /* Brackets opened after closing one from a line above are level with that line's, and a brace
     * opened on a line that continues a statement is level with the statement's first line. */
    let base = indent;
    let braceBase = (continued && inBlock) ? indent - 1 : indent;
    let opened = 0;

    while (k < line.pieces.len()) {
      let piece = line.pieces[k];

      if (_opens(piece)) {
        openIndents.push(piece.token == Token.LBrace ? braceBase : base);
        openBraces.push(piece.token == Token.LBrace);
        opened++;
      } else if (_closes(piece) && (openIndents.len() > 0)) {
        let closed = openIndents.pop();
        openBraces.pop();

        if (opened > 0) {
          opened--;
        } else {
          base = closed;
          braceBase = closed;
        }
      }
      k++;
    }
    opening[i] = opened > 0;
    if (first >= 0) { last = line.pieces[_lastCode(line)].token; }
    i++;
  }
  { indents: indents, statements: statements, opening: opening }
};

/** Checks whether `line` starts a block or a function: an `if`, `match`, `while`, `for`, `do`,
 * `try`, `with`, `prototype`, `enum`, `typedef` or `macro`, or a `let` or `const` bound to a
 * function or to an `if`, `match`, `try` or `with`. */
let _blockStart = fn(line: Line): Bool {
  let k = _firstCode(line);
  if (_is(line.pieces[k], Token.Export)) { k++; }
  if (k >= line.pieces.len()) { return false; }

  match (line.pieces[k].token) {
    If, Match, While, For, Do, Try, With, Prototype, EnumDecl, Typedef, Macro => true,
    Let, Const => {
      let found = false;

      while (!found && (k + 1 < line.pieces.len())) {
        if (_is(line.pieces[k], Token.Equal)) {
          let next = line.pieces[k + 1];
          found = _isCode(next) && match (next.token) {
            Fn, If, Match, Try, With => true,
            Ident(name) => (name == "method") && (k + 2 < line.pieces.len())
              && _is(line.pieces[k + 2], Token.Fn),
            _ => false,
          };
        }
        k++;
      }
      found
    },
    _ => false,
  }
};

/** Sets the blank lines above each line: at most one, none at the start, after an opening bracket
 * or before a closing one, and one above a block or function that starts a statement, or above
 * the comments directly on top of it. */
let _spaceLines = fn(lines: Array<Line>, layout: Layout, style: Style) {
  let i = 0;

  while (i < lines.len()) {
    let line = lines[i];
    if (line.blanks > 1) { line.blanks = 1; }
    if ((i == 0) || _endsOpen(lines[i - 1]) || _closes(line.pieces[0])) { line.blanks = 0; }
    i++;
  }

  i = 0;

  while (i < lines.len()) {
    if (layout.statements[i] && (layout.opening[i] || style.blankBeforeOneLineBlocks)
      && _blockStart(lines[i])) {
      let top = i;
      while ((top > 0) && (lines[top].blanks == 0) && (_firstCode(lines[top - 1]) < 0)) { top--; }
      if ((top > 0) && !_endsOpen(lines[top - 1])) { lines[top].blanks = 1; }
    }
    i++;
  }
};

// Returns the number of code points in `text`.
let _width = fn(text: Bytes): I32 {
  let count = 0;
  let k = 0;

  while (k < text.len()) {
    if ((Bytes.get_u8(text, k) & 0xc0) != 0x80) { count++; }
    k++;
  }
  count
};

// Returns `count` spaces.
let _spaces = fn(count: I32): Bytes {
  let parts = Array.new<Bytes>(0);
  let k = 0;

  while (k < count) {
    parts.push(" ");
    k++;
  }
  parts.join("")
};

// Returns the bytes of `text` from `start` to its end.
let _from = fn(text: Bytes, start: I32): Bytes { Bytes.slice(text, start, text.len() - start) };

// Returns `text` without its leading spaces and tabs.
let _trimStart = fn(text: Bytes): Bytes {
  let k = 0;

  while ((k < text.len()) && ((Bytes.get_u8(text, k) == " ".code)
    || (Bytes.get_u8(text, k) == "\t".code))) {
    k++;
  }
  _from(text, k)
};

// Returns `text` without its trailing whitespace.
let _trimEnd = fn(text: Bytes): Bytes {
  let k = text.len();

  while ((k > 0) && ((Bytes.get_u8(text, k - 1) == " ".code)
    || (Bytes.get_u8(text, k - 1) == "\t".code) || (Bytes.get_u8(text, k - 1) == "\r".code))) {
    k--;
  }
  Bytes.slice(text, 0, k)
};

/** Wraps the comment text `text` at spaces into lines of at most `width` code points; a word
 * longer than that keeps a line of its own. */
let _wrap = fn(text: Bytes, width: I32): Array<Bytes> {
  let out = Array.new<Bytes>(0);
  let rest = text;

  while (_width(rest) > width) {
    // The last space that leaves the line within the width, or else the first space.
    let cut = -1;
    let k = 0;

    while (k < rest.len()) {
      if ((Bytes.get_u8(rest, k) == " ".code) && (k > 0)) {
        if ((cut < 0) || (_width(Bytes.slice(rest, 0, k)) <= width)) { cut = k; }
      }
      k++;
    }
    if (cut < 0) { break; }
    let head = _trimEnd(Bytes.slice(rest, 0, cut));
    if (head == "") { break; }
    out.push(head);
    rest = _trimStart(_from(rest, cut));
  }
  out.push(rest);
  out
};

/** Returns the lines of a block comment that opens with `marker`, slash-star or slash-star-star,
 * holding `content`, at `indent` spaces, with each line after the first starting ` * `, wrapped to
 * `width` code points. Text in a code fence, or indented, is not wrapped.
 * @param openOwn  whether the marker has a line of its own
 * @param closeOwn  whether the closing star-slash has a line of its own */
let _blockLines = fn(
  marker: Bytes,
  content: Array<Bytes>,
  openOwn: Bool,
  closeOwn: Bool,
  indent: I32,
  width: I32
): Array<Bytes> {
  let pad = _spaces(indent);
  let wrapped = Array.new<Bytes>(0);
  let fenced = false;
  let k = 0;

  while (k < content.len()) {
    let text = content[k];
    let room = width - indent - (((k == 0) && !openOwn) ? marker.len() + 1 : 3);
    if ((k == content.len() - 1) && !closeOwn) { room = room - 3; }
    if (text.startsWith("```")) { fenced = !fenced; }

    if (fenced || text.startsWith("```") || text.startsWith(" ")) {
      wrapped.push(text);
    } else {
      wrapped.appendFrom(_wrap(text, room), 0);
    }
    k++;
  }

  let out = Array.new<Bytes>(0);
  if (openOwn) { out.push(pad + marker); }
  k = 0;

  while (k < wrapped.len()) {
    let text = wrapped[k];

    if ((k == 0) && !openOwn) {
      out.push(text == "" ? pad + marker : `${pad}${marker} ${text}`);
    } else {
      out.push(text == "" ? pad + " *" : `${pad} * ${text}`);
    }
    k++;
  }

  if (closeOwn || (out.len() == 0)) {
    out.push(pad + " */");
  } else {
    out[out.len() - 1] = out[out.len() - 1] + " */";
  }
  out
};

/** Lays out the block comment `text` at `indent` spaces, its lines after the first starting
 * ` * `, wrapped to `width`; an empty comment stays as it is. */
let _blockComment = fn(text: Bytes, indent: I32, width: I32): Array<Bytes> {
  let doc = text.startsWith("/**") && (text.len() > 4);
  let marker = doc ? "/**" : "/*";
  let inner = Bytes.slice(text, marker.len(), text.len() - marker.len() - 2);
  let rows = split(inner, "\n");
  if ((rows.len() == 1) && (_trimEnd(_trimStart(inner)) == "")) { return [_spaces(indent) + text]; }

  let content = Array.new<Bytes>(0);
  let openOwn = _trimEnd(rows[0]) == "";

  if (!openOwn) {
    let first = _trimEnd(rows[0]);
    content.push(first.startsWith(" ") ? _from(first, 1) : first);
  }
  let k = 1;

  while (k < rows.len()) {
    let row = _trimEnd(_trimStart(rows[k]));

    if (row.startsWith("*")) {
      row = _from(row, 1);
      if (row.startsWith(" ")) { row = _from(row, 1); }
    }
    content.push(row);
    k++;
  }
  let closeOwn = (rows.len() > 1) && (content[content.len() - 1] == "");
  if (closeOwn) { content.pop(); }
  _blockLines(marker, content, openOwn, closeOwn, indent, width)
};

// Returns the text of the line comment `text` after its marker and one space.
let _lineCommentText = fn(text: Bytes): Bytes {
  let body = _from(text, text.startsWith("#") ? 1 : 2);
  body.startsWith(" ") ? _from(body, 1) : body
};

/** Lays out a run of line comments, one comment per line, at `indent` spaces. A run of more than
 * one line, or a line wider than `width` that must wrap, becomes a block comment, unless its text
 * holds a star-slash, which would end the block early. */
let _lineComments = fn(texts: Array<Bytes>, indent: I32, width: I32): Array<Bytes> {
  let pad = _spaces(indent);
  let content = texts.map(_lineCommentText);
  let closes = content.filter(fn(text: Bytes): Bool { indexOf(text, "*/") >= 0 }).len() > 0;

  if (closes || ((texts.len() == 1) && (_width(texts[0]) + indent <= width))) {
    let out = Array.new<Bytes>(0);

    for (text in texts) {
      if (_width(text) + indent <= width) {
        out.push(pad + text);
      } else {
        let marker = Bytes.slice(text, 0, text.len() - _lineCommentText(text).len());

        for (part in _wrap(_lineCommentText(text), width - indent - marker.len())) {
          out.push(pad + marker + part);
        }
      }
    }
    return out;
  }
  _blockLines("/*", content, false, false, indent, width)
};

// Returns the text of `line`, indented by `indent` spaces, its pieces spaced as in the source.
let _plainLine = fn(line: Line, indent: I32): Bytes {
  let parts = [_spaces(indent), line.pieces[0].text];
  let k = 1;

  while (k < line.pieces.len()) {
    parts.push(line.pieces[k].space);
    parts.push(line.pieces[k].text);
    k++;
  }
  parts.join("")
};

// Checks whether `line` is a single comment of kind `kind`.
let _lone = fn(line: Line, kind: PieceKind): Bool {
  (line.pieces.len() == 1) && (line.pieces[0].kind == kind)
};

// Writes out `lines` with their layout, as text ending in a newline.
let _render = fn(lines: Array<Line>, layout: Layout, style: Style): Bytes {
  let out = Array.new<Bytes>(0);
  let i = 0;

  while (i < lines.len()) {
    let line = lines[i];
    let indent = layout.indents[i] * style.indent;
    if (line.blanks > 0) { out.push(""); }

    if (style.rewriteComments && _lone(line, PieceKind.LineComment)
      && !((i == 0) && line.pieces[0].text.startsWith("#!"))) {
      let texts = [line.pieces[0].text];

      while ((i + 1 < lines.len()) && (lines[i + 1].blanks == 0)
        && _lone(lines[i + 1], PieceKind.LineComment)
        && (layout.indents[i + 1] == layout.indents[i])) {
        i++;
        texts.push(lines[i].pieces[0].text);
      }
      out.appendFrom(_lineComments(texts, indent, style.lineWidth), 0);
    } else if (style.rewriteComments && _lone(line, PieceKind.BlockComment)) {
      out.appendFrom(_blockComment(line.pieces[0].text, indent, style.lineWidth), 0);
    } else {
      out.push(_plainLine(line, indent));
    }
    i++;
  }
  out.len() == 0 ? "" : out.join("\n") + "\n"
};

// Checks whether `a` and `b` are the same tokens.
let _sameTokens = fn(a: Array<Token>, b: Array<Token>): Bool {
  if (a.len() != b.len()) { return false; }
  let k = 0;
  while ((k < a.len()) && (a[k] == b[k])) { k++; }
  k == a.len()
};

/** Lays out the source `src` of the file at `path` in `style`.
 * @return the laid-out text, or null when it would not lex to the same tokens, which is a bug
 *         in the formatter
 * @throws the diagnostic of a lexical error in `src` */
export let formatSource = fn(src: Bytes, path: Bytes, style: Style): ?Bytes {
  let (tokens, _, starts, ends) = lexFile(src, path);
  let lines = sourceLines(src, tokens, starts, ends);

  if (style.stripComments && style.rewriteComments) {
    lines = _stripComments(lines, style.keepDocComments);
  } else if (style.rewriteComments) {
    lines = _moveTrailingComments(lines);
  }
  lines = _joinBraces(_splitLines(lines));

  if (style.rewriteComments) {
    lines = _lineCommentsOfBlocks(lines, style.stripComments && style.keepDocComments);
  }

  let layout = _layout(lines);
  _spaceLines(lines, layout, style);
  let text = _render(lines, layout, style);
  let (again, _, _, _) = lexFile(text, path);
  _sameTokens(tokens, again) ? text : null
};
