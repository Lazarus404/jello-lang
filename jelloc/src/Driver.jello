import { lexFile } from frontend.Lexer;
import type { Token } from frontend.Lexer;
import { parseProgram } from frontend.Parser;
import { printTokens } from frontend.Tokens;
import { typeCheckProgramWithSyntaxAt } from frontend.TypeCheck;
import { loadProgramWithSyntax } from frontend.Modules;
import { printHir } from frontend.PrintHir;
import { lowerProgram } from ir.Lower;
import { printIr } from ir.Print;
import { legalizeJlo } from backend.jello.Legalize;
import { printJlo } from backend.jello.Print;
import { emitJlo } from backend.jello.Emit;
import { readText, writeText } from std.io.File;

let _parseArgs = fn(argv: List<Bytes>) {
  let input = "";
  let printLex = false;
  let parseOnly = false;
  let printLowered = false;
  let printTyped = false;
  let printLegalized = false;
  let output = "";
  let cur = argv;

  while (List.is_nil(cur) == false) {
    let arg = List.head(cur);

    if (arg == "--lex") {
      printLex = true;
    } else if (arg == "--parse") {
      parseOnly = true;
    } else if (arg == "--ir") {
      printLowered = true;
    } else if (arg == "--hir") {
      printTyped = true;
    } else if (arg == "--jlo") {
      printLegalized = true;
    } else if (arg == "--out") {
      cur = List.tail(cur);
      if (List.is_nil(cur)) { throw "--out requires a path"; }
      output = List.head(cur);
    } else if (input == "") {
      input = arg;
    } else {
      throw ("unexpected argument: " + arg);
      null
    }
    cur = List.tail(cur);
  }

  if (input == "") {
    throw "usage: jelloc <input.jello> [--lex|--parse|--hir|--ir|--jlo|--out path]";
    null
  }
  (input, printLex, parseOnly, printTyped, printLowered, printLegalized, output)
};

export let run: (List<Bytes>) -> Bytes = fn(argv) {
  let (input, printLex, parseOnly, printTyped, printLowered, printLegalized, output) = _parseArgs(argv);

  if (printLex) {
    try { printTokens(lexFile(readText(input), input)) } catch (e) {
      "LexError: " + Std.string(e) + "\n"
    }
  } else if (parseOnly) {
    let lexed = try { (lexFile(readText(input), input), "") } catch (e) {
      (Array.new<Token>(0), Std.string(e))
    };
    let (parsedTokens, lexError) = lexed;

    if (lexError != "") { "LEXER\t" + lexError + "\n" } else {
      try {
        parseProgram(parsedTokens);
        ""
      } catch (e) {
        "PARSER\t" + Std.string(e) + "\n"
      }
    }
  } else if (printTyped) {
    try {
      let (program, sourceSyntax) = loadProgramWithSyntax(input);
      printHir(typeCheckProgramWithSyntaxAt(program, sourceSyntax, input))
    } catch (e) {
      "HIR\t" + Std.string(e) + "\n"
    }
  } else if (printLowered) {
    try {
      let (program, sourceSyntax) = loadProgramWithSyntax(input);
      printIr(lowerProgram(typeCheckProgramWithSyntaxAt(program, sourceSyntax, input)))
    } catch (e) {
      "IR\t" + Std.string(e) + "\n"
    }
  } else if (printLegalized) {
    try {
      let (program, sourceSyntax) = loadProgramWithSyntax(input);
      printJlo(legalizeJlo(lowerProgram(typeCheckProgramWithSyntaxAt(program, sourceSyntax, input))))
    } catch (e) {
      "JLO\t" + Std.string(e) + "\n"
    }
  } else if (output != "") {
    try {
      let (program, sourceSyntax) = loadProgramWithSyntax(input);
      let bytes = emitJlo(legalizeJlo(lowerProgram(typeCheckProgramWithSyntaxAt(program, sourceSyntax, input))));
      if (!writeText(output, bytes)) { throw "could not write output"; }
      ""
    } catch (e) {
      "EMIT\t" + Std.string(e) + "\n"
    }
  } else {
    throw "output path required; pass --out <path>";
    ""
  }
};
