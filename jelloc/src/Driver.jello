import { lexFile } from frontend.syntax.Lexer;
import { parseFailureSpan, parseProgram, programSyntax, takeSyntaxErrors } from frontend.syntax.Parser;
import { locate } from frontend.syntax.Locations;
import { sourceDiagnostic } from frontend.syntax.Source;
import type { SourceSpan } from frontend.syntax.Source;
import { printTokens } from frontend.syntax.Tokens;
import { checkProgram } from frontend.semantics.Modules;
import { currentSpan } from frontend.semantics.TypeCheck;
import type { Module } from frontend.Loader;
import { isTestFile, loadFailureSpan, loadModules, loadTests } from frontend.Loader;
import { Project, baseName, findProject, inDirectory, loadProject, parentDirectory } from Project;
import { MAX_FAILURES, noteFailure, pendingNote, recordFailure, takeFailures, takeWarnings } from frontend.semantics.Failures;
import { takeInternalError } from support.Internal;
import { verifyFailureSpan } from frontend.hir.Verify;
import { printHir, printHirWithSpans } from frontend.hir.Print;
import { functionNode, lowerProgram, relowerBodyInParts } from ir.Lower;
import { printIr } from ir.Print;
import { legalizeJlo, relegalizeJlo } from backend.jello.Legalize;
import { allocateProgram, allocationFailure } from backend.jello.Allocate;
import { emitAllocated } from backend.jello.Emit;
import { exists, listDir, makeDirs, readText, writeText } from std.io.File;
import { getEnv } from std.io.Env;
import { endsWith, joined, startsWith } from support.Text;
import { appendFrom } from support.Arrays;
import { explain } from support.Codes;

import type { Program } from ir.Model;
import type { Hir } from frontend.hir.Hir;
import { spanOf, spanPathOf } from frontend.hir.Hir;

enum Mode { Lex; Parse; Typed; Lowered; Legalized; Emit; Help; }

let _USAGE = "usage: jelloc <input.jello> (--out path | --lex | --parse | --hir [--spans] | --ir | --jlo [--out path]) [--std dir] [--path dir]...\n"
  + "       jelloc --test <file.test.jello>... --path dir... (--out path | --hir [--spans] | --ir | --jlo [--out path]) [--std dir]\n"
  + "       jelloc run [--std dir] [--path dir]... <file.jello> [args...]\n"
  + "       jelloc test [--std dir] [--path dir]... [dir...] [-- args...]\n"
  + "       jelloc deps.get [dir]\n"
  + "       jelloc --explain <code>\n\n"
  + "  run          compile the file into the project's build/run/ (outside a\n"
  + "               project, under $TMPDIR) and run it with jellovm, passing\n"
  + "               it args\n"
  + "  test         compile every *.test.jello file under the dirs (by default\n"
  + "               the project's test.dirs) into one test binary in build/\n"
  + "               and run it, passing it args\n"
  + "  deps.get     fetch the project's dependencies into packages/, with\n"
  + "               jlo_tool get-deps\n\n"
  + "  --test       compile a test binary instead: every test in the files, each\n"
  + "               under a --path root, run by std.testing\n"
  + "  --out path   write the compiled module to path\n"
  + "  --std dir    resolve std.* imports under dir (by default\n"
  + "               $JELLO_STD_PATH)\n"
  + "  --path dir   resolve other imports under dir too, after the input's\n"
  + "               directory (with --test, under these alone); repeatable,\n"
  + "               searched in order\n"
  + "  --lex        print the tokens\n"
  + "  --parse      check the syntax only\n"
  + "  --hir        print the typed HIR\n"
  + "  --spans      with --hir, end each node's line with its source byte range\n"
  + "  --ir         print the CFG IR\n"
  + "  --jlo        print the allocated JLO instructions (with --out, also\n"
  + "               write the compiled module)\n"
  + "  --explain    print what an error code, such as E0302, means\n"
  + "  --help       print this help\n\n"
  + "A project is the nearest directory at or above the file (run), or the\n"
  + "first dir or else the current directory (test, deps.get), that holds a\n"
  + "jello.json. Its src, and each dependency's, are searched after the\n"
  + "--path roots. run and test find jellovm, and deps.get jlo_tool, as\n"
  + "$JELLO_VM and $JELLO_JLO_TOOL say, else beside jelloc, else on PATH.\n\n"
  + "Exit status: 0 on success, 1 when the program does not compile (the\n"
  + "diagnostic is on standard error), 2 for a bad command line, 3 for an\n"
  + "internal error (a compiler bug). run and test exit as the program does.\n";

let _exit = fn(code: I32, message: Bytes) {
  writeText("/dev/stderr", message);
  System.exit(code);
  null
};

let _std = getEnv("JELLO_STD_PATH");
let _roots = Array.new<Bytes>(0);
let _spans = false;
let _testing = false;

let _value = fn(rest: List<Bytes>, flag: Bytes, what: Bytes): Bytes {
  if (List.is_nil(rest) || (List.head(rest) == "")) { throw flag + " requires " + what; }
  List.head(rest)
};

let _commonOption = fn(args: List<Bytes>): List<Bytes> {
  let arg = List.head(args);

  match (arg) {
    "--std" => {
      _std = _value(List.tail(args), arg, "a directory");
      List.tail(List.tail(args))
    },
    "--path" => {
      _roots.push(_value(List.tail(args), arg, "a directory"));
      List.tail(List.tail(args))
    },
    _ => {
      if (startsWith(arg, "-")) { throw "unknown option: " + arg; }
      args
    },
  }
};

let _parseArgs = fn(argv: List<Bytes>): Tuple<Array<Bytes>, Mode, Bytes> {
  let inputs = Array.new<Bytes>(0);
  let mode: ?Mode = null;
  let output = "";
  let cur = argv;

  while (!List.is_nil(cur)) {
    let arg = List.head(cur);
    if (arg == "--help") { return (inputs, Mode.Help, ""); }

    if (arg == "--spans") {
      _spans = true;
      cur = List.tail(cur);
      continue;
    }

    if (arg == "--test") {
      _testing = true;
      cur = List.tail(cur);
      continue;
    }

    if ((arg == "--std") || (arg == "--path")) {
      cur = _commonOption(cur);
      continue;
    }
    let flag: ?Mode = match (arg) { "--lex" => Mode.Lex, "--parse" => Mode.Parse, "--hir" => Mode.Typed, "--ir" => Mode.Lowered, "--jlo" => Mode.Legalized, _ => null };

    if (flag != null) {
      if (mode != null) { throw "choose one of --lex, --parse, --hir, --ir, --jlo"; }
      mode = flag;
    } else {
      match (arg) {
        "--out" => {
          cur = List.tail(cur);
          output = _value(cur, arg, "a path");
          null
        },
        _ => {
          if (startsWith(arg, "-")) { throw "unknown option: " + arg; }
          inputs.push(arg);
          null
        },
      };
    }
    cur = List.tail(cur);
  }
  if (inputs.len() == 0) { throw _testing ? "no test file" : "no input file"; }
  if (!_testing && (inputs.len() > 1)) { throw "unexpected argument: " + inputs[1]; }
  if (_testing && ((mode == Mode.Lex) || (mode == Mode.Parse))) { throw "--test cannot be combined with --lex or --parse"; }
  if (_spans && (mode != Mode.Typed)) { throw "--spans requires --hir"; }
  if ((mode == null) && (output == "")) { throw "output path required; pass --out <path>"; }
  if ((mode != null) && (mode != Mode.Legalized) && (output != "")) { throw "--out cannot be combined with --lex, --parse, --hir or --ir"; }
  (inputs, mode == null ? Mode.Emit : mode, output)
};

let _checked = fn(inputs: Array<Bytes>): Hir {
  checkProgram(fn(types: Array<Bytes>): Array<Module> { _testing ? loadTests(inputs, _std, _roots, types) : loadModules(inputs[0], _std, _roots, types) })
};

let _allocated = fn(inputs: Array<Bytes>): Program {
  let hir = _checked(inputs);
  let legalized = legalizeJlo(lowerProgram(hir));

  try { allocateProgram(legalized) } catch (e) {
    if (allocationFailure() != 0) { throw e; }
    allocateProgram(relegalizeJlo(relowerBodyInParts(legalized), legalized))
  }
};

let _diagnostic = fn(span: SourceSpan, message: Bytes): Bytes {
  match (span) { Span(path, start, _) => sourceDiagnostic(path, readText(path), start, message) }
};

let _at = fn(span: ?SourceSpan, message: Bytes): Bytes { span == null ? message : _diagnostic(span, message) };

let _note = fn(span: ?SourceSpan, noteSpan: ?SourceSpan, note: Bytes): Bytes {
  if (noteSpan == null) { return ""; }
  let (path, start) = match (noteSpan) { Span(path, start, _) => (path, start) };

  if (span != null) {
    let (failed, at) = match (span) { Span(failed, at, _) => (failed, at) };
    if ((failed == path) && (locate(path, at).0 == locate(path, start).0)) { return ""; }
  }
  "\n" + _diagnostic(noteSpan, "note: " + note)
};

let _allocationSpan = fn(): ?SourceSpan {
  let span: ?SourceSpan = null;

  if (allocationFailure() >= 0) {
    let node = functionNode(allocationFailure());
    if (spanPathOf(node) >= 0) { span = spanOf(node); }
  }
  span
};

let _failurePoint = fn(): ?SourceSpan {
  let span = currentSpan();
  if (span == null) { span = loadFailureSpan(); }
  if (span == null) { span = parseFailureSpan(); }
  if (span == null) { span = verifyFailureSpan(); }
  if (span == null) { span = _allocationSpan(); }
  span
};

let _location = fn(node: I32): Tuple<Bytes, I32, I32> {
  if (spanPathOf(node) < 0) { return ("", 0, 0); }
  let (path, start) = match (spanOf(node)) { Span(path, start, _) => (path, start) };
  let (line, column) = locate(path, start);
  (path, line, column)
};

let _write = fn(output: Bytes, program: Program) {
  if (!writeText(output, emitAllocated(program, _location))) { throw "could not write " + output; }
  null
};

export let failure = fn(label: Bytes, error: Dynamic): Tuple<I32, Bytes> {
  let message = Std.string(error);
  let errors = takeSyntaxErrors();
  let e = 0;

  while (e < errors.len()) {
    let (span, failed, noteSpan, note) = errors[e];
    if (!recordFailure(span, noteFailure(noteSpan, note, failed) as Dynamic)) { break; }
    e++;
  }
  let (failures, capped) = takeFailures();
  if (takeInternalError()) { return (3, _at(_failurePoint(), "internal error: " + message + " (please report this compiler bug)")); }

  if (failures.len() == 0) {
    let (noteSpan, note) = pendingNote(message);
    failures.push((_failurePoint(), message, noteSpan, note));
  }
  let located = "";
  let i = 0;

  while (i < failures.len()) {
    let (span, failed, noteSpan, note) = failures[i];
    located = located + (i == 0 ? "" : "\n") + _at(span, failed) + _note(span, noteSpan, note);
    i++;
  }
  if (capped) { located = located + "\nstopped after " + Std.string(MAX_FAILURES) + " errors"; }
  (1, (label == "" ? "" : label + "\t") + located)
};

let _fail = fn(label: Bytes, error: Dynamic) {
  let (status, report) = failure(label, error);
  _exit(status, report + "\n")
};

let _warn = fn() {
  let warnings = takeWarnings();
  let text = "";
  let i = 0;

  while (i < warnings.len()) {
    let (span, message) = warnings[i];
    text = text + _at(span, "warning: " + message) + "\n";
    i++;
  }
  if (text != "") { writeText("/dev/stderr", text); }
  null
};

let _report: (() -> Bytes, Bytes) -> Bytes = fn(stage, label) {
  try {
    let out = stage();
    _warn();
    out
  } catch (e) {
    _fail(label, e);
    ""
  }
};

let _parse = fn(input: Bytes): Bytes {
  let phase = "LEXER";

  try {
    let lexed = lexFile(readText(input), input);
    phase = "PARSER";
    programSyntax(parseProgram(lexed));
    ""
  } catch (e) {
    _fail(phase, e);
    ""
  }
};

load { process_exec, process_executable } from std;

let _execEntries: (Bytes) -> Bytes = process_exec;
let _executable: () -> Bytes = process_executable;

let _exec = fn(argv: Array<Bytes>) {
  _exit(1, "jelloc: " + _execEntries(joined(argv, "\0") + "\0") + "\n")
};

let _tool = fn(variable: Bytes, name: Bytes): Bytes {
  let set = getEnv(variable);
  if (set != "") { return set; }
  let beside = inDirectory(parentDirectory(_executable()), name);
  exists(beside) ? beside : name
};

let _items = fn(list: List<Bytes>): Array<Bytes> {
  let out = Array.new<Bytes>(0);
  let cur = list;

  while (!List.is_nil(cur)) {
    out.push(List.head(cur));
    cur = List.tail(cur);
  }
  out
};

let _project = fn(start: Bytes): ?Project {
  let root = findProject(start);
  if (root == "") { return null; }

  try { loadProject(root) } catch (e) {
    _exit(1, Std.string(e) + "\n");
    null
  }
};

let _buildDir = fn(project: ?Project, under: Bytes): Bytes {
  let tmp = getEnv("TMPDIR");

  let dir = match (project) {
    Project(root, _, _, _) => inDirectory(root, under),
    null => (tmp == "" ? "/tmp" : tmp) + "/jelloc/" + under,
  };
  if (!makeDirs(dir)) { _exit(1, "jelloc: cannot make " + dir + "\n"); }
  dir
};

let _addSources = fn(project: ?Project) {
  match (project) {
    Project(_, sources, _, _) => {
      appendFrom(_roots, sources, 0);
      null
    },
    null => null,
  }
};

let _compileAndRun = fn(inputs: Array<Bytes>, output: Bytes, args: Array<Bytes>, project: ?Project) {
  _report(fn() {
    _write(output, _allocated(inputs));
    ""
  }, "");
  let vm = [_tool("JELLO_VM", "jellovm")];

  match (project) {
    Project(_, _, _, libraries) => {
      if (libraries.len() > 0) {
        vm.push("--jdll-path");
        vm.push(joined(libraries, ":"));
      }
      null
    },
    null => null,
  };
  vm.push(output);
  _exec(appendFrom(vm, args, 0))
};

let _runCommand = fn(argv: List<Bytes>) {
  let cur = argv;
  let input = "";

  while (!List.is_nil(cur) && (input == "")) {
    let rest = _commonOption(cur);

    if (rest == cur) {
      input = List.head(cur);
      cur = List.tail(cur);
    } else { cur = rest; }
  }
  if (input == "") { throw "run needs a file"; }
  if (!exists(input)) { _exit(1, "jelloc: cannot read " + input + "\n"); }
  let project = _project(parentDirectory(input));
  _addSources(project);
  let name = baseName(input);
  if ((name.len() <= 6) || !endsWith(name, ".jello")) { throw "run takes a .jello file, not " + input; }
  let output = _buildDir(project, "build/run") + "/" + Bytes.slice(name, 0, name.len() - 6) + ".jlo";
  _compileAndRun([input], output, _items(cur), project)
};

let _testFiles: (Bytes, Array<Bytes>) -> Null = fn(dir, files) {
  let entries = listDir(dir);
  let i = 0;

  while (i < entries.len()) {
    let entry = entries[i];
    let path = inDirectory(dir, entry);
    if (Bytes.get_u8(entry, entry.len() - 1) == "/".code) { _testFiles(Bytes.slice(path, 0, path.len() - 1), files); } else if (isTestFile(entry)) { files.push(path); }
    i++;
  }
  null
};

let _testCommand = fn(argv: List<Bytes>) {
  let dirs = Array.new<Bytes>(0);
  let cur = argv;

  while (!List.is_nil(cur) && (List.head(cur) != "--")) {
    let rest = _commonOption(cur);

    if (rest == cur) {
      dirs.push(List.head(cur));
      cur = List.tail(cur);
    } else { cur = rest; }
  }
  let args = List.is_nil(cur) ? Array.new<Bytes>(0) : _items(List.tail(cur));
  let project = _project(dirs.len() == 0 ? "." : dirs[0]);

  if (dirs.len() == 0) {
    match (project) {
      Project(_, _, tests, _) => {
        let i = 0;

        while (i < tests.len()) {
          if (exists(tests[i])) { dirs.push(tests[i]); }
          i++;
        } null
      },
      null => {
        throw "test needs a directory outside a project (no jello.json here or above)";
        null
      },
    };
    if (dirs.len() == 0) { _exit(1, "jelloc: the project has none of its test directories\n"); }
  }
  let files = Array.new<Bytes>(0);
  let i = 0;

  while (i < dirs.len()) {
    if (!exists(dirs[i])) { _exit(1, "jelloc: cannot read " + dirs[i] + "\n"); }
    _testFiles(dirs[i], files);
    i++;
  }
  if (files.len() == 0) { _exit(1, "jelloc: no *.test.jello file under " + dirs[0] + "\n"); }
  _roots = appendFrom(dirs, _roots, 0);
  _addSources(project);
  _testing = true;
  _compileAndRun(files, _buildDir(project, "build") + "/test.jlo", args, project)
};

let _depsCommand = fn(argv: List<Bytes>) {
  let args = _items(argv);
  if (args.len() > 1) { throw "unexpected argument: " + args[1]; }
  if ((args.len() == 1) && startsWith(args[0], "-")) { throw "unknown option: " + args[0]; }
  let root = findProject(args.len() == 0 ? "." : args[0]);
  if (root == "") { _exit(1, "jelloc: no jello.json here or in a directory above\n"); }
  _exec([_tool("JELLO_JLO_TOOL", "jlo_tool"), "get-deps", root])
};

let _subcommand = fn(name: Bytes, args: List<Bytes>): Bool {
  let command: ?((List<Bytes>) -> Null) = match (name) { "run" => _runCommand, "test" => _testCommand, "deps.get" => _depsCommand, _ => null };
  if (command == null) { return false; }
  try { command(args) } catch (e) { _exit(2, "jelloc: " + Std.string(e) + "\n" + _USAGE); }
  true
};

let _explain = fn(args: Array<Bytes>): Bytes {
  if (args.len() != 1) { _exit(2, "jelloc: --explain takes one error code, as E0302\n" + _USAGE); }
  let text = explain(args[0]);
  if (text == "") { _exit(2, "jelloc: unknown error code: " + args[0] + "\n" + _USAGE); }
  text
};

export let run: (List<Bytes>) -> Bytes = fn(argv) {
  if (!List.is_nil(argv) && _subcommand(List.head(argv), List.tail(argv))) { return ""; }
  if (!List.is_nil(argv) && (List.head(argv) == "--explain")) { return _explain(_items(List.tail(argv))); }

  let (inputs, mode, output) = try { _parseArgs(argv) } catch (e) {
    _exit(2, "jelloc: " + Std.string(e) + "\n" + _USAGE);
    (Array.new<Bytes>(0), Mode.Help, "")
  };

  if (mode != Mode.Help) {
    let i = 0;

    while (i < inputs.len()) {
      if (!exists(inputs[i])) { _exit(1, "jelloc: cannot read " + inputs[i] + "\n"); }
      i++;
    }
  }

  match (mode) {
    Help => _USAGE,
    Lex => _report(fn() { printTokens(lexFile(readText(inputs[0]), inputs[0]).0) }, ""),
    Parse => _parse(inputs[0]),
    Typed => _report(fn() { _spans ? printHirWithSpans(_checked(inputs)) : printHir(_checked(inputs)) }, ""),
    Lowered => _report(fn() { printIr(lowerProgram(_checked(inputs))) }, ""),
    Legalized => _report(fn() {
      let program = _allocated(inputs);
      let listing = printIr(program);
      if (output != "") { _write(output, program); }
      listing
    }, ""),
    Emit => _report(fn() {
      _write(output, _allocated(inputs));
      ""
    }, ""),
  }
};
