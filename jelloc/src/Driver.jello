import { lexFile } from frontend.Lexer;
import type { Token } from frontend.Lexer;
import { parseFailureSpan, parseProgram, programSyntax } from frontend.Parser;
import { locate } from frontend.Locations;
import { sourceDiagnostic } from frontend.Source;
import type { SourceSpan } from frontend.Source;
import { printTokens } from frontend.Tokens;
import { typeCheckModules } from frontend.CheckModules;
import { checkFailureSpan } from frontend.TypeCheck;
import { loadFailureSpan, loadModules, loadTests } from frontend.Modules;
import { printHir, printHirWithSpans } from frontend.PrintHir;
import { functionNode, lowerProgram } from ir.Lower;
import { printIr } from ir.Print;
import { legalizeJlo } from backend.jello.Legalize;
import { allocateProgram, allocationFailure } from backend.jello.Allocate;
import { emitAllocated } from backend.jello.Emit;
import { exists, readText, writeText } from std.io.File;

import type { Program as AstProgram } from frontend.Ast;
import type { Program } from ir.Model;
import type { Hir } from frontend.Hir;
import { spanOf, spanPathOf } from frontend.Hir;

enum Mode { Lex; Parse; Typed; Lowered; Legalized; Emit; Help; }

let _USAGE = "usage: jelloc <input.jello> [--out path] [--std dir] [--path dir]... [--lex|--parse|--hir [--spans]|--ir|--jlo]\n       jelloc --test <file.test.jello>... --path dir... [--out path] [--std dir] [--hir [--spans]|--ir|--jlo]\n\n  --test       compile a test binary instead: every test in the files, each\n               under a --path root, run by std.testing\n  --out path   write the compiled module to path\n  --std dir    resolve std.* imports under dir\n  --path dir   resolve other imports under dir too, after the input's\n               directory (with --test, under these alone); repeatable,\n               searched in order\n  --lex        print the tokens\n  --parse      check the syntax only\n  --hir        print the typed HIR\n  --spans      with --hir, end each node's line with its source byte range\n  --ir         print the CFG IR\n  --jlo        print the allocated JLO instructions (with --out, also\n               write the compiled module)\n  --help       print this help\n\nExit status: 0 on success, 1 when the program does not compile (the\ndiagnostic is on standard error), 2 for a bad command line.\n";

let _exit = fn(code: I32, message: Bytes) {
  writeText("/dev/stderr", message);
  System.exit(code);
  null
};

let _std = "";
let _roots = Array.new<Bytes>(0);
let _spans = false;
let _testing = false;

let _value = fn(rest: List<Bytes>, flag: Bytes, what: Bytes): Bytes {
  if (List.is_nil(rest) || (List.head(rest) == "")) { throw flag + " requires " + what; }
  List.head(rest)
};

let _parseArgs = fn(argv: List<Bytes>): Tuple<Array<Bytes>, Mode, Bytes> {
  let inputs = Array.new<Bytes>(0);
  let mode: ?Mode = null;
  let output = "";
  let cur = argv;

  while (!List.is_nil(cur)) {
    let arg = List.head(cur);
    if (arg == "--help") { return (inputs, Mode.Help, ""); }

    if (arg == "--spans") {
      _spans = true;
      cur = List.tail(cur);
      continue;
    }

    if (arg == "--test") {
      _testing = true;
      cur = List.tail(cur);
      continue;
    }
    let flag: ?Mode = match (arg) { "--lex" => Mode.Lex, "--parse" => Mode.Parse, "--hir" => Mode.Typed, "--ir" => Mode.Lowered, "--jlo" => Mode.Legalized, _ => null };

    if (flag != null) {
      if (mode != null) { throw "choose one of --lex, --parse, --hir, --ir, --jlo"; }
      mode = flag;
    } else {
      match (arg) {
        "--out" => {
          cur = List.tail(cur);
          output = _value(cur, arg, "a path");
          null
        },
        "--std" => {
          cur = List.tail(cur);
          _std = _value(cur, arg, "a directory");
          null
        },
        "--path" => {
          cur = List.tail(cur);
          _roots.push(_value(cur, arg, "a directory"));
          null
        },
        _ => {
          inputs.push(arg);
          null
        },
      };
    }
    cur = List.tail(cur);
  }
  if (inputs.len() == 0) { throw _testing ? "no test file" : "no input file"; }
  if (!_testing && (inputs.len() > 1)) { throw "unexpected argument: " + inputs[1]; }
  if (_testing && ((mode == Mode.Lex) || (mode == Mode.Parse))) { throw "--test cannot be combined with --lex or --parse"; }
  if (_spans && (mode != Mode.Typed)) { throw "--spans requires --hir"; }
  if ((mode == null) && (output == "")) { throw "output path required; pass --out <path>"; }
  if ((mode != null) && (mode != Mode.Legalized) && (output != "")) { throw "--out cannot be combined with --lex, --parse, --hir or --ir"; }
  (inputs, mode == null ? Mode.Emit : mode, output)
};

let _checked = fn(inputs: Array<Bytes>): Hir {
  typeCheckModules(_testing ? loadTests(inputs, _std, _roots) : loadModules(inputs[0], _std, _roots))
};
let _allocated = fn(inputs: Array<Bytes>): Program { allocateProgram(legalizeJlo(lowerProgram(_checked(inputs)))) };

let _diagnostic = fn(span: SourceSpan, message: Bytes): Bytes {
  match (span) { Span(path, start, _) => sourceDiagnostic(path, readText(path), start, message) }
};

let _allocationSpan = fn(): ?SourceSpan {
  let span: ?SourceSpan = null;

  if (allocationFailure() >= 0) {
    let node = functionNode(allocationFailure());
    if (spanPathOf(node) >= 0) { span = spanOf(node); }
  }
  span
};

let _located = fn(message: Bytes): Bytes {
  let span = checkFailureSpan();
  if (span == null) { span = loadFailureSpan(); }
  if (span == null) { span = parseFailureSpan(); }
  if (span == null) { span = _allocationSpan(); }
  if (span == null) { message } else { _diagnostic(span, message) }
};

let _location = fn(node: I32): Tuple<Bytes, I32, I32> {
  if (spanPathOf(node) < 0) { return ("", 0, 0); }
  let (path, start) = match (spanOf(node)) { Span(path, start, _) => (path, start) };
  let (line, column) = locate(path, start);
  (path, line, column)
};

let _write = fn(output: Bytes, program: Program) {
  if (!writeText(output, emitAllocated(program, _location))) { throw "could not write " + output; }
  null
};

let _report: (Bytes, () -> Bytes) -> Bytes = fn(label, stage) {
  try { stage() } catch (e) {
    let message = _located(Std.string(e));
    _exit(1, (label == "" ? "" : label + "\t") + message + "\n");
    ""
  }
};

let _checkSyntax = fn(program: AstProgram): Bytes {
  try {
    programSyntax(program);
    ""
  } catch (e) {
    _exit(1, "SYNTAX\t" + Std.string(e) + "\n");
    ""
  }
};

let _parse = fn(input: Bytes): Bytes {
  let (tokens, lexError) = try { (lexFile(readText(input), input), "") } catch (e) { (Array.new<Token>(0), Std.string(e)) };
  if (lexError != "") { _exit(1, "LEXER\t" + lexError + "\n"); }
  _report("PARSER", fn() { _checkSyntax(parseProgram(tokens)) })
};

export let run: (List<Bytes>) -> Bytes = fn(argv) {
  let (inputs, mode, output) = try { _parseArgs(argv) } catch (e) {
    _exit(2, "jelloc: " + Std.string(e) + "\n" + _USAGE);
    (Array.new<Bytes>(0), Mode.Help, "")
  };

  if (mode != Mode.Help) {
    let i = 0;

    while (i < inputs.len()) {
      if (!exists(inputs[i])) { _exit(1, "jelloc: cannot read " + inputs[i] + "\n"); }
      i++;
    }
  }

  match (mode) {
    Help => _USAGE,
    Lex => _report("", fn() { printTokens(lexFile(readText(inputs[0]), inputs[0])) }),
    Parse => _parse(inputs[0]),
    Typed => _report("", fn() { _spans ? printHirWithSpans(_checked(inputs)) : printHir(_checked(inputs)) }),
    Lowered => _report("", fn() { printIr(lowerProgram(_checked(inputs))) }),
    Legalized => _report("", fn() {
      let program = _allocated(inputs);
      let listing = printIr(program);
      if (output != "") { _write(output, program); }
      listing
    }),
    Emit => _report("", fn() {
      _write(output, _allocated(inputs));
      ""
    }),
  }
};
