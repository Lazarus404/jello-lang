/** @file
 * The `jelloc` command line. Parses the arguments and runs the pipeline as far as the chosen
 * mode asks; lexing, parsing, module loading and type checking into HIR, lowering to IR,
 * legalisation and register allocation, and emission of the `.jlo` module. It also prints the
 * requested listing or writes the module (when asked), and turns a thrown error into a
 * located diagnostic on standard error and an exit status. The subcommands `run`, `test` and
 * `deps.get` work in the project `Project` finds, and replace the process with `jello` or
 * `jlo_tool` once there is something to run, and `--explain` prints what an error code means.
 * `Main.jello` calls `run`, here. */

import { lexFile } from frontend.syntax.Lexer;
import {
  parseFailureSpan, parseProgram, programSyntax, takeSyntaxErrors
} from frontend.syntax.Parser;
import { locate } from frontend.syntax.Locations;
import { sourceDiagnostic } from frontend.syntax.Source;
import type { SourceSpan } from frontend.syntax.Source;
import { printTokens } from frontend.syntax.Tokens;
import { checkProgram } from frontend.semantics.Modules;
import { currentSpan } from frontend.semantics.TypeCheck;
import {
  isTestFile, loadExpanders, loadFailureSpan, loadModules, loadTests
} from frontend.Loader;
import { macroFailureSpan } from frontend.Macros;
import type { Project } from Project;
import {
  baseName, compileDefaults, findProject, inDirectory, loadProject, parentDirectory
} from Project;
import {
  MAX_FAILURES, noteFailure, pendingNote, recordFailure, takeFailures, takeWarnings
} from frontend.semantics.Failures;
import { takeInternalError } from support.Internal;
import { verifyFailureSpan } from frontend.hir.Verify;
import { printHir, printHirWithSpans } from frontend.hir.Print;
import { functionNode, lowerProgram, relowerBodyInParts } from ir.Lower;
import { optimizeProgram } from ir.Optimize;
import { printIr } from ir.Print;
import { legalizeJlo, relegalizeJlo } from backend.jello.Legalize;
import { allocateProgram, allocationFailure } from backend.jello.Allocate;
import { emitAllocated } from backend.jello.Emit;
import { exists, listDir, makeDirs, readText, writeText } from std.io.File;
import { getEnv } from std.io.Env;
import { os, tempDir, version } from std.sys.Platform;
import { toArray } from std.core.List;
import { explain } from support.Codes;
import { findFormatter, formatFiles, loadFormatter, styleFor } from format.Config;
import { formatSource } from format.Format;

import type { Program } from ir.Model;
import type { Hir } from frontend.hir.Hir;
import { spanOf, spanPathOf } from frontend.hir.Hir;

/** What `jelloc` does, chosen by flag.
 * - `Lex` (`--lex`) prints the tokens;
 * - `Parse` (`--parse`) checks the syntax;
 * - `Typed` (`--hir`) prints the typed HIR;
 * - `Lowered` (`--ir`) prints the IR;
 * - `Legalized` (`--jlo`) prints the allocated IR and, with `--out`, also writes the module;
 * - `Emit` (no mode flag) writes the module to the `--out` path, or else to `build/` (`_assume`);
 * - `Expanders` (`--expanders`, which `frontend.Macros` passes when it runs the compiler) returns
 *   the module of the program that runs the input's macros;
 * - `Help` (`--help`) prints how to use the compiler. */
enum Mode { Lex; Parse; Typed; Lowered; Legalized; Emit; Expanders; Help; }

// The usage text, printed by `--help` and after a command-line error.
const _USAGE = "usage: jelloc [input.jello] [--out path | --lex | --parse | --hir [--spans] | --ir | "
  + "--jlo [--out path]] [--std dir] [--path dir]...\n"
  + "       jelloc --test <file.test.jello>... --path dir... (--out path | --hir [--spans] | "
  + "--ir | --jlo [--out path]) [--std dir]\n"
  + "       jelloc run [--std dir] [--path dir]... [file.jello [args...]]\n"
  + "       jelloc test [--std dir] [--path dir]... [dir...] [-- args...]\n"
  + "       jelloc deps.get [dir]\n"
  + "       jelloc fmt [--check] [--strip-comments] [path...]\n"
  + "       jelloc --explain <code>\n"
  + "       jelloc --version\n\n"
  + "  run          compile the file, by default the entry module, into the\n"
  + "               project's build/run/ (outside a project, under the temp dir)\n"
  + "               and run it with jello, passing it args\n"
  + "  test         compile every *.test.jello file under the dirs (by default\n"
  + "               the project's test.dirs) into one test binary in build/\n"
  + "               and run it, passing it args\n"
  + "  deps.get     fetch the project's dependencies into packages/, with\n"
  + "               jlo_tool get-deps\n"
  + "  fmt          lay out the files and the files under the directories (by\n"
  + "               default the inputs of the nearest .formatter) as the\n"
  + "               .formatter says; --check lists those it would change and\n"
  + "               changes none, and --strip-comments removes comments\n\n"
  + "  input.jello  the entry module; by default, jello.json's \"entry\", else\n"
  + "               Main.jello in its src, in the project or the current\n"
  + "               directory, whose sources and packages are then searched\n"
  + "               as run's are\n"
  + "  --test       compile a test binary instead: every test in the files, each\n"
  + "               under a --path root, run by std.testing\n"
  + "  --out path   write the compiled module to path; by default,\n"
  + "               build/<name>.jlo in the project or the current directory,\n"
  + "               named by jello.json's \"name\", else the directory's\n"
  + "  --std dir    resolve std.* imports under dir (by default\n"
  + "               $JELLO_STD_PATH)\n"
  + "  --path dir   resolve other imports under dir too, after the input's\n"
  + "               directory (with --test, under these alone); repeatable,\n"
  + "               searched in order\n"
  + "  --lex        print the tokens\n"
  + "  --parse      check the syntax only\n"
  + "  --hir        print the typed HIR\n"
  + "  --spans      with --hir, end each node's line with its source byte range\n"
  + "  --ir         print the CFG IR\n"
  + "  --jlo        print the allocated JLO instructions (with --out, also\n"
  + "               write the compiled module)\n"
  + "  --explain    print what an error code, such as E0302, means\n"
  + "  -v, --version\n"
  + "               print the compiler's version\n"
  + "  --help       print this help\n\n"
  + "A project is the nearest directory at or above the file (run), or the\n"
  + "first dir (test, deps.get), or else the current directory, that holds a\n"
  + "jello.json. Its src, and each dependency's, are searched after the\n"
  + "--path roots. run and test find jello, and deps.get jlo_tool, as\n"
  + "$JELLO_VM and $JELLO_JLO_TOOL say, else beside jelloc, else on PATH.\n\n"
  + "Exit status: 0 on success, 1 when the program does not compile (the\n"
  + "diagnostic is on standard error), 2 for a bad command line, 3 for an\n"
  + "internal error (a compiler bug). run and test exit as the program does.\n";

/** Writes `message` to standard error and exits the process.
 * @param code  the exit status
 * @param message  the text, written as given */
let _exit = fn(code: I32, message: Bytes) {
  writeText("/dev/stderr", message);
  System.exit(code);
  null
};

// The standard library's directory; the `--std` value, or else `JELLO_STD_PATH`.
let _std = getEnv("JELLO_STD_PATH");
// The source roots searched after the input's directory, from each `--path`, in order.
let _roots = Array.new<Bytes>(0);
// Whether `--spans` was given; `--hir` ends each node's line with its source byte range.
let _spans = false;
// Whether `--test` was given; the inputs are test files, compiled into one test binary.
let _testing = false;
// Whether the input is compiled for `--expanders`, into the program that runs its macros.
let _expanding = false;

/** Returns the value of option `flag`, which is the head of `rest`.
 * @param rest  the arguments after `flag`
 * @param flag  the option, for the error
 * @param what  what the value is, for the error, such as "a path"
 * @throws an error if `rest` is empty or its head is empty */
let _value = fn(rest: List<Bytes>, flag: Bytes, what: Bytes): Bytes {
  match (rest) {
    [value | _] when (value != "") => value,
    _ => { throw `${flag} requires ${what}`; },
  }
};

/** Consumes `--std dir` or `--path dir` at the head of `args`, which is not empty, setting `_std`
 * or adding to `_roots`.
 * @return the arguments after it, or `args` when its head is not an option
 * @throws an error for another option, or an option without its value */
let _commonOption = fn(args: List<Bytes>): List<Bytes> {
  match (args) {
    ["--std" | rest] => {
      _std = _value(rest, "--std", "a directory");
      List.tail(rest)
    },
    ["--path" | rest] => {
      _roots.push(_value(rest, "--path", "a directory"));
      List.tail(rest)
    },
    [arg | _] when (arg.startsWith("-")) => { throw `unknown option: ${arg}`; },
    _ => args,
  }
};

/** Parses the command-line arguments, setting `_std`, `_roots`, `_spans` and `_testing`. `--help`
 * ends parsing at once.
 * @param argv  the arguments, without the program name
 * @return the input files, which may be none without `--test`, the mode (`Emit` when no mode
 *         flag is given), and the `--out` path, or empty
 * @throws an error for an unknown option, an option without its value, two mode flags, a second
 *         input without `--test`, `--test` with no input, with `--lex` or `--parse`, or with no
 *         mode flag and no `--out`, `--spans` without `--hir`, or `--out` with a mode flag other
 *         than `--jlo` */
let _parseArgs = fn(argv: List<Bytes>): Tuple<Array<Bytes>, Mode, Bytes> {
  let inputs = Array.new<Bytes>(0);
  let mode: ?Mode = null;
  let output = "";
  let cur = argv;

  while (let [arg | rest] = cur) {
    if (arg == "--help") { return (inputs, Mode.Help, ""); }

    if ((arg == "--std") || (arg == "--path")) {
      cur = _commonOption(cur);
      continue;
    }

    cur = rest;

    let flag: ?Mode = match (arg) {
      "--lex" => Mode.Lex,
      "--parse" => Mode.Parse,
      "--hir" => Mode.Typed,
      "--ir" => Mode.Lowered,
      "--jlo" => Mode.Legalized,
      "--expanders" => Mode.Expanders,
      _ => null,
    };

    if (arg == "--spans") {
      _spans = true;
    } else if (arg == "--test") {
      _testing = true;
    } else if (flag != null) {
      if (mode != null) { throw "choose one of --lex, --parse, --hir, --ir, --jlo"; }
      mode = flag;
    } else if (arg == "--out") {
      output = _value(cur, arg, "a path");
      cur = List.tail(cur);
    } else if (arg.startsWith("-")) {
      throw `unknown option: ${arg}`;
    } else {
      inputs.push(arg);
    }
  }

  if (_testing && (inputs.len() == 0)) { throw "no test file"; }
  if (!_testing && (inputs.len() > 1)) { throw `unexpected argument: ${inputs[1]}`; }

  if (_testing && ((mode == Mode.Lex) || (mode == Mode.Parse))) {
    throw "--test cannot be combined with --lex or --parse";
  }
  if (_spans && (mode != Mode.Typed)) { throw "--spans requires --hir"; }

  if (_testing && (mode == null) && (output == "")) {
    throw "output path required; pass --out <path>";
  }

  if ((mode != null) && (mode != Mode.Legalized) && (output != "")) {
    throw "--out cannot be combined with --lex, --parse, --hir or --ir";
  }
  (inputs, mode ?? Mode.Emit, output)
};

/** Loads and type-checks the program; the module `inputs[0]` and what it imports, or, with
 * `--test`, the test files and what they import, under a generated entry, with the extension
 * modules its method calls need (`frontend.semantics.Modules.checkProgram`).
 * @param inputs  the input files
 * @return the checked HIR
 * @throws an error if a module fails to load or check */
let _checked = fn(inputs: Array<Bytes>): Hir {
  checkProgram(if (_expanding) {
    loadExpanders(inputs[0], _std)
  } else if (_testing) {
    loadTests(inputs, _std, _roots)
  } else {
    loadModules(inputs[0], _std, _roots)
  })
};

/** Allocates `legalized`; a program body with more registers than one function can have is
 * lowered again to run in parts.
 * @throws an error if a function needs too many registers */
let _allocatedInParts = fn(legalized: Program): Program {
  try {
    allocateProgram(legalized)
  } catch (e) {
    if (allocationFailure() != 0) { throw e; }
    allocateProgram(relegalizeJlo(relowerBodyInParts(legalized), legalized))
  }
};

/** Compiles the files `inputs` as far as allocated IR; checks, lowers, optimises, legalises and
 * allocates. When a function other than the body needs too many registers, which inlining
 * may cause, the program is optimised again without inlining or clean-up.
 * @throws the error of the first pass that fails */
let _allocated = fn(inputs: Array<Bytes>): Program {
  let lowered = lowerProgram(_checked(inputs));

  try {
    _allocatedInParts(legalizeJlo(optimizeProgram(lowered, true)))
  } catch (e) {
    if (allocationFailure() <= 0) { throw e; }
    _allocatedInParts(legalizeJlo(optimizeProgram(lowered, false)))
  }
};

/** Returns `message` formatted as a diagnostic pointing at the start of `span`, quoting its source
 * line, which is read from the file. */
let _diagnostic = fn(span: SourceSpan, message: Bytes): Bytes {
  sourceDiagnostic(span.path, readText(span.path), span.start, message)
};

// Returns `message` as a diagnostic at `span`, or unchanged when `span` is null.
let _at = fn(span: ?SourceSpan, message: Bytes): Bytes {
  span == null ? message : _diagnostic(span, message)
};

/** Returns a failure's note as a diagnostic on a line of its own, or "" when it has none or the
 * failure's diagnostic already quotes the line it points at.
 * @param span  where the failure was found, or null
 * @param noteSpan  where the note points, or null for none
 * @param note  the note */
let _note = fn(span: ?SourceSpan, noteSpan: ?SourceSpan, note: Bytes): Bytes {
  if (noteSpan == null) { return ""; }
  let path = noteSpan.path;

  if ((span != null)
    && (span.path == path)
    && (locate(path, span.start).0 == locate(path, noteSpan.start).0)) {
    return "";
  }
  "\n" + _diagnostic(noteSpan, `note: ${note}`)
};

/** Returns the span of the HIR node of the function register allocation last failed on, or null
 * when allocation did not fail or the node has no span. */
let _allocationSpan = fn(): ?SourceSpan {
  let span: ?SourceSpan = null;

  if (allocationFailure() >= 0) {
    let node = functionNode(allocationFailure());
    if (spanPathOf(node) >= 0) { span = spanOf(node); }
  }
  span
};

/** Returns the first failure point known, in this order; the node the type checker failed on, the
 * import that failed to load, the macro call that failed to expand, the token parsing failed at,
 * the node the HIR verifier failed at, or the function register allocation failed on.
 * @return the span, or null when no failure point is known */
let _failurePoint = fn(): ?SourceSpan {
  currentSpan()
    ?? loadFailureSpan()
    ?? macroFailureSpan()
    ?? parseFailureSpan()
    ?? verifyFailureSpan()
    ?? _allocationSpan()
};

/** Locates HIR node `node` for the emitted line table; `_write` passes it to
 * `Emit.emitAllocated`.
 * @return the path, line and column where the node starts, or an empty path, line 0 and column 0
 *         when it has no span */
let _location = fn(node: I32): Tuple<Bytes, I32, I32> {
  if (spanPathOf(node) < 0) { return ("", 0, 0); }
  let { path, start } = spanOf(node);
  let (line, column) = locate(path, start);
  (path, line, column)
};

/** Emits the allocated `program` as a `.jlo` module, with a line table, and writes it to path
 * `output`.
 * @throws an error if the file cannot be written */
let _write = fn(output: Bytes, program: Program) {
  if (!writeText(output, emitAllocated(program, _location))) { throw `could not write ${output}`; }
  null
};

/** Turns an error thrown by a compiler pass into an exit status and a report, clearing the
 * internal-error record. An ordinary error is status 1, with the located message after `label`
 * and a tab when `label` is not empty; when the type checker recorded failures, or the parser
 * syntax errors, each is reported in source order instead, followed by its note on a line of its
 * own when it has one on another line, with a last line if it stopped at `MAX_FAILURES`. An
 * internal error (a check the compiler makes of its own work failed; a compiler bug, never a
 * rejected program) is status 3, with the located message reported as a bug and no label.
 * @param label  the failing pass's name, such as `LEXER` or `PARSER`, or empty
 * @param error  the thrown value
 * @return the exit status and the report, without a final newline */
export let failure = fn(label: Bytes, error: Dynamic): Tuple<I32, Bytes> {
  let message = Std.string(error);
  // The parser recovers from syntax errors on its own, without the checker's record of failures.
  let errors = takeSyntaxErrors();

  for ((span, failed, noteSpan, note) in errors) {
    if (!recordFailure(span, noteFailure(noteSpan, note, failed) as Dynamic)) { break; }
  }

  let (failures, capped) = takeFailures();

  if (takeInternalError()) {
    let bug = `internal error: ${message} (please report this compiler bug)`;
    return (3, _at(_failurePoint(), bug));
  }

  if (failures.len() == 0) {
    let (noteSpan, note) = pendingNote(message);
    failures.push((_failurePoint(), message, noteSpan, note));
  }

  let reports = Array.new<Bytes>(0);

  for ((span, failed, noteSpan, note) in failures) {
    reports.push(_at(span, failed) + _note(span, noteSpan, note));
  }
  if (capped) { reports.push(`stopped after ${MAX_FAILURES} errors`); }
  (1, (label == "" ? "" : `${label}\t`) + reports.join("\n"))
};

/** Writes the report of `error` to standard error and exits with its status (see `failure`).
 * @param label  the failing pass's name, or empty
 * @param error  the thrown value */
let _fail = fn(label: Bytes, error: Dynamic) {
  let (status, report) = failure(label, error);
  _exit(status, `${report}\n`)
};

// Writes the warnings the check recorded to standard error, each located as a failure is.
let _warn = fn() {
  let warnings = takeWarnings();
  let lines = Array.new<Bytes>(0);

  for ((span, message) in warnings) {
    lines.push(_at(span, `warning: ${message}`) + "\n");
  }
  if (lines.len() > 0) { writeText("/dev/stderr", lines.join("")); }
  null
};

/** Runs `stage` and returns what it prints, after writing its warnings; an error it throws is
 * reported instead, without them, and exits (see `_fail`).
 * @param stage  the work, returning its standard output
 * @param label  the label for a failure, or empty
 * @return the output */
let _report = fn(stage: () -> Bytes, label: Bytes): Bytes {
  try {
    let out = stage();
    _warn();
    out
  } catch (e) {
    _fail(label, e);
    ""
  }
};

/** Checks the syntax of `input` for `--parse`. A failure is labelled with the pass that failed,
 * `LEXER` or `PARSER`, and exits.
 * @param input  the input file
 * @return empty output */
let _parse = fn(input: Bytes): Bytes {
  let phase = "LEXER";

  try {
    let lexed = lexFile(readText(input), input);
    phase = "PARSER";
    programSyntax(parseProgram(lexed));
    ""
  } catch (e) {
    _fail(phase, e);
    ""
  }
};

load { process_exec, process_executable } from std;

let _execEntries: (Bytes) -> Bytes = process_exec;
let _executable: () -> Bytes = process_executable;

/** Replaces the process with the program `argv[0]` (found on PATH unless it has a slash), run with
 * `argv`, or exits with status 1 saying why it cannot. */
let _exec = fn(argv: Array<Bytes>) {
  let why = _execEntries(`${argv.join("\0")}\0`);
  _exit(1, `jelloc: ${why}\n`)
};

// What an executable's file name ends with: `.exe` on Windows, else nothing.
let _exe = os() == "windows" ? ".exe" : "";

/** Returns the program to run as the tool `name`; the environment variable `variable` when it is
 * set, else `name` (`name.exe` on Windows) beside the running executable when it is there, else
 * `name`, for PATH. */
let _tool = fn(variable: Bytes, name: Bytes): Bytes {
  let set = getEnv(variable);
  if (set != "") { return set; }
  // An unknown executable leaves `name` itself, for PATH.
  let beside = inDirectory(parentDirectory(_executable()), name + _exe);
  exists(beside) ? beside : name
};

/** Returns the project at `root`, or null when `root` is empty; a manifest that is not valid
 * exits with status 1 and its diagnostic. */
let _load = fn(root: Bytes): ?Project {
  if (root == "") { return null; }

  try {
    loadProject(root)
  } catch (e) {
    _exit(1, `${e}\n`);
    null
  }
};

// Returns the project at or above `start`, or null when there is none (see `_load`).
let _project = fn(start: Bytes): ?Project { _load(findProject(start)) };

/** Returns the directory a subcommand writes its build to, made if missing; `build/` in the
 * project, or under the system's temporary directory outside one.
 * @param project  the project, or null
 * @param under  the directory within it, such as "build/run" */
let _buildDir = fn(project: ?Project, under: Bytes): Bytes {
  let dir = project != null ? inDirectory(project.root, under) : `${tempDir()}/jelloc/${under}`;
  if (!makeDirs(dir)) { _exit(1, `jelloc: cannot make ${dir}\n`); }
  dir
};

/** Adds the sources of `project` to `_roots`, after the `--path` roots, and those of its
 * `dev_dependencies` when `tests` is set. */
let _addSources = fn(project: ?Project, tests: Bool) {
  if (project != null) {
    _roots.appendFrom(project.sources, 0);
    if (tests) { _roots.appendFrom(project.testSources, 0); }
  }
  null
};

/** Returns what a compile assumes in directory `dir`, the project's or else the current one
 * (`Project.compileDefaults`); a manifest that is not valid exits with status 1 and its
 * diagnostic.
 * @return the entry module and the module's name */
let _defaults = fn(dir: Bytes): Tuple<Bytes, Bytes> {
  try {
    compileDefaults(dir)
  } catch (e) {
    _exit(1, `${e}\n`);
    ("", "")
  }
};

/** Returns the entry module in directory `dir` (see `_defaults`), or exits with status 2 and the
 * usage when it does not exist. */
let _entry = fn(dir: Bytes): Bytes {
  let entry = _defaults(dir).0;
  if (!exists(entry)) { _exit(2, `jelloc: no input file, and no ${entry} to compile\n${_USAGE}`); }
  entry
};

/** Fills in what a compile's command line leaves out, from the project at or above the current
 * directory, or else the current directory itself. With no input, it adds the entry module and
 * searches the project's sources and packages as `run` does; a module written without `--out`
 * goes to `build/<name>.jlo` there. `--help`, `--expanders` and `--test` assume nothing.
 * @param inputs  the input files, which it adds the entry module to when empty
 * @param mode  the mode
 * @param output  the `--out` path, or empty
 * @return the path to write the module to, or empty for none */
let _assume = fn(inputs: Array<Bytes>, mode: Mode, output: Bytes): Bytes {
  let named = (mode != Mode.Emit) || (output != "");
  let alone = _testing || (mode == Mode.Help) || (mode == Mode.Expanders);
  if (alone || ((inputs.len() > 0) && named)) { return output; }

  let root = findProject(".");
  let dir = root == "" ? "." : root;

  if (inputs.len() == 0) {
    inputs.push(_entry(dir));
    _addSources(_load(root), false);
  }
  if (named) { return output; }

  let build = inDirectory(dir, "build");
  if (!makeDirs(build)) { _exit(1, `jelloc: cannot make ${build}\n`); }
  `${build}/${_defaults(dir).1}.jlo`
};

/** Compiles `inputs` into the module `output`, reporting a failure as `run` does.
 * @return "", since it prints nothing */
let _emit = fn(inputs: Array<Bytes>, output: Bytes): Bytes {
  _report(fn() {
    _write(output, _allocated(inputs));
    ""
  }, "")
};

/** Compiles `inputs` into the module `output`, reporting a failure as `run` does, and runs it with
 * jello and `args`, its native libraries also found in the directories `near`, then in those of
 * `project`. */
let _compileAndRun = fn(
  inputs: Array<Bytes>,
  output: Bytes,
  args: Array<Bytes>,
  project: ?Project,
  near: Array<Bytes>
) {
  _emit(inputs, output);

  let libraries = Array.new<Bytes>(0);

  for (dir in near) {
    if (exists(dir)) { libraries.push(dir); }
  }
  if (project != null) { libraries.appendFrom(project.libraries, 0); }
  let vm = [_tool("JELLO_VM", "jello")];

  if (libraries.len() > 0) {
    vm.push("--jdll-path");
    vm.push(libraries.join(os() == "windows" ? ";" : ":"));
  }
  vm.push(output);
  _exec(vm.appendFrom(args, 0))
};

/** Runs `jelloc run [options] <file.jello> [args...]`; the options are jelloc's, and the
 * arguments after the file the program's, as they are.
 * @throws an error for a bad command line */
let _runCommand = fn(argv: List<Bytes>) {
  let cur = argv;
  let input = "";

  while (let [arg | after] = cur) {
    let rest = _commonOption(cur);

    if (rest != cur) {
      cur = rest;
      continue;
    }
    input = arg;
    cur = after;
    if (input != "") { break; }
  }

  let project: ?Project = null;

  if (input == "") {
    let root = findProject(".");
    input = _entry(root == "" ? "." : root);
    project = _load(root);
  } else {
    if (!exists(input)) { _exit(1, `jelloc: cannot read ${input}\n`); }
    project = _project(parentDirectory(input));
  }
  _addSources(project, false);

  let name = baseName(input);

  if ((name.len() <= 6) || !name.endsWith(".jello")) {
    throw `run takes a .jello file, not ${input}`;
  }
  let stem = Bytes.slice(name, 0, name.len() - 6);
  let output = `${_buildDir(project, "build/run")}/${stem}.jlo`;
  /* Outside a project the module runs from the temporary directory, so its libraries are found
   * beside the source, as they would be beside a module compiled there. */
  let dir = parentDirectory(input);
  let near = (project == null) ? [inDirectory(dir, "jdll"), dir] : Array.new<Bytes>(0);
  _compileAndRun([input], output, toArray(cur), project, near)
};

// Adds the test files under directory `dir` to `files`, in byte order at each level.
let _testFiles = fn(dir: Bytes, files: Array<Bytes>): Null {
  let entries = listDir(dir);

  for (entry in entries) {
    let path = inDirectory(dir, entry);

    if (entry.endsWith("/")) {
      _testFiles(Bytes.slice(path, 0, path.len() - 1), files);
    } else if (isTestFile(entry)) {
      files.push(path);
    }
  }
  null
};

/** Runs `jelloc test [options] [dir...] [-- args...]`; the test files under the directories, or
 * the project's test directories, as one test binary, with the arguments after `--`.
 * @throws an error for a bad command line */
let _testCommand = fn(argv: List<Bytes>) {
  let dirs = Array.new<Bytes>(0);
  let cur = argv;

  while (let [arg | after] = cur) {
    if (arg == "--") { break; }
    let rest = _commonOption(cur);

    if (rest == cur) {
      dirs.push(arg);
      cur = after;
    } else {
      cur = rest;
    }
  }

  let args = match (cur) {
    [_ | after] => toArray(after),
    _ => Array.new<Bytes>(0),
  };

  let project = _project(dirs.len() == 0 ? "." : dirs[0]);

  if (dirs.len() == 0) {
    if (project == null) {
      throw "test needs a directory outside a project (no jello.json here or above)";
    }
    dirs.appendFrom(project.tests.filter(fn(test: Bytes): Bool { exists(test) }), 0);
    if (dirs.len() == 0) { _exit(1, "jelloc: the project has none of its test directories\n"); }
  }

  let files = Array.new<Bytes>(0);

  for (dir in dirs) {
    if (!exists(dir)) { _exit(1, `jelloc: cannot read ${dir}\n`); }
    _testFiles(dir, files);
  }
  if (files.len() == 0) { _exit(1, `jelloc: no *.test.jello file under ${dirs[0]}\n`); }

  // A test directory's modules are found before those of the other roots, as a test's own helpers.
  _roots = dirs.appendFrom(_roots, 0);
  _addSources(project, true);
  _testing = true;
  _compileAndRun(files, `${_buildDir(project, "build")}/test.jlo`, args, project, [])
};

/** Runs `jelloc deps.get [dir]`; jlo_tool fetches the dependencies of the project at or above
 * `dir`, or else the current directory.
 * @throws an error for a bad command line */
let _depsCommand = fn(argv: List<Bytes>) {
  let args = toArray(argv);
  if (args.len() > 1) { throw `unexpected argument: ${args[1]}`; }
  if ((args.len() == 1) && args[0].startsWith("-")) { throw `unknown option: ${args[0]}`; }

  let root = findProject(args.len() == 0 ? "." : args[0]);
  if (root == "") { _exit(1, "jelloc: no jello.json here or in a directory above\n"); }
  _exec([_tool("JELLO_JLO_TOOL", "jlo_tool"), "get-deps", root])
};

/** Runs `jelloc fmt [--check] [--strip-comments] [path...]`; lays out the files at and under the
 * paths, or under the inputs of the nearest `.formatter`, in the style it gives each. A file that
 * does not lex is reported and left as it is, and so is one the formatter would change the tokens
 * of, which is a bug; either ends the run with status 1 or 3, and `--check` with status 1 when
 * any file would change.
 * @throws an error for a bad command line */
let _fmtCommand = fn(argv: List<Bytes>) {
  let paths = Array.new<Bytes>(0);
  let check = false;
  let strip = false;

  for (arg in toArray(argv)) {
    if (arg == "--check") {
      check = true;
    } else if (arg == "--strip-comments") {
      strip = true;
    } else if (arg.startsWith("-")) {
      throw `unknown option: ${arg}`;
    } else {
      paths.push(arg);
    }
  }

  let root = findFormatter(".");

  if ((root == "") && (paths.len() == 0)) {
    throw "fmt needs a path outside a project with a .formatter (none here or above)";
  }

  let formatter = try {
    loadFormatter(root, strip)
  } catch (e) {
    _exit(1, `${e}\n`);
    loadFormatter("", strip)
  };

  let files = try {
    formatFiles(formatter, paths)
  } catch (e) {
    _exit(1, `jelloc: ${e}\n`);
    Array.new<Bytes>(0)
  };

  let status = 0;
  let changed = Array.new<Bytes>(0);

  for (file in files) {
    let src = readText(file);

    let laidOut = try {
      formatSource(src, file, styleFor(formatter, file))
    } catch (e) {
      writeText("/dev/stderr", `${e}\n`);
      if (status == 0) { status = 1; }
      src
    };

    if (laidOut == null) {
      writeText("/dev/stderr", `jelloc: internal error: laying out ${file} changes its tokens\n`);
      status = 3;
    } else if (laidOut != src) {
      changed.push(file);
      if (!check) { writeText(file, laidOut); }
    }
  }

  if (check && (changed.len() > 0)) {
    writeText("/dev/stdout", changed.join("\n") + "\n");
    if (status == 0) { status = 1; }
  }
  if (status != 0) { System.exit(status); }
  null
};

/** Runs the subcommand `name` with `args`, after it on the command line; a bad command line exits
 * with status 2 and the usage.
 * @return whether `name` is a subcommand */
let _subcommand = fn(name: Bytes, args: List<Bytes>): Bool {
  let command: ?((List<Bytes>) -> Null) = match (name) {
    "run" => _runCommand,
    "test" => _testCommand,
    "deps.get" => _depsCommand,
    "fmt" => _fmtCommand,
    _ => null,
  };
  if (command == null) { return false; }

  try {
    command(args)
  } catch (e) {
    _exit(2, `jelloc: ${e}\n${_USAGE}`);
  }
  true
};

/** Returns the explanation of the one error code in `args`, as `jelloc --explain E0302` prints it;
 * a bad command line, or an unknown code, exits with status 2 and the usage. */
let _explain = fn(args: Array<Bytes>): Bytes {
  if (args.len() != 1) { _exit(2, `jelloc: --explain takes one error code, as E0302\n${_USAGE}`); }
  let text = explain(args[0]);
  if (text == "") { _exit(2, `jelloc: unknown error code: ${args[0]}\n${_USAGE}`); }
  text
};

/** Runs `jelloc` on a command line. A bad command line exits with status 2 and the usage, an
 * input that does not exist with status 1, and a failed compilation with the status `failure`
 * gives.
 * @param argv  the arguments, without the program name
 * @return what to print on standard output; the usage, a listing, or empty */
export let run = fn(argv: List<Bytes>): Bytes {
  if (let [first | rest] = argv) {
    if (_subcommand(first, rest)) { return ""; }
    if (first == "--explain") { return _explain(toArray(rest)); }

    if (((first == "--version") || (first == "-v")) && List.is_nil(rest)) {
      return `jelloc ${version()}\n`;
    }
  }

  let (inputs, mode, given) = try {
    _parseArgs(argv)
  } catch (e) {
    _exit(2, `jelloc: ${e}\n${_USAGE}`);
    (Array.new<Bytes>(0), Mode.Help, "")
  };
  let output = _assume(inputs, mode, given);

  if (mode != Mode.Help) {
    for (input in inputs) {
      if (!exists(input)) { _exit(1, `jelloc: cannot read ${input}\n`); }
    }
  }

  match (mode) {
    Help => _USAGE,
    Lex => _report(fn() { printTokens(lexFile(readText(inputs[0]), inputs[0]).0) }, ""),
    Parse => _parse(inputs[0]),
    Typed => _report(fn() {
      let hir = _checked(inputs);
      _spans ? printHirWithSpans(hir) : printHir(hir)
    }, ""),
    Lowered => _report(fn() { printIr(lowerProgram(_checked(inputs))) }, ""),
    Legalized => _report(fn() {
      let program = _allocated(inputs);
      let listing = printIr(program);
      if (output != "") { _write(output, program); }
      listing
    }, ""),
    Emit => _emit(inputs, output),
    // The compiler runs as a macro program does, so a failure is thrown, not printed.
    Expanders => {
      _expanding = true;

      try {
        let out = emitAllocated(_allocated(inputs), _location);
        _warn();
        out
      } catch (e) {
        throw failure("", e).1;
      }
    },
  }
};
