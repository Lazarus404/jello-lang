import { test, run } from jellotest.Runner;
import { lex } from frontend.Lexer;
import { parseProgram, programSyntax } from frontend.Parser;
import type { Syntax } from frontend.Source;

let tree = fn(source: Bytes): Syntax { programSyntax(parseProgram(lex(source))) };

let span = fn(node: Syntax): Bytes { match (node) { Node(_, start, end, _) => Std.string(start) + ".." + Std.string(end) } };
let child = fn(node: Syntax, i: I32): Syntax { match (node) { Node(_, _, _, children) => children[i] } };
let width = fn(node: Syntax): I32 { match (node) { Node(_, _, _, children) => children.len() } };

let tail = fn(source: Bytes): Syntax {
  let root = tree(source);
  child(root, width(root) - 1)
};

test("spans every expression with its children in field order", fn(t) {
  let product = tail("(1 + 2) * f(3)");
  t.is(span(product), "0..14");
  t.is(span(child(product, 0)), "0..7");
  t.is(span(child(child(product, 0), 1)), "5..6");
  let call = child(product, 1);
  t.is(span(call), "10..14");
  t.is(width(call), 2);
  t.is(span(child(call, 0)), "10..11");
  t.is(span(child(call, 1)), "12..13");
});

test("gives invented nodes the span of the source that implies them", fn(t) {
  let branch = tail("if (true) { 1 }");
  t.is(width(branch), 3);
  t.is(span(child(branch, 2)), "0..15");
  let negative = tail("-5");
  t.is(span(negative), "0..2");
  t.is(span(child(negative, 0)), "1..2");
});

test("spans statements, parameters and loop tails", fn(t) {
  let root = tree("let f = fn(a: I32, b: I32): I32 { a };\nwhile (false) { f(1, 2) }\n0");
  t.is(width(root), 3);
  t.is(span(root), "0..66");
  let function = child(child(root, 0), 0);
  t.is(width(function), 3);
  t.is(span(child(function, 1)), "19..25");
  let loop = child(root, 1);
  t.is(span(child(loop, 1)), "55..62");
});

run()
