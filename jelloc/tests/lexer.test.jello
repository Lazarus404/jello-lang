import { test, run } from jellotest.Runner;
import { u8 } from std.core.Bytes;

import { lex, tokenEnds, tokenPath, tokenStarts, Token, IntegerSize, FloatSize } from frontend.Lexer;

test("records half-open token byte spans", fn(t) {
  lex("  1i32 + abc");
  let starts = tokenStarts();
  let ends = tokenEnds();
  t.is(tokenPath(), "<input>");
  t.is(starts[0], 2);
  t.is(ends[0], 6);
  t.is(starts[1], 7);
  t.is(ends[1], 8);
  t.is(starts[2], 9);
  t.is(ends[2], 12);
  t.is(starts[3], 12);
  t.is(ends[3], 12);
});

test("lexes integer sizes without narrowing their digits", fn(t) {
  let toks = lex("1i8 2i16 3i32 4i64 5u8 6u16 7u32 18446744073709551615u64");
  t.is(toks[0], Token.IntegerConstant("1", IntegerSize.I8));
  t.is(toks[1], Token.IntegerConstant("2", IntegerSize.I16));
  t.is(toks[2], Token.IntegerConstant("3", IntegerSize.I32));
  t.is(toks[3], Token.IntegerConstant("4", IntegerSize.I64));
  t.is(toks[4], Token.IntegerConstant("5", IntegerSize.U8));
  t.is(toks[5], Token.IntegerConstant("6", IntegerSize.U16));
  t.is(toks[6], Token.IntegerConstant("7", IntegerSize.U32));
  t.is(toks[7], Token.IntegerConstant("18446744073709551615", IntegerSize.U64));
});

test("lexes floating-point sizes", fn(t) {
  let toks = lex("1f16 2.5f32 3e4f64 4.5");
  t.is(toks[0], Token.FloatConstant("1", FloatSize.F16));
  t.is(toks[1], Token.FloatConstant("2.5", FloatSize.F32));
  t.is(toks[2], Token.FloatConstant("3e4", FloatSize.F64));
  t.is(toks[3], Token.FloatConstant("4.5", FloatSize.Infer));
});

test("distinguishes tuple members from leading-dot floats", fn(t) {
  let toks = lex("t.0 .5");
  t.is(toks[0], Token.Ident("t"));
  t.is(toks[1], Token.Dot);
  t.is(toks[2], Token.IntegerConstant("0", IntegerSize.Infer));
  t.is(toks[3], Token.FloatConstant(".5", FloatSize.Infer));
});

test("leaves unsuffixed integer size for type checking", fn(t) {
  let toks = lex("42");
  t.is(toks[0], Token.IntegerConstant("42", IntegerSize.Infer));
});

test("distinguishes keywords from identifiers", fn(t) {
  let toks = lex("let fn if else enum true false null return new as is letter async");
  t.is(toks[0], Token.Let);
  t.is(toks[1], Token.Fn);
  t.is(toks[2], Token.If);
  t.is(toks[3], Token.Else);
  t.is(toks[4], Token.EnumDecl);
  t.is(toks[5], Token.True);
  t.is(toks[6], Token.False);
  t.is(toks[7], Token.Null);
  t.is(toks[8], Token.Return);
  t.is(toks[9], Token.New);
  t.is(toks[10], Token.As);
  t.is(toks[11], Token.Is);
  t.is(toks[12], Token.Ident("letter"));
  t.is(toks[13], Token.Ident("async"));
});

test("lexes const as a keyword", fn(t) {
  let toks = lex("const constant");
  t.is(toks[0], Token.Const);
  t.is(toks[1], Token.Ident("constant"));
});

test("lexes type declaration keywords", fn(t) {
  let toks = lex("type typedef typed");
  t.is(toks[0], Token.Type);
  t.is(toks[1], Token.Typedef);
  t.is(toks[2], Token.Ident("typed"));
});

test("lexes error handling keywords", fn(t) {
  let toks = lex("try catch throw trying catcher");
  t.is(toks[0], Token.Try);
  t.is(toks[1], Token.Catch);
  t.is(toks[2], Token.Throw);
  t.is(toks[3], Token.Ident("trying"));
  t.is(toks[4], Token.Ident("catcher"));
});

test("lexes object receiver keywords", fn(t) {
  let toks = lex("this super thisValue superior");
  t.is(toks[0], Token.This);
  t.is(toks[1], Token.Super);
  t.is(toks[2], Token.Ident("thisValue"));
  t.is(toks[3], Token.Ident("superior"));
});

test("lexes bit syntax keywords", fn(t) {
  let toks = lex("bits rest match bitsValue restart matcher");
  t.is(toks[0], Token.Bits);
  t.is(toks[1], Token.Rest);
  t.is(toks[2], Token.Match);
  t.is(toks[3], Token.Ident("bitsValue"));
  t.is(toks[4], Token.Ident("restart"));
  t.is(toks[5], Token.Ident("matcher"));
});

test("lexes list syntax keywords", fn(t) {
  let toks = lex("list for do when listed format donut whenever");
  t.is(toks[0], Token.ListLiteral);
  t.is(toks[1], Token.For);
  t.is(toks[2], Token.Do);
  t.is(toks[3], Token.When);
  t.is(toks[4], Token.Ident("listed"));
  t.is(toks[5], Token.Ident("format"));
  t.is(toks[6], Token.Ident("donut"));
  t.is(toks[7], Token.Ident("whenever"));
});

test("leaves built-in names as identifiers", fn(t) {
  let toks = lex("Array Atom Bool Bytes Enum F16 F32 F64 I8 I16 I32 I64 List System Tuple U8 U16 U32 U64");
  t.is(toks[0], Token.Ident("Array"));
  t.is(toks[4], Token.Ident("Enum"));
  t.is(toks[10], Token.Ident("I32"));
  t.is(toks[13], Token.Ident("System"));
  t.is(toks[14], Token.Ident("Tuple"));
  t.is(toks[18], Token.Ident("U64"));
});

test("rejects unknown and mismatched numeric suffixes", fn(t) {
  t.throws(fn(_t) { lex("1i128"); });
  t.throws(fn(_t) { lex("1.0u32"); });
  t.throws(fn(_t) { lex("1f32x"); });
});

test("lexes byte literals and escapes", fn(t) {
  let toks = lex("\"hello\\nworld\" '\\u{1f642}' \"\\u0041\\0\"");
  t.is(toks[0], Token.BytesLiteral("hello\nworld"));
  t.is(toks[1], Token.BytesLiteral("🙂"));
  t.is(toks[2], Token.BytesLiteral("A" + u8(0)));
  t.throws(fn(_t) { lex("\"unterminated"); });
  t.throws(fn(_t) { lex("\"\\q\""); });
  t.throws(fn(_t) { lex("\"\\u{110000}\""); });
  t.throws(fn(_t) { lex("\"\\u{d800}\""); });
});

test("lexes regexp literals", fn(t) {
  let toks = lex("~r/a+/ ~r/hello/q ~r/a\\/b/im ~r/[a]/");
  t.is(toks[0], Token.RegExpLiteral("a+", ""));
  t.is(toks[1], Token.RegExpLiteral("hello", "q"));
  t.is(toks[2], Token.RegExpLiteral("a\\/b", "im"));
  t.is(toks[3], Token.RegExpLiteral("[a]", ""));
  t.throws(fn(_t) { lex("~r/unterminated"); });
});

test("lexes Jello operators longest first", fn(t) {
  let toks = lex("... == => != <- <= >= ++ += -- -= -> *= /= << >> && || |> (){}[];:,?.=!<>+-*/%&|^");
  t.is(toks[0], Token.DotDotDot);
  t.is(toks[1], Token.EqualEqual);
  t.is(toks[2], Token.FatArrow);
  t.is(toks[3], Token.NotEqual);
  t.is(toks[4], Token.LessMinus);
  t.is(toks[5], Token.LessEqual);
  t.is(toks[6], Token.GreaterEqual);
  t.is(toks[7], Token.PlusPlus);
  t.is(toks[8], Token.PlusEqual);
  t.is(toks[9], Token.MinusMinus);
  t.is(toks[10], Token.MinusEqual);
  t.is(toks[11], Token.Arrow);
  t.is(toks[12], Token.StarEqual);
  t.is(toks[13], Token.SlashEqual);
  t.is(toks[14], Token.LessLess);
  t.is(toks[15], Token.GreaterGreater);
  t.is(toks[16], Token.And);
  t.is(toks[17], Token.PipePipe);
  t.is(toks[18], Token.PipeGreater);
  t.is(toks[19], Token.LParen);
  t.is(toks[41], Token.Caret);
});

run()
