// expect: fn i32 3 other true false present
let kind = fn(d: Dynamic): Bytes {
  match (d) { is fn => "fn", is I32 as n => "i32 " + Std.string(n), _ => "other" }
};
let maybe: ?((I32) -> I32) = fn(n: I32): I32 { n + 1 };
let call = match (maybe) { is fn => "present", null => "absent" };
let f = fn(x: I32): I32 { x };
[kind(f as Dynamic), kind(3 as Dynamic), kind("s" as Dynamic), Std.string((f as Dynamic) is fn),
  Std.string((1 as Dynamic) is fn), call].join(" ")
