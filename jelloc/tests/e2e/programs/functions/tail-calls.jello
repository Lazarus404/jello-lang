// expect: 3000000
// A call of a function by itself in return position reuses its frame, through `return`, an if
// and a block's tail, so recursion this deep does not run out of stack.
let count = fn(n: I32, acc: I32): I32 { if (n == 0) { return acc; } return count(n - 1, acc + 1); };
let down = fn(n: I32): I32 { n == 0 ? 0 : { let next = n - 1; down(next) } };
let swap = fn(n: I32, a: I32, b: I32): I32 { if (n == 0) { a * 10 + b } else { swap(n - 1, b, a) } };
let gcd = fn(a: I32, b: I32): I32 { b == 0 ? a : gcd(b, a % b) };
System.assertEq(swap(3, 1, 2), 21);
System.assertEq(swap(4, 1, 2), 12);
System.assertEq(gcd(48, 18), 6);
System.assertEq(down(1000000), 0);
count(1000000, 0) + count(2000000, 0)
