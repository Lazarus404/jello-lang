// expect: 26
// A function may name an annotated global declared after it; the program reads each one only
// after its initialiser has run.
let isEven: (I32) -> Bool = fn(n) { n == 0 ? true : isOdd(n - 1) };
let isOdd: (I32) -> Bool = fn(n) { n == 0 ? false : isEven(n - 1) };
let twice = fn(n: I32): I32 { scale * n };
let scale: I32 = 13;
System.assert(isEven(10));
System.assert(isOdd(7));
twice(2)
