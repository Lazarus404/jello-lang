// expect: 42071
// A function that always throws takes its result type from the tail after
// the throw, which never runs: here Null, so callers use it as a statement.
let fail = fn(message: Bytes) { throw "failed: " + message; null };
let double = fn(n: I32): I32 { if (n < 0) { fail("negative"); } n * 2 };
let firstPositive = fn(a: I32, b: I32) { if (a > 0) { return a; } if (b > 0) { return b; } throw "none"; 0 };
let caught = try { double(-1) } catch (e) { (e as Bytes) == "failed: negative" ? 1 : 0 };
double(21) * 1000 + firstPositive(-3, 7) * 10 + caught
