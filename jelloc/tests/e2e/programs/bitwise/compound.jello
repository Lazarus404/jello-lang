// expect: ok
// Each binary operator but the comparisons has a compound assignment, on a variable and on
// an element.
let x = 17;
x %= 5; System.assertEq(x, 2);
x <<= 3; System.assertEq(x, 16);
x >>= 2; System.assertEq(x, 4);
x |= 3; System.assertEq(x, 7);
x &= 5; System.assertEq(x, 5);
x ^= 1; System.assertEq(x, 4);
let a = [9, 10, -16];
a[0] %= 4; a[1] ^= 3; a[2] >>= 2;
System.assertEq(a[0], 1); System.assertEq(a[1], 9); System.assertEq(a[2], -4);
let w = 1i64; w <<= 40; w |= 5i64;
System.assertEq(w, 1099511627781i64);
"ok"
