// expect: 111111
// Bitwise operators and shifts: one operand type, shift counts modulo the
// width, and an arithmetic >>.
let shl = fn(a: I32, n: I32): I32 { a << n };
let shr = fn(a: I32, n: I32): I32 { a >> n };
let shlw = fn(a: I64, n: I64): I64 { a << n };
let shrw = fn(a: I64, n: I64): I64 { a >> n };
let min = -2147483648;
let one: I64 = 1; let low: I64 = 4294967295;
let pack = fn(high: I32, lowBits: I32): I64 { ((high as I64) << 32) | ((lowBits as I64) & low) };
let digits = 0;
digits = digits * 10 + (shl(1, 31) == min && shl(1, 32) == 1 && shl(1, 33) == 2 ? 1 : 0);
digits = digits * 10 + (shr(-1, 1) == -1 && shr(min, 31) == -1 && shr(64, 33) == 32 ? 1 : 0);
digits = digits * 10 + ((12 & 10) == 8 && (12 | 10) == 14 && (12 ^ 10) == 6 && (5 ^ -1) == -6 ? 1 : 0);
digits = digits * 10 + (shlw(one, 32) == 4294967296 && shlw(one, 64) == one && shrw(-one, 63) == -one ? 1 : 0);
digits = digits * 10 + (pack(3, -1) == 17179869183 && (pack(3, -1) >> 32) as I32 == 3 && pack(-1, 0) == -4294967296 ? 1 : 0);
let wide: I64 = 1 << 40;
digits = digits * 10 + (wide == 1099511627776 && (1 << 2 + 1) == 5 ? 1 : 0);
digits
