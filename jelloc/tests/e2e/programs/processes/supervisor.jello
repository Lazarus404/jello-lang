// expect: 3 1 1 | 2 2 1 | 1 2 2 1 | 2 1 true | Exit.Crashed(too many restarts) 3
// schedulers: 4
// Supervisors restart crashed children by strategy and policy, a child is found again after its
// restarts and not once it has finished, stopping one waits for its children, and one that
// restarts too often gives up, crashing. Slot 11 counts the exits of children made by child.
import std.concurrent.Process as Process;
import type { Process, Inbox, Reply } from std.concurrent.Process;
import std.concurrent.Supervisor as Supervisor;
import type { Supervisor, Child, Strategy, Restart } from std.concurrent.Supervisor;
import { Strategy, Restart } from std.concurrent.Supervisor;
import type { Buffer } from std.concurrent.Buffer;

enum Ask { Run(reply: Reply<I32>); }

let starts = new Buffer(64);

// Parks until the count at SLOT reaches WANT, then a while longer, for any further start to show.
let settle = fn(slot: I32, want: I32) {
  let waited = 0;
  while ((starts.getI32(slot) < want) && (waited < 5000)) {
    Process.sleep(5);
    waited = waited + 5;
  }
  Process.sleep(50);
};

// The counts at FIRST to LAST.
let counts = fn(first: I32, last: I32): Bytes {
  let out = Std.string(starts.getI32(first));
  let i = first + 1;
  while (i <= last) { out = out + " " + Std.string(starts.getI32(i)); i++; }
  out
};

// A child counting its starts in COUNTED at SLOT and crashing on its first CRASHES of them, once
// the child counting at AFTER, if any, has started; it then parks.
let child = fn(
  counted: Buffer, name: Bytes, slot: I32, crashes: I32, after: I32, restart: Restart
): Child {
  new Child(name, fn() {
    Process.onExit(fn() { counted.addI32(11, 1); });
    let run = counted.addI32(slot, 1);
    if (after >= 0) {
      while (counted.getI32(after) == 0) { Process.sleep(1); }
      Process.sleep(20);
    };
    if (run < crashes) { throw "crash"; };
    new Inbox<I32>().receive();
  }, restart)
};

// A transient child counting its exits in COUNTED at SLOT, which returns once the child counting
// at AFTER has started.
let finisher = fn(counted: Buffer, name: Bytes, slot: I32, after: I32): Child {
  new Child(name, fn() {
    Process.onExit(fn() { counted.addI32(slot, 1); });
    while (counted.getI32(after) == 0) { Process.sleep(1); }
  }, Restart.Transient)
};

// One for one: only the crashing child restarts, and child finds its latest run.
let one = Supervisor.start(Strategy.OneForOne, [
  new Child("flaky", fn() {
    let run = starts.addI32(0, 1) + 1;
    if (run < 3) { throw "crash"; };
    let inbox = new Inbox<Ask>();
    while (true) { match (inbox.receive()) { Run(reply) => reply.send(run) }; }
  }, Restart.Permanent),
  child(starts, "steady", 1, 0, -1, Restart.Permanent)
], 10, 60000);
settle(0, 3);
let flaky = Supervisor.child<Ask>(one, "flaky");
let asked = match (flaky) {
  null => -1,
  p => Process.call<Ask, I32>(p, fn(r: Reply<I32>): Ask { Ask.Run(r) }),
};
let first = Std.string(asked) + " " + counts(1, 1);
one.stop();
first = first + " " + counts(11, 11);

// One for all: the other child restarts too, but for a temporary one.
let all = Supervisor.start(Strategy.OneForAll, [
  child(starts, "a", 2, 1, 3, Restart.Permanent),
  child(starts, "b", 3, 0, -1, Restart.Permanent),
  child(starts, "c", 12, 0, -1, Restart.Temporary)
], 10, 60000);
settle(3, 2);
let second = counts(2, 3) + " " + counts(12, 12);
all.stop();

// Rest for one: the children after the crashing one restart, the one before does not, nor one
// that had finished.
let rest = Supervisor.start(Strategy.RestForOne, [
  child(starts, "x", 4, 0, -1, Restart.Permanent),
  child(starts, "y", 5, 1, 13, Restart.Permanent),
  child(starts, "z", 6, 0, -1, Restart.Permanent),
  finisher(starts, "w", 13, 6)
], 10, 60000);
settle(6, 2);
let third = counts(4, 6) + " " + counts(13, 13);
rest.stop();

// A transient child restarts after a crash but not once it returns; a temporary one never does.
let policies = Supervisor.start(Strategy.OneForOne, [
  new Child("transient", fn() {
    if (starts.addI32(7, 1) < 1) { throw "crash"; };
  }, Restart.Transient),
  child(starts, "temporary", 8, 1, -1, Restart.Temporary)
], 10, 60000);
settle(7, 2);
let fourth = counts(7, 8) + " " + Std.string(Supervisor.child<I32>(policies, "temporary") == null);
policies.stop();

// A third restart within a minute is more than two: the supervisor gives up.
let doomed = Supervisor.start(Strategy.OneForOne, [
  child(starts, "doomed", 9, 1000, -1, Restart.Permanent)
], 2, 60000);
let fifth = Std.string(doomed.join()) + " " + counts(9, 9);

first + " | " + second + " | " + third + " | " + fourth + " | " + fifth
