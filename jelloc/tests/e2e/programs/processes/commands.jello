// expect: 8 216 true
// schedulers: 4
// Processes on several schedulers run commands at once. One process's waitAny may reap another's
// child, which then still reads its own status and output.
import std.concurrent.Process as Process;
import type { Process, Inbox } from std.concurrent.Process;
import { start, wait, stdout, waitAny } from std.io.Command;

let PROCS = 8;
let inbox = new Inbox<I32>();
let me = Process.self<I32>(inbox);
let i = 0;
while (i < PROCS) {
  let k = i;
  Process.spawn<I32>(fn(_: Inbox<I32>) {
    let quick = start(["/bin/sh", "-c", "printf " + Std.string(k) + "; exit " + Std.string(k)], []);
    let slow = start(["/bin/sh", "-c", "sleep 0.05; exit " + Std.string(k + 20)], []);
    waitAny([quick, slow]);
    let ok = stdout(quick) == Std.string(k);
    me.send(ok ? wait(quick) + wait(slow) : -1000);
  });
  i++;
}
let n = 0;
let total = 0;
let good = true;
while (n < PROCS) {
  let got = inbox.receive();
  if (got < 0) { good = false; }
  total = total + got;
  n++;
}
Std.string(n) + " " + Std.string(total) + " " + Std.string(good)
