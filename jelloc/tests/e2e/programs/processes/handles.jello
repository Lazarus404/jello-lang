// expect: ab42 7 b true | false
// schedulers: 4
// A native handle sent to another process, in a message or in the globals a process starts with,
// is a handle of its own there to the same regexp, match or timer: here the child cancels its
// parent's timer.
import std.concurrent.Process as Process;
import type { Process, Inbox } from std.concurrent.Process;
import { compile, find, group } from std.core.RegExp;

let digits = compile("[0-9]+", "");
enum Message { Run; }

let inbox = new Inbox<Bytes>();
let me = Process.self<Bytes>(inbox);
let timer = inbox.sendAfter(100000, "never");
let child = Process.spawn<Message>(fn(own: Inbox<Message>) {
  own.receive();
  me.send(group(find("ab42", compile("[a-z]*[0-9]+", "")), 0) as Bytes);
  me.send(group(find("x7", digits), 0) as Bytes);
  me.send(group(find("a-b-c", compile("-([a-z])-", "")), 1) as Bytes);
  me.send(Std.string(timer.cancel()));
});
child.send(Message.Run);
let got = inbox.receive() + " " + inbox.receive() + " " + inbox.receive() + " " + inbox.receive();
child.join();
got + " | " + Std.string(timer.cancel())
