// error: 5:30: v is annotated Tuple<Bytes, Bytes>, but its value is Tuple<I64, I32>
// The annotation's Bytes binds A before I32 fails to match Bytes; rolled back, A is I64 from the
// argument, so the argument checks and the annotation is what mismatches.
let mk<A> = fn(a: A): Tuple<A, I32> { (a, 1) };
let v: Tuple<Bytes, Bytes> = mk(5i64);
