// expect: 500500
// gc: collects
enum List { Cons(head: I32, tail: List); Nil; }

let build = fn(n: I32): List {
  let items = List.Nil; let i = 0;
  while (i < n) { i = i + 1; items = List.Cons(i, items); }
  items
};

let total = fn(items: List): I32 {
  let sum = 0; let rest = items;
  while (true) {
    match (rest) {
      Cons(head, tail) => { sum = sum + head; rest = tail; },
      Nil => { return sum; },
    }
  }
  0
};


let churn = fn(rounds: I32): I32 {
  let round = 0;
  while (round < rounds) { build(1000); round = round + 1; }
  round
};


let kept = build(1000);
churn(200);
total(kept)
