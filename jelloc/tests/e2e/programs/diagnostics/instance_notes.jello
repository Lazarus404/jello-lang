/* An error in an instance of a generic, which may be declared in another
 * module, notes where the instance is needed. */
typedef Box<T> = { let value: Dynamic; };
prototype Box<T> {
  init(value: Dynamic) { this.value = value; };
  get(): T { this.value as T };
};
let unwrap<T> = fn(value: Dynamic): T { value as T };

let box = new Box<Array<I32>>(1 as Dynamic);
let numbers = unwrap<Array<I32>>(1 as Dynamic);
