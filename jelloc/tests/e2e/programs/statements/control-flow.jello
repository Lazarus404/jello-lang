// expect: 39
// Statement `if` with else-if chains, early returns, and loop exits from
// inside an `if`.
let classify = fn(n: I32): I32 {
  let result = 0;
  if (n < 0) {
    result = 1;
  } else if (n == 0) {
    result = 2;
  } else {
    result = 3;
  }
  result
};

// Both branches return, so the tail never runs.
let sign = fn(n: I32): I32 {
  if (n < 0) { return 0 - 1; } else { return 1; }
  0
};

// Sums 1..limit, skipping 3 and stopping after 6.
let sum = fn(limit: I32): I32 {
  let total = 0; let i = 0;
  while (i < limit) {
    i = i + 1;
    if (i == 3) { continue; }
    if (i > 6) { break; }
    total = total + i;
  }
  total
};

// The first value above the threshold, returned from inside the loop.
let firstAbove = fn(threshold: I32) {
  let i = 0;
  while (true) {
    if (i > threshold) { return i; }
    i = i + 1;
  }
  0
};

classify(0 - 5) + classify(0) + classify(5) + sign(0 - 2) + sign(2) + sum(100) + firstAbove(14)
