// expect: 4321
// A `while` or `enum` may end with a `;`, which adds nothing: here at the top
// level, in a block and as the last statement of a function returning Null.
enum Step { Up; Down; };
let i = 0;
while (i < 4) { i++; };
let count = fn(n: I32): Null {
  let k = 0;
  while (k < n) { k++; };
};
count(3);
let total = 0;
{
  let j = 0;
  while (j < 3) { j++; total = total + 100; };
}
let up = match (Step.Up) { Up => 20, Down => 0 };
i * 1000 + total + up + 1
