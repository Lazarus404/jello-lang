// expect: 61492
// gc: collects
// More values live at once than JLO's 256 registers, of four kinds: allocation
// spills some. Spilled Bytes and arrays must survive the collections churn forces.

enum Chain { Link(next: Chain); End; }

// Allocates and drops ROUNDS chains of 1000 links, forcing collections.
let churn = fn(rounds: I32): I32 {
  let round = 0;
  while (round < rounds) {
    let chain = Chain.End; let i = 0;
    while (i < 1000) { chain = Chain.Link(chain); i = i + 1; }
    round = round + 1;
  }
  round
};

