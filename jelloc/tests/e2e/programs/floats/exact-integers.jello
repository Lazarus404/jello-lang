// expect: ok
// An unsuffixed integer literal in a float context is the float of its value, which must be exact;
// a U64 above the greatest I64 included. A long literal reads in full.
let big: F64 = 18446744073709549568;
System.assertEq(Std.string(big), "18446744073709550000.0");
let least: F64 = -9223372036854775808;
System.assertEq(Std.string(least), "-9223372036854776000.0");
let hex: F32 = 0x100;
System.assertEq(Std.string(hex), "256.0");
let zero: F64 = -0;
System.assertEq(Std.string(zero), "0.0");
let half: F16 = 65504;
System.assertEq(Std.string(half), "65500.0");
System.assertEq(Std.string(1.), "1.0");
"ok"
