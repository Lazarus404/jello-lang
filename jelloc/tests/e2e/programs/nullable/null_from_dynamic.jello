// expect: null ok
// `as Null` extracts the one value of Null from a Dynamic, so a process may take Null messages.
import std.concurrent.Process as Process;
import type { Inbox } from std.concurrent.Process;
let show = fn(d: Dynamic): Bytes { `${d as Null}` };
let child = Process.spawn<Null>(fn(inbox: Inbox<Null>) { inbox.receive(); null; });
child.send(null);
`${show(null as Dynamic)} ok`
