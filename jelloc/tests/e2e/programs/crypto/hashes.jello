// expect: ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
// expect: cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7
// expect: ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f
// expect: 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843
// expect: 164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737
// expect: 0c60c80f961f0e71f3a9b524af6012062fe037a6|4b007901b765489abead49d926f721d065a429c1
// expect: ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43
// expect: 3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865
// expect: 16 20 28 32 48 64|true false false|e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
// expect: Hash.digest: unknown algorithm sha3|Hash.pbkdf2: iterations 0 is not 1 or more
// expect: Hash.hkdf: length 8161 is not from 1 to 8160|Hash.size: unknown algorithm SHA256
/* The published answers: the digests of "abc" (RFC 1321, FIPS 180-4), HMAC
 * (RFC 4231, test case 2), PBKDF2 with SHA-1 (RFC 6070) and SHA-256, and HKDF
 * (RFC 5869, test case 1); then the sizes, comparing, and what throws. */
import std.crypto.Hash as Hash;

let error = fn(f: () -> Bytes): Bytes { try { f() } catch (e) { Std.string(e) } };
let jefe = "what do ya want for nothing?";
Bytes.join([
  Hash.md5("abc").toHex() + "|" + Hash.sha1("abc").toHex(),
  Hash.digest("sha224", "abc").toHex(),
  Hash.sha256("abc").toHex(),
  Hash.sha384("abc").toHex(),
  Hash.sha512("abc").toHex(),
  Hash.hmac("sha256", "Jefe", jefe).toHex(),
  Hash.hmac("sha512", "Jefe", jefe).toHex(),
  Hash.pbkdf2("sha1", "password", "salt", 1, 20).toHex() + "|"
    + Hash.pbkdf2("sha1", "password", "salt", 4096, 20).toHex(),
  Hash.pbkdf2("sha256", "password", "salt", 2, 32).toHex(),
  Hash.hkdf("sha256", Bytes.fromHex("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"),
    Bytes.fromHex("000102030405060708090a0b0c"), Bytes.fromHex("f0f1f2f3f4f5f6f7f8f9"), 42).toHex(),
  Bytes.join(["md5", "sha1", "sha224", "sha256", "sha384", "sha512"].map(fn(a: Bytes): Bytes {
    Std.string(Hash.size(a))
  }), " ") + "|" + Std.string(Hash.equal("tag", "tag")) + " " + Std.string(Hash.equal("tag", "tab"))
    + " " + Std.string(Hash.equal("tag", "tags")) + "|" + Hash.sha256("").toHex(),
  error(fn() { Hash.digest("sha3", "abc") }) + "|"
    + error(fn() { Hash.pbkdf2("sha256", "password", "salt", 0, 32) }),
  error(fn() { Hash.hkdf("sha256", "key", "", "", 8161) }) + "|"
    + error(fn() { Std.string(Hash.size("SHA256")) })
], "\n")
