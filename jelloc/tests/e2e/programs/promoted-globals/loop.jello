// expect: 5050 2.5 hello!!! 7
let total = 0; let i = 1;
while (i <= 100) { total += i; i++; }
let x = 0.5; let k = 0;
while (k < 2) { x += 1.0; k++; }
let s = "hello"; let n = 0;
while (n < 3) { s = s + "!"; n++; }
let maybe: ?I32 = null;
if (total > 0) { maybe = 7; }
Std.string(total) + " " + Std.string(x) + " " + s + " " + Std.string(maybe)
