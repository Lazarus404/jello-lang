// expect: 2,2,0,3,7,ok,42,(7, "ok"),(),(1,),tg,
// Tuple.len and Tuple.get, and a tuple's len and toString methods.
let out = "";
let put = fn(v: Bytes) { out = out + v + ","; null };
let n = fn(v: I32): Bytes { Std.string(v) };
let t = (7, "ok");
put(n(Tuple.len(t))); put(n(t.len())); put(n(Tuple.len(()))); put(n((1, 2, 3).len()));
let first: Dynamic = Tuple.get(t, 0);
let second: Dynamic = Tuple.get(t, 1);
put(n(first as I32)); put(second as Bytes);
let single = (42,);
put(n(Tuple.get(single, 0) as I32));
put(t.toString()); put(().toString()); put((1,).toString());
// The tuple, then the index.
let order = "";
let tuple = fn(): Tuple<I32, I32> { order = order + "t"; (1, 2) };
let index = fn(): I32 { order = order + "g"; 1 };
let _ = Tuple.get(tuple(), index());
put(order);
out
