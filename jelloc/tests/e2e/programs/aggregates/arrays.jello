// expect: 37
// Generic arrays: literals, push, pop, resize, nested arrays and element assignment.
let words = fn(): Array<Bytes> {
  let out: Array<Bytes> = [];
  out.push("a"); out.push("bb"); out.push("ccc");
  out
};

let total = fn(rows: Array<Array<I32>>): I32 {
  let sum = 0; let r = 0;
  while (r < rows.len()) {
    let c = 0;
    while (c < Array.len(rows[r])) { sum += rows[r][c]; c++; }
    r++;
  }
  sum
};

let build = fn(): I32 {
  let names = words();
  let popped = names.pop();
  let rows = [[1, 2], [3]];
  rows[1].push(4);
  rows.push(Array.new<I32>(2));
  rows[2][1] = 10;
  let counts = Array.new<I32>(0);
  let i = 0;
  while (i < 1000) { counts.push(i); i++; }
  Array.resize(counts, 3);
  // Resize returns the same array, zero-extended.
  let grown = Array.resize(counts, 5);
  // 2 + 3 + 20 + 5 + 5 + 2 + 0 = 37
  names.len() + popped.len() + total(rows) + counts.len() + grown.len() + counts[2] + grown[4]
};

build()
