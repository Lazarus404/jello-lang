// expect: === RUN   Failing/testPasses
// expect: === RUN   Failing/testFailsTwice
// expect: --- FAIL: Failing/testFailsTwice ($DIR/Failing.test.jello:22)
// expect:     first
// expect:     second
// expect: === RUN   Failing/testThrows
// expect: --- FAIL: Failing/testThrows ($DIR/Failing.test.jello:29)
// expect:     threw boom
// expect: === RUN   Failing/testRunsAfterAThrow
// expect: --- FAIL: Hooks/beforeAll
// expect:     threw no setup
// expect: FAIL
// status: 1
// flags: --test --path $DIR --path $DIR/auxiliary $DIR/auxiliary/Hooks.test.jello
// A failure names where its test is declared and fails the run.
import type { Test } from std.testing;
import std.testing as T;

let testPasses = fn(t: Test) { null };


let testFailsTwice = fn(t: Test) {
  T.fail(t, "first");
  T.fail(t, "second");
  null
};


let testThrows = fn(t: Test) { throw "boom"; null };

let testRunsAfterAThrow = fn(t: Test) { null };
