package frontend;

// Counts in steps of a private size.
let _step = 2;
let _scaled = fn(times: I32): I32 { times * _step };
enum Parity { Even; Odd; }
let _parity = fn(value: I32): Parity { value % 2 == 0 ? Parity.Even : Parity.Odd };

export let count = fn(times: I32): I32 { _scaled(times) + 1 };
