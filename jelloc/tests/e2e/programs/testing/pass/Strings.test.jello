// expect: === RUN   Strings/testJoins
// expect: === RUN   frontend/Counter/testCountsInSteps
// expect: === RUN   frontend/Counter/testSeesPrivateNames
// expect: frontend/Counter: afterAll
// expect: ok
// flags: --test --path $DIR/.. --path $DIR --path $DIR/auxiliary $DIR/auxiliary/frontend/Counter.test.jello $DIR/auxiliary/empty/Empty.test.jello
// Test binaries: --test compiles the tests in the files, each a module under
// the innermost --path root it is in, with an entry that passes them to
// std.testing.main. A file's beforeAll and afterAll run around its tests; a
// test sees the private names of the module it tests; a file without tests
// runs nothing.
import type { Test } from std.testing;
import std.testing as T;

let testJoins = fn(t: Test) {
  let joined = "a" + "b";
  if (joined != "ab") { T.fail(t, "joined is " + joined); }
  null
};
