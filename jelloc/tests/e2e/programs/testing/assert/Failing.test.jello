// expect: FAIL
// status: 1
// flags: --test --path $DIR
// A failure shows the values, an enum's by variant, and the test goes on.
import type { Test } from std.testing;
import std.testing as T;

enum Shape { Dot; Square; Circle(radius: I32); }


let testShowsValues = fn(t: Test) {
  T.equal(t, 1 + 1, 3);
  T.equal(t, 1i64 << 40, 0i64);
  T.equal(t, 2 > 3, true);
  T.equal(t, "a" + "b", "ba");
  let missing: ?I32 = null;
  let present: ?I32 = 4;
  T.equal(t, missing, 4);
  T.equal(t, present, null);
  T.equal(t, Shape.Dot, Shape.Square);
  let shape = Shape.Circle(1);
  let maybe: ?Shape = Shape.Square;
  T.equal(t, shape, Shape.Dot);
  T.equal(t, maybe, Shape.Dot);
  T.notEqual(t, "same", "same");
  T.equal(t, (1, "one"), (1, "uno"));
  T.equal(t, [Shape.Circle(2)], [Shape.Circle(3)]);
  null
};

let testChecks = fn(t: Test) {
  let present: ?Bytes = "here";
  T.isTrue(t, 1 > 2);
  T.isNull(t, present);
  let maybe: ?Shape = Shape.Circle(5);
  T.isNull(t, maybe);
  T.throws(t, fn() { null });
  null
};
