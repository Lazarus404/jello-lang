// expect:     $DIR/Failing.test.jello:33:3: got 1099511627776, want 0
// expect:     $DIR/Failing.test.jello:34:3: got false, want true
// expect:     $DIR/Failing.test.jello:35:3: got "ab", want "ba"
// expect:     $DIR/Failing.test.jello:38:3: got null, want 4
// expect:     $DIR/Failing.test.jello:39:3: got 4, want null
// expect:     $DIR/Failing.test.jello:40:3: got Shape.Dot, want Shape.Square
// expect:     $DIR/Failing.test.jello:43:3: got Shape.Circle(1), want Shape.Dot
// expect:     $DIR/Failing.test.jello:44:3: got Shape.Square, want Shape.Dot
// expect:     $DIR/Failing.test.jello:45:3: got "same", want any other value
// expect:     $DIR/Failing.test.jello:46:3: got (1, "one"), want (1, "uno")
// expect:     $DIR/Failing.test.jello:47:3: got [Shape.Circle(2)], want [Shape.Circle(3)]
// expect: === RUN   Failing/testChecks
