// trap: NULL_DEREF
// It would return 7 if a possibly-null read in or after a try were trusted
// unchecked.
// The handler must not learn what the body learned after its throw.
let keep = fn(_text: Bytes): I32 { 7 };
let fail = fn(): I32 { throw "stop"; 0 };
let run = fn(): I32 { let x: ?Bytes = null; try { fail(); x = "b"; 0 } catch { keep(x) } };
run()
