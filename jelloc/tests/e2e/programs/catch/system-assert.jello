// expect: assertion failed
// expect: assertEq failed: [1, 2] != [1, 3]
// expect: assertEq failed: "a" != "b": the names differ
// expect: passed
// A failing System assertion throws Bytes that start with the call's location, path:line:column;
// each argument is evaluated once, in order.
let afterLocation = fn(message: Dynamic): Bytes {
  let text = message as Bytes; let colons = 0; let i = 0;
  while (colons < 3) { if (Bytes.get_u8(text, i) == ":".code) { colons++; } i++; }
  Bytes.slice(text, i + 1, text.len() - i - 1)
};
let first = try { System.assert(1 > 2); "" } catch (e) { afterLocation(e) };
let second = try { System.assertEq([1, 2], [1, 3]); "" } catch (e) { afterLocation(e) };
let third = try { System.assertEq("a", "b", "the names differ"); "" } catch (e) { afterLocation(e) };
let calls = 0;
let next = fn(): I32 { calls++; calls };
System.assertEq(next(), 1);
System.assertEq(calls, 1);
first + "\n" + second + "\n" + third + "\npassed"
