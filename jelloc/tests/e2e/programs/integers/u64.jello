// expect: ok
// U64 arithmetic wraps to its width, and its comparisons, shifts and text follow its signedness.
let hi: U64 = 18446744073709551615;
let lo: U64 = 0;
let three: U64 = 3;
System.assertEq(Std.string(hi), "18446744073709551615");
System.assertEq(Std.string(lo), "0");
System.assertEq(Std.string(hi + three), "2");
System.assertEq(Std.string(lo - three), "18446744073709551613");
System.assertEq(Std.string(hi * three), "18446744073709551613");
System.assertEq(Std.string(hi << three), "18446744073709551608");
System.assertEq(Std.string(-hi), "1");
System.assertEq(Std.string(-lo), "0");
System.assertEq(Std.string(hi / three), "6148914691236517205");
System.assertEq(Std.string(hi % three), "0");
let top: U64 = 9223372036854775808;
System.assertEq(Std.string(top >> 0u64), "9223372036854775808");
System.assertEq(Std.string(top >> 1u64), "4611686018427387904");
System.assertEq(Std.string(top >> 63u64), "1");
System.assert(lo < hi);
System.assert(!(hi < lo));
System.assert(top != hi);
let n = hi;
n++;
System.assertEq(Std.string(n), "0");
n--;
System.assertEq(Std.string(n), "18446744073709551615");
n += three;
System.assertEq(Std.string(n), "2");
n *= three;
System.assertEq(Std.string(n), "6");
n <<= three;
System.assertEq(Std.string(n), "48");
let elements = [hi, lo];
elements[0] += three;
System.assertEq(Std.string(elements), "[2, 0]");
System.assertEq(Std.string(1000 as U64), "1000");
System.assertEq(Std.string(-1 as U64), "18446744073709551615");
System.assertEq(Std.string(hi as I32), "-1");
System.assertEq(Std.string(hi as I64), "-1");
System.assertEq(Std.string(lo as U64), "0");
"ok"
