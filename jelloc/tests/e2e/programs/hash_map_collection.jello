// expect: true true [{host: "127.0.0.1", port: 3478} => (7, "ok")]
import type { HashMap } from std.core.HashMap;

typedef Peer = { let host: Bytes; let port: I32; };

let map = new HashMap<I32, Bytes>();
map.set(1, "one");
map.set(2, "two");
map.set(3, "three");
map.remove(1);
let keys = map.keys();
let values = map.values();
let pairs = Array.new<Bytes>(0);
map.each(fn(key: I32, value: Bytes) { pairs.push(Std.string(key) + ":" + value); });

let copy = map.copy();
copy.set(2, "changed");
copy.set(4, "four");
let independent = (map.get(2) == "two") && !map.exists(4) && (copy.get(2) == "changed");
let peers = new HashMap<Peer, Tuple<I32, Bytes>>();
peers.set({ host: "127.0.0.1", port: 3478 }, (7, "ok"));
let peerText = Std.string(peers);
let empty = new HashMap<I32, Bytes>();

let traversed = (keys.len() == 2) && (values.len() == 2) && (pairs.len() == 2)
  && (keys.contains(2)) && (keys.contains(3)) && (values.contains("two")) && (values.contains("three"));
let shown = Std.string(map);
let formatted = (shown == "[3 => \"three\", 2 => \"two\"]") || (shown == "[2 => \"two\", 3 => \"three\"]");
System.assert(Std.string(empty) == "[]");
System.assert(formatted);
Std.string(traversed) + " " + Std.string(independent) + " " + peerText
