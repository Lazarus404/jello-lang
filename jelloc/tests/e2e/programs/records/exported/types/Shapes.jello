package types;

export typedef Ints = Array<I32>;
export typedef Many<T> = Array<T>;
export typedef Point = { let x: I32; let y: I32; };
export typedef Box<T> = { let value: T; };

// Traps if this module is ever initialized: a type-only import must not run it.
let none = Array.new<I32>(0);
export let boom = none[0];
