// expect: 42
// Function literals are values.
let apply = fn(f: (I32) -> I32, x: I32): I32 { f(x) };
let pick = fn(double: Bool): (I32) -> I32 {
  if (double) { fn(x: I32): I32 { x * 2 } } else { fn(x) { x + 1 } }
};
let current: (I32) -> I32 = pick(false);
current = pick(true);
apply(current, 20) + apply(pick(false), 1)
