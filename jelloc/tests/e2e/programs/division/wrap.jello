let digits = 0;
digits = digits * 10 + q(1, 1);
digits = digits * 10 + (q(-7, 2) == -3 ? 1 : 0);
digits = digits * 10 + (r(-7, 2) == -1 && q(7, -2) == -3 && r(7, -2) == 1 ? 1 : 0);
digits = digits * 10 + (q(min, -1) == min && r(min, -1) == 0 ? 1 : 0);
digits = digits * 10 + (min / -1 == min && min % -1 == 0 && min / 1 == min ? 1 : 0);
digits = digits * 10 + (qw(-seven, two) == -3 && rw(seven, -two) == 1 ? 1 : 0);
digits = digits * 10 + (qw(wideMin, minusOne) == wideMin && rw(wideMin, minusOne) == 0 && wideMin / -1 == wideMin ? 1 : 0);
