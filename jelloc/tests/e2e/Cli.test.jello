// jelloc's command line, as a developer meets it: what each kind of run
// prints where, and its exit status (0 success, 1 a program that does not
// compile, 2 a bad command line), run through support.Run. The fixtures
// only these checks need are in tests/e2e/cli.

import type { Test } from std.testing;
import std.testing as T;
import { contains, join, split, startsWith } from std.core.Bytes;
import { exists, makeDirs, readText, writeText } from std.io.File;
import { dirname } from std.io.Path;
import type { Command } from std.io.Command;
import { result } from std.io.Command;
import { replace } from std.core.RegExp;
import degust.Golden as G;
import { Json, jsonField, parseJson } from support.Json;
import { NONE, badCommandLines, concat, finish, fresh, has, jelloc, jellocIn, startJelloc, startVm, stdDir, withStd } from support.Run;
import { jloTool, vmCommand, vmEnv } from degust.Programs;

const _P = "tests/e2e/programs";
const _CLI = "tests/e2e/cli";

// What the compiler prints for ARGS, which must succeed.
let _dump = fn(t: Test, args: Array<Bytes>): Bytes {
  let (status, out, err) = jelloc(args, NONE);
  if (status != 0) { T.fail(t, "jelloc failed: " + err); }
  out
};

// ARGS, with ENV over the environment, is a program the compiler rejects:
// status 1, nothing on standard output, no module, and MESSAGE on standard
// error.
let _rejects = fn(t: Test, args: Array<Bytes>, env: Array<Bytes>, message: Bytes): Null {
  let module = fresh("rejected.jlo");
  let (status, out, err) = jelloc(concat(args, ["--out", module]), env);
  T.equal(t, (status, out, exists(module)), (1, "", false));
  has(t, err, message);
};

// Each of CASES, ARGS and MESSAGE, is a bad command line, with MESSAGE on
// standard error. They run at once.
let _usage = fn(t: Test, cases: Array<Tuple<Array<Bytes>, Bytes>>): Null {
  let started = Array.new<Tuple<Command, Array<Bytes>>>(0);
  let i = 0;

  while (i < cases.len()) {
    let (args, message) = cases[i];
    started.push((startJelloc(args, NONE), ["jelloc: " + message]));
    i++;
  }
  badCommandLines(t, started);
};

let testHelp = fn(t: Test) {
  let (status, out, err) = jelloc(["--help"], NONE);
  T.equal(t, (status, err), (0, ""));
  has(t, out, "usage: jelloc [input.jello]");
  has(t, out, "Exit status: 0 on success, 1 when the program does not compile");
};

/* jelloc --version and jello --version print the release's version, which the VM's build takes
 * from jello.json; any other argument makes a bad command line. */
let testPrintsTheVersion = fn(t: Test) {
  let (manifest, _, _) = parseJson(readText("jello.json"));

  let version = match (jsonField(manifest ?? Json.Null(0), "version")) {
    Text(_, value) => value,
    _ => "",
  };
  T.isTrue(t, version != "");
  T.equal(t, jelloc(["--version"], NONE), (0, "jelloc " + version, ""));
  T.equal(t, jelloc(["-v"], NONE), (0, "jelloc " + version, ""));
  T.equal(t, finish(startVm("", ["--version"])), (0, "jello " + version, ""));
  T.equal(t, finish(startVm("", ["-v"])), (0, "jello " + version, ""));
  _usage(t, [(["--version", "extra"], "unknown option: --version")]);
};

let testBadCommandLines = fn(t: Test) {
  let core = _P + "/core.jello";
  let zero = _P + "/division/zero.jello";
  _usage(t, [
    ([core, "--frobnicate"], "unknown option: --frobnicate"),
    // An unknown option is never taken for an input, wherever it is.
    (["--frobnicate", core, "--out", fresh("frobnicate.jlo")], "unknown option: --frobnicate"),
    ([core, "--hir", "--frobnicate"], "unknown option: --frobnicate"),
    ([core, "--hir", "other.jello"], "unexpected argument: other.jello"),
    ([core, "--hir", "--out", fresh("core-hir.jlo")], "--out cannot be combined with --lex, --parse, --hir or --ir"),
    ([core, "--spans"], "--spans requires --hir"),
    // A flag that takes a value needs a non-empty one.
    ([zero, "--path"], "--path requires a directory"),
    ([zero, "--path", ""], "--path requires a directory"),
    ([zero, "--std", ""], "--std requires a directory"),
    ([zero, "--out", ""], "--out requires a path")
  ]);
};

let testCompiles = fn(t: Test) {
  let module = fresh("core.jlo");
  let listed = fresh("listed.jlo");
  T.equal(t, jelloc([_P + "/no-such-file.jello", "--out", module], NONE),
    (1, "", "jelloc: cannot read " + _P + "/no-such-file.jello"));
  T.equal(t, jelloc([_P + "/core.jello", "--out", module], NONE), (0, "", ""));
  T.isTrue(t, exists(module));
  // --jlo with --out prints the listing and writes the module --out alone does.
  let (status, out, err) = jelloc([_P + "/core.jello", "--jlo", "--out", listed], NONE);
  T.equal(t, (status, err), (0, ""));
  has(t, out, "fn @");
  T.isTrue(t, readText(listed) == readText(module));
};

let testDumps = fn(t: Test) {
  let (status, tokens, _) = result(startJelloc(["tests/lex/tokens.jello", "--lex"], NONE));
  T.equal(t, status, 0);
  G.equal(t, "tests/lex/tokens.tok", tokens);
  // --hir --spans ends each node's line with its span
  // (tests/integration/compiler/dumps checks them).
  has(t, _dump(t, [_P + "/core.jello", "--hir", "--spans"]), "fn @1 count(%0 limit: i32 @28..38) -> i32 @25..119");
  // A parse error points at the token the parser stopped at.
  T.equal(t, jelloc(["itests/while/missing_while.jello", "--parse"], NONE), (1, "",
    "PARSER\titests/while/missing_while.jello:5:1: ParseError: expected 'while', found '\"ok\"' [E0100]\n\"ok\"\n^"));
  // Bytes escapes, \x reaching every byte, are one literal in the HIR and IR.
  let escapes = "bytes \"\\x00\\x7f\\x80\\xff\\x07\\x08\\x0c\\x0b\\x00\\xc3\\xa9A'\\\"\\\\\"";
  has(t, _dump(t, [_P + "/bytes/escapes.jello", "--hir"]), escapes);
  has(t, _dump(t, [_P + "/bytes/escapes.jello", "--ir"]), escapes);
};

/* A function of a type's extension module is one direct call however it is
 * named: as a method, through the type, or imported. A method name can load
 * the extension modules of other types that export it too, `map` both
 * std.core.Array's and std.core.List's, which numbers the functions apart but
 * leaves the code the same. */
let testCallsAnExtensionFunctionEachWay = fn(t: Test) {
  let dir = _CLI + "/extension";

  let ir = fn(name: Bytes): Bytes {
    replace(_dump(t, withStd([`${dir}/${name}.jello`, "--ir"])), ~r/@[0-9]+/, "@")
  };
  let called = ir("method");
  has(t, called, "= call @(");
  T.equal(t, ir("static"), called);
  T.equal(t, ir("imported"), called);
  let listed = ir("list_method");
  has(t, listed, "= call @(");
  T.equal(t, ir("list_static"), listed);
};

// A function with an annotated type compiles as the same function unannotated.
let testCompilesAnAnnotatedFunctionDirectly = fn(t: Test) {
  let ir = fn(name: Bytes): Bytes { _dump(t, [`${_CLI}/annotated/${name}.jello`, "--ir"]) };
  let annotated = ir("annotated");
  has(t, annotated, "= call @");
  T.equal(t, annotated, ir("plain"));
};

// A `const` of a constant costs no global read: `LIMIT`, global g0, reads as 10.
let testFoldsConstants = fn(t: Test) {
  let ir = _dump(t, [`${_CLI}/const/fold.jello`, "--ir"]);
  has(t, ir, "= i32 10");
  T.equal(t, contains(ir, "global.get g0"), false);
};

// A literal passed to `map` is called directly by a copy of `map` made for it, and inlined
// there: the one indirect call left is the original `map`'s, which nothing calls now.
let testCallsAPassedLiteralDirectly = fn(t: Test) {
  let listing = _dump(t, withStd([`${_CLI}/specialise/map.jello`, "--jlo"]));
  T.equal(t, split(listing, "call %").len(), 2);
  T.equal(t, split(listing, "mul.wrap.i32").len(), 3);
};

// Literals bound before a branch reach the calls in its arms, so each arm's copy multiplies
// inline: two multiplications in the literals and two more in the copies.
let testCallsALiteralBoundBeforeABranchDirectly = fn(t: Test) {
  let listing = _dump(t, withStd([`${_CLI}/specialise/branches.jello`, "--jlo"]));
  T.equal(t, split(listing, "mul.wrap.i32").len(), 5);
};

// A `for` costs what the hand-written loop does: its counter steps in place, with no copy,
// and a `_` item is never read. The only moves are the entry's, before the calls.
let testLoopsOverAnArrayWithoutCopies = fn(t: Test) {
  let listing = _dump(t, [`${_CLI}/loops/for.jello`, "--jlo"]);
  let loops = split(listing, "fn @0(")[0];
  T.equal(t, contains(loops, "move"), false);
  T.equal(t, split(loops, "array.get").len(), 2);
};

// A linked prototype's method is called directly, so it inlines; only the field is looked up.
let testCallsALinkedMethodDirectly = fn(t: Test) {
  let listing = _dump(t, [`${_CLI}/prototypes/linked.jello`, "--jlo"]);
  let step = split(split(listing, "fn @1(")[1], "fn @2(")[0];
  T.equal(t, contains(step, "call"), false);
  T.equal(t, split(step, "object.get").len(), 2);
};

// An extension module may not export a name its type's intrinsics have; the
// error is in the module, which loads once a method call needs it.
let testRejectsAnExportAnIntrinsicHides = fn(t: Test) {
  let dir = _CLI + "/extension/clash";
  _rejects(t, [dir + "/main.jello", "--std", dir + "/std"], NONE,
    dir + "/std/core/Array.jello:4:1: Array.len is intrinsic, so std.core.Array cannot export len");
};

// Every dump stops at a lex error with the diagnostic a compile gives.
let testDumpsStopAtALexError = fn(t: Test) {
  let source = _P + "/bytes/bad_hex.jello";
  let flags = ["--lex", "--hir", "--ir", "--jlo"];
  let dumps = Array.new<Command>(0);
  let i = 0;

  while (i < flags.len()) {
    dumps.push(startJelloc([source, flags[i]], NONE));
    i++;
  }
  let (_, _, error) = jelloc([source, "--out", fresh("bad_hex.jlo")], NONE);
  has(t, error, "invalid hex escape");
  i = 0;

  while (i < flags.len()) {
    T.equal(t, finish(dumps[i]), (1, "", error));
    i++;
  }
  // --parse labels it with its phase.
  T.equal(t, jelloc([source, "--parse"], NONE), (1, "", "LEXER\t" + error));
};

// A value try whose body gives null and whose catch a value, with no type
// expected, joins to a nullable, each block converting its own tail. It is
// written here rather than as a fixture because the committed seed fails on it.
let testJoinsATryToANullable = fn(t: Test) {
  let source = fresh("nullable_try.jello");
  writeText(source, "let fail = fn(): I32 { throw \"stop\"; 0 };\n"
    + "let pick = fn(n: I32): I32 { let v = try { if (n > 0) { fail(); } null } catch { 7 }; v != null ? v : 10 };\n"
    + "pick(1) + pick(0)\n");
  let (status, _, err) = jelloc([source, "--out", fresh("nullable_try.jlo")], NONE);
  T.equal(t, (status, err), (0, ""));
};

// Fixtures whose error lines list every diagnostic of their run: each run reports
// those and nothing after them, such as a consequence of an earlier error.
let testReportsOnlyIndependentErrors = fn(t: Test) {
  let dir = _P + "/diagnostics";
  let names = ["several_errors", "notes", "syntax_errors", "missing_brace", "unclosed_block", "unclosed_nested", "same_statement", "instance_notes"];
  let n = 0;

  while (n < names.len()) {
    let source = dir + "/" + names[n] + ".jello";
    let lines = split(readText(source), "\n");
    let want = Array.new<Bytes>(0);
    let i = 0;

    while ((i < lines.len()) && startsWith(lines[i], "// error: ")) {
      let line = join(split(Bytes.slice(lines[i], 10, Bytes.len(lines[i]) - 10), "$DIR"), dir);
      want.push(i == 0 ? source + ":" + line : line);
      i++;
    }
    T.equal(t, jelloc([source, "--hir"], NONE), (1, "", join(want, "\n")));
    n++;
  }
};

// A run reports at most 20 errors, each with its source line, and says so when
// it stops there.
let testStopsAfterTwentyErrors = fn(t: Test) {
  let source = _CLI + "/errors/TooMany.jello";
  let want = "";
  let i = 0;

  while (i < 20) {
    let name = "v" + Std.string(i);
    let line = "let " + name + ": I32 = \"s\";";
    let caret = "^";
    while (Bytes.len(caret) < Bytes.len(line) - 3) { caret = " " + caret; }
    want = want + source + ":" + Std.string(i + 2) + ":" + Std.string(Bytes.len(caret)) + ": " + name + " is annotated I32, but its value is Bytes [E0400]\n"
      + line + "\n" + caret + "\n";
    i++;
  }
  T.equal(t, jelloc([source, "--hir"], NONE), (1, "", want + "stopped after 20 errors"));
};

// A warning goes to standard error, with its source line, and the program
// still compiles.
let testWarns = fn(t: Test) {
  let source = _CLI + "/with_cannot_fail.jello";
  let module = fresh("warned.jlo");
  let line = "let f = fn(v: I32): I32 { with x <- v, y <- x { y } };";
  let (status, out, err) = jelloc([source, "--out", module], NONE);
  T.equal(t, (status, out, exists(module)), (0, "", true));
  T.equal(t, err, source + ":2:32: warning: this clause cannot fail: use `let`\n" + line + "\n" + "                               ^\n"
    + source + ":2:40: warning: this clause cannot fail: use `let`\n" + line + "\n" + "                                       ^");
};

// What the compiler emits, where a program's output cannot show it.
// Without --std or JELLO_STD_PATH, a standard module is not found.
let testNeedsStd = fn(t: Test) {
  _rejects(t, [_CLI + "/needs_std.jello"], ["JELLO_STD_PATH"],
    "needs_std.jello:1:1: module std.core.Bytes is in the standard library; pass its directory with --std <dir> or set JELLO_STD_PATH");
};

// Test binaries, as tests/e2e/programs/testing runs them. The generated entry
// is a program like any other: --hir shows it. Without --std, jelloc reads
// JELLO_STD_PATH and writes the same program.
let testTestBinaries = fn(t: Test) {
  let pass = _P + "/testing/pass";
  let strings = pass + "/Strings.test.jello";
  let hir = _dump(t, withStd(["--test", "--path", pass, strings, "--hir"]));
  T.equal(t, jelloc(["--test", "--path", pass, strings, "--hir"], ["JELLO_STD_PATH=" + stdDir()]), (0, hir, ""));
  // A root is matched by the path it resolves to, however it is written.
  T.equal(t, _dump(t, withStd(["--test", "--path", "./" + pass + "/", strings, "--hir"])), hir);
  has(t, hir, "            bytes \"Strings/testJoins\": bytes\n            bytes \"" + strings + ":15\": bytes");
  _rejects(t, withStd(["--test", "--path", _CLI + "/errors", "--path", pass + "/auxiliary", _CLI + "/errors/frontend/Other.test.jello"]), NONE,
    "Other.test.jello:4:1: unknown export _step in " + pass + "/auxiliary/frontend/Counter.jello");
  _rejects(t, [_CLI + "/errors/Misnamed.jello", "--test"], NONE, "a test file's name ends in .test.jello: " + _CLI + "/errors/Misnamed.jello");
  let hook = _P + "/testing/errors/Hook.test.jello";
  _rejects(t, [hook, "--test", "--path", pass], NONE, "test file " + hook + " is under no --path root");
  _usage(t, [(["--test", "--path", pass], "no test file"),
    (["--test", strings, "--lex"], "--test cannot be combined with --lex or --parse")]);
};

// A project under --out, called NAME, of FILES, each a path in it and its
// text, with jello.json first.
let _project = fn(name: Bytes, files: Array<Tuple<Bytes, Bytes>>): Bytes {
  let dir = fresh(name);
  let i = 0;

  while (i < files.len()) {
    let (path, text) = files[i];
    makeDirs(dirname(dir + "/" + path));
    writeText(dir + "/" + path, text);
    i++;
  }
  dir
};

// An app whose program imports its own module and a package that a
// package_paths directory holds, whose own dev_dependencies are not looked
// for, with a test of its module.
let _APP = [
  ("jello.json", "{ \"name\": \"app\", \"version\": \"0.1.0\", \"license\": \"MIT\",\n  \"dependencies\": { \"greet\": \"0.1.0\" }, \"package_paths\": [\"libs\"] }\n"),
  ("src/Main.jello", "import { twice } from demo.Util;\nimport { hello } from greet.Hello;\nhello(Std.string(twice(System.args.len())) + \" \" + List.head(System.args))\n"),
  ("src/demo/Util.jello", "package demo;\nexport let twice = fn(x: I32): I32 { x * 2 };\n"),
  ("libs/greet/jello.json", "{ \"name\": \"greet\", \"version\": \"0.1.0\", \"src\": \"lib\", \"dev_dependencies\": { \"nope\": \"1.0.0\" } }\n"),
  ("libs/greet/lib/greet/Hello.jello", "package greet;\nexport let hello = fn(who: Bytes): Bytes { \"hello \" + who };\n"),
  ("tests/demo/Util.test.jello", "package demo;\nimport type { Test } from std.testing;\nimport std.testing as T;\nimport { twice } from demo.Util;\n"
    + "let testTwice = fn(t: Test) { T.equal(t, twice(2), 4); };\nlet testFails = fn(t: Test) { T.equal(t, twice(1), 3); };\n")
];

// The environment run and test find the VM under test in.
let _withVm = fn(): Array<Bytes> { concat(vmEnv(), ["JELLO_VM=" + vmCommand("", NONE)[0], "JELLO_STD_PATH=" + stdDir()]) };

// jelloc run compiles a program against its project's sources and packages,
// with no --path, into the project's build/run/, and runs it with the
// arguments after the file, as they are; it exits as the program does.
let testRunsAProgramInItsProject = fn(t: Test) {
  let dir = _project("app", _APP);
  T.equal(t, jelloc(["run", dir + "/src/Main.jello", "--out", "-x"], _withVm()), (0, "hello 4 --out", ""));
  T.isTrue(t, exists(dir + "/build/run/Main.jlo"));
  // Outside a project, the file is its own source root.
  let lone = _project("lone", [("lone.jello", "System.exit(3); 0\n")]);
  T.equal(t, jelloc(["run", lone + "/lone.jello"], _withVm()), (3, "", ""));
  let broken = _project("broken", [("broken.jello", "let x: I32 = \"s\";\n")]);
  let (status, out, err) = jelloc(["run", broken + "/broken.jello"], _withVm());
  T.equal(t, (status, out), (1, ""));
  has(t, err, "broken.jello:1:14: x is annotated I32, but its value is Bytes");
};

/* A compile that names no input compiles jello.json's "entry", or else
 * src/Main.jello, with the project's sources, as run does; one that names no
 * --out writes build/<name>.jlo, named by jello.json's "name", or else the
 * directory's, a space or / in it made a -. Both are found in the project at or
 * above the current directory, or else in the current directory. */
let testAssumesTheEntryAndTheModule = fn(t: Test) {
  let ran = fn(module: Bytes): Tuple<I32, Bytes, Bytes> { finish(startVm("", [module])) };
  let lone = _project("my app", [("src/Main.jello", "\"alone\"\n")]);
  T.equal(t, jellocIn(lone, NONE, NONE), (0, "", ""));
  T.equal(t, ran(lone + "/build/my-app.jlo"), (0, "alone", ""));
  let app = _project("assumed", [
    ("jello.json", "{ \"name\": \"my/app\", \"entry\": \"bin/start.jello\" }\n"),
    ("bin/start.jello", "import { twice } from demo.Util;\nStd.string(twice(21))\n"),
    ("bin/other.jello", "\"other\"\n"),
    ("src/demo/Util.jello", "package demo;\nexport let twice = fn(x: I32): I32 { x * 2 };\n")]);
  T.equal(t, jellocIn(app + "/src/demo", NONE, NONE), (0, "", ""));
  T.equal(t, ran(app + "/build/my-app.jlo"), (0, "42", ""));
  T.equal(t, jellocIn(app, ["run"], _withVm()), (0, "42", ""));
  // A named input is compiled on its own, into the module the project names.
  T.equal(t, jellocIn(app, ["bin/other.jello"], NONE), (0, "", ""));
  T.equal(t, ran(app + "/build/my-app.jlo"), (0, "other", ""));
  // A listing writes no module.
  has(t, jellocIn(lone, ["--jlo"], NONE).1, "fn @");
  let badEntry = _project("bad-entry", [("jello.json", "{ \"entry\": 3 }\n")]);
  T.equal(t, jellocIn(badEntry, ["src/Main.jello"], NONE),
    (1, "", "jello.json:1:12: \"entry\" must be a string [E0211]\n{ \"entry\": 3 }\n           ^"));
  let none = _project("none", [("README", "")]);
  let (status, out, err) = jellocIn(none, NONE, NONE);
  T.equal(t, (status, out), (2, ""));
  has(t, err, "jelloc: no input file, and no src/Main.jello to compile");
  has(t, jellocIn(none, ["run"], _withVm()).2, "jelloc: no input file, and no src/Main.jello to compile");
};

/* An uncaught throw shows the thrown value: a number as itself, and a value
 * the VM keeps no type for by its kind, the same on every run. */
let testShowsAThrownValue = fn(t: Test) {
  let shown = fn(name: Bytes, source: Bytes): Bytes {
    let dir = _project(name, [(name + ".jello", source)]);
    let (status, out, err) = jelloc(["run", dir + "/" + name + ".jello"], _withVm());
    T.equal(t, (status, out), (1, ""));
    let lines = split(err, "\n");
    lines.len() > 1 ? lines[1] : err
  };
  T.equal(t, shown("enum", "enum P { A; }\nthrow P.A;\n"), "jello: thrown: <enum value>");
  T.equal(t, shown("tuple", "throw (1, 2);\n"), "jello: thrown: <tuple or record>");
  T.equal(t, shown("wide", "let n: I64 = 5000000000;\nthrow n;\n"), "jello: thrown: 5000000000");
};

// jelloc test builds one test binary of every test file under the project's
// test directories, and runs it with the arguments after --.
let testRunsAProjectsTests = fn(t: Test) {
  let dir = _project("app", _APP);
  // A directory named with a trailing slash, as a shell completes it, names the same modules.
  let (status, out, _) = jelloc(["test", dir + "/tests/", "--", "--run", "demo/Util/testTwice"], _withVm());
  T.equal(t, (status, out), (0, "=== RUN   demo/Util/testTwice\nok"));
  let (failed, failedOut, failedErr) = jelloc(["test", dir + "/tests"], _withVm());
  T.equal(t, failed, 1);
  has(t, failedOut + failedErr, "got 2, want 3");
  T.isTrue(t, exists(dir + "/build/test.jlo"));
};

// The packages of dev_dependencies are roots for the project's tests, but not
// for its program.
let testKeepsDevDependenciesForTests = fn(t: Test) {
  let dir = _project("dev-app", [
    ("jello.json", "{ \"name\": \"app\", \"dev_dependencies\": { \"tool\": \"0.1.0\" }, \"package_paths\": [\"libs\"] }\n"),
    ("libs/tool/src/tool/Check.jello", "package tool;\nexport let check = fn(): Bytes { \"checked\" };\n"),
    ("src/Main.jello", "import { check } from tool.Check;\ncheck()\n"),
    ("tests/app/Check.test.jello", "package app;\nimport type { Test } from std.testing;\nimport std.testing as T;\nimport { check } from tool.Check;\n"
      + "let testCheck = fn(t: Test) { T.equal(t, check(), \"checked\"); };\n")]);
  T.equal(t, jelloc(["test", dir + "/tests"], _withVm()), (0, "=== RUN   app/Check/testCheck\nok", ""));
  let (status, _, err) = jelloc(["run", dir + "/src/Main.jello"], _withVm());
  T.equal(t, status, 1);
  has(t, err, "module tool.Check not found");
};

// run and test pass jello the native library directories of the project
// and its packages that exist: each one's jdll/, or the one its "jdll" names.
let testPassesTheNativeLibraryDirectories = fn(t: Test) {
  let dir = _project("native-app", _APP);
  makeDirs(dir + "/jdll");
  makeDirs(dir + "/libs/greet/native");
  writeText(dir + "/libs/greet/jello.json", "{ \"src\": \"lib\", \"jdll\": \"native\" }\n");
  let echo = concat(_withVm(), ["JELLO_VM=/bin/echo"]);
  let search = "--jdll-path " + dir + "/jdll:" + dir + "/libs/greet/native ";
  T.equal(t, jelloc(["run", dir + "/src/Main.jello", "x"], echo), (0, search + dir + "/build/run/Main.jlo x", ""));
  T.equal(t, jelloc(["test", dir + "/tests", "--", "-v"], echo), (0, search + dir + "/build/test.jlo -v", ""));
  let plain = _project("plain-app", _APP);
  T.equal(t, jelloc(["run", plain + "/src/Main.jello"], echo), (0, plain + "/build/run/Main.jlo", ""));
  // Outside a project, the libraries beside the file, in jdll/ and then with it.
  let loose = _project("loose-file", [("main.jello", "0\n")]);
  let (status, out, err) = jelloc(["run", loose + "/main.jello"], echo);
  T.equal(t, (status, Bytes.slice(out, 0, 12), err), (0, "--jdll-path ", ""));
  has(t, out, " " + loose + " ");
  makeDirs(loose + "/jdll");
  let (_, withJdll, _) = jelloc(["run", loose + "/main.jello"], echo);
  has(t, withJdll, "--jdll-path " + loose + "/jdll:" + loose + " ");
};

// A manifest's errors point into it.
let testRejectsABadManifest = fn(t: Test) {
  let bad = _project("bad-manifest", [("jello.json", "{ \"name\": \"app\",\n  \"src\": [\"src\"] }\n"), ("main.jello", "0\n")]);
  T.equal(t, jelloc(["run", bad + "/main.jello"], _withVm()),
    (1, "", bad + "/jello.json:2:10: \"src\" must be a string [E0211]\n  \"src\": [\"src\"] }\n         ^"));
  let missing = _project("missing-package", [("jello.json", "{ \"dependencies\": { \"nope\": \"1.0.0\" } }\n"), ("main.jello", "0\n")]);
  let (status, _, err) = jelloc(["run", missing + "/main.jello"], _withVm());
  T.equal(t, status, 1);
  has(t, err, missing + "/jello.json:1:29: package nope is in none of " + missing + "/packages; run `jelloc deps.get`");
  let invalid = _project("invalid-manifest", [("jello.json", "{ \"name\" }\n"), ("main.jello", "0\n")]);
  let (invalidStatus, _, invalidErr) = jelloc(["test", invalid], _withVm());
  T.equal(t, invalidStatus, 1);
  has(t, invalidErr, invalid + "/jello.json:1:10: invalid JSON: expected : after key");
};

// jelloc deps.get fetches with jlo_tool; a path dependency is linked under
// packages/, where run then finds it.
let testGetsDependencies = fn(t: Test) {
  let lib = _project("deps-lib", [("jello.json", "{ \"name\": \"lib\", \"version\": \"0.1.0\" }\n"), ("src/lib/Name.jello", "package lib;\nexport let NAME = \"lib\";\n")]);
  let app = _project("deps-app", [("jello.json", "{ \"name\": \"app\", \"version\": \"0.1.0\", \"dependencies\": { \"lib\": { \"path\": \"" + lib + "\" } } }\n"),
    ("src/Main.jello", "import { NAME } from lib.Name;\nNAME\n")]);
  let env = concat(_withVm(), ["JELLO_JLO_TOOL=" + jloTool()]);
  let (status, _, _) = jelloc(["deps.get", app], env);
  T.equal(t, status, 0);
  T.equal(t, jelloc(["run", app + "/src/Main.jello"], env), (0, "lib", ""));
};

let testBadSubcommandLines = fn(t: Test) {
  _usage(t, [
    (["run", "--frobnicate", "x.jello"], "unknown option: --frobnicate"),
    (["run", "--path"], "--path requires a directory"),
    (["run", _P + "/testing"], "run takes a .jello file, not " + _P + "/testing"),
    (["deps.get", "a", "b"], "unexpected argument: b"),
    (["deps.get", "--frobnicate"], "unknown option: --frobnicate")
  ]);
};

// --explain prints what an error code means; any other argument is a bad command line.
let testExplainsAnErrorCode = fn(t: Test) {
  let (status, out, err) = jelloc(["--explain", "E0302"], NONE);
  T.equal(t, (status, err), (0, ""));
  T.isTrue(t, startsWith(out, "E0302: a duplicate declaration\n\n"));
  _usage(t, [
    (["--explain"], "--explain takes one error code, as E0302"),
    (["--explain", "E9999"], "unknown error code: E9999"),
    (["--explain", "E0302", "E0303"], "--explain takes one error code, as E0302")
  ]);
};

// fmt lays out a file in place; --check lists it while it would change, and
// changes nothing.
let testFmt = fn(t: Test) {
  let file = fresh("fmt.jello");
  writeText(file, "let a = 1; let b = 2;   \nif (a == b)\n{\n      a\n}\n");
  T.equal(t, jelloc(["fmt", "--check", file], NONE), (1, file, ""));
  T.equal(t, readText(file), "let a = 1; let b = 2;   \nif (a == b)\n{\n      a\n}\n");
  T.equal(t, jelloc(["fmt", file], NONE), (0, "", ""));
  T.equal(t, readText(file), "let a = 1;\nlet b = 2;\n\nif (a == b) {\n  a\n}\n");
  T.equal(t, jelloc(["fmt", "--check", file], NONE), (0, "", ""));
  T.equal(t, jelloc(["fmt", fresh("no-such-file.jello")], NONE),
    (1, "", "jelloc: cannot read " + fresh("no-such-file.jello")));
  _usage(t, [(["fmt", "--frobnicate"], "unknown option: --frobnicate")]);
};
