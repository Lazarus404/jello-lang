package support;

// Running the compiler under test and the VM as child commands, for the e2e tests
// that check their command lines. What runs is the test package's options,
// which scripts/test.sh passes; this is the one module that reads them.

import type { Test } from std.testing;
import std.testing as T;
import { contains } from std.core.Bytes;
import { makeDirs, remove } from std.io.File;
import type { Command } from std.io.Command;
import { result, start } from std.io.Command;
import { checkCommand, checkEnv, compiler, jloTool, modes as _modes, outDir, stdDir as _stdDir, vmCommand, vmEnv } from degust.Programs;

T.declareOption("--self", "what the compiler under test builds from its own sources, when known (at the fixed point, the compiler itself)");

// The module the compiler under test builds from its own sources (--self),
// or "" when the tests must build it.
export let selfModule = fn(): Bytes { T.option("--self", "") };

// The standard library's directory, and the VM's modes.
export let stdDir: () -> Bytes = _stdDir;
export let modes: () -> Array<Bytes> = _modes;

// TEXT less its trailing newlines, as a shell's $(...) gives output.
let _chomp = fn(text: Bytes): Bytes {
  let n = Bytes.len(text);
  while ((n > 0) && (Bytes.get_u8(text, n - 1) == 10)) { n--; }
  Bytes.slice(text, 0, n)
};

export let concat = fn(a: Array<Bytes>, b: Array<Bytes>): Array<Bytes> {
  let all = Array.new<Bytes>(0);
  let i = 0;

  while (i < a.len()) {
    all.push(a[i]);
    i++;
  }
  i = 0;

  while (i < b.len()) {
    all.push(b[i]);
    i++;
  }
  all
};

export const NONE = Array.new<Bytes>(0);

// The path of module NAME, in a directory of its own under --out, and not
// there yet.
export let fresh = fn(name: Bytes): Bytes {
  let dir = outDir() + "/e2e";
  makeDirs(dir);
  remove(dir + "/" + name);
  dir + "/" + name
};

// ARGS with the standard library's directory.
export let withStd = fn(args: Array<Bytes>): Array<Bytes> { concat(args, ["--std", _stdDir()]) };

// The command that runs the compiler under test with ARGS.
let _jellocCommand = fn(args: Array<Bytes>): Array<Bytes> {
  let argv = compiler();
  if (argv.len() == 0) { throw "the e2e tests need -- --compiler CMD"; }
  concat(argv, args)
};

// Starts the compiler under test with ARGS, and ENV over the environment.
export let startJelloc = fn(args: Array<Bytes>, env: Array<Bytes>): Command { start(_jellocCommand(args), env) };

// Waits for COMMAND: its status, standard output and standard error, less
// trailing newlines.
export let finish = fn(command: Command): Tuple<I32, Bytes, Bytes> {
  let (status, out, err) = result(command);
  (status, _chomp(out), _chomp(err))
};

// The compiler under test given ARGS, with ENV over the environment, run to
// the end.
export let jelloc = fn(args: Array<Bytes>, env: Array<Bytes>): Tuple<I32, Bytes, Bytes> { finish(startJelloc(args, env)) };

/* The compiler under test given ARGS in the directory DIR, with ENV over the
 * environment and the standard library's directory, made absolute first, as
 * JELLO_STD_PATH, run to the end. A directory the shell cannot enter is
 * status 125, which jelloc never exits with. */
export let jellocIn = fn(dir: Bytes, args: Array<Bytes>, env: Array<Bytes>): Tuple<I32, Bytes, Bytes> {
  if (_stdDir() == "") { throw "the e2e tests need -- --std DIR"; }
  let enter = "std=$(cd \"$2\" && pwd) && cd \"$1\" || exit 125; shift 2; JELLO_STD_PATH=$std exec \"$@\"";
  finish(start(concat(["sh", "-c", enter, "sh", dir, _stdDir()], _jellocCommand(args)), env))
};

// Starts the VM in MODE ("" for the default) on ARGS, which start with the
// module, as the fixtures run.
export let startVm = fn(mode: Bytes, args: Array<Bytes>): Command { start(vmCommand(mode, args), vmEnv()) };

// Starts the check after each compile on DUMP, the compiler's --jlo output,
// and MODULE, as degust.Programs runs it.
export let startCheck = fn(dump: Bytes, module: Bytes): Command { start(checkCommand(dump, module), checkEnv()) };

// Starts jlo_tool, beside the VM, with ARGS.
export let startJloTool = fn(args: Array<Bytes>): Command { start(concat([jloTool()], args), vmEnv()) };

// Fails T unless TEXT contains PART.
export let has = fn(t: Test, text: Bytes, part: Bytes): Null {
  if (!contains(text, part)) { T.fail(t, "want " + Std.string(part) + " in " + Std.string(text)); }
  null
};

// Each of CASES, a started command and what its standard error contains, is
// a bad command line: status 2 and nothing on standard output. Start them
// all before calling this, so they run at once.
export let badCommandLines = fn(t: Test, cases: Array<Tuple<Command, Array<Bytes>>>): Null {
  let i = 0;

  while (i < cases.len()) {
    let (command, parts) = cases[i];
    let (status, out, err) = finish(command);
    T.equal(t, (status, out), (2, ""));
    let k = 0;

    while (k < parts.len()) {
      has(t, err, parts[k]);
      k++;
    }
    i++;
  }
};
