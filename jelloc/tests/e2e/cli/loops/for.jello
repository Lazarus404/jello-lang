// Sums of each item weighted by its position, and of the positions alone: 14 + 3.
let weighted = fn(xs: Array<I32>): I32 {
  let total = 0;
  for (i, x in xs) { total = total + i * x; }
  total
};

let positions = fn(xs: Array<I32>): I32 {
  let total = 0;
  for (i, _ in xs) { total = total + i; }
  total
};

let xs = [3, 4, 5];
weighted(xs) + positions(xs)
