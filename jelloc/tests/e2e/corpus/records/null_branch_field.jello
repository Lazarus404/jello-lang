// expect: ok
import { append } from std.core.List;

let at: (List<Dynamic>, I32) -> Dynamic = fn(list, idx) {
  let cur = list;
  let i = 0;
  while (List.is_nil(cur) == false) {
    if (i == idx) {
      return List.head(cur);
    }
    i = i + 1;
    cur = List.tail(cur);
  }
  null
};

let readTileBroken: (List<Dynamic>, I32) -> I32 = fn(list, idx) {
  let cell = at(list, idx);
  if (cell == null) {
    -1
  } else {
    (cell as Object).tile as I32
  }
};

let makeGrid: () -> List<Dynamic> = fn() {
  append(List.nil<Dynamic>(), { tile: -1 } as Dynamic)
};

System.assert(readTileBroken(makeGrid(), 0) == -1);
"ok"
