// expect: ok
let thrownSlot = { ok: false };
let _: ?I32 = try { throw 99; null } catch (e) {
  thrownSlot.ok = (e as I32) == 99;
  null
};
System.assert(thrownSlot.ok == true);

let wildThrow: Dynamic = try { throw 1; "bad" as Dynamic } catch (e) { "ok" as Dynamic };
System.assert((wildThrow as Bytes) == "ok");

let bareThrow: Dynamic = try { throw 2; "bad" as Dynamic } catch { "ok" as Dynamic };
System.assert((bareThrow as Bytes) == "ok");

"ok"
