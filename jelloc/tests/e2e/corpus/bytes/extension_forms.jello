// expect: ["a", "b"] true true 2 x-y
// A function of std.core.Bytes is called on the bytes or through the type.
let parts = "a,b".split(",");
let line: Bytes = "hello";
Std.string(parts) + " " + Std.string(line.startsWith("he")) + " " + Std.string(Bytes.contains(line, "ll")) + " " + Std.string(line.indexOf("l")) + " " + Bytes.join(["x", "y"], "-")
