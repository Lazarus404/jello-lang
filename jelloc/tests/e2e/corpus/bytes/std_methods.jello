// expect: ok
let b = "hello";
System.assert(b.len() == 5);
System.assert(b.get(0) == 104);
System.assert(b.startsWith("he"));
System.assert(b.endsWith("lo"));
System.assert(b.contains("ell"));
System.assert(b.indexOf("ll") == 2);
System.assert(b.indexOf("zzz") == -1);
System.assert(b.indexOfFrom("l", 2) == 2);
System.assert(b.lastIndexOf("l") == 3);
let c = b.slice(1, 3);
System.assert(c.eq("ell"));
System.assert(b.concat(", world").indexOf(",") == 5);
System.assert(b.isEmpty() == false);
let d = b.copy();
System.assert(d.toString().eq(b));
d.set(0, 72);
System.assert(!d.toString().eq(b));
let buf = Bytes.new(2);
buf.set(0, 97);
buf.set(1, 98);
System.assert(buf.toString().eq("ab"));
let padded = "  hi  ";
System.assert(padded.trim().eq("hi"));
System.assert("hello".substring(1, 4).eq("ell"));
System.assert("a-b-c".replace("-", "+").eq("a+b-c"));
System.assert("a-b-c".replaceAll("-", "+").eq("a+b+c"));
let parts = "a,b,c".split(",");
System.assert(parts.len() == 3);
System.assert(parts[0].eq("a"));
System.assert(parts[1].eq("b"));
System.assert(parts[2].eq("c"));
System.assert(parts.join("+").eq("a+b+c"));
"ok"
