// expect: ok
enum Tag { A; B(x: I32); C(a: I8, b: I8); }

let pairSum = fn(lst: List<I32>): I32 {
  match (lst) {
    [a, b] => a + b,
    _ => 0,
  }
};
System.assert(pairSum(list[10, 32]) == 42);

let arrSum = fn(arr: Array<I32>) {
  match (arr) {
    [a, b] => a + b,
    _ => 0,
  }
};
System.assert(arrSum([10, 32]) == 42);

let addPair = fn(pair: Tuple<I32, I32>) {
  match (pair) {
    (a, b) => a + b,
  }
};
System.assert(addPair((10, 32)) == 42);

let tag = fn(val: Tag) {
  match (val) {
    A => { 0 },
    B(x) => { x },
    C(a, b) => { (a + b) as I32 },
  }
};
System.assert(tag(Tag.B(9)) == 9);
System.assert(tag(Tag.C(3i8, 4i8)) == 7);

let fromCode = fn(x: I32) {
  match (x) {
    "#".code => 1,
    _ => 0,
  }
};
System.assert(fromCode("#".code) == 1);

"ok"
