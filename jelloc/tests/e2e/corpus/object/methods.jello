// expect: ok
let o = {};
let ka = Atom.intern("a");
let kb = Atom.intern("b");
o.set(ka, 1);
o.set(kb, 2);
let va: I32 = o.get<I32>(ka);
System.assert(o.exists(ka));
System.assert(o.isEmpty() == false);
System.assert(o.len() == 2);
System.assert(va == 1);

let o2 = o.copy();
System.assert(o2.exists(kb));
System.assert(o2.len() == 2);

let other = {};
other.set(ka, 10);
other.set(kb, 20);
o.merge(other);
System.assert(o.get<I32>(ka) == 10);
System.assert(o.len() == 2);
let vb: I32 = o2.get<I32>(kb);
System.assert(vb == 2);

o.set(kb, 99);
System.assert(o.get<I32>(kb) == 99);
System.assert(o.remove(ka));
System.assert(o.exists(ka) == false);
System.assert(o.len() == 1);

o.clear();
System.assert(o.isEmpty());
System.assert(o.len() == 0);
o.set(ka, "x");
System.assert(Bytes.len(o.toString()) > 2);

let add: (Object, I32) -> I32 = fn(self, y) {
  let x = self.x as I32;
  return x + y;
};
let mobj = { x: 4, add: add };
System.assert(mobj.add(3) == 7);

let f: (Object) -> I32 = fn(o) { return o.a as I32; };
System.assert(f({ a: 7 }) == 7);

prototype P {
  init(n: I32) { this.n = n; };
  get(): I32 { this.n as I32 };
};
let po: P = new P(7);
System.assert(po.get() == 7);
"ok"
