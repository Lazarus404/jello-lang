// expect: ok
import { trim } from std.core.Bytes;

let _stripHeadingMark: (Bytes) -> Bytes = fn(text: Bytes) {
  let t = trim(text);
  if (Bytes.len(t) > 0 && Bytes.get(t, 0) == 35) {
    trim(Bytes.slice(t, 1, Bytes.len(t) - 1))
  } else {
    t
  }
};

export let titleFromFirstLineBytes: (Bytes) -> Bytes = fn(text: Bytes) {
  let n = Bytes.len(text);
  let i = 0;
  while (i < n) {
    if (Bytes.get(text, i) == 10) {
      let lineText = _stripHeadingMark(trim(Bytes.slice(text, 0, i)));
      if (Bytes.len(lineText) == 0) {
        "Untitled"
      } else {
        lineText
      }
    }
    i += 1;
  }
  let lineText = _stripHeadingMark(trim(text));
  if (Bytes.len(lineText) == 0) {
    "Untitled"
  } else {
    lineText
  }
};

"ok"
