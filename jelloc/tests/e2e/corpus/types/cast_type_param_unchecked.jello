// error: 3:34: cannot extract Array<I32> from Dynamic: only Bool, I32, I64, F16, F32, F64, Atom, Bytes, enums and Object are checked [E0406]
// An instance whose type argument the VM cannot check is an error where the cast is.
let get<T> = fn(d: Dynamic): T { d as T };
let xs: Array<I32> = get<Array<I32>>([1] as Dynamic);
"ok"
