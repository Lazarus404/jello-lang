// expect: ok
import { readText, writeText, exists, remove } from std.io.File;
import { getEnv } from std.io.Env;

let path = getEnv("TMPDIR") + "/std_io_ctest.tmp";
let data = "hello std.File";
System.assert(writeText(path, data));
System.assert(exists(path));
let got = readText(path);
System.assert(got == data);
System.assert(remove(path));
System.assert(exists(path) == false);
"ok"
