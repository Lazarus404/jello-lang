// expect: ok
// Resolves std wrapper modules: the clock and sleep of std.concurrent.Process, and Math.random.
import { now, sleep } from std.concurrent.Process;

let t = now();
System.assert(t >= 0);

let r = Math.floor(Math.random() * 11);
System.assert(r >= 0);
System.assert(r <= 10);

let before = now();
sleep(1);
System.assert(now() >= before + 1);

"ok"
