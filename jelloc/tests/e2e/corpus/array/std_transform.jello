// expect: ok
let empty: Array<I32> = [];
let filtered = empty.filter(fn(x) { x == 1 });
System.assert(filtered.len() == 0);
let mapped = empty.map(fn(x) { x + 1 });
System.assert(mapped.len() == 0);
let noFirst = empty.first(fn(x) { true });
System.assert(noFirst == null);
let noLast = empty.last(fn(x) { true });
System.assert(noLast == null);
let a = [1.0, 2.0, 3.0, 4.0];
let found = a.first(fn(x) { x == 2.0 });
System.assert(found == 2.0);
let miss = a.first(fn(x) { x == 9.0 });
System.assert(miss == null);
let lastHit = a.last(fn(x) { x == 4.0 });
System.assert(lastHit == 4.0);
let lastMiss = a.last(fn(x) { x == 9.0 });
System.assert(lastMiss == null);
let evens = a.filter(fn(x) { (x == 2.0) || (x == 4.0) });
System.assert(evens.len() == 2);
let odds = a.reject(fn(x) { (x == 2.0) || (x == 4.0) });
System.assert(odds.len() == 2);
let doubled = a.map(fn(x) { x * 2.0 });
System.assert(doubled[3] == 8.0);
let idxs = [10, 20, 30];
let indexedMap = idxs.mapIndexed(fn(x, i) { x + i });
System.assert(indexedMap[0] == 10);
System.assert(indexedMap[1] == 21);
System.assert(indexedMap[2] == 32);
let kept = idxs.filterIndexed(fn(x, i) { i == 1 });
System.assert(kept.len() == 1);
System.assert(kept[0] == 20);
let dropped = idxs.rejectIndexed(fn(x, i) { i == 0 });
System.assert(dropped.len() == 2);
System.assert(dropped[0] == 20);
let ints = [3, 1, 2];
ints.sort(fn(x, y) { if (x < y) { -1 } else { if (x > y) { 1 } else { 0 } } });
System.assert(ints[0] == 1);
System.assert(ints[2] == 3);
let nums = [3.0, 1.0, 2.0];
nums.sort(fn(x, y) { if (x < y) { -1 } else { if (x > y) { 1 } else { 0 } } });
System.assert(nums[0] == 1.0);
"ok"
