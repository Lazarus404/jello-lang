// expect: ok
let empty: Array<I32> = [];
System.assert(empty.reduce(7, fn(a, x) { a + x }) == 7);
let a = [1, 2, 3];
System.assert(a.reduce(0, fn(acc, x) { acc + x }) == 6);
let parts: Array<Bytes> = ["x", "y"];
System.assert(parts.reduce("", fn(buf, s) { buf + s }) == "xy");
System.assert([10, 20, 30].reduceIndexed(0, fn(acc, x, i) { acc + x + i }) == 63);
let n = [0];
let same = a.forEach(fn(_x) { n[0] = n[0] + 1; null });
System.assert(n[0] == 3);
System.assert(same.len() == 3);
System.assert(same[1] == 2);
let sum = [0];
a.forEachIndexed(fn(x, i) { sum[0] = sum[0] + x + i; null });
System.assert(sum[0] == 9);
"ok"
