// expect: ok
let empty: Array<I32> = [];
System.assert(empty.shift() == null);
let a = [1, 2, 3];
System.assert(a.push(4) == 4);
System.assert(a.pop() == 4);
System.assert(a.unshift(0) == 4);
System.assert(a.shift() == 0);
System.assert(a.len() == 3);
a.insert(1, 9);
System.assert(a[1] == 9);
a.reverse();
System.assert(a[0] == 3);
System.assert(a[1] == 2);
System.assert(a[2] == 9);
System.assert(a[3] == 1);
let b = [10, 20];
b.resize(5);
System.assert(b.len() == 5);
b.resize(2);
System.assert(b.len() == 2);
"ok"
