// expect: ok
// pending: native wakeup_new without a typed binding
load { poll_many, wakeup_new, wakeup_poll_fd, wakeup_signal, wakeup_drain } from std;

let w = wakeup_new();
let fd = wakeup_poll_fd(w);
let fds = Array.new<I32>(1);
Array.set(fds, 0, fd);
let before = poll_many(fds, 1, 0);
wakeup_signal(w);
let after = poll_many(fds, 1, 100);
if (before != 0) { System.exit(1); }
if (after == 0) { System.exit(2); }
wakeup_drain(w);
"ok"
