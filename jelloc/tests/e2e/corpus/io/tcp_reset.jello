// expect: ok
// A read gives empty Bytes once the other end has closed.
import std.net.Tcp as Tcp;
import type { Listener, Stream } from std.net.Tcp;

let run = fn(): Bytes {
  let listener = Tcp.listen("127.0.0.1", 0);
  let client = Tcp.connect("127.0.0.1", listener.port());
  let server = listener.accept();
  System.assert(client.close());
  let eof = server.read(64);
  System.assert(Bytes.isEmpty(eof));
  server.close();
  listener.close();
  "ok"
};
run()
