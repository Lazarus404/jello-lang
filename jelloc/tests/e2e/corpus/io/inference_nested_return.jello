// expect: ok
// A returned closure calls a closure it captured from its maker.
import { readText, writeText, remove } from std.io.File;
import { getEnv } from std.io.Env;

let make = fn() {
  let writeSeed = fn(p: Bytes) { writeText(p, "seed") };
  return fn() {
    let path = getEnv("TMPDIR") + "/io_infer_cap.tmp";
    writeSeed(path);
    let text = readText(path);
    remove(path);
    text
  };
};

let inner = make();
System.assert(Bytes.eq(inner(), "seed"));
"ok"
