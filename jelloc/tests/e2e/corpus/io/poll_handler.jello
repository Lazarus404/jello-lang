// expect: ok
// A handler process runs once for each datagram its socket receives.
import std.concurrent.Process as Process;
import type { Process, Inbox } from std.concurrent.Process;
import std.net.Udp as Udp;
import type { Socket, Datagram } from std.net.Udp;

let run = fn(): Bytes {
  let hits = new Inbox<I32>();
  let main = Process.self<I32>(hits);
  let sock = Udp.bind("127.0.0.1", 0);
  let port = sock.port();
  Process.spawn<I32>(fn(_: Inbox<I32>) {
    let n = 0;
    while (true) {
      sock.receive(64);
      n = n + 1;
      main.send(n);
    }
  });
  let sender = Udp.bind("127.0.0.1", 0);
  sender.sendTo(bits[16(7), 8(9)], "127.0.0.1", port);
  let seen = hits.receiveWithin(5000);
  sender.close();
  System.assert(seen == 1);
  "ok"
};
run()
