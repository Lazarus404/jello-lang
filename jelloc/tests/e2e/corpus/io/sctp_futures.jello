// expect: ok
// pending: std.io.net.Sctp is not ported
load { addr_resolve } from std;
import { bind, connect, boundPort, accept, trySend, awaitRecv, payload, close } from std.io.net.Sctp;
import { create, awaitFuture } from std.io.EventLoop;

let loop = create();
let bindAddr = addr_resolve("127.0.0.1", 0);
let server = bind(bindAddr);
let port = boundPort(server);
let connectAddr = addr_resolve("127.0.0.1", port);

let acceptF = accept(loop, server);
let client = connect(connectAddr);
let conn = awaitFuture(loop, acceptF);

let sent = trySend(client, bits[8(3)], 0, 11);
System.assert(sent > 0);
let rec = awaitRecv(loop, conn, 4096);
System.assert(Bytes.get_u8(payload(rec), 0) == 3);
close(client);
close(conn);
close(server);
"ok"
