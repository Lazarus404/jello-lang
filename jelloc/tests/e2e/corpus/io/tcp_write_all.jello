// expect: ok
import std.net.Tcp as Tcp;
import type { Listener, Stream } from std.net.Tcp;

let run = fn(): Bytes {
  let listener = Tcp.listen("127.0.0.1", 0);
  let client = Tcp.connect("127.0.0.1", listener.port());
  let server = listener.accept();
  let payload = bits[8(1), 8(2), 8(3), 8(4), 8(5), 8(6), 8(7), 8(8)];
  client.write(payload);
  let msg = "";
  while (msg.len() < payload.len()) { msg = msg + server.read(64); }
  System.assert(msg == payload);
  client.close();
  server.close();
  listener.close();
  "ok"
};
run()
