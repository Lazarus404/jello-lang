// expect: ok
// Closing a listener frees its port for a new listener.
import std.net.Tcp as Tcp;
import type { Listener, Stream } from std.net.Tcp;

let run = fn(): Bytes {
  let listener = Tcp.listen("127.0.0.1", 0);
  let port = listener.port();
  System.assert(listener.close());
  let listener2 = Tcp.listen("127.0.0.1", port);
  System.assert(listener2.port() == port);
  System.assert(listener2.close());
  System.assert(listener2.close() == false);
  "ok"
};
run()
