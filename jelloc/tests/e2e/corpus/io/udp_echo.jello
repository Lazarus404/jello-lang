// expect: ok
import std.net.Udp as Udp;
import type { Socket, Datagram } from std.net.Udp;

typedef EchoHdr = bytes-layout {
  let tag: U16.le;
  let payload: rest;
};

let run = fn(): Bytes {
  let sock = Udp.bind("127.0.0.1", 0);
  let pkt = EchoHdr.pack({ tag: 7, payload: bits[8(9)] });
  sock.sendTo(pkt, "127.0.0.1", sock.port());
  let raw = sock.receive(4096).data;
  let tag = match (raw) {
    EchoHdr(h) => h.tag,
    _ => 0,
  };
  System.assert(tag == 7);
  sock.close();
  "ok"
};
run()
