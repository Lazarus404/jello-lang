// expect: ok
// A process parked on a UDP receive wakes when the datagram arrives.
import std.concurrent.Process as Process;
import type { Process, Inbox } from std.concurrent.Process;
import std.net.Udp as Udp;
import type { Socket, Datagram } from std.net.Udp;

let run = fn(): Bytes {
  let got = new Inbox<Bytes>();
  let main = Process.self<Bytes>(got);
  let sock = Udp.bind("127.0.0.1", 0);
  let port = sock.port();
  Process.spawn<I32>(fn(_: Inbox<I32>) { main.send(sock.receive(4096).data); });
  let sender = Udp.bind("127.0.0.1", 0);
  sender.sendTo(bits[8(42)], "127.0.0.1", port);
  let raw = got.receive();
  sender.close();
  System.assert(Bytes.len(raw) == 1);
  System.assert(Bytes.get_u8(raw, 0) == 42);
  "ok"
};
run()
