// expect: ok
import std.net.Udp as Udp;
import type { Socket, Datagram } from std.net.Udp;

let run = fn(): Bytes {
  let sock = Udp.bind("127.0.0.1", 0);
  let pkt = bits[16(7), 8(9)];
  sock.sendTo(pkt, "127.0.0.1", sock.port());
  let rec = sock.receiveWithin(4096, 5000);
  System.assert(rec != null);
  let raw = match (rec) { null => "", d => d.data };
  System.assert(Bytes.readU16Le(raw, 0) == 7);
  sock.close();
  "ok"
};
run()
