// expect: ok
import std.net.Tcp as Tcp;
import type { Listener, Stream } from std.net.Tcp;

let run = fn(): Bytes {
  let listener = Tcp.listen("::1", 0);
  let client = Tcp.connect("::1", listener.port());
  let server = listener.accept();
  client.write("v6");
  let msg = "";
  while (msg.len() < 2) { msg = msg + server.read(8); }
  System.assert(msg == "v6");
  System.assert(server.peerHost() == "::1");
  client.close();
  server.close();
  listener.close();
  "ok"
};
run()
