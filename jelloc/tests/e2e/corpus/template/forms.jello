// expect: ["hello world!", "42", "n=42, list=[1, 2], pair=(1, \"a\")", "abc", "", "none"]
// A hole shows its value as Std.string does, and Bytes as itself; a template
// without holes is a bytes literal.
let name = "world"; let n = 42;
Std.string([`hello ${name}!`, `${n}`, `n=${n}, list=${list[1, 2]}, pair=${(1, "a")}`, `a${"b"}c`, ``, `none`])
