// expect: ok
// pending: lists
// std List methods: transform, search, mutators, join, toString, sort
// Plain module tail (no ava): linking ava pushes this file over the 256-reg limit.
let xs: List<I32> = list[1, 2, 3];

let ys = xs.filter(fn(x) { return x != 2; });
System.assert(ys.join(",") == "1,3");

let zs = xs.map(fn(x) { return x + 10; });
System.assert(zs.first() == 11);

let ws = xs.remove(2);
System.assert(ws.join(",") == "1,3");

System.assert(xs.contains(2));
System.assert(xs.contains(9) == false);
System.assert(xs.indexOf(2) == 1);
System.assert(xs.indexOf(9) == -1);
System.assert(xs.indexOfFrom(2, 2) == -1);
System.assert(xs.lastIndexOf(2) == 1);
System.assert(xs.lastIndexOfFrom(2, 0) == -1);

let rev = xs.reverse();
System.assert(rev.join(",") == "3,2,1");

let dup = xs.copy();
System.assert(dup.join(",") == "1,2,3");
System.assert(dup.indexOf(2) == 1);

System.assert(xs.join(",") == "1,2,3");
System.assert(xs.toString() == "{1,2,3}");
System.assert(xs.pop() == 1);
System.assert(xs.last() == 3);

let e = xs.clear();
System.assert(e.last() == null);

let uns: List<I32> = list[3, 1, 2];
let sorted = uns.sort(fn(a, b) { return a - b; });
System.assert(sorted.join(",") == "1,2,3");

"ok"
