// expect: ok
/* An inbox delivers in order, tryReceive gives null when it is empty, and a finished process
 * takes no more messages. */
import std.concurrent.Process as Process;
import type { Process, Inbox } from std.concurrent.Process;

let inbox = new Inbox<I32>();
let me = Process.self<I32>(inbox);
System.assert(inbox.tryReceive() == null);
System.assert(me.send(99));
System.assert(inbox.receive() == 99);
System.assert(me.send(7));
System.assert(inbox.tryReceive() == 7);

let done = Process.spawn<I32>(fn(_: Inbox<I32>) { });
done.join();
System.assert(done.send(1) == false);
"ok"
