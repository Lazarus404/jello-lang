import { test, run } from jellotest.Runner;
import { verifyFunction, verifyProgram } from ir.Verify;
import type {
  BasicBlock,
  EnumSchema,
  Native,
  Function,
  Instruction,
  Program,
  ReturnType,
  Terminator,
  ThrowHandler,
  ValueType,
} from ir.Model;
import { Op, instruction } from ir.Model;

let insn = fn(op: Op, dst: I32, args: Array<I32>, imm: I32): Instruction { instruction(op, dst, args, imm) };
let none = fn(): Array<I32> { Array.new<I32>(0) };
let program = fn(functions: Array<Function>, pool: Array<Bytes>): Program { Program.Program(functions, pool, Array.new<I64>(0), Array.new<EnumSchema>(0), Array.new<ValueType>(0), Array.new<Native>(0)) };

test("verifies a typed branching function", fn(t) {
  let blocks: Array<BasicBlock> = [
    BasicBlock.Block(0, [
      insn(Op.Eq, 2, [0, 1], 0)
    ], Terminator.Branch(2, 1, 2), null),
    BasicBlock.Block(1, [], Terminator.ReturnValue(0), null),
    BasicBlock.Block(2, [], Terminator.ReturnValue(1), null)
  ];
  let function = Function.Function(
    0,
    [0, 1],
    [ValueType.I32, ValueType.I32, ValueType.Bool],
    ReturnType.Value(ValueType.I32),
    blocks,
    0
  );

  t.is(verifyFunction(function), true);
  t.is(verifyProgram(program([function], Array.new<Bytes>(0))), true);
});

test("rejects invalid register types and block targets", fn(t) {
  let wrongType = Function.Function(
    0,
    [],
    [ValueType.Bool],
    ReturnType.Value(ValueType.Bool),
    [BasicBlock.Block(
      0,
      [insn(Op.ConstI32, 0, none(), 1)],
      Terminator.ReturnValue(0),
      null
    )],
    0
  );
  let badTarget = Function.Function(
    1,
    [],
    [],
    ReturnType.Void,
    [BasicBlock.Block(0, [], Terminator.Jump(9), null)],
    0
  );
  let duplicateBlock = Function.Function(
    2,
    [],
    [],
    ReturnType.Void,
    [BasicBlock.Block(0, [], Terminator.Jump(1), null), BasicBlock.Block(1, [], Terminator.ReturnVoid, null), BasicBlock.Block(1, [], Terminator.ReturnVoid, null)],
    0
  );

  t.throws(fn(_t) { verifyFunction(wrongType); });
  t.throws(fn(_t) { verifyFunction(badTarget); });
  t.throws(fn(_t) { verifyFunction(duplicateBlock); });
});

test("rejects return and handler mismatches", fn(t) {
  let wrongReturn = Function.Function(
    0,
    [],
    [],
    ReturnType.Value(ValueType.I32),
    [BasicBlock.Block(0, [], Terminator.ReturnVoid, null)],
    0
  );
  let badHandler = Function.Function(
    1,
    [],
    [],
    ReturnType.Void,
    [BasicBlock.Block(0, [], Terminator.ReturnVoid, ThrowHandler.Catch(4, 0))],
    0
  );

  t.throws(fn(_t) { verifyFunction(wrongReturn); });
  t.throws(fn(_t) { verifyFunction(badHandler); });
});

test("requires definitions on every path to a use", fn(t) {
  let missingDefinition = Function.Function(
    0,
    [0],
    [ValueType.Bool, ValueType.I32],
    ReturnType.Value(ValueType.I32),
    [
      BasicBlock.Block(0, [], Terminator.Branch(0, 1, 2), null),
      BasicBlock.Block(1, [insn(Op.ConstI32, 1, none(), 7)], Terminator.Jump(3), null),
      BasicBlock.Block(2, [], Terminator.Jump(3), null),
      BasicBlock.Block(3, [], Terminator.ReturnValue(1), null)
    ],
    0
  );
  let definedOnBothPaths = Function.Function(
    1,
    [0],
    [ValueType.Bool, ValueType.I32],
    ReturnType.Value(ValueType.I32),
    [
      BasicBlock.Block(0, [], Terminator.Branch(0, 1, 2), null),
      BasicBlock.Block(1, [insn(Op.ConstI32, 1, none(), 7)], Terminator.Jump(3), null),
      BasicBlock.Block(2, [insn(Op.ConstI32, 1, none(), 9)], Terminator.Jump(3), null),
      BasicBlock.Block(3, [], Terminator.ReturnValue(1), null)
    ],
    0
  );

  t.throws(fn(_t) { verifyFunction(missingDefinition); });
  t.is(verifyFunction(definedOnBothPaths), true);
});

test("requires a spill slot written on every path to a pop", fn(t) {
  let spilled = fn(id: I32, otherPath: Array<Instruction>, slotType: ValueType): Function {
    Function.Function(
      id,
      [0],
      [ValueType.Bool, ValueType.I32, slotType],
      ReturnType.Value(ValueType.I32),
      [
        BasicBlock.Block(0, [insn(Op.ConstI32, 1, none(), 7)], Terminator.Branch(0, 1, 2), null),
        BasicBlock.Block(1, [insn(Op.SpillPush, -1, [1], 0)], Terminator.Jump(3), null),
        BasicBlock.Block(2, otherPath, Terminator.Jump(3), null),
        BasicBlock.Block(3, [insn(Op.SpillPop, 2, none(), 0)], Terminator.ReturnValue(1), null)
      ],
      0
    )
  };
  t.is(verifyFunction(spilled(0, [insn(Op.SpillPush, -1, [1], 0)], ValueType.I32)), true);
  t.throws(fn(_t) { verifyFunction(spilled(1, Array.new<Instruction>(0), ValueType.I32)); });
  t.throws(fn(_t) { verifyFunction(spilled(2, [insn(Op.SpillPush, -1, [1], 0)], ValueType.Bool)); });
  t.throws(fn(_t) { verifyFunction(spilled(3, [insn(Op.SpillPush, -1, [1], -1)], ValueType.I32)); });
});

test("types sparse spill slots independently", fn(t) {
  let sparse = fn(id: I32, popped: ValueType, instructions: Array<Instruction>): Function {
    Function.Function(
      id,
      [0],
      [ValueType.Bool, ValueType.I32, popped],
      ReturnType.Value(ValueType.I32),
      [BasicBlock.Block(0, instructions, Terminator.ReturnValue(1), null)],
      0
    )
  };
  t.is(verifyFunction(sparse(0, ValueType.I32, [insn(Op.ConstI32, 1, none(), 7), insn(Op.SpillPush, -1, [1], 5), insn(Op.SpillPush, -1, [0], 0), insn(Op.SpillPop, 2, none(), 5)])), true);
  t.throws(fn(_t) { verifyFunction(sparse(1, ValueType.Bool, [insn(Op.ConstI32, 1, none(), 7), insn(Op.SpillPush, -1, [1], 5), insn(Op.SpillPop, 2, none(), 5)])); });
});

test("defines a dynamic catch payload on throw edges", fn(t) {
  let function = Function.Function(
    0,
    [],
    [ValueType.Dynamic, ValueType.Bytes],
    ReturnType.Value(ValueType.Dynamic),
    [
      BasicBlock.Block(0, [], Terminator.Jump(2), null),
      BasicBlock.Block(
        2,
        [insn(Op.ConstBytes, 1, none(), 0)],
        Terminator.Throw(1),
        ThrowHandler.Catch(1, 0)
      ),
      BasicBlock.Block(1, [], Terminator.ReturnValue(0), null)
    ],
    0
  );

  t.is(verifyFunction(function), true);
});

test("does not define post-call values on exceptional edges", fn(t) {
  let callee = Function.Function(
    1, [], [ValueType.I32], ReturnType.Value(ValueType.I32),
    [BasicBlock.Block(0, [insn(Op.ConstI32, 0, none(), 1)], Terminator.ReturnValue(0), null)], 0
  );
  let caller = Function.Function(
    0,
    [],
    [ValueType.I32, ValueType.I32, ValueType.Dynamic],
    ReturnType.Value(ValueType.I32),
    [
      BasicBlock.Block(0, [], Terminator.Jump(2), null),
      BasicBlock.Block(
        2,
        [insn(Op.Call, 0, none(), 1), insn(Op.ConstI32, 1, none(), 2)],
        Terminator.ReturnValue(1),
        ThrowHandler.Catch(1, 2)
      ),
      BasicBlock.Block(1, [], Terminator.ReturnValue(1), null)
    ],
    0
  );
  t.throws(fn(_t) { verifyProgram(program([callee, caller], Array.new<Bytes>(0))); });
});

let regions = fn(entry: Terminator, first: ?ThrowHandler, second: ?ThrowHandler): Function {
  let empty = Array.new<Instruction>(0);
  Function.Function(0, none(), [ValueType.Dynamic, ValueType.Bool], ReturnType.Value(ValueType.Dynamic), [
    BasicBlock.Block(0, [insn(Op.ConstNull, 0, none(), 0), insn(Op.ConstBool, 1, none(), 1)], entry, null),
    BasicBlock.Block(1, empty, Terminator.ReturnValue(0), first),
    BasicBlock.Block(2, empty, Terminator.ReturnValue(0), second)
  ], 0)
};

test("checks that try regions nest", fn(t) {
  t.is(verifyFunction(regions(Terminator.Jump(1), ThrowHandler.Catch(2, 0), null)), true);
  t.throws(fn(_t) {
    verifyFunction(Function.Function(0, none(), [ValueType.Dynamic], ReturnType.Value(ValueType.Dynamic), [
      BasicBlock.Block(0, Array.new<Instruction>(0), Terminator.ReturnValue(0), ThrowHandler.Catch(1, 0)),
      BasicBlock.Block(1, Array.new<Instruction>(0), Terminator.ReturnValue(0), null)
    ], 0));
  });
  t.throws(fn(_t) { verifyFunction(regions(Terminator.Branch(1, 1, 2), ThrowHandler.Catch(2, 0), null)); });
  t.throws(fn(_t) { verifyFunction(regions(Terminator.Jump(1), ThrowHandler.Catch(2, 0), ThrowHandler.Catch(1, 0))); });
});

test("converges on loop backedges", fn(t) {
  let function = Function.Function(
    0,
    [0, 1],
    [ValueType.Bool, ValueType.I32],
    ReturnType.Value(ValueType.I32),
    [
      BasicBlock.Block(0, [], Terminator.Branch(0, 1, 2), null),
      BasicBlock.Block(1, [insn(Op.Add, 1, [1, 1], 0)], Terminator.Jump(0), null),
      BasicBlock.Block(2, [], Terminator.ReturnValue(1), null)
    ],
    0
  );

  t.is(verifyFunction(function), true);
});

test("checks calls, function constants and the bytes pool against the program", fn(t) {
  let callee = Function.Function(
    1, [0], [ValueType.I32], ReturnType.Value(ValueType.I32),
    [BasicBlock.Block(0, [], Terminator.ReturnValue(0), null)], 0
  );

  let caller = fn(instructions: Array<Instruction>, registers: Array<ValueType>): Function {
    Function.Function(0, [], registers, ReturnType.Value(ValueType.I32),
      [BasicBlock.Block(0, instructions, Terminator.ReturnValue(0), null)], 0)
  };
  let good = caller([insn(Op.ConstI32, 1, none(), 7), insn(Op.Call, 0, [1], 1)], [ValueType.I32, ValueType.I32]);
  t.is(verifyProgram(program([callee, good], Array.new<Bytes>(0))), true);
  let wrongArgument = caller([insn(Op.ConstBool, 1, none(), 1), insn(Op.Call, 0, [1], 1)], [ValueType.I32, ValueType.Bool]);
  t.throws(fn(_t) { verifyProgram(program([callee, wrongArgument], Array.new<Bytes>(0))); });
  let unknownCallee = caller([insn(Op.ConstI32, 1, none(), 7), insn(Op.Call, 0, [1], 9)], [ValueType.I32, ValueType.I32]);
  t.throws(fn(_t) { verifyProgram(program([callee, unknownCallee], Array.new<Bytes>(0))); });
  let wrongSignature = Function.Function(0, [], [ValueType.Function([ValueType.Bool], ReturnType.Value(ValueType.I32)), ValueType.I32],
    ReturnType.Value(ValueType.I32),
    [BasicBlock.Block(0, [insn(Op.ConstFunction, 0, none(), 1), insn(Op.ConstI32, 1, none(), 0)], Terminator.ReturnValue(1), null)], 0);
  t.throws(fn(_t) { verifyProgram(program([callee, wrongSignature], Array.new<Bytes>(0))); });
  let bytes = Function.Function(0, [], [ValueType.Bytes], ReturnType.Value(ValueType.Bytes),
    [BasicBlock.Block(0, [insn(Op.ConstBytes, 0, none(), 0)], Terminator.ReturnValue(0), null)], 0);
  t.is(verifyProgram(program([bytes], ["A"])), true);
  t.throws(fn(_t) { verifyProgram(program([bytes], Array.new<Bytes>(0))); });
});

run()
