package frontend;

import type { Test } from std.testing;
import std.testing as T;
import { u8 } from std.core.Bytes;

import { lexFile, Token, IntegerSize, FloatSize } from frontend.Lexer;

// SRC's tokens alone.
let lex = fn(src: Bytes): Array<Token> { lexFile(src, "<input>").0 };

let testRecordsHalfOpenTokenByteSpans = fn(t: Test) {
  let (_, path, starts, ends) = lexFile("  1i32 + abc", "<input>");
  T.equal(t, path, "<input>");
  T.equal(t, starts[0], 2);
  T.equal(t, ends[0], 6);
  T.equal(t, starts[1], 7);
  T.equal(t, ends[1], 8);
  T.equal(t, starts[2], 9);
  T.equal(t, ends[2], 12);
  T.equal(t, starts[3], 12);
  T.equal(t, ends[3], 12);
};

let testLexesIntegerSizesWithoutNarrowingTheirDigits = fn(t: Test) {
  let toks = lex("1i8 2i16 3i32 4i64 5u8 6u16 7u32 18446744073709551615u64");
  T.equal(t, toks[0], Token.IntegerConstant("1", IntegerSize.I8));
  T.equal(t, toks[1], Token.IntegerConstant("2", IntegerSize.I16));
  T.equal(t, toks[2], Token.IntegerConstant("3", IntegerSize.I32));
  T.equal(t, toks[3], Token.IntegerConstant("4", IntegerSize.I64));
  T.equal(t, toks[4], Token.IntegerConstant("5", IntegerSize.U8));
  T.equal(t, toks[5], Token.IntegerConstant("6", IntegerSize.U16));
  T.equal(t, toks[6], Token.IntegerConstant("7", IntegerSize.U32));
  T.equal(t, toks[7], Token.IntegerConstant("18446744073709551615", IntegerSize.U64));
};

let testLexesFloatingPointSizes = fn(t: Test) {
  let toks = lex("1f16 2.5f32 3e4f64 4.5");
  T.equal(t, toks[0], Token.FloatConstant("1", FloatSize.F16));
  T.equal(t, toks[1], Token.FloatConstant("2.5", FloatSize.F32));
  T.equal(t, toks[2], Token.FloatConstant("3e4", FloatSize.F64));
  T.equal(t, toks[3], Token.FloatConstant("4.5", FloatSize.Infer));
};

let testDistinguishesTupleMembersFromLeadingDotFloats = fn(t: Test) {
  let toks = lex("t.0 .5");
  T.equal(t, toks[0], Token.Ident("t"));
  T.equal(t, toks[1], Token.Dot);
  T.equal(t, toks[2], Token.IntegerConstant("0", IntegerSize.Infer));
  T.equal(t, toks[3], Token.FloatConstant(".5", FloatSize.Infer));
};

let testLexesHexBinaryAndOctalIntegersWithDigitSeparators = fn(t: Test) {
  let toks = lex("0xFF 0XdeAD_beef 0b1010 0o17 0x7Fi32");
  T.equal(t, toks[0], Token.IntegerConstant("0xFF", IntegerSize.Infer));
  T.equal(t, toks[1], Token.IntegerConstant("0XdeAD_beef", IntegerSize.Infer));
  T.equal(t, toks[2], Token.IntegerConstant("0b1010", IntegerSize.Infer));
  T.equal(t, toks[3], Token.IntegerConstant("0o17", IntegerSize.Infer));
  T.equal(t, toks[4], Token.IntegerConstant("0x7F", IntegerSize.I32));
  T.throws(t, fn() { lex("0x"); });
  T.throws(t, fn() { lex("0b2"); });
  T.throws(t, fn() { lex("0b1f32"); });
};

let testLeavesUnsuffixedIntegerSizeForTypeChecking = fn(t: Test) {
  let toks = lex("42");
  T.equal(t, toks[0], Token.IntegerConstant("42", IntegerSize.Infer));
};

let testDistinguishesKeywordsFromIdentifiers = fn(t: Test) {
  let toks = lex("let fn if else enum true false null return new as is letter async");
  T.equal(t, toks[0], Token.Let);
  T.equal(t, toks[1], Token.Fn);
  T.equal(t, toks[2], Token.If);
  T.equal(t, toks[3], Token.Else);
  T.equal(t, toks[4], Token.EnumDecl);
  T.equal(t, toks[5], Token.True);
  T.equal(t, toks[6], Token.False);
  T.equal(t, toks[7], Token.Null);
  T.equal(t, toks[8], Token.Return);
  T.equal(t, toks[9], Token.New);
  T.equal(t, toks[10], Token.As);
  T.equal(t, toks[11], Token.Is);
  T.equal(t, toks[12], Token.Ident("letter"));
  T.equal(t, toks[13], Token.Ident("async"));
};

let testLexesConstAsAKeyword = fn(t: Test) {
  let toks = lex("const constant");
  T.equal(t, toks[0], Token.Const);
  T.equal(t, toks[1], Token.Ident("constant"));
};

let testLexesTypeDeclarationKeywords = fn(t: Test) {
  let toks = lex("type typedef typed");
  T.equal(t, toks[0], Token.Type);
  T.equal(t, toks[1], Token.Typedef);
  T.equal(t, toks[2], Token.Ident("typed"));
};

let testLexesErrorHandlingKeywords = fn(t: Test) {
  let toks = lex("try catch throw trying catcher");
  T.equal(t, toks[0], Token.Try);
  T.equal(t, toks[1], Token.Catch);
  T.equal(t, toks[2], Token.Throw);
  T.equal(t, toks[3], Token.Ident("trying"));
  T.equal(t, toks[4], Token.Ident("catcher"));
};

let testLexesObjectReceiverKeywords = fn(t: Test) {
  let toks = lex("this super thisValue superior");
  T.equal(t, toks[0], Token.This);
  T.equal(t, toks[1], Token.Super);
  T.equal(t, toks[2], Token.Ident("thisValue"));
  T.equal(t, toks[3], Token.Ident("superior"));
};

let testLexesBitSyntaxKeywordsAndContextualRest = fn(t: Test) {
  let toks = lex("bits rest match bitsValue restart matcher");
  T.equal(t, toks[0], Token.Bits);
  T.equal(t, toks[1], Token.Ident("rest"));
  T.equal(t, toks[2], Token.Match);
  T.equal(t, toks[3], Token.Ident("bitsValue"));
  T.equal(t, toks[4], Token.Ident("restart"));
  T.equal(t, toks[5], Token.Ident("matcher"));
};

let testLexesListSyntaxKeywords = fn(t: Test) {
  let toks = lex("list for do when listed format donut whenever");
  T.equal(t, toks[0], Token.ListLiteral);
  T.equal(t, toks[1], Token.For);
  T.equal(t, toks[2], Token.Do);
  T.equal(t, toks[3], Token.When);
  T.equal(t, toks[4], Token.Ident("listed"));
  T.equal(t, toks[5], Token.Ident("format"));
  T.equal(t, toks[6], Token.Ident("donut"));
  T.equal(t, toks[7], Token.Ident("whenever"));
};

let testLeavesBuiltInNamesAsIdentifiers = fn(t: Test) {
  let toks = lex("Array Atom Bool Bytes Enum F16 F32 F64 I8 I16 I32 I64 List System Tuple U8 U16 U32 U64");
  T.equal(t, toks[0], Token.Ident("Array"));
  T.equal(t, toks[4], Token.Ident("Enum"));
  T.equal(t, toks[10], Token.Ident("I32"));
  T.equal(t, toks[13], Token.Ident("System"));
  T.equal(t, toks[14], Token.Ident("Tuple"));
  T.equal(t, toks[18], Token.Ident("U64"));
};

let testRejectsUnknownAndMismatchedNumericSuffixes = fn(t: Test) {
  T.throws(t, fn() { lex("1i128"); });
  T.throws(t, fn() { lex("1.0u32"); });
  T.throws(t, fn() { lex("1f32x"); });
};

let testLexesByteLiteralsAndEscapes = fn(t: Test) {
  let toks = lex("\"hello\\nworld\" '\\u{1f642}' \"\\u0041\\0\"");
  T.equal(t, toks[0], Token.BytesLiteral("hello\nworld"));
  T.equal(t, toks[1], Token.BytesLiteral("🙂"));
  T.equal(t, toks[2], Token.BytesLiteral("A" + u8(0)));
  T.throws(t, fn() { lex("\"unterminated"); });
  T.throws(t, fn() { lex("\"\\q\""); });
  T.throws(t, fn() { lex("\"\\u{110000}\""); });
  T.throws(t, fn() { lex("\"\\u{d800}\""); });
};

let testLexesRegexpLiterals = fn(t: Test) {
  let toks = lex("~r/a+/ ~r/hello/q ~r/a\\/b/im ~r/[a]/");
  T.equal(t, toks[0], Token.RegExpLiteral("a+", ""));
  T.equal(t, toks[1], Token.RegExpLiteral("hello", "q"));
  T.equal(t, toks[2], Token.RegExpLiteral("a\\/b", "im"));
  T.equal(t, toks[3], Token.RegExpLiteral("[a]", ""));
  T.throws(t, fn() { lex("~r/unterminated"); });
};

let testLexesJelloOperatorsLongestFirst = fn(t: Test) {
  let toks = lex("... == => != <- <= >= ++ += -- -= -> *= /= << >> && || |> (){}[];:,?.=!<>+-*/%&|^");
  T.equal(t, toks[0], Token.DotDotDot);
  T.equal(t, toks[1], Token.EqualEqual);
  T.equal(t, toks[2], Token.FatArrow);
  T.equal(t, toks[3], Token.NotEqual);
  T.equal(t, toks[4], Token.LessMinus);
  T.equal(t, toks[5], Token.LessEqual);
  T.equal(t, toks[6], Token.GreaterEqual);
  T.equal(t, toks[7], Token.PlusPlus);
  T.equal(t, toks[8], Token.PlusEqual);
  T.equal(t, toks[9], Token.MinusMinus);
  T.equal(t, toks[10], Token.MinusEqual);
  T.equal(t, toks[11], Token.Arrow);
  T.equal(t, toks[12], Token.StarEqual);
  T.equal(t, toks[13], Token.SlashEqual);
  T.equal(t, toks[14], Token.LessLess);
  T.equal(t, toks[15], Token.GreaterGreater);
  T.equal(t, toks[16], Token.And);
  T.equal(t, toks[17], Token.PipePipe);
  T.equal(t, toks[18], Token.PipeGreater);
  T.equal(t, toks[19], Token.LParen);
  T.equal(t, toks[41], Token.Caret);
};
