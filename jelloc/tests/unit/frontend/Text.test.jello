package frontend;

import type { Test } from std.testing;
import std.testing as T;
import { concatAll } from frontend.Text;

let testConcatenatesPartsInOrder = fn(t: Test) {
  T.equal(t, concatAll(Array.new<Bytes>(0)), "");
  T.equal(t, concatAll(["one"]), "one");
  T.equal(t, concatAll(["a", "", "bc", "d", "efg"]), "abcdefg");
  let parts = Array.new<Bytes>(0);
  let expected = "";
  let i = 0;

  while (i < 37) {
    parts.push(Std.string(i) + ",");
    expected = expected + Std.string(i) + ",";
    i++;
  }
  T.equal(t, concatAll(parts), expected);
};
