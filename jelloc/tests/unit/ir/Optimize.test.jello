package ir;

import type { Test } from std.testing;
import std.testing as T;
import { optimizeProgram } from ir.Optimize;
import { verifyProgram } from ir.Verify;
import type {
  BasicBlock, EnumSchema, Function, Instruction, Native, Program, ThrowHandler, ValueType
} from ir.Model;
import { Op, Terminator, instruction } from ir.Model;

let insn = fn(op: Op, dst: I32, args: Array<I32>, imm: I32): Instruction {
  instruction(op, dst, args, imm)
};
let none = fn(): Array<I32> { Array.new<I32>(0) };

let _block = fn(id: I32, instructions: Array<Instruction>, terminator: Terminator,
  handler: ?ThrowHandler): BasicBlock {
  { id, instructions, terminator, handler }
};

// Function ID, with no parameters but PARAMS, no captures, and entry block 0.
let _function = fn(id: I32, params: Array<I32>, registers: Array<ValueType>, result: ValueType,
  blocks: Array<BasicBlock>): Function {
  { id, params, captures: 0, registers, result, blocks, entry: 0 }
};

// FUNCTIONS with empty pools, no enums and no natives.
let _program = fn(functions: Array<Function>, floats: Array<I64>,
  globals: Array<ValueType>): Program {
  {
    functions,
    bytes: Array.new<Bytes>(0),
    wides: Array.new<I64>(0),
    floats,
    atoms: Array.new<Bytes>(0),
    enums: Array.new<EnumSchema>(0),
    globals,
    natives: Array.new<Native>(0)
  }
};

/* A helper, function 1, that reads global 1, and the body, function 0, that writes global 0 and
 * reads globals 0 and 1; global 2 is never addressed. */
let _globals = fn(): Program {
  let helper = _function(1, [], [ValueType.I32], ValueType.I32, [
    _block(0, [insn(Op.GlobalGet, 0, none(), 1)], Terminator.ReturnValue(0), null)
  ]);
  let body = _function(0, [], [ValueType.F64, ValueType.F64, ValueType.I32], ValueType.F64, [
    _block(0, [
      insn(Op.ConstFloat, 0, none(), 0),
      insn(Op.GlobalSet, -1, [0], 0),
      insn(Op.GlobalGet, 1, none(), 0),
      insn(Op.GlobalGet, 2, none(), 1)
    ], Terminator.ReturnValue(1), null)
  ]);
  _program([helper, body], [0], [ValueType.F64, ValueType.I32, ValueType.I32])
};

let _instructions = fn(function: Function): Array<Instruction> { function.blocks[0].instructions };

let testPromotesAGlobalOnlyTheBodyAddresses = fn(t: Test) {
  let program = optimizeProgram(_globals(), true);
  let body = program.functions[1];
  T.equal(t, body.registers.len(), 4);
  T.isTrue(t, body.registers[3] == ValueType.F64);

  let code = _instructions(body);
  T.isTrue(t, code[1].op == Op.Move);
  T.equal(t, code[1].dst, 3);
  T.equal(t, code[1].args[0], 0);
  T.isTrue(t, code[2].op == Op.Move);
  T.equal(t, code[2].dst, 1);
  T.equal(t, code[2].args[0], 3);
  T.isTrue(t, verifyProgram(program));
};

let testKeepsAGlobalAnotherFunctionAddresses = fn(t: Test) {
  let program = optimizeProgram(_globals(), true);
  let code = _instructions(program.functions[1]);
  T.isTrue(t, code[3].op == Op.GlobalGet);
  T.equal(t, code[3].imm, 1);
  T.isTrue(t, _instructions(program.functions[0])[0].op == Op.GlobalGet);
};

/* A leaf, function 1, returning its I32 argument plus one; function 2, calling it in block 1,
 * with HANDLER, and returning the result; function 3, calling function 2; and an empty body. */
let _calls = fn(handler: ?ThrowHandler): Program {
  let leaf = _function(1, [0], [ValueType.I32, ValueType.I32], ValueType.I32, [
    _block(0, [insn(Op.AddImm, 1, [0], 1)], Terminator.ReturnValue(1), null)
  ]);
  let caller = _function(2, [], [ValueType.I32, ValueType.I32, ValueType.Dynamic], ValueType.I32, [
    _block(0, [insn(Op.ConstI32, 0, none(), 4)], Terminator.Jump(1), null),
    _block(1, [insn(Op.Call, 1, [0], 1)], Terminator.ReturnValue(1), handler),
    _block(2, [insn(Op.ConstI32, 1, none(), 0)], Terminator.ReturnValue(1), null)
  ]);
  let outer = _function(3, [], [ValueType.I32], ValueType.I32, [
    _block(0, [insn(Op.Call, 0, none(), 2)], Terminator.ReturnValue(0), null)
  ]);
  let body = _function(0, [], [ValueType.I32], ValueType.I32, [
    _block(0, [insn(Op.Call, 0, none(), 2)], Terminator.ReturnValue(0), null)
  ]);
  _program([leaf, caller, outer, body], Array.new<I64>(0), Array.new<ValueType>(0))
};

let _callCount = fn(function: Function): I32 {
  let count = 0;
  let i = 0;

  while (i < function.blocks.len()) {
    let code = function.blocks[i].instructions;
    let j = 0;

    while (j < code.len()) {
      if (code[j].op == Op.Call) { count++; }
      j++;
    }
    i++;
  }
  count
};

let testInlinesALeafIntoItsCaller = fn(t: Test) {
  let program = optimizeProgram(_calls(null), true);
  let caller = program.functions[1];
  T.equal(t, _callCount(caller), 0);
  T.equal(t, caller.registers.len(), 5);
  // The copy and the blocks around it join the entry block, and block 2, unreached, goes.
  T.equal(t, caller.blocks.len(), 1);
  T.isTrue(t, verifyProgram(program));
};

let testKeepsCallsOfNonLeavesAndInTheBody = fn(t: Test) {
  let program = optimizeProgram(_calls(null), true);
  T.equal(t, _callCount(program.functions[2]), 1);
  T.equal(t, _callCount(program.functions[3]), 1);
};

let testInlinedCopyJoinsTheCallersTryRegion = fn(t: Test) {
  let handler: ThrowHandler = { target: 2, payload: 2 };
  let program = optimizeProgram(_calls(handler), true);
  let blocks = program.functions[1].blocks;
  let i = 0;

  while (i < blocks.len()) {
    let block = blocks[i];
    T.isTrue(t, ((block.id == 0) || (block.id == 2)) == (block.handler == null));
    i++;
  }
  T.isTrue(t, verifyProgram(program));
};

let testInlinesNothingWhenAsked = fn(t: Test) {
  let program = _calls(null);
  T.isTrue(t, optimizeProgram(program, false) == program);
};
