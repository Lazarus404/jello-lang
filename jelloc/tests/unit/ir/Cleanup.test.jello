package ir;

import type { Test } from std.testing;
import std.testing as T;
import { cleanupFunction } from ir.Cleanup;
import { verifyProgram } from ir.Verify;
import type {
  BasicBlock, EnumSchema, Function, Instruction, Native, Program, ThrowHandler, ValueType
} from ir.Model;
import { Op, Terminator, instruction } from ir.Model;

let insn = fn(op: Op, dst: I32, args: Array<I32>, imm: I32): Instruction {
  instruction(op, dst, args, imm)
};
let none = fn(): Array<I32> { Array.new<I32>(0) };

let _block = fn(id: I32, instructions: Array<Instruction>, terminator: Terminator,
  handler: ?ThrowHandler): BasicBlock {
  { id, instructions, terminator, handler }
};

// Function ID, of parameters PARAMS and REGISTERS, returning an I32, with BLOCKS from block 0.
let _withRegisters = fn(id: I32, params: Array<I32>, registers: Array<ValueType>,
  blocks: Array<BasicBlock>): Function {
  { id, params, captures: 0, registers, result: ValueType.I32, blocks, entry: 0 }
};

// Function 1, of I32 parameter 0 and COUNT I32 registers, with BLOCKS.
let _function = fn(count: I32, blocks: Array<BasicBlock>): Function {
  let registers = Array.new<ValueType>(0);
  while (registers.len() < count) { registers.push(ValueType.I32); }
  _withRegisters(1, [0], registers, blocks)
};

// A program of FUNCTION and a body that calls it.
let _program = fn(function: Function): Program {
  let body = _withRegisters(0, [], [ValueType.I32, ValueType.I32], [
    _block(0, [
      insn(Op.ConstI32, 0, none(), 1),
      insn(Op.Call, 1, [0], 1)
    ], Terminator.ReturnValue(1), null)
  ]);
  {
    functions: [function, body],
    bytes: Array.new<Bytes>(0),
    wides: Array.new<I64>(0),
    floats: Array.new<I64>(0),
    atoms: Array.new<Bytes>(0),
    enums: Array.new<EnumSchema>(0),
    globals: Array.new<ValueType>(0),
    natives: Array.new<Native>(0)
  }
};

let _code = fn(function: Function, index: I32): Array<Instruction> {
  function.blocks[index].instructions
};

let _last = fn(function: Function, index: I32): Terminator { function.blocks[index].terminator };

let _returned = fn(terminator: Terminator): I32 {
  match (terminator) { ReturnValue(value) => value, _ => -1 }
};

let testReadsThroughACopyAndRemovesIt = fn(t: Test) {
  let cleaned = cleanupFunction(_function(3, [
    _block(0, [
      insn(Op.Move, 1, [0], 0),
      insn(Op.Add, 2, [1, 1], 0)
    ], Terminator.ReturnValue(2), null)
  ]));
  let code = _code(cleaned, 0);
  T.equal(t, code.len(), 1);
  T.isTrue(t, code[0].op == Op.Add);
  T.equal(t, code[0].args[0], 0);
  T.equal(t, code[0].args[1], 0);
  T.isTrue(t, verifyProgram(_program(cleaned)));
};

let testKeepsACopyItsSourceChangesUnder = fn(t: Test) {
  let cleaned = cleanupFunction(_function(2, [
    _block(0, [
      insn(Op.Move, 1, [0], 0),
      insn(Op.ConstI32, 0, none(), 5)
    ], Terminator.ReturnValue(1), null)
  ]));
  T.equal(t, _returned(_last(cleaned, 0)), 1);
  T.isTrue(t, _code(cleaned, 0)[0].op == Op.Move);
};

let testKeepsACopyReadInAnotherBlock = fn(t: Test) {
  let cleaned = cleanupFunction(_function(4, [
    _block(0, [
      insn(Op.Move, 1, [0], 0),
      insn(Op.Add, 2, [1, 1], 0),
      insn(Op.Eq, 3, [2, 0], 0)
    ], Terminator.Branch(3, 1, 2), null),
    _block(1, Array.new<Instruction>(0), Terminator.Jump(2), null),
    _block(2, [insn(Op.Add, 2, [2, 1], 0)], Terminator.ReturnValue(2), null)
  ]));
  T.isTrue(t, _code(cleaned, 0)[0].op == Op.Move);
  T.equal(t, _code(cleaned, 0)[1].args[0], 1);
};

let testFoldsConstantsAndRemovesThem = fn(t: Test) {
  let cleaned = cleanupFunction(_function(4, [
    _block(0, [
      insn(Op.ConstI32, 1, none(), 2147483647),
      insn(Op.ConstI32, 2, none(), 1),
      insn(Op.Add, 3, [1, 2], 0)
    ], Terminator.ReturnValue(3), null)
  ]));
  let code = _code(cleaned, 0);
  T.equal(t, code.len(), 1);
  T.isTrue(t, code[0].op == Op.ConstI32);
  T.equal(t, code[0].imm, -2147483648);
  T.equal(t, code[0].dst, 3);
};

let testStopsFoldingAfterAWrite = fn(t: Test) {
  let cleaned = cleanupFunction(_function(3, [
    _block(0, [
      insn(Op.ConstI32, 1, none(), 2),
      insn(Op.Add, 1, [1, 0], 0),
      insn(Op.Add, 2, [1, 1], 0)
    ], Terminator.ReturnValue(2), null)
  ]));
  let code = _code(cleaned, 0);
  T.equal(t, code.len(), 3);
  T.isTrue(t, code[2].op == Op.Add);
};

let testKeepsDivisionAndCalls = fn(t: Test) {
  let cleaned = cleanupFunction(_function(3, [
    _block(0, [
      insn(Op.Div, 1, [0, 0], 0),
      insn(Op.Call, 2, [0], 1)
    ], Terminator.ReturnValue(0), null)
  ]));
  T.equal(t, _code(cleaned, 0).len(), 2);
};

let testFoldsABranchOnAConstantAndDropsWhatItSkips = fn(t: Test) {
  let cleaned = cleanupFunction(_function(2, [
    _block(0, [insn(Op.ConstBool, 1, none(), 1)], Terminator.Branch(1, 2, 1), null),
    _block(1, Array.new<Instruction>(0), Terminator.ReturnValue(0), null),
    _block(2, Array.new<Instruction>(0), Terminator.ReturnValue(0), null)
  ]));
  T.equal(t, cleaned.blocks.len(), 2);
  T.equal(t, _code(cleaned, 0).len(), 0);
  T.isTrue(t, match (_last(cleaned, 0)) { Jump(target) => target == 2, _ => false });
  T.isTrue(t, verifyProgram(_program(cleaned)));
};

let testKeepsACatchAndWhatOnlyItReads = fn(t: Test) {
  let registers = [ValueType.I32, ValueType.I32, ValueType.I32, ValueType.Dynamic];
  let handler: ThrowHandler = { target: 2, payload: 3 };
  let function = _withRegisters(1, [0], registers, [
    _block(0, Array.new<Instruction>(0), Terminator.Jump(1), null),
    _block(1, [
      insn(Op.ConstI32, 1, none(), 7),
      insn(Op.Call, 2, [0], 1)
    ], Terminator.ReturnValue(2), handler),
    _block(2, Array.new<Instruction>(0), Terminator.ReturnValue(1), null)
  ]);
  let cleaned = cleanupFunction(function);
  T.equal(t, cleaned.blocks.len(), 3);
  T.equal(t, _code(cleaned, 1).len(), 2);
  T.isTrue(t, verifyProgram(_program(cleaned)));
};

let testJoinsABlockOnlyAJumpReachesAndFoldsAcrossIt = fn(t: Test) {
  let cleaned = cleanupFunction(_function(4, [
    _block(0, [insn(Op.ConstI32, 1, none(), 3)], Terminator.Jump(1), null),
    _block(1, [
      insn(Op.ConstI32, 2, none(), 4),
      insn(Op.Mul, 3, [1, 2], 0)
    ], Terminator.ReturnValue(3), null)
  ]));
  T.equal(t, cleaned.blocks.len(), 1);
  let code = _code(cleaned, 0);
  T.equal(t, code.len(), 1);
  T.equal(t, code[0].imm, 12);
  T.isTrue(t, verifyProgram(_program(cleaned)));
};
