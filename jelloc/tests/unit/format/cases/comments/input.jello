#!/usr/bin/env jello
// The answer, which every one of these lines leads up to.
// It is computed once.
let answer = 42; // why not

let check = fn(n: I32): Bool { // whether N is the answer
  n == answer
};
// A comment that holds a star-slash */ so cannot become a block.
// Its partner line.
// This comment is far too long to fit on one line of one hundred code points, so it is wrapped at spaces.
/* An old block comment
   whose lines have no stars
 * and one that has. */
/**
    * A doc comment, indented badly.
    */
let documented = 1;
/* A block comment whose single line is also far too long to fit in the width that the file allows. */
let after = 2;
/** The VM's opcodes, numbered as in its `bytecode.h`. */
let opcodes = 3;
let other = 5; /* trailing */
let inline = /* in code */ 4;
