package compiler;

import type { Hir } from frontend.Hir;
import type { Program } from ir.Model;
import { lexFile } from frontend.Lexer;
import { parseProgram } from frontend.Parser;
import { typeCheckModules, typeCheckProgram } from frontend.CheckModules;
import { lowerProgram } from ir.Lower;
import { legalizeJlo } from backend.jello.Legalize;
import { allocateProgram } from backend.jello.Allocate;
import { emitAllocated, noSource } from backend.jello.Emit;
import { loadModules, loadTests } from frontend.Modules;
import { printIr } from ir.Print;

export let checked = fn(source: Bytes): Hir { typeCheckProgram(parseProgram(lexFile(source, "<input>"))) };

export let lowered = fn(source: Bytes): Program { lowerProgram(checked(source)) };

export let legalized = fn(source: Bytes): Program { legalizeJlo(lowered(source)) };

export let encoded = fn(program: Program): Bytes { emitAllocated(allocateProgram(program), noSource) };

export let emitted = fn(hir: Hir): Bytes { encoded(legalizeJlo(lowerProgram(hir))) };

let _STD = "../stdlib";

export let checkedFile = fn(path: Bytes, roots: Array<Bytes>): Hir { typeCheckModules(loadModules(path, _STD, roots)) };

export let allocatedFile = fn(path: Bytes, roots: Array<Bytes>): Program { allocateProgram(legalizeJlo(lowerProgram(checkedFile(path, roots)))) };
export let jloOf = fn(path: Bytes, roots: Array<Bytes>): Bytes { printIr(allocatedFile(path, roots)) };

export let checkedTests = fn(files: Array<Bytes>, roots: Array<Bytes>): Hir { typeCheckModules(loadTests(files, _STD, roots)) };
