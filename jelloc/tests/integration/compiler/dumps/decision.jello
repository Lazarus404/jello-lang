// A match whose arms test an enum's tag, and integer literals, for decision.ir.
enum Shape { Circle(r: I32); Square(s: I32); Point; }

let area = fn(s: Shape, k: I32): I32 {
  match (s) {
    Circle(1) => 3, Circle(r) when (r > k) => r * r * 3, Square(s) => s * s, Circle(r) => r,
    Point => 0,
  }
};

let digit = fn(n: I32, odd: Bool): Bytes {
  match (n) { 0 => "zero", 1 when (odd) => "one", 2 => "two", 1 => "unit", _ => "many" }
};

// As a statement, and in the tail of a function that calls itself.
let tally = fn(s: Shape): I32 {
  let n = 0;

  match (s) {
    Circle(1) => { n = 1; }, Circle(_) => { n = 2; }, Square(_) => { n = 3; }, Point => { n = 4; },
  };
  n
};

let count = fn(n: I32, k: I32): I32 {
  match (n) {
    0 => k, 1 when (k > 3) => count(0, k), 1 => count(0, k + 1), _ => count(n - 1, k + 2),
  }
};
let sum = tally(Shape.Point) + count(3, 0) + area(Shape.Circle(2), 1) + area(Shape.Point, 0);
digit(1, true) + Std.string(sum)
