package compiler.pipeline;

import type { Test } from std.testing;
import std.testing as T;
import { contains, indexOf } from std.core.Bytes;
import { verifyProgram } from ir.Verify;
import { blockCatch } from ir.Cfg;
import { Op, instruction } from ir.Model;
import { printIr } from ir.Print;
import { printHir } from frontend.hir.Print;
import { lexFile } from frontend.syntax.Lexer;
import { takeInternalError } from support.Internal;
import { parseProgram, programSyntax } from frontend.syntax.Parser;
import { lowerProgram } from ir.Lower;
import { legalizeJlo } from backend.jello.Legalize;
import { allocateProgram } from backend.jello.Allocate;
import { typeCheckModules, typeCheckProgramWithSyntax } from frontend.semantics.Modules;
import type { Module } from frontend.Loader;
import { loadModules, modulePath } from frontend.Loader;
import type { SourceSpan } from frontend.syntax.Source;
import type { Hir } from frontend.hir.Hir;
import { nodeCount, spanOf, useHir } from frontend.hir.Hir;
import type {
  BasicBlock,
  EnumSchema,
  Native,
  Function,
  Instruction,
  Program,
  Terminator,
  ThrowHandler,
  ValueType,
} from ir.Model;
import { checked, checkedFile, emitted, encoded, legalized, lowered } from compiler.Pipeline;

let insn = fn(op: Op, dst: I32, args: Array<I32>, imm: I32): Instruction {
  instruction(op, dst, args, imm)
};
let none = fn(): Array<I32> { Array.new<I32>(0) };

// IR built by hand, field by field in declaration order, as the tests below read best.
let basicBlock = fn(
  id: I32,
  instructions: Array<Instruction>,
  terminator: Terminator,
  handler: ?ThrowHandler
): BasicBlock {
  { id, instructions, terminator, handler }
};

let irFunction = fn(
  id: I32,
  params: Array<I32>,
  captures: I32,
  registers: Array<ValueType>,
  result: ValueType,
  blocks: Array<BasicBlock>,
  entry: I32
): Function {
  { id, params, captures, registers, result, blocks, entry }
};
let catches = fn(target: I32, payload: I32): ThrowHandler { { target, payload } };

let program = fn(functions: Array<Function>): Program {
  {
    functions,
    bytes: Array.new<Bytes>(0),
    wides: Array.new<I64>(0),
    floats: Array.new<I64>(0),
    atoms: Array.new<Bytes>(0),
    enums: Array.new<EnumSchema>(0),
    globals: Array.new<ValueType>(0),
    natives: Array.new<Native>(0),
  }
};

// The allocated program the emitter encodes, printed.
let printJlo = fn(jlo: Program): Bytes { printIr(allocateProgram(jlo)) };

// The first allocated function: its register count and spill traffic.
let allocated = fn(jlo: Program): Function { allocateProgram(jlo).functions[0] };
let registerCount = fn(function: Function): I32 { function.registers.len() };

let spillCount = fn(function: Function, push: Bool): I32 {
  let count = 0;
  let b = 0;

  while (b < function.blocks.len()) {
    let instructions = function.blocks[b].instructions;
    let i = 0;

    while (i < instructions.len()) {
      let counted = match (instructions[i].op) { SpillPush => push, SpillPop => !push, _ => false };
      if (counted) { count++; }
      i++;
    }
    b++;
  }

  count
};

let modulesOf = fn(path: Bytes): Array<Module> {
  loadModules(path, "", Array.new<Bytes>(0), Array.new<Bytes>(0))
};
let checkFile = fn(path: Bytes): Hir { checkedFile(path, Array.new<Bytes>(0)) };

// The paths of MODULES, in initialisation order.
let initializationOrder = fn(modules: Array<Module>): Array<Bytes> {
  let paths = Array.new<Bytes>(0);
  let i = 0;

  while (i < modules.len()) {
    paths.push(modulePath(modules[i]));
    i++;
  }
  paths
};

// The source span of every node, by node ID.
let spansOf = fn(hir: Hir): Array<SourceSpan> {
  useHir(hir);
  let spans = Array.new<SourceSpan>(0);
  let id = 0;

  while (id < nodeCount()) {
    spans.push(spanOf(id));
    id++;
  }
  spans
};

// Whether SPANS name both the dependency and the entry module of tests/e2e/programs/modules.
let spansBothModules = fn(spans: Array<SourceSpan>): Bool {
  let dependency = false;
  let entry = false;
  let i = 0;

  while (i < spans.len()) {
    if (contains(spans[i].path, "/math/Increment.jello")) { dependency = true; }
    if (contains(spans[i].path, "/modules/main.jello")) { entry = true; }
    i++;
  }
  dependency && entry
};

let testFindsTheCatchAThrowingBlockReaches = fn(t: Test) {
  // Blocks 0 and 2 sit at indexes 1 and 0.
  let indexes = [1, -1, 0];
  let throwing = basicBlock(0, [], Terminator.Throw(0, -1), catches(2, 1));
  let returning = basicBlock(0, [], Terminator.ReturnValue(0), catches(2, 1));
  T.equal(t, blockCatch(throwing, indexes), (0, 1));
  T.equal(t, blockCatch(returning, indexes), (-1, -1));
  T.equal(t, blockCatch(basicBlock(0, [], Terminator.Throw(0, -1), null), indexes), (-1, -1));
};

let testPrintsDeterministicHumanReadableIR = fn(t: Test) {
  let printed = program([irFunction(
    7,
    [0, 1], 0,
    [ValueType.I32, ValueType.I32, ValueType.Bool],
    ValueType.I32,
    [
      basicBlock(0, [insn(Op.Eq, 2, [0, 1], 0)], Terminator.Branch(2, 1, 2), null),
      basicBlock(1, [], Terminator.ReturnValue(0), null),
      basicBlock(2, [], Terminator.ReturnValue(1), null)
    ],
    0
  )]);

  T.equal(t, printIr(printed), "fn @7(%0: i32, %1: i32) -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: bool\n"
    + "  block 0:\n"
    + "    %2 = eq.i32 %0, %1\n"
    + "    branch %2, block 1, block 2\n"
    + "  block 1:\n"
    + "    return %0\n"
    + "  block 2:\n"
    + "    return %1\n"
    + "}\n");
};

let testLowersAParsedBooleanProgramTailToVerifiedIR = fn(t: Test) {
  T.equal(t, printIr(lowered("true")),
    "fn @0() -> bool entry 0 {\n"
    + "  register %0: bool\n"
    + "  block 0:\n"
    + "    %0 = bool true\n"
    + "    return %0\n"
    + "}\n");
  T.equal(t, printIr(lowered("1i32 + 2i32")),
    "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 1\n"
    + "    %1 = i32 2\n"
    + "    %2 = add.wrap.i32 %0, %1\n"
    + "    return %2\n"
    + "}\n");
  T.throws(t, fn() { checked("2147483648i32"); });
  // Unsuffixed literals default to I32.
  T.equal(t, printIr(lowered("1 + 2")),
    printIr(lowered("1i32 + 2i32")));
  T.throws(t, fn() { checked("1i32 + true"); });
};

let testLowersBytesLiteralsAndU8Indexing = fn(t: Test) {
  let hir = checked("\"ABC\"[1i32]");
  T.equal(t, printHir(hir), "program\n"
    + "  bytes.get_u8: i32\n"
    + "    bytes \"ABC\": bytes\n"
    + "    i32 1: i32\n");
  let ir = lowerProgram(hir);
  let printed = printIr(ir);
  T.isTrue(t, contains(printed, "bytes \"ABC\""));
  T.isTrue(t, contains(printed, "bytes.get_u8"));
  T.isTrue(t, verifyProgram(ir));
};

let testPrintsDeterministicTypedHIR = fn(t: Test) {
  let hir = checked("1i32 + 2i32 + 3i32");
  T.equal(t, printHir(hir), "program\n"
    + "  add.wrap: i32\n"
    + "    add.wrap: i32\n"
    + "      i32 1: i32\n"
    + "      i32 2: i32\n"
    + "    i32 3: i32\n");
};

let testGivesEveryHIRNodeTheSpanOfTheSyntaxItWasCheckedFrom = fn(t: Test) {
  let spans = spansOf(checked("1i32 + 2i32"));
  // Two literals, the addition, the program block and the program.
  T.equal(t, spans.len(), 5);
  let i = 0;

  while (i < spans.len()) {
    T.equal(t, spans[i].path, "<input>");
    i++;
  }
  T.equal(t, spans[0].start, 0);
  T.equal(t, spans[0].end, 4);
  T.equal(t, spans[1].start, 7);
  T.equal(t, spans[1].end, 11);
  T.equal(t, spans[2].start, 0);
  T.equal(t, spans[2].end, 11);

  T.isTrue(t, spansBothModules(spansOf(checkFile("tests/e2e/programs/modules/main.jello"))));
};

let testKeepsSourceSpansWithExplicitFrontendResults = fn(t: Test) {
  let (tokens, path, starts, ends) = lexFile("1i32 + 2i32", "first.jello");
  let program = parseProgram((tokens, path, starts, ends));
  let syntax = programSyntax(program);
  parseProgram(lexFile("true", "second.jello"));
  let spans = spansOf(typeCheckProgramWithSyntax(program, syntax));
  let i = 0;

  while (i < spans.len()) {
    T.equal(t, spans[i].path, "first.jello");
    i++;
  }

  takeInternalError();
  T.throws(t, fn() { parseProgram((tokens, path, Array.new<I32>(0), Array.new<I32>(0))); });
  T.isTrue(t, takeInternalError());

  let loaded = modulesOf("tests/e2e/programs/modules/main.jello");
  parseProgram(lexFile("false", "third.jello"));
  T.isTrue(t, spansBothModules(spansOf(typeCheckModules(loaded))));
};

let testLoadsOrdinaryLetDeclarationsWithTheirSyntax = fn(t: Test) {
  let path = "tests/e2e/programs/core.jello";
  let hir = checkFile(path);
  T.isTrue(t, Bytes.len(emitted(hir)) > 64);
};

let testLoadsAComparisonTailWithItsSyntax = fn(t: Test) {
  let path = "tests/e2e/programs/greater-i32.jello";
  let hir = checkFile(path);
  T.isTrue(t, Bytes.len(emitted(hir)) > 64);
};

let testChecksLenGetAndSetOnArrayOfI32 = fn(t: Test) {
  let source = "let values = Array.new<I32>(2i32); values[0i32] = 39i32; "
    + "values[0i32] + values.len() + 1i32";
  let hir = checked(source);
  let printed = printHir(hir);
  T.isTrue(t, contains(printed, "array.set: i32"));
  T.isTrue(t, contains(printed, "array.get: i32"));
  T.isTrue(t, contains(printed, "array.len"));
  T.isTrue(t, verifyProgram(lowerProgram(hir)));
};

let testLowersAPairOfI32LiteralAndItsFixedFields = fn(t: Test) {
  let source = "let pair = (19i32, 23i32); pair.0 + pair.1";
  let hir = checked(source);
  T.isTrue(t, contains(printHir(hir), "tuple: tuple<i32, i32>"));
  let ir = lowerProgram(hir);
  let printed = printIr(ir);
  T.isTrue(t, contains(printed, "tuple %"));
  T.isTrue(t, contains(printed, "tuple.get"));
  T.isTrue(t, verifyProgram(ir));
  T.isTrue(t, Bytes.len(encoded(legalizeJlo(ir))) > 128);
};

let testPreservesExactSpansThroughFunctionsAssignmentsBranchesAndLoops = fn(t: Test) {
  let source = "let f = fn(flag: Bool): I32 { let value = 1i32; "
    + "while (flag) { value += 2i32; break; } return value; }; f(false)";
  let lexed = lexFile(source, "spans.jello");
  let path = lexed.1;
  let program = parseProgram(lexed);
  let spans = spansOf(typeCheckProgramWithSyntax(program, programSyntax(program)));
  let sawTarget = false;
  let sawAssignment = 0;
  let i = 0;

  while (i < spans.len()) {
    T.equal(t, spans[i].path, path);
    T.isTrue(t, spans[i].end > spans[i].start);
    // `value += 2i32`: the assignment and its addition span it all; the local read is `value`.
    if ((spans[i].start == 63) && (spans[i].end == 68)) { sawTarget = true; }
    if ((spans[i].start == 63) && (spans[i].end == 76)) { sawAssignment++; }
    i++;
  }
  T.isTrue(t, sawTarget);
  T.equal(t, sawAssignment, 2);
};

let testResolvesALocalBindingOnceByStableIdentity = fn(t: Test) {
  let hir = checked("{ let x = 1i32; x + x }");
  T.equal(t, printHir(hir), "program\n"
    + "  block: i32\n"
    + "    let %0 x: i32\n"
    + "      i32 1: i32\n"
    + "    add.wrap: i32\n"
    + "      local %0: i32\n"
    + "      local %0: i32\n");
  T.equal(t, printIr(lowerProgram(hir)), "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 1\n"
    + "    %1 = move %0\n"
    + "    %2 = add.wrap.i32 %1, %1\n"
    + "    return %2\n"
    + "}\n");
  T.throws(t, fn() { checked("missing"); });
  T.throws(t, fn() { checked("let x = x; x"); });
};

let testScopesBlockBindingsAndPermitsNestedShadowing = fn(t: Test) {
  let hir = checked(
    "{ let x = 1i32; ({ let x = x + 1i32; ({ let y = x + 1i32; y }) + x }) + x }"
  );
  T.equal(t, printHir(hir), "program\n"
    + "  block: i32\n"
    + "    let %0 x: i32\n"
    + "      i32 1: i32\n"
    + "    add.wrap: i32\n"
    + "      block: i32\n"
    + "        let %1 x: i32\n"
    + "          add.wrap: i32\n"
    + "            local %0: i32\n"
    + "            i32 1: i32\n"
    + "        add.wrap: i32\n"
    + "          block: i32\n"
    + "            let %2 y: i32\n"
    + "              add.wrap: i32\n"
    + "                local %1: i32\n"
    + "                i32 1: i32\n"
    + "            local %2: i32\n"
    + "          local %1: i32\n"
    + "      local %0: i32\n");
  T.equal(t, printIr(lowerProgram(hir)), "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  register %3: i32\n"
    + "  register %4: i32\n"
    + "  register %5: i32\n"
    + "  register %6: i32\n"
    + "  register %7: i32\n"
    + "  register %8: i32\n"
    + "  register %9: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 1\n"
    + "    %1 = move %0\n"
    + "    %2 = i32 1\n"
    + "    %3 = add.wrap.i32 %1, %2\n"
    + "    %4 = move %3\n"
    + "    %5 = i32 1\n"
    + "    %6 = add.wrap.i32 %4, %5\n"
    + "    %7 = move %6\n"
    + "    %8 = add.wrap.i32 %7, %4\n"
    + "    %9 = add.wrap.i32 %8, %1\n"
    + "    return %9\n"
    + "}\n");
  T.throws(t, fn() { checked("let x = 1i32; let x = 2i32; x"); });
  T.throws(t, fn() { checked("{ let x = 1i32; let x = 2i32; x }"); });
  T.throws(t, fn() { checked("{ let x = 1i32; x }; x"); });
};

let testLowersExpressionValuedIfThroughATypedJoin = fn(t: Test) {
  let hir = checked("if (1i32 < 2i32) { 1i32 } else { 2i32 }");
  T.equal(t, printHir(hir), "program\n"
    + "  if: i32\n"
    + "    condition\n"
    + "      lt.s.i32: bool\n"
    + "        i32 1: i32\n"
    + "        i32 2: i32\n"
    + "    then\n"
    + "      block: i32\n"
    + "        i32 1: i32\n"
    + "    else\n"
    + "      block: i32\n"
    + "        i32 2: i32\n");
  T.equal(t, printIr(lowerProgram(hir)), "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  register %3: bool\n"
    + "  register %4: i32\n"
    + "  register %5: i32\n"
    + "  block 0:\n"
    + "    %1 = i32 1\n"
    + "    %2 = i32 2\n"
    + "    %3 = lt.s.i32 %1, %2\n"
    + "    branch %3, block 2, block 3\n"
    + "  block 2:\n"
    + "    %4 = i32 1\n"
    + "    %0 = move %4\n"
    + "    jump block 1\n"
    + "  block 3:\n"
    + "    %5 = i32 2\n"
    + "    %0 = move %5\n"
    + "    jump block 1\n"
    + "  block 1:\n"
    + "    return %0\n"
    + "}\n");
  T.isTrue(t, verifyProgram(lowered(
    "if (true) { if (false) { 1i32 } else { 2i32 } } else { 3i32 }"
  )));
  T.throws(t, fn() { checked("if (1i32) { 2i32 } else { 3i32 }"); });
  T.throws(t, fn() { checked("if (true) { 1i32 } else { false }"); });
  T.throws(t, fn() { checked("if (true) { 1i32 }"); });
};

let testLowersTypedDirectFunctionsAndLeftToRightCalls = fn(t: Test) {
  let hir = checked(
    "let add = fn(left: I32, right: I32): I32 { left + right }; add(1i32, 2i32)"
  );
  T.equal(t, printHir(hir), "program\n"
    + "  fn @1 add(%0 left: i32, %1 right: i32) -> i32\n"
    + "    tail\n"
    + "      add.wrap: i32\n"
    + "        local %0: i32\n"
    + "        local %1: i32\n"
    + "  call @1: i32\n"
    + "    i32 1: i32\n"
    + "    i32 2: i32\n");
  T.equal(t, printIr(lowerProgram(hir)), "fn @1(%0: i32, %1: i32) -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  block 0:\n"
    + "    %2 = add.wrap.i32 %0, %1\n"
    + "    return %2\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 1\n"
    + "    %1 = i32 2\n"
    + "    %2 = call @1(%0, %1)\n"
    + "    return %2\n"
    + "}\n");
  T.throws(t, fn() { checked(
    "let f = fn(x: I32): I32 { x }; f()"
  );
  });
  T.throws(t, fn() { checked(
    "let f = fn(x: I32): I32 { x }; f(true)"
  );
  });
  T.throws(t, fn() { checked(
    "let f = fn(x): I32 { 1i32 }; f(1i32)"
  );
  });
  T.throws(t, fn() { checked(
    "let f = fn(x: I32): Bool { x }; f(1i32)"
  );
  });
};

let testResolvesDirectRecursiveCallsFromCollectedSignatures = fn(t: Test) {
  let source = "let factorial = fn(value: I32): I32 { "
    + "if (value < 2i32) { 1i32 } else { value * factorial(value - 1i32) } }; factorial(5i32)";
  let hir = checked(source);
  let printedHir = printHir(hir);
  T.isTrue(t, contains(printedHir, "fn @1 factorial"));
  T.isTrue(t, contains(printedHir, "call @1: i32"));
  let ir = printIr(lowerProgram(hir));
  T.isTrue(t, contains(ir, "fn @1"));
  T.isTrue(t, indexOf(ir, "call @1") > indexOf(ir, "fn @1"));
  T.isTrue(t, verifyProgram(lowerProgram(hir)));
  T.throws(t, fn() { checked(
    "let bad = fn(value: I32): I32 { bad(true) }; bad(1i32)"
  );
  });
};

let testLowersExactNoncapturingFunctionValuesAndIndirectCalls = fn(t: Test) {
  let source = "let increment = fn(value: I32): I32 { value + 1i32 }; "
    + "let decrement = fn(value: I32): I32 { value - 1i32 }; "
    + "let operation: (I32) -> I32 = increment; operation = decrement; operation(43i32)";
  let hir = checked(source);
  let program = lowerProgram(hir);
  let ir = printIr(program);
  T.isTrue(t, contains(ir, "function @1"));
  T.isTrue(t, contains(ir, "call %"));
  let legalizedProgram = legalizeJlo(program);
  let jlo = printJlo(legalizedProgram);
  T.isTrue(t, contains(jlo, "= function @1"));
  T.isTrue(t, contains(jlo, "= call %"));
  T.isTrue(t, Bytes.len(encoded(legalizedProgram)) > 128);
  T.isTrue(t, verifyProgram(lowered(
    "let factorial = fn(value: I32): I32 { "
    + "if (value < 2i32) { 1i32 } else { value * factorial(value - 1i32) } }; factorial(5i32)"
  )));
};

let testLowersTypedI32EqualityForChangingLoopConditions = fn(t: Test) {
  let hir = checked(
    "let count = fn(limit: I32): I32 { let value = 0i32; "
    + "while (value == limit) { value = value + 1i32; } value }; count(0i32)"
  );
  T.equal(t, printHir(hir), "program\n"
    + "  fn @1 count(%0 limit: i32) -> i32\n"
    + "    let %1 value: i32\n"
    + "      i32 0: i32\n"
    + "    while\n"
    + "      condition\n"
    + "        eq.i32: bool\n"
    + "          local %1: i32\n"
    + "          local %0: i32\n"
    + "      body\n"
    + "        expression\n"
    + "          assign %1: i32\n"
    + "            add.wrap: i32\n"
    + "              local %1: i32\n"
    + "              i32 1: i32\n"
    + "    tail\n"
    + "      local %1: i32\n"
    + "  call @1: i32\n"
    + "    i32 0: i32\n");
  T.equal(t, printIr(lowerProgram(hir)), "fn @1(%0: i32) -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  register %3: bool\n"
    + "  register %4: i32\n"
    + "  register %5: i32\n"
    + "  block 0:\n"
    + "    %1 = i32 0\n"
    + "    %2 = move %1\n"
    + "    jump block 1\n"
    + "  block 1:\n"
    + "    %3 = eq.i32 %2, %0\n"
    + "    branch %3, block 2, block 3\n"
    + "  block 2:\n"
    + "    %4 = i32 1\n"
    + "    %5 = add.wrap.i32 %2, %4\n"
    + "    %2 = move %5\n"
    + "    jump block 1\n"
    + "  block 3:\n"
    + "    return %2\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 0\n"
    + "    %1 = call @1(%0)\n"
    + "    return %1\n"
    + "}\n");
  T.equal(t, printHir(checked("true != false")), "program\n"
    + "  not.bool: bool\n"
    + "    eq.bool: bool\n"
    + "      bool true: bool\n"
    + "      bool false: bool\n");
  T.throws(t, fn() { checked("1i32 == true"); });
};

let testLowersWrappingI32SubtractionLeftToRight = fn(t: Test) {
  let hir = checked(
    "let decrement = fn(value: I32): I32 { value - 1i32 }; decrement(0i32)"
  );
  T.equal(t, printHir(hir), "program\n"
    + "  fn @1 decrement(%0 value: i32) -> i32\n"
    + "    tail\n"
    + "      sub.wrap: i32\n"
    + "        local %0: i32\n"
    + "        i32 1: i32\n"
    + "  call @1: i32\n"
    + "    i32 0: i32\n");
  T.equal(t, printIr(lowerProgram(hir)), "fn @1(%0: i32) -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  block 0:\n"
    + "    %1 = i32 1\n"
    + "    %2 = sub.wrap.i32 %0, %1\n"
    + "    return %2\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 0\n"
    + "    %1 = call @1(%0)\n"
    + "    return %1\n"
    + "}\n");
  T.isTrue(t, verifyProgram(lowered(
    "let count = fn(start: I32): I32 { let value = start; "
    + "while (value == start) { value = value - 1i32; } value }; count(2i32)"
  )));
  T.throws(t, fn() { checked("true - false"); });
  T.throws(t, fn() { checked("1i32 - true"); });
};

let testDesugarsI32CompoundAssignmentThroughExistingOperations = fn(t: Test) {
  let hir = checked(
    "let update = fn(value: I32): I32 { let result = value; "
    + "result += 2i32; result -= 1i32; result }; update(3i32)"
  );
  T.equal(t, printHir(hir), "program\n"
    + "  fn @1 update(%0 value: i32) -> i32\n"
    + "    let %1 result: i32\n"
    + "      local %0: i32\n"
    + "    expression\n"
    + "      assign %1: i32\n"
    + "        add.wrap: i32\n"
    + "          local %1: i32\n"
    + "          i32 2: i32\n"
    + "    expression\n"
    + "      assign %1: i32\n"
    + "        sub.wrap: i32\n"
    + "          local %1: i32\n"
    + "          i32 1: i32\n"
    + "    tail\n"
    + "      local %1: i32\n"
    + "  call @1: i32\n"
    + "    i32 3: i32\n");
  T.equal(t, printIr(lowerProgram(hir)), "fn @1(%0: i32) -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  register %3: i32\n"
    + "  register %4: i32\n"
    + "  register %5: i32\n"
    + "  block 0:\n"
    + "    %1 = move %0\n"
    + "    %2 = i32 2\n"
    + "    %3 = add.wrap.i32 %1, %2\n"
    + "    %1 = move %3\n"
    + "    %4 = i32 1\n"
    + "    %5 = sub.wrap.i32 %1, %4\n"
    + "    %1 = move %5\n"
    + "    return %1\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 3\n"
    + "    %1 = call @1(%0)\n"
    + "    return %1\n"
    + "}\n");
  T.throws(t, fn() { checked(
    "let f = fn(): Bool { let value = true; value += false; value }; f()"
  );
  });
  T.throws(t, fn() { checked(
    "let f = fn(): I32 { const value = 1i32; value += 1i32; value }; f()"
  );
  });
  T.isTrue(t, verifyProgram(lowered(
    "let f = fn(): I32 { let value = 7i32; value *= 2i32; value /= 3i32; value }; f()"
  )));
  T.isTrue(t, verifyProgram(lowered(
    "let f = fn(source: I32): I32 { let copy = source; copy += 1i32; source }; f(7i32)"
  )));
};

let testLowersSignedI32LessThanForBoundedLoops = fn(t: Test) {
  let hir = checked(
    "let count = fn(limit: I32): I32 { let value = 0i32; "
    + "while (value < limit) { value += 1i32; } value }; count(3i32)"
  );
  T.equal(t, printHir(hir), "program\n"
    + "  fn @1 count(%0 limit: i32) -> i32\n"
    + "    let %1 value: i32\n"
    + "      i32 0: i32\n"
    + "    while\n"
    + "      condition\n"
    + "        lt.s.i32: bool\n"
    + "          local %1: i32\n"
    + "          local %0: i32\n"
    + "      body\n"
    + "        expression\n"
    + "          assign %1: i32\n"
    + "            add.wrap: i32\n"
    + "              local %1: i32\n"
    + "              i32 1: i32\n"
    + "    tail\n"
    + "      local %1: i32\n"
    + "  call @1: i32\n"
    + "    i32 3: i32\n");
  T.equal(t, printIr(lowerProgram(hir)), "fn @1(%0: i32) -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  register %3: bool\n"
    + "  register %4: i32\n"
    + "  register %5: i32\n"
    + "  block 0:\n"
    + "    %1 = i32 0\n"
    + "    %2 = move %1\n"
    + "    jump block 1\n"
    + "  block 1:\n"
    + "    %3 = lt.s.i32 %2, %0\n"
    + "    branch %3, block 2, block 3\n"
    + "  block 2:\n"
    + "    %4 = i32 1\n"
    + "    %5 = add.wrap.i32 %2, %4\n"
    + "    %2 = move %5\n"
    + "    jump block 1\n"
    + "  block 3:\n"
    + "    return %2\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 3\n"
    + "    %1 = call @1(%0)\n"
    + "    return %1\n"
    + "}\n");
  T.throws(t, fn() { checked("true < false"); });
  T.throws(t, fn() { checked("1i32 < true"); });
};

let testLegalizesTheExecutableCFGSubsetToJLOOperations = fn(t: Test) {
  let jlo = legalized(
    "let count = fn(limit: I32): I32 { let value = 0i32; "
    + "while (value < limit) { value += 1i32; } value }; count(2i32)"
  );
  let bytes = encoded(jlo);
  T.equal(t, Bytes.get_u8(bytes, 0), "B".code);
  T.equal(t, Bytes.get_u8(bytes, 1), "Y".code);
  T.equal(t, Bytes.get_u8(bytes, 2), "L".code);
  T.equal(t, Bytes.get_u8(bytes, 3), "J".code);
  T.equal(t, encoded(jlo), bytes);
  // Allocation coalesces the loop variable and the call argument into its
  // window, so no move is left; the step is an immediate add.
  T.equal(t, printJlo(jlo), "fn @1(%0: i32) -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: bool\n"
    + "  block 0:\n"
    + "    %1 = i32 0\n"
    + "    jump block 1\n"
    + "  block 1:\n"
    + "    %2 = lt.s.i32 %1, %0\n"
    + "    branch %2, block 2, block 3\n"
    + "  block 2:\n"
    + "    %1 = add.wrap.i32 %1, 1\n"
    + "    jump block 1\n"
    + "  block 3:\n"
    + "    return %1\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 2\n"
    + "    %0 = call @1(%0)\n"
    + "    return %0\n"
    + "}\n");
  let throwing = legalized(
    "let fail = fn(value: I32): I32 { throw value; }; fail(1i32)"
  );
  let printedThrowing = printJlo(throwing);
  T.isTrue(t, contains(printedThrowing, "= box %0"));
  T.isTrue(t, contains(printedThrowing, "throw %1"));
  T.isTrue(t, Bytes.len(encoded(throwing)) > 64);
};

let testCarriesADeduplicatedBytesPoolThroughSelectedJLO = fn(t: Test) {
  let jlo = legalized("\"A\"[0i32] + \"A\"[0i32]");
  T.equal(t, jlo.bytes, ["A"]);
  T.isTrue(t, contains(printJlo(jlo), "bytes \"A\""));
  T.isTrue(t, Bytes.len(encoded(jlo)) > 0);
};

let testReusesOneCallScratchWindow = fn(t: Test) {
  let caller = irFunction(
    0,
    [], 0,
    [ValueType.I32, ValueType.I32, ValueType.I32],
    ValueType.I32,
    [basicBlock(0, [
      insn(Op.ConstI32, 0, none(), 1),
      insn(Op.Call, 1, [0], 1),
      insn(Op.Call, 2, [1], 1)
    ], Terminator.ReturnValue(2), null)],
    0
  );
  let callee = irFunction(
    1,
    [0], 0,
    [ValueType.I32],
    ValueType.I32,
    [basicBlock(0, [], Terminator.ReturnValue(0), null)],
    0
  );
  // The constant is computed in the window, and both calls share it.
  T.equal(t, registerCount(allocated(program([caller, callee]))), 1);
};

let testAllocatesCompatibleScratchWindowsForMixedCallSignatures = fn(t: Test) {
  let caller = irFunction(
    0, [], 0, [ValueType.Bool, ValueType.Bool, ValueType.I32, ValueType.I32], ValueType.I32,
    [basicBlock(0, [
      insn(Op.ConstBool, 0, none(), 1),
      insn(Op.Call, 1, [0], 1),
      insn(Op.ConstI32, 2, none(), 7),
      insn(Op.Call, 3, [2], 2)
    ], Terminator.ReturnValue(3), null)], 0
  );
  let boolCallee = irFunction(
    1, [0], 0, [ValueType.Bool], ValueType.Bool,
    [basicBlock(0, [], Terminator.ReturnValue(0), null)], 0
  );
  let i32Callee = irFunction(
    2, [0], 0, [ValueType.I32], ValueType.I32,
    [basicBlock(0, [], Terminator.ReturnValue(0), null)], 0
  );
  T.isTrue(t, contains(printJlo(program([caller, boolCallee, i32Callee])), "call @2(%"));
};

let testAllocatesMoreThan256ShortLivedVirtualRegisters = fn(t: Test) {
  let registers = Array.new<ValueType>(0);
  let instructions = Array.new<Instruction>(0);
  let i = 0;

  while (i < 300) {
    registers.push(ValueType.I32);
    instructions.push(insn(Op.ConstI32, i, none(), i));
    i++;
  }
  T.equal(t, registerCount(allocated(program([irFunction(
    0, [], 0, registers, ValueType.I32,
    [basicBlock(0, instructions, Terminator.ReturnValue(299), null)], 0
  )]))), 1);
};

let testSpillsTrulySimultaneousRegisterPressure = fn(t: Test) {
  let registers = Array.new<ValueType>(0);
  let instructions = Array.new<Instruction>(0);
  let i = 0;
  // 300 constants stay live until the running sum reads them, exceeding 256 registers.
  let count = 300;

  while (i < count) {
    registers.push(ValueType.I32);
    instructions.push(insn(Op.ConstI32, i, none(), i));
    i++;
  }
  let result = count - 1;
  i = 1;

  while (i < count) {
    registers.push(ValueType.I32);
    result = registers.len() - 1;
    instructions.push(insn(Op.Add, result, [result - 1, i], 0));
    i++;
  }
  let function = allocated(program([irFunction(
    0, [], 0, registers, ValueType.I32,
    [basicBlock(0, instructions, Terminator.ReturnValue(result), null)], 0
  )]));
  T.isTrue(t, spillCount(function, true) > 0);
  T.isTrue(t, spillCount(function, false) > 0);
  T.isTrue(t, registerCount(function) <= 256);
};

let testAllocatesThousandsOfInstructionsAcrossJoins = fn(t: Test) {
  // Chains split by diamonds every 200 values; every 50th value stays live to the end.
  let count = 4000;
  let registers: Array<ValueType> = [ValueType.Bool, ValueType.I32];
  let blocks = Array.new<BasicBlock>(0);
  let current = [insn(Op.ConstBool, 0, none(), 1), insn(Op.ConstI32, 1, none(), 1)];
  let kept = Array.new<I32>(0);
  let block = 0;
  let i = 2;

  while (i < count) {
    registers.push(ValueType.I32);
    current.push(insn(Op.Add, i, [i - 1, i - 1], 0));
    if (i % 50 == 0) { kept.push(i); }

    if (i % 200 == 0) {
      blocks.push(basicBlock(block, current, Terminator.Branch(0, block + 1, block + 2), null));
      blocks.push(basicBlock(block + 1, [], Terminator.Jump(block + 3), null));
      blocks.push(basicBlock(block + 2, [], Terminator.Jump(block + 3), null));
      block += 3;
      current = Array.new<Instruction>(0);
    }
    i++;
  }
  let sum = count - 1;
  i = 0;

  while (i < kept.len()) {
    registers.push(ValueType.I32);
    current.push(insn(Op.Add, registers.len() - 1, [sum, kept[i]], 0));
    sum = registers.len() - 1;
    i++;
  }
  blocks.push(basicBlock(block, current, Terminator.ReturnValue(sum), null));
  let function = allocated(program([irFunction(0, [], 0, registers, ValueType.I32, blocks, 0)]));
  T.isTrue(t, registerCount(function) < 100);
  T.equal(t, spillCount(function, true), 0);
};

let testVerifiesAllocatedCodeAgainstTheProgram = fn(t: Test) {
  // A call whose argument does not match the callee is caught after allocation too.
  let caller = irFunction(
    0, [], 0, [ValueType.Bool, ValueType.I32], ValueType.I32,
    [basicBlock(
      0,
      [insn(Op.ConstBool, 0, none(), 1), insn(Op.Call, 1, [0], 1)],
      Terminator.ReturnValue(1),
      null
    )],
    0
  );
  let callee = irFunction(
    1, [0], 0, [ValueType.I32], ValueType.I32,
    [basicBlock(0, [], Terminator.ReturnValue(0), null)], 0
  );
  T.throws(t, fn() { allocateProgram(program([caller, callee])); });
};

let testLoadsNamedDirectFunctionImportsAsOneTypedProgram = fn(t: Test) {
  let hir = checkFile("tests/e2e/programs/modules/main.jello");
  T.isTrue(t, Bytes.len(emitted(hir)) > 64);
};

let testInitializesImportedPrimitiveConstantsBeforeTheEntryTail = fn(t: Test) {
  let path = "tests/e2e/programs/module-constants/main.jello";
  let modules = modulesOf(path);
  let hir = typeCheckModules(modules);
  let initialization = initializationOrder(modules);
  T.equal(t, initialization.len(), 2);
  T.isTrue(t, contains(initialization[0], "/math/Constants.jello"));
  T.equal(t, initialization[1], path);
  // Imported constants are immutable globals, initialised in module order.
  T.equal(t, printIr(lowerProgram(hir)), "global g0: i32\n"
    + "global g1: i32\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  register %3: i32\n"
    + "  register %4: i32\n"
    + "  register %5: i32\n"
    + "  register %6: i32\n"
    + "  register %7: i32\n"
    + "  register %8: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 40\n"
    + "    global.set g0, %0\n"
    + "    %1 = i32 16\n"
    + "    %2 = i32 19\n"
    + "    %3 = sub.wrap.i32 %1, %2\n"
    + "    global.set g1, %3\n"
    + "    %4 = global.get g0\n"
    + "    %5 = global.get g1\n"
    + "    %6 = add.wrap.i32 %4, %5\n"
    + "    %7 = i32 5\n"
    + "    %8 = add.wrap.i32 %6, %7\n"
    + "    return %8\n"
    + "}\n");
};

