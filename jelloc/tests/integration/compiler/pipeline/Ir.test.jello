let testInitializesModuleDiamondsDependencyFirstExactlyOnce = fn(t: Test) {
  let path = "tests/e2e/programs/module-init/main.jello";
  let modules = modulesOf(path);
  let hir = typeCheckModules(modules);
  let initialization = initializationOrder(modules);
  T.equal(t, initialization.len(), 4);
  T.isTrue(t, contains(initialization[0], "/values/Base.jello"));
  T.isTrue(t, contains(initialization[1], "/values/Left.jello"));
  T.isTrue(t, contains(initialization[2], "/values/Right.jello"));
