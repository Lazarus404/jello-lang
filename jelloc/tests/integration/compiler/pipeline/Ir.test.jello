let testLoadsTransitiveDirectFunctionsDependencyFirstAndRejectsCycles = fn(t: Test) {
  let hir = checkFile("tests/e2e/programs/transitive/main.jello");
  let ir = printIr(lowerProgram(hir));
  T.isTrue(t, contains(ir, "fn @1"));
  T.isTrue(t, indexOf(ir, "fn @2") > indexOf(ir, "fn @1"));
  T.throws(t, fn() { modulesOf("tests/e2e/programs/cycle/main.jello"); });
};

let testCanonicalizesAliasesAcrossADiamondImportGraph = fn(t: Test) {
  let hir = checkFile("tests/e2e/programs/alias-diamond/main.jello");
  T.isTrue(t, Bytes.len(emitted(hir)) > 64);
};

let testLowersSignedI32GreaterThanBySwappingLessThanOperands = fn(t: Test) {
  let hir = checked("if (2i32 > 1i32) { 1i32 } else { 0i32 }");
  T.isTrue(t, contains(printIr(lowerProgram(hir)), "lt.s.i32 %2, %1"));
  let effectful = printIr(lowered(
    "let first = fn(): I32 { 2i32 }; let second = fn(): I32 { 1i32 }; "
    + "if (first() > second()) { 1i32 } else { 0i32 }"
  ));
  T.isTrue(t, indexOf(effectful, "call @1") < indexOf(effectful, "call @2"));
  T.isTrue(t, contains(effectful, "lt.s.i32 %2, %1"));
  T.throws(t, fn() { checked("true > false"); });
};

let testCarriesPrimitivesThroughIRAndJLO = fn(t: Test) {
  let source = "let left = fn(): I32 { 2i32 }; let right = fn(): I32 { 3i32 }; "
    + "let product = left() * -right(); let narrowed = (product as I64) as I32; "
    + "let unequal = narrowed != 0i32; let lower = left() <= right(); "
    + "let higher = left() >= right(); !unequal";
  let program = lowerProgram(checked(source));
  let ir = printIr(program);
  T.isTrue(t, contains(ir, "mul.wrap.i32"));
  T.isTrue(t, contains(ir, "neg.wrap.i32"));
  T.isTrue(t, contains(ir, "sext.i32.i64"));
  T.isTrue(t, contains(ir, "trunc.i64.i32"));
  T.throws(t, fn() { checked("true as I64"); });
  T.throws(t, fn() { checked("1i32 as Bool"); });
  T.isTrue(t, indexOf(ir, "call @1") < indexOf(ir, "call @2"));
  let jlo = legalizeJlo(program);
  let printed = printJlo(jlo);
  T.isTrue(t, contains(printed, "mul.wrap.i32"));
  T.isTrue(t, contains(printed, "neg.wrap.i32"));
  T.isTrue(t, contains(printed, "not.bool"));
  T.isTrue(t, contains(printed, "sext.i32.i64"));
  T.isTrue(t, contains(printed, "trunc.i64.i32"));
  T.isTrue(t, Bytes.len(encoded(jlo)) > 64);
};

let testAcceptsOnlyInRangeSignedI32LiteralForms = fn(t: Test) {
  T.isTrue(t, contains(printIr(lowered("-2147483648i32")), "i32 -2147483648"));
  T.throws(t, fn() { checked("2147483648i32"); });
  T.throws(t, fn() { checked("-2147483649i32"); });
  T.throws(t, fn() { checked("-true"); });
  T.throws(t, fn() { checked("!1i32"); });
};
