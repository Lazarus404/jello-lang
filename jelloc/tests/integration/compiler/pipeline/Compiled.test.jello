package compiler.pipeline;

// What the compiler makes of whole programs, in process, where their output
// cannot show it: the catch regions and boxes of the allocated program, the
// unwraps narrowing makes unchecked, the namespace twins, the strings a
// passing assertion does not build, and dense spill slots.

import type { Test } from std.testing;
import std.testing as T;
import { contains, startsWith } from std.core.Bytes;
import type { Hir } from frontend.hir.Hir;
import frontend.hir.Hir as H;
import { printHir } from frontend.hir.Print;
import type { BasicBlock, Instruction, Program } from ir.Model;
import { Op } from ir.Model;
import { allocatedFile, checkedFile, checkedTests, jloOf } from compiler.Pipeline;
import { PROGRAMS } from compiler.Corpus;

const _NONE = Array.new<Bytes>(0);

// The blocks of PROGRAM's functions.
let _blocks = fn(program: Program): Array<BasicBlock> {
  let all = Array.new<BasicBlock>(0);
  let f = 0;

  while (f < program.functions.len()) {
    all.appendFrom(program.functions[f].blocks, 0);
    f++;
  }

  all
};

// The instructions of PROGRAM's blocks.
let _instructions = fn(program: Program): Array<Instruction> {
  let blocks = _blocks(program);
  let all = Array.new<Instruction>(0);
  let b = 0;

  while (b < blocks.len()) {
    all.appendFrom(blocks[b].instructions, 0);
    b++;
  }

  all
};

// The blocks of PROGRAM in a catch region, and its boxes.
let _regionsAndBoxes = fn(program: Program): Tuple<I32, I32> {
  let caught = _blocks(program).filter(fn(block) { block.handler != null }).len();
  let boxes = _instructions(program).filter(fn(insn) { insn.op == Op.Box }).len();

  (caught, boxes)
};

// Catch regions: a body that cannot throw opens no region, and a rethrown
// value is not boxed again.
let testCatchRegions = fn(t: Test) {
  let (caught, _) = _regionsAndBoxes(allocatedFile(PROGRAMS + "/catch/no-region.jello", _NONE));
  T.equal(t, caught, 0);
  let (regions, boxes) = _regionsAndBoxes(allocatedFile(PROGRAMS + "/catch/uncaught.jello", _NONE));
  T.equal(t, (regions > 0, boxes), (true, 1));
};

// The nodes reachable in HIR, each with the function it is in (its index
// among the program's functions, or -1 for the program body) and whether it
// is under an if's else.
let _reached = fn(hir: Hir): Array<Tuple<I32, I32, Bool>> {
  H.useHir(hir);
  let root = H.rootNode();
  let pending = Array.new<Tuple<I32, I32, Bool>>(0);
  let reached = Array.new<Tuple<I32, I32, Bool>>(0);
  let i = 0;

  while (i < H.childCount(root)) {
    // The last child is the program body, in no function.
    pending.push((H.childOf(root, i), i < H.childCount(root) - 1 ? i : -1, false));
    i++;
  }

  while (pending.len() > 0) {
    let (id, function, otherwise) = pending.pop();
    reached.push((id, function, otherwise));
    let branches = match (H.opOf(id)) { If, IfStatement => true, _ => false };
    let c = 0;

    while (c < H.childCount(id)) {
      pending.push((H.childOf(id, c), function, otherwise || (branches && (c == 2))));
      c++;
    }
  }
  reached
};

// How many unwraps in HIR are known (narrowed) and how many checked.
let _unwraps = fn(hir: Hir): Tuple<I32, I32> {
  let reached = _reached(hir);
  let known = 0;
  let checked = 0;
  let i = 0;

  while (i < reached.len()) {
    let (id, _, _) = reached[i];

    match (H.opOf(id)) {
      Unwrap => { if (H.valueOf(id) == 1) { checked++; } else { known++; } },
      _ => null,
    };
    i++;
  }
  (known, checked)
};

// Narrowed reads compile to unchecked unwraps: in a try, the reads the body
// cannot change.
let testNarrowedUnwraps = fn(t: Test) {
  T.equal(t, _unwraps(checkedFile(PROGRAMS + "/catch/narrowing/safe.jello", _NONE)), (2, 0));
  T.equal(t, _unwraps(checkedFile(PROGRAMS + "/nullable/narrowing/safe.jello", _NONE)), (3, 0));
};

// Namespace imports: M.x is what `import { x }` gives, so both forms compile
// to the same program.
let testNamespaceTwins = fn(t: Test) {
  let roots = [PROGRAMS + "/namespaces/auxiliary"];
  T.equal(
    t,
    jloOf(PROGRAMS + "/namespaces/qualified.jello", roots),
    jloOf(PROGRAMS + "/namespaces/named.jello", roots)
  );
};

// Whether NAME is a test's: test and a capital, as testXxx.
let _isTest = fn(name: Bytes): Bool {
  startsWith(name, "test")
    && (Bytes.len(name) > 4)
    && (Bytes.get_u8(name, 4) >= 65)
    && (Bytes.get_u8(name, 4) <= 90)
};

// In the tests of HIR, how many strings values become (by the to_string or
// quote native, or a call of a generated string function), and how many of
// those are not under the else of an assertion's if.
let _stringsBuilt = fn(hir: Hir): Tuple<I32, I32> {
  let reached = _reached(hir);
  let root = H.rootNode();
  let strings = 0;
  let passing = 0;
  let i = 0;

  while (i < reached.len()) {
    let (id, function, otherwise) = reached[i];

    let shown = match (H.opOf(id)) {
      CallNative => {
        let name = H.nativeNameOf(H.valueOf(id));
        (H.nativeLibraryOf(H.valueOf(id)) == "std") && ((name == "to_string") || (name == "quote"))
      },
      // call @N is of the program's Nth function.
      Call => H.bytesOf(H.valueOf(H.childOf(root, H.valueOf(id) - 1))) == "string",
      _ => false,
    };

    if (shown && (function >= 0) && _isTest(H.bytesOf(H.valueOf(H.childOf(root, function))))) {
      strings++;
      if (!otherwise) { passing++; }
    }
    i++;
  }
  (strings, passing)
};

// A passing assertion builds no strings: in every test, each string a value
// becomes is under the else of an assertion's if. The failure names the call
// exactly.
let testAssertionsBuildNoStrings = fn(t: Test) {
  let passing = PROGRAMS + "/testing/assert/Passing.test.jello";
  let hir = checkedTests([passing], [PROGRAMS + "/testing/assert"]);
  let (strings, outside) = _stringsBuilt(hir);
  T.equal(t, (strings > 0, outside), (true, 0));
  T.isTrue(t, contains(printHir(hir), "bytes \"" + passing + ":18:3\": bytes"));
};

// Spill slots are dense (0..n-1), since the VM sizes each frame's slot
// array, which the collector scans, by the highest slot used.
let testSpillSlotsAreDense = fn(t: Test) {
  let file = allocatedFile(PROGRAMS + "/registers/spill-pressure.jello", _NONE);
  let instructions = _instructions(file);
  let used = Array.new<Bool>(0);
  let i = 0;

  while (i < instructions.len()) {
    match (instructions[i].op) {
      SpillPush, SpillPop => {
        let slot = instructions[i].imm;
        while (used.len() <= slot) { used.push(false); }
        used[slot] = true;
      },
      _ => null,
    };
    i++;
  }
  let gaps = 0;
  i = 0;

  while (i < used.len()) {
    if (!used[i]) { gaps++; }
    i++;
  }
  T.equal(t, (used.len() > 0, gaps), (true, 0));
};
