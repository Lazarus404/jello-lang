package compiler.pipeline;

import type { Test } from std.testing;
import std.testing as T;
import type { Hir, Kind } from frontend.hir.Hir;
import frontend.hir.Hir as H;
import {
  Op, arrayType, beginHir, bytesId, declareEnum, functionType, hirTypeName, nullType, opOf, tupleType,
  typeName, useHir,
} from frontend.hir.Hir;
import { takeInternalError } from support.Internal;
import type { SyntaxMark } from frontend.syntax.Source;
import { sourceDiagnostic } from frontend.syntax.Source;
import { readText } from std.io.File;
import { failure } from Driver;
import { lexFile } from frontend.syntax.Lexer;
import { parseProgram } from frontend.syntax.Parser;
import { syntaxTree } from frontend.syntax.SyntaxTree;
import { verifyFailureSpan, verifyHir } from frontend.hir.Verify;
import { checked, checkedFile } from compiler.Pipeline;

let opName = fn(op: Op): Bytes {
  match (op) {
    I32 => "I32", Local => "Local", Add => "Add", Call => "Call", If => "If", Let => "Let", Return => "Return",
    Global => "Global", InitGlobal => "InitGlobal", Parameter => "Parameter", Capture => "Capture", Expression => "Expression",
    Try => "Try", _ => "",
  }
};

// The ID of the `nth` node named `name`.
let find = fn(hir: Hir, name: Bytes, nth: I32): I32 {
  useHir(hir);
  let seen = 0;
  let id = 0;

  while (id < H.nodeCount()) {
    if (opName(opOf(id)) == name) {
      if (seen == nth) { return id; }
      seen++;
    }
    id++;
  }
  -1
};

let copy = fn(values: Array<I32>): Array<I32> {
  let result = Array.new<I32>(0);
  let i = 0;

  while (i < values.len()) {
    result.push(values[i]);
    i++;
  }
  result
};

// A copy of `hir` with one node column replaced (0 type, 1 value, 2 aux).
let mutate = fn(hir: Hir, id: I32, column: I32, value: I32): Hir {
  let changed = copy(hir.nodes);
  changed[id * 5 + column] = value;
  { ...hir, nodes: changed }
};

let mutateOp = fn(hir: Hir, id: I32, op: Op): Hir {
  let changed = Array.new<Op>(0);
  let i = 0;

  while (i < hir.ops.len()) {
    changed.push(i == id ? op : hir.ops[i]);
    i++;
  }
  { ...hir, ops: changed }
};

// A copy of `hir` whose child `index` of `parent` is `child`.
let mutateChild = fn(hir: Hir, parent: I32, index: I32, child: I32): Hir {
  let changed = copy(hir.edges);
  changed[hir.nodes[parent * 5 + 3] + index] = child;
  { ...hir, edges: changed }
};

// A copy of `hir` with its span table cut to `count` entries, or with one
// span column replaced (0 path, 1 start, 2 end) when `id` is a node.
let mutateSpans = fn(hir: Hir, count: I32, id: I32, column: I32, value: I32): Hir {
  let changed = Array.new<I32>(0);
  let i = 0;

  while (i < count * 3) {
    changed.push(hir.spans[i]);
    i++;
  }
  if (id >= 0) { changed[id * 3 + column] = value; }
  { ...hir, spans: changed }
};

// A copy of `hir` with field slot `slot` of its field table (name, type) replaced.
let mutateField = fn(hir: Hir, slot: I32, value: I32): Hir {
  let changed = copy(hir.fields);
  changed[slot] = value;
  { ...hir, fields: changed }
};

let rejection = fn(hir: Hir): Bytes {
  try {
    verifyHir(hir);
    "accepted"
  } catch (e) { Std.string(e) }
};

// Where the verifier located its rejection of `hir`: the failing node's span
// start and end, or (-1, -1) when it gave none.
let location = fn(hir: Hir): Tuple<I32, I32> {
  rejection(hir);
  let span = verifyFailureSpan();
  span == null ? (-1, -1) : (span.start, span.end)
};

let SAMPLE = "let twice = fn(f: (I32) -> I32, x: I32): I32 { f(f(x)) };\n"
  + "let inc = fn(x: I32): I32 { x + 1i32 };\n"
  + "let loop = fn(n: I32): I32 { let i = 0i32; while (i < n) { i += 1i32; } return i; };\n"
  + "let pair = (1i32, 2i32);\n"
  + "let xs = Array.new<I32>(2i32);\n"
  + "xs[0i32] = \"A\"[0i32];\n"
  + "let maybe: ?I32 = null;\n"
  + "if (maybe == null) { twice(inc, loop(pair.1) + xs[0i32]) } else { 0i32 }";

let testInterning = fn(t: Test) {
  beginHir();
  let a = arrayType(H.TYPE_I32);
  T.equal(t, arrayType(H.TYPE_I32), a);
  let tu = tupleType([H.TYPE_I32, H.TYPE_BOOL]);
  T.equal(t, tupleType([H.TYPE_I32, H.TYPE_BOOL]), tu);
  T.notEqual(t, tupleType([H.TYPE_BOOL, H.TYPE_I32]), tu);
  let f = functionType([a, tu], nullType(H.TYPE_I32));
  T.equal(t, functionType([a, tu], nullType(H.TYPE_I32)), f);
  T.notEqual(t, functionType([a], nullType(H.TYPE_I32)), f);
  let i = 0;
  let ids = Array.new<I32>(0);

  while (i < 300) {
    ids.push(arrayType(tupleType([H.TYPE_I32, H.TYPE_I32, i < 150 ? H.TYPE_BOOL : H.TYPE_I32])));
    i++;
  }
  T.equal(t, ids[0], ids[149]);
  T.equal(t, ids[150], ids[299]);
  T.notEqual(t, ids[0], ids[150]);
  i = 0;

  while (i < 500) {
    bytesId("n" + Std.string(i));
    i++;
  }
  T.equal(t, bytesId("n42"), bytesId("n42"));
  T.equal(t, H.bytesOf(bytesId("n499")), "n499");
  let e = declareEnum("Color");
  T.notEqual(t, declareEnum("Color"), e);
  T.equal(t, typeName(tu), "Tuple<I32, Bool>");
  T.equal(t, typeName(nullType(a)), "?Array<I32>");
  T.equal(t, hirTypeName(nullType(a)), "?array<i32>");
  // `?` binds to a type atom, so a nullable function type is parenthesized.
  T.equal(t, typeName(nullType(functionType([H.TYPE_I32], H.TYPE_BOOL))), "?((I32) -> Bool)");
  // A parameter `?T` may be omitted; a Null<T> one is spelt so.
  let params = functionType([nullType(H.TYPE_I32), H.optionalType(H.TYPE_I32), H.restType(H.TYPE_BYTES)], H.TYPE_BOOL);
  T.equal(t, typeName(params), "(Null<I32>, ?I32, Bytes...) -> Bool");
  T.equal(t, hirTypeName(params), "(null<i32>, ?i32, bytes...) -> bool");
  T.equal(t, H.slotType(H.optionalType(H.TYPE_I32)), nullType(H.TYPE_I32));
  T.equal(t, H.slotType(H.restType(H.TYPE_BYTES)), arrayType(H.TYPE_BYTES));
  T.equal(t, typeName(e), "Color");
};

let testVerifierAcceptsCheckedPrograms = fn(t: Test) {
  T.equal(t, rejection(checked(SAMPLE)), "accepted");
};

let testVerifierRecomputesTypes = fn(t: Test) {
  let hir = checked(SAMPLE);
  T.equal(t, rejection(mutate(hir, find(hir, "I32", 0), 0, H.TYPE_BOOL)), "invalid HIR: expression type mismatch");
  T.equal(t, rejection(mutate(hir, find(hir, "Call", 0), 1, 1)), "invalid HIR: direct call signature mismatch");
  T.equal(t, rejection(mutateOp(hir, find(hir, "Add", 0), Op.Eq)), "invalid HIR: expression type mismatch");
  T.equal(t, rejection(mutate(hir, find(hir, "If", 0), 0, H.TYPE_BOOL)), "invalid HIR: if operand type");
};

let testVerifierChecksScopesAndMutability = fn(t: Test) {
  let hir = checked(SAMPLE);
  T.equal(t, rejection(mutate(hir, find(hir, "Local", 0), 1, 99)), "invalid HIR: unknown local binding");
  T.equal(t, rejection(mutateOp(hir, find(hir, "Let", 0), Op.Const)), "invalid HIR: assignment to immutable local");
  T.equal(t, rejection(mutate(hir, find(hir, "Let", 0), 1, H.valueOf(find(hir, "Parameter", 3)))), "invalid HIR: binding declared twice");
};

let testVerifierChecksGlobals = fn(t: Test) {
  // pair, xs and maybe are globals 0, 1 and 2; the tail reads maybe.
  let hir = checked(SAMPLE);
  T.equal(t, rejection(mutate(hir, find(hir, "Global", 0), 1, 99)), "invalid HIR: unknown global");
  T.equal(t, rejection(mutate(hir, find(hir, "InitGlobal", 1), 1, 0)), "invalid HIR: global initialized twice");
  T.equal(t, rejection(mutate(hir, find(hir, "InitGlobal", 1), 1, 2)), "invalid HIR: global type mismatch");
};

// Each global is initialised exactly once, in any order: a module's regexps
// come first, whatever their IDs, and InitOrder rejects a read before the
// write.
let testVerifierChecksEachGlobalIsInitializedOnce = fn(t: Test) {
  // a and b are I32 globals 0 and 1.
  let hir = checked("let a = 1i32;\nlet b = 2i32;\na + b\n");
  let first = find(hir, "InitGlobal", 0);
  let second = find(hir, "InitGlobal", 1);
  T.equal(t, rejection(mutate(mutate(hir, first, 1, 1), second, 1, 0)), "accepted");
  T.equal(t, rejection(mutate(hir, second, 1, 0)), "invalid HIR: global initialized twice");
  T.equal(t, rejection(mutateOp(hir, second, Op.Const)), "invalid HIR: global never initialized");
};

let testVerifierChecksClosuresAgainstTheirFunctionsCaptures = fn(t: Test) {
  // fn @1 makes a closure, fn @2, that captures n.
  let hir = checked("let adder = fn(n: I32): () -> I32 { fn() { n } };\nadder(1i32)()");
  T.equal(t, rejection(hir), "accepted");
  T.equal(t, rejection(mutate(hir, find(hir, "Capture", 0), 0, H.TYPE_BOOL)), "invalid HIR: closure capture type mismatch");
  T.equal(t, rejection(mutateOp(hir, find(hir, "Capture", 0), Op.Parameter)), "invalid HIR: parameter type mismatch");
  T.equal(t, rejection(mutate(hir, find(hir, "Call", 0), 1, 2)), "invalid HIR: direct call of a function that captures");
};

let testVerifierRequiresATree = fn(t: Test) {
  let hir = checked(SAMPLE);
  let branch = find(hir, "If", 0);
  useHir(hir);
  T.equal(t, rejection(mutateChild(hir, branch, 2, H.childOf(branch, 1))), "invalid HIR: node referenced twice");
  T.equal(t, rejection(mutateChild(hir, find(hir, "Add", 0), 0, branch)), "invalid HIR: node reference out of order");
};

let testVerifierChecksReturnsAndTries = fn(t: Test) {
  let hir = checked("let f = fn(): I32 { 1i32 };\nlet v = try { f() } catch (e) { 2i32 };\nf();\nv");
  T.equal(t, rejection(hir), "accepted");
  // The program body's `f();`, as a return there.
  T.equal(t, rejection(mutateOp(hir, find(hir, "Expression", 0), Op.Return)), "invalid HIR: return outside a function");
  useHir(hir);
  let body = H.childOf(find(hir, "Try", 0), 0);
  T.equal(t, rejection(mutateOp(hir, body, Op.Expression)), "invalid HIR: expected block");
};

let testVerifierChecksControlFlowAndSourceSpans = fn(t: Test) {
  let hir = checked(SAMPLE);
  T.equal(t, rejection(mutateOp(hir, find(hir, "Return", 0), Op.Break)), "invalid HIR: break outside loop");
  useHir(hir);
  let count = H.nodeCount();
  T.equal(t, rejection(mutateSpans(hir, count, -1, 0, 0)), "accepted");
  T.equal(t, rejection(mutateSpans(hir, count - 1, -1, 0, 0)), "invalid HIR: every node needs a source span");
  T.equal(t, rejection(mutateSpans(hir, count, 3, 0, H.bytesCount())), "invalid HIR: source span without a path");
  T.equal(t, rejection(mutateSpans(hir, count, 3, 2, H.spanStartOf(3))), "invalid HIR: empty source span");
  let add = find(hir, "Add", 0);
  T.equal(t, rejection(mutateSpans(hir, count, add, 2, H.spanEndOf(H.childOf(add, 1)) - 1)), "invalid HIR: child span outside its parent");
};

let testVerifierFailuresAreInternalErrorsAtTheirNode = fn(t: Test) {
  let hir = checked(SAMPLE);

  let at = fn(id: I32): Tuple<I32, I32> {
    useHir(hir);
    (H.spanStartOf(id), H.spanEndOf(id))
  };
  takeInternalError();
  let literal = find(hir, "I32", 0);
  T.equal(t, location(mutate(hir, literal, 0, H.TYPE_BOOL)), at(literal));
  T.equal(t, takeInternalError(), true);
  // A check made after a node's operands is the node's, not its last operand's.
  let branch = find(hir, "If", 0);
  T.equal(t, location(mutate(hir, branch, 0, H.TYPE_BOOL)), at(branch));
  let add = find(hir, "Add", 0);
  let end = H.spanEndOf(H.childOf(add, 1)) - 1;
  T.equal(t, location(mutateSpans(hir, H.nodeCount(), add, 2, end)), (H.spanStartOf(add), end));
  // A failure of the whole program, or at a node without a valid span, has none.
  let globals = checked("let a = 1i32;\nlet b = 2i32;\na + b\n");
  T.equal(t, location(mutateOp(globals, find(globals, "InitGlobal", 1), Op.Const)), (-1, -1));
  useHir(hir);
  T.equal(t, location(mutateSpans(hir, H.nodeCount(), 3, 2, H.spanStartOf(3))), (-1, -1));
  // A program the checker rejects is not a compiler bug.
  takeInternalError();

  try {
    checked("let x: I32 = true;");
    null
  } catch (_e) { null };
  T.equal(t, takeInternalError(), false);
};

let testSyntaxMarksThatDoNotFitAreInternalErrors = fn(t: Test) {
  takeInternalError();
  let program = parseProgram(lexFile("1i32", "<input>"));
  T.equal(t, try {
    syntaxTree(program, "x.jello", Array.new<SyntaxMark>(0));
    "accepted"
  } catch (e) { Std.string(e) }, "syntax marks end before the AST");
  T.equal(t, takeInternalError(), true);
};

// What jelloc says of a failure, caught as Driver catches it: an internal
// error is a compiler bug, located at the node it failed at, with status 3;
// the same failure, not internal, has status 1, after its stage's label.
let testFailuresReportTheirStatus = fn(t: Test) {
  let hir = checkedFile("tests/integration/compiler/pipeline/answer.jello", Array.new<Bytes>(0));
  let literal = find(hir, "I32", 0);
  let span = H.spanOf(literal);
  let error = try { verifyHir(mutate(hir, literal, 0, H.TYPE_BOOL)) as Dynamic } catch (e) { e };
  let located = fn(message: Bytes): Bytes { sourceDiagnostic(span.path, readText(span.path), span.start, message) };
  let message = Std.string(error);
  T.equal(t, failure("PARSER", error), (3, located("internal error: " + message + " (please report this compiler bug)")));
  T.equal(t, failure("PARSER", error), (1, "PARSER\t" + located(message)));
};

let testVerifierRejectsATypeParameterInAnEnumField = fn(t: Test) {
  // E is reached only through g's type, so only the closed-type check reads its field.
  let hir = checked("enum E { A(v: I32); }\nlet id<T> = fn(x: T): T { x };\nlet g: ?E = null;\nid(1)");
  T.equal(t, rejection(hir), "accepted");
  useHir(hir);
  let param = 0;
  while (!H.isKind(param, Kind.Param)) { param++; }
  T.equal(t, rejection(mutateField(hir, 1, param)), "invalid HIR: an enum's field type is not inferred");
};
