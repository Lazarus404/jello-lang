package compiler.pipeline;

import type { Test } from std.testing;
import std.testing as T;
import frontend.hir.Hir as H;
import { arrayType, beginHir, integerVar, isOpen, newVar, nullType, resolve, tupleType, unify } from frontend.hir.Hir;

let testFailedUnifyUnbindsItsVars = fn(t: Test) {
  beginHir();
  let v = newVar(false);
  // The first elements unify, binding v to Bytes, before the second ones fail.
  T.isTrue(t, !unify(tupleType([v, H.TYPE_I32]), tupleType([H.TYPE_BYTES, H.TYPE_BYTES])));
  T.isTrue(t, isOpen(v));
  T.isTrue(t, unify(tupleType([v, H.TYPE_I32]), tupleType([H.TYPE_I64, H.TYPE_I32])));
  T.equal(t, resolve(tupleType([v, H.TYPE_I32])), tupleType([H.TYPE_I64, H.TYPE_I32]));
};

let testOccursCheck = fn(t: Test) {
  beginHir();
  let v = newVar(false);
  T.isTrue(t, !unify(v, arrayType(v)));
  T.isTrue(t, isOpen(v));
};

let testIntegerVar = fn(t: Test) {
  beginHir();
  let v = integerVar();
  T.isTrue(t, !unify(v, H.TYPE_BYTES));
  T.isTrue(t, isOpen(v));
  T.isTrue(t, unify(v, H.TYPE_I64));
  T.equal(t, resolve(v), H.TYPE_I64);
};

let testNeverNullVar = fn(t: Test) {
  beginHir();
  let v = newVar(true);
  T.isTrue(t, !unify(v, nullType(H.TYPE_I32)));
  T.isTrue(t, unify(v, H.TYPE_I32));
};

let testTypeArgumentsAreInvariant = fn(t: Test) {
  beginHir();
  T.isTrue(t, !unify(arrayType(H.TYPE_I32), arrayType(H.TYPE_I64)));
  let v = newVar(false);
  T.isTrue(t, unify(arrayType(v), arrayType(H.TYPE_I32)));
  T.isTrue(t, !unify(arrayType(v), arrayType(H.TYPE_I64)));
  T.equal(t, resolve(v), H.TYPE_I32);
};
