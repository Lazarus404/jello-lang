package compiler.pipeline;

import type { Test } from std.testing;
import std.testing as T;
import { contains } from std.core.Bytes;
import { printHir } from frontend.hir.Print;
import { lowerProgram } from ir.Lower;
import { printIr } from ir.Print;
import { verifyProgram } from ir.Verify;
import { checked, lowered } from compiler.Pipeline;

let testLowersReturnAndWhileInTypedFunctionBodies = fn(t: Test) {
  let source = "let choose = fn(flag: Bool, value: I32): I32 { while (flag) { return value; } value + 1i32 }; choose(false, 2i32)";
  let hir = checked(source);
  T.equal(t, printHir(hir), "program\n"
    + "  fn @1 choose(%0 flag: bool, %1 value: i32) -> i32\n"
    + "    while\n"
    + "      condition\n"
    + "        local %0: bool\n"
    + "      body\n"
    + "        return\n"
    + "          local %1: i32\n"
    + "    tail\n"
    + "      add.wrap: i32\n"
    + "        local %1: i32\n"
    + "        i32 1: i32\n"
    + "  call @1: i32\n"
    + "    bool false: bool\n"
    + "    i32 2: i32\n");
  T.equal(t, printIr(lowerProgram(hir)), "fn @1(%0: bool, %1: i32) -> i32 entry 0 {\n"
    + "  register %0: bool\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  register %3: i32\n"
    + "  block 0:\n"
    + "    jump block 1\n"
    + "  block 1:\n"
    + "    branch %0, block 2, block 3\n"
    + "  block 2:\n"
    + "    return %1\n"
    + "  block 3:\n"
    + "    %2 = i32 1\n"
    + "    %3 = add.wrap.i32 %1, %2\n"
    + "    return %3\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: bool\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  block 0:\n"
    + "    %0 = bool false\n"
    + "    %1 = i32 2\n"
    + "    %2 = call @1(%0, %1)\n"
    + "    return %2\n"
    + "}\n");
  T.isTrue(t, verifyProgram(lowered(
    "let loop = fn(flag: Bool, value: I32): I32 { while (flag) { value; } value }; loop(false, 1i32)"
  )));
  T.throws(t, fn() { checked(
    "let f = fn(value: I32): I32 { return true; }; f(1i32)"
  );
  });
  T.throws(t, fn() { checked(
    "let f = fn(value: I32): I32 { while (value) { return value; } value }; f(1i32)"
  );
  });
  T.throws(t, fn() { checked(
    "let f = fn(value: I32): I32 { let value = 1i32; value }; f(1i32)"
  );
  });
  T.throws(t, fn() { checked(
    "let f = fn(): I32 { let value = 1i32; let value = 2i32; value }; f()"
  );
  });
  T.throws(t, fn() { checked(
    "let f = fn(value: I32): I32 { value; }; f(1i32)"
  );
  });
};

let testLowersMutableLocalAssignmentToTheExistingRegister = fn(t: Test) {
  let source = "let update = fn(flag: Bool): I32 { let value = 1i32; while (flag) { value = value + 1i32; return value; } value }; update(false)";
  let hir = checked(source);
  T.equal(t, printHir(hir), "program\n"
    + "  fn @1 update(%0 flag: bool) -> i32\n"
    + "    let %1 value: i32\n"
    + "      i32 1: i32\n"
    + "    while\n"
    + "      condition\n"
    + "        local %0: bool\n"
    + "      body\n"
    + "        expression\n"
    + "          assign %1: i32\n"
    + "            add.wrap: i32\n"
    + "              local %1: i32\n"
    + "              i32 1: i32\n"
    + "        return\n"
    + "          local %1: i32\n"
    + "    tail\n"
    + "      local %1: i32\n"
    + "  call @1: i32\n"
    + "    bool false: bool\n");
  T.equal(t, printIr(lowerProgram(hir)), "fn @1(%0: bool) -> i32 entry 0 {\n"
    + "  register %0: bool\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  register %3: i32\n"
    + "  register %4: i32\n"
    + "  block 0:\n"
    + "    %1 = i32 1\n"
    + "    %2 = move %1\n"
    + "    jump block 1\n"
    + "  block 1:\n"
    + "    branch %0, block 2, block 3\n"
    + "  block 2:\n"
    + "    %3 = i32 1\n"
    + "    %4 = add.wrap.i32 %2, %3\n"
    + "    %2 = move %4\n"
    + "    return %2\n"
    + "  block 3:\n"
    + "    return %2\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: bool\n"
    + "  register %1: i32\n"
    + "  block 0:\n"
    + "    %0 = bool false\n"
    + "    %1 = call @1(%0)\n"
    + "    return %1\n"
    + "}\n");
  T.throws(t, fn() { checked(
    "let f = fn(): I32 { const value = 1i32; value = 2i32; value }; f()"
  );
  });
  T.throws(t, fn() { checked(
    "let f = fn(value: I32): I32 { value = 2i32; value }; f(1i32)"
  );
  });
  T.throws(t, fn() { checked(
    "let f = fn(): I32 { let value = 1i32; value = true; value }; f()"
  );
  });
};

let testLowersBreakAndContinueToTheNearestLoopTargets = fn(t: Test) {
  let breakHir = checked(
    "let f = fn(flag: Bool): I32 { while (flag) { break; } 1i32 }; f(false)"
  );
  T.equal(t, printHir(breakHir), "program\n"
    + "  fn @1 f(%0 flag: bool) -> i32\n"
    + "    while\n"
    + "      condition\n"
    + "        local %0: bool\n"
    + "      body\n"
    + "        break\n"
    + "    tail\n"
    + "      i32 1: i32\n"
    + "  call @1: i32\n"
    + "    bool false: bool\n");
  T.equal(t, printIr(lowerProgram(breakHir)), "fn @1(%0: bool) -> i32 entry 0 {\n"
    + "  register %0: bool\n"
    + "  register %1: i32\n"
    + "  block 0:\n"
    + "    jump block 1\n"
    + "  block 1:\n"
    + "    branch %0, block 2, block 3\n"
    + "  block 2:\n"
    + "    jump block 3\n"
    + "  block 3:\n"
    + "    %1 = i32 1\n"
    + "    return %1\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: bool\n"
    + "  register %1: i32\n"
    + "  block 0:\n"
    + "    %0 = bool false\n"
    + "    %1 = call @1(%0)\n"
    + "    return %1\n"
    + "}\n");
  T.isTrue(t, verifyProgram(lowered(
    "let f = fn(outer: Bool, inner: Bool): I32 { while (outer) { while (inner) { continue; } break; } 1i32 }; f(false, false)"
  )));
  T.throws(t, fn() { checked(
    "let f = fn(): I32 { break; }; f()"
  );
  });
  T.throws(t, fn() { checked(
    "let f = fn(): I32 { continue; }; f()"
  );
  });
  T.throws(t, fn() { checked(
    "let f = fn(flag: Bool): I32 { while (flag) { break; 1i32; } 1i32 }; f(false)"
  );
  });
};

let testLowersStatementIfAndDropsCodeAfterTheEndOfEveryPath = fn(t: Test) {
  let hir = checked(
    "let f = fn(flag: Bool): I32 { if (flag) { return 1; } else if (!flag) { return 2; } 3 }; f(true)"
  );
  T.equal(t, printHir(hir), "program\n"
    + "  fn @1 f(%0 flag: bool) -> i32\n"
    + "    if\n"
    + "      condition\n"
    + "        local %0: bool\n"
    + "      then\n"
    + "        return\n"
    + "          i32 1: i32\n"
    + "      else\n"
    + "        if\n"
    + "          condition\n"
    + "            not.bool: bool\n"
    + "              local %0: bool\n"
    + "          then\n"
    + "            return\n"
    + "              i32 2: i32\n"
    + "    tail\n"
    + "      i32 3: i32\n"
    + "  call @1: i32\n"
    + "    bool true: bool\n");
  // The inner if has no else, so its join (and the tail) still runs.
  T.isTrue(t, contains(printIr(lowerProgram(hir)), "i32 3"));
  let dead = lowered(
    "let f = fn(flag: Bool): I32 { if (flag) { return 1; } else { return 2; } 3 }; f(true)"
  );
  T.isTrue(t, !contains(printIr(dead), "i32 3"));
  T.isTrue(t, !contains(printIr(dead), "block 1"));
  // A result type is inferred from a return inside an if.
  T.isTrue(t, verifyProgram(lowered(
    "let f = fn(flag: Bool) { if (flag) { return 1; } 2 }; f(true)"
  )));
  T.throws(t, fn() { checked(
    "let f = fn(flag: Bool): I32 { if (flag) { return 1; } }; f(true)"
  );
  });
};

let testLowersExplicitThrowAsATerminatingControlFlowEdge = fn(t: Test) {
  let hir = checked(
    "let fail = fn(value: I32): I32 { throw value + 1i32; }; fail(1i32)"
  );
  T.equal(t, printHir(hir), "program\n"
    + "  fn @1 fail(%0 value: i32) -> i32\n"
    + "    throw\n"
    + "      add.wrap: i32\n"
    + "        local %0: i32\n"
    + "        i32 1: i32\n"
    + "  call @1: i32\n"
    + "    i32 1: i32\n");
  T.equal(t, printIr(lowerProgram(hir)), "fn @1(%0: i32) -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  block 0:\n"
    + "    %1 = i32 1\n"
    + "    %2 = add.wrap.i32 %0, %1\n"
    + "    throw %2\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 1\n"
    + "    %1 = call @1(%0)\n"
    + "    return %1\n"
    + "}\n");
  T.isTrue(t, verifyProgram(lowered(
    "let fail = fn(value: Bool): I32 { while (value) { throw value; } throw 1i32; }; fail(false)"
  )));
  T.throws(t, fn() { checked(
    "let fail = fn(): I32 { throw 1i32; return 1i32; }; fail()"
  );
  });
  // A tail after a throw never runs; stage-0 code needs one as a placeholder.
  T.isTrue(t, verifyProgram(lowered(
    "let fail = fn(): I32 { throw 1i32; 1i32 }; fail()"
  )));
};
