package compiler.pipeline;

import type { Test } from std.testing;
import std.testing as T;
import { contains } from std.core.Bytes;
import { printHir } from frontend.PrintHir;
import { lowerProgram } from ir.Lower;
import { printIr } from ir.Print;
import { legalizeJlo } from backend.jello.Legalize;
import { checked, encoded, lowered } from compiler.Pipeline;

let testNullableI32ReachesExecutableJLO = fn(t: Test) {
  let hir = checked("let check = fn(value: ?I32): Bool { value != null }; check(7i32)");
  T.isTrue(t, contains(printHir(hir), "present: ?i32"));
  let ir = lowerProgram(hir);

  let printed = printIr(ir);
  T.isTrue(t, contains(printed, "register %0: dynamic"));
  T.isTrue(t, contains(printed, "is_null"));
  let jlo = legalizeJlo(ir);

  T.isTrue(t, contains(printIr(jlo), "is_null"));
  T.isTrue(t, Bytes.len(encoded(jlo)) > 0);
};

let testANullableReferenceKeepsItsRegisterKindAndConvertsWithACheck = fn(t: Test) {
  let ir = printIr(lowered(
    "let size = fn(value: ?Bytes): I32 { value.len() }; size(\"ab\")"
  ));
  T.isTrue(t, contains(ir, "register %0: bytes"));
  T.isTrue(t, contains(ir, "null_check %0"));
};
