import { test, run } from jellotest.Runner;
import { verifyProgram } from ir.Verify;
import { blockSuccessors } from ir.Cfg;
import { Op, instruction, opEffects, opOf } from ir.Model;
import { printIr } from ir.Print;
import { printHir } from frontend.PrintHir;
import { lex, lexFileSource } from frontend.Lexer;
import { parseProgram, parseSource, programSyntax } from frontend.Parser;
import { lowerProgram } from ir.Lower;
import { legalizeJlo } from backend.jello.Legalize;
import { allocateProgram } from backend.jello.Allocate;
import { emitJlo } from backend.jello.Emit;
import { typeCheckModules, typeCheckProgram, typeCheckProgramWithSyntax } from frontend.CheckModules;
import { loadModules, modulePath } from frontend.Modules;
import type { SourceSpan } from frontend.Source;
import { spanEnd, spanPath, spanStart } from frontend.Source;
import type { Hir } from frontend.Hir;
import { nodeCount, spanOf, useHir } from frontend.Hir;
import type {
  BasicBlock,
  Effect,
  EnumSchema,
  Function,
  Instruction,
  Program,
  ReturnType,
  Terminator,
  ThrowHandler,
  ValueType,
} from ir.Model;

let insn = fn(op: Op, dst: I32, args: Array<I32>, imm: I32): Instruction { instruction(op, dst, args, imm) };
let none = fn(): Array<I32> { Array.new<I32>(0) };
let program = fn(functions: Array<Function>): Program { Program.Program(functions, Array.new<Bytes>(0), Array.new<EnumSchema>(0), Array.new<ValueType>(0)) };
let printJlo = fn(legalized: Program): Bytes { printIr(allocateProgram(legalized)) };
let allocated = fn(legalized: Program): Function { match (allocateProgram(legalized)) { Program(functions, _, _, _) => functions[0] } };
let registerCount = fn(function: Function): I32 { match (function) { Function(_, _, registers, _, _, _) => registers.len() as I32 } };

let spillCount = fn(function: Function, push: Bool): I32 {
  match (function) { Function(_, _, _, _, blocks, _) => {
    let count = 0;
    let b = 0;

    while (b < blocks.len()) {
      match (blocks[b]) { Block(_, instructions, _, _) => {
        let i = 0;

        while (i < instructions.len()) {
          if (match (opOf(instructions[i])) { SpillPush => push, SpillPop => !push, _ => false }) { count++; }
          i++;
        }
      } };
      b++;
    }
    count
  } }
};

let checkFile = fn(path: Bytes): Hir { typeCheckModules(loadModules(path)) };

let initializationOrder = fn(path: Bytes): Array<Bytes> {
  let modules = loadModules(path);
  let paths = Array.new<Bytes>(0);
  let i = 0;

  while (i < modules.len()) {
    paths.push(modulePath(modules[i]));
    i++;
  }
  paths
};

let spansOf = fn(hir: Hir): Array<SourceSpan> {
  useHir(hir);
  let spans = Array.new<SourceSpan>(0);
  let id = 0;

  while (id < nodeCount()) {
    spans.push(spanOf(id));
    id++;
  }
  spans
};

let spansBothModules = fn(spans: Array<SourceSpan>): Bool {
  let dependency = false;
  let entry = false;
  let i = 0;

  while (i < spans.len()) {
    if (spanPath(spans[i]).indexOf("/math/Increment.jello") >= 0) { dependency = true; }
    if (spanPath(spans[i]).indexOf("/modules/main.jello") >= 0) { entry = true; }
    i++;
  }
  dependency && entry
};

test("centralizes instruction effects and CFG successors", fn(t) {
  let effects = opEffects(Op.Box);
  t.is(effects.len(), 1);

  match (effects[0]) {
    MayAllocate => t.pass(),
    _ => t.fail("dynamic boxing must allocate"),
  };

  let successors = blockSuccessors(BasicBlock.Block(
    0,
    [],
    Terminator.Throw(0),
    ThrowHandler.Catch(2, 1)
  ));
  t.is(successors.len(), 1);
  t.is(successors[0], 2);
});

test("prints deterministic human-readable IR", fn(t) {
  let printed = program([Function.Function(
    7,
    [0, 1],
    [ValueType.I32, ValueType.I32, ValueType.Bool],
    ReturnType.Value(ValueType.I32),
    [
      BasicBlock.Block(0, [insn(Op.Eq, 2, [0, 1], 0)], Terminator.Branch(2, 1, 2), null),
      BasicBlock.Block(1, [], Terminator.ReturnValue(0), null),
      BasicBlock.Block(2, [], Terminator.ReturnValue(1), null)
    ],
    0
  )]);

  t.is(printIr(printed), "fn @7(%0: i32, %1: i32) -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: bool\n"
    + "  block 0:\n"
    + "    %2 = eq.i32 %0, %1\n"
    + "    branch %2, block 1, block 2\n"
    + "  block 1:\n"
    + "    return %0\n"
    + "  block 2:\n"
    + "    return %1\n"
    + "}\n");
});

test("lowers a parsed boolean program tail to verified IR", fn(t) {
  t.is(printIr(lowerProgram(typeCheckProgram(parseProgram(lex("true"))))),
    "fn @0() -> bool entry 0 {\n"
    + "  register %0: bool\n"
    + "  block 0:\n"
    + "    %0 = bool true\n"
    + "    return %0\n"
    + "}\n");
  t.is(printIr(lowerProgram(typeCheckProgram(parseProgram(lex("1i32 + 2i32"))))),
    "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 1\n"
    + "    %1 = i32 2\n"
    + "    %2 = add.wrap.i32 %0, %1\n"
    + "    return %2\n"
    + "}\n");
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("2147483648i32"))); });
  t.is(printIr(lowerProgram(typeCheckProgram(parseProgram(lex("1 + 2"))))),
    printIr(lowerProgram(typeCheckProgram(parseProgram(lex("1i32 + 2i32"))))));
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("1i32 + true"))); });
});

test("lowers Bytes literals and u8 indexing", fn(t) {
  let hir = typeCheckProgram(parseProgram(lex("\"ABC\"[1i32]")));
  t.is(printHir(hir), "program\n"
    + "  bytes.get_u8: i32\n"
    + "    bytes \"ABC\": bytes\n"
    + "    i32 1: i32\n");
  let ir = lowerProgram(hir);
  let printed = printIr(ir);
  t.is(printed.indexOf("bytes \"ABC\"") >= 0, true);
  t.is(printed.indexOf("bytes.get_u8") >= 0, true);
  t.is(verifyProgram(ir), true);
});

test("prints deterministic typed HIR", fn(t) {
  let hir = typeCheckProgram(parseProgram(lex("1i32 + 2i32 + 3i32")));
  t.is(printHir(hir), "program\n"
    + "  add.wrap: i32\n"
    + "    add.wrap: i32\n"
    + "      i32 1: i32\n"
    + "      i32 2: i32\n"
    + "    i32 3: i32\n");
});

test("gives every HIR node the span of the syntax it was checked from", fn(t) {
  let spans = spansOf(typeCheckProgram(parseProgram(lex("1i32 + 2i32"))));
  t.is(spans.len(), 5);
  let i = 0;

  while (i < spans.len()) {
    t.is(spanPath(spans[i]), "<input>");
    i++;
  }
  t.is(spanStart(spans[0]), 0);
  t.is(spanEnd(spans[0]), 4);
  t.is(spanStart(spans[1]), 7);
  t.is(spanEnd(spans[1]), 11);
  t.is(spanStart(spans[2]), 0);
  t.is(spanEnd(spans[2]), 11);

  t.is(spansBothModules(spansOf(checkFile("itests/emit/modules/main.jello"))), true);
});

test("keeps source spans with explicit frontend results", fn(t) {
  let (tokens, path, starts, ends) = lexFileSource("1i32 + 2i32", "first.jello");
  lex("false");
  let program = parseSource(tokens, path, starts, ends);
  let syntax = programSyntax(program);
  parseProgram(lex("true"));
  let spans = spansOf(typeCheckProgramWithSyntax(program, syntax));
  let i = 0;

  while (i < spans.len()) {
    t.is(spanPath(spans[i]), "first.jello");
    i++;
  }

  t.throws(fn(_t) { parseSource(tokens, path, Array.new<I32>(0), Array.new<I32>(0)); });

  let loaded = loadModules("itests/emit/modules/main.jello");
  parseProgram(lex("false"));
  t.is(spansBothModules(spansOf(typeCheckModules(loaded))), true);
});

test("loads ordinary let declarations with their syntax", fn(t) {
  let path = "itests/emit/core.jello";
  let hir = checkFile(path);
  t.is(emitJlo(legalizeJlo(lowerProgram(hir))).len() > 64, true);
});

test("loads a comparison tail with its syntax", fn(t) {
  let path = "itests/emit/greater-i32.jello";
  let hir = checkFile(path);
  t.is(emitJlo(legalizeJlo(lowerProgram(hir))).len() > 64, true);
});

test("checks Array<I32> len, get, and set", fn(t) {
  let source = "let values = Array.new<I32>(2i32); values[0i32] = 39i32; values[0i32] + values.len() + 1i32";
  let hir = typeCheckProgram(parseProgram(lex(source)));
  let printed = printHir(hir);
  t.is(printed.indexOf("array.set: i32") >= 0, true);
  t.is(printed.indexOf("array.get: i32") >= 0, true);
  t.is(printed.indexOf("array.len") >= 0, true);
  t.is(verifyProgram(lowerProgram(hir)), true);
});

test("lowers Tuple<I32, I32> literal and fixed fields", fn(t) {
  let source = "let pair = (19i32, 23i32); pair.0 + pair.1";
  let parsed = parseProgram(lex(source));
  let hir = typeCheckProgram(parsed);
  t.is(printHir(hir).indexOf("tuple: tuple<i32, i32>") >= 0, true);
  let ir = lowerProgram(hir);
  let printed = printIr(ir);
  t.is(printed.indexOf("tuple %") >= 0, true);
  t.is(printed.indexOf("tuple.get") >= 0, true);
  t.is(verifyProgram(ir), true);
  t.is(emitJlo(legalizeJlo(ir)).len() > 128, true);
});

test("preserves exact spans through functions, assignments, branches, and loops", fn(t) {
  let source = "let f = fn(flag: Bool): I32 { let value = 1i32; while (flag) { value += 2i32; break; } return value; }; f(false)";
  let (tokens, path, starts, ends) = lexFileSource(source, "spans.jello");
  let program = parseSource(tokens, path, starts, ends);
  let spans = spansOf(typeCheckProgramWithSyntax(program, programSyntax(program)));
  let sawTarget = false;
  let sawAssignment = 0;
  let i = 0;

  while (i < spans.len()) {
    t.is(spanPath(spans[i]), path);
    t.is(spanEnd(spans[i]) > spanStart(spans[i]), true);
    if ((spanStart(spans[i]) == 63) && (spanEnd(spans[i]) == 68)) { sawTarget = true; }
    if ((spanStart(spans[i]) == 63) && (spanEnd(spans[i]) == 76)) { sawAssignment++; }
    i++;
  }
  t.is(sawTarget, true);
  t.is(sawAssignment, 2);
});

test("resolves a local binding once by stable identity", fn(t) {
  let hir = typeCheckProgram(parseProgram(lex("{ let x = 1i32; x + x }")));
  t.is(printHir(hir), "program\n"
    + "  block: i32\n"
    + "    let %0 x: i32\n"
    + "      i32 1: i32\n"
    + "    add.wrap: i32\n"
    + "      local %0: i32\n"
    + "      local %0: i32\n");
  t.is(printIr(lowerProgram(hir)), "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 1\n"
    + "    %1 = move %0\n"
    + "    %2 = add.wrap.i32 %1, %1\n"
    + "    return %2\n"
    + "}\n");
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("missing"))); });
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("let x = x; x"))); });
});

test("scopes block bindings and permits nested shadowing", fn(t) {
  let hir = typeCheckProgram(parseProgram(lex(
    "{ let x = 1i32; { let x = x + 1i32; { let y = x + 1i32; y } + x } + x }"
  )));
  t.is(printHir(hir), "program\n"
    + "  block: i32\n"
    + "    let %0 x: i32\n"
    + "      i32 1: i32\n"
    + "    add.wrap: i32\n"
    + "      block: i32\n"
    + "        let %1 x: i32\n"
    + "          add.wrap: i32\n"
    + "            local %0: i32\n"
    + "            i32 1: i32\n"
    + "        add.wrap: i32\n"
    + "          block: i32\n"
    + "            let %2 y: i32\n"
    + "              add.wrap: i32\n"
    + "                local %1: i32\n"
    + "                i32 1: i32\n"
    + "            local %2: i32\n"
    + "          local %1: i32\n"
    + "      local %0: i32\n");
  t.is(printIr(lowerProgram(hir)), "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  register %3: i32\n"
    + "  register %4: i32\n"
    + "  register %5: i32\n"
    + "  register %6: i32\n"
    + "  register %7: i32\n"
    + "  register %8: i32\n"
    + "  register %9: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 1\n"
    + "    %1 = move %0\n"
    + "    %2 = i32 1\n"
    + "    %3 = add.wrap.i32 %1, %2\n"
    + "    %4 = move %3\n"
    + "    %5 = i32 1\n"
    + "    %6 = add.wrap.i32 %4, %5\n"
    + "    %7 = move %6\n"
    + "    %8 = add.wrap.i32 %7, %4\n"
    + "    %9 = add.wrap.i32 %8, %1\n"
    + "    return %9\n"
    + "}\n");
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("let x = 1i32; let x = 2i32; x"))); });
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("{ let x = 1i32; let x = 2i32; x }"))); });
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("{ let x = 1i32; x }; x"))); });
});

test("lowers expression-valued if through a typed join", fn(t) {
  let hir = typeCheckProgram(parseProgram(lex("if (true) { 1i32 } else { 2i32 }")));
  t.is(printHir(hir), "program\n"
    + "  if: i32\n"
    + "    condition\n"
    + "      bool true: bool\n"
    + "    then\n"
    + "      block: i32\n"
    + "        i32 1: i32\n"
    + "    else\n"
    + "      block: i32\n"
    + "        i32 2: i32\n");
  t.is(printIr(lowerProgram(hir)), "fn @0() -> i32 entry 0 {\n"
    + "  register %0: bool\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  register %3: i32\n"
    + "  block 0:\n"
    + "    %0 = bool true\n"
    + "    branch %0, block 1, block 2\n"
    + "  block 1:\n"
    + "    %2 = i32 1\n"
    + "    %1 = move %2\n"
    + "    jump block 3\n"
    + "  block 2:\n"
    + "    %3 = i32 2\n"
    + "    %1 = move %3\n"
    + "    jump block 3\n"
    + "  block 3:\n"
    + "    return %1\n"
    + "}\n");
  t.is(verifyProgram(lowerProgram(typeCheckProgram(parseProgram(lex(
    "if (true) { if (false) { 1i32 } else { 2i32 } } else { 3i32 }"
  ))))), true);
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("if (1i32) { 2i32 } else { 3i32 }"))); });
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("if (true) { 1i32 } else { false }"))); });
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("if (true) { 1i32 }"))); });
});

test("lowers typed direct functions and left-to-right calls", fn(t) {
  let hir = typeCheckProgram(parseProgram(lex(
    "let add = fn(left: I32, right: I32): I32 { left + right }; add(1i32, 2i32)"
  )));
  t.is(printHir(hir), "program\n"
    + "  fn @1 add(%0 left: i32, %1 right: i32) -> i32\n"
    + "    tail\n"
    + "      add.wrap: i32\n"
    + "        local %0: i32\n"
    + "        local %1: i32\n"
    + "  call @1: i32\n"
    + "    i32 1: i32\n"
    + "    i32 2: i32\n");
  t.is(printIr(lowerProgram(hir)), "fn @1(%0: i32, %1: i32) -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  block 0:\n"
    + "    %2 = add.wrap.i32 %0, %1\n"
    + "    return %2\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 1\n"
    + "    %1 = i32 2\n"
    + "    %2 = call @1(%0, %1)\n"
    + "    return %2\n"
    + "}\n");
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex(
    "let f = fn(x: I32): I32 { x }; f()"
  )));
  });
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex(
    "let f = fn(x: I32): I32 { x }; f(true)"
  )));
  });
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex(
    "let f = fn(x): I32 { 1i32 }; f(1i32)"
  )));
  });
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex(
    "let f = fn(x: I32): Bool { x }; f(1i32)"
  )));
  });
});

test("resolves direct recursive calls from collected signatures", fn(t) {
  let source = "let factorial = fn(value: I32): I32 { if (value < 2i32) { 1i32 } else { value * factorial(value - 1i32) } }; factorial(5i32)";
  let hir = typeCheckProgram(parseProgram(lex(source)));
  let printedHir = printHir(hir);
  t.is(printedHir.indexOf("fn @1 factorial") >= 0, true);
  t.is(printedHir.indexOf("call @1: i32") >= 0, true);
  let ir = printIr(lowerProgram(hir));
  t.is(ir.indexOf("fn @1") >= 0, true);
  t.is(ir.indexOf("call @1") > ir.indexOf("fn @1"), true);
  t.is(verifyProgram(lowerProgram(hir)), true);
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex(
    "let bad = fn(value: I32): I32 { bad(true) }; bad(1i32)"
  )));
  });
});

test("lowers exact noncapturing function values and indirect calls", fn(t) {
  let source = "let increment = fn(value: I32): I32 { value + 1i32 }; let decrement = fn(value: I32): I32 { value - 1i32 }; let operation: (I32) -> I32 = increment; operation = decrement; operation(43i32)";
  let hir = typeCheckProgram(parseProgram(lex(source)));
  let ir = printIr(lowerProgram(hir));
  t.is(ir.indexOf("function @1") >= 0, true);
  t.is(ir.indexOf("call %") >= 0, true);
  let jlo = printJlo(legalizeJlo(lowerProgram(hir)));
  t.is(jlo.indexOf("= function @1") >= 0, true);
  t.is(jlo.indexOf("= call %") >= 0, true);
  t.is(emitJlo(legalizeJlo(lowerProgram(hir))).len() > 128, true);
  t.is(verifyProgram(lowerProgram(typeCheckProgram(parseProgram(lex(
    "let factorial = fn(value: I32): I32 { if (value < 2i32) { 1i32 } else { value * factorial(value - 1i32) } }; factorial(5i32)"
  ))))), true);
});

test("lowers typed i32 equality for changing loop conditions", fn(t) {
  let hir = typeCheckProgram(parseProgram(lex(
    "let count = fn(limit: I32): I32 { let value = 0i32; while (value == limit) { value = value + 1i32; } value }; count(0i32)"
  )));
  t.is(printHir(hir), "program\n"
    + "  fn @1 count(%0 limit: i32) -> i32\n"
    + "    let %1 value: i32\n"
    + "      i32 0: i32\n"
    + "    while\n"
    + "      condition\n"
    + "        eq.i32: bool\n"
    + "          local %1: i32\n"
    + "          local %0: i32\n"
    + "      body\n"
    + "        expression\n"
    + "          assign %1: i32\n"
    + "            add.wrap: i32\n"
    + "              local %1: i32\n"
    + "              i32 1: i32\n"
    + "    tail\n"
    + "      local %1: i32\n"
    + "  call @1: i32\n"
    + "    i32 0: i32\n");
  t.is(printIr(lowerProgram(hir)), "fn @1(%0: i32) -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  register %3: bool\n"
    + "  register %4: i32\n"
    + "  register %5: i32\n"
    + "  block 0:\n"
    + "    %1 = i32 0\n"
    + "    %2 = move %1\n"
    + "    jump block 1\n"
    + "  block 1:\n"
    + "    %3 = eq.i32 %2, %0\n"
    + "    branch %3, block 2, block 3\n"
    + "  block 2:\n"
    + "    %4 = i32 1\n"
    + "    %5 = add.wrap.i32 %2, %4\n"
    + "    %2 = move %5\n"
    + "    jump block 1\n"
    + "  block 3:\n"
    + "    return %2\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 0\n"
    + "    %1 = call @1(%0)\n"
    + "    return %1\n"
    + "}\n");
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("true == false"))); });
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("1i32 == true"))); });
});

test("lowers wrapping i32 subtraction left-to-right", fn(t) {
  let hir = typeCheckProgram(parseProgram(lex(
    "let decrement = fn(value: I32): I32 { value - 1i32 }; decrement(0i32)"
  )));
  t.is(printHir(hir), "program\n"
    + "  fn @1 decrement(%0 value: i32) -> i32\n"
    + "    tail\n"
    + "      sub.wrap: i32\n"
    + "        local %0: i32\n"
    + "        i32 1: i32\n"
    + "  call @1: i32\n"
    + "    i32 0: i32\n");
  t.is(printIr(lowerProgram(hir)), "fn @1(%0: i32) -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  block 0:\n"
    + "    %1 = i32 1\n"
    + "    %2 = sub.wrap.i32 %0, %1\n"
    + "    return %2\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 0\n"
    + "    %1 = call @1(%0)\n"
    + "    return %1\n"
    + "}\n");
  t.is(verifyProgram(lowerProgram(typeCheckProgram(parseProgram(lex(
    "let count = fn(start: I32): I32 { let value = start; while (value == start) { value = value - 1i32; } value }; count(2i32)"
  ))))), true);
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("true - false"))); });
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("1i32 - true"))); });
});

test("desugars i32 compound assignment through existing operations", fn(t) {
  let hir = typeCheckProgram(parseProgram(lex(
    "let update = fn(value: I32): I32 { let result = value; result += 2i32; result -= 1i32; result }; update(3i32)"
  )));
  t.is(printHir(hir), "program\n"
    + "  fn @1 update(%0 value: i32) -> i32\n"
    + "    let %1 result: i32\n"
    + "      local %0: i32\n"
    + "    expression\n"
    + "      assign %1: i32\n"
    + "        add.wrap: i32\n"
    + "          local %1: i32\n"
    + "          i32 2: i32\n"
    + "    expression\n"
    + "      assign %1: i32\n"
    + "        sub.wrap: i32\n"
    + "          local %1: i32\n"
    + "          i32 1: i32\n"
    + "    tail\n"
    + "      local %1: i32\n"
    + "  call @1: i32\n"
    + "    i32 3: i32\n");
  t.is(printIr(lowerProgram(hir)), "fn @1(%0: i32) -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  register %3: i32\n"
    + "  register %4: i32\n"
    + "  register %5: i32\n"
    + "  block 0:\n"
    + "    %1 = move %0\n"
    + "    %2 = i32 2\n"
    + "    %3 = add.wrap.i32 %1, %2\n"
    + "    %1 = move %3\n"
    + "    %4 = i32 1\n"
    + "    %5 = sub.wrap.i32 %1, %4\n"
    + "    %1 = move %5\n"
    + "    return %1\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 3\n"
    + "    %1 = call @1(%0)\n"
    + "    return %1\n"
    + "}\n");
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex(
    "let f = fn(): Bool { let value = true; value += false; value }; f()"
  )));
  });
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex(
    "let f = fn(): I32 { const value = 1i32; value += 1i32; value }; f()"
  )));
  });
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex(
    "let f = fn(): I32 { let value = 1i32; value *= 2i32; value }; f()"
  )));
  });
  t.is(verifyProgram(lowerProgram(typeCheckProgram(parseProgram(lex(
    "let f = fn(source: I32): I32 { let copy = source; copy += 1i32; source }; f(7i32)"
  ))))), true);
});

test("lowers signed i32 less-than for bounded loops", fn(t) {
  let hir = typeCheckProgram(parseProgram(lex(
    "let count = fn(limit: I32): I32 { let value = 0i32; while (value < limit) { value += 1i32; } value }; count(3i32)"
  )));
  t.is(printHir(hir), "program\n"
    + "  fn @1 count(%0 limit: i32) -> i32\n"
    + "    let %1 value: i32\n"
    + "      i32 0: i32\n"
    + "    while\n"
    + "      condition\n"
    + "        lt.s.i32: bool\n"
    + "          local %1: i32\n"
    + "          local %0: i32\n"
    + "      body\n"
    + "        expression\n"
    + "          assign %1: i32\n"
    + "            add.wrap: i32\n"
    + "              local %1: i32\n"
    + "              i32 1: i32\n"
    + "    tail\n"
    + "      local %1: i32\n"
    + "  call @1: i32\n"
    + "    i32 3: i32\n");
  t.is(printIr(lowerProgram(hir)), "fn @1(%0: i32) -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  register %3: bool\n"
    + "  register %4: i32\n"
    + "  register %5: i32\n"
    + "  block 0:\n"
    + "    %1 = i32 0\n"
    + "    %2 = move %1\n"
    + "    jump block 1\n"
    + "  block 1:\n"
    + "    %3 = lt.s.i32 %2, %0\n"
    + "    branch %3, block 2, block 3\n"
    + "  block 2:\n"
    + "    %4 = i32 1\n"
    + "    %5 = add.wrap.i32 %2, %4\n"
    + "    %2 = move %5\n"
    + "    jump block 1\n"
    + "  block 3:\n"
    + "    return %2\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 3\n"
    + "    %1 = call @1(%0)\n"
    + "    return %1\n"
    + "}\n");
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("true < false"))); });
  t.throws(fn(_t) { typeCheckProgram(parseProgram(lex("1i32 < true"))); });
});

test("legalizes the executable CFG subset to JLO operations", fn(t) {
  let jlo = legalizeJlo(lowerProgram(typeCheckProgram(parseProgram(lex(
    "let count = fn(limit: I32): I32 { let value = 0i32; while (value < limit) { value += 1i32; } value }; count(2i32)"
  )))));
  let bytes = emitJlo(jlo);
  t.is(Bytes.get_u8(bytes, 0), "B".code);
  t.is(Bytes.get_u8(bytes, 1), "Y".code);
  t.is(Bytes.get_u8(bytes, 2), "L".code);
  t.is(Bytes.get_u8(bytes, 3), "J".code);
  t.is(emitJlo(jlo), bytes);
  t.is(printJlo(jlo), "fn @1(%0: i32) -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: bool\n"
    + "  register %3: i32\n"
    + "  block 0:\n"
    + "    %1 = i32 0\n"
    + "    jump block 1\n"
    + "  block 1:\n"
    + "    %2 = lt.s.i32 %1, %0\n"
    + "    branch %2, block 2, block 3\n"
    + "  block 2:\n"
    + "    %3 = i32 1\n"
    + "    %1 = add.wrap.i32 %1, %3\n"
    + "    jump block 1\n"
    + "  block 3:\n"
    + "    return %1\n"
    + "}\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 2\n"
    + "    %1 = move %0\n"
    + "    %0 = call @1(%1)\n"
    + "    return %0\n"
    + "}\n");
  let throwing = legalizeJlo(lowerProgram(typeCheckProgram(parseProgram(lex(
    "let fail = fn(value: I32): I32 { throw value; }; fail(1i32)"
  )))));
  t.is(printJlo(throwing).indexOf("= box %0") >= 0, true);
  t.is(printJlo(throwing).indexOf("throw %1") >= 0, true);
  t.is(emitJlo(throwing).len() > 64, true);
});

test("carries a deduplicated bytes pool through selected JLO", fn(t) {
  let jlo = legalizeJlo(lowerProgram(typeCheckProgram(parseProgram(lex("\"A\"[0i32] + \"A\"[0i32]")))));

  match (jlo) {
    Program(_, pool, _, _) => {
      t.is(pool.len(), 1);
      t.is(pool[0], "A");
    },
  };
  t.is(printJlo(jlo).indexOf("bytes \"A\"") >= 0, true);
  t.is(emitJlo(jlo).len() > 0, true);
});

test("reuses one call scratch window", fn(t) {
  let caller = Function.Function(
    0,
    [],
    [ValueType.I32, ValueType.I32, ValueType.I32],
    ReturnType.Value(ValueType.I32),
    [BasicBlock.Block(0, [
      insn(Op.ConstI32, 0, none(), 1),
      insn(Op.Call, 1, [0], 1),
      insn(Op.Call, 2, [1], 1)
    ], Terminator.ReturnValue(2), null)],
    0
  );
  let callee = Function.Function(
    1,
    [0],
    [ValueType.I32],
    ReturnType.Value(ValueType.I32),
    [BasicBlock.Block(0, [], Terminator.ReturnValue(0), null)],
    0
  );
  t.is(registerCount(allocated(program([caller, callee]))), 2);
});

test("allocates compatible scratch windows for mixed call signatures", fn(t) {
  let caller = Function.Function(
    0, [], [ValueType.Bool, ValueType.Bool, ValueType.I32, ValueType.I32], ReturnType.Value(ValueType.I32),
    [BasicBlock.Block(0, [
      insn(Op.ConstBool, 0, none(), 1),
      insn(Op.Call, 1, [0], 1),
      insn(Op.ConstI32, 2, none(), 7),
      insn(Op.Call, 3, [2], 2)
    ], Terminator.ReturnValue(3), null)], 0
  );
  let boolCallee = Function.Function(
    1, [0], [ValueType.Bool], ReturnType.Value(ValueType.Bool),
    [BasicBlock.Block(0, [], Terminator.ReturnValue(0), null)], 0
  );
  let i32Callee = Function.Function(
    2, [0], [ValueType.I32], ReturnType.Value(ValueType.I32),
    [BasicBlock.Block(0, [], Terminator.ReturnValue(0), null)], 0
  );
  t.is(printJlo(program([caller, boolCallee, i32Callee])).indexOf("call @2(%") >= 0, true);
});

test("allocates more than 256 short-lived virtual registers", fn(t) {
  let registers = Array.new<ValueType>(0);
  let instructions = Array.new<Instruction>(0);
  let i = 0;

  while (i < 300) {
    registers.push(ValueType.I32);
    instructions.push(insn(Op.ConstI32, i, none(), i));
    i++;
  }
  t.is(registerCount(allocated(program([Function.Function(
    0, [], registers, ReturnType.Value(ValueType.I32),
    [BasicBlock.Block(0, instructions, Terminator.ReturnValue(299), null)], 0
  )]))), 1);
});

test("spills truly simultaneous register pressure", fn(t) {
  let registers = Array.new<ValueType>(0);
  let instructions = Array.new<Instruction>(0);
  let i = 0;
  let count = 300;

  while (i < count) {
    registers.push(ValueType.I32);
    instructions.push(insn(Op.ConstI32, i, none(), i));
    i++;
  }
  let result = count - 1;
  i = 1;

  while (i < count) {
    registers.push(ValueType.I32);
    result = registers.len() - 1;
    instructions.push(insn(Op.Add, result, [result - 1, i], 0));
    i++;
  }
  let function = allocated(program([Function.Function(
    0, [], registers, ReturnType.Value(ValueType.I32),
    [BasicBlock.Block(0, instructions, Terminator.ReturnValue(result), null)], 0
  )]));
  t.is(spillCount(function, true) > 0, true);
  t.is(spillCount(function, false) > 0, true);
  t.is(registerCount(function) <= 256, true);
});

test("allocates thousands of instructions across joins", fn(t) {
  let count = 4000;
  let registers: Array<ValueType> = [ValueType.Bool, ValueType.I32];
  let blocks = Array.new<BasicBlock>(0);
  let current = [insn(Op.ConstBool, 0, none(), 1), insn(Op.ConstI32, 1, none(), 1)];
  let kept = Array.new<I32>(0);
  let block = 0;
  let i = 2;

  while (i < count) {
    registers.push(ValueType.I32);
    current.push(insn(Op.Add, i, [i - 1, i - 1], 0));
    if (i % 50 == 0) { kept.push(i); }

    if (i % 200 == 0) {
      blocks.push(BasicBlock.Block(block, current, Terminator.Branch(0, block + 1, block + 2), null));
      blocks.push(BasicBlock.Block(block + 1, [], Terminator.Jump(block + 3), null));
      blocks.push(BasicBlock.Block(block + 2, [], Terminator.Jump(block + 3), null));
      block += 3;
      current = Array.new<Instruction>(0);
    }
    i++;
  }
  let sum = count - 1;
  i = 0;

  while (i < kept.len()) {
    registers.push(ValueType.I32);
    current.push(insn(Op.Add, registers.len() as I32 - 1, [sum, kept[i]], 0));
    sum = registers.len() as I32 - 1;
    i++;
  }
  blocks.push(BasicBlock.Block(block, current, Terminator.ReturnValue(sum), null));
  let function = allocated(program([Function.Function(0, [], registers, ReturnType.Value(ValueType.I32), blocks, 0)]));
  t.is(registerCount(function) < 100, true);
  t.is(spillCount(function, true), 0);
});

test("verifies allocated code against the program", fn(t) {
  let caller = Function.Function(
    0, [], [ValueType.Bool, ValueType.I32], ReturnType.Value(ValueType.I32),
    [BasicBlock.Block(0, [insn(Op.ConstBool, 0, none(), 1), insn(Op.Call, 1, [0], 1)], Terminator.ReturnValue(1), null)], 0
  );
  let callee = Function.Function(
    1, [0], [ValueType.I32], ReturnType.Value(ValueType.I32),
    [BasicBlock.Block(0, [], Terminator.ReturnValue(0), null)], 0
  );
  t.throws(fn(_t) { allocateProgram(program([caller, callee])); });
});

test("loads named direct-function imports as one typed program", fn(t) {
  let hir = checkFile("itests/emit/modules/main.jello");
  t.is(emitJlo(legalizeJlo(lowerProgram(hir))).len() > 64, true);
});

test("initializes imported primitive constants before the entry tail", fn(t) {
  let path = "itests/emit/module-constants/main.jello";
  let hir = checkFile(path);
  let initialization = initializationOrder(path);
  t.is(initialization.len(), 2);
  t.is(initialization[0].indexOf("/math/Constants.jello") >= 0, true);
  t.is(initialization[1], path);
  t.is(printIr(lowerProgram(hir)), "global g0: i32\n"
    + "global g1: i32\n"
    + "\n"
    + "fn @0() -> i32 entry 0 {\n"
    + "  register %0: i32\n"
    + "  register %1: i32\n"
    + "  register %2: i32\n"
    + "  register %3: i32\n"
    + "  register %4: i32\n"
    + "  register %5: i32\n"
    + "  register %6: i32\n"
    + "  register %7: i32\n"
    + "  register %8: i32\n"
    + "  block 0:\n"
    + "    %0 = i32 40\n"
    + "    global.set g0, %0\n"
    + "    %1 = i32 16\n"
    + "    %2 = i32 19\n"
    + "    %3 = sub.wrap.i32 %1, %2\n"
    + "    global.set g1, %3\n"
    + "    %4 = global.get g0\n"
    + "    %5 = global.get g1\n"
    + "    %6 = add.wrap.i32 %4, %5\n"
    + "    %7 = i32 5\n"
    + "    %8 = add.wrap.i32 %6, %7\n"
    + "    return %8\n"
    + "}\n");
});

