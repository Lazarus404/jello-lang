import { test, run } from jellotest.Runner;
import { lex } from frontend.Lexer;
import { parseProgram } from frontend.Parser;
import type {
  AssignOp,
  BinaryOp,
  Block,
  Expr,
  ImportItem,
  ImportKind,
  IntSize,
  ListLiteral,
  MatchArm,
  ObjectEntry,
  Package,
  Parameter,
  ParameterKind,
  Pattern,
  Program,
  QuoteBody,
  QuoteKind,
  Stmt,
  StructField,
  Type,
  TypedefBody,
} from frontend.Ast;

test("parses package, declarations, precedence, and program tail", fn(t) {
  let program = parseProgram(lex(
    "package demo.core; import type {Box as B} from lib.types; let x: I32 = 1 + 2 * 3; x"
  ));
  t.is(program, Program.Program(
    Package.Path(["demo", "core"]),
    [
      Stmt.ImportFrom(
        ImportKind.TypeOnly,
        [ImportItem.Item("Box", "B")],
        ["lib", "types"]
      ),
      Stmt.LetStmt(
        false,
        false,
        Pattern.BindPattern("x"),
        [],
        Type.Named("I32"),
        Expr.Binary(
          BinaryOp.Add,
          Expr.Integer("1", IntSize.Infer),
          Expr.Binary(
            BinaryOp.Multiply,
            Expr.Integer("2", IntSize.Infer),
            Expr.Integer("3", IntSize.Infer)
          )
        )
      )
    ],
    Expr.Variable("x")
  ));
});

test("parses function block tails and control statements", fn(t) {
  let program = parseProgram(lex(
    "let f = fn(x: I32): I32 { while (x) { break; } return x; };"
  ));
  let expected: ?Expr = null;

  match (program) {
    Program(_, statements, tail) => {
      t.is(statements.len(), 1);
      t.is(tail, expected);
    }
  };
});

test("parses representative patterns and nested generic types", fn(t) {
  let program = parseProgram(lex(
    "let [head, ...tail]: Box<Array<I32>> = value; match (value) { Pair(a, b) => a, is Box<Array<I32>> as boxed => boxed }"
  ));

  match (program) {
    Program(_, statements, tail) => {
      t.is(statements.len(), 1);
      t.not(tail, null);
    }
  };
});

test("rejects malformed syntax and missing semicolons", fn(t) {
  t.throws(fn(_t) { parseProgram(lex("let x = 1")); });
  t.throws(fn(_t) { parseProgram(lex("while x {}")); });
  t.throws(fn(_t) { parseProgram(lex("package demo let x = 1;")); });
});

test("parses keyword members, spreads, varargs, and generic new", fn(t) {
  parseProgram(lex(
    "let f: (I32...) -> I32 = fn(...xs) { 0 }; let x = new Box<I32>(1); Array.new(...xs); t.0;"
  ));
  t.pass();
});

test("validates pipeline topics", fn(t) {
  parseProgram(lex("value |> %.field;"));
  t.throws(fn(_t) { parseProgram(lex("%;")); });
});

test("parses match regexp, fallthrough, and enum payload patterns", fn(t) {
  let program = parseProgram(lex(
    "match (x) { A, B(v) => v, when ~r/a+/ as m => m, _ => 0 }"
  ));

  match (program) {
    Program(_, _, tail) => t.is(tail, Expr.Match(Expr.Variable("x"), [
      MatchArm.Arm(Pattern.Enum("A", []), null, Block.Block([], null)),
      MatchArm.Arm(Pattern.Enum("B", [Pattern.BindPattern("v")]), null, Block.Block([], Expr.Variable("v"))),
      MatchArm.Arm(Pattern.RegExp("a+", "", "m"), null, Block.Block([], Expr.Variable("m"))),
      MatchArm.Arm(Pattern.Wildcard, null, Block.Block([], Expr.Integer("0", IntSize.Infer)))
    ]))
  };
});

test("preserves guards on bodyless match arms", fn(t) {
  let program = parseProgram(lex(
    "match (x) { A when (a), B when (b), C => value }"
  ));

  match (program) {
    Program(_, _, tail) => t.is(tail, Expr.Match(Expr.Variable("x"), [
      MatchArm.Arm(Pattern.Enum("A", []), Expr.Variable("a"), Block.Block([], null)),
      MatchArm.Arm(Pattern.Enum("B", []), Expr.Variable("b"), Block.Block([], null)),
      MatchArm.Arm(Pattern.Enum("C", []), null, Block.Block([], Expr.Variable("value")))
    ]))
  };
});

test("builds exact ASTs for names, spreads, new, lists, and varargs", fn(t) {
  let program = parseProgram(lex(
    "let f: (I32...) -> I32 = fn(...xs) { 0 }; new Box<I32>(...xs); { type: t }; (...xs, x); list[head | tail]; list[a, ...rest, b]; Array.new(...xs); [x, ...xs]; t.0; list[head, | tail]"
  ));

  match (program) {
    Program(_, statements, tail) => {
      t.is(statements[0], Stmt.LetStmt(false, false, Pattern.BindPattern("f"), [],
        Type.Function([Type.VarargsArg(Type.Named("I32"))], Type.Named("I32")),
        Expr.Function([Parameter.Parameter("xs", null, ParameterKind.Varargs)], null,
          Block.Block([], Expr.Integer("0", IntSize.Infer)), false)));
      t.is(statements[1], Stmt.Expression(Expr.New(
        Expr.TypeApply(Expr.Variable("Box"), [Type.Named("I32")]),
        [Expr.Spread(Expr.Variable("xs"))]
      )));
      t.is(statements[2], Stmt.Expression(Expr.Object([
        ObjectEntry.Field("type", Expr.Variable("t"))
      ])));
      t.is(statements[3], Stmt.Expression(Expr.Tuple([
        Expr.Spread(Expr.Variable("xs")), Expr.Variable("x")
      ])));
      t.is(statements[4], Stmt.Expression(Expr.List(
        ListLiteral.Cons([Expr.Variable("head")], Expr.Variable("tail")))));
      t.is(statements[5], Stmt.Expression(Expr.List(ListLiteral.Spread(
        [Expr.Variable("a")], Expr.Variable("rest"), [Expr.Variable("b")]
      ))));
      t.is(statements[6], Stmt.Expression(Expr.Call(
        Expr.Member(Expr.Variable("Array"), "new"), [],
        [Expr.Spread(Expr.Variable("xs"))]
      )));
      t.is(statements[7], Stmt.Expression(Expr.Array([
        Expr.Variable("x"), Expr.Spread(Expr.Variable("xs"))
      ])));
      t.is(statements[8], Stmt.Expression(
        Expr.Member(Expr.Variable("t"), "0")));
      t.is(tail, Expr.List(ListLiteral.Cons([Expr.Variable("head")], Expr.Variable("tail"))));
    }
  };
});

test("builds exact pattern and control-statement ASTs", fn(t) {
  let program = parseProgram(lex(
    "let f = fn() { if (x) { 1 } let y = 2; }; match (x) { is fn as f => f, \"#\".code => 1, -2 => 2 }"
  ));

  match (program) {
    Program(_, statements, tail) => {
      match (statements[0]) {
        LetStmt(_, _, _, _, _, Function(_, _, Block(body, _), _)) => {
          t.is(body[0], Stmt.Expression(Expr.If(
            Expr.Variable("x"),
            Expr.BlockExpr(Block.Block([], Expr.Integer("1", IntSize.Infer))),
            Expr.Null
          )));
        },
        _ => t.fail("expected function declaration"),
      };
      t.is(tail, Expr.Match(Expr.Variable("x"), [
        MatchArm.Arm(Pattern.IsType(Type.Named("__fn__"), "f"), null,
          Block.Block([], Expr.Variable("f"))),
        MatchArm.Arm(Pattern.Integer("35", IntSize.Infer), null,
          Block.Block([], Expr.Integer("1", IntSize.Infer))),
        MatchArm.Arm(Pattern.Integer("-2", IntSize.Infer), null,
          Block.Block([], Expr.Integer("2", IntSize.Infer)))
      ]));
    }
  };
});

test("parses else-if chains and keyword-led blocks", fn(t) {
  let program = parseProgram(lex(
    "if (a) { 1 } else if (b) { 2 } else { 3 }; { null }; { null: value }"
  ));

  match (program) {
    Program(_, statements, tail) => {
      t.is(statements[0], Stmt.Expression(Expr.If(
        Expr.Variable("a"),
        Expr.BlockExpr(Block.Block([], Expr.Integer("1", IntSize.Infer))),
        Expr.If(
          Expr.Variable("b"),
          Expr.BlockExpr(Block.Block([], Expr.Integer("2", IntSize.Infer))),
          Expr.BlockExpr(Block.Block([], Expr.Integer("3", IntSize.Infer)))
        )
      )));
      t.is(statements[1], Stmt.Expression(
        Expr.BlockExpr(Block.Block([], Expr.Null))));
      t.is(tail, Expr.Object([
        ObjectEntry.Field("null", Expr.Variable("value"))
      ]));
    }
  };
});

test("parses macro and quote control-expression statements", fn(t) {
  let program = parseProgram(lex(
    "macro m() { if (x) { 1 } value; } quote.stmts { if (x) { 1 } value; }; quote.stmt { value; }"
  ));

  match (program) {
    Program(_, statements, tail) => {
      t.is(statements[0], Stmt.Macro(false, "m", [], [
        Stmt.Expression(Expr.If(Expr.Variable("x"),
          Expr.BlockExpr(Block.Block([], Expr.Integer("1", IntSize.Infer))), Expr.Null)),
        Stmt.Expression(Expr.Variable("value"))
      ]));
      t.is(statements[1], Stmt.Expression(Expr.Quote(QuoteKind.Statements,
        QuoteBody.Statements([
          Stmt.Expression(Expr.If(Expr.Variable("x"),
            Expr.BlockExpr(Block.Block([], Expr.Integer("1", IntSize.Infer))), Expr.Null)),
          Stmt.Expression(Expr.Variable("value"))
      ]))));
      t.is(tail, Expr.Quote(QuoteKind.Statement,
        QuoteBody.Statement(Stmt.Expression(Expr.Variable("value")))));
    }
  };
});

test("auto-detects quote bodies and rejects empty statement quotes", fn(t) {
  let program = parseProgram(lex(
    "quote { value }; quote { let x = 1; }; quote { let x = 1; return x; }"
  ));

  match (program) {
    Program(_, statements, tail) => {
      t.is(statements[0], Stmt.Expression(Expr.Quote(QuoteKind.Auto,
        QuoteBody.Expression(Expr.Variable("value")))));
      t.is(statements[1], Stmt.Expression(Expr.Quote(QuoteKind.Auto,
        QuoteBody.Statement(Stmt.LetStmt(false, false, Pattern.BindPattern("x"), [], null,
          Expr.Integer("1", IntSize.Infer))))));
      t.is(tail, Expr.Quote(QuoteKind.Auto, QuoteBody.Statements([
        Stmt.LetStmt(false, false, Pattern.BindPattern("x"), [], null,
          Expr.Integer("1", IntSize.Infer)),
        Stmt.Return(Expr.Variable("x"))
      ])));
    }
  };
  t.throws(fn(_t) { parseProgram(lex("quote.stmts {}")); });
  t.throws(fn(_t) { parseProgram(lex("quote.stmt {}")); });
  t.throws(fn(_t) { parseProgram(lex("quote {}")); });
});

test("classifies let by terminator and parses structural function fields", fn(t) {
  let expression = parseProgram(lex("let x = 1"));
  t.is(expression, Program.Program(Package.None, [], Expr.LetExpr(
    Pattern.BindPattern("x"), [], null, Expr.Integer("1", IntSize.Infer))));

  let declaration = parseProgram(lex("let x = 1; x"));
  t.is(declaration, Program.Program(Package.None, [
    Stmt.LetStmt(false, false, Pattern.BindPattern("x"), [], null,
      Expr.Integer("1", IntSize.Infer))
  ], Expr.Variable("x")));

  let typedefProgram = parseProgram(lex("typedef Box = { let f: (I32) -> I32; };"));

  match (typedefProgram) {
    Program(_, statements, _) => t.is(statements[0], Stmt.Typedef(false, "Box", [],
      TypedefBody.Struct([StructField.Field("f",
        Type.Function([Type.Named("I32")], Type.Named("I32")))])))
  };
  t.throws(fn(_t) { parseProgram(lex("typedef Box = { f: (I32) -> I32; };")); });
});

test("defines assignment and shift precedence", fn(t) {
  let program = parseProgram(lex("a = b + c << d; a << b + c; a + b << c; value |> %.field"));

  match (program) {
    Program(_, statements, tail) => {
      t.is(statements[0], Stmt.Expression(Expr.Assign(AssignOp.Assign,
        Expr.Variable("a"), Expr.Binary(BinaryOp.Add, Expr.Variable("b"),
          Expr.Binary(BinaryOp.ShiftLeft, Expr.Variable("c"), Expr.Variable("d"))))));
      t.is(statements[1], Stmt.Expression(Expr.Binary(BinaryOp.Add,
        Expr.Binary(BinaryOp.ShiftLeft, Expr.Variable("a"), Expr.Variable("b")),
        Expr.Variable("c"))));
      t.is(statements[2], Stmt.Expression(Expr.Binary(BinaryOp.Add, Expr.Variable("a"),
        Expr.Binary(BinaryOp.ShiftLeft, Expr.Variable("b"), Expr.Variable("c")))));
      t.is(tail, Expr.Pipe(Expr.Variable("value"),
        Expr.Member(Expr.Topic, "field")));
    }
  };
  t.throws(fn(_t) { parseProgram(lex("a = b = c")); });
  t.throws(fn(_t) { parseProgram(lex("a += b = c")); });
});

test("defines comparison, ternary, and await associativity", fn(t) {
  let program = parseProgram(lex(
    "a < b > c; f<T>(x); a ? b : c ? d : e; a ? b; await f(x)"
  ));

  match (program) {
    Program(_, statements, tail) => {
      t.is(statements[0], Stmt.Expression(Expr.Binary(BinaryOp.Greater,
        Expr.Binary(BinaryOp.Less, Expr.Variable("a"), Expr.Variable("b")),
        Expr.Variable("c"))));
      t.is(statements[1], Stmt.Expression(Expr.Call(Expr.Variable("f"),
        [Type.Named("T")], [Expr.Variable("x")])));
      t.is(statements[2], Stmt.Expression(Expr.Conditional(Expr.Variable("a"),
        Expr.Variable("b"), Expr.Conditional(Expr.Variable("c"), Expr.Variable("d"), Expr.Variable("e")))));
      t.is(statements[3], Stmt.Expression(Expr.Conditional(
        Expr.Variable("a"), Expr.Variable("b"), Expr.Null)));
      t.is(tail, Expr.Call(Expr.Await(Expr.Variable("f")), [], [Expr.Variable("x")]));
    }
  };
});

test("validates grammar-only restrictions and resets parser state", fn(t) {
  t.throws(fn(_t) { parseProgram(lex("let f = fn(...xs, y) { y };")); });
  t.throws(fn(_t) { parseProgram(lex("let f = fn(...?xs) { 0 };")); });
  t.throws(fn(_t) { parseProgram(lex("let f = fn(...xs = value) { 0 };")); });
  t.throws(fn(_t) { parseProgram(lex("let f = fn(if) { 0 };")); });
  t.throws(fn(_t) { parseProgram(lex("let f: (I32..., I32) -> I32 = value;")); });
  t.throws(fn(_t) { parseProgram(lex("typedef T = I32...;")); });
  t.throws(fn(_t) { parseProgram(lex("typedef T = ...I32;")); });
  t.throws(fn(_t) { parseProgram(lex("let (x) = value;")); });
  parseProgram(lex("let () = value; let (x,) = value; value is fn;"));
  t.throws(fn(_t) { parseProgram(lex("list[for x <- xs: x]")); });
  t.throws(fn(_t) { parseProgram(lex("let ~r/a/ = value;")); });
  t.throws(fn(_t) { parseProgram(lex("with ~r/a/ <- value { 1 }")); });
  t.throws(fn(_t) { parseProgram(lex("(a + b) = c;")); });
  t.throws(fn(_t) { parseProgram(lex("++(a + b);")); });
  t.throws(fn(_t) { parseProgram(lex("(a + b)++;")); });
  parseProgram(lex("a = b; a.x += b; a[0] = b;"));
  t.throws(fn(_t) { parseProgram(lex("bits[9(x)]")); });
  t.throws(fn(_t) { parseProgram(lex("bits[999999999999999999999(x)]")); });
  t.throws(fn(_t) { parseProgram(lex("bits[]")); });
  t.throws(fn(_t) { parseProgram(lex("bits[u8.be(x)]")); });
  t.throws(fn(_t) { parseProgram(lex("bits[rest.le(x)]")); });
  parseProgram(lex("bits[u16.be(x), rest(y)]"));
  t.throws(fn(_t) { parseProgram(lex("f(x,)")); });
  t.throws(fn(_t) { parseProgram(lex("[x,]")); });
  t.throws(fn(_t) { parseProgram(lex("fn(x,) { x }")); });
  t.throws(fn(_t) { parseProgram(lex("let f: (I32,) -> I32 = value;")); });
  t.throws(fn(_t) { parseProgram(lex("typedef B = bytes-layout { let x: bits(0); };")); });
  t.throws(fn(_t) { parseProgram(lex("typedef B = bytes-layout { let x: bits(8); };")); });
  t.throws(fn(_t) { parseProgram(lex("typedef B = bytes-layout { let x: bits(999999999999999999999); };")); });
  t.throws(fn(_t) { parseProgram(lex("prototype P { x: 1; }")); });
  parseProgram(lex("enum E { A; } let x = 1;"));
  t.throws(fn(_t) { parseProgram(lex("x is fn is fn")); });
  t.throws(fn(_t) { parseProgram(lex("match (x) { \"ab\".code => 1 }")); });
  parseProgram(lex("match (x) { \"é\".code => 1 }"));
  t.throws(fn(_t) { parseProgram(lex("{ x: 1 } let y = 2;")); });
  t.throws(fn(_t) { parseProgram(lex("x |> ;")); });
  t.throws(fn(_t) { parseProgram(lex("%;")); });
  t.pass();
});

run()
