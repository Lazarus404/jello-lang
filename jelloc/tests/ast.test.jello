import { test, run } from jellotest.Runner;
import { integerValue, wideIntegerValue } from frontend.Ast;

import type {
  BinaryOp,
  Block,
  Expr,
  IntSize,
  MatchArm,
  Package,
  Pattern,
  Program,
  QuoteBody,
  QuoteKind,
  Stmt,
  Type,
} from frontend.Ast;

test("represents recursive Jello syntax", fn(t) {
  let sum = Expr.Binary(
    BinaryOp.Add,
    Expr.Integer("1", IntSize.Infer),
    Expr.Integer("2", IntSize.I64)
  );
  let noGuard: ?Expr = null;
  let noType: ?Type = null;
  let noStatements: Array<Stmt> = [];
  let arms: Array<MatchArm> = [MatchArm.Arm(
    Pattern.BindPattern("n"),
    noGuard,
    Block.Block(noStatements, Expr.Variable("n"))
  )];
  let packagePath: Array<Bytes> = ["demo", "ast"];
  let statements: Array<Stmt> = [
    Stmt.LetStmt(false, false, Pattern.BindPattern("sum"), [], noType, sum)
  ];
  let tail: ?Expr = Expr.Match(Expr.Variable("sum"), arms);
  let program = Program.Program(
    Package.Path(packagePath),
    statements,
    tail
  );

  t.is(program, Program.Program(
    Package.Path(packagePath),
    statements,
    tail
  ));

  let macroExpr = Expr.Function(
    [],
    noType,
    Block.Block(
      noStatements,
      Expr.Quote(
        QuoteKind.Expression,
        QuoteBody.Expression(Expr.Unquote(Expr.Variable("x")))
      )
    ),
    true
  );
  t.is(macroExpr, macroExpr);
});

test("preserves imported recursive enum payload types", fn(t) {
  let named = Type.Named("I32");
  let function = Type.Function([named], named);

  match (function) {
    Function(args, result) => {
      match (args[0]) {
        Named(name) => t.is(name, "I32"),
        _ => t.fail("array element lost its recursive enum type"),
      };

      match (result) {
        Named(name) => t.is(name, "I32"),
        _ => t.fail("result lost its recursive enum type"),
      }
    },
    _ => t.fail("function type constructor changed"),
  };
});

let rejects = fn(text: Bytes, negative: Bool, wide: Bool): Bytes {
  try { if (wide) { wideIntegerValue(text, negative); } else { integerValue(text, negative); } "accepted" } catch (e) { Std.string(e) }
};

test("reads integer literals at both widths", fn(t) {
  t.is(integerValue("2147483647", false), 2147483647);
  t.is(integerValue("2147483648", true), -2147483647 - 1);
  t.is(integerValue("0x7FFF_FFFF", false), 2147483647);
  t.is(rejects("2147483648", false, false), "integer literal 2147483648 is out of range for I32 (-2147483648 to 2147483647)");
  t.is(rejects("2147483649", true, false), "integer literal -2147483649 is out of range for I32 (-2147483648 to 2147483647)");
  t.is(rejects("0xFFFFFFFF", false, false), "integer literal 0xFFFFFFFF is out of range for I32 (-2147483648 to 2147483647)");
  let max: I64 = 9223372036854775807;
  t.is(wideIntegerValue("9223372036854775807", false), max);
  t.is(wideIntegerValue("9223372036854775808", true), -max - 1);
  t.is(wideIntegerValue("0x7fff_ffff_ffff_ffff", false), max);
  t.is(wideIntegerValue("0b1_0000_0000_0000_0000_0000_0000_0000_0000", false), max - max + 4294967296);
  t.is(wideIntegerValue("-1", false), max - max - 1);
  t.is(rejects("9223372036854775808", false, true), "integer literal 9223372036854775808 is out of range for I64 (-9223372036854775808 to 9223372036854775807)");
  t.is(rejects("9223372036854775809", true, true), "integer literal -9223372036854775809 is out of range for I64 (-9223372036854775808 to 9223372036854775807)");
  t.is(rejects("0x1_0000_0000_0000_0000", false, true), "integer literal 0x1_0000_0000_0000_0000 is out of range for I64 (-9223372036854775808 to 9223372036854775807)");
});

run()
