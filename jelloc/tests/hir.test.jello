import { test, run } from jellotest.Runner;
import type { Hir } from frontend.Hir;
import frontend.Hir as H;
import {
  Hir, Op, arrayType, beginHir, bytesId, declareEnum, functionType, nullType, opOf, tupleType,
  typeName, useHir,
} from frontend.Hir;
import { typeCheckProgram } from frontend.CheckModules;
import { verifyHir } from frontend.VerifyHir;
import { lex } from frontend.Lexer;
import { parseProgram } from frontend.Parser;

let checked = fn(source: Bytes): Hir { typeCheckProgram(parseProgram(lex(source))) };

let opName = fn(op: Op): Bytes {
  match (op) {
    I32 => "I32", Local => "Local", Add => "Add", Call => "Call", If => "If", Let => "Let", Return => "Return",
    Global => "Global", InitGlobal => "InitGlobal", Parameter => "Parameter", _ => "",
  }
};

let find = fn(hir: Hir, name: Bytes, nth: I32): I32 {
  useHir(hir);
  let seen = 0;
  let id = 0;

  while (id < H.nodeCount()) {
    if (opName(opOf(id)) == name) {
      if (seen == nth) { return id; }
      seen++;
    }
    id++;
  }
  -1
};

let copy = fn(values: Array<I32>): Array<I32> {
  let result = Array.new<I32>(0);
  let i = 0;

  while (i < values.len()) {
    result.push(values[i]);
    i++;
  }
  result
};

let mutate = fn(hir: Hir, id: I32, column: I32, value: I32): Hir {
  match (hir) { Hir(ops, nodes, edges, bytes, kinds, types, typeEdges, root, spans, globals, natives, variants, fields) => {
    let changed = copy(nodes);
    changed[id * 5 + column] = value;
    Hir.Hir(ops, changed, edges, bytes, kinds, types, typeEdges, root, spans, globals, natives, variants, fields)
  } }
};

let mutateOp = fn(hir: Hir, id: I32, op: Op): Hir {
  match (hir) { Hir(ops, nodes, edges, bytes, kinds, types, typeEdges, root, spans, globals, natives, variants, fields) => {
    let changed = Array.new<Op>(0);
    let i = 0;

    while (i < ops.len()) {
      changed.push(i == id ? op : ops[i]);
      i++;
    }
    Hir.Hir(changed, nodes, edges, bytes, kinds, types, typeEdges, root, spans, globals, natives, variants, fields)
  } }
};

let mutateChild = fn(hir: Hir, parent: I32, index: I32, child: I32): Hir {
  match (hir) { Hir(ops, nodes, edges, bytes, kinds, types, typeEdges, root, spans, globals, natives, variants, fields) => {
    let changed = copy(edges);
    changed[nodes[parent * 5 + 3] + index] = child;
    Hir.Hir(ops, nodes, changed, bytes, kinds, types, typeEdges, root, spans, globals, natives, variants, fields)
  } }
};

let mutateSpans = fn(hir: Hir, count: I32, id: I32, column: I32, value: I32): Hir {
  match (hir) { Hir(ops, nodes, edges, bytes, kinds, types, typeEdges, root, spans, globals, natives, variants, fields) => {
    let changed = Array.new<I32>(0);
    let i = 0;

    while (i < count * 3) {
      changed.push(spans[i]);
      i++;
    }
    if (id >= 0) { changed[id * 3 + column] = value; }
    Hir.Hir(ops, nodes, edges, bytes, kinds, types, typeEdges, root, changed, globals, natives, variants, fields)
  } }
};

let rejection = fn(hir: Hir): Bytes {
  try {
    verifyHir(hir);
    "accepted"
  } catch (e) { Std.string(e) }
};

let SAMPLE = "let twice = fn(f: (I32) -> I32, x: I32): I32 { f(f(x)) };\n"
  + "let inc = fn(x: I32): I32 { x + 1i32 };\n"
  + "let loop = fn(n: I32): I32 { let i = 0i32; while (i < n) { i += 1i32; } return i; };\n"
  + "let pair = (1i32, 2i32);\n"
  + "let xs = Array.new<I32>(2i32);\n"
  + "xs[0i32] = \"A\"[0i32];\n"
  + "let maybe: ?I32 = null;\n"
  + "if (maybe == null) { twice(inc, loop(pair.1) + xs[0i32]) } else { 0i32 }";

test("interning", fn(t) {
  beginHir();
  let a = arrayType(H.TYPE_I32);
  t.is(arrayType(H.TYPE_I32), a);
  let tu = tupleType([H.TYPE_I32, H.TYPE_BOOL]);
  t.is(tupleType([H.TYPE_I32, H.TYPE_BOOL]), tu);
  t.is(tupleType([H.TYPE_BOOL, H.TYPE_I32]) != tu, true);
  let f = functionType([a, tu], nullType(H.TYPE_I32));
  t.is(functionType([a, tu], nullType(H.TYPE_I32)), f);
  t.is(functionType([a], nullType(H.TYPE_I32)) != f, true);
  let i = 0;
  let ids = Array.new<I32>(0);

  while (i < 300) {
    ids.push(arrayType(tupleType([H.TYPE_I32, H.TYPE_I32, i < 150 ? H.TYPE_BOOL : H.TYPE_I32])));
    i++;
  }
  t.is(ids[0], ids[149]);
  t.is(ids[150], ids[299]);
  t.is(ids[0] != ids[150], true);
  i = 0;

  while (i < 500) {
    bytesId("n" + Std.string(i));
    i++;
  }
  t.is(bytesId("n42"), bytesId("n42"));
  t.is(H.bytesOf(bytesId("n499")), "n499");
  let e = declareEnum("Color");
  t.is(declareEnum("Color") != e, true);
  t.is(typeName(tu), "tuple<i32, bool>");
  t.is(typeName(nullType(a)), "?array<i32>");
  t.is(typeName(e), "Color");
});

test("verifier accepts checked programs", fn(t) {
  t.is(rejection(checked(SAMPLE)), "accepted");
});

test("verifier recomputes types", fn(t) {
  let hir = checked(SAMPLE);
  t.is(rejection(mutate(hir, find(hir, "I32", 0), 0, H.TYPE_BOOL)), "invalid HIR: expression type mismatch");
  t.is(rejection(mutate(hir, find(hir, "Call", 0), 1, 1)), "invalid HIR: direct call signature mismatch");
  t.is(rejection(mutateOp(hir, find(hir, "Add", 0), Op.Eq)), "invalid HIR: expression type mismatch");
  t.is(rejection(mutate(hir, find(hir, "If", 0), 0, H.TYPE_BOOL)), "invalid HIR: if operand type");
});

test("verifier checks scopes and mutability", fn(t) {
  let hir = checked(SAMPLE);
  t.is(rejection(mutate(hir, find(hir, "Local", 0), 1, 99)), "invalid HIR: unknown local binding");
  t.is(rejection(mutateOp(hir, find(hir, "Let", 0), Op.Const)), "invalid HIR: assignment to immutable local");
  t.is(rejection(mutate(hir, find(hir, "Let", 0), 1, H.valueOf(find(hir, "Parameter", 3)))), "invalid HIR: binding declared twice");
});

test("verifier checks globals", fn(t) {
  let hir = checked(SAMPLE);
  t.is(rejection(mutate(hir, find(hir, "Global", 0), 1, 99)), "invalid HIR: unknown global");
  t.is(rejection(mutate(hir, find(hir, "InitGlobal", 1), 1, 0)), "invalid HIR: globals must be initialized once, in order");
  t.is(rejection(mutate(hir, find(hir, "InitGlobal", 1), 1, 2)), "invalid HIR: globals must be initialized once, in order");
});

test("verifier requires a tree", fn(t) {
  let hir = checked(SAMPLE);
  let branch = find(hir, "If", 0);
  useHir(hir);
  t.is(rejection(mutateChild(hir, branch, 2, H.childOf(branch, 1))), "invalid HIR: node referenced twice");
  t.is(rejection(mutateChild(hir, find(hir, "Add", 0), 0, branch)), "invalid HIR: node reference out of order");
});

test("verifier checks control flow and source spans", fn(t) {
  let hir = checked(SAMPLE);
  t.is(rejection(mutateOp(hir, find(hir, "Return", 0), Op.Break)), "invalid HIR: break outside loop");
  useHir(hir);
  let count = H.nodeCount();
  t.is(rejection(mutateSpans(hir, count, -1, 0, 0)), "accepted");
  t.is(rejection(mutateSpans(hir, count - 1, -1, 0, 0)), "invalid HIR: every node needs a source span");
  t.is(rejection(mutateSpans(hir, count, 3, 0, H.bytesCount())), "invalid HIR: source span without a path");
  t.is(rejection(mutateSpans(hir, count, 3, 2, H.spanStartOf(3))), "invalid HIR: empty source span");
  let add = find(hir, "Add", 0);
  t.is(rejection(mutateSpans(hir, count, add, 2, H.spanEndOf(H.childOf(add, 1)) - 1)), "invalid HIR: child span outside its parent");
});

run()
